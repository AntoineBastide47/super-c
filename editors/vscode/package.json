{
  "name": "super-c",
  "displayName": "Super-C",
  "description": "Super-C language support: diagnostics, hover, go-to-definition, references, rename, completion, formatting and semantic highlighting via `super-c lsp`.",
  "version": "0.1.0",
  "publisher": "super-c",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:super-c",
    "workspaceContains:**/build.toml",
    "onLanguage:superc-manifest"
  ],
  "contributes": {
    "languages": [
      {
        "id": "super-c",
        "aliases": [
          "Super-C",
          "superc"
        ],
        "extensions": [
          ".spc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "superc-manifest",
        "aliases": [
          "Super-C manifest"
        ],
        "filenames": [
          "build.toml"
        ],
        "configuration": "./language-configuration-toml.json"
      }
    ],
    "grammars": [
      {
        "language": "super-c",
        "scopeName": "source.super-c",
        "path": "./syntaxes/super-c.tmLanguage.json"
      },
      {
        "language": "superc-manifest",
        "scopeName": "source.superc-manifest",
        "path": "./syntaxes/build-toml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Super-C",
      "properties": {
        "superc.serverPath": {
          "type": "string",
          "default": "super-c",
          "description": "Path to the super-c binary (the language server runs as `super-c lsp`). When unset, the extension discovers one: the workspace's <out-dir>/release/super-c (sanitizer-free) first, then the workspace-root super-c, then PATH."
        },
        "superc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the Super-C language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
