// std::crypto::mlkem against NIST's ACVP vectors for FIPS 203 (ML-KEM-keyGen-FIPS203 and
// ML-KEM-encapDecap-FIPS203), two or one of each kind per parameter set: key generation from d and z
// (the SHA3-256 digests of ek and dk), encapsulation from ek and m (the digest of c, and K), decapsulation
// of a valid and of a modified ciphertext (K, the second by implicit rejection), an encapsulation key with
// a coefficient past q (the modulus check) and a decapsulation key with a modified H (the hash check).
// Then a round trip of the randomized functions.
import std::crypto::secret as *;
import std::crypto::sha3;
import std::crypto::mlkem;

// The bytes that hex text `h` spells.
fn unhex(h: str) Vector<Secret<u8>> {
    let d = |c: u8| if c <= b'9' {
        c - b'0'
    } else {
        c - b'a' + 10
    };
    let mut v = Vector::<Secret<u8>>::with_capacity(h.len() / 2);
    for i in 0..h.len() / 2 {
        v.push(Secret::new(d(h.byte_at(2 * i)) << 4 | d(h.byte_at(2 * i + 1))));
    }
    return v;
}

// `b` as lowercase hex.
fn hex(b: []Secret<u8>) String {
    let digits = "0123456789abcdef";
    let mut s = String::new();
    for x in b {
        let v = x.declassify();
        s.push_byte(digits.byte_at((v >> 4) as usize));
        s.push_byte(digits.byte_at((v & 15) as usize));
    }
    return s;
}

// The SHA3-256 digest of `b` as hex.
fn digest(b: []Secret<u8>) String {
    let d = sha3::sha3_256(b);
    return hex(&d[0..32]);
}

// `n` zero bytes.
fn zeros(n: usize) Vector<Secret<u8>> {
    let mut v = Vector::<Secret<u8>>::with_capacity(n);
    for _i in 0..n {
        v.push(Secret::new(0u8));
    }
    return v;
}

@test
fn keygen_vectors() {
    let cases: [(usize, str, str, str, str); 6] = [
        (
            2,
            "47b893474672ba92e4b12ee44fb32953af8e8503b5fb471d1614fb8a021a660a",
            "1f8cb39e9e30bc458a0dc5408884b1187fb217018df760fa57317703b844a0a9",
            "3a389831056ed8fd81476869245782689c84b3ce90fe6a9e78d0a380fd6a1573",
            "c26aff5b9f97b5b9ca824755d053a1b1aece2b965af6bfbd527b77ea22538468"
        ),
        (
            2,
            "3def73c558e1f5f2bfb4f6eaa36ee200cdf54580958cc2176282628ff508a016",
            "b9958575128f97022525266064f9422e83f75fbdcd0f2bc2648655f0e31a17e5",
            "52be25fbe4d87aa01253da8891d2592a416e2f791479e50abb19e8f215dd6216",
            "330ed125d5f61211d8817a7c6f147580c8652040baa682a761b71753d7ce38f0"
        ),
        (
            3,
            "e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0",
            "1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0",
            "81e66ef5a7a221619f6a64039cc369843e10df5c859f6959cc3fd8e5272330fd",
            "be81068c104cd6cf8efd800b294f4a15bb8a8050993fd54a2cc428841ef6ca44"
        ),
        (
            3,
            "3e5848db624613f7ac144457cc1375f006fa8cb953e767dc9e7428d00f5dad8b",
            "012dd6c2f0918b9eb6182474eb86d848f65974759d59ce151a396deee4ca10d1",
            "423290e0ccb74da11b95294fef12ec690815ff103075053b89c5021aeff4ca0c",
            "90ed09b739c59ff947f4ac7bc139f5696af8f62bc3b9e655c0437dc36b1c6f54"
        ),
        (
            4,
            "f3a706faf090c03db506863ab0b20bd8a1627956318e88c67eb875e8e7266009",
            "35d2bc43dd1cc879f765bf2a0c5e297889dde910e57e2bb0eae417b90ab7a275",
            "9370fe5b05ddc92c939f62cbde4c0fea36f45cd20c5748cf3ac891a4c2604496",
            "b8c683c71564ff8e2391c57b68c3a1ff186734b13e31d2a075b65307c8b80888"
        ),
        (
            4,
            "52f2df12173088140ca73333d1db4341949be452049028ef0dd904bc7e0ddef7",
            "cc96de9e1f0506bf490a154a6db46bd2bd1413c3d1dc163190ff171ef0d11e22",
            "7708c928659dfe465ae813012df3ff6eecb1e081391b0a94172aff81aa3296c4",
            "5739b6cac0651c4129adc2f34d921703066289089678556ed5462dc297188480"
        ),
    ];
    for (n, d, z, ek_digest, dk_digest) in cases {
        if n < 2 || n > 4 {
            panic("no rank");
        }
        let k = n;
        let (dv, zv) = (unhex(d), unhex(z));
        let mut ek = zeros(mlkem::ek_len(k));
        let mut dk = zeros(mlkem::dk_len(k));
        if dv.len() != 32 || zv.len() != 32 || ek.len() != mlkem::ek_len(k) || dk.len() != mlkem::dk_len(k) {
            panic("lengths");
        }
        assert(mlkem::keygen_internal(&dv, &zv, k, &mut ek, &mut dk));
        assert_eq(digest(&ek).as_str(), ek_digest);
        assert_eq(digest(&dk).as_str(), dk_digest);
    }
}

@test
fn encaps_vectors() {
    let cases: [(usize, str, str, str, str); 3] = [
        (
            2,
            "",
            "dcacfe4de1c115da106acd1eefeafdc7f0f4e5707453ee2d6b0d69d34cc0ef4a",
            "469862ade9e35df4c40cbddfe3594c43a059808b6790c7710cc28fe564c148ca",
            "2d74374b55d29aa585e144a29ba4f0a96537a73b4f176c5527075f66e38e8858"
        ),
        (
            3,
            "",
            "4e77596168711e913965d8175ac3bd76aab08b7f9385a02ae883cf6c6e17dd81",
            "684da17d93e27520cb78ae6169c020d73ef770e6fa89589cc7d653a76a8b1751",
            "79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed"
        ),
        (
            4,
            "",
            "2f1e2ca7bd72af847cac38cdefc4d345909d7517543edf32e2fc491ba05eb5c3",
            "866618b1b8d52ceefeb503b91d01b060c37cbe452ee912277b4978a030d20172",
            "5087e3b0c90bf601dd6501e071270eff8683621e9f5d67a7a668e50c4f460a75"
        ),
    ];
    for (n, ek, m, c_digest, key) in cases {
        if n < 2 || n > 4 {
            panic("no rank");
        }
        let k = n;
        let (ekv, mv) = (unhex(ek), unhex(m));
        let mut c = zeros(mlkem::ct_len(k));
        let mut kv = zeros(32);
        if ekv.len() != mlkem::ek_len(k) || mv.len() != 32 || c.len() != mlkem::ct_len(k) || kv.len() != 32 {
            panic("lengths");
        }
        assert(mlkem::encaps_internal(&ekv, &mv, k, &mut c, &mut kv));
        assert_eq(digest(&c).as_str(), c_digest);
        assert_eq(hex(&kv).as_str(), key);
    }
}

@test
fn decaps_vectors() {
    let cases: [(usize, str, str, str); 6] = [
        (
            2,
            "",
            "",
            "ea8067e693b368f1e0800deb84dcf2e7304db4ea439e05ddac64aa2358376873"
        ),
        (
            2,
            "",
            "",
            "1eb644ebfd75877d0ca481e1a3b95e7c461b81e0e3df5a42699775c7bda3b004"
        ),
        (
            3,
            "",
            "",
            "34cfae7f2ca3b0b9c3e06afeed554c053f6e51d875d3bd3ff0eda2086ee79f3a"
        ),
        (
            3,
            "",
            "",
            "2cfb695710a6c4377f46c20c13480aef7ac56030d47a0ab5af07ddd6062c28f4"
        ),
        (
            4,
            "",
            "",
            "8d77e1681dfbee67ff380ab5c5f66a0c5a6d30e34cca71523b4ed7dfd51a1a56"
        ),
        (
            4,
            "",
            "",
            "5d1350c0937b6222662f3d0a6194b8f1b60d4aeaf94fb8426c91078b6c12041d"
        ),
    ];
    for (n, dk, c, key) in cases {
        if n < 2 || n > 4 {
            panic("no rank");
        }
        let k = n;
        let (dkv, cv) = (unhex(dk), unhex(c));
        let mut kv = zeros(32);
        assert(mlkem::decaps(&dkv, &cv, k, &mut kv));
        assert_eq(hex(&kv).as_str(), key);
    }
}

@test
fn input_checks() {
    let eks: [(usize, str); 3] = [
        (
            2,
            ""
        ),
        (
            3,
            ""
        ),
        (
            4,
            ""
        ),
    ];
    for (n, ek) in eks {
        if n < 2 || n > 4 {
            panic("no rank");
        }
        let k = n;
        let mut c = zeros(mlkem::ct_len(k));
        let mut kv = zeros(32);
        let ekv = unhex(ek);
        assert(!mlkem::encaps(&ekv, k, &mut c, &mut kv));
    }
    let dks: [(usize, str); 3] = [
        (
            2,
            ""
        ),
        (
            3,
            ""
        ),
        (
            4,
            ""
        ),
    ];
    for (n, dk) in dks {
        if n < 2 || n > 4 {
            panic("no rank");
        }
        let k = n;
        let c = zeros(mlkem::ct_len(k));
        let mut kv = zeros(32);
        let dkv = unhex(dk);
        assert(!mlkem::decaps(&dkv, &c, k, &mut kv));
        let z = zeros(32);
        assert_eq(hex(&kv).as_str(), hex(&z).as_str());
    }
    // A wrong rank or length fails the type checks.
    let mut kv = zeros(32);
    let (dk, c3) = (zeros(mlkem::dk_len(2)), zeros(mlkem::ct_len(3)));
    assert(!mlkem::decaps(&dk, &c3, 2, &mut kv));
    let ek = zeros(mlkem::ek_len(2));
    let mut c = zeros(1568);
    assert(!mlkem::encaps(&ek, 5, &mut c, &mut kv));
}

// Decapsulation recovers the key of a fresh encapsulation, for keys from the system's entropy.
@test
fn round_trip() {
    for k in mlkem::ML_KEM_512..mlkem::ML_KEM_1024 + 1 {
        let mut ek = zeros(mlkem::ek_len(k));
        let mut dk = zeros(mlkem::dk_len(k));
        assert(mlkem::keygen(k, &mut ek, &mut dk));
        let mut c = zeros(mlkem::ct_len(k));
        let mut sent = zeros(32);
        assert(mlkem::encaps(&ek, k, &mut c, &mut sent));
        let mut got = zeros(32);
        assert(mlkem::decaps(&dk, &c, k, &mut got));
        assert_eq(hex(&got).as_str(), hex(&sent).as_str());
    }
}
