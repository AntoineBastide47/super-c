const fn i32_check() u32 {
    let mut n: u32 = 0;
    n = check(n, 1, i32::BITS == 32);
    n = check(n, 2, i32::MIN.count_zeros() == 31);
    n = check(n, 3, i32::MIN.leading_ones() == 1);
    n = check(n, 4, i32::MIN.trailing_ones() == 0);
    n = check(n, 5, i32::MIN.swap_bytes() == 128);
    n = check(n, 6, i32::MIN.reverse_bits() == 1);
    n = check(n, 7, i32::MIN.cast_unsigned() == 2147483648);
    n = check(n, 8, i32::MIN.unsigned_abs() == 2147483648);
    n = check(n, 9, i32::MIN.wrapping_abs() == i32::MIN);
    let (r10, o10) = i32::MIN.overflowing_abs();
    n = check(n, 10, r10 == i32::MIN && o10 == true);
    n = check(n, 11, i32::MIN.checked_abs() == Option::<i32>::None);
    n = check(n, 12, i32::MIN.saturating_abs() == i32::MAX);
    n = check(n, 13, i32::MIN.saturating_neg() == i32::MAX);
    let (r14, o14) = i32::MIN.overflowing_neg();
    n = check(n, 14, r14 == i32::MIN && o14 == true);
    n = check(n, 15, i32::MIN.checked_isqrt() == Option::<i32>::None);
    n = check(n, 16, i32::MIN.checked_ilog2() == Option::<u32>::None);
    n = check(n, 17, i32::MIN.checked_ilog10() == Option::<u32>::None);
