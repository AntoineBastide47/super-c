// The scalar methods of the prelude (std/core.spc): integer bits, byte order, powers, roots, logarithms,
// Euclidean division and the overflow flavors; float encodings, classes, neighbors and the IEEE 754-2019
// `maximum` and `minimum`; the bool and the char and u8 ASCII methods. Each `<type>_check` at the end of
// the file lists edge cases whose expected values come from an exact model of Rust's integer methods; it
// returns the number of its first failing case (0 when all pass) and runs once as a constant, through the
// compile-time evaluator, and once at run time. The randomized tests compare against reference loops over
// a fixed Pcg32 sequence; the narrow types are checked over every value.

import std::math::random as random;
import std::math::scalar as sc;

const I8_CHECK: u32 = i8_check();
const I16_CHECK: u32 = i16_check();
const I32_CHECK: u32 = i32_check();
const I64_CHECK: u32 = i64_check();
const ISIZE_CHECK: u32 = isize_check();
const U8_CHECK: u32 = u8_check();
const U16_CHECK: u32 = u16_check();
const U32_CHECK: u32 = u32_check();
const U64_CHECK: u32 = u64_check();
const USIZE_CHECK: u32 = usize_check();
const F32_CHECK: u32 = f32_check();
const F64_CHECK: u32 = f64_check();
const TEXT_CHECK: u32 = text_check();

// The rounds of each randomized test.
const ROUNDS: u32 = 4096;

// The first failing case: `n` once it is set, else `k` when `ok` is false.
const fn check(n: u32, k: u32, ok: bool) u32 {
    if n == 0 && !ok {
        return k;
    }
    return n;
}

// True when both arrays hold the same bytes.
const fn bytes_are<const N: usize>(a: [u8; N], b: [u8; N]) bool {
    for i in 0..N {
        if unsafe a[i] != unsafe b[i] {
            return false;
        }
    }
    return true;
}

const fn next_u64(rng: &mut random::Pcg32) u64 {
    let hi = rng.next_u32() as u64;
    return hi << 32 | rng.next_u32();
}

// A random value with a random number of leading zeros, so every magnitude occurs.
const fn spread_u64(rng: &mut random::Pcg32) u64 {
    return next_u64(rng) >> rng.next_u32() % 64;
}

@test
fn i8_methods_match_the_model_at_compile_time() {
    assert_eq(I8_CHECK, 0u32);
}

@test
fn i8_methods_match_the_model_at_run_time() {
    assert_eq(i8_check(), 0u32);
}

@test
fn i16_methods_match_the_model_at_compile_time() {
    assert_eq(I16_CHECK, 0u32);
}

