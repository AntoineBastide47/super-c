// Every u8 and u16 value: roots and logarithms against direct definitions, and the bit and byte round
// trips.
@test
fn narrow_unsigned_methods_hold_for_every_value() {
    for i in 0..65536u32 {
        let x = i as u16;
        let r = x.isqrt() as u32;
        assert(r * r <= i, "u16 isqrt too large");
        assert((r + 1) * (r + 1) > i, "u16 isqrt too small");
        if x > 0 {
            let mut bits: u32 = 0;
            let mut digits: u32 = 0;
            let mut v = i;
            while v > 1 {
                v >>= 1;
                bits += 1;
            }
            v = i;
            while v >= 10 {
                v /= 10;
                digits += 1;
            }
            assert_eq(x.ilog2(), bits);
            assert_eq(x.ilog10(), digits);
            assert_eq(x.ilog(3), (i as u64).ilog(3));
        }
        assert_eq(u16::from_le_bytes(x.to_le_bytes()), x);
        assert_eq(u16::from_be_bytes(x.to_be_bytes()), x);
        assert_eq(u16::from_ne_bytes(x.to_ne_bytes()), x);
        assert_eq(u16::from_be_bytes(x.to_le_bytes()), x.swap_bytes());
        assert_eq(x.swap_bytes().swap_bytes(), x);
        assert_eq(x.reverse_bits().reverse_bits(), x);
        let mut rev: u16 = 0;
        for b in 0..16u32 {
            rev |= (x >> b as u16 & 1) << (15 - b) as u16;
        }
        assert_eq(x.reverse_bits(), rev);
        for n in 0..18u32 {
            assert_eq(x.rotate_left(n).rotate_right(n), x);
            assert_eq(x.rotate_left(n), x.rotate_right(16 - n % 16));
        }
        assert_eq(x.count_zeros() + x.count_ones(), 16usize);
        assert_eq(x.leading_ones(), (~x).leading_zeros());
        let b = x as u8;
        assert_eq(b.isqrt() as u32, (b as u32).isqrt());
        assert_eq(b.reverse_bits().reverse_bits(), b);
        assert_eq(b.rotate_left(i % 11).rotate_right(i % 11), b);
    }
}

// Every i8 and i16 value against i32 and i64 references: the Euclidean pair, midpoint, abs_diff and the
// signed roots and logarithms.
@test
fn narrow_signed_methods_hold_for_every_value() {
    let divisors: [i16; 8] = [1, -1, 2, -2, 7, -7, i16::MAX, i16::MIN];
    for i in -32768..32768i32 {
        let x = i as i16;
        for j in 0..8usize {
            let d = unsafe divisors[j];
            let w = d as i32;
            if !(x == i16::MIN && d == -1) {
                let q = x.div_euclid(d) as i32;
                let r = x.rem_euclid(d) as i32;
                assert_eq(q * w + r, i);
                assert(r >= 0, "rem_euclid negative");
                assert(r < w.abs(), "rem_euclid not below |rhs|");
            }
            assert_eq(x.abs_diff(d) as i32, (i - w).abs());
            assert_eq(x.midpoint(d) as i32, (i + w) / 2);
        }
        if x >= 0 {
            let r = x.isqrt() as i32;
            assert(r * r <= i, "i16 isqrt too large");
            assert((r + 1) * (r + 1) > i, "i16 isqrt too small");
        } else {
            assert(x.checked_isqrt().is_none(), "negative i16 has a root");
            assert(x.checked_ilog2().is_none(), "negative i16 has a logarithm");
        }
        if x > 0 {
            assert_eq(x.ilog10(), (i as u32).ilog10());
            assert_eq(x.ilog2(), (i as u32).ilog2());
        }
        assert_eq(i16::from_le_bytes(x.to_le_bytes()), x);
        assert_eq(i16::from_be_bytes(x.to_be_bytes()), x);
        assert_eq(x.unsigned_abs() as i32, i.abs());
        assert_eq(x.wrapping_abs().wrapping_neg().wrapping_abs(), x.wrapping_abs());
        let b = x as i8;
        assert_eq(b.saturating_neg() as i32, (-(b as i32)).min(127));
        assert_eq(b.saturating_abs() as i32, (b as i32).abs().min(127));
    }
}

// The power family against a reference loop of `checked_mul` and `wrapping_mul` over random bases and
// exponents: u64, i64, u32 and i32.
@test
fn powers_match_repeated_multiplication() {
    let mut rng = random::Pcg32::new(1, 11);
    for _ in 0..ROUNDS {
        let e = rng.next_u32() % 70;
        let ub = spread_u64(&mut rng);
        let mut exact = Option::<u64>::Some(1);
        let mut wrapped: u64 = 1;
        for _ in 0..e {
            exact = exact.and_then(|a| a.checked_mul(ub));
            wrapped = wrapped.wrapping_mul(ub);
        }
        assert_eq(ub.checked_pow(e), exact);
        assert_eq(ub.wrapping_pow(e), wrapped);
        let (r, o) = ub.overflowing_pow(e);
        assert_eq(r, wrapped);
        assert_eq(o, exact.is_none());
        assert_eq(ub.saturating_pow(e), exact.unwrap_or(u64::MAX));
        if exact.is_some() {
            assert_eq(ub.pow(e), wrapped);
        }
        let sb = (rng.next_u32() % 41) as i64 - 20;
        let mut sexact = Option::<i64>::Some(1);
        let mut swrapped: i64 = 1;
        for _ in 0..e {
            sexact = sexact.and_then(|a| a.checked_mul(sb));
            swrapped = swrapped.wrapping_mul(sb);
        }
        assert_eq(sb.checked_pow(e), sexact);
        assert_eq(sb.wrapping_pow(e), swrapped);
        let (sr, so) = sb.overflowing_pow(e);
        assert_eq(sr, swrapped);
        assert_eq(so, sexact.is_none());
        let sat = if sb < 0 && e % 2 == 1 {
            i64::MIN
        } else {
            i64::MAX
        };
        assert_eq(sb.saturating_pow(e), sexact.unwrap_or(sat));
        let nb = sb as i32;
        let mut nexact = Option::<i32>::Some(1);
        for _ in 0..e {
            nexact = nexact.and_then(|a| a.checked_mul(nb));
        }
        assert_eq(nb.checked_pow(e), nexact);
        assert_eq(nb.wrapping_pow(e), swrapped as i32);
        let wb = ub as u32;
        let mut wexact = Option::<u32>::Some(1);
        for _ in 0..e {
            wexact = wexact.and_then(|a| a.checked_mul(wb));
        }
        assert_eq(wb.checked_pow(e), wexact);
        assert_eq(wb.wrapping_pow(e), wrapped as u32);
    }
}

// Roots and logarithms of random values of every magnitude against their definitions.
@test
fn roots_and_logarithms_match_their_definitions() {
    let mut rng = random::Pcg32::new(2, 13);
    for _ in 0..ROUNDS {
        let x = spread_u64(&mut rng);
        let r = x.isqrt();
        assert(r * r <= x, "u64 isqrt too large");
        assert((r + 1).checked_mul(r + 1).map_or(true, |s| s > x), "u64 isqrt too small");
        let w = x as u32;
        let rw = w.isqrt();
        assert(rw as u64 * rw as u64 <= w as u64, "u32 isqrt too large");
        assert((rw as u64 + 1) * (rw as u64 + 1) > w as u64, "u32 isqrt too small");
        assert_eq((x as usize).isqrt() as u64, ((x as usize) as u64).isqrt());
        if x == 0 {
            continue;
        }
        let base = (rng.next_u32() % 39 + 2) as u64;
        let mut n: u32 = 0;
        let mut p: u64 = 1;
        while p <= x / base {
            p *= base;
            n += 1;
        }
        assert_eq(x.ilog(base), n);
        assert_eq(x.checked_ilog(base), Some(n));
        let mut d: u32 = 0;
        let mut t: u64 = 10;
        while t <= x {
            d += 1;
            if t > u64::MAX / 10 {
                break;
            }
            t *= 10;
        }
        assert_eq(x.ilog10(), d);
        assert_eq(x.ilog2(), 63 - x.leading_zeros() as u32);
        let s = (x >> 1) as i64;
        if s > 0 {
            assert_eq(s.ilog10(), (s as u64).ilog10());
            assert_eq(s.isqrt() as u64, (s as u64).isqrt());
        }
    }
}

// The bit and byte round trips of random u64, i64, u32, i32 and usize values, and the rotations against
// a reference built from wrapping shifts.
@test
fn bit_and_byte_round_trips_hold() {
    let mut rng = random::Pcg32::new(3, 17);
    for _ in 0..ROUNDS {
        let x = next_u64(&mut rng);
        let n = rng.next_u32();
        assert_eq(u64::from_le_bytes(x.to_le_bytes()), x);
        assert_eq(u64::from_be_bytes(x.to_be_bytes()), x);
        assert_eq(u64::from_ne_bytes(x.to_ne_bytes()), x);
        assert_eq(u64::from_be_bytes(x.to_le_bytes()), x.swap_bytes());
        assert_eq(x.swap_bytes().swap_bytes(), x);
        assert_eq(x.reverse_bits().reverse_bits(), x);
        assert_eq(x.reverse_bits().swap_bytes(), x.swap_bytes().reverse_bits());
        assert_eq(x.rotate_left(n).rotate_right(n), x);
        let k = n % 64;
        let rot = if k == 0 {
            x
        } else {
            x.wrapping_shl(k) | x.wrapping_shr(64 - k)
        };
        assert_eq(x.rotate_left(n), rot);
        assert_eq(x.to_be(), u64::from_be_bytes(x.to_ne_bytes()));
        assert_eq(u64::from_be(x.to_be()), x);
        assert_eq(u64::from_le(x.to_le()), x);
        let s = x as i64;
        assert_eq(i64::from_le_bytes(s.to_le_bytes()), s);
        assert_eq(i64::from_be_bytes(s.to_be_bytes()), s);
        assert_eq(s.rotate_right(n), x.rotate_right(n) as i64);
        assert_eq(s.reverse_bits(), x.reverse_bits() as i64);
        let w = x as u32;
        assert_eq(u32::from_be_bytes(w.to_be_bytes()), w);
        assert_eq(w.swap_bytes(), (x.swap_bytes() >> 32) as u32);
        assert_eq(w.reverse_bits(), (x.reverse_bits() >> 32) as u32);
        assert_eq(w.rotate_left(n).rotate_right(n), w);
        assert_eq((w as i32).swap_bytes(), w.swap_bytes() as i32);
        let z = x as usize;
        assert_eq(usize::from_le_bytes(z.to_le_bytes()), z);
        assert_eq(usize::from_be_bytes(z.to_be_bytes()), z);
        assert_eq(usize::from_ne_bytes(z.to_ne_bytes()), z);
        assert_eq(z.swap_bytes().swap_bytes(), z);
        assert_eq(z.reverse_bits().reverse_bits(), z);
        assert_eq(z.rotate_left(n).rotate_right(n), z);
        assert_eq(isize::from_be_bytes((z as isize).to_be_bytes()), z as isize);
        assert_eq(x.count_zeros() + x.count_ones(), 64usize);
        assert_eq(x.trailing_ones(), (~x).trailing_zeros());
    }
}

// Random i64 pairs against i128 references: Euclidean division, midpoint and abs_diff.
@test
fn i64_division_and_midpoint_match_i128() {
    let mut rng = random::Pcg32::new(4, 19);
    let two = i128::from_i64(2);
    let zero = i128::from_i64(0);
    for _ in 0..ROUNDS {
        let a = spread_u64(&mut rng) as i64;
        let mut b = spread_u64(&mut rng) as i64;
        if rng.next_u32() % 2 == 0 {
            b = b.wrapping_neg();
        }
        let wa = i128::from_i64(a);
        let wb = i128::from_i64(b);
        let m = i128::from_i64(a.midpoint(b));
        assert(m == (wa + wb) / two, "midpoint differs from the i128 quotient");
        let d = u128::from_u64(a.abs_diff(b));
        assert(d == wa.abs_diff(&wb), "abs_diff differs from the i128 difference");
        if b == 0 || a == i64::MIN && b == -1 {
            continue;
        }
        let q = i128::from_i64(a.div_euclid(b));
        let r = i128::from_i64(a.rem_euclid(b));
        assert(q * wb + r == wa, "div_euclid and rem_euclid do not recompose");
        assert(r >= zero, "rem_euclid negative");
        assert(r < wb.abs(), "rem_euclid not below |rhs|");
    }
}

// Unsigned values plus signed offsets against i128 sums.
@test
fn add_signed_matches_i128() {
    let mut rng = random::Pcg32::new(5, 23);
    let zero = i128::from_i64(0);
    let max = u128::from_u64(u64::MAX);
    let top = i128::cast_unsigned(&max);
    for _ in 0..ROUNDS {
        let a = next_u64(&mut rng) >> rng.next_u32() % 2 * 63;
        let s = next_u64(&mut rng) as i64;
        let wa = u128::from_u64(a);
        let sum = i128::cast_unsigned(&wa) + i128::from_i64(s);
        let fits = sum >= zero && sum <= top;
        assert_eq(a.checked_add_signed(s).is_some(), fits);
        assert_eq(a.wrapping_add_signed(s), a.wrapping_add(s as u64));
        let (r, o) = a.overflowing_add_signed(s);
        assert_eq(r, a.wrapping_add(s as u64));
        assert_eq(o, !fits);
        let ws = u128::from_u64(a.saturating_add_signed(s));
        let sat = i128::cast_unsigned(&ws);
        if fits {
            assert(sat == sum, "saturating_add_signed changed an exact sum");
        } else if sum < zero {
            assert(sat == zero, "saturating_add_signed did not clamp to 0");
        } else {
            assert(sat == top, "saturating_add_signed did not clamp to MAX");
        }
    }
}

// Random finite encodings: next_up and next_down are inverse, the encoding and its bytes round trip,
// and the class agrees with the predicates.
@test
fn float_neighbors_and_encodings_round_trip() {
    let mut rng = random::Pcg32::new(6, 29);
    for _ in 0..ROUNDS {
        let bits = next_u64(&mut rng);
        let x = f64::from_bits(bits);
        assert_eq(x.to_bits(), bits);
        assert_eq(f64::from_le_bytes(x.to_le_bytes()).to_bits(), bits);
        assert_eq(f64::from_be_bytes(x.to_be_bytes()).to_bits(), bits);
        assert_eq(f64::from_ne_bytes(x.to_ne_bytes()).to_bits(), bits);
        let y = f32::from_bits(bits as u32);
        assert_eq(y.to_bits(), bits as u32);
        assert_eq(f32::from_be_bytes(y.to_be_bytes()).to_bits(), bits as u32);
        assert_eq(x.is_normal(), x.classify() == FpClass::FP_NORMAL);
        assert_eq(x.is_subnormal(), x.classify() == FpClass::FP_SUBNORMAL);
        assert_eq(y.is_normal(), y.classify() == FpClass::FP_NORMAL);
        if x.is_finite() && x != f64::MAX && x != f64::MIN {
            assert(x.next_up() > x, "f64 next_up not above");
            assert(x.next_down() < x, "f64 next_down not below");
            if x != 0.0 {
                assert_eq(x.next_up().next_down().to_bits(), bits);
                assert_eq(x.next_down().next_up().to_bits(), bits);
            }
        }
        if y.is_finite() && y != f32::MAX && y != f32::MIN && y != 0.0 {
            assert_eq(y.next_up().next_down().to_bits(), bits as u32);
        }
    }
}

// Every byte and char against the ASCII class definitions spelled as lists.
@test
fn ascii_classes_match_their_lists() {
    let punct = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
    let space = " \t\n\x0C\r";
    let hex = "0123456789abcdefABCDEF";
    for i in 0..256u32 {
        let b = i as u8;
        let c = b as char;
        let upper = i >= 65 && i <= 90;
        let lower = i >= 97 && i <= 122;
        let digit = i >= 48 && i <= 57;
        let in_punct = punct.find_byte(b) >= 0;
        let in_space = space.find_byte(b) >= 0;
        let in_hex = hex.find_byte(b) >= 0;
        assert_eq(b.is_ascii(), i < 128);
        assert_eq(b.is_ascii_uppercase(), upper);
        assert_eq(b.is_ascii_lowercase(), lower);
        assert_eq(b.is_ascii_alphabetic(), upper || lower);
        assert_eq(b.is_ascii_digit(), digit);
        assert_eq(b.is_ascii_alphanumeric(), upper || lower || digit);
        assert_eq(b.is_ascii_hexdigit(), in_hex);
        assert_eq(b.is_ascii_punctuation(), in_punct);
        assert_eq(b.is_ascii_graphic(), upper || lower || digit || in_punct);
        assert_eq(b.is_ascii_whitespace(), in_space);
        assert_eq(b.is_ascii_control(), i < 32 || i == 127);
        let up = if lower {
            b - 32
        } else {
            b
        };
        let down = if upper {
            b + 32
        } else {
            b
        };
        assert_eq(b.to_ascii_uppercase(), up);
        assert_eq(b.to_ascii_lowercase(), down);
        assert_eq(c.is_ascii(), b.is_ascii());
        assert_eq(c.is_ascii_uppercase(), upper);
        assert_eq(c.is_ascii_lowercase(), lower);
        assert_eq(c.is_ascii_alphabetic(), upper || lower);
        assert_eq(c.is_ascii_digit(), digit);
        assert_eq(c.is_ascii_alphanumeric(), upper || lower || digit);
        assert_eq(c.is_ascii_hexdigit(), in_hex);
        assert_eq(c.is_ascii_punctuation(), in_punct);
        assert_eq(c.is_ascii_graphic(), b.is_ascii_graphic());
        assert_eq(c.is_ascii_whitespace(), in_space);
        assert_eq(c.is_ascii_control(), b.is_ascii_control());
        assert_eq(c.to_ascii_uppercase(), up as char);
        assert_eq(c.to_ascii_lowercase(), down as char);
        for j in 0..256u32 {
            let o = j as u8;
            assert_eq(b.eq_ignore_ascii_case(o), down == o.to_ascii_lowercase());
            assert_eq(c.eq_ignore_ascii_case(o as char), down == o.to_ascii_lowercase());
        }
    }
}

// Every char in every radix against the digit list, and from_digit back.
@test
fn digits_match_the_digit_list() {
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz";
    for radix in 2..37u32 {
        for i in 0..256u32 {
            let c = (i as u8) as char;
            let low = c.to_ascii_lowercase() as u8;
            let mut want = Option::<u32>::None;
            for k in 0..radix as usize {
                if digits.byte_at(k) == low {
                    want = Some(k as u32);
                }
            }
            assert_eq(c.to_digit(radix), want);
        }
        for num in 0..40u32 {
            let d = char::from_digit(num, radix);
            assert_eq(d.is_some(), num < radix);
            if num < radix {
                assert_eq(d.unwrap() as u8, digits.byte_at(num as usize));
                assert_eq(d.unwrap().to_digit(radix), Some(num));
            }
        }
    }
}

// `then` runs its closure only when true; `then_some` drops its value when false (the leak check sees a
// lost String).
@test
fn bool_then_runs_only_when_true() {
    let zero = "".len();
    let skipped = false.then(|| 1 / zero);
    assert(skipped.is_none(), "then ran its closure on false");
    let taken = true.then(|| String::from("kept"));
    assert(taken.unwrap().as_str() == "kept", "then lost its value");
    let dropped = false.then_some(String::from("dropped"));
    assert(dropped.is_none(), "then_some kept a value on false");
    let some = true.then_some(String::from("some"));
    assert(some.unwrap().as_str() == "some", "then_some lost its value");
}

// A concrete f32 takes the prelude's `to_bits` (u32); a generic `T: sc::Float` keeps the interface's
// (u64).
fn interface_bits<T: sc::Float>(x: T) u64 {
    return x.to_bits();
}

@test
fn prelude_to_bits_and_the_float_interface_coexist() {
    let x: f32 = -2.0;
    let concrete: u32 = x.to_bits();
    assert_eq(concrete, 0xC000_0000u32);
    assert_eq(interface_bits(x), 0xC000_0000u64);
    assert_eq(interface_bits(-2.0f64), 0xC000_0000_0000_0000u64);
}

