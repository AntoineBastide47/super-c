// The float cases: constants, encodings, classes, neighbors, midpoint, Euclidean division, maximum and
// minimum.
const fn f32_check() u32 {
    let mut n: u32 = 0;
    let tiny = f32::from_bits(1);
    let qnan = f32::from_bits(0x7FC0_0001);
    n = check(n, 1, f32::EPSILON.to_bits() == 0x3400_0000);
    n = check(n, 2, f32::MIN_POSITIVE.to_bits() == 0x0080_0000);
    n = check(n, 3, f32::NAN.to_bits() == 0x7FC0_0000);
    n = check(n, 4, f32::INFINITY.to_bits() == 0x7F80_0000);
    n = check(n, 5, f32::NEG_INFINITY.to_bits() == 0xFF80_0000);
    n = check(n, 6, f32::RADIX == 2 && f32::MANTISSA_DIGITS == 24 && f32::DIGITS == 6);
    n = check(n, 7, f32::MIN_EXP == -125 && f32::MAX_EXP == 128);
    n = check(n, 8, f32::MIN_10_EXP == -37 && f32::MAX_10_EXP == 38);
    n = check(n, 9, 1.0f32 + f32::EPSILON != 1.0 && 1.0f32 + f32::EPSILON / 2.0 == 1.0);
    n = check(n, 10, 1.0f32.to_bits() == 0x3F80_0000);
    n = check(n, 11, (-0.0f32).to_bits() == 0x8000_0000);
    n = check(n, 12, qnan.to_bits() == 0x7FC0_0001);
    n = check(n, 13, f32::from_bits(0x4049_0FDB) == 3.14159274);
    n = check(n, 14, bytes_are(1.0f32.to_be_bytes(), [0x3F, 0x80, 0, 0]));
    n = check(n, 15, bytes_are(1.0f32.to_le_bytes(), [0, 0, 0x80, 0x3F]));
    n = check(n, 16, f32::from_be_bytes([0x3F, 0x80, 0, 0]) == 1.0);
    n = check(n, 17, f32::from_le_bytes([0, 0, 0x80, 0x3F]) == 1.0);
    n = check(n, 18, f32::from_ne_bytes(2.5f32.to_ne_bytes()) == 2.5);
    n = check(n, 19, 0.0f32.classify() == FpClass::FP_ZERO);
    n = check(n, 20, (-0.0f32).classify() == FpClass::FP_ZERO);
    n = check(n, 21, tiny.classify() == FpClass::FP_SUBNORMAL);
    n = check(n, 22, f32::from_bits(0x807F_FFFF).classify() == FpClass::FP_SUBNORMAL);
    n = check(n, 23, f32::MIN_POSITIVE.classify() == FpClass::FP_NORMAL);
    n = check(n, 24, f32::MAX.classify() == FpClass::FP_NORMAL);
    n = check(n, 25, (-1.0f32).classify() == FpClass::FP_NORMAL);
    n = check(n, 26, f32::INFINITY.classify() == FpClass::FP_INFINITE);
    n = check(n, 27, f32::NEG_INFINITY.classify() == FpClass::FP_INFINITE);
    n = check(n, 28, f32::NAN.classify() == FpClass::FP_NAN);
    n = check(n, 29, f32::from_bits(0xFF80_0001).classify() == FpClass::FP_NAN);
    n = check(n, 30, f32::MIN_POSITIVE.is_normal() && !tiny.is_normal() && !0.0f32.is_normal());
    n = check(n, 31, !f32::INFINITY.is_normal() && !f32::NAN.is_normal());
    n = check(n, 32, tiny.is_subnormal() && f32::from_bits(0x807F_FFFF).is_subnormal());
    n = check(n, 33, !0.0f32.is_subnormal() && !f32::MIN_POSITIVE.is_subnormal() && !f32::NAN.is_subnormal());
    n = check(n, 34, 0.0f32.next_up().to_bits() == 1);
    n = check(n, 35, (-0.0f32).next_up().to_bits() == 1);
    n = check(n, 36, f32::from_bits(0x8000_0001).next_up().to_bits() == 0x8000_0000);
    n = check(n, 37, f32::MAX.next_up() == f32::INFINITY);
    n = check(n, 38, f32::INFINITY.next_up() == f32::INFINITY);
    n = check(n, 39, f32::NEG_INFINITY.next_up() == f32::MIN);
    n = check(n, 40, qnan.next_up().to_bits() == 0x7FC0_0001);
    n = check(n, 41, 1.0f32.next_up() == 1.0 + f32::EPSILON);
    n = check(n, 42, f32::from_bits(0x007F_FFFF).next_up() == f32::MIN_POSITIVE);
    n = check(n, 43, (-1.0f32).next_up().to_bits() == 0xBF7F_FFFF);
    n = check(n, 44, 0.0f32.next_down().to_bits() == 0x8000_0001);
    n = check(n, 45, (-0.0f32).next_down().to_bits() == 0x8000_0001);
    n = check(n, 46, tiny.next_down().to_bits() == 0);
    n = check(n, 47, f32::MIN.next_down() == f32::NEG_INFINITY);
    n = check(n, 48, f32::NEG_INFINITY.next_down() == f32::NEG_INFINITY);
    n = check(n, 49, f32::INFINITY.next_down() == f32::MAX);
    n = check(n, 50, qnan.next_down().to_bits() == 0x7FC0_0001);
    n = check(n, 51, 1.0f32.next_down() == 1.0 - f32::EPSILON / 2.0);
    n = check(n, 52, f32::MIN_POSITIVE.next_down().to_bits() == 0x007F_FFFF);
    n = check(n, 53, 1.0f32.midpoint(3.0) == 2.0);
    n = check(n, 54, f32::MAX.midpoint(f32::MAX) == f32::MAX);
    n = check(n, 55, f32::MIN.midpoint(f32::MAX) == 0.0);
    n = check(n, 56, tiny.midpoint(tiny) == tiny);
    n = check(n, 57, f32::INFINITY.midpoint(1.0) == f32::INFINITY);
    n = check(n, 58, f32::INFINITY.midpoint(f32::NEG_INFINITY).is_nan());
    n = check(n, 59, f32::NAN.midpoint(1.0).is_nan());
    n = check(n, 60, 7.0f32.div_euclid(4.0) == 1.0 && (-7.0f32).div_euclid(4.0) == -2.0);
    n = check(n, 61, 7.0f32.div_euclid(-4.0) == -1.0 && (-7.0f32).div_euclid(-4.0) == 2.0);
    n = check(n, 62, 7.0f32.rem_euclid(4.0) == 3.0 && (-7.0f32).rem_euclid(4.0) == 1.0);
    n = check(n, 63, 7.0f32.rem_euclid(-4.0) == 3.0 && (-7.0f32).rem_euclid(-4.0) == 1.0);
    n = check(n, 64, 1.0f32.rem_euclid(0.0).is_nan());
    n = check(n, 65, 1.0f32.maximum(2.0) == 2.0 && 2.0f32.maximum(1.0) == 2.0);
    n = check(n, 66, f32::NAN.maximum(1.0).is_nan() && 1.0f32.maximum(f32::NAN).is_nan());
    n = check(n, 67, (-0.0f32).maximum(0.0).to_bits() == 0 && 0.0f32.maximum(-0.0).to_bits() == 0);
    n = check(n, 68, f32::NEG_INFINITY.maximum(f32::INFINITY) == f32::INFINITY);
    n = check(n, 69, 1.0f32.minimum(2.0) == 1.0 && 2.0f32.minimum(1.0) == 1.0);
    n = check(n, 70, f32::NAN.minimum(1.0).is_nan() && 1.0f32.minimum(f32::NAN).is_nan());
    n = check(n, 71, (-0.0f32).minimum(0.0).to_bits() == 0x8000_0000);
    n = check(n, 72, 0.0f32.minimum(-0.0).to_bits() == 0x8000_0000);
    n = check(n, 73, 1.0f32.max(f32::NAN) == 1.0 && 1.0f32.min(f32::NAN) == 1.0);
    return n;
}

const fn f64_check() u32 {
    let mut n: u32 = 0;
    let tiny = f64::from_bits(1);
    let qnan = f64::from_bits(0x7FF8_0000_0000_0001);
    n = check(n, 1, f64::EPSILON.to_bits() == 0x3CB0_0000_0000_0000);
    n = check(n, 2, f64::MIN_POSITIVE.to_bits() == 0x0010_0000_0000_0000);
    n = check(n, 3, f64::NAN.to_bits() == 0x7FF8_0000_0000_0000);
    n = check(n, 4, f64::INFINITY.to_bits() == 0x7FF0_0000_0000_0000);
    n = check(n, 5, f64::NEG_INFINITY.to_bits() == 0xFFF0_0000_0000_0000);
    n = check(n, 6, f64::RADIX == 2 && f64::MANTISSA_DIGITS == 53 && f64::DIGITS == 15);
    n = check(n, 7, f64::MIN_EXP == -1021 && f64::MAX_EXP == 1024);
    n = check(n, 8, f64::MIN_10_EXP == -307 && f64::MAX_10_EXP == 308);
    n = check(n, 9, 1.0 + f64::EPSILON != 1.0 && 1.0 + f64::EPSILON / 2.0 == 1.0);
    n = check(n, 10, 1.0f64.to_bits() == 0x3FF0_0000_0000_0000);
    n = check(n, 11, (-0.0f64).to_bits() == 0x8000_0000_0000_0000);
    n = check(n, 12, qnan.to_bits() == 0x7FF8_0000_0000_0001);
    n = check(n, 13, bytes_are(1.0f64.to_be_bytes(), [0x3F, 0xF0, 0, 0, 0, 0, 0, 0]));
    n = check(n, 14, bytes_are(1.0f64.to_le_bytes(), [0, 0, 0, 0, 0, 0, 0xF0, 0x3F]));
    n = check(n, 15, f64::from_be_bytes([0x3F, 0xF0, 0, 0, 0, 0, 0, 0]) == 1.0);
    n = check(n, 16, f64::from_le_bytes([0, 0, 0, 0, 0, 0, 0xF0, 0x3F]) == 1.0);
    n = check(n, 17, f64::from_ne_bytes(2.5f64.to_ne_bytes()) == 2.5);
    n = check(n, 18, 0.0f64.classify() == FpClass::FP_ZERO && (-0.0f64).classify() == FpClass::FP_ZERO);
    n = check(n, 19, tiny.classify() == FpClass::FP_SUBNORMAL);
    n = check(n, 20, f64::from_bits(0x800F_FFFF_FFFF_FFFF).classify() == FpClass::FP_SUBNORMAL);
    n = check(n, 21, f64::MIN_POSITIVE.classify() == FpClass::FP_NORMAL && f64::MAX.classify() == FpClass::FP_NORMAL);
    n = check(n, 22, f64::INFINITY.classify() == FpClass::FP_INFINITE);
    n = check(n, 23, f64::NEG_INFINITY.classify() == FpClass::FP_INFINITE);
    n = check(n, 24, f64::NAN.classify() == FpClass::FP_NAN && qnan.classify() == FpClass::FP_NAN);
    n = check(n, 25, f64::MIN_POSITIVE.is_normal() && !tiny.is_normal() && !f64::INFINITY.is_normal());
    n = check(n, 26, tiny.is_subnormal() && !0.0f64.is_subnormal() && !f64::MIN_POSITIVE.is_subnormal());
    n = check(n, 27, 0.0f64.next_up().to_bits() == 1 && (-0.0f64).next_up().to_bits() == 1);
    n = check(n, 28, f64::from_bits(0x8000_0000_0000_0001).next_up().to_bits() == 0x8000_0000_0000_0000);
    n = check(n, 29, f64::MAX.next_up() == f64::INFINITY && f64::INFINITY.next_up() == f64::INFINITY);
    n = check(n, 30, f64::NEG_INFINITY.next_up() == f64::MIN);
    n = check(n, 31, qnan.next_up().to_bits() == 0x7FF8_0000_0000_0001);
    n = check(n, 32, 1.0f64.next_up() == 1.0 + f64::EPSILON);
    n = check(n, 33, f64::from_bits(0x000F_FFFF_FFFF_FFFF).next_up() == f64::MIN_POSITIVE);
    n = check(n, 34, 0.0f64.next_down().to_bits() == 0x8000_0000_0000_0001);
    n = check(n, 35, tiny.next_down().to_bits() == 0);
    n = check(n, 36, f64::MIN.next_down() == f64::NEG_INFINITY && f64::INFINITY.next_down() == f64::MAX);
    n = check(n, 37, f64::NEG_INFINITY.next_down() == f64::NEG_INFINITY);
    n = check(n, 38, qnan.next_down().to_bits() == 0x7FF8_0000_0000_0001);
    n = check(n, 39, 1.0f64.next_down() == 1.0 - f64::EPSILON / 2.0);
    n = check(n, 40, 1.0f64.midpoint(3.0) == 2.0 && (-1.0f64).midpoint(-3.0) == -2.0);
    n = check(n, 41, f64::MAX.midpoint(f64::MAX) == f64::MAX && f64::MIN.midpoint(f64::MAX) == 0.0);
    n = check(n, 42, f64::MAX.midpoint(1.0) == f64::MAX / 2.0);
    n = check(n, 43, tiny.midpoint(f64::MAX) == f64::MAX / 2.0);
    n = check(n, 44, f64::MAX.midpoint(tiny) == f64::MAX / 2.0);
    n = check(n, 45, tiny.midpoint(tiny) == tiny);
    n = check(n, 46, f64::INFINITY.midpoint(1.0) == f64::INFINITY);
    n = check(n, 47, f64::INFINITY.midpoint(f64::NEG_INFINITY).is_nan() && f64::NAN.midpoint(1.0).is_nan());
    n = check(n, 48, 7.0f64.div_euclid(4.0) == 1.0 && (-7.0f64).div_euclid(4.0) == -2.0);
    n = check(n, 49, 7.0f64.div_euclid(-4.0) == -1.0 && (-7.0f64).div_euclid(-4.0) == 2.0);
    n = check(n, 50, 7.0f64.rem_euclid(4.0) == 3.0 && (-7.0f64).rem_euclid(4.0) == 1.0);
    n = check(n, 51, 7.0f64.rem_euclid(-4.0) == 3.0 && (-7.0f64).rem_euclid(-4.0) == 1.0);
    n = check(n, 52, 1.0f64.maximum(2.0) == 2.0 && 1.0f64.minimum(2.0) == 1.0);
    n = check(n, 53, f64::NAN.maximum(1.0).is_nan() && 1.0f64.minimum(f64::NAN).is_nan());
    n = check(n, 54, (-0.0f64).maximum(0.0).to_bits() == 0 && 0.0f64.minimum(-0.0).to_bits() == 0x8000_0000_0000_0000);
    n = check(n, 55, 0.0f64.maximum(-0.0).to_bits() == 0 && (-0.0f64).minimum(0.0).to_bits() == 0x8000_0000_0000_0000);
    return n;
}

// The bool, char and u8 cases.
const fn text_check() u32 {
    let mut n: u32 = 0;
    n = check(n, 1, true.then_some(3) == Option::<i32>::Some(3));
    n = check(n, 2, false.then_some(3) == Option::<i32>::None);
    n = check(n, 3, true.then(|| 4) == Option::<i32>::Some(4));
    n = check(n, 4, false.then(|| 4) == Option::<i32>::None);
    n = check(n, 5, 'z'.to_digit(36) == Option::<u32>::Some(35));
    n = check(n, 6, 'Z'.to_digit(36) == Option::<u32>::Some(35));
    n = check(n, 7, 'f'.to_digit(16) == Option::<u32>::Some(15));
    n = check(n, 8, 'g'.to_digit(16) == Option::<u32>::None);
    n = check(n, 9, '9'.to_digit(10) == Option::<u32>::Some(9));
    n = check(n, 10, '9'.to_digit(9) == Option::<u32>::None);
    n = check(n, 11, '1'.to_digit(2) == Option::<u32>::Some(1));
    n = check(n, 12, ' '.to_digit(36) == Option::<u32>::None);
    n = check(n, 13, (200 as char).to_digit(36) == Option::<u32>::None);
    n = check(n, 14, char::from_digit(11, 16) == Option::<char>::Some('b'));
    n = check(n, 15, char::from_digit(9, 10) == Option::<char>::Some('9'));
    n = check(n, 16, char::from_digit(35, 36) == Option::<char>::Some('z'));
    n = check(n, 17, char::from_digit(10, 10) == Option::<char>::None);
    n = check(n, 18, 'q'.to_ascii_uppercase() == 'Q' && 'Q'.to_ascii_lowercase() == 'q');
    n = check(n, 19, '@'.to_ascii_lowercase() == '@' && '['.to_ascii_lowercase() == '[');
    n = check(n, 20, '`'.to_ascii_uppercase() == '`' && '{'.to_ascii_uppercase() == '{');
    n = check(n, 21, (0xE1 as char).to_ascii_uppercase() == 0xE1 as char);
    n = check(n, 22, 'a'.eq_ignore_ascii_case('A') && !'a'.eq_ignore_ascii_case('b'));
    n = check(n, 23, !'@'.eq_ignore_ascii_case('`') && !'['.eq_ignore_ascii_case('{'));
    n = check(n, 24, b'~'.is_ascii_punctuation() && b'`'.is_ascii_punctuation() && !b' '.is_ascii_punctuation());
    n = check(n, 25, b'\t'.is_ascii_whitespace() && !0x0Bu8.is_ascii_whitespace() && 0x0Cu8.is_ascii_whitespace());
    n = check(n, 26, 0x7Fu8.is_ascii_control() && !b' '.is_ascii_control() && !b' '.is_ascii_graphic());
    n = check(n, 27, b'F'.is_ascii_hexdigit() && !b'G'.is_ascii_hexdigit() && b'f'.is_ascii_hexdigit());
    n = check(n, 28, 0x7Fu8.is_ascii() && !0x80u8.is_ascii() && !(0x80 as char).is_ascii());
    n = check(n, 29, b'a'.to_ascii_uppercase() == b'A' && b'Z'.to_ascii_lowercase() == b'z');
    n = check(n, 30, b'0'.is_ascii_digit() && b'9'.is_ascii_alphanumeric() && !b'/'.is_ascii_digit());
    return n;
}

// The integer cases: one line per case, numbered within each function.
const fn i8_check() u32 {
    let mut n: u32 = 0;
    n = check(n, 1, i8::BITS == 8);
    n = check(n, 2, i8::MIN.count_zeros() == 7);
    n = check(n, 3, i8::MIN.leading_ones() == 1);
    n = check(n, 4, i8::MIN.trailing_ones() == 0);
    n = check(n, 5, i8::MIN.swap_bytes() == i8::MIN);
    n = check(n, 6, i8::MIN.reverse_bits() == 1);
