pub enum TokenType {
    Identifier,
    Label,
    As,
    Import,
    Break,
    Case,
    Const,
    Continue,
    Defer,
    Do,
    Dyn,
    Else,
    Enum,
    Extern,
    False,
    Fn,
    For,
    If,
    Extend,
    In,
    Let,
    Loop,
    Switch,
    Move,
    Mut,
    New,
    Null,
    Pub,
    Sizeof,
    Alignof,
    Return,
    SelfLower,
    SelfUpper,
    Struct,
    Interface,
    True,
    Type,
    Union,
    Unsafe,
    Where,
    While,
    IntegerLiteral,
    FloatLiteral,
    CharacterLiteral,
    ByteCharacterLiteral,
    StringLiteral,
    RawStringLiteral,
    ByteStringLiteral,
    LeftBrace,
    RightBrace,
    LeftParen,
    RightParen,
    LeftBracket,
    RightBracket,
    Comma,
    Semicolon,
    Colon,
    Dot,
    At,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Tilde,
    Bang,
    Question,
    EqualEqual,
    BangEqual,
    LessThan,
    LessThanEqual,
    GreaterThan,
    GreaterThanEqual,
    Ampersand,
    Pipe,
    Caret,
    AmpersandAmpersand,
    PipePipe,
    LeftShift,
    RightShift,
    Equal,
    PlusEqual,
    MinusEqual,
    StarEqual,
    SlashEqual,
    PercentEqual,
    AmpersandEqual,
    PipeEqual,
    CaretEqual,
    LeftShiftEqual,
    RightShiftEqual,
    Range,
    RangeInclusive,
    Ellipsis,
    PathSeparator,
    Arrow,
    FatArrow,
    Eof,
}

extend TokenType {
    pub fn name(self: Self) str {
        return switch self {
            Identifier => "Identifier",
            Label => "Label",
            As => "As",
            Import => "Import",
            Break => "Break",
            Case => "Case",
            Const => "Const",
            Continue => "Continue",
            Defer => "Defer",
            Do => "Do",
            Dyn => "Dyn",
            Else => "Else",
            Enum => "Enum",
            Extern => "Extern",
            False => "False",
            Fn => "Fn",
            For => "For",
            If => "If",
            Extend => "Extend",
            In => "In",
            Let => "Let",
            Loop => "Loop",
            Switch => "Switch",
            Move => "Move",
            Mut => "Mut",
            New => "New",
            Null => "Null",
            Pub => "Pub",
            Sizeof => "Sizeof",
            Alignof => "Alignof",
            Return => "Return",
            SelfLower => "SelfLower",
            SelfUpper => "SelfUpper",
            Struct => "Struct",
            Interface => "Interface",
            True => "True",
            Type => "Type",
            Union => "Union",
            Unsafe => "Unsafe",
            Where => "Where",
            While => "While",
            IntegerLiteral => "IntegerLiteral",
            FloatLiteral => "FloatLiteral",
            CharacterLiteral => "CharacterLiteral",
            ByteCharacterLiteral => "ByteCharacterLiteral",
            StringLiteral => "StringLiteral",
            RawStringLiteral => "RawStringLiteral",
            ByteStringLiteral => "ByteStringLiteral",
            LeftBrace => "LeftBrace",
            RightBrace => "RightBrace",
            LeftParen => "LeftParen",
            RightParen => "RightParen",
            LeftBracket => "LeftBracket",
            RightBracket => "RightBracket",
            Comma => "Comma",
            Semicolon => "Semicolon",
            Colon => "Colon",
            Dot => "Dot",
            At => "At",
            Plus => "Plus",
            Minus => "Minus",
            Star => "Star",
            Slash => "Slash",
            Percent => "Percent",
            Tilde => "Tilde",
            Bang => "Bang",
            Question => "Question",
            EqualEqual => "EqualEqual",
            BangEqual => "BangEqual",
            LessThan => "LessThan",
            LessThanEqual => "LessThanEqual",
            GreaterThan => "GreaterThan",
            GreaterThanEqual => "GreaterThanEqual",
            Ampersand => "Ampersand",
            Pipe => "Pipe",
            Caret => "Caret",
            AmpersandAmpersand => "AmpersandAmpersand",
            PipePipe => "PipePipe",
            LeftShift => "LeftShift",
            RightShift => "RightShift",
            Equal => "Equal",
            PlusEqual => "PlusEqual",
            MinusEqual => "MinusEqual",
            StarEqual => "StarEqual",
            SlashEqual => "SlashEqual",
            PercentEqual => "PercentEqual",
            AmpersandEqual => "AmpersandEqual",
            PipeEqual => "PipeEqual",
            CaretEqual => "CaretEqual",
            LeftShiftEqual => "LeftShiftEqual",
            RightShiftEqual => "RightShiftEqual",
            Range => "Range",
            RangeInclusive => "RangeInclusive",
            Ellipsis => "Ellipsis",
            PathSeparator => "PathSeparator",
            Arrow => "Arrow",
            FatArrow => "FatArrow",
            Eof => "Eof",
        };
    }
}
