/// The code named `n`, or `NONE`.
pub(package) const fn by_name(n: str) u16 {
    if n.len() == 0 {
        return NONE;
    }
    for c in 1..COUNT {
        if name(c) == n {
            return c;
        }
    }
    return NONE;
}
