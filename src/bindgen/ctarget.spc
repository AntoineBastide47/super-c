// The C environment of one bindgen target, as clang (pinned to one release, `ctarget_data::PINNED_VERSION`)
// gives it to its preprocessor: predefined macros, `__has_*` answers, system include directories and
// built-in headers. Clang is the model for every target, Windows too, where the build compiles with
// mingw-w64 GCC: the parity oracle is `clang --target=x86_64-w64-mingw32` over the same sysroot.
// The tables are generated by `scripts/gen_ctarget.py`. macOS 11.0 is ctarget's floor, not the build's.

import stdlib;
import driver_shim as shim;
import std::platform::fs;
import module::loader as loader;
import driver::util as *;
import build_system::objcache as oc;
import bindgen::ctarget_data as data;
import bindgen::ctarget_headers as hdrs;
import target::table as tgt;

/// The directory name of the built-in headers in `CTarget.sys_dirs`; `builtin_header` serves its files.
pub const BUILTIN_DIR: str<'static> = "<super-c>";

/// One target's C environment.
pub struct CTarget {
    /// C text: `#define NAME VALUE` for every predefined macro, one per line.
    pub predefs: String,
    /// The true answers of `__has_feature`, `__has_extension`, `__has_attribute`, `__has_c_attribute`,
    /// `__has_builtin` and `__has_declspec_attribute`, keyed `feature:x`, `extension:x`, `attribute:x`,
    /// `c_attribute:x` (`x` may be `scope::name`), `builtin:x`, `declspec_attribute:x`; and of the
    /// `__is_target_*` operators, keyed `target_os:x`, `target_arch:x`, `target_vendor:x`,
    /// `target_environment:x`, `target_variant_os:x`, `target_variant_environment:x`.
    pub has: Vector<str<'static>>,
    /// System include directories in search order. `BUILTIN_DIR` stands for the built-in headers at the
    /// place the compiler searches its resource directory.
    pub sys_dirs: Vector<String>,
    /// Apple framework directories: `<Name/Header.h>` is `<dir>/Name.framework/Headers/Header.h`.
    pub frameworks: Vector<String>,
    /// The names of the built-in headers of the target's instruction set, each under `BUILTIN_DIR`.
    pub headers: Vector<str<'static>>,
}

/// The text of built-in header `name`; empty when there is none.
pub const fn builtin_header(name: str) str<'static> {
    let hs: []hdrs::Header = hdrs::HEADERS;
    for i in 0..hs.len() {
        if hs[i].name == name {
            return hs[i].text;
        }
    }
    return "";
}

// Applies the layers `ids` taken from `layers` in order into `out`: a line sets the entry of its name.
fn merge_layers(ids: []u8, layers: []str<'static>, out: &mut Vector<str<'static>>) {
    let mut at = Map::<str<'static>, usize>::new();
    for k in 0..ids.len() {
        if ids[k] == 255 {
            break;
        }
        let mut it = layers[ids[k] as usize].lines();
        while let Some(line) = it.next() {
            let key = entry_name(line);
            if let Some(slot) = at.get(&key) {
                out.set(*slot, line);
            } else {
                at.insert(key, out.len());
                out.push(line);
            }
        }
    }
}

// The name of a table entry: a macro line's identifier, else the whole `kind:name` line.
const fn entry_name<'a>(line: str<'a>) str<'a> {
    let mut e: usize = 0;
    while e < line.len() && line[e] != b' ' && line[e] != b'(' {
        e += 1;
    }
    return line.slice(0, e);
}

fn fill_tables(row: &data::Row, out: &mut CTarget) {
    let ver = data::PINNED_VERSION;
    let mut parts = ver.split(".");
    let major = parts.next().unwrap();
    let minor = parts.next().unwrap();
    let patch = parts.next().unwrap();
    out.predefs.format_into(
        "#define __clang_major__ {}\n#define __clang_minor__ {}\n#define __clang_patchlevel__ {}\n#define __clang_version__ \"{}\"\n#define __VERSION__ \"Clang {}\"\n",
        major,
        minor,
        patch,
        ver,
        ver,
    );
    let ml: []str<'static> = data::MACRO_LAYERS;
    let mut lines = Vector::<str<'static>>::new();
    merge_layers(row.layers, ml, &mut lines);
    for i in 0..lines.len() {
        out.predefs.push_str("#define ");
        out.predefs.push_str(lines[i]);
        out.predefs.push_byte(b'\n');
    }
    let hl: []str<'static> = data::HAS_LAYERS;
    merge_layers(row.layers, hl, &mut out.has);
}

// `Header.arch` holds bit `i` for instruction set `i` (a `target::table::ISAS` index).
fn fill_headers(arch: i32, out: &mut CTarget) {
    let hs: []hdrs::Header = hdrs::HEADERS;
    for i in 0..hs.len() {
        if (hs[i].arch >> arch as u8 & 1) != 0 {
            out.headers.push(hs[i].name);
        }
    }
}

// `path` without trailing slashes: the root "/" becomes "".
const fn trim_slashes(path: str) str {
    let mut e = path.len();
    while e > 0 && path[e - 1] == b'/' {
        e -= 1;
    }
    return path.slice(0, e);
}

fn push_dir(prefix: str, suffix: str, out: &mut Vector<String>) {
    let p = format("{}{}", prefix, suffix);
    if is_dir(p.as_str()) {
        out.push(p);
    }
}

fn no_sysroot(row: &data::Row, hint: str) bool {
    eprintln("super-c: no sysroot found for {}; {}", row.triple, hint);
    return false;
}

/// The SDK of an Apple target, found as `xcrun` finds it from the build's toolchain lookup (`objcache::cc_identity`):
/// $SDKROOT (macOS only), else the SDKs of $DEVELOPER_DIR, the `xcode-select` directory and the Command Line Tools,
/// in that order. No process runs. The SDK's platform name is the target's (`apple_sdk`).
pub fn apple_sdk(t: &tgt::Target, out: &mut String) bool {
    // `xcrun --sdk` honors $SDKROOT only for the system it runs on, so does this; "/" counts as unset.
    if tgt::os(t.os).sdk == tgt::SDK_NONE {
        let env = stdlib::get_env("SDKROOT").unwrap_or(String::new());
        let root = trim_slashes(env.as_str());
        if root.len() != 0 && is_dir(root) {
            out.push_str(root);
            return true;
        }
    }
    if !tgt::os(unsafe shim::sc_host_platform()).darwin {
        return false;
    }
    let platform = t.apple_sdk;
    let devs = [
        stdlib::get_env("DEVELOPER_DIR").unwrap_or(String::new()),
        oc::xcode_select_dir(),
        String::from_str("/Library/Developer/CommandLineTools"),
    ];
    for d in devs {
        if d.len() == 0 {
            continue;
        }
        let xcode = format("{}/Platforms/{}.platform/Developer/SDKs/{}.sdk", d.as_str(), platform, platform);
        let tools = format("{}/SDKs/{}.sdk", d.as_str(), platform);
        for c in [xcode, tools] {
            if is_dir(c.as_str()) {
                out.push_string(&c);
                return true;
            }
        }
    }
    return false;
}

// Clang searches `<sdk>/usr/local/include`, its resource directory, then `<sdk>/usr/include`.
fn apple_dirs(t: &tgt::Target, row: &data::Row, sysroot: str, out: &mut CTarget) bool {
    let mut sdk = String::from_str(trim_slashes(sysroot));
    if sysroot.len() == 0 && !apple_sdk(t, &mut sdk) {
        return no_sysroot(row, "set SDKROOT or DEVELOPER_DIR, or pass the SDK path");
    }
    let base = sdk.as_str();
    push_dir(base, "/usr/local/include", &mut out.sys_dirs);
    out.sys_dirs.push(String::from_str(BUILTIN_DIR));
    push_dir(base, "/usr/include", &mut out.sys_dirs);
    push_dir(base, "/System/Library/Frameworks", &mut out.frameworks);
    push_dir(base, "/System/Library/SubFrameworks", &mut out.frameworks);
    push_dir(base, "/Library/Frameworks", &mut out.frameworks);
    return true;
}

// The directories clang searches for a Linux or Android libc under `root` (the sysroot, "" for the
// running system), in its order; only the ones that exist.
fn elf_dirs(root: str, dir: str, out: &mut Vector<String>) {
    out.push(String::from_str(BUILTIN_DIR));
    push_dir(root, "/usr/local/include", out);
    let multiarch = format("/usr/include/{}", dir);
    push_dir(root, multiarch.as_str(), out);
    push_dir(root, "/include", out);
    push_dir(root, "/usr/include", out);
}

fn linux_dirs(t: &tgt::Target, row: &data::Row, sysroot: str, out: &mut CTarget) bool {
    if sysroot.len() == 0 {
        // The running system serves its own architecture; another one, or a compiler under a WASI runtime
        // on Linux, only through a multiarch directory that holds the target's headers.
        let multiarch = format("/usr/include/{}", row.dir);
        let native = unsafe shim::sc_host_platform() == t.os as i32 && unsafe shim::sc_host_arch() == t.isa as i32;
        let ok = is_dir("/usr/include") && (native || is_dir(multiarch.as_str()));
        if !ok {
            return no_sysroot(row, "pass the sysroot");
        }
    }
    elf_dirs(trim_slashes(sysroot), row.dir, &mut out.sys_dirs);
    return true;
}

fn android_dirs(row: &data::Row, sysroot: str, out: &mut CTarget) bool {
    let mut root = String::from_str(trim_slashes(sysroot));
    if sysroot.len() == 0 {
        if !ndk_llvm(&mut root) {
            return no_sysroot(row, "set ANDROID_NDK_HOME or pass the NDK sysroot");
        }
        root.push_str("/sysroot");
    }
    elf_dirs(root.as_str(), row.dir, &mut out.sys_dirs);
    return true;
}

// The directory above `bin` of the first mingw-w64 toolchain in PATH. Only the layout is read:
// `$CC`, then the `<triple>-gcc` and `<triple>-clang` drivers, then `gcc`, `cc` and `clang`.
fn mingw_root(dir: str, out: &mut String) bool {
    let mut names = Vector::<String>::new();
    let cc = stdlib::get_env("CC").unwrap_or(String::new());
    if cc.len() != 0 {
        names.push(cc);
    }
    names.push(format("{}-gcc", dir));
    names.push(format("{}-clang", dir));
    for n in ["gcc", "cc", "clang"] {
        names.push(String::from_str(n));
    }
    for i in 0..names.len() {
        let mut found = String::new();
        if oc::which_path(names[i].as_str(), &mut found) == 0 {
            continue;
        }
        let resolved = fs::realpath(found.as_str());
        if resolved.is_err() {
            continue;
        }
        let real = resolved.unwrap();
        let bin = loader::dirname_of(real.as_str());
        let root = loader::dirname_of(bin);
        if is_mingw_tree(root, dir) {
            out.push_str(root);
            return true;
        }
    }
    return false;
}

// Whether `root` is a mingw-w64 tree: `_mingw.h` sits in `<root>/<triple>/include` or `<root>/include`
// (which tells it from the system's own `include`).
fn is_mingw_tree(root: str, dir: str) bool {
    let base = trim_slashes(root);
    for c in [format("{}/{}/include", base, dir), format("{}/include", base)] {
        let marker = format("{}/_mingw.h", c.as_str());
        if file_mtime(marker.as_str()) != 0 {
            return true;
        }
    }
    return false;
}

fn windows_dirs(row: &data::Row, sysroot: str, out: &mut CTarget) bool {
    let mut root = String::from_str(sysroot);
    if sysroot.len() == 0 && !mingw_root(row.dir, &mut root) {
        return no_sysroot(row, "put a mingw-w64 toolchain in PATH or pass its root");
    }
    if !is_mingw_tree(root.as_str(), row.dir) {
        eprintln("super-c: '{}' holds no mingw-w64 headers for {}", root.as_str(), row.triple);
        return false;
    }
    // Clang searches the three directories a mingw-w64 tree may hold, in this order.
    let base = trim_slashes(root.as_str());
    out.sys_dirs.push(String::from_str(BUILTIN_DIR));
    let triple_inc = format("/{}/include", row.dir);
    let triple_usr = format("/{}/usr/include", row.dir);
    push_dir(base, triple_inc.as_str(), &mut out.sys_dirs);
    push_dir(base, triple_usr.as_str(), &mut out.sys_dirs);
    push_dir(base, "/include", &mut out.sys_dirs);
    return true;
}

fn wasm_dirs(row: &data::Row, sysroot: str, out: &mut CTarget) bool {
    let mut root = String::from_str(trim_slashes(sysroot));
    if sysroot.len() == 0 && !wasi_sysroot(&mut root) {
        return no_sysroot(row, "set WASI_SDK_PATH or WASI_SYSROOT");
    }
    out.sys_dirs.push(String::from_str(BUILTIN_DIR));
    let multiarch = format("/include/{}", row.dir);
    push_dir(root.as_str(), multiarch.as_str(), &mut out.sys_dirs);
    push_dir(root.as_str(), "/include", &mut out.sys_dirs);
    return true;
}

/// Fills `out` with the C environment of `target` and `arch` (`target::table` indexes, as every
/// driver entry takes them). `sysroot` is the target's C library tree: the SDK of macOS and iOS, the root of a
/// Linux or Android tree, the root of a mingw-w64 tree, the wasi sysroot. Empty: discover it, as the
/// build does where it can: `$SDKROOT`, then the SDKs of `$DEVELOPER_DIR`, `xcode-select` and the
/// Command Line Tools for macOS and iOS; `/` for Linux on its own architecture; the NDK of
/// `$ANDROID_NDK_HOME` or `$ANDROID_NDK_ROOT` for Android; the mingw-w64 tree above the `bin` directory
/// of the toolchain in PATH for Windows; the wasi-sdk of `$WASI_SDK_PATH` or the sysroot of
/// `$WASI_SYSROOT` for wasm. Returns false, with a message on stderr, for an unknown pair or when no
/// sysroot exists.
pub fn c_target(target: i32, arch: i32, sysroot: str, out: &mut CTarget) bool {
    let to = tgt::target_of(target, arch);
    if to.is_none() {
        eprintln("super-c: no C environment for target code {} with arch code {}", target, arch);
        return false;
    }
    let tv = to.unwrap();
    let t = &tv;
    let rows: []data::Row = data::ROWS;
    let row = &rows[t.cenv as usize];
    *out = CTarget::new();
    let sr = tgt::os(target).sysroot;
    let ok = if sr == tgt::SYSROOT_APPLE {
        apple_dirs(t, row, sysroot, out);
    } else if sr == tgt::SYSROOT_LINUX {
        linux_dirs(t, row, sysroot, out);
    } else if sr == tgt::SYSROOT_ANDROID {
        android_dirs(row, sysroot, out);
    } else if sr == tgt::SYSROOT_MINGW {
        windows_dirs(row, sysroot, out);
    } else {
        wasm_dirs(row, sysroot, out);
    };
    if !ok {
        return false;
    }
    if out.sys_dirs.len() <= 1 {
        eprintln("super-c: no system include directory found for {}", row.triple);
        return false;
    }
    fill_tables(row, out);
    fill_headers(arch, out);
    return true;
}

// ---- The C dialect --------------------------------------------------------------------------------

// Drops the `#define` lines of macro `name` from `predefs`.
fn undefine(predefs: &mut String, name: str) {
    let old = replace(predefs, String::new());
    let mut it = old.as_str().lines();
    while let Some(line) = it.next() {
        if !line.starts_with("#define ") || entry_name(line.slice(8, line.len())) != name {
            predefs.push_str(line);
            predefs.push_byte(b'\n');
        }
    }
}

// Defines the macro `text` (`NAME VALUE` or `NAME(args) VALUE`), replacing an earlier definition.
fn define(predefs: &mut String, text: str) {
    undefine(predefs, entry_name(text));
    predefs.push_str("#define ");
    predefs.push_str(text);
    predefs.push_byte(b'\n');
}

// The value of macro `name` in `predefs`; empty when undefined.
const fn value_of<'a>(predefs: &'a String, name: str) str<'a> {
    let mut it = predefs.as_str().lines();
    while let Some(line) = it.next() {
        if line.starts_with("#define ") {
            let body = line.slice(8, line.len());
            if entry_name(body) == name && body.len() > name.len() {
                return body.slice(name.len() + 1, body.len());
            }
        }
    }
    return "";
}

// Applies `-std=<std>` to the clang default dialect (gnu17): the macros clang changes for it. False for
// a value this environment does not model.
fn apply_std(predefs: &mut String, std: str) bool {
    let mut strict = true;
    let mut name = std;
    if std.starts_with("gnu") {
        strict = false;
        name = std.slice(3, std.len());
    } else if !std.starts_with("c") {
        return false;
    } else {
        name = std.slice(1, std.len());
    }
    // 0: no __STDC_VERSION__ (C89), else the value; C23 and later add the binary format and char8_t macros.
    let version = if name == "89" || name == "90" {
        "";
    } else if name == "99" {
        "199901L";
    } else if name == "11" {
        "201112L";
    } else if name == "17" || name == "18" {
        "201710L";
    } else if name == "23" || name == "2x" {
        "202311L";
    } else if name == "2y" {
        "202400L";
    } else {
        return false;
    };
    if version.len() == 0 {
        undefine(predefs, "__STDC_VERSION__");
        undefine(predefs, "__GNUC_STDC_INLINE__");
        define(predefs, "__GNUC_GNU_INLINE__ 1");
    } else {
        define(predefs, format("__STDC_VERSION__ {}", version).as_str());
    }
    if strict {
        define(predefs, "__STRICT_ANSI__ 1");
        // The names that are not in the implementation's namespace go.
        let names: []str<'static> = tgt::STRICT_UNDEFINED;
        for n in names {
            undefine(predefs, n);
        }
    }
    if name == "23" || name == "2x" || name == "2y" {
        let mut extra = Vector::<String>::new();
        let mut it = predefs.as_str().lines();
        while let Some(line) = it.next() {
            if line.starts_with("#define __") {
                let body = line.slice(8, line.len());
                let n = entry_name(body);
                if n.ends_with("_FMTx__") && body.ends_with("x\"") {
                    let stem = n.slice(0, n.len() - 7);
                    let val = body.slice(n.len() + 1, body.len() - 2);
                    extra.push(format("{}_FMTB__ {}B\"", stem, val));
                    extra.push(format("{}_FMTb__ {}b\"", stem, val));
                }
            }
        }
        let lock = String::from_str(value_of(predefs, "__CLANG_ATOMIC_CHAR_LOCK_FREE"));
        // The default dialect lacks all of these, so they are appended.
        for i in 0..extra.len() {
            predefs.format_into("#define {}\n", extra[i].as_str());
        }
        predefs.format_into(
            "#define __CHAR8_TYPE__ unsigned char\n#define __CLANG_ATOMIC_CHAR8_T_LOCK_FREE {}\n#define __GCC_ATOMIC_CHAR8_T_LOCK_FREE {}\n",
            lock.as_str(),
            lock.as_str(),
        );
    }
    return true;
}

/// Applies the C compiler flags `flags` (whitespace separated, as the manifest's `cstd` and `cflags`
/// give them) to the predefined macros of `out`, as clang would predefine them: `-std=` (c89, c90, c99,
/// c11, c17, c18, c23, c2x, c2y and the gnu spellings), `-D`, `-U` (joined to the flag or the next
/// word), `-funsigned-char` and `-fsigned-char`. Any other flag is rejected with a message on stderr
/// and false. The last `-std=` wins and is applied first, before the `-D`, `-U` and char flags, which
/// apply in order, as clang predefines the dialect before the command line's macros.
pub fn apply_c_flags(flags: str, out: &mut CTarget) bool {
    let mut words = Vector::<String>::new();
    let mut a: usize = 0;
    for i in 0..flags.len() + 1 {
        if i == flags.len() || flags[i] == b' ' || flags[i] == b'\t' {
            if i > a {
                words.push(String::from_str(flags.slice(a, i)));
            }
            a = i + 1;
        }
    }
    let base = out.predefs.clone();
    let mut std = "";
    let mut at: usize = 0;
    while at < words.len() {
        let w = words[at].as_str();
        if w.starts_with("-std=") {
            std = w.slice(5, w.len());
        }
        at += 1;
    }
    if std.len() != 0 && !apply_std(&mut out.predefs, std) {
        eprintln("super-c: the C dialect '-std={}' is not modelled by bindgen's C environment", std);
        out.predefs = base;
        return false;
    }
    at = 0;
    while at < words.len() {
        let w = words[at].as_str();
        at += 1;
        if w.starts_with("-std=") {
            continue;
        }
        if w == "-funsigned-char" {
            define(&mut out.predefs, "__CHAR_UNSIGNED__ 1");
        } else if w == "-fsigned-char" {
            undefine(&mut out.predefs, "__CHAR_UNSIGNED__");
        } else if w.starts_with("-D") || w.starts_with("-U") {
            let mut arg = w.slice(2, w.len());
            if arg.len() == 0 && at < words.len() {
                arg = words[at].as_str();
                at += 1;
            }
            if arg.len() == 0 {
                eprintln("super-c: '{}' needs a macro name", w);
                out.predefs = base;
                return false;
            }
            if w.starts_with("-U") {
                undefine(&mut out.predefs, entry_name(arg));
            } else {
                let e = arg.find_byte(b'=');
                if e < 0 {
                    define(&mut out.predefs, format("{} 1", arg).as_str());
                } else {
                    define(
                        &mut out.predefs,
                        format("{} {}", arg.slice(0, e as usize), arg.slice(e as usize + 1, arg.len())).as_str(),
                    );
                }
            }
        } else {
            eprintln("super-c: the C flag '{}' is not modelled by bindgen's C environment", w);
            out.predefs = base;
            return false;
        }
    }
    return true;
}

extend CTarget {
    /// An empty environment, for `c_target` to fill.
    pub fn new() CTarget {
        return CTarget {
            predefs: String::new(),
            has: Vector::<str<'static>>::new(),
            sys_dirs: Vector::<String>::new(),
            frameworks: Vector::<String>::new(),
            headers: Vector::<str<'static>>::new(),
        };
    }
}
