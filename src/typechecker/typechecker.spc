// Type checking for one module: consumes the resolver's AST (+ the Package for imports) and types it
// in place: per-node/decl TypeIds, member/method resolutions, call_info, dyn uses, deref chains and
// generic instances: everything the borrowck pass and codegen read. Borrow/move/lifetime analysis is
// the separate src/borrowck stage (extends TypeChecker, replays bodies after check()); the flow/borrow/
// region fields here are its state. Invariant: TC-* memoizations must not change type-pool interning
// order: emitted C is byte-compared across bootstrap generations.
import string as cstring;
import stdio;
import math;
import lexer::token as tok;
import lexer::token_type as *;
import ast::ast as *;
import graph::items as gitems;
import module::loader as loader;
import pattern::pattern as pat;
import ir::interp as iri;
import ir::layout as lay;
import typechecker::infer as inf;
import utils::errors as diag;

/// Alias-chain hops before a cycle is reported.
pub const TYPE_ALIAS_MAX_DEPTH: u32 = 64;
pub type Lits8 = Array<u8, 8>;
/// Candidates one call may weigh; the collector stops here and past it the call is an error.
pub const TC_MAX_CANDIDATES: usize = 8;
/// `tc_dyn_conf` verdicts: a conformance with the dyn type's arguments exists, none exists (a
/// type mismatch), or only conformances with other arguments exist (reported there).
const DYN_CONF_OK: u8 = 0;
const DYN_CONF_NONE: u8 = 1;
const DYN_CONF_REPORTED: u8 = 2;

// One candidate's lexicographic score: fewer safe conversions, then fewer reference
// adjustments, then fewer literal defaults, then fewer generic defaults, then more exact matches.
struct CandScore {
    pub viable: bool,
    pub conv: i32,
    pub radj: i32,
    pub litd: i32,
    pub gdef: i32,
    pub exact: i32,
}

const fn score_better(a: &CandScore, b: &CandScore) bool {
    if a.conv != b.conv {
        return a.conv < b.conv;
    }
    if a.radj != b.radj {
        return a.radj < b.radj;
    }
    if a.litd != b.litd {
        return a.litd < b.litd;
    }
    if a.gdef != b.gdef {
        return a.gdef < b.gdef;
    }
    return a.exact > b.exact;
}

/// Walk budgets: bound nesting, place projection steps, match variants, and borrow-escape depth.
pub const BOUND_MAX_DEPTH: i32 = 8;
/// The deferred reflection-bound obligations one module may hold (`Ast.proj_obs`).
pub const PROJ_OBS_MAX: usize = 1024;
pub const PLACE_MAX_STEPS: i32 = 16;
pub const MATCH_MAX_VARIANTS: u32 = 256;
/// Aggregates the infinite-size check follows by value from one declaration before it reports the
/// type as too deep: a generic that holds itself with a growing argument never ends the walk.
pub const BYVAL_MAX_DEPTH: i32 = 64;
pub const BORROW_ESCAPE_MAX_DEPTH: u32 = 64;
/// `tc_type_is_free`'s walk: no assumption made, and the stack depth past which it cuts.
const FREE_BUSY_NONE: i64 = 0x7FFFFFFFFFFFFFFFi64;
const FREE_WALK_MAX: usize = 64;

/// Borrow kinds (Borrow.kind).
pub const BORROW_SHARED: u8 = 0;
pub const BORROW_MUT: u8 = 1;
/// The reserved RegionVid for `'static`: outlives every other region.
pub const REGION_STATIC: u32 = 0;
/// "no region": a lifetime name that denotes nothing in the current signature.
pub const REGION_NONE: u32 = 0xFFFFFFFF;
/// Place-projection step kinds (PStep.kind).
pub const PS_FIELD: u8 = 0;
pub const PS_INDEX: u8 = 1;
pub const PS_DEREF: u8 = 2;

/// Variance of a type/lifetime parameter in an aggregate, 2 bits, packed LSB-first per parameter
/// (lifetime params first, then type params). Drives subtyping: `C<'a> <: C<'b>` requires 'a and 'b
/// related per C's variance in that slot. BIVARIANT is the lattice bottom (unconstrained); INVARIANT
/// the top. Bit 0 marks a covariant use and bit 1 a contravariant one, so the join (v_join) is a bitwise
/// or; composition is v_transform.
pub const V_BIVARIANT: u32 = 0;
pub const V_COVARIANT: u32 = 1;
pub const V_CONTRAVARIANT: u32 = 2;
pub const V_INVARIANT: u32 = 3;

/// Fixed-size scratch arrays (a struct field zero-inits its array).
pub type Buf96 = Array<char, 96>;
pub type Defs8 = Array<DefId, 8>;
pub type Tys8 = Array<TypeId, 8>;
pub type BoundArr8 = Array<BoundIface, 8>;
// The String methods the print lowering calls by name, with no type-checked call node.
const FORMAT_HELPERS: [str<'static>; 16] = [
    "new",
    "print",
    "eprint",
    "push_i64",
    "push_u64",
    "push_f64",
    "push_hex_i64",
    "push_hex",
    "push_byte",
    "push_str",
    "as_str",
    "push_bin",
    "push_f64_prec",
    "push_padded",
    "pad_at",
    "len",
];
// The other method names codegen synthesizes calls to: auto-free, operators, indexing, `for`, `?`.
const SYNTH_METHODS: [str<'static>; 10] = [
    "free",
    "eq",
    "cmp",
    "index",
    "index_mut",
    "index_range",
    "index_range_mut",
    "next",
    "from",
    "try_from",
];
pub type Steps16 = Array<PStep, 16>;
pub type Keep256 = Array<bool, 256>;
/// Worklist/visited scratch for the outlives closure. The DECLARED outlives graph is signature-sized
/// (a handful of lifetimes), so 32 is ample; overflowing answers "cannot prove", which over-rejects.
pub type Regions32 = Array<u32, 32>;
/// Field-chain scratch for resolving a store slot's lifetime through nested aggregates.
pub type Nodes8 = Array<NodeId, 8>;
pub type Spans8 = Array<tok::Span, 8>;

/// A live borrow: `root` = the borrowed place's base binding, `place` = the place node, `origin` = the
/// expression that created it, `binding` = the binding holding it (NODE_NONE = transient, released at
/// statement end), `region` = scope depth at creation, `kind` = BORROW_SHARED/BORROW_MUT.
pub struct Borrow {
    pub root: NodeId,
    pub place: NodeId,
    pub origin: NodeId,
    pub binding: NodeId,
    pub region: u16,
    pub kind: u8,
}

/// One access step of a decomposed place (see place_decompose): PS_FIELD (`name`), PS_INDEX
/// (`index_val` valid when `index_const`), or PS_DEREF.
pub struct PStep {
    pub kind: u8,
    pub index_const: bool,
    pub index_val: i64,
    pub name: tok::Span,
}

/// An interface bound plus its lowered type arguments (`n` <= 8).
pub struct BoundIface {
    pub iface: DefId,
    pub n: u8,
    pub args: [TypeId; 8],
}

/// One enclosing loop of the statement under check: its label, node, and `break <value>` type.
pub struct LoopEntry {
    pub label: tok::Span,
    pub node: NodeId,
    pub break_ty: TypeId,
    pub value_loop: bool,
    pub saw_value: bool,
    pub saw_bare: bool,
    // Scope depth on entry to this loop. A binding declared DEEPER than this lives inside the loop
    // body and therefore dies at the end of each iteration, which is what makes source-order
    // last-use reasoning valid for it despite the back edge (see borrow_dead_after).
    pub depth: u32,
}

/// Snapshot of the borrow pass's flow state (moves, split initializations, borrows), saved
/// and merged around branches; only the counted prefixes are touched. Each array is as large as the
/// matching TypeChecker table, so a snapshot holds every state the live checker can hold.
pub struct FlowState {
    pub moved: [NodeId; 1024],
    pub nmoved: u32,
    pub late: [NodeId; 256],
    pub nlate: u32,
    pub borrows: [Borrow; 256],
    pub nborrows: u32,
}

/// One extend in the per-checker target index (`TypeChecker::ext_begin`); `next` links the extends
/// of one target, EXT_END ends the list.
struct ExtHit {
    pub m: ModuleId,
    pub node: NodeId,
    pub next: u32,
    pub scoped: bool, // `m` is in the extension scope
}

const EXT_END: u32 = 0xFFFFFFFFu32;

/// A walk over one target's extends: pass 0 yields the target module's, pass 1 the other scoped ones.
struct ExtCursor {
    pub tmod: ModuleId,
    pub head: u32,
    pub at: u32,
    pub pass: u8,
}

/// Method/assoc-const/default-method query key. `name` is a CONTENT view (span slice of the
/// querying module's source, or the caller's literal), so span- and cstr-form queries for the same
/// name share one entry. Exact-keyed (Hash + full Eq), so collisions cannot alias.
pub struct MQKey<'a> {
    pub m: ModuleId,
    pub decl: NodeId,
    pub kind: u8,
    pub name: str<'a>,
}

extend MQKey as Hash {
    pub fn hash(self: &Self) u64 {
        let mut h: u64 = 0xcbf29ce484222325u64;
        h = (h ^ self.m as u64).wrapping_mul(1099511628211u64);
        h = (h ^ self.decl as u64).wrapping_mul(1099511628211u64);
        h = (h ^ self.kind as u64).wrapping_mul(1099511628211u64);
        return (h ^ self.name.hash()).wrapping_mul(1099511628211u64);
    }
}

extend MQKey as Eq {
    pub fn eq(self: &Self, other: &Self) bool {
        return self.m == other.m && self.decl == other.decl && self.kind == other.kind && self.name == other.name;
    }
}

/// A bound or marker query (`TypeChecker::sat_memo`): `kind` 0 asks `iface` (with the arguments of
/// `dyn` type `args`, or any when TYPE_NONE), 1 `Copy`, 2 `Send`, 3 `Sync`.
struct SatKey {
    pub ty: TypeId,
    pub depth: i32,
    pub kind: u32,
    pub iface: DefId,
    pub args: TypeId,
}

extend SatKey as Hash {
    pub fn hash(self: &Self) u64 {
        let h = (self.ty as u64 << 32 | self.iface.node as u64).wrapping_mul(0x9E3779B97F4A7C15u64);
        return (h ^ self.args as u64).wrapping_mul(0x9E3779B97F4A7C15u64) ^ (self.iface.module as u64 << 8 | self.kind as u64 << 4 | self.depth as u64);
    }
}

extend SatKey as Eq {
    pub fn eq(self: &Self, other: &Self) bool {
        return self.ty == other.ty && self.depth == other.depth && self.kind == other.kind && self.iface.module == other.iface.module && self.iface.node == other.iface.node && self.args == other.args;
    }
}

/// An open `sat_memo` frame: the side-effect count and `mark_n` at entry; `on` is false under a
/// `tc_type_is_free` walk.
struct SatFrame {
    pub fx: usize,
    pub mark_n: u32,
    pub on: bool,
}

/// An (interface, target) conformance pair: the duplicate-conformance indexes' key.
pub struct ConfKey {
    pub iface: DefId,
    pub tgt: DefId,
}

extend ConfKey as Hash {
    pub fn hash(self: &Self) u64 {
        let h = (self.iface.module as u64 << 32 | self.iface.node as u64).wrapping_mul(0x9E3779B97F4A7C15u64);
        return h ^ (self.tgt.module as u64 << 32 | self.tgt.node as u64);
    }
}

extend ConfKey as Eq {
    pub fn eq(self: &Self, other: &Self) bool {
        return self.iface.module == other.iface.module && self.iface.node == other.iface.node && self.tgt.module == other.tgt.module && self.tgt.node == other.tgt.node;
    }
}

// The (interface, target) key of top-level extend `id` when it states a conformance to an interface
// written without arguments; `iface.node` is NODE_NONE otherwise.
fn dup_conf_key(a: &Ast, id: NodeId) ConfKey {
    let none = ConfKey { iface: DefId { module: 0, node: NODE_NONE }, tgt: DefId { module: 0, node: NODE_NONE } };
    if a.at_const(id).kind != NodeKind::NODE_EXTEND {
        return none;
    }
    let itype = a.at_const(id).as_data.extend_def.interface_type;
    if itype == NODE_NONE {
        return none;
    }
    if a.at_const(itype).kind == NodeKind::NODE_TYPE_PATH && a.at_const(itype).as_data.type_path.args.len != 0 {
        return none;
    }
    let k = ConfKey {
        iface: a.resolution_def(itype),
        tgt: a.resolution_def(a.at_const(id).as_data.extend_def.target_type),
    };
    if k.tgt.node == NODE_NONE {
        return none;
    }
    return k;
}

/// The first extend of each conformance `check_cross_module_dup_conformances` compares, in module
/// then item order: its key -> module << 32 | extend node. Built once for the package.
pub fn dup_conformance_index(p: &loader::Package) Map<ConfKey, u64> {
    let mut idx = Map::<ConfKey, u64>::new();
    for j in 0..p.modules.len() {
        let a = &p.modules[j].ast;
        let items = a.at_const(a.root).as_data.program.items;
        for k in 0..items.len {
            let id = unsafe a.list(items)[k as usize];
            let key = dup_conf_key(a, id);
            if key.iface.node != NODE_NONE && !idx.contains_key(&key) {
                idx.insert(key, j as u64 << 32 | id as u64);
            }
        }
    }
    return idx;
}

/// Parallel-frontier capture of the package-global method marks: replayed by the driver in module
/// order through the real functions.
pub struct TcMarkLog {
    pub kinds: Vector<u8>, // 1 = always_methods, 2 = mark_method_used
    pub a: Vector<u64>, // the marked DefId (module << 32 | node)
    pub used: Set<u64>, // task-local dedupe standing in for method_used_get
}

extend TcMarkLog {
    /// An empty log.
    pub fn new() TcMarkLog {
        return TcMarkLog { kinds: Vector::<u8>::new(), a: Vector::<u64>::new(), used: Set::<u64>::new() };
    }
}

/// A const-expression leaf that takes its form's type (a literal or a limit) and its value.
struct LinLeaf {
    pub node: NodeId,
    pub v: i128,
}

// A step `tc_lin` computed: the value of the binary or unary node `node` (`div` 0), or the dividend
// of the `/` at `node` that the form floors by `div`.
struct LinStep {
    pub node: NodeId,
    pub lin: ConstLin,
    pub div: i128,
}

// A const-generic step recorded for item `owner` of the module under check, published with the
// owner's check (`Ast::publish_step`).
struct PendStep {
    pub owner: loader::ItemId,
    pub s: ConstStep,
}

/// The per-module checker. Also the state substrate for the borrowck pass, which extends TypeChecker
/// and re-walks function bodies after check() (Ast.call_info bridges the two).
pub struct TypeChecker<'a> {
    /// The module's Ast, mutated IN PLACE in its `Package.modules` slot (never moved out): package
    /// lookups that land back on this module read the live tree with no override indirection.
    pub ast: *mut Ast,
    pub source: str<'a>,
    pub current_self: NodeId,
    pub current_extend: NodeId,
    /// The per-body mutable walk state: expected type, function
    /// state, closures, returns, and unsafe state live here, isolated from the module-wide caches.
    pub icx: inf::InferenceContext,
    pub package: *mut loader::Package,
    pub alias_depth: u32,
    // Extends by peeled target, built on the first lookup (see `ext_begin`): `ext_heads` maps
    // (target module << 32 | target decl) to (first << 32 | last) indices of a list in `ext_hits`.
    ext_hits: Vector<ExtHit>,
    ext_heads: Map<u64, u64>,
    ext_indexed: Vector<u8>, // per module: 1 once its extends are in `ext_hits`
    pub moved: [NodeId; 1024],
    pub nmoved: u32,
    /// Split-initialization tracking: immutable `let x;` bindings assigned on SOME path so far;
    /// a second assignment (or one on a path that may repeat) is "cannot assign twice".
    pub late: [NodeId; 256],
    pub nlate: u32,
    pub borrows: [Borrow; 256],
    pub nborrows: u32,
    pub scope_depth: u32,
    pub loop_depth: u32,
    pub fields_depth: u32, // nesting inside `inline for .. in fields(..)` bodies (closures rejected there)
    pub binding_depth: Map<u32, u32>,
    pub proj_cbase: Map<u32, u32>, // fields-loop node -> closure_depth at its entry (capture guard)
    pub in_loop_recheck: bool,
    // Next RegionVid to hand out. REGION_STATIC (0) is reserved; the current function's declared
    // lifetimes take the ids after it (universal: they outlive the whole body), and every other
    // region is existential, allocated one per lifetime slot of a value's type as the body is walked.
    pub region_next: u32,
    // Per-aggregate variance of each lifetime-then-type parameter, 2 bits each (V_*), packed LSB-first,
    // keyed by decl (module << 32 | node). Lazy + memoized; a recursive-type cycle resolves to the
    // conservative all-V_INVARIANT (over-restricts only recursion). `variance_wip` marks a decl whose
    // inference is on the stack. Consumed by the invariance check and by `relate` for subtyping.
    pub variance_of: Map<u64, u64>,
    pub variance_wip: Map<u64, bool>,
    // A declared lifetime param node -> the universal RegionVid standing for it in this function.
    pub lt_region: Map<u32, u32>,
    // Outlives constraints for the current function, packed (sup << 32 | sub) meaning "sup: sub",
    // i.e. sup outlives sub. Seeded from the signature (`<'a: 'b>` bounds and `where 'a: 'b`) and
    // later from constraint generation. Cleared per function: RegionVids are function-scoped.
    pub outlives: Vector<u64>,
    // Index into `errors` where the CURRENT function's diagnostics begin. Region/lifetime errors are
    // discovered after the body has been walked (the solver only knows once its constraints are
    // solved), so they are inserted back into source order within this function's range rather than
    // appended after every other diagnostic. See tc_region_diag / diag::Errors::emit_ordered.
    pub err_wm: usize,
    // Two-phase-borrow watermark. While a method call's `&mut self` receiver borrow is being checked,
    // this holds the borrow-array index at which THIS call's argument borrows begin; a reserved `&mut`
    // does not conflict with the shared borrows its own arguments produced (`v.push(v.len())`,
    // `self.m(self.field.as_str())`). 0xFFFFFFFF = not in a receiver check.
    pub tc_twophase_wm: u32,
    /// Nodes a once-per-node diagnostic already reported, keyed (module << 32) | node: array lengths
    /// and type paths naming no type (resolve_type revisits them) and casts the unnecessary-cast
    /// lint flagged.
    pub reported: Set<u64>,
    // Why the last `bound_holds` failed on an associated type binding (`its 'Output' is 'i64'`);
    // empty when it did not.
    pub bind_miss: String,
    // Per member name node resolved to an inherited default of a generic interface on a receiver
    // that is not a type parameter (`tc_pick_conf_method`), or to an interface method through a type
    // parameter whose bounds reach its interface with several arguments (`tc_pick_bound_conf`):
    // `dyn I<args>` naming the conformance the call runs it under.
    pub dflt_conf: Map<NodeId, TypeId>,
    /// Expressions checked so far that have TYPE_ERROR (`check_expr_w`).
    err_exprs: u32,
    /// An evaluation (`ev`, `ev_static`, `fn_recheck_as`) since the caller cleared it failed over a
    /// node this or another check rejected: that diagnostic stands, so the failure reports nothing.
    ev_err: bool,
    /// Set by `tc_lin` when a constant or coefficient of the form leaves i128.
    lin_ovf: bool,
    /// The type a const-generic argument under check expects (TYPE_NONE outside one): among the
    /// disjoint extends of a generic type that each define an associated constant, the one of
    /// that type is the one a bare `W::K` names (`tc_value_member`).
    vm_want: TypeId,
    /// Set by `tc_lin_top` when it reported the form's typing error.
    lin_err: bool,
    /// `tc_lin`'s typing of the form it builds: the join of its typed leaves (BT_COUNT: none yet),
    /// the first leaf whose type does not join (NODE_NONE: none) and that type, the leaves that
    /// take the form's type (literals and limits) with their values, and the largest shift count.
    lin_ty: BuiltinType,
    lin_mis: NodeId,
    lin_mis_bt: BuiltinType,
    lin_lits: Vector<LinLeaf>,
    lin_shift: i64,
    /// `tc_lin`'s steps, in evaluation order (`tc_lin_top` checks and records them).
    lin_steps: Vector<LinStep>,
    /// Steps recorded for items of this module whose check has not published them yet.
    st_pend: Vector<PendStep>,
    /// Nonzero: steps go to `st_cap` instead (an alias body or a parameter default, which its user
    /// substitutes and records as its own), and `st_nocache` lowers past the type memos.
    st_capture: u32,
    st_cap: Vector<ConstStep>,
    st_nocache: u32,
    /// Per generic alias (module << 32 | node): its body's steps over its own parameters, as
    /// start << 32 | count in `alias_pool`.
    alias_steps: Map<u64, u64>,
    alias_pool: Vector<ConstStep>,
    pub lint: bool,
    /// Non-null routes the package-global method marks into a log the driver replays in item order.
    pub mark_log: *mut TcMarkLog,
    /// The item under check (its index record; ITEM_NONE outside `check_one`), the top-level
    /// item's node and the exclusive start of that item's own module-arena range
    /// (`ItemSched.top_lo`): what `decl_is_own` and the engine's reader identity read.
    pub cur_item: loader::ItemId,
    pub cur_top: NodeId,
    pub cur_lo: NodeId,
    /// The components the item under check depends on (`check_orphans`: the module's items'
    /// components and theirs). The checked state the engine and the foreign reads may see.
    pub reach: gitems::Reach,
    /// `check_orphans`: the diagnostics of each top-level node that is no item, in declaration
    /// order, for the driver to publish at the node's place among the items.
    pub orphan_errs: Vector<diag::Errors>,
    pub free_derive_memo: Map<u64, u64>, // (module<<32|decl) -> 1 = not owning, 2 = derives Free (non-generic only)
    // Unsafe-expression span ranges (start<<32|end) the walk records per function; the Core IR
    // free-move rules consult them in place of the walk's unsafe_depth.
    pub bc_unsafe_spans: Vector<u64>,
    pub derive_busy: Vector<u64>, // `tc_type_is_free`'s walk stack: the types entered, by id
    pub bin_spine: Vector<NodeId>, // `check_binary`'s stack of left-nested binary nodes (shared by nested checks)
    pub derive_low: i64, // lowest `derive_busy` index the walk assumed false (FREE_BUSY_NONE: none)
    pub mut_used: Vector<NodeId>, // bindings whose mutability was required (unnecessary-mut lint)
    pub loop_stack: [LoopEntry; 32],
    pub nloops: u32,
    pub loop_floor: u32,
    pub errors: diag::Errors,
    // Per-decl index of the LAST node whose resolution targets it (built lazily from the
    // resolver's tables; the one typechecker-added resolution kind that can target a binding
    // (break/continue -> loop node) is folded in at its set site). Replaces the full-arena scan
    // in borrow_dead_after; answers are identical by construction.
    pub last_use: Vector<NodeId>,
    pub last_use_built: bool,
    /// The module's shared table (`Ast.last_use`) when it is there: read in place of `last_use`,
    /// never written (no resolution is added after the type check).
    pub last_use_view: *const NodeId,
    pub last_use_vn: usize,
    // Presence bitset mirroring moved[0..nmoved] (bit index = decl NodeId), so is_moved is
    // O(1) per identifier. Kept in sync at every moved[] mutation site.
    pub moved_bits: Vector<u64>,
    // (module<<32|decl) -> packed (module<<32|extend) of the type's Free extend (0 = none).
    // Same shape as codegen's CG-3 memo; the first full scan already interned everything the
    // repeat scans would, so pool order is unchanged.
    pub free_ext_memo: Map<u64, u64>,
    // Per-interned-type `tc_type_is_free` result: -1 unknown, 0 no, 1 yes. Free-ness is a stable fact of
    // a concrete type (extends are parse-time facts), so the full result caches by TypeId.
    pub type_free_memo: Vector<u64>,
    // Per (TypeId, depth 0..4) `tc_carries_borrow_rec` result, same encoding; only computations
    // that never touched a TYPE_FUNCTION are cached (closure answers move under the walk).
    pub carries_borrow_memo: Vector<u64>,
    // (interface bit<<63|module<<32|method) -> enclosing extend/interface item (NODE_NONE misses included).
    pub encl_memo: Map<u64, NodeId>,
    // Format helpers are marked used once per module, not once per print call.
    pub fmt_marked: bool,
    // (target, name-content, query kind) -> packed DefId (module<<32|node), misses included
    // (node == NODE_NONE). Valid for the whole check: the ext scope, ASTs and self.cur_module() (the
    // privacy filter input) are all fixed per checker. mark_method_used is re-fired on method hits
    // (idempotent set), so used-lint marking is unchanged.
    pub method_memo: Map<MQKey<'a>, u64>,
    pub method_all_memo: Map<MQKey<'a>, u64>,
    pub method_all_pool: Vector<DefId>,
    /// The receiver type the last aggregate lookup resolved on: what tc_mark_method_used pairs a method
    /// with, since the lookups themselves are keyed by the receiver's DECL and never carry its arguments.
    pub mark_recv: TypeId,
    // Tc_peel_target memo, (module<<32|node) -> packed DefId. The first peel does the
    // named_type_of interning; repeats re-derived the same DefId from frozen inputs.
    pub peel_memo: Map<u64, u64>,
    // Whether an extend, (module<<32|node), binds positionally (`ext_is_identity`): its target is
    // lowered only for the extends that do not.
    pub ext_id_memo: Map<u64, bool>,
    // Foreign generic-instance lowering memo, (module<<32|node) -> current-pool TypeId,
    // HEAVY NODES ONLY (type paths with generic args; anything cheaper loses to the hash probe).
    // Foreign lowering is context-free (resolution_def/builtin_of_decl/const-eval only; Self and
    // generic params lower to identity types, substitution happens in callers). DIAGNOSTICS GATE:
    // entries are inserted only when the lowering emitted no new errors and the result is not
    // TYPE_ERROR, so error-carrying programs re-emit their diagnostics exactly as before.
    pub lower_memo: Map<u64, TypeId>,
    /// Foreign declaration types (`decl_type_in` for another module's fields, parameters, consts and
    /// generic parameters), keyed `module << 32 | decl`: a foreign declaration has no type slot in
    /// this checker's pool, and every member access or call re-lowered its type syntax (126k times
    /// per transpile of the compiler). Entries are recorded only when the lowering raised no
    /// diagnostic, the `lower_memo` rule.
    pub fdecl_memo: Map<u64, TypeId>,
    // Memoized "does a value of this type carry a borrow": a pure function of the interned type, so
    // caching per (module, TypeId) makes the DEEP structural check O(1) after first use (it runs on
    // every method call and every binding/return). 1 = carries, 0 = does not.
    pub carries_memo: Map<u64, u8>,
    // Bound and marker verdicts (`type_satisfies`, `tc_copy_marker`, `tc_thread_marker`) of the
    // outermost query in progress, keyed by type, bound and depth: within one query the verdict is a
    // function of the key. Emptied when the outermost frame returns. A frame under a
    // `tc_type_is_free` walk (whose answers read the walk's stack) or one that recorded a diagnostic
    // or an obligation is never stored. Value: verdict bit 0, `mark_recv` written bit 1, the last
    // written `mark_recv` in the high half.
    sat_memo: Map<SatKey, u64>,
    sat_nest: u32,
    // `mark_recv` writes so far: a memoized verdict replays the last write of its walk.
    mark_n: u32,
    // `subst_type`'s memo for one call: instance nodes with compound arguments -> substituted type.
    subst_memo: Map<TypeId, TypeId>,
    // The module's conformance extends by (interface, target), built on the first conformance check:
    // `dup_heads` holds the first item position of each key, `dup_next` links an item position to the
    // next one with its key (EXT_END ends a list).
    dup_heads: Map<ConfKey, u32>,
    dup_next: Vector<u32>,
    dup_built: bool,
    // Prelude lookup hits resolved once at construction, for the names the checker asks for per call.
    pub ph_str: loader::LookupHit,
    pub ph_string: loader::LookupHit,
    pub ph_unsafecell: loader::LookupHit,
    pub ph_send: loader::LookupHit,
    pub ph_sync: loader::LookupHit,
    pub ph_allocator: loader::LookupHit,
    pub ph_slice: loader::LookupHit,
    pub ph_slicemut: loader::LookupHit,
    pub ph_range: loader::LookupHit,
    pub ph_box: loader::LookupHit,
    pub ph_global: loader::LookupHit,
    pub ph_t2: loader::LookupHit,
    pub ph_t3: loader::LookupHit,
    pub ph_t4: loader::LookupHit,
    pub ph_option: loader::LookupHit,
    pub ph_result: loader::LookupHit,
    pub ph_uint: loader::LookupHit, // the prelude's UInt/Int: what admits a wide integer literal
    pub ph_int: loader::LookupHit,
}

// Takes the package pointer as usize: a *mut Package value is move-tracked (Package is Free).
fn ph_lookup(pkg: usize, name: str) loader::LookupHit {
    let package = pkg as *mut loader::Package;
    return unsafe (*package).prelude_lookup(name, true);
}

/// A function type's parameter list, read one parameter at a time through `fn_param`, and its
/// return type (TYPE_NONE for a multi-return signature).
/// The shape of a function type: its parameter count `np`, its single result `ret`, and where the
/// parameter types come from: the parameter nodes `ps` of module `m`, or, for a function-pointer
/// type, its signature record (`sig` is that type).
struct FnShape {
    pub m: ModuleId,
    pub ps: NodeList,
    pub ret: TypeId,
    pub sig: TypeId,
    pub np: u32,
}

/// True when span `s` of `src` spells exactly `lit`.
pub const fn span_is(src: str, s: tok::Span, lit: str) bool {
    let n = lit.len();
    if (s.end - s.start) as usize != n {
        return false;
    }
    return unsafe cstring::memcmp(src.ptr() + s.start as usize, lit.ptr(), n) == 0;
}

/// True when two spans, possibly of different sources, spell the same bytes.
pub const fn spans_eq2(sa: str, a: tok::Span, sb: str, b: tok::Span) bool {
    let la = a.end - a.start;
    if la != b.end - b.start {
        return false;
    }
    return unsafe cstring::memcmp(sa.ptr() + a.start as usize, sb.ptr() + b.start as usize, la as usize) == 0;
}

const fn bt_is_int(b: BuiltinType) bool {
    return b as u8 >= BuiltinType::BT_I8 as u8 && b as u8 <= BuiltinType::BT_USIZE as u8;
}
const fn bt_is_uint(b: BuiltinType) bool {
    return b as u8 >= BuiltinType::BT_U8 as u8 && b as u8 <= BuiltinType::BT_USIZE as u8;
}
// The content span of a matchertext literal: past `Md"(` and before `)"` (the delimiter chain
// `d` ends at the quote).
const fn tc_mt_content(src: str, s: tok::Span) tok::Span {
    let mut i = s.start + 1;
    while src[i as usize] != b'"' {
        i = i + 1;
    }
    return tok::Span { start: i + 2, end: s.end - 2 };
}
const fn bt_is_float(b: BuiltinType) bool {
    return b == BuiltinType::BT_F32 || b == BuiltinType::BT_F64;
}
const fn bt_is_complex(b: BuiltinType) bool {
    return b == BuiltinType::BT_C32 || b == BuiltinType::BT_C64;
}

// Largest positive value of builtin `b` (0 = unbounded in a u64 carrier). `ptr32` narrows
// usize/isize to the 32-bit target's pointer width.
const fn bt_int_max(b: BuiltinType, ptr32: bool) u64 {
    if ptr32 {
        if b == BuiltinType::BT_USIZE {
            return 4294967295u64;
        }
        if b == BuiltinType::BT_ISIZE {
            return 2147483647u64;
        }
    }
    if b == BuiltinType::BT_I8 {
        return 127u64;
    }
    if b == BuiltinType::BT_I16 {
        return 32767u64;
    }
    if b == BuiltinType::BT_I32 {
        return 2147483647u64;
    }
    if b == BuiltinType::BT_I64 || b == BuiltinType::BT_ISIZE {
        return 9223372036854775807u64;
    }
    if b == BuiltinType::BT_U8 {
        return 255u64;
    }
    if b == BuiltinType::BT_U16 {
        return 65535u64;
    }
    if b == BuiltinType::BT_U32 {
        return 4294967295u64;
    }
    // U64/usize.
    return 0u64;
}

const fn tc_lit_in_range(b: BuiltinType, mag: u64, neg: bool, ptr32: bool) bool {
    let mx = bt_int_max(b, ptr32);
    if neg {
        let sgn = b == BuiltinType::BT_I8 || b == BuiltinType::BT_I16 || b == BuiltinType::BT_I32 || b == BuiltinType::BT_I64 || b == BuiltinType::BT_ISIZE;
        return sgn && (mx == 0 || mag <= mx + 1);
    }
    return mx == 0 || mag <= mx;
}

// Implicit lossless numeric widening.
const fn bt_widens(from: BuiltinType, to: BuiltinType) bool {
    if from == BuiltinType::BT_F32 && to == BuiltinType::BT_F64 {
        return true;
    }
    let fs = from as u8 >= BuiltinType::BT_I8 as u8 && from as u8 <= BuiltinType::BT_I64 as u8;
    let fu = from as u8 >= BuiltinType::BT_U8 as u8 && from as u8 <= BuiltinType::BT_U64 as u8;
    let ts = to as u8 >= BuiltinType::BT_I8 as u8 && to as u8 <= BuiltinType::BT_I64 as u8;
    let tu = to as u8 >= BuiltinType::BT_U8 as u8 && to as u8 <= BuiltinType::BT_U64 as u8;
    if !(fs || fu) || !(ts || tu) {
        return false;
    }
    let mut fw = from as i32 - BuiltinType::BT_U8 as i32;
    if fs {
        fw = from as i32 - BuiltinType::BT_I8 as i32;
    }
    let mut tw = to as i32 - BuiltinType::BT_U8 as i32;
    if ts {
        tw = to as i32 - BuiltinType::BT_I8 as i32;
    }
    if fu {
        return tw > fw;
    }
    return ts && tw > fw;
}

// Type-level safe-conversion oracle for the generic-argument join: identity, the integer widening
// lattice, f32 -> f64, `&mut T` -> `&T`, and never -> anything. Deliberately narrower than
// `compatible`: an unmodeled conversion makes the join fall back to the first bound, which is the
// pre-rewrite result.
const fn it_conv_join(a: *mut Ast, from: TypeId, to: TypeId) bool {
    if from == to {
        return true;
    }
    if from == TYPE_NONE || to == TYPE_NONE {
        return false;
    }
    let f = *unsafe (&*a).type_at(from);
    let t = *unsafe (&*a).type_at(to);
    if f.kind == TypeKind::TYPE_NEVER {
        return true;
    }
    if f.kind == TypeKind::TYPE_BUILTIN && t.kind == TypeKind::TYPE_BUILTIN {
        return bt_widens(f.as_data.builtin, t.as_data.builtin);
    }
    if f.kind == TypeKind::TYPE_REFERENCE && t.kind == TypeKind::TYPE_REFERENCE {
        let fm = f.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
        let ts = t.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8;
        return fm && ts && f.as_data.elem == t.as_data.elem;
    }
    return false;
}

// Shared integer-literal base-prefix detection: returns (base, prefix chars consumed).
const fn lit_base_prefix(p: *const u8, len: usize) (u64, usize) {
    if len >= 2 && unsafe p[0] == b'0' {
        let c1 = unsafe p[1] | 0x20u8;
        if c1 == b'x' {
            return 16u64, 2;
        }
        if c1 == b'b' {
            return 2u64, 2;
        }
        if c1 == b'o' {
            return 8u64, 2;
        }
    }
    return 10u64, 0;
}

const fn hex_digit(c: u8) u32 {
    if c <= b'9' {
        return c - b'0';
    }
    return (c | 0x20u8) - b'a' + 10u8;
}

// The value of the integer-literal digits `p[0..len)` in `base`, underscores skipped. False when a
// character is not a digit of `base` or the value exceeds `max`.
const fn lit_digits(p: *const u8, len: usize, base: u64, max: u64, out: &mut u64) bool {
    let mut acc: u64 = 0;
    for i in 0..len {
        let ch = unsafe p[i];
        if ch == b'_' {
            continue;
        }
        let d = hex_digit(ch) as u64;
        if d >= base || acc > (max - d) / base {
            return false;
        }
        acc = acc * base + d;
    }
    *out = acc;
    return true;
}

// An operator of literal-only arithmetic: 1 for `+ - * / %`, 2 for the integer-only `& | ^ << >>`, 0 for
// any other.
const fn lit_arith_op(op: TokenType) u8 {
    if op == TokenType::Plus || op == TokenType::Minus || op == TokenType::Star || op == TokenType::Slash || op == TokenType::Percent {
        return 1;
    }
    if op == TokenType::Ampersand || op == TokenType::Pipe || op == TokenType::Caret || op == TokenType::LeftShift || op == TokenType::RightShift {
        return 2;
    }
    return 0;
}

// Whether integer literal `lr` ends in a library-width suffix (`5i128`, `7u100`).
const fn lit_width_suffix(src: str, lr: tok::Span) bool {
    let mut k = lr.end;
    while k > lr.start && src[(k - 1) as usize] >= b'0' && src[(k - 1) as usize] <= b'9' {
        k = k - 1;
    }
    return k > lr.start + 1 && k < lr.end && (src[(k - 1) as usize] == b'i' || src[(k - 1) as usize] == b'u');
}

// The f32 overflow bound: a finite value at or past it rounds to infinity in f32 (FLT_MAX plus half an
// ulp, where round-to-nearest-even goes up).
const F32_LIMIT: f64 = 3.4028235677973366e38;

// One step of literal-only integer arithmetic in `bt` (i32, i64 or u64) on values held as i64 bit
// patterns: 0 when the result fits `bt`, 1 when it overflows `bt` (a shift count of at least the width
// included), 2 when the step traps in every type (division by zero, a shift count past 63 or negative).
const fn lit_int_op(op: TokenType, a: i64, b: i64, bt: BuiltinType, out: &mut i64) u8 {
    let x = a as u64;
    let y = b as u64;
    if (op == TokenType::Slash || op == TokenType::Percent) && b == 0 || (op == TokenType::LeftShift || op == TokenType::RightShift) && y >= 64 {
        return 2;
    }
    if bt == BuiltinType::BT_U64 {
        let mut r: u64 = 0;
        if op == TokenType::Plus {
            r = x.wrapping_add(y);
            if r < x {
                return 1;
            }
        } else if op == TokenType::Minus {
            if y > x {
                return 1;
            }
            r = x - y;
        } else if op == TokenType::Star {
            let (p, o) = x.overflowing_mul(y);
            if o {
                return 1;
            }
            r = p;
        } else if op == TokenType::Slash {
            r = x / y;
        } else if op == TokenType::Percent {
            r = x % y;
        } else if op == TokenType::Ampersand {
            r = x & y;
        } else if op == TokenType::Pipe {
            r = x | y;
        } else if op == TokenType::Caret {
            r = x ^ y;
        } else if op == TokenType::LeftShift {
            r = x << y;
        } else {
            r = x >> y;
        }
        *out = r as i64;
        return 0;
    }
    let bits: u64 = if bt == BuiltinType::BT_I32 {
        32;
    } else {
        64;
    };
    let mn = (1u64 << bits - 1).wrapping_neg() as i64;
    let mx = ((1u64 << bits - 1) - 1) as i64;
    let mut r: i64 = 0;
    if op == TokenType::Plus {
        r = x.wrapping_add(y) as i64;
        if ((a ^ r) & (b ^ r)) < 0 {
            return 1;
        }
    } else if op == TokenType::Minus {
        r = x.wrapping_sub(y) as i64;
        if ((a ^ b) & (a ^ r)) < 0 {
            return 1;
        }
    } else if op == TokenType::Star {
        let (p, o) = a.overflowing_mul(b);
        if o {
            return 1;
        }
        r = p;
    } else if op == TokenType::Slash || op == TokenType::Percent {
        if a == mn && b == -1 {
            return 1;
        }
        r = if op == TokenType::Slash {
            a / b;
        } else {
            a % b;
        };
    } else if op == TokenType::Ampersand {
        r = a & b;
    } else if op == TokenType::Pipe {
        r = a | b;
    } else if op == TokenType::Caret {
        r = a ^ b;
    } else if y >= bits {
        return 1;
    } else if op == TokenType::LeftShift {
        // Two's complement at the width: the bits shifted out are lost.
        r = (x << y) as i64;
        if bits == 32 {
            r = (r as u64 << 32) as i64 >> 32;
        }
    } else {
        r = a >> b;
    }
    if r < mn || r > mx {
        return 1;
    }
    *out = r;
    return 0;
}

extend<'a> TypeChecker<'a> {
    /// Ownership: borrows `ast` (the module keeps it); `package` is a borrowed raw pointer.
    pub fn new(ast: *mut Ast, source: str, package: *mut loader::Package) TypeChecker {
        assert(package != null, "a type checker reads through its package");
        let pkg = package as usize; // read the address before the literal's `package:` field moves it
        let mut t = TypeChecker {
            ast: ast,
            source: source,
            current_self: NODE_NONE,
            current_extend: NODE_NONE,
            icx: inf::InferenceContext::new(),
            package: package,
            alias_depth: 0,
            ext_hits: Vector::<ExtHit>::new(),
            ext_heads: Map::<u64, u64>::new(),
            ext_indexed: Vector::<u8>::new(),
            nmoved: 0,
            nlate: 0,
            nborrows: 0,
            scope_depth: 0,
            loop_depth: 0,
            fields_depth: 0,
            binding_depth: Map::<u32, u32>::new(),
            proj_cbase: Map::<u32, u32>::new(),
            in_loop_recheck: false,
            region_next: 1,
            variance_of: Map::<u64, u64>::new(),
            variance_wip: Map::<u64, bool>::new(),
            lt_region: Map::<u32, u32>::new(),
            outlives: Vector::<u64>::new(),
            err_wm: 0,
            tc_twophase_wm: 0xFFFFFFFF,
            reported: Set::<u64>::new(),
            bind_miss: String::new(),
            dflt_conf: Map::<NodeId, TypeId>::new(),
            err_exprs: 0,
            ev_err: false,
            lin_ovf: false,
            vm_want: TYPE_NONE,
            lin_err: false,
            lin_ty: BuiltinType::BT_COUNT,
            lin_mis: NODE_NONE,
            lin_mis_bt: BuiltinType::BT_COUNT,
            lin_lits: Vector::<LinLeaf>::new(),
            lin_shift: 0,
            lin_steps: Vector::<LinStep>::new(),
            st_pend: Vector::<PendStep>::new(),
            st_capture: 0,
            st_cap: Vector::<ConstStep>::new(),
            st_nocache: 0,
            alias_steps: Map::<u64, u64>::new(),
            alias_pool: Vector::<ConstStep>::new(),
            lint: false,
            mark_log: null,
            cur_item: loader::ITEM_NONE,
            cur_top: NODE_NONE,
            cur_lo: 0,
            reach: gitems::Reach::new(),
            orphan_errs: Vector::<diag::Errors>::new(),
            free_derive_memo: Map::<u64, u64>::new(),
            bc_unsafe_spans: Vector::<u64>::new(),
            derive_busy: Vector::<u64>::new(),
            bin_spine: Vector::<NodeId>::new(),
            derive_low: FREE_BUSY_NONE,
            mut_used: Vector::<NodeId>::new(),
            nloops: 0,
            loop_floor: 0,
            errors: diag::Errors::new(),
            last_use: Vector::<NodeId>::new(),
            last_use_built: false,
            last_use_view: null,
            last_use_vn: 0,
            moved_bits: Vector::<u64>::new(),
            free_ext_memo: Map::<u64, u64>::new(),
            type_free_memo: Vector::<u64>::new(),
            carries_borrow_memo: Vector::<u64>::new(),
            encl_memo: Map::<u64, NodeId>::new(),
            fmt_marked: false,
            method_memo: Map::<MQKey, u64>::new(),
            method_all_memo: Map::<MQKey, u64>::new(),
            method_all_pool: Vector::<DefId>::new(),
            mark_recv: TYPE_NONE,
            peel_memo: Map::<u64, u64>::new(),
            ext_id_memo: Map::<u64, bool>::new(),
            lower_memo: Map::<u64, TypeId>::new(),
            fdecl_memo: Map::<u64, TypeId>::new(),
            carries_memo: Map::<u64, u8>::new(),
            sat_memo: Map::<SatKey, u64>::new(),
            sat_nest: 0,
            mark_n: 0,
            subst_memo: Map::<TypeId, TypeId>::new(),
            dup_heads: Map::<ConfKey, u32>::new(),
            dup_next: Vector::<u32>::new(),
            dup_built: false,
            ph_str: ph_lookup(pkg, "str"),
            ph_string: ph_lookup(pkg, "String"),
            ph_unsafecell: ph_lookup(pkg, "UnsafeCell"),
            ph_send: ph_lookup(pkg, "Send"),
            ph_sync: ph_lookup(pkg, "Sync"),
            ph_allocator: ph_lookup(pkg, "Allocator"),
            ph_slice: ph_lookup(pkg, "Slice"),
            ph_slicemut: ph_lookup(pkg, "SliceMut"),
            ph_range: ph_lookup(pkg, "Range"),
            ph_box: ph_lookup(pkg, "Box"),
            ph_global: ph_lookup(pkg, "Global"),
            ph_t2: ph_lookup(pkg, "Tuple2"),
            ph_t3: ph_lookup(pkg, "Tuple3"),
            ph_t4: ph_lookup(pkg, "Tuple4"),
            ph_option: ph_lookup(pkg, "Option"),
            ph_result: ph_lookup(pkg, "Result"),
            ph_uint: ph_lookup(pkg, "UInt"),
            ph_int: ph_lookup(pkg, "Int"),
        };
        t.icx.sv.ast = ast;
        if unsafe (&*ast).last_use.len() != 0 {
            t.last_use_view = unsafe (&*ast).last_use.as_ptr();
            t.last_use_vn = unsafe (&*ast).last_use.len();
            t.last_use_built = true;
        }
        return t;
    }

    /// The Ast under check (live in its package slot).
    pub const fn cur_ast(self: &Self) *mut Ast {
        return self.ast;
    }
    /// The module id of the AST under check. A by-value read (no lingering borrow of `self`), so it composes
    /// inside expressions that also take `&mut self`.
    pub const fn cur_module(self: &Self) ModuleId {
        return unsafe (*self.cur_ast()).module;
    }

    // True when the selected target's pointers are 32-bit: usize/isize literal ranges narrow.
    const fn tc_ptr32(self: &Self) bool {
        return lay::target_for(unsafe (*self.package).arch).ptr == 4;
    }

    /// Module `m`'s live Ast.
    @c.always_inline
    pub const fn mod_ast(self: &Self, m: ModuleId) *mut Ast {
        if m != self.cur_module() {
            // Asts live in place in the module table, so the slot IS the live tree.
            return unsafe &mut (*self.package).modules[m as usize].ast;
        }
        return self.ast;
    }
    /// Module `m`'s source text, for span rendering.
    pub const fn mod_src(self: &Self, m: ModuleId) str<'a> {
        if m != self.cur_module() {
            return unsafe (*self.package).modules[m as usize].source.as_str();
        }
        return self.source;
    }
    /// Number of modules in the package.
    pub const fn pkg_count(self: &Self) usize {
        return unsafe (*self.package).modules.len();
    }
    const fn cir(self: &Self) *mut iri::Interp {
        return (unsafe (*self.package).cir) as *mut iri::Interp;
    }

    /// The text span of an identifier node.
    pub const fn name_span(self: &Self, name_node: NodeId) tok::Span {
        return unsafe (*self.cur_ast()).at_const(name_node).as_data.name.text;
    }

    /// The interned record of `x` in the current module's pool.
    pub const fn type_at<'t>(self: &Self, x: TypeId) &'t Ty {
        return unsafe (*self.cur_ast()).type_at(x);
    }

    const fn is_bool(self: &Self, x: TypeId) bool {
        let y = self.type_at(x);
        return y.kind == TypeKind::TYPE_BUILTIN && y.as_data.builtin == BuiltinType::BT_BOOL;
    }
    const fn is_int(self: &Self, x: TypeId) bool {
        let y = self.type_at(x);
        return y.kind == TypeKind::TYPE_BUILTIN && bt_is_int(y.as_data.builtin);
    }
    const fn is_numeric(self: &Self, x: TypeId) bool {
        let y = self.type_at(x);
        return y.kind == TypeKind::TYPE_BUILTIN && (bt_is_int(y.as_data.builtin) || bt_is_float(y.as_data.builtin) || bt_is_complex(
            y.as_data.builtin,
        ));
    }
    const fn is_void_type(self: &Self, x: TypeId) bool {
        let y = self.type_at(x);
        return y.kind == TypeKind::TYPE_BUILTIN && y.as_data.builtin == BuiltinType::BT_VOID;
    }
    const fn bt_of(self: &Self, x: TypeId) BuiltinType {
        let y = self.type_at(x);
        if y.kind == TypeKind::TYPE_BUILTIN {
            return y.as_data.builtin;
        }
        return BuiltinType::BT_COUNT;
    }
    fn is_plain_enum(self: &Self, x: TypeId) bool {
        let y = *self.type_at(x);
        if y.kind != TypeKind::TYPE_ENUM {
            return false;
        }
        return !unsafe (*self.mod_ast(y.module)).enum_has_payload(y.as_data.decl);
    }
    /// `x0` with every pointer and reference wrapper peeled.
    pub fn strip(self: &Self, x0: TypeId) TypeId {
        let mut x = x0;
        let mut y = self.type_at(x);
        while y.kind == TypeKind::TYPE_POINTER || y.kind == TypeKind::TYPE_REFERENCE {
            x = y.as_data.elem;
            y = self.type_at(x);
        }
        return x;
    }
    fn tc_ref(self: &mut Self, elem: TypeId, mut2: bool) TypeId {
        let mut q = TypeQualifier::TYPE_QUAL_NONE;
        if mut2 {
            q = TypeQualifier::TYPE_QUAL_MUT;
        }
        return unsafe (*self.cur_ast()).intern_type(
            Ty { kind: TypeKind::TYPE_REFERENCE, qualifier: q as u8, as_data: TyAs { elem: elem } },
        );
    }

    fn tc_is_prelude_decl(self: &Self, t: TypeId, name: str) bool {
        let hit = unsafe (*self.package).prelude_lookup(name, true);
        if hit.node == NODE_NONE {
            return false;
        }
        let y = self.type_at(t);
        return y.kind == TypeKind::TYPE_STRUCT && y.module == hit.mid && y.as_data.decl == hit.node;
    }
    fn tc_main_params_ok(self: &Self, params: NodeList) bool {
        if params.len == 0 {
            return true;
        }
        if params.len != 1 {
            return false;
        }
        let ids = unsafe (*self.cur_ast()).list(params);
        let argv = self.type_at(unsafe (*self.cur_ast()).type_of(unsafe ids[0]));
        if argv.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let hit = unsafe (*self.package).prelude_lookup("Vector", true);
        if hit.node == NODE_NONE {
            return false;
        }
        let it = unsafe (*self.cur_ast()).instance(argv.as_data.inst);
        return it.module == hit.mid && it.decl == hit.node && it.n >= 1 && self.tc_is_prelude_decl(it.args[0], "str");
    }

    /// Returns the loop-stack index, or -1 when 32 loops are already open (callers skip the matching pop).
    pub const fn tc_loop_push(self: &mut Self, label: tok::Span, node: NodeId, value_loop: bool) i32 {
        if self.nloops >= 32 {
            return -1;
        }
        let n = self.nloops;
        unsafe self.loop_stack[n as usize] = LoopEntry {
            label: label,
            node: node,
            break_ty: TYPE_NONE,
            value_loop: value_loop,
            saw_value: false,
            saw_bare: false,
            depth: self.scope_depth,
        };
        self.nloops = n + 1;
        return n as i32;
    }
    fn tc_loop_pop(self: &mut Self, le: i32, sp: tok::Span) {
        if le < 0 {
            return;
        }
        if unsafe self.loop_stack[le as usize].saw_value && unsafe self.loop_stack[le as usize].saw_bare {
            self.errors.emit_span(sp, format("every 'break' in a value-yielding 'loop' must carry a value"));
        }
        self.nloops = le as u32;
    }
    fn tc_find_loop(self: &Self, label: tok::Span) i32 {
        let mut i = self.nloops;
        while i > self.loop_floor {
            i = i - 1;
            if label.end == label.start {
                return i as i32;
            }
            if spans_eq2(self.source, unsafe self.loop_stack[i as usize].label, self.source, label) {
                return i as i32;
            }
        }
        return -1;
    }

    fn tc_is_test_fn(self: &Self, m: ModuleId, fnode: NodeId) bool {
        let a = self.mod_ast(m);
        for i in 0..unsafe (*a).attrs.len() {
            let at = unsafe (*a).attrs.at(i);
            if at.owner == fnode && (at.kind == AttrKind::ATTR_TEST as u8 || at.kind == AttrKind::ATTR_TEST_INIT as u8 || at.kind == AttrKind::ATTR_TEST_FREE as u8) {
                return true;
            }
        }
        return false;
    }
    fn tc_check_test_ref(self: &mut Self, d: DefId, sp: tok::Span) {
        if d.node == NODE_NONE || !self.tc_is_test_fn(d.module, d.node) {
            return;
        }
        if self.icx.current_fn != NODE_NONE && self.tc_is_test_fn(self.cur_module(), self.icx.current_fn) {
            return;
        }
        self.errors.emit_span(sp, format("a '@test' function can only be called from other test functions"));
        self.errors.note(
            format("test functions are not compiled outside 'super-c --test'; move shared logic into a plain function"),
        );
    }

    fn tc_literal_pinned(self: &Self, id: NodeId) bool {
        let n = unsafe (*self.cur_ast()).at_const(id);
        if n.kind != NodeKind::NODE_LITERAL {
            return false;
        }
        let tt = n.as_data.literal.token_type;
        if tt != TokenType::IntegerLiteral && tt != TokenType::FloatLiteral {
            return false;
        }
        let mut sfx: u32 = 0;
        return ast_numeric_suffix(self.source, n.as_data.literal.raw.start, n.as_data.literal.raw.end, &mut sfx) != BuiltinType::BT_COUNT;
    }
    const fn is_integer_literal_node(self: &Self, id: NodeId) bool {
        if id == NODE_NONE {
            return false;
        }
        let a = self.cur_ast();
        let mut nid = id;
        let n0 = unsafe (*a).at_const(nid);
        if n0.kind == NodeKind::NODE_UNARY && n0.as_data.unary.op == TokenType::Minus {
            nid = n0.as_data.unary.operand;
        }
        let n = unsafe (*a).at_const(nid);
        return n.kind == NodeKind::NODE_LITERAL && n.as_data.literal.token_type == TokenType::IntegerLiteral;
    }
    fn lit_mag(self: &Self, id: NodeId, out: &mut u64) bool {
        return self.lit_mag_in(self.cur_module(), id, out);
    }

    // `lit_mag` for integer literal `id` of module `m`.
    fn lit_mag_in(self: &Self, m: ModuleId, id: NodeId, out: &mut u64) bool {
        let n = unsafe (*self.mod_ast(m)).at_const(id);
        let src = self.mod_src(m);
        let lr = n.as_data.literal.raw;
        let mut endd = lr.end;
        ast_numeric_suffix(src, lr.start, lr.end, &mut endd);
        let mut p = unsafe (src.ptr() + lr.start as usize);
        let mut len = (endd - lr.start) as usize;
        let (base, skip) = lit_base_prefix(p, len);
        p = unsafe (p + skip);
        len = len - skip;
        return lit_digits(p, len, base, 0xFFFFFFFFFFFFFFFFu64, out);
    }

    // An operation that requires 'unsafe': counts against the innermost active marker (for the
    // unnecessary-unsafe lint) and reports whether the requirement is unmet.
    const fn tc_needs_unsafe(self: &mut Self) bool {
        self.icx.unsafe_used = self.icx.unsafe_used + 1;
        return self.icx.unsafe_depth == 0;
    }

    /// Fold `nid` to a boolean constant through the engine, only when the expression is closed
    /// (`tc_expr_closed`): then the answer holds on every execution, which is what the
    /// constant-condition lint claims.
    fn tc_fold_bool(self: &mut Self, nid: NodeId, out: &mut bool) bool {
        if !self.tc_expr_closed(nid, 0) {
            return false;
        }
        let ceptr = self.cir();
        if ceptr == null {
            return false;
        }
        let v = self.ev(self.cur_module(), nid);
        if v.kind != iri::IV_BOOL {
            return false;
        }
        *out = v.i != 0;
        return true;
    }

    // A closed expression reads no runtime value: literals, constants (never `static mut` or
    // extern), enum variants, `sizeof`/`alignof`, combined by operators, casts and member paths.
    // A call is not closed: a `const fn` gate (`on_wasm()`) is a deliberate switch, not a slip.
    fn tc_expr_closed(self: &Self, nid: NodeId, depth: u32) bool {
        if nid == NODE_NONE || depth > 24 {
            return false;
        }
        let a = self.cur_ast();
        let n = unsafe (*a).at_const(nid);
        return switch n.kind {
            NODE_LITERAL | NODE_SIZEOF | NODE_ALIGNOF => true,
            NODE_IDENTIFIER => self.tc_def_closed(unsafe (*a).resolution_def(nid)),
            NODE_MEMBER => n.as_data.member.path && self.tc_def_closed(unsafe (*a).resolution_def(nid)),
            NODE_UNARY => self.tc_expr_closed(n.as_data.unary.operand, depth + 1),
            NODE_BINARY => self.tc_expr_closed(n.as_data.binary.left, depth + 1) && self.tc_expr_closed(
                n.as_data.binary.right,
                depth + 1,
            ),
            NODE_CAST => self.tc_expr_closed(n.as_data.cast.expression, depth + 1),
            _ => false,
        };
    }

    // A build constant is not closed: a condition over one is a deliberate switch.
    const fn tc_def_closed(self: &Self, d: DefId) bool {
        if d.node == NODE_NONE || d.module as usize >= self.pkg_count() || d.module as i32 == unsafe (*self.package).build_module {
            return false;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if dn.kind == NodeKind::NODE_CONST {
            return !dn.as_data.const_def.is_static_mut && !dn.as_data.const_def.is_extern;
        }
        return dn.kind == NodeKind::NODE_VARIANT;
    }

    /// The constant-condition lint: a closed `if` or `while` condition the engine folds is
    /// always true or always false. The warning carries the fold as a `--fix`: an `if` statement
    /// becomes its live branch (or nothing), `while false` disappears, `while true` becomes
    /// `loop`; an `if` value gets no fix (its branch is not an expression on its own). The dead
    /// branch or loop body gets its own "unreachable" warning.
    fn lint_const_cond(self: &mut Self, id: NodeId, cond: NodeId, is_while: bool, is_stmt: bool) {
        if !self.lint || cond == NODE_NONE {
            return;
        }
        if is_while && unsafe (*self.cur_ast()).at_const(id).as_data.while_stmt.is_do {
            return; // `do { } while false` is the run-once block idiom
        }
        let mut val = false;
        if !self.tc_fold_bool(cond, &mut val) {
            return;
        }
        let a = self.cur_ast();
        let csp = unsafe (*a).at_const(cond).span;
        let nsp = unsafe (*a).at_const(id).span;
        if val {
            self.errors.warn_span(csp, format("condition is always true"));
        } else {
            self.errors.warn_span(csp, format("condition is always false"));
        }
        if is_while {
            let w = unsafe (*a).at_const(id).as_data.while_stmt;
            if w.label.end <= w.label.start {
                if val {
                    self.errors.fix_replace(nsp.start, csp.end, String::from_str("loop"));
                } else {
                    self.errors.fix(nsp.start, nsp.end, 0);
                }
            }
            if !val {
                let bsp = unsafe (*a).at_const(w.body).span;
                self.errors.warn_span(bsp, format("unreachable loop body"));
            }
            return;
        }
        let ifd = unsafe (*a).at_const(id).as_data.if_stmt;
        let dead = pick(val, ifd.else_branch, ifd.then_branch);
        let live = pick(val, ifd.then_branch, ifd.else_branch);
        if is_stmt {
            if live == NODE_NONE {
                self.errors.fix(nsp.start, nsp.end, 0);
            } else {
                let lsp = unsafe (*a).at_const(live).span;
                self.errors.fix_replace(
                    nsp.start,
                    nsp.end,
                    String::from_str(self.source.slice(lsp.start as usize, lsp.end as usize)),
                );
            }
        }
        if dead != NODE_NONE {
            let dsp = unsafe (*a).at_const(dead).span;
            self.errors.warn_span(dsp, format("unreachable branch"));
        }
    }

    /// Whether statement `id` never completes normally: a `return`, `break` or `continue`, an
    /// expression of type `!`, a `loop` no `break` leaves, a block holding such a statement, or
    /// an `if` whose two branches both do. The statement after one is unreachable.
    fn stmt_diverges(self: &Self, id: NodeId, depth: u32) bool {
        if id == NODE_NONE || depth > 64 {
            return false;
        }
        let a = self.cur_ast();
        let n = unsafe (*a).at_const(id);
        if n.kind == NodeKind::NODE_RETURN || n.kind == NodeKind::NODE_BREAK || n.kind == NodeKind::NODE_CONTINUE {
            return true;
        }
        if n.kind == NodeKind::NODE_EXPRESSION_STATEMENT {
            let vt = unsafe (*a).type_of(n.as_data.single.value);
            return vt != TYPE_NONE && self.type_at(vt).kind == TypeKind::TYPE_NEVER;
        }
        if n.kind == NodeKind::NODE_WHILE {
            let vt = unsafe (*a).type_of(id);
            return vt != TYPE_NONE && self.type_at(vt).kind == TypeKind::TYPE_NEVER;
        }
        if n.kind == NodeKind::NODE_BLOCK {
            let stmts = n.as_data.block.statements;
            for i in 0..stmts.len {
                if self.stmt_diverges(unsafe (*a).list(stmts)[i as usize], depth + 1) {
                    return true;
                }
            }
            return false;
        }
        if n.kind == NodeKind::NODE_IF {
            let ifd = n.as_data.if_stmt;
            return ifd.else_branch != NODE_NONE && self.stmt_diverges(ifd.then_branch, depth + 1) && self.stmt_diverges(
                ifd.else_branch,
                depth + 1,
            );
        }
        return false;
    }

    fn tc_fold_int(self: &mut Self, nid: NodeId, out: &mut i64) bool {
        let ceptr = self.cir();
        if ceptr == null {
            return false;
        }
        let v = self.ev(self.cur_module(), nid);
        if v.kind != iri::IV_INT {
            return false;
        }
        *out = v.i;
        return true;
    }

    // Whether `id` is the build constant PROFILE (the name is reserved, so its resolution decides).
    const fn tc_is_profile(self: &Self, id: NodeId) bool {
        let a = self.cur_ast();
        if unsafe (*a).at_const(id).kind != NodeKind::NODE_IDENTIFIER || (unsafe (*a).resolution_def(id).module) as i32 != unsafe (*self.package).build_module {
            return false;
        }
        let sp = self.name_span(id);
        return bc_index(self.source.slice(sp.start as usize, sp.end as usize)) == BC_PROFILE;
    }

    // A string literal compared with PROFILE must name a profile this build knows: a typo would
    // silently select the other branch. The package lists no profiles when its driver sets none.
    fn tc_profile_lit(self: &mut Self, lit: NodeId) {
        let pk = unsafe &*self.package;
        let n = *unsafe (*self.cur_ast()).at_const(lit);
        if pk.profiles.len() == 0 || n.kind != NodeKind::NODE_LITERAL || n.as_data.literal.token_type != TokenType::StringLiteral {
            return;
        }
        let raw = n.as_data.literal.raw;
        let name = self.source.slice(raw.start as usize + 1, raw.end as usize - 1);
        let mut known = String::new();
        for i in 0..pk.profiles.len() {
            if pk.profiles.at(i).as_str() == name {
                return;
            }
            if i != 0 {
                known.push_str(", ");
            }
            known.push_str(pk.profiles.at(i).as_str());
        }
        self.errors.emit_span(raw, format("unknown profile '{}'; this build knows {}", name, known.as_str()));
    }

    // The profile literals of a `PROFILE == "x"` comparison or of the arms of `switch PROFILE`.
    fn tc_profile_check(self: &mut Self, c: NodeId, other: NodeId) {
        if !self.tc_is_profile(c) {
            return;
        }
        let n = *unsafe (*self.cur_ast()).at_const(other);
        if n.kind == NodeKind::NODE_PATTERN_OR {
            for j in 0..n.as_data.pattern.children.len {
                let alt = unsafe (*self.cur_ast()).list(n.as_data.pattern.children)[j as usize];
                self.tc_profile_check(c, alt);
            }
        } else if n.kind == NodeKind::NODE_PATTERN_LITERAL {
            self.tc_profile_lit(n.as_data.single.value);
        } else {
            self.tc_profile_lit(other);
        }
    }

    @c.cold
    fn err_unsafe(self: &mut Self, sp: tok::Span, what: str) {
        self.errors.emit_span(sp, format("{} requires an 'unsafe' block", what));
        self.errors.note(format("{}", "wrap the operation in 'unsafe { ... }' or prefix the expression with 'unsafe'"));
    }
    fn tc_attr(self: &Self, m: ModuleId, owner: NodeId, kind: AttrKind) *const Attr {
        return unsafe (*self.mod_ast(m)).attr_of(owner, kind);
    }
    // Whether `t` mentions a '@no_const' declaration anywhere (through pointers, references,
    // slices, arrays and instance arguments). Used by the `const fn` def-site check: no value of
    // such a type can exist at compile time, so the signature cannot be part of a const contract.
    fn tc_ty_no_const(self: &Self, t: TypeId, depth: u32) bool {
        if t == TYPE_NONE || depth > 16 {
            return false;
        }
        let y = *self.type_at(t);
        if y.kind == TypeKind::TYPE_POINTER || y.kind == TypeKind::TYPE_REFERENCE || y.kind == TypeKind::TYPE_SLICE || y.kind == TypeKind::TYPE_ARRAY {
            return self.tc_ty_no_const(y.as_data.elem, depth + 1);
        }
        if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
            return self.tc_attr(y.module, y.as_data.decl, AttrKind::ATTR_NO_CONST) != null;
        }
        if y.kind == TypeKind::TYPE_INSTANCE {
            let it = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            if self.tc_attr(it.module, it.decl, AttrKind::ATTR_NO_CONST) != null {
                return true;
            }
            for i in 0..it.n {
                if self.tc_ty_no_const(unsafe it.args[i as usize], depth + 1) {
                    return true;
                }
            }
        }
        return false;
    }

    fn through_raw_pointer(self: &Self, ty0: TypeId) bool {
        let mut ty = ty0;
        let mut y = self.type_at(ty);
        while y.kind == TypeKind::TYPE_REFERENCE || y.kind == TypeKind::TYPE_POINTER {
            if y.kind == TypeKind::TYPE_POINTER {
                return true;
            }
            ty = y.as_data.elem;
            y = self.type_at(ty);
        }
        return false;
    }

    fn render_type(self: &Self, tid: TypeId, buf: *mut char, cap: usize) {
        render_type_into(self.package, self.cur_ast(), self.source, tid, buf, cap);
    }

    @c.cold
    fn err_no_field(self: &mut Self, name: tok::Span, ty: TypeId) {
        if ty == TYPE_ERROR {
            return;
        }
        let tb = self.type_buf(ty);
        self.errors.emit_span(
            name,
            format("no field '{}' on '{}'", diag::span_str(self.source, name.start, name.end), str::from_cstr(&tb[0])),
        );
    }

    // Type-checks condition `cond` of statement `what`; false after it reports a type that is not 'bool'.
    fn check_cond(self: &mut Self, cond: NodeId, what: str) bool {
        let c = self.check_expr(cond);
        if untyped(c) || self.is_bool(c) {
            return true;
        }
        let ty = self.type_buf(c);
        let sp = unsafe (*self.cur_ast()).at_const(cond).span;
        self.errors.emit_span(sp, format("{} condition must be 'bool', found '{}'", what, str::from_cstr(&ty[0])));
        return false;
    }

    // Bind extend `ext`'s generic parameters (in module `m`) for the instance of its target whose
    // arguments are `args[0..n]` (`tc_ext_args`), appended to the substitution frame `ps`/`ts` of `*k`
    // entries (at most 8). An extend that does not apply to that instance binds nothing.
    fn frame_ext(
        self: &mut Self,
        m: ModuleId,
        ext: NodeId,
        args: *const TypeId,
        n: i32,
        ps: *mut DefId,
        ts: *mut TypeId,
        k: &mut i32,
    ) {
        let mut ea = Tys8 {};
        let g = self.tc_ext_args(m, ext, args, n, &mut ea[0]);
        let a = self.mod_ast(m);
        let ig = unsafe (*a).at_const(ext).as_data.extend_def.generics;
        let mut i: i32 = 0;
        while i < g && *k < 8 {
            unsafe ps[(*k) as usize] = DefId { module: m, node: unsafe (*a).list(ig)[i as usize] };
            unsafe ts[(*k) as usize] = ea[i as usize];
            *k = *k + 1;
            i = i + 1;
        }
    }

    // The type extend `ext` of module `m` targets, over its own generic parameters.
    fn tc_ext_pattern(self: &mut Self, m: ModuleId, ext: NodeId) TypeId {
        return self.node_type_in(m, unsafe (*self.mod_ast(m)).at_const(ext).as_data.extend_def.target_type);
    }

    // Whether extend `ext` of module `m` applies to every instance of its target and binds its
    // parameters positionally (`ext_is_identity`).
    fn tc_ext_identity(self: &mut Self, m: ModuleId, ext: NodeId) bool {
        let key = m as u64 << 32 | ext as u64;
        switch self.ext_id_memo.get(&key) {
            Some(v) => {
                return *v;
            },
            None => {},
        };
        let pat = self.tc_ext_pattern(m, ext);
        let r = ext_is_identity(unsafe &*self.cur_ast(), pat, unsafe &*self.mod_ast(m), m, ext);
        self.ext_id_memo.insert(key, r);
        return r;
    }

    // Extend `ext`'s (module `m`) own generic arguments for the instance of its target whose arguments
    // are `ta[0..tn]`, into `out`: their count, or -1 when the extend does not apply to that instance.
    // Each argument the target constrains binds by its kind (`xarg_of`): a bare parameter takes the
    // instance's argument, a form `{c * N + k}` gives N the value that makes it equal the instance's
    // (`tc_ext_solve`), and an argument that names no parameter must equal the instance's.
    fn tc_ext_args(self: &mut Self, m: ModuleId, ext: NodeId, ta: *const TypeId, tn: i32, out: *mut TypeId) i32 {
        let ea = self.mod_ast(m);
        let gens = unsafe (*ea).at_const(ext).as_data.extend_def.generics;
        let g = pick(gens.len < 8, gens.len, 8) as i32;
        if self.tc_ext_identity(m, ext) {
            let mut i: i32 = 0;
            while i < g && i < tn {
                unsafe out[i as usize] = unsafe ta[i as usize];
                i += 1;
            }
            return i;
        }
        let pat = self.tc_ext_pattern(m, ext);
        let it = *unsafe (*self.cur_ast()).instance(self.type_at(pat).as_data.inst);
        let np = ext_arity(unsafe &*ea, ext, it.n);
        for i in 0..g {
            unsafe out[i as usize] = TYPE_NONE;
        }
        for j in 0..np {
            if j as i32 >= tn {
                return -1;
            }
            let pj = unsafe it.args[j as usize];
            let r = unsafe ta[j as usize];
            let x = xarg_of(unsafe &*self.cur_ast(), pj, unsafe &*ea, m, gens);
            if x.kind == XA_FIXED {
                if pj != r {
                    return -1;
                }
                continue;
            }
            let mut v = TYPE_NONE;
            if x.kind == XA_PARAM {
                v = r;
            } else if x.kind == XA_FORM {
                let bt = unsafe (*self.package).const_param_bt(m, unsafe (*ea).list(gens)[x.par as usize]);
                v = self.tc_ext_solve(r, &x, bt);
            }
            if v == TYPE_NONE || x.par as i32 >= g {
                return -1;
            }
            let prev = unsafe out[x.par as usize];
            if prev != TYPE_NONE && prev != v {
                return -1;
            }
            unsafe out[x.par as usize] = v;
        }
        for i in 0..g {
            if unsafe out[i as usize] == TYPE_NONE {
                return -1;
            }
        }
        return g;
    }

    // The value of FORM argument `x`'s parameter (of type `bt`) that makes the form equal argument `r`:
    // for a constant `r` a constant, exact and in `bt`. A symbolic `r` (a const parameter, or a form of
    // them without a division) gives the form `(r - k) / c`, whose every coefficient must divide
    // exactly and whose value must fit `bt` for every value `r` takes (`tc_lin_range`). TYPE_NONE when
    // no solution holds.
    fn tc_ext_solve(self: &mut Self, r: TypeId, x: &XArg, bt: BuiltinType) TypeId {
        let y = *self.type_at(r);
        let ptr32 = self.tc_ptr32();
        let mut q = i128::zero();
        if y.kind == TypeKind::TYPE_CONST {
            if !xarg_solve(x, y.cval(), bt, ptr32, &mut q) {
                return TYPE_NONE;
            }
            return unsafe (*self.cur_ast()).const_value(cval_bits(q), bt);
        }
        let mut rl = ConstLin::new(bt);
        if y.kind == TypeKind::TYPE_GENERIC {
            let rbt = unsafe (*self.package).const_param_bt(y.module, y.as_data.decl);
            if rbt == BuiltinType::BT_COUNT {
                return TYPE_NONE;
            }
            rl = ConstLin::new(rbt);
            let _ = rl.add_term(DefId { module: y.module, node: y.as_data.decl }, i128::one());
        } else if y.kind == TypeKind::TYPE_CONST_EXPR {
            rl = *unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst);
        } else {
            return TYPE_NONE;
        }
        let mut lo = i128::zero();
        let mut hi = i128::zero();
        if !self.tc_lin_range(&rl, &mut lo, &mut hi) {
            return TYPE_NONE;
        }
        let mut s = ConstLin::new(bt);
        if !xarg_solve_lin(x, &rl, bt, &mut s) {
            return TYPE_NONE;
        }
        // Every solution lies between the truncated quotients of the argument's extremes.
        let mut rem = i128::zero();
        let mut e = lo;
        if !lin_acc(&mut e, i128::from_i64(-1), x.k) || !bt_holds(bt, e.divmod(&x.c, &mut rem), ptr32) {
            return TYPE_NONE;
        }
        e = hi;
        if !lin_acc(&mut e, i128::from_i64(-1), x.k) || !bt_holds(bt, e.divmod(&x.c, &mut rem), ptr32) {
            return TYPE_NONE;
        }
        return self.tc_intern_form(&s);
    }

    // The least and the greatest value of form `l` over every value of its parameters' types, within
    // the types it computes in and stands for, into `lo` and `hi`: false when a term names something
    // other than a const generic parameter, or a bound leaves i128.
    fn tc_lin_range(self: &Self, l: &ConstLin, lo: &mut i128, hi: &mut i128) bool {
        let ptr32 = self.tc_ptr32();
        let mut a = l.k;
        let mut b = l.k;
        for i in 0..l.n {
            let c = unsafe l.c[i as usize];
            let p = unsafe l.p[i as usize];
            if c.is_zero() {
                continue;
            }
            if unsafe (*self.mod_ast(p.module)).at_const(p.node).kind != NodeKind::NODE_GENERIC_PARAM {
                return false;
            }
            let pbt = unsafe (*self.package).const_param_bt(p.module, p.node);
            if pbt == BuiltinType::BT_COUNT {
                return false;
            }
            let mut plo = i128::zero();
            let mut phi = i128::zero();
            bt_range(pbt, ptr32, &mut plo, &mut phi);
            let neg = c.is_negative();
            if !lin_acc(&mut a, c, pick(neg, phi, plo)) || !lin_acc(&mut b, c, pick(neg, plo, phi)) {
                return false;
            }
        }
        a = l.floor_of(a);
        b = l.floor_of(b);
        let mut tlo = i128::zero();
        let mut thi = i128::zero();
        bt_range(l.ty, ptr32, &mut tlo, &mut thi);
        let mut ulo = i128::zero();
        let mut uhi = i128::zero();
        bt_range(l.to, ptr32, &mut ulo, &mut uhi);
        if a < tlo {
            a = tlo;
        }
        if a < ulo {
            a = ulo;
        }
        if b > thi {
            b = thi;
        }
        if b > uhi {
            b = uhi;
        }
        *lo = a;
        *hi = b;
        return a <= b;
    }

    // Whether method `md` applies to receiver type `recv`: the extend that declares it applies to the
    // receiver's instance (`tc_ext_args`).
    fn tc_method_applies(self: &mut Self, recv: TypeId, md: DefId) bool {
        if md.node == NODE_NONE || recv == TYPE_NONE {
            return true;
        }
        let ext = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
        if ext == NODE_NONE || self.tc_ext_identity(md.module, ext) {
            return true;
        }
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(recv), &mut tm, &mut td, &mut gp, &mut ga, &mut gn) {
            return true;
        }
        let mut ea = Tys8 {};
        return self.tc_ext_args(md.module, ext, &ga[0], gn, &mut ea[0]) >= 0;
    }

    // Whether extends `e1` and `e2` of one peeled target apply to a common instance, as the method
    // lookup decides applicability (`tc_ext_args`: bounds do not take part). Each argument position
    // their targets constrain (`xarg_of`) must unify: a parameter meets anything, two fixed arguments
    // must be equal, a const form meets a fixed constant it solves (`tc_ext_solve`) and another form
    // whose values it shares (`xarg_forms_meet`).
    fn tc_exts_overlap(self: &mut Self, e1: DefId, e2: DefId) bool {
        let p1 = self.tc_ext_pattern(e1.module, e1.node);
        let p2 = self.tc_ext_pattern(e2.module, e2.node);
        if p1 == TYPE_NONE || p2 == TYPE_NONE || self.type_at(p1).kind != TypeKind::TYPE_INSTANCE || self.type_at(p2).kind != TypeKind::TYPE_INSTANCE {
            return true;
        }
        let i1 = *unsafe (*self.cur_ast()).instance(self.type_at(p1).as_data.inst);
        let i2 = *unsafe (*self.cur_ast()).instance(self.type_at(p2).as_data.inst);
        let a1 = self.mod_ast(e1.module);
        let a2 = self.mod_ast(e2.module);
        let g1 = unsafe (*a1).at_const(e1.node).as_data.extend_def.generics;
        let g2 = unsafe (*a2).at_const(e2.node).as_data.extend_def.generics;
        let n1 = ext_arity(unsafe &*a1, e1.node, i1.n);
        let n2 = ext_arity(unsafe &*a2, e2.node, i2.n);
        let tgens = unsafe (*self.mod_ast(i1.module)).at_const(i1.decl).as_data.aggregate.generics;
        let mut j: u32 = 0;
        while j < i1.n as u32 && j < i2.n as u32 {
            let t1 = unsafe i1.args[j as usize];
            let t2 = unsafe i2.args[j as usize];
            // A position past the written arguments constrains nothing.
            let mut x1 = XArg { c: i128::one(), k: i128::zero(), par: 0, kind: XA_PARAM };
            let mut x2 = x1;
            if j < n1 {
                x1 = xarg_of(unsafe &*self.cur_ast(), t1, unsafe &*a1, e1.module, g1);
            }
            if j < n2 {
                x2 = xarg_of(unsafe &*self.cur_ast(), t2, unsafe &*a2, e2.module, g2);
            }
            let vj = j;
            j += 1;
            if x1.kind == XA_BAD || x2.kind == XA_BAD {
                // Its extend is rejected at its target.
                return false;
            }
            if x1.kind == XA_PARAM || x2.kind == XA_PARAM {
                continue;
            }
            if x1.kind == XA_FIXED && x2.kind == XA_FIXED {
                if t1 != t2 {
                    return false;
                }
                continue;
            }
            if x1.kind == XA_FIXED || x2.kind == XA_FIXED {
                let xf = pick(x1.kind == XA_FORM, x1, x2);
                let em = pick(x1.kind == XA_FORM, e1.module, e2.module);
                let eg = pick(x1.kind == XA_FORM, g1, g2);
                let bt = unsafe (*self.package).const_param_bt(em, unsafe (*self.mod_ast(em)).list(eg)[xf.par as usize]);
                if self.tc_ext_solve(pick(x1.kind == XA_FIXED, t1, t2), &xf, bt) == TYPE_NONE {
                    return false;
                }
                continue;
            }
            let bt1 = unsafe (*self.package).const_param_bt(e1.module, unsafe (*a1).list(g1)[x1.par as usize]);
            let bt2 = unsafe (*self.package).const_param_bt(e2.module, unsafe (*a2).list(g2)[x2.par as usize]);
            let vbt = unsafe (*self.package).const_param_bt(
                i1.module,
                unsafe (*self.mod_ast(i1.module)).list(tgens)[vj as usize],
            );
            if !xarg_forms_meet(&x1, bt1, &x2, bt2, vbt, self.tc_ptr32()) {
                return false;
            }
        }
        return true;
    }

    // The first method named `name` of (m, decl) whose extend applies to receiver `recv`, marked used;
    // NODE_NONE when none does.
    fn tc_applicable_method(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span, recv: TypeId) DefId {
        let mut cands = Defs8 {};
        let mut n = self.find_method_all(m, decl, name, "", &mut cands);
        if n as usize > cands.len() {
            n = cands.len() as i32;
        }
        for i in 0..n {
            if self.tc_method_applies(recv, cands[i as usize]) {
                self.mark_recv = self.strip(recv);
                self.mark_n += 1;
                self.tc_mark_method_used(cands[i as usize]);
                return cands[i as usize];
            }
        }
        return DefId { module: 0, node: NODE_NONE };
    }

    // An extend's target solves each of its generic parameters (`tc_ext_args`): every argument it
    // constrains is one parameter, bare or in a const form `{c * N + k}` without a division, or names
    // none of them, and each parameter appears in exactly one argument. `Free` conforms every instance
    // of a type, so its extend binds positionally.
    fn tc_check_ext_target(self: &mut Self, id: NodeId) {
        let m = self.cur_module();
        if self.tc_ext_identity(m, id) {
            return;
        }
        let a = self.cur_ast();
        let ed = unsafe (*a).at_const(id).as_data.extend_def;
        let pat = self.tc_ext_pattern(m, id);
        let it = *unsafe (*a).instance(self.type_at(pat).as_data.inst);
        let np = ext_arity(unsafe &*a, id, it.n);
        let targs = unsafe (*a).at_const(ed.target_type).as_data.type_path.args;
        let mut seen: u64 = 0;
        let mut bad = false;
        let mut w: u32 = 0;
        for j in 0..np {
            // The written argument `j` stands for (the whole target for an alias).
            let mut an = ed.target_type;
            while w < targs.len && unsafe (*a).at_const(unsafe (*a).list(targs)[w as usize]).kind == NodeKind::NODE_LIFETIME {
                w += 1;
            }
            if w < targs.len {
                an = unsafe (*a).list(targs)[w as usize];
                w += 1;
            }
            let sp = unsafe (*a).at_const(an).span;
            let x = xarg_of(unsafe &*a, unsafe it.args[j as usize], unsafe &*a, m, ed.generics);
            if x.kind == XA_BAD {
                bad = true;
                self.errors.emit_span(
                    sp,
                    format(
                        "an extend's target argument must be one of its generic parameters, a const form `c * N + k` of one, or a type that names none of them",
                    ),
                );
            } else if x.kind != XA_FIXED && x.par < 64 {
                if (seen >> x.par as u64 & 1u64) != 0 {
                    let gn = unsafe (*a).at_const(unsafe (*a).list(ed.generics)[x.par as usize]).as_data.generic_param.name;
                    let gs = unsafe (*a).at_const(gn).as_data.name.text;
                    self.errors.emit_span(
                        sp,
                        format(
                            "the generic parameter '{}' appears in two arguments of the extend's target",
                            diag::span_str(self.source, gs.start, gs.end),
                        ),
                    );
                }
                seen = seen | 1u64 << x.par as u64;
            }
        }
        // A parameter inside a rejected argument is reported with it.
        for i in 0..ed.generics.len {
            if !bad && i < 64 && (seen >> i as u64 & 1u64) == 0 {
                let gid = unsafe (*a).list(ed.generics)[i as usize];
                let gs = unsafe (*a).at_const(unsafe (*a).at_const(gid).as_data.generic_param.name).as_data.name.text;
                self.errors.emit_span(
                    gs,
                    format(
                        "the generic parameter '{}' of this extend does not appear in its target",
                        diag::span_str(self.source, gs.start, gs.end),
                    ),
                );
                self.errors.note(format("an extend solves its parameters from its target's arguments"));
            }
        }
        if ed.interface_type != NODE_NONE && self.is_free_iface(unsafe (*a).resolution_def(ed.interface_type)) {
            self.errors.emit_span(
                unsafe (*a).at_const(ed.target_type).span,
                format(
                    "'Free' is implemented for every instance of a type: write the target with the extend's parameters in order",
                ),
            );
        }
    }

    @c.cold
    fn err_lit_range(self: &mut Self, node: NodeId, ty: TypeId) {
        let tn = self.type_buf(ty);
        let sp = unsafe (*self.cur_ast()).at_const(node).span;
        self.errors.emit_span(sp, format("integer literal is out of range for '{}'", str::from_cstr(&tn[0])));
    }

    // A negation `node` of unsigned type `ty`: no unsigned value has one.
    @c.cold
    fn err_neg_unsigned(self: &mut Self, node: NodeId, ty: TypeId) {
        let tn = self.type_buf(ty);
        let sp = unsafe (*self.cur_ast()).at_const(node).span;
        self.errors.emit_span(sp, format("cannot apply unary operator '-' to type '{}'", str::from_cstr(&tn[0])));
    }

    // An unpinned literal operand, or literal-only arithmetic of kind `k` (`2 * 3`), takes the other
    // operand's numeric type `ty`: an integer type integer literals, each reported when it does not
    // fit; a float type float literals. False when the kinds differ: an integer literal never becomes
    // a float, and a float literal never an integer.
    fn lit_adopt(self: &mut Self, lit: NodeId, k: u8, ty: TypeId) bool {
        let b = self.bt_of(ty);
        if k == 3 {
            if bt_is_int(b) {
                unsafe (*self.cur_ast()).set_type(lit, ty);
            }
        } else if bt_is_int(b) {
            if k == 2 {
                return false;
            }
            let _ = self.tc_lit_set_int(lit, ty, true, false, false);
        } else if k == 1 && bt_is_float(b) {
            return false;
        } else if k == 2 && bt_is_float(b) {
            self.tc_lit_set_flt(lit, ty);
            let _ = self.tc_lit_frange(lit, ty, true);
        }
        return true;
    }

    // The kind of a literal-only arithmetic leaf: 1 for an unsuffixed integer literal, 2 for an
    // unsuffixed float literal (either one negated), 0 for anything else.
    fn tc_lit_leafk(self: &Self, n: NodeId) u8 {
        let a = self.cur_ast();
        let mut lit = n;
        if unsafe (*a).at_const(n).kind == NodeKind::NODE_UNARY {
            lit = unsafe (*a).at_const(n).as_data.unary.operand;
        }
        let lk = self.tc_lim(lit);
        if lk != 0 {
            return lk;
        }
        let nd = unsafe (*a).at_const(lit);
        if nd.kind != NodeKind::NODE_LITERAL || self.tc_literal_pinned(lit) {
            return 0;
        }
        let tt = nd.as_data.literal.token_type;
        if tt == TokenType::IntegerLiteral && !lit_width_suffix(self.source, nd.as_data.literal.raw) {
            return 1;
        }
        if tt == TokenType::FloatLiteral {
            return 2;
        }
        return 0;
    }

    // Whether `n` is a character or byte-character literal.
    const fn tc_char_lit(self: &Self, n: NodeId) bool {
        let nd = unsafe (*self.cur_ast()).at_const(n);
        let tt = nd.as_data.literal.token_type;
        return nd.kind == NodeKind::NODE_LITERAL && (tt == TokenType::CharacterLiteral || tt == TokenType::ByteCharacterLiteral);
    }

    // A leaf of literal-only arithmetic: a literal or a builtin limit (`i32::MAX`), or a negated one.
    const fn tc_lit_is_leaf(self: &Self, n: NodeId) bool {
        let a = self.cur_ast();
        let nd = unsafe (*a).at_const(n);
        let lit = if nd.kind == NodeKind::NODE_UNARY {
            nd.as_data.unary.operand;
        } else {
            n;
        };
        return unsafe (*a).at_const(lit).kind == NodeKind::NODE_LITERAL && (lit == n || nd.as_data.unary.op == TokenType::Minus) || self.tc_lim(
            lit,
        ) != 0 && (lit == n || nd.as_data.unary.op == TokenType::Minus);
    }

    // A builtin numeric limit named as a value (`i32::MAX`, `f64::MIN`): 1 for an integer type's, 2
    // for a float type's, 0 for anything else. Literal-only arithmetic reads it as the literal of its
    // value, so `i32::MAX + 1` is an `i64` and `let i: i32 = i32::MAX + 1;` overflows.
    const fn tc_lim(self: &Self, n: NodeId) u8 {
        let a = self.cur_ast();
        let nd = unsafe (*a).at_const(n);
        if nd.kind != NodeKind::NODE_MEMBER || !nd.as_data.member.path {
            return 0;
        }
        let obj = nd.as_data.member.object;
        if unsafe (*a).at_const(obj).kind != NodeKind::NODE_IDENTIFIER || unsafe (*a).resolution_def(obj).node != NODE_NONE {
            return 0;
        }
        let ms = unsafe (*a).at_const(nd.as_data.member.member).as_data.name.text;
        if !span_is(self.source, ms, "MIN") && !span_is(self.source, ms, "MAX") {
            return 0;
        }
        let b = bt_of_name(self.source, unsafe (*a).at_const(obj).span);
        if b < 0 {
            return 0;
        }
        if bt_is_int(b as BuiltinType) {
            return 1;
        }
        return pick(bt_is_float(b as BuiltinType), 2u8, 0u8);
    }

    // The builtin type and whether the limit is MAX, of limit `n` (tc_lim).
    const fn tc_lim_of(self: &Self, n: NodeId, is_max: &mut bool) BuiltinType {
        let a = self.cur_ast();
        let nd = unsafe (*a).at_const(n);
        *is_max = span_is(self.source, unsafe (*a).at_const(nd.as_data.member.member).as_data.name.text, "MAX");
        return bt_of_name(self.source, unsafe (*a).at_const(nd.as_data.member.object).span) as BuiltinType;
    }

    // The magnitude and sign of integer limit `n` on the target.
    const fn tc_lim_int(self: &Self, n: NodeId, mag: &mut u64, neg: &mut bool) {
        let mut is_max = false;
        let b = self.tc_lim_of(n, &mut is_max);
        let mx = bt_int_max(b, self.tc_ptr32());
        let signed = b == BuiltinType::BT_I8 || b == BuiltinType::BT_I16 || b == BuiltinType::BT_I32 || b == BuiltinType::BT_I64 || b == BuiltinType::BT_ISIZE;
        *neg = signed && !is_max;
        if is_max {
            *mag = pick(mx == 0, 0xFFFFFFFFFFFFFFFFu64, mx);
        } else {
            *mag = pick(signed, mx + 1, 0u64);
        }
    }

    // The value of float limit `n`: the largest finite value of its type, negated for MIN.
    const fn tc_lim_flt(self: &Self, n: NodeId) f64 {
        let mut is_max = false;
        let b = self.tc_lim_of(n, &mut is_max);
        let v: f64 = if b == BuiltinType::BT_F32 {
            3.4028234663852886e38;
        } else {
            1.7976931348623157e308;
        };
        return pick(is_max, v, -v);
    }

    // The magnitude and sign of integer leaf literal `lit` (a literal or a limit); false when a
    // literal's digits do not parse.
    fn tc_leaf_mag(self: &Self, lit: NodeId, mag: &mut u64, neg: &mut bool) bool {
        if self.tc_lim(lit) == 1 {
            self.tc_lim_int(lit, mag, neg);
            return true;
        }
        *neg = false;
        return self.lit_mag(lit, mag);
    }

    // The next node down the left spine of literal-only arithmetic: a binary's left operand, a negation's
    // operand.
    const fn tc_lit_below(self: &Self, n: NodeId) NodeId {
        let nd = unsafe (*self.cur_ast()).at_const(n);
        if nd.kind == NodeKind::NODE_BINARY {
            return nd.as_data.binary.left;
        }
        return nd.as_data.unary.operand;
    }

    // Whether `id` is literal-only arithmetic (unsuffixed numeric literals under `+ - * / %`, the
    // integer-only `& | ^ << >>`, and unary `-`): 1 when every literal is an integer, 2 when every
    // literal is a float, 0 when it is not literal-only (an integer literal never becomes a float,
    // so the two kinds do not mix).
    fn tc_lit_kind(self: &Self, id: NodeId) u8 {
        let a = self.cur_ast();
        let mut n = id;
        let mut k: u8 = 0; // the kind of the literals seen so far (0: none yet)
        // Below an integer-only operator every operand must be an integer.
        let mut int_only = false;
        while !self.tc_lit_is_leaf(n) {
            let nd = unsafe (*a).at_const(n);
            if nd.kind == NodeKind::NODE_BINARY {
                let ok = lit_arith_op(nd.as_data.binary.op);
                if ok == 0 {
                    return 0;
                }
                int_only = int_only || ok == 2;
                let rk = self.tc_lit_kind(nd.as_data.binary.right);
                if rk == 0 || int_only && rk == 2 || k != 0 && k != rk {
                    return 0;
                }
                k = rk;
            } else if nd.kind != NodeKind::NODE_UNARY || nd.as_data.unary.op != TokenType::Minus {
                return 0;
            }
            n = self.tc_lit_below(n);
        }
        let lk = self.tc_lit_leafk(n);
        if lk == 0 || int_only && lk == 2 || k != 0 && k != lk {
            return 0;
        }
        return lk;
    }

    // The kind of binary `b` whose left operand is literal-only arithmetic of kind `k`, as tc_lit_kind.
    fn tc_lit_step(self: &Self, b: NodeId, k: u8) u8 {
        let bd = unsafe (*self.cur_ast()).at_const(b).as_data.binary;
        let ok = lit_arith_op(bd.op);
        if ok == 0 {
            return 0;
        }
        let rk = self.tc_lit_kind(bd.right);
        if rk != k || ok == 2 && k != 1 {
            return 0;
        }
        return k;
    }

    // The value of integer leaf `n` in `bt` (i32, i64 or u64), as lit_int_op answers.
    fn tc_lit_leaf_ival(self: &Self, n: NodeId, bt: BuiltinType, out: &mut i64) u8 {
        let a = self.cur_ast();
        let minus = unsafe (*a).at_const(n).kind == NodeKind::NODE_UNARY;
        let lit = if minus {
            unsafe (*a).at_const(n).as_data.unary.operand;
        } else {
            n;
        };
        let mut mag: u64 = 0;
        let mut lneg = false;
        if !self.tc_leaf_mag(lit, &mut mag, &mut lneg) {
            return 2;
        }
        let neg = minus != lneg && mag != 0;
        if bt == BuiltinType::BT_U64 {
            if neg && mag != 0 {
                return 1;
            }
        } else if !tc_lit_in_range(bt, mag, neg, false) {
            return 1;
        }
        *out = if neg {
            mag.wrapping_neg() as i64;
        } else {
            mag as i64;
        };
        return 0;
    }

    // Integer literal-only arithmetic `id` evaluated in `bt` (i32, i64 or u64), as lit_int_op answers:
    // 0 with the value in `out`, 1 when a step overflows `bt`, 2 when a step traps in every type.
    fn tc_lit_ival(self: &Self, id: NodeId, bt: BuiltinType, out: &mut i64) u8 {
        let a = self.cur_ast();
        let mut spine = Vector::<NodeId>::new();
        let mut n = id;
        while !self.tc_lit_is_leaf(n) {
            spine.push(n);
            n = self.tc_lit_below(n);
        }
        let mut v: i64 = 0;
        let st = self.tc_lit_leaf_ival(n, bt, &mut v);
        if st != 0 {
            return st;
        }
        let mut i = spine.len();
        while i > 0 {
            i -= 1;
            let nd = unsafe (*a).at_const(*spine.at(i));
            let mut r: i64 = 0;
            let mut os: u8 = 0;
            if nd.kind == NodeKind::NODE_BINARY {
                let mut rv: i64 = 0;
                let rs = self.tc_lit_ival(nd.as_data.binary.right, bt, &mut rv);
                if rs != 0 {
                    return rs;
                }
                os = lit_int_op(nd.as_data.binary.op, v, rv, bt, &mut r);
            } else {
                os = lit_int_op(TokenType::Minus, 0, v, bt, &mut r);
            }
            if os != 0 {
                return os;
            }
            v = r;
        }
        *out = v;
        return 0;
    }

    // Type integer literal-only arithmetic `id` as integer type `ty`, every node of it. A literal that
    // does not fit `ty` makes the answer false and, with `report`, is an error. `probe` only answers;
    // `first` also runs each literal's own checks (the first typing of the expression).
    fn tc_lit_set_int(self: &mut Self, id: NodeId, ty: TypeId, report: bool, probe: bool, first: bool) bool {
        let a = self.cur_ast();
        let tb = self.bt_of(ty);
        let mut ok = true;
        let mut n = id;
        let uns = bt_is_uint(tb);
        while !self.tc_lit_is_leaf(n) {
            if !probe {
                unsafe (*a).set_type(n, ty);
            }
            if unsafe (*a).at_const(n).kind == NodeKind::NODE_BINARY {
                ok = self.tc_lit_set_int(unsafe (*a).at_const(n).as_data.binary.right, ty, report, probe, first) && ok;
                if !ok && probe {
                    return false;
                }
            } else if uns {
                if probe {
                    return false;
                }
                ok = false;
                if report {
                    self.err_neg_unsigned(n, ty);
                }
            }
            n = self.tc_lit_below(n);
        }
        let lit = if unsafe (*a).at_const(n).kind == NodeKind::NODE_UNARY {
            unsafe (*a).at_const(n).as_data.unary.operand;
        } else {
            n;
        };
        if self.tc_lim(lit) != 0 {
            self.tc_lim_resolve(lit);
        } else if first {
            let _ = self.check_literal(lit, TYPE_NONE);
        }
        let mut mag: u64 = 0;
        let mut lneg = false;
        if uns && lit != n {
            if probe {
                return false;
            }
            ok = false;
            if report {
                self.err_neg_unsigned(n, ty);
            }
        } else if self.tc_leaf_mag(lit, &mut mag, &mut lneg) && !tc_lit_in_range(
            tb,
            mag,
            lit != n != lneg && mag != 0,
            self.tc_ptr32(),
        ) {
            if probe {
                return false;
            }
            ok = false;
            if report {
                self.err_lit_range(n, ty);
            }
        }
        if !probe {
            unsafe (*a).set_type(n, ty);
            unsafe (*a).set_type(lit, ty);
        }
        return ok;
    }

    // Type float literal-only arithmetic `id` as float type `ty`, every node of it.
    fn tc_lit_set_flt(self: &mut Self, id: NodeId, ty: TypeId) {
        let a = self.cur_ast();
        let mut n = id;
        while !self.tc_lit_is_leaf(n) {
            unsafe (*a).set_type(n, ty);
            if unsafe (*a).at_const(n).kind == NodeKind::NODE_BINARY {
                self.tc_lit_set_flt(unsafe (*a).at_const(n).as_data.binary.right, ty);
            }
            n = self.tc_lit_below(n);
        }
        let lit = self.tc_lit_below_leaf(n);
        if self.tc_lim(lit) != 0 {
            self.tc_lim_resolve(lit);
        }
        unsafe (*a).set_type(n, ty);
        unsafe (*a).set_type(lit, ty);
    }

    // Resolve limit leaf `lit` (tc_lim) to its std constant once; its type is the arithmetic's.
    fn tc_lim_resolve(self: &mut Self, lit: NodeId) {
        let mem = unsafe (*self.cur_ast()).at_const(lit).as_data.member.member;
        if unsafe (*self.cur_ast()).resolution_def(mem).node == NODE_NONE {
            let _ = self.check_path_member(lit, TYPE_NONE);
        }
    }

    // The literal of leaf `n` (a literal, or a negated one).
    const fn tc_lit_below_leaf(self: &Self, n: NodeId) NodeId {
        let nd = unsafe (*self.cur_ast()).at_const(n);
        if nd.kind == NodeKind::NODE_UNARY {
            return nd.as_data.unary.operand;
        }
        return n;
    }

    // The value of float literal `lit` (no suffix); false when its spelling does not parse here.
    fn tc_flit_value(self: &Self, lit: NodeId, out: &mut f64) bool {
        let lr = unsafe (*self.cur_ast()).at_const(lit).as_data.literal.raw;
        let mut sfx = lr.end;
        let _ = ast_numeric_suffix(self.source, lr.start, lr.end, &mut sfx);
        return switch self.source.slice(lr.start as usize, sfx as usize).parse_f64() {
            Some(v) => {
                *out = v;
                true;
            },
            None => false,
        };
    }

    // Float literal-only arithmetic `id`, evaluated in f64: false when a literal does not parse. `flags`
    // gains 1 when a step passes the f32 range and 2 when a step of finite operands passes the f64 range
    // (division by zero excepted: its infinity is the IEEE answer).
    fn tc_lit_fval(self: &Self, id: NodeId, out: &mut f64, flags: &mut u8) bool {
        let a = self.cur_ast();
        let mut spine = Vector::<NodeId>::new();
        let mut n = id;
        while !self.tc_lit_is_leaf(n) {
            spine.push(n);
            n = self.tc_lit_below(n);
        }
        let mut v: f64 = 0.0;
        let lit = self.tc_lit_below_leaf(n);
        if self.tc_lim(lit) == 2 {
            v = self.tc_lim_flt(lit);
        } else if !self.tc_flit_value(lit, &mut v) {
            return false;
        }
        if n != lit {
            v = -v;
        }
        if v - v != 0.0 {
            *flags = *flags | 2;
        } else if v.abs() >= F32_LIMIT {
            *flags = *flags | 1;
        }
        let mut i = spine.len();
        while i > 0 {
            i -= 1;
            let nd = unsafe (*a).at_const(*spine.at(i));
            if nd.kind != NodeKind::NODE_BINARY {
                v = -v;
                continue;
            }
            let mut c: f64 = 0.0;
            if !self.tc_lit_fval(nd.as_data.binary.right, &mut c, flags) {
                return false;
            }
            let op = nd.as_data.binary.op;
            let r = if op == TokenType::Plus {
                v + c;
            } else if op == TokenType::Minus {
                v - c;
            } else if op == TokenType::Star {
                v * c;
            } else if op == TokenType::Slash {
                v / c;
            } else {
                unsafe math::fmod(v, c);
            };
            if r - r != 0.0 {
                if v - v == 0.0 && c - c == 0.0 && !(op == TokenType::Slash && c == 0.0) {
                    *flags = *flags | 2;
                }
            } else if r.abs() >= F32_LIMIT {
                *flags = *flags | 1;
            }
            v = r;
        }
        *out = v;
        return true;
    }

    // The range of float literal-only arithmetic `id` typed `fty`. A declared type reports a value past
    // it; an undeclared f32 expression past the f32 range becomes f64. The final type.
    fn tc_lit_frange(self: &mut Self, id: NodeId, fty: TypeId, declared: bool) TypeId {
        let mut v: f64 = 0.0;
        let mut fl: u8 = 0;
        if !self.tc_lit_fval(id, &mut v, &mut fl) || fl == 0 {
            return fty;
        }
        let f64t = Ast::builtin(BuiltinType::BT_F64);
        if (fl & 2) == 0 && self.bt_of(fty) == BuiltinType::BT_F64 {
            return fty;
        }
        let mut t = fty;
        if !declared {
            t = f64t;
            self.tc_lit_set_flt(id, t);
            if (fl & 2) == 0 {
                return t;
            }
        }
        let tn = self.type_buf(t);
        let what = if self.tc_lit_is_leaf(id) {
            "float literal";
        } else {
            "float constant expression";
        };
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        self.errors.emit_span(sp, format("{} is out of range for '{}'", what, str::from_cstr(&tn[0])));
        return t;
    }

    // Literal-only arithmetic `id` of kind `k` (tc_lit_kind). With an expected builtin type of its kind
    // it is computed in that type; without one, in the first of i32, i64 and u64 where no step
    // overflows (a float expression: f32, or f64 past the f32 range). The type.
    fn tc_lit_arith(self: &mut Self, id: NodeId, k: u8, expected: TypeId) TypeId {
        let eb = if expected != TYPE_NONE {
            self.bt_of(expected);
        } else {
            BuiltinType::BT_COUNT;
        };
        if k == 2 {
            let declared = bt_is_float(eb);
            let fty = if declared {
                expected;
            } else {
                Ast::builtin(BuiltinType::BT_F32);
            };
            self.tc_lit_set_flt(id, fty);
            return self.tc_lit_frange(id, fty, declared);
        }
        if bt_is_int(eb) {
            let _ = self.tc_lit_set_int(id, expected, true, false, true);
            return expected;
        }
        for b in [BuiltinType::BT_I32, BuiltinType::BT_I64, BuiltinType::BT_U64] {
            let mut v: i64 = 0;
            if self.tc_lit_ival(id, b, &mut v) != 1 {
                let t = Ast::builtin(b);
                let _ = self.tc_lit_set_int(id, t, true, false, true);
                return t;
            }
        }
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        self.errors.emit_span(sp, format("integer constant expression does not fit in 'i32', 'i64' or 'u64'"));
        let t = Ast::builtin(BuiltinType::BT_I64);
        let _ = self.tc_lit_set_int(id, t, false, false, true);
        return t;
    }

    /// `tid` rendered for a diagnostic.
    @c.cold
    fn type_buf(self: &Self, tid: TypeId) Buf96 {
        let mut b = Buf96 {};
        self.render_type(tid, &mut b[0], 96);
        return b;
    }

    @c.cold
    fn err_mismatch(self: &mut Self, node: NodeId, expected: TypeId) {
        if expected == TYPE_ERROR || unsafe (*self.cur_ast()).type_of(node) == TYPE_ERROR {
            return; // reported where the type was rejected
        }
        let e = self.type_buf(expected);
        let f = self.type_buf(unsafe (*self.cur_ast()).type_of(node));
        let sp = unsafe (*self.cur_ast()).at_const(node).span;
        self.errors.emit_span(
            sp,
            format("mismatched types: expected '{}', found '{}'", str::from_cstr(&e[0]), str::from_cstr(&f[0])),
        );
    }

    // The parameter list and return type of function type `fid`.
    fn fn_sig(self: &mut Self, fid: TypeId) FnShape {
        if unsafe TS_ON {
            ts_add(TS_FNSIG, 1);
        }
        let fty = *self.type_at(fid);
        if fty.fn_sig() {
            let a = self.cur_ast();
            let nr = unsafe (*a).sig_len(&fty, true);
            let mut ret = TYPE_NONE; // multi-return: callers read the results instead
            if nr == 1 {
                ret = unsafe (*a).sig_at(&fty, true, 0);
            } else if nr == 0 {
                ret = Ast::builtin(BuiltinType::BT_VOID);
            }
            return FnShape {
                m: 0,
                ps: NodeList { start: 0, len: 0 },
                ret: ret,
                sig: fid,
                np: unsafe (*a).sig_len(&fty, false),
            };
        }
        let m = fty.module;
        let fa = self.mod_ast(m);
        let fn0 = unsafe (*fa).at_const(fty.as_data.decl);
        let mut ps = NodeList { start: 0, len: 0 };
        let mut rs = NodeList { start: 0, len: 0 };
        let _ = unsafe (*fa).sig_lists(fty.as_data.decl, &mut ps, &mut rs);
        let mut ret = TYPE_NONE; // multi-return: callers read the component list instead
        if fn0.kind == NodeKind::NODE_CLOSURE && fn0.as_data.closure.expr_body {
            ret = unsafe (*fa).type_of(fn0.as_data.closure.body);
        } else if rs.len == 1 {
            ret = self.node_type_in(m, unsafe (*fa).list(rs)[0]);
        } else if rs.len == 0 {
            // An omitted return type IS void: TYPE_NONE here would make call sites lenient.
            ret = Ast::builtin(BuiltinType::BT_VOID);
        }
        return FnShape { m: m, ps: ps, ret: ret, sig: TYPE_NONE, np: ps.len };
    }

    // Parameter `i` of `sh`: an unannotated closure parameter's inferred type, else its declared one.
    fn fn_param(self: &mut Self, sh: &FnShape, i: u32) TypeId {
        if sh.sig != TYPE_NONE {
            return unsafe (*self.cur_ast()).sig_at(self.type_at(sh.sig), false, i);
        }
        let fa = self.mod_ast(sh.m);
        let pid = unsafe (*fa).list(sh.ps)[i as usize];
        let p = unsafe (*fa).at_const(pid);
        if p.kind == NodeKind::NODE_PARAMETER && p.as_data.parameter.ty == NODE_NONE {
            return unsafe (*fa).type_of(pid);
        }
        return self.node_type_in(sh.m, pid);
    }

    const fn receiver_type_eq(self: &Self, a: TypeId, b: TypeId) bool {
        if a == b {
            return true;
        }
        let at = self.type_at(a);
        let bt = self.type_at(b);
        let ap = at.kind == TypeKind::TYPE_POINTER || at.kind == TypeKind::TYPE_REFERENCE;
        let bp = bt.kind == TypeKind::TYPE_POINTER || bt.kind == TypeKind::TYPE_REFERENCE;
        return ap && bp && at.qualifier == bt.qualifier && at.as_data.elem == bt.as_data.elem;
    }

    fn generic_fn_bound(self: &Self, m: ModuleId, decl: NodeId) NodeId {
        let a = self.mod_ast(m);
        let gp = unsafe (*a).at_const(decl);
        if gp.kind != NodeKind::NODE_GENERIC_PARAM {
            return NODE_NONE;
        }
        let bounds = gp.as_data.generic_param.bounds;
        for i in 0..bounds.len {
            let bid = unsafe (*a).list(bounds)[i as usize];
            if unsafe (*a).at_const(bid).kind == NodeKind::NODE_FUNCTION_TYPE {
                return bid;
            }
        }
        if self.icx.current_fn != NODE_NONE && m == self.cur_module() {
            let wc = unsafe (*self.cur_ast()).at_const(self.icx.current_fn).as_data.function.where_clause;
            for w in 0..wc.len {
                let wid = unsafe (*self.cur_ast()).list(wc)[w as usize];
                let wp = unsafe (*self.cur_ast()).at_const(wid).as_data.where_predicate;
                if unsafe (*self.cur_ast()).resolution(wp.ty) == decl {
                    for b in 0..wp.bounds.len {
                        let wbid = unsafe (*self.cur_ast()).list(wp.bounds)[b as usize];
                        if unsafe (*self.cur_ast()).at_const(wbid).kind == NodeKind::NODE_FUNCTION_TYPE {
                            return wbid;
                        }
                    }
                }
            }
        }
        return NODE_NONE;
    }

    const fn fn_is_capturing(self: &Self, fid: TypeId) bool {
        let fy = self.type_at(fid);
        if fy.kind != TypeKind::TYPE_FUNCTION {
            return false;
        }
        let a = self.mod_ast(fy.module);
        let fnn = unsafe (*a).at_const(fy.as_data.decl);
        return fnn.kind == NodeKind::NODE_CLOSURE && fnn.as_data.closure.captures.len != 0;
    }

    // A binding mutated in a closure body (assigned, `&mut`-borrowed, or a `&mut self` receiver):
    // in every enclosing closure under check that captures it, a non-owning capture is captured by
    // reference (its mut_caps bit), and an owning one is recorded in own_mut (the env owns it; see
    // tc_borrow_owned_caps). A bound check on the closure (`fn_owns`) then reads final masks. The
    // borrow pass derives the same mut_caps bits from Core IR (Lowerer::note_mut_bind uses this peel).
    fn tc_note_capture_mut(self: &mut Self, expr0: NodeId) {
        if self.icx.nclos == 0 {
            return;
        }
        let a = self.cur_ast();
        let mut expr = expr0;
        loop {
            let n = unsafe (*a).at_const(expr);
            if n.kind == NodeKind::NODE_UNARY && (n.as_data.unary.op == TokenType::Move || n.as_data.unary.op == TokenType::Unsafe) {
                expr = n.as_data.unary.operand;
            } else if n.kind == NodeKind::NODE_MEMBER && !n.as_data.member.path {
                expr = n.as_data.member.object;
            } else if n.kind == NodeKind::NODE_INDEX {
                expr = n.as_data.index.object;
            } else {
                break;
            }
        }
        if unsafe (*a).at_const(expr).kind != NodeKind::NODE_IDENTIFIER {
            return;
        }
        let d = unsafe (*a).resolution(expr);
        if d == NODE_NONE {
            return;
        }
        for k in 0..self.icx.nclos {
            let c = unsafe self.icx.clos_stack[k as usize];
            let idx = self.tc_capture_index(c, d);
            if idx >= 0 {
                let cl = unsafe (*a).at_const(c).as_data.closure;
                let bit = 1u32 << idx as u32;
                if self.tc_capture_owns(unsafe (*a).type_of(unsafe (*a).list(cl.captures)[idx as usize])) {
                    unsafe (*a).at(c).as_data.closure.own_mut = cl.own_mut | bit;
                } else {
                    unsafe (*a).at(c).as_data.closure.mut_caps = cl.mut_caps | bit;
                }
            }
        }
    }

    // `tc_borrow_owned_caps(ty)` when bound list `bounds` (of module ast `fa`) has a plain `fn(..)`.
    fn tc_plain_fn_borrows(self: &mut Self, fa: *mut Ast, bounds: NodeList, ty: TypeId) {
        for b in 0..bounds.len {
            let bn = unsafe (*fa).at_const(unsafe (*fa).list(bounds)[b as usize]);
            if bn.kind == NodeKind::NODE_FUNCTION_TYPE && !bn.as_data.function_type.is_move {
                self.tc_borrow_owned_caps(ty);
                return;
            }
        }
    }

    // A plain `fn(..)` bound takes a closure that owns nothing (the callee may copy it). A closure of
    // this module whose captures own values borrows them instead: the body cannot move a captured
    // value in either mode, so only the owner changes, and the borrow checker keeps each borrowed
    // binding alive and unmoved while the closure value lives.
    fn tc_borrow_owned_caps(self: &mut Self, ty: TypeId) {
        let y = *self.type_at(ty);
        if y.kind != TypeKind::TYPE_FUNCTION || y.module != self.cur_module() {
            return;
        }
        let a = self.cur_ast();
        let c = y.as_data.decl;
        if unsafe (*a).at_const(c).kind != NodeKind::NODE_CLOSURE {
            return;
        }
        let cl = unsafe (*a).at_const(c).as_data.closure;
        let mut add: u32 = 0;
        for i in 0..cl.captures.len {
            let bit = 1u32 << i;
            if ((cl.mut_caps | cl.ref_caps) & bit) == 0 && self.tc_capture_owns(
                unsafe (*a).type_of(unsafe (*a).list(cl.captures)[i as usize]),
            ) {
                add = add | bit;
            }
        }
        if add == 0 {
            return;
        }
        let muts = cl.mut_caps | add & cl.own_mut;
        let refs = cl.ref_caps | add & ~cl.own_mut;
        unsafe (*a).at(c).as_data.closure.mut_caps = muts;
        unsafe (*a).at(c).as_data.closure.ref_caps = refs;
        let cf = unsafe (*a).closure_fact_mut(c);
        if cf != null {
            unsafe (*cf).mut_caps = muts;
            unsafe (*cf).ref_caps = refs;
        }
    }

    /// Index of binding `decl` in closure `clos`'s capture list, or -1 when not captured.
    pub fn tc_capture_index(self: &Self, clos: NodeId, decl: NodeId) i32 {
        let a = self.cur_ast();
        let caps = unsafe (*a).at_const(clos).as_data.closure.captures;
        for i in 0..caps.len {
            let cid = unsafe (*a).list(caps)[i as usize];
            if cid == decl {
                return i as i32;
            }
        }
        return -1;
    }

    // A foreign node's checked type under the schedule's visibility: an item the item under
    // check depends on is complete, so its value is final; any other item's value is TYPE_NONE
    // whatever a worker has done with it, so every worker order answers alike.
    fn tc_foreign_type_of(self: &mut Self, fm: ModuleId, n: NodeId) TypeId {
        if fm == self.cur_module() {
            return unsafe (*self.cur_ast()).type_of(n);
        }
        if !self.node_visible(fm, n) {
            return TYPE_NONE;
        }
        return (unsafe &*self.mod_ast(fm)).type_of(n);
    }

    /// Does a non-`mut` capture of a binding of type `cty` move an owning value into the env? A
    /// reference or pointer binding never owns what it points at, whatever that is.
    pub fn tc_capture_owns(self: &mut Self, cty: TypeId) bool {
        if cty == TYPE_NONE {
            return false;
        }
        let k = self.type_at(cty).kind;
        if k == TypeKind::TYPE_POINTER || k == TypeKind::TYPE_REFERENCE {
            return false;
        }
        return self.tc_type_is_free(cty);
    }

    fn fn_owns(self: &mut Self, fid: TypeId) bool {
        let fy = *self.type_at(fid);
        if fy.kind != TypeKind::TYPE_FUNCTION {
            return false;
        }
        let fa = self.mod_ast(fy.module);
        let fnn = unsafe (*fa).at_const(fy.as_data.decl);
        if fnn.kind != NodeKind::NODE_CLOSURE {
            return false;
        }
        let caps = fnn.as_data.closure.captures;
        let by_ptr = (fnn.as_data.closure.mut_caps | fnn.as_data.closure.ref_caps) as u64;
        for i in 0..caps.len {
            let cid = unsafe (*fa).list(caps)[i as usize];
            if (by_ptr >> i as u64 & 1u64) == 0 {
                let ct0 = self.tc_foreign_type_of(fy.module, cid);
                let rt = unsafe (*self.cur_ast()).reintern(unsafe &*fa, ct0);
                if self.tc_capture_owns(rt) {
                    return true;
                }
            }
        }
        return false;
    }

    const fn ret_eq(self: &Self, a: TypeId, b: TypeId) bool {
        if a == b {
            return true;
        }
        let v = Ast::builtin(BuiltinType::BT_VOID);
        return (a == TYPE_NONE || a == v) && (b == TYPE_NONE || b == v);
    }

    fn fn_compatible(self: &mut Self, exid: TypeId, acid: TypeId) bool {
        if exid != acid && self.fn_is_capturing(acid) {
            return false;
        }
        return self.dynfn_sig_ok(exid, acid);
    }

    // The generic function `node` names, or NODE_NONE when it names something else. A generic function
    // has no type of its own (only its instantiations do) so naming one as a VALUE needs the type
    // arguments pinned before it can be a fn pointer.
    const fn tc_generic_fn_named(self: &Self, node: NodeId) DefId {
        let a = self.cur_ast();
        let mut n = node;
        if unsafe (*a).at_const(n).kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            n = unsafe (*a).at_const(n).as_data.specialization.expression;
        }
        let k = unsafe (*a).at_const(n).kind;
        if k != NodeKind::NODE_IDENTIFIER && (k != NodeKind::NODE_MEMBER || !unsafe (*a).at_const(n).as_data.member.path) {
            return DefId { module: 0, node: NODE_NONE };
        }
        let d = unsafe (*a).resolution_def(n);
        if d.node == NODE_NONE || d.module != self.cur_module() && d.module as usize >= self.pkg_count() {
            return DefId { module: 0, node: NODE_NONE };
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if dn.kind != NodeKind::NODE_FUNCTION || dn.as_data.function.generics.len == 0 {
            return DefId { module: 0, node: NODE_NONE };
        }
        return d;
    }

    // Does `node` need the context type pushed into it before it can be checked? A generic function
    // named as a value and a generic enum's variant without type arguments carry no complete type of
    // their own; an array literal's element type comes from the parameter when its elements are
    // unsuffixed literals (or when it is empty).
    const fn tc_wants_param_type(self: &Self, node: NodeId) bool {
        if unsafe (*self.cur_ast()).at_const(node).kind == NodeKind::NODE_ARRAY_LITERAL {
            return true;
        }
        return self.tc_generic_fn_named(node).node != NODE_NONE || self.tc_bare_generic_variant(node) || self.tc_bare_generic_struct_lit(
            node,
        );
    }

    // `S { .. }`, `&S { .. }` or `&mut S { .. }` where `S` names a generic struct (or generic alias)
    // without type arguments.
    const fn tc_bare_generic_struct_lit(self: &Self, node: NodeId) bool {
        let a = self.cur_ast();
        let mut n = node;
        while unsafe (*a).at_const(n).kind == NodeKind::NODE_UNARY && unsafe (*a).at_const(n).as_data.unary.op == TokenType::Ampersand {
            n = unsafe (*a).at_const(n).as_data.unary.operand;
        }
        if unsafe (*a).at_const(n).kind != NodeKind::NODE_STRUCT_INITIALIZER {
            return false;
        }
        let stn = unsafe (*a).at_const(n).as_data.struct_initializer.ty;
        if unsafe (*a).at_const(stn).kind != NodeKind::NODE_IDENTIFIER {
            return false;
        }
        let d = unsafe (*a).resolution_def(stn);
        if d.node == NODE_NONE || d.module != self.cur_module() && d.module as usize >= self.pkg_count() {
            return false;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        return dn.kind == NodeKind::NODE_STRUCT && dn.as_data.aggregate.generics.len > 0 || self.tc_lit_generic_alias(
            stn,
        ).node != NODE_NONE;
    }

    // `E::V`, `E::V(..)` or `E::V { .. }` where `E` names a generic enum without type arguments
    // (`Option::None`).
    const fn tc_bare_generic_variant(self: &Self, node: NodeId) bool {
        let a = self.cur_ast();
        let mut n = node;
        let nk = unsafe (*a).at_const(n).kind;
        if nk == NodeKind::NODE_CALL {
            n = unsafe (*a).at_const(n).as_data.call.callee;
        }
        let mut en = NODE_NONE;
        if nk == NodeKind::NODE_STRUCT_INITIALIZER {
            let stn = unsafe (*a).at_const(n).as_data.struct_initializer.ty;
            let sn = unsafe (*a).at_const(stn);
            if sn.kind != NodeKind::NODE_TYPE_PATH || sn.as_data.type_path.parts.len < 2 || sn.as_data.type_path.args.len != 0 {
                return false;
            }
            en = stn;
        } else if unsafe (*a).at_const(n).kind != NodeKind::NODE_MEMBER || !unsafe (*a).at_const(n).as_data.member.path {
            return false;
        } else {
            en = unsafe (*a).at_const(n).as_data.member.object;
        }
        let d = unsafe (*a).resolution_def(en);
        if d.node == NODE_NONE || d.module != self.cur_module() && d.module as usize >= self.pkg_count() {
            return false;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        return dn.kind == NodeKind::NODE_ENUM && dn.as_data.aggregate.generics.len > 0;
    }

    // Coerce a generic function named as a value to the expected function-pointer type: bind its type
    // parameters by matching its declared signature against `expected`'s, then check the substituted
    // signature. On success the node ADOPTS `expected` (a concrete signature the rest of the pipeline
    // can render and emit) and records its type arguments, so codegen names the monomorphized instance
    // exactly as a call site does. A turbofish pre-binds the arguments it spells out.
    fn tc_coerce_generic_fn(self: &mut Self, expected: TypeId, node: NodeId) bool {
        let d = self.tc_generic_fn_named(node);
        if d.node == NODE_NONE || self.type_at(expected).kind != TypeKind::TYPE_FUNCTION {
            return false;
        }
        let fa = self.mod_ast(d.module);
        let gens = unsafe (*fa).at_const(d.node).as_data.function.generics;
        let g = gens.len as i32;
        if g > 8 {
            return false;
        }
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        for i in 0..g {
            gp[i as usize] = DefId { module: d.module, node: unsafe (*fa).list(gens)[i as usize] };
            ga[i as usize] = TYPE_NONE;
        }
        // Explicit turbofish arguments bind first, left to right.
        let sn = unsafe (*self.cur_ast()).at_const(node);
        if sn.kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            let tas = sn.as_data.specialization.types;
            let mut i: u32 = 0;
            while i < tas.len && i as i32 < g {
                ga[i as usize] = self.resolve_type(unsafe (*self.cur_ast()).list(tas)[i as usize]);
                i = i + 1;
            }
        }
        let es = self.fn_sig(expected);
        let params = unsafe (*fa).at_const(d.node).as_data.function.params;
        let rets = unsafe (*fa).at_const(d.node).as_data.function.returns;
        let ne = self.fn_nret(expected);
        if params.len != es.np || (rets.len > 1 || ne > 1) && rets.len != ne {
            return false;
        }
        // Probe session: infer the rest from the wanted signature, parameters then return.
        let mark = self.icx.sv.probe_begin();
        for i in 0..g {
            let pgid = unsafe (*fa).list(gens)[i as usize];
            let is_c9 = unsafe (*fa).at_const(pgid).as_data.generic_param.is_const;
            let _ = self.icx.sv.map_param(DefId { module: d.module, node: pgid }, is_c9);
            if ga[i as usize] != TYPE_NONE {
                let at = self.tc_slot_const(mark.base + i as u32, ga[i as usize]);
                if at != TYPE_NONE {
                    self.icx.sv.s_explicit(mark.base + i as u32, at);
                }
            }
        }
        for i in 0..params.len {
            let pid = unsafe (*fa).list(params)[i as usize];
            self.tc_infer_ev(self.decl_type_in(d.module, pid), self.fn_param(&es, i), false);
        }
        if rets.len == 1 {
            let r0 = unsafe (*fa).list(rets)[0];
            self.tc_infer_ev(self.node_type_in(d.module, r0), es.ret, false);
        }
        if rets.len > 1 {
            for i in 0..rets.len {
                let ri = unsafe (*fa).list(rets)[i as usize];
                self.tc_infer_ev(self.node_type_in(d.module, ri), self.fn_ret_i(expected, i), false);
            }
        }
        let mut all9 = true;
        for i in 0..g {
            if ga[i as usize] == TYPE_NONE {
                ga[i as usize] = self.icx.sv.s_resolve(mark.base + i as u32, it_conv_join);
            }
            if ga[i as usize] == TYPE_NONE {
                all9 = false;
            }
        }
        self.icx.sv.probe_end(&mark);
        if !all9 {
            return false;
        }
        // The substituted signature must be exactly what was asked for.
        for i in 0..params.len {
            let pid = unsafe (*fa).list(params)[i as usize];
            if self.subst_type(self.decl_type_in(d.module, pid), &gp[0], &ga[0], g) != self.fn_param(&es, i) {
                return false;
            }
        }
        if rets.len > 1 {
            for i in 0..rets.len {
                let ri = unsafe (*fa).list(rets)[i as usize];
                if self.subst_type(self.node_type_in(d.module, ri), &gp[0], &ga[0], g) != self.fn_ret_i(expected, i) {
                    return false;
                }
            }
        } else {
            let mut ar = Ast::builtin(BuiltinType::BT_VOID);
            if rets.len == 1 {
                let r0 = unsafe (*fa).list(rets)[0];
                ar = self.subst_type(self.node_type_in(d.module, r0), &gp[0], &ga[0], g);
            }
            if !self.ret_eq(es.ret, ar) {
                return false;
            }
        }
        self.check_generic_bounds(node, d.module, d.node, gens, &gp[0], &ga[0], g, &gp[0], &ga[0], 0);
        unsafe (*self.cur_ast()).set_type(node, expected);
        unsafe (*self.cur_ast()).set_type_args(node, &ga[0], g as u8);
        return true;
    }

    // The function-pointer type of generic function `d` named as a value at `node` with all its
    // type arguments `ga[0..g]` given, after checking their bounds.
    fn tc_fn_value_sig(self: &mut Self, node: NodeId, d: DefId, ga: *const TypeId, g: i32) TypeId {
        let fa = self.mod_ast(d.module);
        let f = unsafe (*fa).at_const(d.node).as_data.function;
        if g > 8 {
            return TYPE_NONE;
        }
        let mut gp = Defs8 {};
        for i in 0..g {
            gp[i as usize] = DefId { module: d.module, node: unsafe (*fa).list(f.generics)[i as usize] };
        }
        let mut slots = Vector::<TypeId>::with_capacity((f.returns.len + f.params.len) as usize);
        for i in 0..f.returns.len {
            let ri = unsafe (*self.mod_ast(d.module)).list(f.returns)[i as usize];
            slots.push(self.subst_type(self.node_type_in(d.module, ri), &gp[0], ga, g));
        }
        for i in 0..f.params.len {
            let pid = unsafe (*self.mod_ast(d.module)).list(f.params)[i as usize];
            slots.push(self.subst_type(self.decl_type_in(d.module, pid), &gp[0], ga, g));
        }
        self.check_generic_bounds(node, d.module, d.node, f.generics, &gp[0], ga, g, &gp[0], ga, 0);
        return unsafe (*self.cur_ast()).intern_fn_sig(slots.as_ptr(), f.returns.len, f.params.len, false);
    }

    fn dynfn_sig_ok(self: &mut Self, exid: TypeId, acid: TypeId) bool {
        let es = self.fn_sig(exid);
        let as2 = self.fn_sig(acid);
        if es.np != as2.np || !self.ret_eq(es.ret, as2.ret) {
            return false;
        }
        // `ret` stands for one result only: several results compare by count, then in order.
        let ne = self.fn_nret(exid);
        let na = self.fn_nret(acid);
        if (ne > 1 || na > 1) && ne != na {
            return false;
        }
        if ne > 1 {
            for i in 0..ne {
                if self.fn_ret_i(exid, i) != self.fn_ret_i(acid, i) {
                    return false;
                }
            }
        }
        for i in 0..es.np {
            if self.fn_param(&es, i) != self.fn_param(&as2, i) {
                return false;
            }
        }
        return true;
    }

    // The result count of function type `fid`: its signature's or declaration's result list, one for
    // an expression-bodied closure.
    fn fn_nret(self: &Self, fid: TypeId) u32 {
        let fty = *self.type_at(fid);
        if fty.fn_sig() {
            return unsafe (*self.cur_ast()).sig_len(&fty, true);
        }
        let fa = self.mod_ast(fty.module);
        let fn0 = unsafe (*fa).at_const(fty.as_data.decl);
        if fn0.kind == NodeKind::NODE_CLOSURE && fn0.as_data.closure.expr_body {
            return 1;
        }
        let mut ps = NodeList { start: 0, len: 0 };
        let mut rs = NodeList { start: 0, len: 0 };
        let _ = unsafe (*fa).sig_lists(fty.as_data.decl, &mut ps, &mut rs);
        return rs.len;
    }

    // Result `i` of function type `fid` (below `fn_nret`), for a declaration with several results.
    fn fn_ret_i(self: &mut Self, fid: TypeId, i: u32) TypeId {
        let fty = *self.type_at(fid);
        if fty.fn_sig() {
            return unsafe (*self.cur_ast()).sig_at(&fty, true, i);
        }
        let m = fty.module;
        let fa = self.mod_ast(m);
        let mut ps = NodeList { start: 0, len: 0 };
        let mut rs = NodeList { start: 0, len: 0 };
        let _ = unsafe (*fa).sig_lists(fty.as_data.decl, &mut ps, &mut rs);
        return self.node_type_in(m, unsafe (*fa).list(rs)[i as usize]);
    }

    fn tc_dyn_fn_sig(self: &mut Self, ty: &Ty) TypeId {
        if ty.kind != TypeKind::TYPE_DYN {
            return TYPE_NONE;
        }
        return unsafe (*self.cur_ast()).dyn_fn_sig(ty);
    }

    fn tc_dyn_same(self: &mut Self, a: &Ty, b: &Ty) bool {
        let as2 = self.tc_dyn_fn_sig(a);
        let bs = self.tc_dyn_fn_sig(b);
        if as2 != TYPE_NONE != (bs != TYPE_NONE) {
            return false;
        }
        if as2 != TYPE_NONE {
            return as2 == bs || self.fn_compatible(as2, bs);
        }
        return a.module == b.module && a.as_data.inst == b.as_data.inst;
    }
}

// The plural suffix for a count of `n`: "" for one, "s" otherwise.
const fn plural(n: u64) *const char {
    if n == 1 {
        return "".ptr() as *const char;
    }
    return "s".ptr() as *const char;
}

const fn src_at(p: str, off: u32) *const char {
    return (unsafe (p.ptr() + off as usize)) as *const char;
}

// The Ast to read for module `m`'s decls when rendering against the current ast `a` (mirrors
// TypeChecker::mod_ast): foreign modules come from the package, the current one from `a` itself.
const fn rt_ast(pkg: *const loader::Package, a: *const Ast, m: ModuleId) *const Ast {
    if m != unsafe (*a).module {
        return unsafe &(*pkg).modules[m as usize].ast;
    }
    return a;
}
const fn rt_src(pkg: *const loader::Package, a: *const Ast, cur_src: str, m: ModuleId) str {
    if m != unsafe (*a).module {
        return unsafe (*pkg).modules[m as usize].source.as_str();
    }
    return cur_src;
}

// `fn(P, Q) R` from a function type's decl node. Reads the CACHED type of each parameter/return node
// rather than lowering (no checker here); an uncached slot renders `..`, so a signature never checked
// still names itself. Without this every function type printed as a bare "fn" and a mismatch between
// two of them read "expected 'fn', found 'fn'".
fn render_fn_sig_into(pkg: *const loader::Package, a: *const Ast, cur_src: str, ty: &Ty, buf: *mut char, cap: usize) {
    if ty.fn_sig() {
        render_sig_into(pkg, a, cur_src, ty, buf, cap);
        return;
    }
    let ma = rt_ast(pkg, a, ty.module);
    let mut ps = NodeList { start: 0, len: 0 };
    let mut rs = NodeList { start: 0, len: 0 };
    if !unsafe (*ma).sig_lists(ty.as_data.decl, &mut ps, &mut rs) {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "fn".ptr() as *const char);
        return;
    }
    let mut at: usize = 0;
    at = at + (unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "fn(".ptr() as *const char)) as usize;
    for i in 0..ps.len {
        let mut pb = Buf96 {};
        render_slot_into(pkg, a, cur_src, ma, unsafe (*ma).list(ps)[i as usize], &mut pb[0], 96);
        let mut sep = ", ".ptr() as *const char;
        if i == 0 {
            sep = "".ptr() as *const char;
        }
        if at >= cap {
            return;
        }
        at = at + (unsafe stdio::snprintf(buf + at, cap - at, "%s%s".ptr() as *const char, sep, &pb[0])) as usize;
    }
    if at >= cap {
        return;
    }
    let mut rb = Buf96 {};
    let dn = unsafe (*ma).at_const(ty.as_data.decl);
    // An expression-body closure lists no return: its body's type is the return type.
    let bt = if dn.kind == NodeKind::NODE_CLOSURE && dn.as_data.closure.expr_body && rs.len == 0 {
        unsafe (*ma).type_of(dn.as_data.closure.body);
    } else {
        TYPE_NONE;
    };
    if rs.len == 1 {
        render_slot_into(pkg, a, cur_src, ma, unsafe (*ma).list(rs)[0], &mut rb[0], 96);
        unsafe stdio::snprintf(buf + at, cap - at, ") %s".ptr() as *const char, &rb[0]);
    } else if rs.len > 1 {
        // Several results in parentheses, as `render_sig_into` spells them.
        at = at + (unsafe stdio::snprintf(buf + at, cap - at, "%s".ptr() as *const char, ") (".ptr() as *const char)) as usize;
        for i in 0..rs.len {
            if at >= cap {
                return;
            }
            render_slot_into(pkg, a, cur_src, ma, unsafe (*ma).list(rs)[i as usize], &mut rb[0], 96);
            let sep = if i == 0 {
                "".ptr() as *const char;
            } else {
                ", ".ptr() as *const char;
            };
            at = at + (unsafe stdio::snprintf(buf + at, cap - at, "%s%s".ptr() as *const char, sep, &rb[0])) as usize;
        }
        if at < cap {
            unsafe stdio::snprintf(buf + at, cap - at, "%s".ptr() as *const char, ")".ptr() as *const char);
        }
    } else if bt != TYPE_NONE && !(unsafe (*ma).type_at(bt).kind == TypeKind::TYPE_BUILTIN && unsafe (*ma).type_at(bt).as_data.builtin == BuiltinType::BT_VOID) {
        render_type_into(pkg, ma, rt_src(pkg, a, cur_src, unsafe (*ma).module), bt, &mut rb[0], 96);
        unsafe stdio::snprintf(buf + at, cap - at, ") %s".ptr() as *const char, &rb[0]);
    } else {
        unsafe stdio::snprintf(buf + at, cap - at, "%s".ptr() as *const char, ")".ptr() as *const char);
    }
}

// Function-pointer type `ty` (pool `a`): `fn(P, ..) R`, `move fn(..)`, several results in parentheses.
fn render_sig_into(pkg: *const loader::Package, a: *const Ast, cur_src: str, ty: &Ty, buf: *mut char, cap: usize) {
    let mut out = String::new();
    if (ty.qualifier & FN_MOVE) != 0 {
        out.push_str("move ");
    }
    out.push_str("fn(");
    let np = unsafe (*a).sig_len(ty, false);
    for i in 0..np {
        let mut pb = Buf96 {};
        render_type_into(pkg, a, cur_src, unsafe (*a).sig_at(ty, false, i), &mut pb[0], 96);
        if i != 0 {
            out.push_str(", ");
        }
        out.push_str(str::from_cstr(&pb[0]));
    }
    out.push_str(")");
    let nr = unsafe (*a).sig_len(ty, true);
    for i in 0..nr {
        let mut rb = Buf96 {};
        render_type_into(pkg, a, cur_src, unsafe (*a).sig_at(ty, true, i), &mut rb[0], 96);
        if i != 0 {
            out.push_str(", ");
        } else if nr > 1 {
            out.push_str(" (");
        } else {
            out.push_str(" ");
        }
        out.push_str(str::from_cstr(&rb[0]));
    }
    if nr > 1 {
        out.push_str(")");
    }
    unsafe stdio::snprintf(buf, cap, "%.*s".ptr() as *const char, out.len() as i32, out.as_str().ptr());
}

// One parameter/return slot of a function type: the node is either a NODE_PARAMETER wrapping a type
// node or the type node itself.
fn render_slot_into(
    pkg: *const loader::Package,
    a: *const Ast,
    cur_src: str,
    ma: *const Ast,
    slot: NodeId,
    buf: *mut char,
    cap: usize,
) {
    let tn = unsafe (*ma).slot_type_node(slot);
    let mut t = TYPE_NONE;
    if tn != NODE_NONE {
        t = unsafe (*ma).type_of(tn);
    }
    if t == TYPE_NONE {
        t = unsafe (*ma).type_of(slot);
    }
    if t == TYPE_NONE {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "..".ptr() as *const char);
        return;
    }
    render_type_into(pkg, ma, rt_src(pkg, a, cur_src, unsafe (*ma).module), t, buf, cap);
}

/// Render `tid` as Super-C surface syntax into `buf` (NUL-terminated, truncating at `cap`). The
/// standalone form of TypeChecker::render_type: `a` is the Ast owning the type pool (a checker's
/// in-flight ast, or a module's held ast after the build), `cur_src` that module's source, `pkg` the
/// package for cross-module decl names (null falls back to `a`/`cur_src` for everything). Also serves
/// LSP hover, which renders from a fully built package.
// Print name span `s` of module `m`'s source into `buf` (at most `cap` bytes) between `pre` and `post`;
// the snprintf count.
fn rt_put_name(
    pkg: *const loader::Package,
    a: *const Ast,
    cur_src: str,
    m: ModuleId,
    s: tok::Span,
    buf: *mut char,
    cap: usize,
    pre: *const char,
    post: *const char,
) i32 {
    return unsafe stdio::snprintf(
        buf,
        cap,
        "%s%.*s%s".ptr() as *const char,
        pre,
        (s.end - s.start) as i32,
        src_at(rt_src(pkg, a, cur_src, m), s.start),
        post,
    );
}

pub fn render_type_into(
    pkg: *const loader::Package,
    a: *const Ast,
    cur_src: str,
    tid: TypeId,
    buf: *mut char,
    cap: usize,
) {
    if tid == TYPE_NONE {
        // No type was ever assigned: there is nothing IN the value to render. Instance arguments
        // recover the parameter's NAME from their declaration below; a bare hole has no declaration.
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "_".ptr() as *const char);
        return;
    }
    let ty = *unsafe (*a).type_at(tid);
    if ty.kind == TypeKind::TYPE_ERROR {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "_".ptr() as *const char);
        return;
    }
    if ty.kind == TypeKind::TYPE_BUILTIN {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, bt_name(ty.as_data.builtin).ptr() as *const char);
    } else if ty.kind == TypeKind::TYPE_NEVER {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "never".ptr() as *const char);
    } else if ty.kind == TypeKind::TYPE_POINTER || ty.kind == TypeKind::TYPE_REFERENCE {
        let mut inb = Buf96 {};
        render_type_into(pkg, a, cur_src, ty.as_data.elem, &mut inb[0], 96);
        let mut pfx = "&".ptr() as *const char;
        if ty.kind == TypeKind::TYPE_POINTER {
            pfx = "*".ptr() as *const char;
        }
        let mut mq = "".ptr() as *const char;
        if ty.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
            mq = "mut ".ptr() as *const char;
        } else if ty.kind == TypeKind::TYPE_POINTER && ty.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8 {
            // A bare `*T` and `*const T` are distinct types.
            mq = "const ".ptr() as *const char;
        }
        unsafe stdio::snprintf(buf, cap, "%s%s%s".ptr() as *const char, pfx, mq, &inb[0]);
    } else if ty.kind == TypeKind::TYPE_SLICE {
        let mut inb = Buf96 {};
        render_type_into(pkg, a, cur_src, ty.as_data.elem, &mut inb[0], 96);
        unsafe stdio::snprintf(buf, cap, "[]%s".ptr() as *const char, &inb[0]);
    } else if ty.kind == TypeKind::TYPE_ARRAY {
        let mut inb = Buf96 {};
        render_type_into(pkg, a, cur_src, ty.as_data.arr.elem, &mut inb[0], 96);
        if ty.arr_sym() {
            let mut lb = Buf96 {};
            render_type_into(pkg, a, cur_src, ty.as_data.arr.len, &mut lb[0], 96);
            unsafe stdio::snprintf(buf, cap, "[%s; %s]".ptr() as *const char, &inb[0], &lb[0]);
        } else {
            unsafe stdio::snprintf(buf, cap, "[%s; %u]".ptr() as *const char, &inb[0], ty.as_data.arr.len);
        }
    } else if ty.kind == TypeKind::TYPE_STRUCT || ty.kind == TypeKind::TYPE_ENUM || ty.kind == TypeKind::TYPE_GENERIC {
        let ma = rt_ast(pkg, a, ty.module);
        let d = unsafe (*ma).at_const(ty.as_data.decl);
        let mut nm = d.as_data.aggregate.name;
        if d.kind == NodeKind::NODE_GENERIC_PARAM {
            nm = d.as_data.generic_param.name;
        }
        let s = unsafe (*ma).at_const(nm).as_data.name.text;
        rt_put_name(pkg, a, cur_src, ty.module, s, buf, cap, "".ptr() as *const char, "".ptr() as *const char);
    } else if ty.kind == TypeKind::TYPE_OPAQUE {
        let ma = rt_ast(pkg, a, ty.module);
        let s = unsafe (*ma).at_const(unsafe (*ma).at_const(ty.as_data.decl).as_data.type_alias.name).as_data.name.text;
        rt_put_name(pkg, a, cur_src, ty.module, s, buf, cap, "".ptr() as *const char, "".ptr() as *const char);
    } else if ty.kind == TypeKind::TYPE_ASSOC {
        // `T::Output`: the projected type, then the associated type's name.
        let it = *unsafe (*a).instance(ty.as_data.inst);
        let mut ob = Buf96 {};
        render_type_into(pkg, a, cur_src, it.args[0], &mut ob[0], 96);
        let ma = rt_ast(pkg, a, it.module);
        let s = unsafe (*ma).at_const(unsafe (*ma).at_const(it.decl).as_data.type_alias.name).as_data.name.text;
        let at = unsafe stdio::snprintf(buf, cap, "%s::".ptr() as *const char, &ob[0]);
        if at >= 0 && at as usize < cap {
            rt_put_name(
                pkg,
                a,
                cur_src,
                it.module,
                s,
                unsafe (buf + at as usize),
                cap - at as usize,
                "".ptr() as *const char,
                "".ptr() as *const char,
            );
        }
    } else if ty.kind == TypeKind::TYPE_INSTANCE {
        let it = *unsafe (*a).instance(ty.as_data.inst);
        let ma = rt_ast(pkg, a, it.module);
        let s = unsafe (*ma).at_const(unsafe (*ma).at_const(it.decl).as_data.aggregate.name).as_data.name.text;
        let at0 = rt_put_name(
            pkg,
            a,
            cur_src,
            it.module,
            s,
            buf,
            cap,
            "".ptr() as *const char,
            "<".ptr() as *const char,
        );
        let mut at = at0 as usize;
        let mut i: u8 = 0;
        while i < it.n && at < cap {
            let mut argb = Buf96 {};
            let ai = unsafe it.args[i as usize];
            if ai == TYPE_NONE || unsafe (*a).type_at(ai).kind == TypeKind::TYPE_ERROR {
                // An argument inference never filled: name the declaration's own parameter;
                // `UInt<BITS>` says WHAT is undetermined, where `UInt<?>` said nothing.
                let gens = unsafe (*ma).at_const(it.decl).as_data.aggregate.generics;
                if i as u32 < gens.len {
                    let gid = unsafe (*ma).list(gens)[i as usize];
                    let gn = unsafe (*ma).at_const(unsafe (*ma).at_const(gid).as_data.generic_param.name).as_data.name.text;
                    rt_put_name(
                        pkg,
                        a,
                        cur_src,
                        it.module,
                        gn,
                        &mut argb[0],
                        96,
                        "".ptr() as *const char,
                        "".ptr() as *const char,
                    );
                } else {
                    unsafe stdio::snprintf(&mut argb[0], 96, "%s".ptr() as *const char, "?".ptr() as *const char);
                }
            } else {
                render_type_into(pkg, a, cur_src, ai, &mut argb[0], 64);
            }
            let mut sep = "".ptr() as *const char;
            if i != 0 {
                sep = ", ".ptr() as *const char;
            }
            let mut room: usize = 0;
            if cap > at {
                room = cap - at;
            }
            let w = unsafe stdio::snprintf(buf + at, room, "%s%s".ptr() as *const char, sep, &argb[0]);
            at = at + w as usize;
            i = i + 1;
        }
        if at < cap {
            unsafe stdio::snprintf(buf + at, cap - at, "%s".ptr() as *const char, ">".ptr() as *const char);
        }
    } else if ty.kind == TypeKind::TYPE_FUNCTION {
        render_fn_sig_into(pkg, a, cur_src, &ty, buf, cap);
    } else if ty.kind == TypeKind::TYPE_DYN {
        let ma = rt_ast(pkg, a, ty.module);
        let mut pfx = "Box<dyn ".ptr() as *const char;
        if ty.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
            pfx = "&mut dyn ".ptr() as *const char;
        } else if ty.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8 {
            pfx = "&dyn ".ptr() as *const char;
        }
        let mut sfx = "".ptr() as *const char;
        if ty.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 {
            sfx = ">".ptr() as *const char;
        }
        let dsig = unsafe (*a).dyn_fn_sig(&ty);
        if dsig != TYPE_NONE {
            let mut sb = Buf96 {};
            render_type_into(pkg, a, cur_src, dsig, &mut sb[0], 96);
            unsafe stdio::snprintf(buf, cap, "%s%s%s".ptr() as *const char, pfx, &sb[0], sfx);
        } else {
            let ddecl = unsafe (*a).dyn_decl_of(&ty);
            let s = unsafe (*ma).at_const(unsafe (*ma).at_const(ddecl).as_data.interface_def.name).as_data.name.text;
            let di = *unsafe (*a).instance(ty.as_data.inst);
            if di.n == 0 {
                rt_put_name(pkg, a, cur_src, ty.module, s, buf, cap, pfx, sfx);
            } else {
                // A generic interface names its arguments: `&dyn I<bool>`, never a bare `&dyn I`.
                let mut at = rt_put_name(pkg, a, cur_src, ty.module, s, buf, cap, pfx, "<".ptr() as *const char) as usize;
                let mut i: u8 = 0;
                while i < di.n && at < cap {
                    let mut argb = Buf96 {};
                    render_type_into(pkg, a, cur_src, unsafe di.args[i as usize], &mut argb[0], 64);
                    let sep = if i != 0 {
                        ", ".ptr() as *const char;
                    } else {
                        "".ptr() as *const char;
                    };
                    let w = unsafe stdio::snprintf(buf + at, cap - at, "%s%s".ptr() as *const char, sep, &argb[0]);
                    at = at + w as usize;
                    i = i + 1;
                }
                if at < cap {
                    unsafe stdio::snprintf(buf + at, cap - at, ">%s".ptr() as *const char, sfx);
                }
            }
        }
    } else if ty.kind == TypeKind::TYPE_CONST {
        // A concrete const argument prints its VALUE: `UInt<64>`, not `UInt<?>`; the number is the
        // whole point of the diagnostic.
        let v = ty.cval().to_string();
        unsafe stdio::snprintf(buf, cap, "%.*s".ptr() as *const char, v.len() as i32, v.as_str().ptr());
    } else if ty.kind == TypeKind::TYPE_CONST_EXPR {
        // Printed from the canonical form rather than as written: two of these failing to match is the
        // one diagnostic this type produces, and the forms are what differ.
        let l = unsafe (*a).const_lin_at(ty.as_data.inst);
        let mut t = String::from_str("{");
        for i in 0..l.n {
            let c = unsafe &l.c[i as usize];
            if c.is_zero() {
                continue;
            }
            let pd = unsafe l.p[i as usize];
            let pa = rt_ast(pkg, a, pd.module);
            let ns = unsafe (*pa).at_const(unsafe (*pa).at_const(pd.node).as_data.generic_param.name).as_data.name.text;
            if t.len() > 1 {
                t.push_str(" + ");
            }
            if *c != i128::one() {
                t.format_into("{}", *c);
                t.push_str(" * ");
            }
            t.push_str(rt_src(pkg, a, cur_src, pd.module).slice(ns.start as usize, ns.end as usize));
        }
        if !l.k.is_zero() {
            t.push_str(" + ");
            t.format_into("{}", l.k);
        }
        if l.div_of() != i128::one() {
            t.push_str(" / ");
            t.format_into("{}", l.div_of());
        }
        t.push_str("}");
        unsafe stdio::snprintf(buf, cap, "%.*s".ptr() as *const char, t.len() as i32, t.as_str().ptr());
    } else if ty.kind == TypeKind::TYPE_FIELD_PROJECTION {
        // The symbolic per-field type of a reflection loop: name it by what it projects.
        let at = (unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "field of ".ptr() as *const char)) as usize;
        if at < cap {
            render_type_into(pkg, a, cur_src, ty.as_data.proj.owner, unsafe (buf + at), cap - at);
        }
    } else {
        unsafe stdio::snprintf(buf, cap, "%s".ptr() as *const char, "?".ptr() as *const char);
    }
}

/// No type to check an operand against: none recorded (a `null`, an untyped node), or TYPE_ERROR,
/// which was reported where it was rejected.
const fn untyped(t: TypeId) bool {
    return t == TYPE_NONE || t == TYPE_ERROR;
}

extend<'a> TypeChecker<'a> {
    /// Unwrap a struct/enum/instance type to its module + decl; for an instance also copies up to 8
    /// param->arg substitution pairs into `params`/`args`. False for any other type kind.
    pub fn aggregate_of(
        self: &Self,
        ty: TypeId,
        mod_out: &mut ModuleId,
        decl_out: &mut NodeId,
        params: &mut Defs8,
        args: &mut Tys8,
        n_out: &mut i32,
    ) bool {
        *n_out = 0;
        // Every method lookup reaches its (module, decl) through here, so this is where the RECEIVER a
        // method is resolved on is recorded: the one piece the lookups themselves never carry.
        let mself = (self as *const TypeChecker) as *mut TypeChecker;
        unsafe (*mself).mark_recv = ty;
        unsafe (*mself).mark_n += 1;
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
            *mod_out = y.module;
            *decl_out = y.as_data.decl;
            return true;
        }
        if y.kind == TypeKind::TYPE_INSTANCE {
            let it = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            *mod_out = it.module;
            *decl_out = it.decl;
            let da = self.mod_ast(it.module);
            // `generics` never contains lifetime params (the parser splits them into `lifetimes`),
            // so it stays index-aligned with the erased-lifetime `it.args`.
            let gens = unsafe (*da).at_const(it.decl).as_data.aggregate.generics;
            let mut nn: i32 = 0;
            let mut i: u32 = 0;
            while i < gens.len && i as u8 < it.n && nn as usize < params.len() {
                let gid = unsafe (*da).list(gens)[i as usize];
                params[nn as usize] = DefId { module: it.module, node: gid };
                args[nn as usize] = unsafe it.args[i as usize];
                nn = nn + 1;
                i = i + 1;
            }
            *n_out = nn;
            return true;
        }
        return false;
    }

    /// `aggregate_of` without the generic arguments, for callers that only need the declaration: it
    /// skips the parameter/argument copy.
    fn aggregate_decl(self: &Self, ty: TypeId, mod_out: &mut ModuleId, decl_out: &mut NodeId) bool {
        let mself = (self as *const TypeChecker) as *mut TypeChecker;
        unsafe (*mself).mark_recv = ty;
        unsafe (*mself).mark_n += 1;
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
            *mod_out = y.module;
            *decl_out = y.as_data.decl;
            return true;
        }
        if y.kind == TypeKind::TYPE_INSTANCE {
            let it = unsafe (*self.cur_ast()).instance(y.as_data.inst);
            *mod_out = it.module;
            *decl_out = it.decl;
            return true;
        }
        return false;
    }

    // Structural params[i]->args[i] substitution; unmatched generics pass through, and unchanged
    // subtrees return the original TypeId (nothing new interned). A shared subterm is substituted
    // once per call (`subst_memo`), so the cost follows the type's DAG, not its tree.
    fn subst_type(self: &mut Self, ty: TypeId, params: *const DefId, args: *const TypeId, n: i32) TypeId {
        if ty == TYPE_NONE || n == 0 {
            return ty;
        }
        let r = self.subst_rec(ty, params, args, n, true);
        // A large table is dropped, not cleared: `clear` costs its capacity on every later call.
        if self.subst_memo.len() > 64 {
            self.subst_memo = Map::<TypeId, TypeId>::new();
        } else if self.subst_memo.len() != 0 {
            self.subst_memo.clear();
        }
        return r;
    }

    // `subst_type` below its root (`top` false): an instance with a compound argument is memoized,
    // since only such a node can repeat below a shared subterm at a cost.
    fn subst_rec(self: &mut Self, ty: TypeId, params: *const DefId, args: *const TypeId, n: i32, top: bool) TypeId {
        if ty == TYPE_NONE {
            return ty;
        }
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_CONST_EXPR {
            let f = unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst);
            let mut out = ConstLin::new(f.ty);
            out.to = f.to;
            let mut v = i128::zero();
            if self.tc_lin_subst(y.as_data.inst, params, args, n, &mut out) && (!out.is_concrete() || out.finish(
                out.k,
                self.tc_ptr32(),
                &mut v,
            )) {
                return self.tc_intern_form(&out);
            }
            // A parameter this instantiation does not bind, or a value outside the form's types (the
            // instance graph reports it where the instance is demanded): still symbolic.
            return ty;
        }
        if y.kind == TypeKind::TYPE_GENERIC {
            for i in 0..n {
                if unsafe params[i as usize].module == y.module && unsafe params[i as usize].node == y.as_data.decl {
                    return unsafe args[i as usize];
                }
            }
            return ty;
        }
        if y.arr_sym() {
            let e = self.subst_rec(y.as_data.arr.elem, params, args, n, false);
            let mut lt = self.subst_rec(y.as_data.arr.len, params, args, n, false);
            let ly = *self.type_at(lt);
            if ly.kind == TypeKind::TYPE_CONST_EXPR {
                // A length form whose value leaves its type is still that value (i64, or u64 past
                // it): the length's own error (negative, past the maximum) is reported where the
                // array is used, and the instance reports the form's.
                let f = *unsafe (*self.cur_ast()).const_lin_at(ly.as_data.inst);
                let mut out = ConstLin::new(f.ty);
                out.to = f.to;
                if self.tc_lin_subst(ly.as_data.inst, params, args, n, &mut out) && out.is_concrete() {
                    let v = out.value();
                    let bt = pick(bt_holds(BuiltinType::BT_I64, v, false), BuiltinType::BT_I64, BuiltinType::BT_U64);
                    if bt_holds(bt, v, false) {
                        lt = unsafe (*self.cur_ast()).const_value(cval_bits(v), bt);
                    }
                }
            }
            if e == y.as_data.arr.elem && lt == y.as_data.arr.len {
                return ty;
            }
            return unsafe (*self.cur_ast()).intern_array(e, lt);
        }
        if y.kind == TypeKind::TYPE_POINTER || y.kind == TypeKind::TYPE_REFERENCE || y.kind == TypeKind::TYPE_SLICE || y.kind == TypeKind::TYPE_ARRAY {
            let e = self.subst_rec(y.as_data.elem, params, args, n, false);
            if e == y.as_data.elem {
                return ty;
            }
            let mut nt = y;
            nt.as_data.elem = e;
            return unsafe (*self.cur_ast()).intern_type(nt);
        }
        if y.kind == TypeKind::TYPE_INSTANCE {
            let src = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            let mut memo = false;
            if !top {
                for i in 0..src.n {
                    let ak = self.type_at(unsafe src.args[i as usize]).kind;
                    if ak == TypeKind::TYPE_INSTANCE || ak == TypeKind::TYPE_POINTER || ak == TypeKind::TYPE_REFERENCE || ak == TypeKind::TYPE_SLICE || ak == TypeKind::TYPE_ARRAY {
                        memo = true;
                    }
                }
            }
            if memo {
                switch self.subst_memo.get(&ty) {
                    Some(t) => {
                        return *t;
                    },
                    None => {},
                };
            }
            let mut na = Tys8 {};
            let mut changed = false;
            for i in 0..src.n {
                na[i as usize] = self.subst_rec(unsafe src.args[i as usize], params, args, n, false);
                if na[i as usize] != unsafe src.args[i as usize] {
                    changed = true;
                }
            }
            let r = if changed {
                unsafe (*self.cur_ast()).intern_instance(src.module, src.decl, &na[0], src.n);
            } else {
                ty;
            };
            if memo {
                self.subst_memo.insert(ty, r);
            }
            return r;
        }
        if y.kind == TypeKind::TYPE_ASSOC {
            // `T::Output` with `T` bound: the conformance's type once `T` names one.
            let src = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            let mut na = Tys8 {};
            let mut changed = false;
            for i in 0..src.n {
                na[i as usize] = self.subst_rec(unsafe src.args[i as usize], params, args, n, false);
                changed = changed || na[i as usize] != unsafe src.args[i as usize];
            }
            if !changed {
                return ty;
            }
            return self.tc_assoc_make(src.module, src.decl, &na[0], src.n);
        }
        if y.fn_sig() || y.kind == TypeKind::TYPE_DYN && unsafe (*self.cur_ast()).dyn_fn_sig(&y) != TYPE_NONE {
            // A function-pointer type substitutes its signature record, a `dyn fn` its signature.
            let mut it = *unsafe (*self.cur_ast()).instance(y.rec());
            let mut changed = false;
            for i in 0..it.n {
                let o = unsafe it.args[i as usize];
                unsafe it.args[i as usize] = self.subst_rec(o, params, args, n, false);
                if unsafe it.args[i as usize] != o {
                    changed = true;
                }
            }
            if !changed {
                return ty;
            }
            if y.kind == TypeKind::TYPE_DYN {
                return unsafe (*self.cur_ast()).intern_dyn_fn(it.args[0], y.qualifier);
            }
            return unsafe (*self.cur_ast()).intern_sig_rec(&it, y.qualifier);
        }
        return ty;
    }

    // The inexact case: keep the divisor ON the form; `{(BITS + 7) / 8}` stays floor((BITS+7)/8)
    // until a substitution makes it a number. Installed only onto an empty accumulator, because the
    // divisor covers the whole form.
    fn tc_lin_floor(self: &Self, lhs: &ConstLin, d: i128, out: &mut ConstLin) bool {
        let one = i128::one();
        if d <= one || lhs.div_of() != one {
            return false;
        }
        if !out.k.is_zero() || out.n != 0 || out.div_of() != one {
            return false;
        }
        *out = *lhs;
        out.div = d;
        return true;
    }

    // Lower const-generic expression `id` of module `m` into `out`, a canonical form: a constant plus a
    // coefficient per parameter. This is what makes `{(N * 2) * 2}` and `{N * 4}` the same width:
    // comparing the expressions as written says they differ, and they do not. Linear is exactly the
    // closed set here: `+`, `-`, and scaling by a constant stay inside it, and `N * N` does not, which
    // is refused rather than approximated. A step between constants computes as at run time (`/`
    // truncates, `>>` floors); a divided form over parameters floors. Types collect into `lin_ty`
    // (`tc_lin_top` settles them). Every operator's value lands in `lin_steps`: the form drops the
    // steps, and the written expression computes each of them.
    fn tc_lin(self: &mut Self, m: ModuleId, id: NodeId, out: &mut ConstLin, depth: i32) bool {
        if !self.tc_lin_i(m, id, out, depth) {
            return false;
        }
        let k = unsafe (*self.mod_ast(m)).at_const(id).kind;
        if k == NodeKind::NODE_BINARY || k == NodeKind::NODE_UNARY {
            // `out` entered empty, so it now holds exactly this node's value.
            self.lin_steps.push(LinStep { node: id, lin: *out, div: i128::zero() });
        }
        return true;
    }

    // The value of associated constant `c` of generic extend `ext` for the instance member path `id`
    // (module `m`, `W::<u8>::K`) writes, as the item under check reads it; IV_NONE when the instance
    // is not concrete or does not fold.
    fn tc_ev_inst_const(self: &mut Self, m: ModuleId, id: NodeId, c: DefId, ext: NodeId) iri::IVal {
        let none = iri::IVal { kind: iri::IV_NONE, tm: 0, ty: TYPE_NONE, i: 0, f: 0.0 };
        let a = self.mod_ast(m);
        let n = *unsafe (*a).at_const(id);
        if n.kind != NodeKind::NODE_MEMBER || self.cir() == null {
            return none;
        }
        let spec = n.as_data.member.object;
        if unsafe (*a).at_const(spec).kind != NodeKind::NODE_GENERIC_SPECIALIZATION {
            return none;
        }
        let d = unsafe (*a).resolution_def(unsafe (*a).at_const(spec).as_data.specialization.expression);
        let inst = self.tc_value_inst(m, spec, d);
        let mut gm: ModuleId = 0;
        let mut gd = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if inst == TYPE_NONE || inst == TYPE_ERROR || !self.aggregate_of(
            inst,
            &mut gm,
            &mut gd,
            &mut gp,
            &mut ga,
            &mut gn,
        ) {
            return none;
        }
        let mut ea = Tys8 {};
        let en = self.tc_ext_args(c.module, ext, &ga[0], gn, &mut ea[0]);
        if en <= 0 {
            return none;
        }
        let xa = self.mod_ast(c.module);
        let gens = unsafe (*xa).at_const(ext).as_data.extend_def.generics;
        let mut pn = Array::<NodeId, 8> {};
        let mut am = Array::<ModuleId, 8> {};
        let mut k: u32 = 0;
        for i in 0..gens.len {
            let g = unsafe (*xa).list(gens)[i as usize];
            if unsafe (*xa).at_const(g).as_data.generic_param.is_lifetime {
                continue;
            }
            if k >= en as u32 || !self.type_at(ea[k as usize]).concrete {
                return none;
            }
            pn[k as usize] = g;
            am[k as usize] = self.cur_module();
            k += 1;
        }
        let ce = self.cir();
        self.eng_read(true);
        unsafe (*ce).err_refused = false;
        let v = unsafe (*ce).eval_typed(
            c.module,
            unsafe (*xa).at_const(c.node).as_data.const_def.value,
            c.module,
            &pn[0],
            &am[0],
            &ea[0],
            k as u8,
        );
        self.ev_err = self.ev_err || unsafe (*ce).err_refused;
        self.eng_read(false);
        return v;
    }

    fn tc_lin_i(self: &mut Self, m: ModuleId, id: NodeId, out: &mut ConstLin, depth: i32) bool {
        if id == NODE_NONE || depth > 12 {
            return false;
        }
        let a = self.mod_ast(m);
        let node = *unsafe (*a).at_const(id);
        // `u64::MAX`, `Foo::K`: a type position is never type-checked, so the path is read here.
        let mut hd = DefId { module: 0, node: NODE_NONE };
        let vp = if node.kind == NodeKind::NODE_TYPE_PATH || node.kind == NodeKind::NODE_MEMBER {
            self.tc_value_path(m, id, &mut hd);
        } else {
            hd;
        };
        if vp.node != NODE_NONE && self.tc_is_int_limit(vp, hd) {
            // A builtin limit is the value it names; like a literal, it takes the form's type.
            if self.cir() == null {
                return false;
            }
            let lv = self.ev(vp.module, vp.node);
            if lv.kind != iri::IV_INT {
                return false;
            }
            let v = iri::iv_exact(&lv);
            self.lin_lits.push(LinLeaf { node: id, v: v });
            return self.tc_lin_add(out, v);
        }
        let d = if vp.node != NODE_NONE {
            vp;
        } else if node.kind == NodeKind::NODE_IDENTIFIER || node.kind == NodeKind::NODE_MEMBER {
            unsafe (*a).resolution_def(id);
        } else {
            DefId { module: 0, node: NODE_NONE };
        };
        if d.node != NODE_NONE {
            let dk = unsafe (*self.mod_ast(d.module)).at_const(d.node).kind;
            if dk == NodeKind::NODE_GENERIC_PARAM {
                self.tc_lin_join(unsafe (*self.package).const_param_bt(d.module, d.node), id);
                return out.add_term(d, i128::one());
            }
            if dk == NodeKind::NODE_CONST {
                // A named constant is its value, in its declared type; one the evaluator cannot
                // fold yet stays a term the emitter folds.
                let ext = pick(vp.node != NODE_NONE, self.enclosing(d.module, d.node, NodeKind::NODE_EXTEND), NODE_NONE);
                if ext != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(ext).as_data.extend_def.generics.len != 0 {
                    // `W::<u8>::K` of `extend<T> W<T>`: the value of the written instance.
                    let v = self.tc_ev_inst_const(m, id, d, ext);
                    if v.kind != iri::IV_INT {
                        return false;
                    }
                    self.tc_lin_join(self.bt_of(self.decl_type_in(d.module, d.node)), id);
                    return self.tc_lin_add(out, iri::iv_exact(&v));
                }
                self.tc_lin_join(self.bt_of(self.decl_type_in(d.module, d.node)), id);
                if self.cir() != null {
                    let cv = if vp.node != NODE_NONE {
                        self.ev(d.module, d.node);
                    } else {
                        self.ev(m, id);
                    };
                    if cv.kind == iri::IV_INT {
                        return self.tc_lin_add(out, iri::iv_exact(&cv));
                    }
                }
                return out.add_term(d, i128::one());
            }
        }
        if node.kind == NodeKind::NODE_LITERAL && node.as_data.literal.token_type == TokenType::IntegerLiteral {
            let mut mag: u64 = 0;
            if !self.lit_mag_in(m, id, &mut mag) {
                return false;
            }
            let mut v = i128::zero();
            v.set_limb(0, mag);
            let r = node.as_data.literal.raw;
            let mut sfx: u32 = 0;
            let b = ast_numeric_suffix(self.mod_src(m), r.start, r.end, &mut sfx);
            if b == BuiltinType::BT_COUNT {
                self.lin_lits.push(LinLeaf { node: id, v: v });
            } else {
                self.tc_lin_join(b, id);
            }
            return self.tc_lin_add(out, v);
        }
        if node.kind == NodeKind::NODE_UNARY && node.as_data.unary.op == TokenType::Minus {
            let mut sub = ConstLin::new(BuiltinType::BT_COUNT);
            return self.tc_lin(m, node.as_data.unary.operand, &mut sub, depth + 1) && self.tc_lin_scale(
                &sub,
                i128::from_i64(-1),
                out,
            );
        }
        if node.kind == NodeKind::NODE_BINARY {
            let op = node.as_data.binary.op;
            let lid = node.as_data.binary.left;
            let rid = node.as_data.binary.right;
            if op == TokenType::Plus || op == TokenType::Minus {
                if !self.tc_lin(m, lid, out, depth + 1) {
                    return false;
                }
                let mut rhs = ConstLin::new(BuiltinType::BT_COUNT);
                if !self.tc_lin(m, rid, &mut rhs, depth + 1) {
                    return false;
                }
                let sign = i128::from_i64(pick(op == TokenType::Plus, 1i64, -1i64));
                if rhs.is_concrete() {
                    // floor(x / d) + c is floor((x + c * d) / d): a constant joins a divided form exactly.
                    let mut cd = i128::zero();
                    let d = out.div_of();
                    if !lin_acc(&mut cd, rhs.value(), d) || !lin_acc(&mut out.k, sign, cd) {
                        self.lin_ovf = true;
                        return false;
                    }
                    return true;
                }
                if rhs.div_of() != i128::one() {
                    return false; // a divided form over parameters composes with nothing
                }
                if !lin_acc(&mut out.k, sign, rhs.k) {
                    self.lin_ovf = true;
                    return false;
                }
                for i in 0..rhs.n {
                    let mut cf = i128::zero();
                    if !lin_acc(&mut cf, sign, unsafe rhs.c[i as usize]) {
                        self.lin_ovf = true;
                        return false;
                    }
                    if !out.add_term(unsafe rhs.p[i as usize], cf) {
                        return false;
                    }
                }
                return true;
            }
            let mut lhs = ConstLin::new(BuiltinType::BT_COUNT);
            let mut rhs = ConstLin::new(BuiltinType::BT_COUNT);
            if !self.tc_lin(m, lid, &mut lhs, depth + 1) || !self.tc_lin(m, rid, &mut rhs, depth + 1) {
                return false;
            }
            if !rhs.is_concrete() {
                // One side must be a plain constant: a product of two parameters is not linear.
                if op == TokenType::Star && lhs.is_concrete() {
                    return self.tc_lin_scale(&rhs, lhs.value(), out);
                }
                return false;
            }
            let r = rhs.value();
            if op == TokenType::Star {
                return self.tc_lin_scale(&lhs, r, out);
            }
            if op == TokenType::LeftShift || op == TokenType::RightShift {
                // A count of the width or more traps; `tc_lin_top` checks it against the form's type.
                if r.is_negative() || r >= i128::from_i64(64) {
                    return false;
                }
                let s = r.to_i64();
                self.lin_shift = self.lin_shift.max(s);
                let p = i128::one().shl(s as usize);
                if op == TokenType::LeftShift {
                    return self.tc_lin_scale(&lhs, p, out);
                }
                if lhs.is_concrete() {
                    return self.tc_lin_add(out, lhs.value().div_euclid(&p));
                }
                return lin_divide(&lhs, p, out) || self.tc_lin_floor(&lhs, p, out);
            }
            if op == TokenType::Slash && !r.is_zero() {
                if lhs.is_concrete() {
                    if let Some(q) = lhs.value().checked_div(&r) {
                        return self.tc_lin_add(out, q);
                    }
                    self.lin_ovf = true;
                    return false;
                }
                if lin_divide(&lhs, r, out) {
                    return true;
                }
                if !self.tc_lin_floor(&lhs, r, out) {
                    return false;
                }
                // The form floors and the written `/` truncates: the two agree only where the
                // dividend is not negative or the division is exact.
                self.lin_steps.push(LinStep { node: id, lin: lhs, div: r });
                return true;
            }
            return false;
        }
        // Any other leaf with no parameter in it (a cast, a call, a variant) is the evaluator's business.
        if self.cir() != null {
            let lv = self.ev(m, id);
            if lv.kind == iri::IV_INT {
                let v = iri::iv_exact(&lv);
                let b = self.tc_lin_leaf_bt(&lv);
                if b == BuiltinType::BT_COUNT {
                    self.lin_lits.push(LinLeaf { node: id, v: v });
                } else {
                    self.tc_lin_join(b, id);
                }
                return self.tc_lin_add(out, v);
            }
        }
        return false;
    }

    // Add constant `v` to form `out` (`tc_lin`).
    fn tc_lin_add(self: &mut Self, out: &mut ConstLin, v: i128) bool {
        let d = out.div_of();
        if !lin_acc(&mut out.k, v, d) {
            self.lin_ovf = true;
            return false;
        }
        return true;
    }

    // Add `f` times form `src` to `out` (`tc_lin`).
    fn tc_lin_scale(self: &mut Self, src: &ConstLin, f: i128, out: &mut ConstLin) bool {
        if src.scale(f, out) {
            return true;
        }
        self.lin_ovf = src.div_of() == i128::one() && out.div_of() == i128::one();
        return false;
    }

    // The integer type evaluated leaf `lv` gives a form; BT_COUNT (the leaf takes the form's type)
    // for a value of any other type (an enum variant's discriminant).
    fn tc_lin_leaf_bt(self: &Self, lv: &iri::IVal) BuiltinType {
        if lv.ty >= Ast::builtin(BuiltinType::BT_BOOL) && lv.ty < Ast::builtin(BuiltinType::BT_COUNT) {
            return (lv.ty - Ast::builtin(BuiltinType::BT_BOOL)) as BuiltinType;
        }
        return BuiltinType::BT_COUNT;
    }

    // Join typed leaf type `b` (at node `at`) into the form's type: the wider of two when one widens
    // to the other, else the first mismatch is kept for `tc_lin_top`. A leaf of a type that is no
    // integer (an enum constant) joins nothing.
    fn tc_lin_join(self: &mut Self, b: BuiltinType, at: NodeId) {
        if !bt_is_int(b) || self.lin_mis != NODE_NONE || self.lin_ty == b {
            return;
        }
        if self.lin_ty == BuiltinType::BT_COUNT || bt_widens(self.lin_ty, b) {
            self.lin_ty = b;
        } else if !bt_widens(b, self.lin_ty) {
            self.lin_mis = at;
            self.lin_mis_bt = b;
        }
    }

    // `tc_lin` over the whole const expression `id` of module `m`, into `out`: the form computes in
    // its typed leaves' joined type, or in `want` when only literals and limits make it, and stands
    // for a value of `want` (BT_COUNT: of its own type, an array length). Every literal and limit
    // must fit the form's type, a shift count must be below its width, and the form's type must be
    // `want` or widen to it. False when the expression is no form; `lin_err` then says a typing error
    // was reported (in the module under check only: another module's owner reports its own).
    fn tc_lin_top(self: &mut Self, m: ModuleId, id: NodeId, want: BuiltinType, out: &mut ConstLin) bool {
        self.lin_ovf = false;
        self.lin_err = false;
        self.lin_ty = BuiltinType::BT_COUNT;
        self.lin_mis = NODE_NONE;
        self.lin_lits.clear();
        self.lin_shift = 0;
        self.lin_steps.clear();
        *out = ConstLin::new(BuiltinType::BT_COUNT);
        if !self.tc_lin(m, id, out, 0) {
            return false;
        }
        let local = m == self.cur_module();
        let a = self.mod_ast(m);
        self.lin_err = true;
        if self.lin_mis != NODE_NONE {
            if local {
                self.errors.emit_span(
                    unsafe (*a).at_const(self.lin_mis).span,
                    format(
                        "mismatched types: expected '{}', found '{}'",
                        bt_name(self.lin_ty),
                        bt_name(self.lin_mis_bt),
                    ),
                );
            }
            return false;
        }
        let mut ty = self.lin_ty;
        if ty == BuiltinType::BT_COUNT {
            ty = pick(want != BuiltinType::BT_COUNT, want, BuiltinType::BT_I64);
            if want == BuiltinType::BT_COUNT && out.is_concrete() && !bt_holds(ty, out.value(), self.tc_ptr32()) {
                ty = BuiltinType::BT_U64;
            }
        }
        for i in 0..self.lin_lits.len() {
            // A literal that is the whole expression is its value: the caller checks that.
            let lf = *self.lin_lits.at(i);
            if lf.node != id && !bt_holds(ty, lf.v, self.tc_ptr32()) {
                if local {
                    self.errors.emit_span(
                        unsafe (*a).at_const(lf.node).span,
                        format("integer literal is out of range for '{}'", bt_name(ty)),
                    );
                }
                return false;
            }
        }
        if self.lin_shift >= bt_int_width(ty, self.tc_ptr32()) as i64 {
            if local {
                self.errors.emit_span(
                    unsafe (*a).at_const(id).span,
                    format("shift count {} is out of range for '{}'", self.lin_shift, bt_name(ty)),
                );
            }
            return false;
        }
        if want != BuiltinType::BT_COUNT && ty != want && !bt_widens(ty, want) {
            if local {
                self.errors.emit_span(
                    unsafe (*a).at_const(id).span,
                    format("mismatched types: expected '{}', found '{}'", bt_name(want), bt_name(ty)),
                );
            }
            return false;
        }
        // Every step computes in the form's type, as the written expression does at run time. A
        // step between constants is decided here (the whole expression's value is its caller's to
        // range-check); one over parameters is recorded for the instantiations to decide.
        for i in 0..self.lin_steps.len() {
            let st = self.lin_steps.at(i);
            let between = st.div.is_zero() && st.node != id && st.lin.is_concrete();
            if between && !bt_holds(ty, st.lin.value(), self.tc_ptr32()) {
                if local {
                    let sp = paren_span(self.mod_src(m), unsafe (*a).at_const(st.node).span);
                    self.errors.emit_span(
                        sp,
                        format(
                            "const expression {{{}}} overflows {}",
                            self.mod_src(m).slice(sp.start as usize, sp.end as usize),
                            bt_name(ty),
                        ),
                    );
                }
                return false;
            }
        }
        self.lin_err = false;
        out.ty = ty;
        out.to = pick(want != BuiltinType::BT_COUNT, want, ty);
        if !out.is_concrete() {
            self.tc_lin_record(m, id, out);
        }
        return true;
    }

    // Record the steps of form `out`, written at `id` of module `m`, that name parameters.
    fn tc_lin_record(self: &mut Self, m: ModuleId, id: NodeId, out: &ConstLin) {
        let a = self.mod_ast(m);
        for i in 0..self.lin_steps.len() {
            let st = *self.lin_steps.at(i);
            if st.div.is_zero() && st.lin.is_concrete() {
                continue;
            }
            let root = st.div.is_zero() && st.node == id;
            let mut l = st.lin;
            if root {
                l = *out;
            } else {
                l.ty = out.ty;
                l.to = out.ty;
            }
            let cs = ConstStep {
                lin: l,
                div: st.div,
                key: id,
                owner: NODE_NONE,
                module: m,
                span: paren_span(self.mod_src(m), unsafe (*a).at_const(st.node).span),
                root: root,
                canon: false,
                idx: false,
            };
            self.tc_step_emit(m, cs);
        }
    }

    // Record that constant index `v` at node `id` stays below symbolic array length `lt` (a const
    // parameter or a form of them) in every instance: a step the instance graph checks for each.
    fn tc_index_step(self: &mut Self, id: NodeId, lt: TypeId, v: i64) {
        let y = *self.type_at(lt);
        let mut l = ConstLin::new(BuiltinType::BT_USIZE);
        if y.kind == TypeKind::TYPE_CONST_EXPR {
            l = *unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst);
        } else if y.kind == TypeKind::TYPE_GENERIC {
            l = ConstLin::new(unsafe (*self.package).const_param_bt(y.module, y.as_data.decl));
            let _ = l.add_term(DefId { module: y.module, node: y.as_data.decl }, i128::one());
        } else {
            return;
        }
        let m = self.cur_module();
        let cs = ConstStep {
            lin: l,
            div: i128::from_i64(v),
            key: id,
            owner: NODE_NONE,
            module: m,
            span: unsafe (*self.cur_ast()).at_const(id).span,
            root: false,
            canon: false,
            idx: true,
        };
        self.tc_step_emit(m, cs);
    }

    // Route step `s`, recorded in module `m`: into the capture, or pending for the item of the
    // module under check that holds its key node. A step is recorded once.
    fn tc_step_emit(self: &mut Self, m: ModuleId, s: ConstStep) {
        if self.st_capture != 0 {
            self.st_cap.push(s);
            return;
        }
        if m != self.cur_module() {
            return;
        }
        let owner = self.tc_step_owner(m, s.key);
        if owner == loader::ITEM_NONE {
            return;
        }
        let mut t = s;
        t.owner = unsafe (*self.package).idx.items.at(owner as usize).node;
        // This checker alone writes the module's steps: its reads need no lock.
        let pubd = unsafe &(*self.cur_ast()).csteps;
        for i in 0..pubd.len() {
            if pubd.at(i).same(&t) {
                return;
            }
        }
        for i in 0..self.st_pend.len() {
            if self.st_pend.at(i).s.same(&t) {
                return;
            }
        }
        self.st_pend.push(PendStep { owner: owner, s: t });
    }

    // The item whose instantiations bind the parameters of a step keyed at node `key` of module
    // `m`: the item that holds the node, but the extend itself for a node of an extend's header
    // (`gitems::owner_of` gives header nodes to the first member).
    fn tc_step_owner(self: &Self, m: ModuleId, key: NodeId) loader::ItemId {
        let p = unsafe &*self.package;
        let it = gitems::owner_of(p, m, key);
        if it == loader::ITEM_NONE || Ast::in_body(key) {
            return it;
        }
        let up = p.idx.items.at(it as usize).owner;
        if up == loader::ITEM_NONE {
            return it;
        }
        let en = unsafe (*self.mod_ast(m)).at_const(p.idx.items.at(up as usize).node);
        if en.kind == NodeKind::NODE_EXTEND && (key <= en.as_data.extend_def.target_type || en.as_data.extend_def.interface_type != NODE_NONE && key <= en.as_data.extend_def.interface_type) {
            return up;
        }
        return it;
    }

    // Publish the pending steps of item `it` and its members (`Ast::publish_step`), before the
    // item's Checked state.
    fn tc_publish_steps(self: &mut Self, it: loader::ItemId) {
        if self.st_pend.len() == 0 {
            return;
        }
        let p = unsafe &*self.package;
        let mut keep: usize = 0;
        for i in 0..self.st_pend.len() {
            let ps = *self.st_pend.at(i);
            if ps.owner == it || p.idx.items.at(ps.owner as usize).owner == it {
                unsafe (*self.cur_ast()).publish_step(ps.s);
            } else {
                self.st_pend.set(keep, ps);
                keep += 1;
            }
        }
        self.st_pend.truncate(keep);
    }

    // The type standing for form `l`: a bare parameter `P` in P's own type is P itself (one type
    // however it is spelled or composed), any other form its interned self.
    fn tc_intern_form(self: &mut Self, l: &ConstLin) TypeId {
        let mut hit: i32 = -1;
        let mut nz: i32 = 0;
        for i in 0..l.n {
            if !unsafe l.c[i as usize].is_zero() {
                hit = i;
                nz += 1;
            }
        }
        if nz == 1 && l.k.is_zero() && l.div_of() == i128::one() && unsafe l.c[hit as usize] == i128::one() && l.ty == l.to {
            let d = unsafe l.p[hit as usize];
            if unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_GENERIC_PARAM && unsafe (*self.package).const_param_bt(
                d.module,
                d.node,
            ) == l.to {
                return unsafe (*self.cur_ast()).intern_type(
                    Ty { kind: TypeKind::TYPE_GENERIC, module: d.module, as_data: TyAs { decl: d.node } },
                );
            }
        }
        return unsafe (*self.cur_ast()).intern_const_lin(l);
    }

    // Substitute a canonical form: every parameter that this instantiation binds is replaced by what it
    // is bound to: a value, or another form, folded in. What is left is the composed width.
    fn tc_lin_subst(self: &mut Self, idx: u32, params: *const DefId, args: *const TypeId, n: i32, out: &mut ConstLin) bool {
        let a = self.cur_ast();
        return unsafe lin_subst(&*a, &*a, idx, params, args, n, out, self.tc_ptr32(), 0);
    }

    // Do two types denote the same thing when one or both still carry an unfolded const-generic
    // expression? Compared by canonical form, not as written, so `{(N * 2) * 2}` matches `{N * 4}`.
    fn tc_const_expr_same(self: &mut Self, a: TypeId, b: TypeId) bool {
        if a == b {
            return true;
        }
        if a == TYPE_NONE || b == TYPE_NONE {
            return false;
        }
        let ya = *self.type_at(a);
        let yb = *self.type_at(b);
        if ya.kind == TypeKind::TYPE_CONST_EXPR && yb.kind == TypeKind::TYPE_CONST_EXPR {
            return const_lin_eq(
                unsafe (*self.cur_ast()).const_lin_at(ya.as_data.inst),
                unsafe (*self.cur_ast()).const_lin_at(yb.as_data.inst),
            );
        }
        if ya.kind != yb.kind {
            return false;
        }
        if ya.kind == TypeKind::TYPE_POINTER || ya.kind == TypeKind::TYPE_REFERENCE || ya.kind == TypeKind::TYPE_SLICE {
            return ya.qualifier == yb.qualifier && self.tc_const_expr_same(ya.as_data.elem, yb.as_data.elem);
        }
        if ya.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let ia = *unsafe (*self.cur_ast()).instance(ya.as_data.inst);
        let ib = *unsafe (*self.cur_ast()).instance(yb.as_data.inst);
        if ia.module != ib.module || ia.decl != ib.decl || ia.n != ib.n {
            return false;
        }
        let mut all = false;
        for i in 0..ia.n {
            if !self.tc_const_expr_same(unsafe ia.args[i as usize], unsafe ib.args[i as usize]) {
                return false;
            }
            all = true;
        }
        return all;
    }

    // Solve a single-unknown, undivided linear const form against exact argument value `v`, which the
    // form's types must hold. Exact integer division gives the parameter's value; a remainder, a value
    // outside the parameter's type or an unmapped unknown leaves the parameter unresolved, which the
    // call reports. Conflicting solved values are conflicts.
    fn tc_lin_solve_ev(self: &mut Self, l: &ConstLin, v: i128) {
        if l.n != 1 || l.div_of() != i128::one() || l.c[0].is_zero() {
            // Multi-variable, divided, or constant form: never solved here.
            return;
        }
        let d = l.p[0];
        let slot = self.icx.sv.slot_of(d);
        let bt = unsafe (*self.package).const_param_bt(d.module, d.node);
        let ptr32 = self.tc_ptr32();
        if slot < 0 || !bt_holds(l.ty, v, ptr32) || !bt_holds(l.to, v, ptr32) {
            return;
        }
        let mut num = v;
        let mut q = i128::zero();
        if !lin_acc(&mut num, i128::from_i64(-1), l.k) || !lin_div_exact(num, l.c[0], &mut q) || !bt_holds(bt, q, ptr32) {
            return;
        }
        let cv = unsafe (*self.cur_ast()).const_value(cval_bits(q), bt);
        self.icx.sv.s_eq(slot as u32, cv);
    }

    // Const evidence `ty` for session slot `slot`, in the slot parameter's integer type (`tc_const_as`;
    // inference may narrow through a form). A value that type does not hold binds nothing: it is
    // recorded as a conflict the call reports (TYPE_NONE).
    fn tc_slot_const(self: &mut Self, slot: u32, ty: TypeId) TypeId {
        let d = self.icx.sv.slot_def(slot);
        let gp = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if gp.kind != NodeKind::NODE_GENERIC_PARAM || !gp.as_data.generic_param.is_const {
            return ty;
        }
        let want = unsafe (*self.package).const_param_bt(d.module, d.node);
        if ty == TYPE_ERROR {
            return ty;
        }
        let r = self.tc_const_as(ty, want, true);
        if r == TYPE_NONE && ty != TYPE_NONE {
            self.icx.sv.cconflicts.push(inf::TypeConflict { first: ty, later: Ast::builtin(want) });
        }
        return r;
    }

    // Session-driven evidence walk: a structural walk in which a mapped generic-parameter leaf
    // feeds its solver variable instead of a first-binding array.
    // A top-level parameter position records a directional bound (a safe conversion is allowed
    // there); every nested position is invariant evidence.
    fn tc_infer_ev(self: &mut Self, param_ty: TypeId, arg_ty: TypeId, top: bool) {
        if param_ty == TYPE_NONE || arg_ty == TYPE_NONE {
            return;
        }
        if arg_ty == TYPE_ERROR {
            self.tc_infer_poison(param_ty);
            return;
        }
        let p = *self.type_at(param_ty);
        // A parameter position written as a bare const-generic parameter reduces to the form `1 * P`,
        // which binds P exactly as a type parameter would. Anything more (`{P * 2}` in a PARAMETER)
        // would have to be solved for P, which this does not attempt.
        if p.kind == TypeKind::TYPE_CONST_EXPR {
            let l = *unsafe (*self.cur_ast()).const_lin_at(p.as_data.inst);
            let slot = self.icx.sv.slot_of(l.p[0]);
            if l.k.is_zero() && l.n == 1 && l.c[0] == i128::one() && l.div_of() == i128::one() && slot >= 0 {
                // Exact `1 * P`: a symbolic or exact argument binds the parameter directly, in its type.
                let at = self.tc_slot_const(slot as u32, arg_ty);
                if at != TYPE_NONE {
                    self.icx.sv.s_eq(slot as u32, at);
                }
            } else {
                // A single-unknown linear form solves against an exact argument value; division
                // with a remainder leaves it unresolved.
                let ay9 = *self.type_at(arg_ty);
                if ay9.kind == TypeKind::TYPE_CONST {
                    self.tc_lin_solve_ev(&l, ay9.cval());
                }
            }
            return;
        }
        if p.kind == TypeKind::TYPE_GENERIC {
            let slot = self.icx.sv.slot_of(DefId { module: p.module, node: p.as_data.decl });
            if slot >= 0 {
                let at = self.tc_slot_const(slot as u32, arg_ty);
                if at == TYPE_NONE {
                    return;
                }
                if top {
                    self.icx.sv.s_lb(slot as u32, at);
                } else {
                    self.icx.sv.s_eq(slot as u32, at);
                }
            }
            return;
        }
        let aT = *self.type_at(arg_ty);
        if aT.kind == p.kind && (p.kind == TypeKind::TYPE_POINTER || p.kind == TypeKind::TYPE_REFERENCE || p.kind == TypeKind::TYPE_SLICE || p.kind == TypeKind::TYPE_ARRAY) {
            self.tc_infer_ev(p.as_data.elem, aT.as_data.elem, false);
            if p.arr_sym() {
                // A symbolic length binds from the argument's length, a count or a symbolic one.
                let alt = if aT.arr_sym() {
                    aT.as_data.arr.len;
                } else {
                    unsafe (*self.cur_ast()).const_value(aT.as_data.arr.len, BuiltinType::BT_USIZE);
                };
                self.tc_infer_ev(p.as_data.arr.len, alt, false);
            }
        } else if p.kind == TypeKind::TYPE_INSTANCE && aT.kind == TypeKind::TYPE_INSTANCE {
            let pi = *unsafe (*self.cur_ast()).instance(p.as_data.inst);
            let ai = *unsafe (*self.cur_ast()).instance(aT.as_data.inst);
            if pi.decl == ai.decl && pi.module == ai.module && pi.n == ai.n {
                for i in 0..pi.n {
                    self.tc_infer_ev(unsafe pi.args[i as usize], unsafe ai.args[i as usize], false);
                }
            }
        } else if p.kind == TypeKind::TYPE_FUNCTION && aT.kind == TypeKind::TYPE_FUNCTION {
            let ps = self.fn_sig(param_ty);
            let as2 = self.fn_sig(arg_ty);
            if ps.np == as2.np {
                for i in 0..ps.np {
                    self.tc_infer_ev(self.fn_param(&ps, i), self.fn_param(&as2, i), false);
                }
                self.tc_infer_ev(ps.ret, as2.ret, false);
            }
        }
    }

    // A rejected type flowed into `param_ty`: every generic parameter of the active session that
    // `param_ty` mentions binds to TYPE_ERROR, so the call infers silently and its result is rejected.
    fn tc_infer_poison(self: &mut Self, param_ty: TypeId) {
        let p = *self.type_at(param_ty);
        if p.kind == TypeKind::TYPE_GENERIC {
            let slot = self.icx.sv.slot_of(DefId { module: p.module, node: p.as_data.decl });
            if slot >= 0 {
                self.icx.sv.s_eq(slot as u32, TYPE_ERROR);
            }
        } else if p.kind == TypeKind::TYPE_CONST_EXPR {
            let l = *unsafe (*self.cur_ast()).const_lin_at(p.as_data.inst);
            for i in 0..l.n {
                let slot = self.icx.sv.slot_of(unsafe l.p[i as usize]);
                if slot >= 0 {
                    self.icx.sv.s_eq(slot as u32, TYPE_ERROR);
                }
            }
        } else if p.kind == TypeKind::TYPE_POINTER || p.kind == TypeKind::TYPE_REFERENCE || p.kind == TypeKind::TYPE_SLICE {
            self.tc_infer_poison(p.as_data.elem);
        } else if p.kind == TypeKind::TYPE_ARRAY {
            self.tc_infer_poison(p.as_data.arr.elem);
            if p.arr_sym() {
                self.tc_infer_poison(p.as_data.arr.len);
            }
        } else if p.rec() != NO_REC {
            let it = *unsafe (*self.cur_ast()).instance(p.rec());
            for i in 0..it.n {
                self.tc_infer_poison(unsafe it.args[i as usize]);
            }
        }
    }

    // Report the const-evidence conflicts the active session recorded, once, at the call span.
    @c.cold
    fn tc_report_const_conflicts(self: &mut Self, sp: tok::Span) {
        for ci in self.icx.sv.sess.cconflicts as usize..self.icx.sv.cconflicts.len() {
            let cf = *self.icx.sv.cconflicts.at(ci);
            let oldy = *self.type_at(cf.first);
            let newy = *self.type_at(cf.later);
            if oldy.kind == TypeKind::TYPE_CONST && newy.kind == TypeKind::TYPE_CONST {
                self.errors.emit_span(
                    sp,
                    format("conflicting const generic arguments: inferred both {} and {}", oldy.cval(), newy.cval()),
                );
            } else if oldy.kind == TypeKind::TYPE_CONST && newy.kind == TypeKind::TYPE_BUILTIN {
                // `tc_slot_const`: a value outside the parameter's type.
                self.errors.emit_span(
                    sp,
                    format(
                        "const generic argument {} is out of range for '{}'",
                        oldy.cval(),
                        bt_name(newy.as_data.builtin),
                    ),
                );
            } else {
                self.errors.emit_span(sp, format("conflicting const generic arguments for this call"));
            }
        }
        self.icx.sv.cconflicts.truncate(self.icx.sv.sess.cconflicts as usize);
    }

    @c.cold
    fn tc_report_type_conflicts(self: &mut Self, sp: tok::Span) {
        for ci in self.icx.sv.sess.type_conflicts as usize..self.icx.sv.type_conflicts.len() {
            let cf = *self.icx.sv.type_conflicts.at(ci);
            let first = self.type_buf(cf.first);
            let later = self.type_buf(cf.later);
            self.errors.emit_span(
                sp,
                format(
                    "mismatched types: generic parameter was constrained to both '{}' and '{}'",
                    str::from_cstr(&first[0]),
                    str::from_cstr(&later[0]),
                ),
            );
        }
        self.icx.sv.type_conflicts.truncate(self.icx.sv.sess.type_conflicts as usize);
    }

    fn named_type_of(self: &mut Self, m: ModuleId, decl: NodeId) TypeId {
        let a = self.mod_ast(m);
        let dk = unsafe (*a).at_const(decl).kind;
        if dk == NodeKind::NODE_STRUCT {
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_STRUCT, module: m, as_data: TyAs { decl: decl } },
            );
        }
        if dk == NodeKind::NODE_ENUM {
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_ENUM, module: m, as_data: TyAs { decl: decl } },
            );
        }
        if dk == NodeKind::NODE_TYPE_ALIAS {
            let aliased_node = unsafe (*a).at_const(decl).as_data.type_alias.ty;
            if aliased_node == NODE_NONE {
                return unsafe (*self.cur_ast()).intern_type(
                    Ty { kind: TypeKind::TYPE_OPAQUE, module: m, as_data: TyAs { decl: decl } },
                );
            }
            if self.alias_depth >= TYPE_ALIAS_MAX_DEPTH {
                let sp = unsafe (*a).at_const(decl).span;
                self.errors.emit_span(sp, format("type alias is cyclic"));
                return TYPE_ERROR;
            }
            self.alias_depth = self.alias_depth + 1;
            let aliased = self.lower_type_in(m, aliased_node);
            self.alias_depth = self.alias_depth - 1;
            return aliased;
        }
        if dk == NodeKind::NODE_GENERIC_PARAM || dk == NodeKind::NODE_INTERFACE {
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_GENERIC, module: m, as_data: TyAs { decl: decl } },
            );
        }
        return TYPE_ERROR;
    }

    const fn agg_has_default_at(self: &Self, dmod: ModuleId, dn: NodeId, from: u32) bool {
        let da = self.mod_ast(dmod);
        let gens = unsafe (*da).at_const(dn).as_data.aggregate.generics;
        if from >= gens.len {
            return false;
        }
        let gid = unsafe (*da).list(gens)[from as usize];
        return unsafe (*da).at_const(gid).as_data.generic_param.default_type != NODE_NONE;
    }

    fn apply_default_args(self: &mut Self, dmod: ModuleId, dn: NodeId, ta: *mut TypeId, tn: *mut u8) {
        let da = self.mod_ast(dmod);
        let dk = unsafe (*da).at_const(dn).kind;
        let gens = if dk == NodeKind::NODE_TYPE_ALIAS {
            unsafe (*da).at_const(dn).as_data.type_alias.generics;
        } else if dk == NodeKind::NODE_INTERFACE {
            unsafe (*da).at_const(dn).as_data.interface_def.generics;
        } else {
            unsafe (*da).at_const(dn).as_data.aggregate.generics;
        };
        if unsafe *tn >= gens.len as u8 {
            return;
        }
        while unsafe *tn < 8 {
            let d = self.tc_default_arg(dmod, gens, unsafe *tn, ta);
            if d == TYPE_NONE {
                break;
            }
            let k = unsafe *tn;
            unsafe ta[k as usize] = d;
            unsafe *tn = k + 1;
        }
    }

    // The declared default of generic parameter `i` in list `gens` of module `dmod`, with the
    // parameters before it bound to `ta[0..i]`; TYPE_NONE past the list or without a default.
    fn tc_default_arg(self: &mut Self, dmod: ModuleId, gens: NodeList, i: u8, ta: *const TypeId) TypeId {
        let da = self.mod_ast(dmod);
        if i as u32 >= gens.len {
            return TYPE_NONE;
        }
        let gid = unsafe (*da).list(gens)[i as usize];
        let dft = unsafe (*da).at_const(gid).as_data.generic_param.default_type;
        if dft == NODE_NONE {
            return TYPE_NONE;
        }
        // A CONST parameter's default is a value: fold it the way an explicit argument would be.
        let d = if unsafe (*da).at_const(gid).as_data.generic_param.is_const {
            self.tc_const_enum_arg(self.tc_const_arg(dmod, dft, self.tc_arg_bt(dmod, gid)), dmod, dft, dmod, gid);
        } else {
            self.lower_type_in(dmod, dft);
        };
        if i == 0 {
            return d;
        }
        let mut prm = Defs8 {};
        for j in 0..i {
            prm[j as usize] = DefId { module: dmod, node: unsafe (*da).list(gens)[j as usize] };
        }
        return self.subst_type(d, &prm[0], ta, i);
    }

    fn prelude_str_type(self: &mut Self) TypeId {
        if self.ph_str.node != NODE_NONE {
            return self.named_type_of(self.ph_str.mid, self.ph_str.node);
        }
        return TYPE_ERROR;
    }
    fn prelude_slice_type(self: &mut Self, elem: TypeId, mut2: bool) TypeId {
        let mut hit = self.ph_slice;
        if mut2 {
            hit = self.ph_slicemut;
        }
        if hit.node != NODE_NONE {
            return unsafe (*self.cur_ast()).intern_instance(hit.mid, hit.node, &elem, 1);
        }
        return TYPE_ERROR;
    }
    fn prelude_range_type(self: &mut Self, elem: TypeId) TypeId {
        if self.ph_range.node != NODE_NONE {
            return unsafe (*self.cur_ast()).intern_instance(self.ph_range.mid, self.ph_range.node, &elem, 1);
        }
        return TYPE_ERROR;
    }
    fn prelude_tuple_type(self: &mut Self, args: *const TypeId, n: u32) TypeId {
        if n < 2 || n > 4 {
            return TYPE_ERROR;
        }
        let mut hit = self.ph_t2;
        if n == 3 {
            hit = self.ph_t3;
        } else if n == 4 {
            hit = self.ph_t4;
        }
        if hit.node != NODE_NONE {
            return unsafe (*self.cur_ast()).intern_instance(hit.mid, hit.node, args, n as u8);
        }
        return TYPE_ERROR;
    }

    // If `tid` is the prelude instance `hit`, copy its args into `out` and return the count; else -1.
    fn prelude_instance_args_hit(self: &Self, tid: TypeId, hit: loader::LookupHit, out: *mut TypeId, maxn: i32) i32 {
        if tid == TYPE_NONE || hit.node == NODE_NONE {
            return -1;
        }
        let ty = self.type_at(tid);
        if ty.kind != TypeKind::TYPE_INSTANCE {
            return -1;
        }
        let it = *unsafe (*self.cur_ast()).instance(ty.as_data.inst);
        if it.module != hit.mid || it.decl != hit.node {
            return -1;
        }
        let mut i: i32 = 0;
        while i < it.n as i32 && i < maxn {
            unsafe out[i as usize] = unsafe it.args[i as usize];
            i = i + 1;
        }
        return it.n;
    }
    fn tuple_args_of(self: &Self, tid: TypeId, out: *mut TypeId, maxn: i32) i32 {
        let n2 = self.prelude_instance_args_hit(tid, self.ph_t2, out, maxn);
        if n2 >= 0 {
            return n2;
        }
        let n3 = self.prelude_instance_args_hit(tid, self.ph_t3, out, maxn);
        if n3 >= 0 {
            return n3;
        }
        return self.prelude_instance_args_hit(tid, self.ph_t4, out, maxn);
    }
    const fn range_instance_elem(self: &Self, tid: TypeId) TypeId {
        let ty = self.type_at(tid);
        if ty.kind != TypeKind::TYPE_INSTANCE {
            return TYPE_NONE;
        }
        let it = *unsafe (*self.cur_ast()).instance(ty.as_data.inst);
        if it.n == 1 && it.module == self.ph_range.mid && it.decl == self.ph_range.node {
            return it.args[0];
        }
        return TYPE_NONE;
    }
    // 0 not a slice, 1 Slice<E>, 2 SliceMut<E>; sets *elem.
    const fn slice_kind(self: &Self, tid: TypeId, elem: *mut TypeId) i32 {
        let ty = self.type_at(tid);
        if ty.kind != TypeKind::TYPE_INSTANCE {
            return 0;
        }
        let it = *unsafe (*self.cur_ast()).instance(ty.as_data.inst);
        if it.n != 1 {
            return 0;
        }
        let mut kind: i32 = 0;
        if it.module == self.ph_slice.mid && it.decl == self.ph_slice.node {
            kind = 1;
        } else if it.module == self.ph_slicemut.mid && it.decl == self.ph_slicemut.node {
            kind = 2;
        }
        if kind != 0 && elem != null {
            unsafe *elem = it.args[0];
        }
        return kind;
    }
    const fn tc_box_of(self: &Self, y: &Ty, inner: &mut TypeId, global_alloc: &mut bool) bool {
        if y.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let it = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
        if it.module != self.ph_box.mid || it.decl != self.ph_box.node || it.n < 1 {
            return false;
        }
        *inner = it.args[0];
        let mut ga = false;
        if it.n >= 2 {
            let ay = self.type_at(it.args[1]);
            ga = ay.kind == TypeKind::TYPE_STRUCT && ay.module == self.ph_global.mid && ay.as_data.decl == self.ph_global.node;
        }
        *global_alloc = ga;
        return true;
    }

    /// The type of declaration `decl` of module `m`: a parameter, field, constant, binding,
    /// function, generic parameter or aggregate. The item that owns the declaration records it on
    /// the node while it is under check (`decl_is_own`); every other reader takes that record
    /// when it is there (a foreign one once its id is final, the package identity) and lowers
    /// the declared syntax privately otherwise, memoized and without diagnostics: the owner
    /// reports a bad declaration once, where it is written, and no two items write one slot.
    /// Only declaration nodes carry their type in the node slot: a type node's slot holds other
    /// facts, so `lower_type_in` never reads it.
    pub fn decl_type_in(self: &mut Self, m: ModuleId, decl: NodeId) TypeId {
        if decl == NODE_NONE {
            return TYPE_NONE;
        }
        let local = m == self.cur_module();
        let fkey = m as u64 << 32 | decl as u64;
        let mut own = local;
        if local {
            let cached = unsafe (*self.cur_ast()).type_of(decl);
            if cached != TYPE_NONE {
                return cached;
            }
            own = self.decl_is_own(decl);
            if !own {
                switch self.fdecl_memo.get(&fkey) {
                    Some(t) => {
                        return *t;
                    },
                    None => {},
                };
            }
        } else {
            if unsafe TS_ON {
                ts_add(TS_DECLIN, 1);
            }
            switch self.fdecl_memo.get(&fkey) {
                Some(t) => {
                    return *t;
                },
                None => {},
            };
            // The owner's record: read only when its item is visible to the item under check (the
            // owner's writes happen before this job), never while the owner may still be writing it.
            if unsafe (*self.mod_ast(m)).gt != null && self.node_visible(m, decl) {
                let known = unsafe (*self.mod_ast(m)).type_of(decl);
                if known != TYPE_NONE && (known & TYPE_PROV) == 0 {
                    let dk0 = unsafe (*self.mod_ast(m)).at_const(decl).kind;
                    if dk0 == NodeKind::NODE_PARAMETER || dk0 == NodeKind::NODE_FIELD || dk0 == NodeKind::NODE_CONST {
                        return known;
                    }
                }
            }
        }
        // A private lowering of another item's declaration reports nothing: its owner does.
        let quiet = local && !own;
        let mut saved = diag::Errors::new();
        if quiet {
            saved = replace(&mut self.errors, diag::Errors::new());
        }
        let ne = self.errors.errors.len();
        let a = self.mod_ast(m);
        let dk = unsafe (*a).at_const(decl).kind;
        let mut result = TYPE_NONE;
        if dk == NodeKind::NODE_PARAMETER {
            result = self.lower_type_in(m, unsafe (*a).at_const(decl).as_data.parameter.ty);
        } else if dk == NodeKind::NODE_FIELD {
            result = self.lower_type_in(m, unsafe (*a).at_const(decl).as_data.field.ty);
        } else if dk == NodeKind::NODE_CONST {
            result = self.lower_type_in(m, unsafe (*a).at_const(decl).as_data.const_def.ty);
        } else if dk == NodeKind::NODE_LET {
            result = self.lower_type_in(m, unsafe (*a).at_const(decl).as_data.let_stmt.ty);
        } else if dk == NodeKind::NODE_FUNCTION {
            result = unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_FUNCTION, module: m, as_data: TyAs { decl: decl } },
            );
        } else if dk == NodeKind::NODE_GENERIC_PARAM {
            let gp = unsafe (*a).at_const(decl).as_data.generic_param;
            // In value position a const-generic param has its declared type (e.g. usize); a type param is TYPE_GENERIC.
            // A LIFETIME param has no type at all: lifetimes are erased before monomorphization, so it must never
            // become a TYPE_GENERIC (that would make it a mono argument and mangle into the emitted symbol).
            if gp.is_lifetime {
                result = TYPE_NONE;
            } else if gp.is_const {
                result = self.lower_type_in(m, gp.const_type);
            } else {
                result = self.named_type_of(m, decl);
            }
        } else if dk == NodeKind::NODE_STRUCT || dk == NodeKind::NODE_ENUM {
            result = self.named_type_of(m, decl);
        }
        let clean = self.errors.errors.len() == ne;
        if quiet {
            let _scratch = replace(&mut self.errors, saved);
        }
        if own {
            unsafe (*self.cur_ast()).set_type(decl, result);
        } else if result != TYPE_ERROR && clean {
            self.fdecl_memo.insert(fkey, result);
        }
        return result;
    }
    fn decl_type(self: &mut Self, decl: NodeId) TypeId {
        return self.decl_type_in(self.cur_module(), decl);
    }

    /// The type a parameter, field, constant or bare type node stands for: a declaration goes
    /// through its recorded declaration type, a type node is lowered.
    pub fn node_type_in(self: &mut Self, m: ModuleId, id: NodeId) TypeId {
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        let k = unsafe (*self.mod_ast(m)).at_const(id).kind;
        if k == NodeKind::NODE_PARAMETER || k == NodeKind::NODE_FIELD || k == NodeKind::NODE_CONST {
            return self.decl_type_in(m, id);
        }
        if m == self.cur_module() {
            return self.lower_type_in(m, id);
        }
        // A foreign signature type node (a return type, a member's type): every call site of the
        // callee asks for it, so the lowering is memoized whatever its shape (the body-expression
        // rule that memoizes only generic paths does not pay here: a signature is read many times).
        let lk = m as u64 << 32 | id as u64;
        switch self.lower_memo.get(&lk) {
            Some(t) => {
                return *t;
            },
            None => {},
        };
        let ne = self.errors.errors.len();
        let r = self.lower_type_in(m, id);
        if r != TYPE_ERROR && self.errors.errors.len() == ne {
            self.lower_memo.insert(lk, r);
        }
        return r;
    }

    fn type_of_type_node(self: &mut Self, id: NodeId) TypeId {
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        if unsafe (*self.cur_ast()).at_const(id).kind != NodeKind::NODE_IDENTIFIER {
            return self.resolve_type_at(id, true);
        }
        let d = unsafe (*self.cur_ast()).resolution_def(id);
        if d.node != NODE_NONE {
            // A bare generic enum name whose parameters all DEFAULT still instantiates. A bare
            // generic struct stays open: `check_struct_init` infers it, defaults last.
            let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
            if dn.kind == NodeKind::NODE_TYPE_ALIAS && dn.as_data.type_alias.generics.len > 0 {
                return self.tc_bare_alias(id, d);
            }
            if dn.kind == NodeKind::NODE_ENUM && dn.as_data.aggregate.generics.len > 0 && self.agg_has_default_at(
                d.module,
                d.node,
                0,
            ) {
                let mut ta = Tys8 {};
                let mut tn: u8 = 0;
                self.apply_default_args(d.module, d.node, &mut ta[0], &mut tn);
                let it = unsafe (*self.cur_ast()).intern_instance(d.module, d.node, &ta[0], tn);
                // Codegen renders the literal's type from this node.
                unsafe (*self.cur_ast()).set_type(id, it);
                return it;
            }
            return self.named_type_of(d.module, d.node);
        }
        let b = bt_of_name(self.source, self.name_span(id));
        if b >= 0 {
            return Ast::builtin(b as BuiltinType);
        }
        return TYPE_ERROR;
    }

    // A local constant of a generic function whose type or initializer may use the function's or its
    // extend's generic parameters has a value per instance: reference `id` to it (of type `ty`)
    // records those parameters, as themselves, as its type arguments (extend's first), so the backend
    // names and defines one static per instance, as for a generic extend's constant.
    fn tc_local_const_env(self: &mut Self, id: NodeId, d: DefId, ty: TypeId) {
        let f = self.icx.current_fn;
        if d.node == NODE_NONE || d.module != self.cur_module() || f == NODE_NONE || ty == TYPE_NONE {
            return;
        }
        let a = self.cur_ast();
        let cn = unsafe (*a).at_const(d.node);
        if cn.kind != NodeKind::NODE_CONST || !cn.as_data.const_def.is_local {
            return;
        }
        let fg = unsafe (*a).at_const(f).as_data.function.generics;
        let ext = self.enclosing(d.module, f, NodeKind::NODE_EXTEND);
        let xg = if ext != NODE_NONE {
            unsafe (*a).at_const(ext).as_data.extend_def.generics;
        } else {
            NodeList { start: 0, len: 0 };
        };
        let n = xg.len + fg.len;
        if n == 0 || n > 8 || self.type_at(ty).concrete && !self.tc_mentions_generic(
            d.module,
            cn.as_data.const_def.value,
            0,
        ) {
            return;
        }
        let mut ga = Tys8 {};
        for i in 0..n {
            let gid = if i < xg.len {
                unsafe (*a).list(xg)[i as usize];
            } else {
                unsafe (*a).list(fg)[(i - xg.len) as usize];
            };
            ga[i as usize] = unsafe (*a).intern_type(
                Ty { kind: TypeKind::TYPE_GENERIC, module: d.module, as_data: TyAs { decl: gid } },
            );
        }
        unsafe (*a).set_type_args(id, &ga[0], n as u8);
    }

    // Is this generic argument a const VALUE rather than a type? A bare integer literal always is; that is
    // the only form `parse_type_args` recognises, so everything else arrives as a type node and the deciding
    // fact is what the resolver bound it to. A path bound to a `const` (`B`, `m::B`) is a named constant standing
    // where a literal is otherwise required. A const-generic PARAMETER is deliberately not included: it is
    // declared in both namespaces and keeps flowing through the type path, which already substitutes it.
    fn tc_arg_is_const(self: &mut Self, m: ModuleId, aid: NodeId) bool {
        let k = unsafe (*self.mod_ast(m)).at_const(aid).kind;
        // A braced argument is written as an expression, so it arrives as one, and the braces already
        // said it is a value. A MEMBER path is how a braced `Family::Ieee` parses; an enum variant as
        // the value of an enum-typed const parameter.
        if k == NodeKind::NODE_LITERAL || unsafe (*self.mod_ast(m)).is_const_expr_arg(aid) {
            return true;
        }
        if k != NodeKind::NODE_TYPE_PATH {
            return false;
        }
        let tp = unsafe (*self.mod_ast(m)).at_const(aid).as_data.type_path;
        if tp.parts.len == tp.head + 2 {
            // `u64::MAX`, `Foo::K`, `D::Y` or `m::Foo::K`: a value the type's name qualifies, also
            // when several constants of that name (disjoint extends of a generic type) leave the
            // choice to the parameter's type.
            let mut hd = DefId { module: 0, node: NODE_NONE };
            if self.tc_value_path(m, aid, &mut hd).node != NODE_NONE {
                return true;
            }
            if hd.node == NODE_NONE {
                return false;
            }
            let ms = unsafe (*self.mod_ast(m)).at_const(
                unsafe (*self.mod_ast(m)).list(tp.parts)[(tp.head + 1) as usize],
            ).as_data.name.text;
            let mut cs = Defs8 {};
            return self.tc_assoc_consts(
                m,
                hd.module,
                hd.node,
                self.mod_src(m).slice(ms.start as usize, ms.end as usize),
                &mut cs,
            ) != 0;
        }
        // `B` or `m::B`: a named constant.
        if tp.parts.len != tp.head + 1 || tp.args.len != 0 {
            return false;
        }
        let d = unsafe (*self.mod_ast(m)).resolution_def(aid);
        if d.node == NODE_NONE {
            return false;
        }
        return unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_CONST;
    }

    // The integer type a written argument of the `i`th type-level generic parameter of `d` folds to:
    // `tc_arg_bt` of the parameter; BT_COUNT for a type parameter, past the list, or no declaration.
    fn tc_gen_bt(self: &Self, d: DefId, i: u32) BuiltinType {
        let gid = self.tc_gen_param(d, i);
        if gid == NODE_NONE {
            return BuiltinType::BT_COUNT;
        }
        return self.tc_arg_bt(d.module, gid);
    }

    // The integer type a written argument of const parameter `gid` (module `pm`) folds to: its
    // `Package::const_param_bt`, or BT_COUNT (the value's own type) for an enum-typed parameter,
    // whose argument `tc_const_enum_arg` checks against the enum before it types it.
    fn tc_arg_bt(self: &Self, pm: ModuleId, gid: NodeId) BuiltinType {
        let ct = unsafe (*self.mod_ast(pm)).at_const(gid).as_data.generic_param.const_type;
        if unsafe (*self.package).type_enum(pm, ct).node != NODE_NONE {
            return BuiltinType::BT_COUNT;
        }
        return unsafe (*self.package).const_param_bt(pm, gid);
    }

    // The `i`th type-level generic parameter of `d` when it is a const parameter; NODE_NONE for a
    // type parameter, past the list, or no declaration.
    fn tc_gen_param(self: &Self, d: DefId, i: u32) NodeId {
        let gid = self.tc_gen_slot(d, i);
        if gid == NODE_NONE || !unsafe (*self.mod_ast(d.module)).at_const(gid).as_data.generic_param.is_const {
            return NODE_NONE;
        }
        return gid;
    }

    // Generic argument `t`, written at `aid` of module `m` as a value (`is_const`) or as a type, for the
    // `i`th type-level generic parameter of `d`: a value for a type parameter, or a type for a const
    // parameter, is reported (in the module under check) and gives TYPE_ERROR.
    fn tc_arg_kind(self: &mut Self, t: TypeId, m: ModuleId, aid: NodeId, d: DefId, i: u32, is_const: bool) TypeId {
        let gid = self.tc_gen_slot(d, i);
        if gid == NODE_NONE || t == TYPE_ERROR || t == TYPE_NONE {
            return t;
        }
        let gp = unsafe (*self.mod_ast(d.module)).at_const(gid).as_data.generic_param;
        if is_const == gp.is_const {
            return t;
        }
        let y = *self.type_at(t);
        let mut cparam = false;
        if y.kind == TypeKind::TYPE_GENERIC {
            let yn = unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl);
            cparam = yn.kind == NodeKind::NODE_GENERIC_PARAM && yn.as_data.generic_param.is_const;
        }
        if !is_const && (y.kind == TypeKind::TYPE_CONST || y.kind == TypeKind::TYPE_CONST_EXPR || cparam) {
            return t; // a const parameter of the enclosing generic, or a value a lowering produced
        }
        if m != self.cur_module() {
            return TYPE_ERROR;
        }
        let gn = unsafe (*self.mod_ast(d.module)).at_const(gp.name).as_data.name.text;
        let pname = diag::span_str(self.mod_src(d.module), gn.start, gn.end);
        let sp = unsafe (*self.mod_ast(m)).at_const(aid).span;
        if is_const {
            self.errors.emit_span(sp, format("expected a type for generic parameter '{}', found a constant", pname));
            return TYPE_ERROR;
        }
        let ty = self.type_buf(t);
        self.errors.emit_span(
            sp,
            format("expected a constant for const parameter '{}', found type '{}'", pname, str::from_cstr(&ty[0])),
        );
        return TYPE_ERROR;
    }

    // The `i`th type-level generic parameter of `d`; NODE_NONE past the list or without a declaration.
    fn tc_gen_slot(self: &Self, d: DefId, i: u32) NodeId {
        if d.node == NODE_NONE {
            return NODE_NONE;
        }
        let da = self.mod_ast(d.module);
        let dn = unsafe (*da).at_const(d.node);
        let gens = if dn.kind == NodeKind::NODE_STRUCT || dn.kind == NodeKind::NODE_ENUM {
            dn.as_data.aggregate.generics;
        } else if dn.kind == NodeKind::NODE_TYPE_ALIAS {
            dn.as_data.type_alias.generics;
        } else if dn.kind == NodeKind::NODE_FUNCTION {
            dn.as_data.function.generics;
        } else if dn.kind == NodeKind::NODE_INTERFACE {
            dn.as_data.interface_def.generics;
        } else {
            NodeList { start: 0, len: 0 };
        };
        let mut k: u32 = 0;
        for j in 0..gens.len {
            let gid = unsafe (*da).list(gens)[j as usize];
            let gp = unsafe (*da).at_const(gid).as_data.generic_param;
            if gp.is_lifetime {
                continue;
            }
            if k == i {
                return gid;
            }
            k = k + 1;
        }
        return NODE_NONE;
    }

    // The enum the value of const argument `aid` (module `m`) belongs to: a variant's enum
    // (`{E::A}`, `E::A`), or the declared enum type of the named or associated constant or the
    // const parameter it names; node NODE_NONE for an integer.
    fn tc_const_arg_enum(self: &mut Self, m: ModuleId, aid: NodeId) DefId {
        let none = DefId { module: 0, node: NODE_NONE };
        let mut hd = none;
        let vp = self.tc_value_path(m, aid, &mut hd);
        if vp.node != NODE_NONE {
            let vn = unsafe (*self.mod_ast(vp.module)).at_const(vp.node);
            if vn.kind == NodeKind::NODE_VARIANT {
                return hd;
            }
            return unsafe (*self.package).type_enum(vp.module, vn.as_data.const_def.ty);
        }
        let a = self.mod_ast(m);
        let an = unsafe (*a).at_const(aid);
        if an.kind == NodeKind::NODE_MEMBER && an.as_data.member.path {
            let ed = unsafe (*a).resolution_def(an.as_data.member.object);
            if ed.node != NODE_NONE && unsafe (*self.mod_ast(ed.module)).at_const(ed.node).kind == NodeKind::NODE_ENUM {
                return ed;
            }
            return none;
        }
        if an.kind != NodeKind::NODE_TYPE_PATH && an.kind != NodeKind::NODE_IDENTIFIER {
            return none;
        }
        let d = unsafe (*a).resolution_def(aid);
        if d.node == NODE_NONE {
            return none;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if dn.kind == NodeKind::NODE_CONST {
            return unsafe (*self.package).type_enum(d.module, dn.as_data.const_def.ty);
        }
        if dn.kind == NodeKind::NODE_GENERIC_PARAM && dn.as_data.generic_param.is_const {
            return unsafe (*self.package).type_enum(d.module, dn.as_data.generic_param.const_type);
        }
        return none;
    }

    // The associated constant or enum variant value path `id` of module `m` names, with the type's
    // declaration in `head`: `u64::MAX`, `D::Y` or `m::Foo::K` as a type path (the grammar reads a
    // generic argument as a type), `Foo::K` or `m::Foo::K` as a member path (a braced argument, a
    // pattern). The type is the path's resolved head segment (`TypePathData.head`) or the member path's
    // object, and one segment follows it. Node NODE_NONE for any other path.
    fn tc_value_path(self: &mut Self, m: ModuleId, id: NodeId, head: &mut DefId) DefId {
        let none = DefId { module: 0, node: NODE_NONE };
        let a = self.mod_ast(m);
        let n = *unsafe (*a).at_const(id);
        if n.kind == NodeKind::NODE_TYPE_PATH {
            let tp = n.as_data.type_path;
            if tp.parts.len != tp.head + 2 || tp.args.len != 0 {
                return none;
            }
            return self.tc_value_member(
                m,
                unsafe (*a).resolution_def(id),
                unsafe (*a).at_const(unsafe (*a).list(tp.parts)[tp.head as usize]).as_data.name.text,
                unsafe (*a).at_const(unsafe (*a).list(tp.parts)[(tp.head + 1) as usize]).as_data.name.text,
                TYPE_NONE,
                head,
            );
        }
        if n.kind != NodeKind::NODE_MEMBER || !n.as_data.member.path {
            return none;
        }
        // `W::<u8>::K`: the arguments name the instance whose extend defines the constant.
        let mut qid = n.as_data.member.object;
        let mut o = *unsafe (*a).at_const(qid);
        let spec = o.kind == NodeKind::NODE_GENERIC_SPECIALIZATION;
        if spec {
            qid = o.as_data.specialization.expression;
            o = *unsafe (*a).at_const(qid);
        }
        let hs = if o.kind == NodeKind::NODE_IDENTIFIER {
            o.as_data.name.text;
        } else if o.kind == NodeKind::NODE_MEMBER && o.as_data.member.path {
            // `m::Foo::K`: the resolver bound `m::Foo` to the type.
            unsafe (*a).at_const(o.as_data.member.member).as_data.name.text;
        } else {
            return none;
        };
        let d = unsafe (*a).resolution_def(qid);
        if (spec || o.kind == NodeKind::NODE_MEMBER) && d.node == NODE_NONE {
            return none;
        }
        let inst = if spec {
            self.tc_value_inst(m, n.as_data.member.object, d);
        } else {
            TYPE_NONE;
        };
        if inst == TYPE_ERROR {
            return none;
        }
        return self.tc_value_member(
            m,
            d,
            hs,
            unsafe (*a).at_const(n.as_data.member.member).as_data.name.text,
            inst,
            head,
        );
    }

    // The instance of generic struct or enum `d` that turbofish `spec` (module `m`, `W::<u8>`)
    // names; TYPE_NONE for any other declaration, TYPE_ERROR when its arguments do not fit (reported
    // in the module under check).
    fn tc_value_inst(self: &mut Self, m: ModuleId, spec: NodeId, d: DefId) TypeId {
        let dk = unsafe (*self.mod_ast(d.module)).at_const(d.node).kind;
        if dk != NodeKind::NODE_STRUCT && dk != NodeKind::NODE_ENUM || self.tc_gen_slot(d, 0) == NODE_NONE {
            return TYPE_NONE;
        }
        let a = self.mod_ast(m);
        let types = unsafe (*a).at_const(spec).as_data.specialization.types;
        if !self.tc_targ_count_ok(m, types, d, spec) {
            self.ev_err = true; // reported: the constant it names reports nothing more
            return TYPE_ERROR;
        }
        let mut ta = Tys8 {};
        let mut tn: u8 = 0;
        for i in 0..types.len {
            let tid = unsafe (*a).list(types)[i as usize];
            if unsafe (*a).at_const(tid).kind == NodeKind::NODE_LIFETIME {
                continue;
            }
            let is_c = self.tc_arg_is_const(m, tid);
            let want = self.tc_gen_bt(d, tn);
            let t = if is_c {
                self.tc_const_arg(m, tid, want);
            } else {
                self.tc_const_pos(self.lower_type_in(m, tid), want, m, tid);
            };
            let k = self.tc_arg_kind(t, m, tid, d, tn, is_c);
            if k == TYPE_ERROR || k == TYPE_NONE {
                self.ev_err = true;
                return TYPE_ERROR;
            }
            ta[tn as usize] = k;
            tn += 1;
        }
        self.apply_default_args(d.module, d.node, &mut ta[0], &mut tn);
        return unsafe (*self.cur_ast()).intern_instance(d.module, d.node, &ta[0], tn);
    }

    // The variant or associated constant named `ms` (module `m`'s source) of the type the head segment
    // `hs` names, resolved to `d` (node NODE_NONE: a builtin type's name), with the type's declaration
    // in `head`. The type is a builtin, a struct or an enum (through a non-generic alias). The
    // constant is the one of the extend that applies to `inst` (the written instance, `W::<u8>::K`),
    // else the only one, else the only one of type `vm_want`; without `inst` it belongs to an extend
    // without parameters. Node NODE_NONE otherwise.
    fn tc_value_member(
        self: &mut Self,
        m: ModuleId,
        d: DefId,
        hs: tok::Span,
        ms: tok::Span,
        inst: TypeId,
        head: &mut DefId,
    ) DefId {
        let none = DefId { module: 0, node: NODE_NONE };
        let mut tm: ModuleId = unsafe (*self.package).core_module;
        let mut td = NODE_NONE;
        if d.node == NODE_NONE {
            let b = bt_of_name(self.mod_src(m), hs);
            if b < 0 {
                return none;
            }
            td = unsafe (*self.package).builtin_decl(b as BuiltinType);
        } else {
            let dn = *unsafe (*self.mod_ast(d.module)).at_const(d.node);
            let agg = dn.kind == NodeKind::NODE_STRUCT || dn.kind == NodeKind::NODE_ENUM;
            if !agg && (dn.kind != NodeKind::NODE_TYPE_ALIAS || dn.as_data.type_alias.generics.len != 0) {
                return none;
            }
            tm = d.module;
            td = d.node;
            if dn.kind == NodeKind::NODE_TYPE_ALIAS {
                let y = *self.type_at(self.named_type_of(d.module, d.node));
                if y.kind == TypeKind::TYPE_BUILTIN {
                    tm = unsafe (*self.package).core_module;
                    td = unsafe (*self.package).builtin_decl(y.as_data.builtin);
                } else if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
                    tm = y.module;
                    td = y.as_data.decl;
                } else {
                    return none;
                }
            }
        }
        if td == NODE_NONE {
            return none;
        }
        *head = DefId { module: tm, node: td };
        let name = self.mod_src(m).slice(ms.start as usize, ms.end as usize);
        if unsafe (*self.mod_ast(tm)).at_const(td).kind == NodeKind::NODE_ENUM {
            let v = self.find_member_cstr(tm, td, name);
            if v != NODE_NONE && unsafe (*self.mod_ast(tm)).at_const(v).kind == NodeKind::NODE_VARIANT {
                return DefId { module: tm, node: v };
            }
        }
        let mut cs = Defs8 {};
        let n = self.tc_assoc_consts(m, tm, td, name, &mut cs);
        if n == 0 || n > cs.len() {
            return none;
        }
        if inst != TYPE_NONE {
            let mut gm: ModuleId = 0;
            let mut gd = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            if !self.aggregate_of(inst, &mut gm, &mut gd, &mut gp, &mut ga, &mut gn) {
                return none;
            }
            for i in 0..n {
                let ext = self.enclosing(cs[i].module, cs[i].node, NodeKind::NODE_EXTEND);
                let mut ea = Tys8 {};
                if self.tc_ext_args(cs[i].module, ext, &ga[0], gn, &mut ea[0]) >= 0 {
                    return cs[i];
                }
            }
            return none;
        }
        // Without the type's arguments only a constant of an extend without parameters has one
        // value: the only one, or among disjoint extends (`W<u8>`, `W<i32>`) the one the expected
        // type selects.
        let mut fit = none;
        for i in 0..n {
            if unsafe (*self.mod_ast(cs[i].module)).at_const(
                self.enclosing(cs[i].module, cs[i].node, NodeKind::NODE_EXTEND),
            ).as_data.extend_def.generics.len != 0 || n > 1 && (self.vm_want == TYPE_NONE || self.decl_type_in(
                cs[i].module,
                cs[i].node,
            ) != self.vm_want) {
                continue;
            }
            if fit.node != NODE_NONE {
                return none;
            }
            fit = cs[i];
        }
        return fit;
    }

    // Type path `id` of the module under check names segments after the one naming its declaration
    // `d` (node NODE_NONE: a builtin's name). Only a struct literal's target (`lit`) may: one segment,
    // an enum's variant (`E::V { .. }`), recorded on the segment. Anything else names no type and is
    // reported; false then.
    fn tc_type_tail(self: &mut Self, id: NodeId, d: DefId, lit: bool) bool {
        let a = self.cur_ast();
        let tp = unsafe (*a).at_const(id).as_data.type_path;
        let h = tp.head;
        let seg = unsafe (*a).list(tp.parts)[(h + 1) as usize];
        let ms = self.name_span(seg);
        let mut hd = DefId { module: 0, node: NODE_NONE };
        let v = self.tc_value_member(
            self.cur_module(),
            d,
            self.name_span(unsafe (*a).list(tp.parts)[h as usize]),
            ms,
            TYPE_NONE,
            &mut hd,
        );
        let start = self.name_span(unsafe (*a).list(tp.parts)[0]).start;
        let prefix = self.name_span(unsafe (*a).list(tp.parts)[h as usize]).end;
        let variant = v.node != NODE_NONE && unsafe (*self.mod_ast(v.module)).at_const(v.node).kind == NodeKind::NODE_VARIANT;
        if variant && lit {
            if tp.parts.len == h + 2 {
                unsafe (*self.cur_ast()).set_resolution_def(seg, v);
                return true;
            }
            let next = self.name_span(unsafe (*a).list(tp.parts)[(h + 2) as usize]);
            if !self.tc_report_once(id) {
                return false;
            }
            self.errors.emit_span(
                next,
                format(
                    "no type '{}' in '{}'",
                    diag::span_str(self.source, next.start, next.end),
                    diag::span_str(self.source, start, ms.end),
                ),
            );
            return false;
        }
        if !self.tc_report_once(id) {
            return false;
        }
        if v.node != NODE_NONE {
            self.errors.emit_span(
                tok::Span { start: start, end: ms.end },
                format(
                    "expected a type, found {} '{}'",
                    pick(variant, "variant", "constant"),
                    diag::span_str(self.source, start, ms.end),
                ),
            );
            return false;
        }
        let en = lit && hd.node != NODE_NONE && unsafe (*self.mod_ast(hd.module)).at_const(hd.node).kind == NodeKind::NODE_ENUM;
        self.errors.emit_span(
            ms,
            format(
                "no {} '{}' {} '{}'",
                pick(en, "variant", "type"),
                diag::span_str(self.source, ms.start, ms.end),
                pick(en, "on", "in"),
                diag::span_str(self.source, start, prefix),
            ),
        );
        return false;
    }

    // Whether node `id` of the module under check has no once-per-node diagnostic yet (`reported`),
    // which it now has. A lowering past the type caches (`tc_alias_steps`) drops its diagnostics, so
    // it reports nothing and leaves the node to its own check.
    fn tc_report_once(self: &mut Self, id: NodeId) bool {
        if self.st_nocache != 0 {
            return false;
        }
        let key = self.cur_module() as u64 << 32 | id as u64;
        if self.reported.contains(&key) {
            return false;
        }
        self.reported.insert(key);
        return true;
    }

    // Generic argument `aid` of module `m`, not a value (`tc_arg_is_const`), for the `i`th type-level
    // generic parameter of `d`, read as a type. A path with segments past its type names no constant a
    // const parameter could take: that is reported (in the module under check) and gives TYPE_ERROR.
    fn tc_arg_type(self: &mut Self, m: ModuleId, aid: NodeId, d: DefId, i: u32) TypeId {
        let a = self.mod_ast(m);
        let an = *unsafe (*a).at_const(aid);
        if an.kind != NodeKind::NODE_TYPE_PATH || an.as_data.type_path.parts.len <= an.as_data.type_path.head + 1 || self.tc_gen_param(
            d,
            i,
        ) == NODE_NONE {
            return self.lower_type_in(m, aid);
        }
        if m == self.cur_module() && self.tc_report_once(aid) {
            let tp = an.as_data.type_path;
            let h = tp.head;
            let ms = self.name_span(unsafe (*a).list(tp.parts)[(h + 1) as usize]);
            let mut hd = DefId { module: 0, node: NODE_NONE };
            let v = self.tc_value_member(
                m,
                unsafe (*a).resolution_def(aid),
                self.name_span(unsafe (*a).list(tp.parts)[h as usize]),
                ms,
                TYPE_NONE,
                &mut hd,
            );
            // `Foo::K::X`: past a constant, the next segment is the one no constant answers to.
            let at = pick(v.node != NODE_NONE, h + 2, h + 1);
            let bad = self.name_span(unsafe (*a).list(tp.parts)[at as usize]);
            let en = v.node == NODE_NONE && hd.node != NODE_NONE && unsafe (*self.mod_ast(hd.module)).at_const(hd.node).kind == NodeKind::NODE_ENUM;
            self.errors.emit_span(
                bad,
                format(
                    "no {} '{}' on '{}'",
                    pick(en, "variant or associated constant", "associated constant"),
                    diag::span_str(self.source, bad.start, bad.end),
                    diag::span_str(
                        self.source,
                        self.name_span(unsafe (*a).list(tp.parts)[0]).start,
                        self.name_span(unsafe (*a).list(tp.parts)[at - 1]).end,
                    ),
                ),
            );
        }
        return TYPE_ERROR;
    }

    // Whether associated constant `c` of type declaration `head` (`tc_value_path`) is a builtin integer
    // type's MIN or MAX: literal-only arithmetic reads it as the literal of its value.
    fn tc_is_int_limit(self: &Self, c: DefId, head: DefId) bool {
        let b = unsafe (*self.package).builtin_of_decl(head.module, head.node);
        if b < 0 || !bt_is_int(b as BuiltinType) || unsafe (*self.mod_ast(c.module)).at_const(c.node).kind != NodeKind::NODE_CONST {
            return false;
        }
        let ns = unsafe (*self.mod_ast(c.module)).at_const(
            unsafe (*self.mod_ast(c.module)).at_const(c.node).as_data.const_def.name,
        ).as_data.name.text;
        let nm = self.mod_src(c.module).slice(ns.start as usize, ns.end as usize);
        return nm == "MIN" || nm == "MAX";
    }

    // Const argument `t` written at `aid` (module `m`) for const parameter `gid` of module `pm`: an
    // enum-typed parameter takes a value of its own enum only, and an integer parameter no enum
    // value. A mismatch is reported (in the module under check) and gives TYPE_ERROR.
    fn tc_const_enum_arg(self: &mut Self, t: TypeId, m: ModuleId, aid: NodeId, pm: ModuleId, gid: NodeId) TypeId {
        if gid == NODE_NONE || t == TYPE_ERROR {
            return t;
        }
        let want = unsafe (*self.package).type_enum(
            pm,
            unsafe (*self.mod_ast(pm)).at_const(gid).as_data.generic_param.const_type,
        );
        let have = self.tc_const_arg_enum(m, aid);
        if want.module == have.module && want.node == have.node {
            // An enum value is its discriminant, an i32 (`tc_arg_bt` left it in its own type).
            return pick(
                want.node == NODE_NONE,
                t,
                self.tc_const_as(t, unsafe (*self.package).const_param_bt(pm, gid), true),
            );
        }
        if m == self.cur_module() {
            let wn = if want.node == NODE_NONE {
                format("{}", bt_name(unsafe (*self.package).const_param_bt(pm, gid)));
            } else {
                self.tc_decl_name(want);
            };
            let hn = if have.node != NODE_NONE {
                self.tc_decl_name(have);
            } else if self.type_at(t).kind == TypeKind::TYPE_CONST {
                // A literal reads as in an expression: an `i32` when its value fits.
                let y = *self.type_at(t);
                let lit = unsafe (*self.mod_ast(m)).at_const(aid).kind == NodeKind::NODE_LITERAL && bt_holds(
                    BuiltinType::BT_I32,
                    y.cval(),
                    false,
                );
                format("{}", bt_name(pick(lit, BuiltinType::BT_I32, y.cbt())));
            } else {
                format("integer");
            };
            self.errors.emit_span(
                unsafe (*self.mod_ast(m)).at_const(aid).span,
                format("mismatched types: expected '{}', found '{}'", wn.as_str(), hn.as_str()),
            );
        }
        return TYPE_ERROR;
    }

    // The declared name of aggregate `d`.
    fn tc_decl_name(self: &Self, d: DefId) String {
        let da = self.mod_ast(d.module);
        let ns = unsafe (*da).at_const(unsafe (*da).at_const(d.node).as_data.aggregate.name).as_data.name.text;
        return String::from_str(self.mod_src(d.module).slice(ns.start as usize, ns.end as usize));
    }

    // Generic argument `t` as the value of a const parameter of integer type `want`: a value of another
    // type retyped (TYPE_NONE when `want` does not hold it), a bare const parameter or a form of another
    // type as a form standing for a `want` value. A written argument (`narrow` false) must have `want`'s
    // type or one that widens to it, as in any expression (TYPE_NONE otherwise); inference binds a
    // parameter through a form (`narrow`), and the instance then checks that its value fits.
    fn tc_const_as(self: &mut Self, t: TypeId, want: BuiltinType, narrow: bool) TypeId {
        if !bt_is_int(want) || t == TYPE_NONE {
            return t;
        }
        let y = *self.type_at(t);
        if y.kind == TypeKind::TYPE_CONST {
            if y.cbt() == want {
                return t;
            }
            let v = y.cval();
            if !bt_holds(want, v, self.tc_ptr32()) {
                return TYPE_NONE;
            }
            return unsafe (*self.cur_ast()).const_value(cval_bits(v), want);
        }
        let mut l = ConstLin::new(BuiltinType::BT_COUNT);
        if y.kind == TypeKind::TYPE_GENERIC {
            let gp = unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl);
            if gp.kind != NodeKind::NODE_GENERIC_PARAM || !gp.as_data.generic_param.is_const {
                return t;
            }
            let have = unsafe (*self.package).const_param_bt(y.module, y.as_data.decl);
            if have == want || !bt_is_int(have) {
                return t;
            }
            l = ConstLin::new(have);
            let _ = l.add_term(DefId { module: y.module, node: y.as_data.decl }, i128::one());
        } else if y.kind == TypeKind::TYPE_CONST_EXPR {
            l = *unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst);
            if l.to == want {
                return t;
            }
        } else {
            return t;
        }
        if !narrow && l.ty != want && !bt_widens(l.ty, want) {
            return TYPE_NONE;
        }
        l.to = want;
        return unsafe (*self.cur_ast()).intern_const_lin(&l);
    }

    // `tc_const_as` for argument `t` written at `aid` of module `m`: a refusal is reported there (in
    // the module under check) and gives TYPE_ERROR.
    fn tc_const_pos(self: &mut Self, t: TypeId, want: BuiltinType, m: ModuleId, aid: NodeId) TypeId {
        let r = self.tc_const_as(t, want, false);
        if r != TYPE_NONE || t == TYPE_NONE {
            return r;
        }
        if m == self.cur_module() {
            let sp = unsafe (*self.cur_ast()).at_const(aid).span;
            let y = *self.type_at(t);
            if y.kind == TypeKind::TYPE_CONST {
                self.errors.emit_span(
                    sp,
                    format("const generic argument {} is out of range for '{}'", y.cval(), bt_name(want)),
                );
            } else {
                let have = if y.kind == TypeKind::TYPE_GENERIC {
                    unsafe (*self.package).const_param_bt(y.module, y.as_data.decl);
                } else {
                    unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst).ty;
                };
                self.errors.emit_span(
                    sp,
                    format("mismatched types: expected '{}', found '{}'", bt_name(want), bt_name(have)),
                );
            }
        }
        return TYPE_ERROR;
    }

    // Fold a const-generic argument expression (e.g. the `4` in `Buff<i32, 4>`) to an interned TYPE_CONST
    // value of integer type `want` (the parameter's; BT_COUNT when unknown: i64, or u64 past it), or to
    // a form over the enclosing generic's parameters standing for one.
    fn tc_const_arg(self: &mut Self, m: ModuleId, aid: NodeId, want: BuiltinType) TypeId {
        self.eng_hold(true);
        let w0 = self.vm_want;
        self.vm_want = pick(bt_is_int(want), Ast::builtin(want), TYPE_NONE);
        let r9 = self.tc_const_arg_i(m, aid, want);
        self.vm_want = w0;
        self.eng_hold(false);
        return r9;
    }

    // A path names associated constant `nm` of a generic type without arguments that choose one of
    // its `n` candidates `cs` (the constants of disjoint extends each define one): reported at `at`
    // with a note at each candidate.
    @c.cold
    fn err_assoc_const_args(self: &mut Self, at: tok::Span, nm: str, cs: &Defs8, n: usize) {
        self.errors.emit_span(
            at,
            format("cannot infer the generic arguments of associated constant '{}'; give explicit type arguments", nm),
        );
        for i in 0..pick(n < cs.len(), n, cs.len()) {
            self.note_decl_site("a candidate is declared here", cs[i]);
        }
    }

    fn tc_const_arg_i(self: &mut Self, m: ModuleId, aid: NodeId, want: BuiltinType) TypeId {
        let ceptr = self.cir();
        self.ev_err = false;
        // An enum VARIANT as the value of an enum-typed const parameter (`{Family::Ieee}`, `Family::Ieee`):
        // its discriminant, computed the way the emitted C computes it: the explicit value when one is
        // written, else the previous discriminant plus one.
        let mut ed = DefId { module: 0, node: NODE_NONE };
        let vp = self.tc_value_path(m, aid, &mut ed);
        let hd = ed;
        let an = unsafe (*self.mod_ast(m)).at_const(aid);
        let mut target = NODE_NONE;
        if vp.node != NODE_NONE && unsafe (*self.mod_ast(vp.module)).at_const(vp.node).kind == NodeKind::NODE_VARIANT {
            target = vp.node;
        } else if vp.node == NODE_NONE && an.kind == NodeKind::NODE_MEMBER && an.as_data.member.path {
            // Member resolution is the type checker's act, and a braced type-position expression is
            // never type-checked: a member of the enum the resolver found that names neither a variant
            // nor a constant is reported here.
            ed = unsafe (*self.mod_ast(m)).resolution_def(an.as_data.member.object);
        } else {
            ed = DefId { module: 0, node: NODE_NONE };
        }
        if ed.node != NODE_NONE && unsafe (*self.mod_ast(ed.module)).at_const(ed.node).kind == NodeKind::NODE_ENUM {
            let ea = self.mod_ast(ed.module);
            let ms = unsafe (*ea).at_const(ed.node).as_data.aggregate.members;
            let mut next: i64 = 0;
            let mut known = true;
            for j in 0..ms.len {
                let mid = unsafe (*ea).list(ms)[j as usize];
                let vv = unsafe (*ea).at_const(mid).as_data.variant.value;
                if vv != NODE_NONE {
                    if ceptr == null {
                        known = false;
                        break;
                    }
                    let ev = self.ev(ed.module, vv);
                    if ev.kind != iri::IV_INT {
                        known = false;
                        break; // the enum's own check reports the discriminant
                    }
                    next = ev.i;
                }
                if mid == target {
                    return self.tc_const_value(m, aid, i128::from_i64(next), want);
                }
                next = next + 1;
            }
            if known {
                if m == self.cur_module() {
                    let vn = unsafe (*self.mod_ast(m)).at_const(an.as_data.member.member).as_data.name.text;
                    let en = self.tc_decl_name(ed);
                    self.errors.emit_span(
                        vn,
                        format(
                            "no variant '{}' on '{}'",
                            self.mod_src(m).slice(vn.start as usize, vn.end as usize),
                            en.as_str(),
                        ),
                    );
                }
                return TYPE_ERROR;
            }
        } else if vp.node == NODE_NONE && hd.node != NODE_NONE && (an.kind == NodeKind::NODE_MEMBER || an.kind == NodeKind::NODE_TYPE_PATH) {
            // `{Foo::Q}`, `{m::Foo::Q}`, `W::K`: a type's member that is no constant, or several
            // constants the path does not choose among.
            if m == self.cur_module() {
                let mut os = an.span;
                let vn = if an.kind == NodeKind::NODE_MEMBER {
                    os = unsafe (*self.mod_ast(m)).at_const(an.as_data.member.object).span;
                    unsafe (*self.mod_ast(m)).at_const(an.as_data.member.member).as_data.name.text;
                } else {
                    let tp = an.as_data.type_path;
                    let hn = unsafe (*self.mod_ast(m)).list(tp.parts)[tp.head as usize];
                    os.end = unsafe (*self.mod_ast(m)).at_const(hn).span.end;
                    unsafe (*self.mod_ast(m)).at_const(unsafe (*self.mod_ast(m)).list(tp.parts)[(tp.head + 1) as usize]).as_data.name.text;
                };
                let nm = self.mod_src(m).slice(vn.start as usize, vn.end as usize);
                let mut cs = Defs8 {};
                let n = self.tc_assoc_consts(m, hd.module, hd.node, nm, &mut cs);
                if n == 0 || an.kind == NodeKind::NODE_MEMBER && unsafe (*self.mod_ast(m)).at_const(
                    an.as_data.member.object,
                ).kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
                    self.errors.emit_span(
                        vn,
                        format(
                            "no associated constant '{}' on '{}'",
                            nm,
                            self.mod_src(m).slice(os.start as usize, os.end as usize),
                        ),
                    );
                } else {
                    self.err_assoc_const_args(vn, nm, &cs, n);
                }
            }
            return TYPE_ERROR;
        }
        // A braced argument is an ordinary expression node, and one in a TYPE position is never checked,
        // so the evaluator has no type to work from and answers only its leaves. Reduce it to canonical
        // form instead: an expression of constants comes out a plain value, and one over the enclosing
        // generic's own parameters (unbound HERE) comes out a form, interned by VALUE so substitution
        // can compose forms later and two spellings of one width are already the same type.
        let mut lin = ConstLin::new(BuiltinType::BT_COUNT);
        if self.tc_lin_top(m, aid, want, &mut lin) {
            if !lin.is_concrete() {
                return self.tc_intern_form(&lin);
            }
            let v = lin.value();
            if bt_is_int(want) && !bt_holds(lin.ty, v, self.tc_ptr32()) {
                return self.tc_const_value(m, aid, v, lin.ty);
            }
            return self.tc_const_value(m, aid, v, want);
        }
        if self.lin_err || self.ev_err || m != self.cur_module() {
            return TYPE_ERROR;
        }
        let sp = unsafe (*self.mod_ast(m)).at_const(aid).span;
        if self.lin_ovf {
            if bt_is_int(want) {
                self.errors.emit_span(sp, format("const generic argument overflows '{}'", bt_name(want)));
            } else {
                self.errors.emit_span(sp, format("const generic argument overflows"));
            }
        } else if ceptr != null && unsafe (*ceptr).trap_get().len() != 0 {
            self.errors.emit_span(
                sp,
                format("const generic argument must be a constant integer: {}", unsafe (*ceptr).trap_detail()),
            );
        } else {
            self.errors.emit_span(sp, format("const generic argument must be a constant integer"));
        }
        return TYPE_ERROR;
    }

    // Const value `v` (written at `aid` of module `m`) as the argument of a const parameter of
    // integer type `want` (BT_COUNT: unknown, the value takes i64, or u64 past it). A value `want`
    // does not hold is an error, reported in the module under check.
    fn tc_const_value(self: &mut Self, m: ModuleId, aid: NodeId, v: i128, want: BuiltinType) TypeId {
        let mut bt = want;
        if !bt_is_int(bt) {
            bt = pick(bt_holds(BuiltinType::BT_I64, v, false), BuiltinType::BT_I64, BuiltinType::BT_U64);
        }
        if !bt_holds(bt, v, self.tc_ptr32()) {
            if m == self.cur_module() {
                self.errors.emit_span(
                    unsafe (*self.mod_ast(m)).at_const(aid).span,
                    format("const generic argument {} is out of range for '{}'", v, bt_name(bt)),
                );
            }
            return TYPE_ERROR;
        }
        return unsafe (*self.cur_ast()).const_value(cval_bits(v), bt);
    }

    // The array type `[elem; lenNode]` of array type node length `lenNode` (module `m`): a count,
    // or a symbolic length (a const generic parameter, or a linear expression over them) that
    // substitution folds. TYPE_ERROR when the length is invalid (reported here once).
    fn tc_array_type(self: &mut Self, m: ModuleId, lenNode: NodeId, elem: TypeId) TypeId {
        self.eng_hold(true);
        let r9 = self.tc_array_type_i(m, lenNode, elem);
        self.eng_hold(false);
        return r9;
    }

    fn tc_array_type_i(self: &mut Self, m: ModuleId, lenNode: NodeId, elem: TypeId) TypeId {
        let ceptr = self.cir();
        if ceptr == null {
            return TYPE_ERROR;
        }
        self.ev_err = false;
        let lv = self.ev(m, lenNode);
        if lv.kind == iri::IV_INT && lv.i >= 0 && lv.i <= 0xFFFFFFFFi64 {
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_ARRAY, as_data: TyAs { arr: TyArr { elem: elem, len: lv.i as u32 } } },
            );
        }
        if lv.kind == iri::IV_NONE {
            let lt = self.tc_sym_len(m, lenNode);
            if self.lin_err {
                return TYPE_ERROR;
            }
            if lt != TYPE_NONE {
                return unsafe (*self.cur_ast()).intern_array(elem, lt);
            }
        }
        // A length that belongs to ANOTHER module is that module's to diagnose, in its own source: this
        // one is only lowering the foreign type to learn its layout, and the module has not been
        // typechecked yet, so a const-valued length (`[u8; CAP]`, `CAP` folding a `sizeof`) has no value
        // to fold TO yet and fails here through no fault of its own. Reporting it against the current
        // module also rendered the foreign span against the wrong source. Every module is typechecked, so
        // a genuinely non-constant length is still reported: once, where it is written.
        if m != self.cur_module() || self.st_nocache != 0 {
            return TYPE_ERROR;
        }
        // Diagnose once per node; a length over a rejected node was reported there.
        let key = m as u64 << 32 | lenNode as u64;
        if self.ev_err || self.reported.contains(&key) {
            return TYPE_ERROR;
        }
        let sp = unsafe (*self.mod_ast(m)).at_const(lenNode).span;
        if unsafe (*ceptr).trap_get().len() != 0 {
            self.reported.insert(key);
            self.errors.emit_span(sp, format("array length cannot be evaluated: {}", unsafe (*ceptr).trap_detail()));
        } else if lv.kind != iri::IV_NONE {
            self.reported.insert(key);
            self.errors.emit_span(sp, format("array length must be a non-negative constant expression"));
        } else if self.tc_len_names_param(m, lenNode, 0) {
            // `N * N`, `N % 2`: no canonical form, so no instance could fold it.
            self.reported.insert(key);
            self.errors.emit_span(sp, format("array length must be a linear expression over const generic parameters"));
        } else if !self.tc_mentions_generic(m, lenNode, 0) {
            self.reported.insert(key);
            self.errors.emit_span(sp, format("array length must be a constant expression"));
        }
        return TYPE_ERROR;
    }

    // The length type of array length `lenNode` over the enclosing generic's const parameters: a
    // parameter's TYPE_GENERIC or its canonical form, which substitution folds per instance.
    // TYPE_NONE when the length is not such a form; `lin_err` then says its typing error was reported.
    fn tc_sym_len(self: &mut Self, m: ModuleId, lenNode: NodeId) TypeId {
        let mut lf = ConstLin::new(BuiltinType::BT_COUNT);
        self.lin_err = false;
        if !self.tc_mentions_generic(m, lenNode, 0) || !self.tc_lin_top(m, lenNode, BuiltinType::BT_COUNT, &mut lf) || lf.is_concrete() {
            return TYPE_NONE;
        }
        let p0 = lf.p[0];
        if lf.k.is_zero() && lf.n == 1 && lf.c[0] == i128::one() && lf.div_of() == i128::one() && unsafe (*self.mod_ast(
            p0.module,
        )).at_const(p0.node).kind == NodeKind::NODE_GENERIC_PARAM {
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_GENERIC, module: p0.module, as_data: TyAs { decl: p0.node } },
            );
        }
        return unsafe (*self.cur_ast()).intern_const_lin(&lf);
    }

    // Does array length expression `id` name a generic parameter outside a `sizeof`/`alignof`?
    fn tc_len_names_param(self: &Self, m: ModuleId, id: NodeId, depth: u32) bool {
        if id == NODE_NONE || depth > 32 {
            return false;
        }
        let a = self.mod_ast(m);
        let n = unsafe (*a).at_const(id);
        if n.kind == NodeKind::NODE_IDENTIFIER || n.kind == NodeKind::NODE_MEMBER && n.as_data.member.path {
            let d = unsafe (*a).resolution_def(id);
            return d.node != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_GENERIC_PARAM;
        }
        if n.kind == NodeKind::NODE_UNARY {
            return self.tc_len_names_param(m, n.as_data.unary.operand, depth + 1);
        }
        if n.kind == NodeKind::NODE_CAST {
            return self.tc_len_names_param(m, n.as_data.cast.expression, depth + 1);
        }
        if n.kind == NodeKind::NODE_BINARY {
            return self.tc_len_names_param(m, n.as_data.binary.left, depth + 1) || self.tc_len_names_param(
                m,
                n.as_data.binary.right,
                depth + 1,
            );
        }
        return false;
    }

    // Does the expression mention a generic parameter or a sizeof/alignof (possibly generic-typed)?
    // Such lengths legitimately fail pre-instantiation and must not be diagnosed.
    fn tc_mentions_generic(self: &Self, m: ModuleId, id: NodeId, depth: u32) bool {
        if id == NODE_NONE || depth > 32 {
            return true;
        }
        let a = self.mod_ast(m);
        let n = unsafe (*a).at_const(id);
        switch n.kind {
            NODE_SIZEOF | NODE_ALIGNOF => {
                return true;
            },
            NODE_IDENTIFIER => {
                let d = unsafe (*a).resolution_def(id);
                return d.node != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_GENERIC_PARAM;
            },
            NODE_MEMBER => {
                if !n.as_data.member.path {
                    return self.tc_mentions_generic(m, n.as_data.member.object, depth + 1);
                }
                let d = unsafe (*a).resolution_def(id);
                return d.node != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_GENERIC_PARAM;
            },
            NODE_UNARY => {
                return self.tc_mentions_generic(m, n.as_data.unary.operand, depth + 1);
            },
            NODE_BINARY => {
                return self.tc_mentions_generic(m, n.as_data.binary.left, depth + 1) || self.tc_mentions_generic(
                    m,
                    n.as_data.binary.right,
                    depth + 1,
                );
            },
            NODE_CAST => {
                return self.tc_mentions_generic(m, n.as_data.cast.expression, depth + 1);
            },
            NODE_CALL => {
                let args = n.as_data.call.args;
                for i in 0..args.len {
                    if self.tc_mentions_generic(m, unsafe (*a).list(args)[i as usize], depth + 1) {
                        return true;
                    }
                }
                return false;
            },
            NODE_LITERAL => {
                return false;
            },
            _ => {},
        };
        // Unknown shapes: assume generic-dependent (stay silent).
        return true;
    }

    /// Lower a type node of module `m` to a TypeId interned in the CURRENT module's pool: the current
    /// module goes through resolve_type's per-node cache, foreign modules through the memoized
    /// Context-free lowering.
    pub fn lower_type_in(self: &mut Self, m: ModuleId, id: NodeId) TypeId {
        if m == self.cur_module() {
            return self.resolve_type(id);
        }
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        let mut t0: u64 = 0;
        if unsafe TS_ON {
            ts_add(TS_LOWER, 1);
            if self.icx.current_fn == NODE_NONE {
                ts_add(TS_LOWER_SIG, 1);
            }
            if unsafe TS_DEPTH == 0 {
                t0 = ts_now();
            }
            unsafe TS_DEPTH += 1;
        }
        let r = self.lower_type_in_f(m, id);
        if unsafe TS_ON {
            unsafe TS_DEPTH -= 1;
            if t0 != 0 {
                ts_add(TS_LOWER_NS, ts_now() - t0);
            }
        }
        return r;
    }

    fn lower_type_in_f(self: &mut Self, m: ModuleId, id: NodeId) TypeId {
        // Memoized foreign lowering with the diagnostics gate. Only generic-instance
        // paths take the memo: they re-lower every argument and probe the instance maps, so a
        // hash probe wins; plain paths/builtins are CHEAPER than the probe itself (measured:
        // an unconditional memo made typechecking 32% slower).
        let hn = unsafe (*self.mod_ast(m)).at_const(id);
        if hn.kind != NodeKind::NODE_TYPE_PATH || hn.as_data.type_path.args.len == 0 {
            return self.lower_foreign_type(m, id);
        }
        let lk = m as u64 << 32 | id as u64;
        switch self.lower_memo.get(&lk) {
            Some(t) => {
                if self.st_nocache == 0 {
                    if unsafe TS_ON {
                        ts_add(TS_LOWER_HIT, 1);
                    }
                    return *t;
                }
            },
            None => {},
        };
        let ne = self.errors.errors.len();
        let r = self.lower_foreign_type(m, id);
        if r != TYPE_ERROR && self.errors.errors.len() == ne {
            self.lower_memo.insert(lk, r);
        }
        return r;
    }
    // The instance of generic aggregate `d` that type path `id` of module `m` names. Lifetime
    // arguments are erased (skipped so the arguments stay index-aligned with the declaration's
    // lifetime-free generic parameters), const arguments fold, a fixed-size array argument is
    // rejected, and the declared defaults fill the rest.
    fn tc_path_instance(self: &mut Self, m: ModuleId, id: NodeId, d: DefId) TypeId {
        if !self.tc_targ_count_ok(m, unsafe (*self.mod_ast(m)).at_const(id).as_data.type_path.args, d, id) {
            return TYPE_ERROR;
        }
        let mut ta = Tys8 {};
        let tn = self.tc_path_args(m, id, d, &mut ta[0]);
        return unsafe (*self.cur_ast()).intern_instance(d.module, d.node, &ta[0], tn);
    }
    // The type generic alias `d` names at type path `id` of module `m`: the alias body with each
    // parameter replaced by its argument. The body lowers with its own parameters as generics, so
    // an alias named inside the body is already expanded when this substitution runs.
    fn tc_alias_instance(self: &mut Self, m: ModuleId, id: NodeId, d: DefId) TypeId {
        if !self.tc_targ_count_ok(m, unsafe (*self.mod_ast(m)).at_const(id).as_data.type_path.args, d, id) {
            return TYPE_ERROR;
        }
        let mut ta = Tys8 {};
        let tn = self.tc_path_args(m, id, d, &mut ta[0]);
        return self.tc_alias_expand(m, id, d, &ta[0], tn);
    }
    // Generic alias `d` named at node `id` without arguments: only its declared defaults apply.
    fn tc_bare_alias(self: &mut Self, id: NodeId, d: DefId) TypeId {
        if !self.tc_targ_count_ok(self.cur_module(), NodeList { start: 0, len: 0 }, d, id) {
            return TYPE_ERROR;
        }
        let mut ta = Tys8 {};
        let mut tn: u8 = 0;
        self.apply_default_args(d.module, d.node, &mut ta[0], &mut tn);
        return self.tc_alias_expand(self.cur_module(), id, d, &ta[0], tn);
    }
    // Generic alias `d` expanded with the `tn` arguments `ta` that node `id` of module `m` spells.
    fn tc_alias_expand(self: &mut Self, m: ModuleId, id: NodeId, d: DefId, ta: *const TypeId, tn: u8) TypeId {
        let body = self.named_type_of(d.module, d.node);
        let mut prm = Defs8 {};
        let mut consts = false;
        for j in 0..tn {
            prm[j as usize] = DefId { module: d.module, node: self.tc_gen_slot(d, j) };
            consts = consts || unsafe (*self.mod_ast(d.module)).at_const(prm[j as usize].node).as_data.generic_param.is_const;
        }
        if consts && (self.st_capture != 0 || m == self.cur_module()) {
            self.tc_alias_use_steps(m, id, d, &prm[0], ta, tn);
        }
        return self.subst_type(body, &prm[0], ta, tn);
    }

    // The const-generic steps alias `d` computes at use `id` of module `m` with its parameters
    // `prm` bound to `ta`: its body's steps composed with the arguments, and each argument that is
    // a form over the user's parameters (the body may only compute with it, and the type it
    // expands to then never holds the argument's own value).
    fn tc_alias_use_steps(
        self: &mut Self,
        m: ModuleId,
        id: NodeId,
        d: DefId,
        prm: *const DefId,
        ta: *const TypeId,
        tn: u8,
    ) {
        let r = self.tc_alias_steps(d);
        let ptr32 = self.tc_ptr32();
        for i in (r >> 32) as usize..((r >> 32) + (r & 0xFFFFFFFFu64)) as usize {
            let st = *self.alias_pool.at(i);
            let mut l = ConstLin::new(st.lin.ty);
            if !lin_subst_form(unsafe &*self.cur_ast(), &st.lin, prm, ta, tn, &mut l, ptr32, 0) {
                // A divided argument scales into no form: the type this use expands to has none
                // either, so the use is refused here.
                if m == self.cur_module() && self.st_capture == 0 {
                    let an = self.tc_decl_name_of(d);
                    self.errors.emit_span(
                        unsafe (*self.cur_ast()).at_const(id).span,
                        format(
                            "const expression {{{}}} of alias '{}' has no linear form for these arguments",
                            self.mod_src(st.module).slice(st.span.start as usize, st.span.end as usize),
                            an.as_str(),
                        ),
                    );
                }
                return;
            }
            // The step computes in its own type whatever its arguments compute in.
            l.ty = st.lin.ty;
            l.to = st.lin.to;
            let mut cs = st;
            cs.lin = l;
            cs.key = id;
            self.tc_step_use(m, id, cs);
        }
        let an = unsafe (*self.mod_ast(m)).at_const(id);
        let args = if an.kind == NodeKind::NODE_TYPE_PATH {
            an.as_data.type_path.args;
        } else if an.kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            an.as_data.specialization.types;
        } else {
            NodeList { start: 0, len: 0 };
        };
        let mut w: u32 = 0;
        for j in 0..tn {
            // The written argument of parameter j, when it is written.
            let mut wn = NODE_NONE;
            while w < args.len && wn == NODE_NONE {
                let c = unsafe (*self.mod_ast(m)).list(args)[w as usize];
                w += 1;
                if unsafe (*self.mod_ast(m)).at_const(c).kind != NodeKind::NODE_LIFETIME {
                    wn = c;
                }
            }
            let y = *self.type_at(unsafe ta[j as usize]);
            if y.kind != TypeKind::TYPE_CONST_EXPR {
                continue;
            }
            let braced = wn != NODE_NONE && unsafe (*self.mod_ast(m)).is_const_expr_arg(wn);
            let at = pick(braced, wn, id);
            let cs = ConstStep {
                lin: *unsafe (*self.cur_ast()).const_lin_at(y.as_data.inst),
                div: i128::zero(),
                key: id,
                owner: NODE_NONE,
                module: m,
                span: paren_span(self.mod_src(m), unsafe (*self.mod_ast(m)).at_const(at).span),
                root: false,
                canon: !braced,
                idx: false,
            };
            self.tc_step_emit(m, cs);
        }
    }

    // Record step `s` composed at use `uid` of module `m`: one between constants is decided here
    // (reported in the module under check), one over parameters is recorded for the use's item.
    fn tc_step_use(self: &mut Self, m: ModuleId, uid: NodeId, s: ConstStep) {
        if !s.lin.is_concrete() {
            self.tc_step_emit(m, s);
            return;
        }
        if s.holds(s.lin.k, self.tc_ptr32()) || m != self.cur_module() || self.st_capture != 0 {
            return;
        }
        let sp = unsafe (*self.cur_ast()).at_const(uid).span;
        if s.canon {
            self.errors.emit_span(
                sp,
                format("const generic argument {} is out of range for '{}'", s.lin.value(), bt_name(s.lin.ty)),
            );
            return;
        }
        let text = self.mod_src(s.module).slice(s.span.start as usize, s.span.end as usize);
        if s.div.is_zero() {
            let bt = pick(bt_holds(s.lin.ty, s.lin.value(), self.tc_ptr32()), s.lin.to, s.lin.ty);
            self.errors.emit_span(sp, format("const expression {{{}}} overflows {}", text, bt_name(bt)));
        } else {
            self.errors.emit_span(
                sp,
                format(
                    "const expression {{{}}} truncates the negative quotient {} / {}: a const-generic division needs a dividend that is not negative or a divisor that divides it",
                    text,
                    s.lin.k,
                    s.div,
                ),
            );
        }
        let sm = unsafe &*self.package;
        self.errors.note(
            format(
                "the alias computes it here\n{}",
                diag::render_site(
                    sm.modules[s.module as usize].source.as_str(),
                    sm.modules[s.module as usize].file.as_str(),
                    s.span.start,
                    s.span.end - s.span.start,
                ).as_str(),
            ),
        );
    }

    // The steps of generic alias `d`'s body over its own parameters (start << 32 | count in
    // `alias_pool`), memoized: the body lowers once more past the type memos with its steps
    // captured and its diagnostics dropped (the alias's own check reports them).
    fn tc_alias_steps(self: &mut Self, d: DefId) u64 {
        let key = d.module as u64 << 32 | d.node as u64;
        switch self.alias_steps.get(&key) {
            Some(v) => {
                return *v;
            },
            None => {},
        };
        self.alias_steps.insert(key, 0); // a cyclic alias meets no steps of its own
        let mark = self.st_cap.len();
        self.st_capture += 1;
        self.st_nocache += 1;
        let held = replace(&mut self.errors, diag::Errors::new());
        let _ = self.lower_type_in(d.module, unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.type_alias.ty);
        self.errors = held;
        self.st_nocache -= 1;
        self.st_capture -= 1;
        let start = self.alias_pool.len();
        for i in mark..self.st_cap.len() {
            self.alias_pool.push(*self.st_cap.at(i));
        }
        self.st_cap.truncate(mark);
        let r = start as u64 << 32 | (self.alias_pool.len() - start) as u64;
        self.alias_steps.insert(key, r);
        return r;
    }

    // The declared name of type alias `d`.
    fn tc_decl_name_of(self: &Self, d: DefId) String {
        let da = self.mod_ast(d.module);
        let ns = unsafe (*da).at_const(unsafe (*da).at_const(d.node).as_data.type_alias.name).as_data.name.text;
        return String::from_str(self.mod_src(d.module).slice(ns.start as usize, ns.end as usize));
    }
    // Whether the type-level arguments `args` (of module `m`) fit generic declaration `d`: more than
    // it declares, or fewer than its parameters without a default, is reported in the module under
    // check (at the first extra argument, or at node `at` for too few) and answers false.
    fn tc_targ_count_ok(self: &mut Self, m: ModuleId, args: NodeList, d: DefId, at: NodeId) bool {
        let a = self.mod_ast(m);
        let mut n: u32 = 0;
        let mut extra = NODE_NONE;
        let mut total: u32 = 0;
        let mut need: u32 = 0;
        while self.tc_gen_slot(d, total) != NODE_NONE {
            if need == total && unsafe (*self.mod_ast(d.module)).at_const(self.tc_gen_slot(d, total)).as_data.generic_param.default_type == NODE_NONE {
                need += 1;
            }
            total += 1;
        }
        for i in 0..args.len {
            let aid = unsafe (*a).list(args)[i as usize];
            if unsafe (*a).at_const(aid).kind == NodeKind::NODE_LIFETIME {
                continue;
            }
            if n == total && extra == NODE_NONE {
                extra = aid;
            }
            n += 1;
        }
        if n <= total && n >= need {
            return true;
        }
        if m != self.cur_module() {
            return false;
        }
        let nm = self.tc_decl_name_of(d);
        let bound = if need == total {
            "";
        } else if n > total {
            "at most ";
        } else {
            "at least ";
        };
        let want = pick(n > total, total, need);
        self.errors.emit_span(
            unsafe (*a).at_const(pick(extra != NODE_NONE, extra, at)).span,
            format(
                "'{}' takes {}{} generic argument{} but {} {} supplied",
                nm.as_str(),
                bound,
                want,
                str::from_cstr(plural(want)),
                n,
                pick(n == 1, "was", "were"),
            ),
        );
        return false;
    }

    // The type arguments type path `id` of module `m` gives generic declaration `d`, into `ta`.
    fn tc_path_args(self: &mut Self, m: ModuleId, id: NodeId, d: DefId, ta: *mut TypeId) u8 {
        let a = self.mod_ast(m);
        let args = unsafe (*a).at_const(id).as_data.type_path.args;
        if args.len > 8 {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("too many generic arguments ({}; the maximum is 8)", args.len));
        }
        let mut tn: u8 = 0;
        let mut i: u32 = 0;
        while i < args.len && tn < 8 {
            let aid = unsafe (*a).list(args)[i as usize];
            i = i + 1;
            if unsafe (*a).at_const(aid).kind == NodeKind::NODE_LIFETIME {
                continue;
            }
            let gid = self.tc_gen_param(d, tn);
            let want = self.tc_gen_bt(d, tn);
            let is_c = self.tc_arg_is_const(m, aid);
            let t = if is_c {
                self.tc_const_arg(m, aid, want);
            } else {
                self.tc_const_pos(self.tc_arg_type(m, aid, d, tn), want, m, aid);
            };
            unsafe ta[tn as usize] = self.tc_const_enum_arg(
                self.tc_arg_kind(t, m, aid, d, tn, is_c),
                m,
                aid,
                d.module,
                gid,
            );
            tn = tn + 1;
        }
        self.apply_default_args(d.module, d.node, ta, &mut tn);
        return tn;
    }

    fn lower_foreign_type(self: &mut Self, m: ModuleId, id: NodeId) TypeId {
        let a = self.mod_ast(m);
        let nk = unsafe (*a).at_const(id).kind;
        if nk == NodeKind::NODE_TYPE_PATH {
            let d = unsafe (*a).resolution_def(id);
            let args = unsafe (*a).at_const(id).as_data.type_path.args;
            let tp = unsafe (*a).at_const(id).as_data.type_path;
            let assoc = self.tc_assoc_path(m, id, d);
            if assoc != TYPE_NONE {
                return assoc;
            }
            if tp.parts.len > tp.head + 1 {
                // Segments past the type: only a literal's variant (`tc_type_tail`, which the module's
                // own check reports).
                let mut hd = DefId { module: 0, node: NODE_NONE };
                let v = self.tc_value_member(
                    m,
                    d,
                    unsafe (*a).at_const(unsafe (*a).list(tp.parts)[tp.head as usize]).as_data.name.text,
                    unsafe (*a).at_const(unsafe (*a).list(tp.parts)[(tp.head + 1) as usize]).as_data.name.text,
                    TYPE_NONE,
                    &mut hd,
                );
                if tp.parts.len != tp.head + 2 || v.node == NODE_NONE || unsafe (*self.mod_ast(v.module)).at_const(
                    v.node,
                ).kind != NodeKind::NODE_VARIANT {
                    return TYPE_ERROR;
                }
            }
            if d.node != NODE_NONE {
                let bb = unsafe (*self.package).builtin_of_decl(d.module, d.node);
                if bb >= 0 {
                    return Ast::builtin(bb as BuiltinType);
                }
                let dnk = unsafe (*self.mod_ast(d.module)).at_const(d.node).kind;
                if args.len == 1 {
                    let a0 = unsafe (*a).list(args)[0];
                    let an = unsafe (*a).at_const(a0);
                    if an.kind == NodeKind::NODE_DYN_TYPE && an.as_data.indirect_type.qualifier == TypeQualifier::TYPE_QUAL_NONE {
                        if d.module == self.ph_box.mid && d.node == self.ph_box.node {
                            return self.lower_type_in(m, a0);
                        }
                    }
                }
                if dnk == NodeKind::NODE_TYPE_ALIAS && unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.type_alias.generics.len > 0 {
                    return self.tc_alias_instance(m, id, d);
                }
                if (dnk == NodeKind::NODE_STRUCT || dnk == NodeKind::NODE_ENUM) && unsafe (*self.mod_ast(d.module)).at_const(
                    d.node,
                ).as_data.aggregate.generics.len > 0 && (args.len > 0 || self.agg_has_default_at(
                    d.module,
                    d.node,
                    args.len,
                )) {
                    return self.tc_path_instance(m, id, d);
                }
                return self.named_type_of(d.module, d.node);
            }
            let parts = unsafe (*a).at_const(id).as_data.type_path.parts;
            let mut b: i32 = -1;
            if parts.len != 0 {
                let p0 = unsafe (*a).list(parts)[0];
                b = bt_of_name(self.mod_src(m), unsafe (*a).at_const(p0).as_data.name.text);
            }
            if b >= 0 {
                return Ast::builtin(b as BuiltinType);
            }
            return TYPE_ERROR;
        }
        if nk == NodeKind::NODE_SLICE_TYPE {
            let it = unsafe (*a).at_const(id).as_data.indirect_type;
            return self.prelude_slice_type(self.lower_type_in(m, it.ty), it.qualifier == TypeQualifier::TYPE_QUAL_MUT);
        }
        if nk == NodeKind::NODE_TUPLE_TYPE {
            let elems = unsafe (*a).at_const(id).as_data.array_literal.elements;
            if elems.len > 4 {
                return TYPE_ERROR;
            }
            let mut targs = Tys8 {};
            for i in 0..elems.len {
                targs[i as usize] = self.lower_type_in(m, unsafe (*a).list(elems)[i as usize]);
            }
            return self.prelude_tuple_type(&targs[0], elems.len);
        }
        if nk == NodeKind::NODE_POINTER_TYPE || nk == NodeKind::NODE_REFERENCE_TYPE {
            let it = unsafe (*a).at_const(id).as_data.indirect_type;
            let mut k = TypeKind::TYPE_REFERENCE;
            if nk == NodeKind::NODE_POINTER_TYPE {
                k = TypeKind::TYPE_POINTER;
            }
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: k, qualifier: it.qualifier as u8, as_data: TyAs { elem: self.lower_type_in(m, it.ty) } },
            );
        }
        if nk == NodeKind::NODE_ARRAY_TYPE {
            let at = unsafe (*a).at_const(id).as_data.array_type;
            return self.tc_array_type(m, at.length, self.lower_type_in(m, at.element));
        }
        if nk == NodeKind::NODE_FUNCTION_TYPE {
            return self.tc_fn_type(m, id);
        }
        if nk == NodeKind::NODE_DYN_TYPE {
            let it = unsafe (*a).at_const(id).as_data.indirect_type;
            let inner = it.ty;
            if unsafe (*a).at_const(inner).kind == NodeKind::NODE_FUNCTION_TYPE {
                return self.tc_intern_dynfn(m, inner, it.qualifier);
            }
            let mut d = DefId { module: 0, node: NODE_NONE };
            if unsafe (*a).at_const(inner).kind == NodeKind::NODE_TYPE_PATH {
                d = unsafe (*a).resolution_def(inner);
            }
            if d.node == NODE_NONE || unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_INTERFACE {
                return TYPE_ERROR;
            }
            let mut na = Tys8 {};
            let nn = self.tc_path_args(m, inner, d, &mut na[0]);
            return unsafe (*self.cur_ast()).intern_dyn(d.module, d.node, &na[0], nn, it.qualifier as u8);
        }
        return TYPE_ERROR;
    }

    fn resolve_type(self: &mut Self, id: NodeId) TypeId {
        return self.resolve_type_at(id, false);
    }

    // The type node `id` spells; `lit`: the node is a struct literal's target, whose path may name
    // an enum's variant after the enum (`tc_type_tail`).
    fn resolve_type_at(self: &mut Self, id: NodeId, lit: bool) TypeId {
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        let cached = unsafe (*self.cur_ast()).type_of(id);
        if cached != TYPE_NONE && self.st_nocache == 0 {
            return cached;
        }
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(id).kind;
        let mut result = TYPE_ERROR;
        switch nk {
            NODE_TYPE_PATH => {
                let parts = unsafe (*a).at_const(id).as_data.type_path.parts;
                let args = unsafe (*a).at_const(id).as_data.type_path.args;
                let tail = parts.len > unsafe (*a).at_const(id).as_data.type_path.head + 1;
                // Box<dyn I> interception.
                let mut i: u32 = 0;
                while i < args.len {
                    let aid = unsafe (*a).list(args)[i as usize];
                    let an = unsafe (*a).at_const(aid);
                    if an.kind != NodeKind::NODE_DYN_TYPE || an.as_data.indirect_type.qualifier != TypeQualifier::TYPE_QUAL_NONE {
                        i = i + 1;
                        continue;
                    }
                    let bh = self.ph_box;
                    let hd = unsafe (*a).resolution_def(id);
                    if args.len == 1 && hd.module == bh.mid && hd.node == bh.node {
                        result = self.resolve_dyn_node(unsafe (*a).list(args)[0], TypeQualifier::TYPE_QUAL_NONE);
                    } else {
                        let sp = unsafe (*a).at_const(id).span;
                        self.errors.emit_span(sp, format("a bare 'dyn' type can only be the generic argument of 'Box'"));
                    }
                    unsafe (*self.cur_ast()).set_type(id, result);
                    return result;
                }
                // The arguments the head's parameters do not type: a value, or a path naming no type
                // that a const parameter reads as a constant (`tc_arg_type`).
                i = 0;
                while i < args.len {
                    let aid = unsafe (*a).list(args)[i as usize];
                    let an = unsafe (*a).at_const(aid);
                    if an.kind != NodeKind::NODE_LIFETIME && !self.tc_arg_is_const(self.cur_module(), aid) && (an.kind != NodeKind::NODE_TYPE_PATH || an.as_data.type_path.parts.len <= an.as_data.type_path.head + 1) {
                        self.resolve_type(aid);
                    }
                    i = i + 1;
                }
                let d = unsafe (*a).resolution_def(id);
                let tbs = unsafe (*a).at_const(id).as_data.type_path.bindings;
                if tbs.len != 0 && Ast::in_body(id) && self.tc_report_once(id) {
                    self.errors.emit_span(
                        unsafe (*a).at_const(unsafe (*a).list(tbs)[0]).span,
                        format("an associated type binding is only allowed in a generic bound"),
                    );
                }
                let assoc = self.tc_assoc_path(self.cur_module(), id, d);
                if assoc != TYPE_NONE {
                    unsafe (*self.cur_ast()).set_type(id, assoc);
                    return assoc;
                }
                if d.node != NODE_NONE {
                    let bb = unsafe (*self.package).builtin_of_decl(d.module, d.node);
                    if bb >= 0 {
                        result = Ast::builtin(bb as BuiltinType);
                    } else {
                        let dnk = unsafe (*self.mod_ast(d.module)).at_const(d.node).kind;
                        let generic_agg = (dnk == NodeKind::NODE_STRUCT || dnk == NodeKind::NODE_ENUM) && unsafe (*self.mod_ast(
                            d.module,
                        )).at_const(d.node).as_data.aggregate.generics.len > 0;
                        // A bare name of the type names the extend's target in its own module;
                        // `Self` does wherever the type is declared.
                        let is_self = parts.len == 1 && span_is(
                            self.source,
                            self.name_span(unsafe (*a).list(parts)[0]),
                            "Self",
                        );
                        let sext = if generic_agg && args.len == 0 && (d.module == self.cur_module() || is_self) {
                            self.self_extend_of(id, d);
                        } else {
                            NODE_NONE;
                        };
                        if dnk == NodeKind::NODE_TYPE_ALIAS && unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.type_alias.generics.len > 0 {
                            result = self.tc_alias_instance(self.cur_module(), id, d);
                        } else if sext != NODE_NONE {
                            let target = unsafe (*a).at_const(sext).as_data.extend_def.target_type;
                            if target != id {
                                result = self.resolve_type(target);
                            } else {
                                result = self.named_type_of(d.module, d.node);
                            }
                        } else if generic_agg && (args.len > 0 || !lit && self.tc_gen_slot(d, 0) != NODE_NONE || self.agg_has_default_at(
                            d.module,
                            d.node,
                            args.len,
                        )) {
                            // A bare name outside a literal's target names no instance: its missing
                            // arguments are reported.
                            result = self.tc_path_instance(self.cur_module(), id, d);
                            if result != TYPE_ERROR {
                                self.tc_inst_bounds(id, result);
                            }
                        } else {
                            result = self.named_type_of(d.module, d.node);
                            if dnk == NodeKind::NODE_INTERFACE && parts.len != 0 && !span_is(
                                self.source,
                                self.name_span(unsafe (*a).list(parts)[0]),
                                "Self",
                            ) {
                                let isp = self.name_span(unsafe (*a).list(parts)[0]);
                                self.errors.emit_span(
                                    isp,
                                    format(
                                        "an interface is not a type; use '&dyn {}', 'Box<dyn {}>', or a generic bound",
                                        diag::span_str(self.source, isp.start, isp.end),
                                        diag::span_str(self.source, isp.start, isp.end),
                                    ),
                                );
                            }
                        }
                    }
                } else if parts.len > 0 {
                    let b = bt_of_name(self.source, self.name_span(unsafe (*a).list(parts)[0]));
                    if b >= 0 {
                        result = Ast::builtin(b as BuiltinType);
                    } else {
                        result = TYPE_ERROR;
                    }
                }
                if tail && result != TYPE_ERROR && !self.tc_type_tail(id, d, lit) {
                    result = TYPE_ERROR;
                }
            },
            NODE_SLICE_TYPE => {
                let it = unsafe (*a).at_const(id).as_data.indirect_type;
                result = self.prelude_slice_type(self.resolve_type(it.ty), it.qualifier == TypeQualifier::TYPE_QUAL_MUT);
            },
            NODE_TUPLE_TYPE => {
                let elems = unsafe (*a).at_const(id).as_data.array_literal.elements;
                if elems.len > 4 {
                    let sp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(sp, format("tuple arity is limited to 4 elements"));
                } else {
                    let mut targs = Tys8 {};
                    for i in 0..elems.len {
                        targs[i as usize] = self.resolve_type(unsafe (*a).list(elems)[i as usize]);
                    }
                    result = self.prelude_tuple_type(&targs[0], elems.len);
                }
            },
            NODE_POINTER_TYPE | NODE_REFERENCE_TYPE => {
                let it = unsafe (*a).at_const(id).as_data.indirect_type;
                let mut k = TypeKind::TYPE_REFERENCE;
                if nk == NodeKind::NODE_POINTER_TYPE {
                    k = TypeKind::TYPE_POINTER;
                }
                result = unsafe (*self.cur_ast()).intern_type(
                    Ty { kind: k, qualifier: it.qualifier as u8, as_data: TyAs { elem: self.resolve_type(it.ty) } },
                );
            },
            NODE_ARRAY_TYPE => {
                let at = unsafe (*a).at_const(id).as_data.array_type;
                self.check_expr(at.length);
                result = self.tc_array_type(self.cur_module(), at.length, self.resolve_type(at.element));
            },
            NODE_FUNCTION_TYPE => {
                result = self.tc_fn_type(self.cur_module(), id);
            },
            NODE_DYN_TYPE => {
                let q = unsafe (*a).at_const(id).as_data.indirect_type.qualifier;
                if q == TypeQualifier::TYPE_QUAL_NONE {
                    let sp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(sp, format("a 'dyn' type must be '&dyn I', '&mut dyn I', or 'Box<dyn I>'"));
                } else {
                    result = self.resolve_dyn_node(id, q);
                }
            },
            _ => {},
        };
        unsafe (*self.cur_ast()).set_type(id, result);
        return result;
    }

    // The function-pointer type `fn(..) ..` node `id` of module `m` spells: a signature, so every
    // spelling of it is one type.
    fn tc_fn_type(self: &mut Self, m: ModuleId, id: NodeId) TypeId {
        let a = self.mod_ast(m);
        let ft = unsafe (*a).at_const(id).as_data.function_type;
        let mut slots = Vector::<TypeId>::with_capacity((ft.returns.len + ft.params.len) as usize);
        for i in 0..ft.returns.len {
            let r0 = unsafe (*self.mod_ast(m)).list(ft.returns)[i as usize];
            let rtn = unsafe (*self.mod_ast(m)).slot_type_node(r0);
            slots.push(self.lower_type_in(m, rtn));
        }
        for i in 0..ft.params.len {
            let pid = unsafe (*self.mod_ast(m)).list(ft.params)[i as usize];
            let pn = unsafe (*self.mod_ast(m)).at_const(pid);
            let mut anchor = pid;
            if pn.kind == NodeKind::NODE_PARAMETER && pn.as_data.parameter.ty != NODE_NONE {
                anchor = pn.as_data.parameter.ty;
            }
            slots.push(self.lower_type_in(m, anchor));
        }
        return unsafe (*self.cur_ast()).intern_fn_sig(slots.as_ptr(), ft.returns.len, ft.params.len, ft.is_move);
    }

    fn tc_intern_dynfn(self: &mut Self, m: ModuleId, sig: NodeId, qual: TypeQualifier) TypeId {
        return unsafe (*self.cur_ast()).intern_dyn_fn(self.lower_type_in(m, sig), qual as u8);
    }

    fn resolve_dyn_node(self: &mut Self, id: NodeId, qual: TypeQualifier) TypeId {
        let a = self.cur_ast();
        let inner = unsafe (*a).at_const(id).as_data.indirect_type.ty;
        let mut result = TYPE_ERROR;
        if unsafe (*a).at_const(inner).kind == NodeKind::NODE_FUNCTION_TYPE {
            let sig = self.resolve_type(inner);
            if qual == TypeQualifier::TYPE_QUAL_MUT {
                let sp = unsafe (*a).at_const(id).span;
                self.errors.emit_span(
                    sp,
                    format("a 'dyn fn' is always called through a shared view; write '&dyn fn(..) ..'"),
                );
            } else {
                result = unsafe (*self.cur_ast()).intern_dyn_fn(sig, qual as u8);
            }
            unsafe (*self.cur_ast()).set_type(id, result);
            return result;
        }
        let mut d = DefId { module: 0, node: NODE_NONE };
        if unsafe (*a).at_const(inner).kind == NodeKind::NODE_TYPE_PATH {
            d = unsafe (*a).resolution_def(inner);
        }
        let sp = unsafe (*a).at_const(id).span;
        if d.node == NODE_NONE || unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_INTERFACE {
            self.errors.emit_span(sp, format("'dyn' requires an interface"));
        } else {
            // `dyn I<T, ..>`: lower the type-path arguments and check the count against the
            // interface's generic parameters (zero args for a plain interface).
            let targs = unsafe (*a).at_const(inner).as_data.type_path.args;
            let ig = unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.interface_def.generics;
            let mut na = Tys8 {};
            let nn = self.tc_path_args(self.cur_module(), inner, d, &mut na[0]);
            if targs.len != ig.len {
                self.errors.emit_span(sp, format("interface expects {} type argument(s), got {}", ig.len, targs.len));
            } else if self.dyn_compatible(d, sp) {
                result = unsafe (*self.cur_ast()).intern_dyn(d.module, d.node, &na[0], nn, qual as u8);
            }
        }
        unsafe (*self.cur_ast()).set_type(id, result);
        return result;
    }

    const fn dyn_method(self: &Self, imod: ModuleId, mnode: NodeId) bool {
        let ia = self.mod_ast(imod);
        let mn = unsafe (*ia).at_const(mnode);
        if mn.kind != NodeKind::NODE_FUNCTION || mn.as_data.function.params.len == 0 {
            return false;
        }
        let p0 = unsafe (*ia).list(mn.as_data.function.params)[0];
        let pnm = unsafe (*ia).at_const(unsafe (*ia).at_const(p0).as_data.parameter.name).as_data.name.text;
        return span_is(self.mod_src(imod), pnm, "self");
    }

    fn tc_mentions_self(self: &Self, imod: ModuleId, tn: NodeId, iface: DefId) bool {
        if tn == NODE_NONE {
            return false;
        }
        let ia = self.mod_ast(imod);
        let n = unsafe (*ia).at_const(tn);
        if n.kind == NodeKind::NODE_TYPE_PATH {
            let d = unsafe (*ia).resolution_def(tn);
            if d.module == iface.module && d.node == iface.node {
                return true;
            }
            let args = n.as_data.type_path.args;
            for i in 0..args.len {
                if self.tc_mentions_self(imod, unsafe (*ia).list(args)[i as usize], iface) {
                    return true;
                }
            }
            return false;
        }
        if n.kind == NodeKind::NODE_POINTER_TYPE || n.kind == NodeKind::NODE_REFERENCE_TYPE || n.kind == NodeKind::NODE_SLICE_TYPE || n.kind == NodeKind::NODE_DYN_TYPE {
            return self.tc_mentions_self(imod, n.as_data.indirect_type.ty, iface);
        }
        if n.kind == NodeKind::NODE_ARRAY_TYPE {
            return self.tc_mentions_self(imod, n.as_data.array_type.element, iface);
        }
        if n.kind == NodeKind::NODE_TUPLE_TYPE {
            let elems = n.as_data.array_literal.elements;
            for i in 0..elems.len {
                if self.tc_mentions_self(imod, unsafe (*ia).list(elems)[i as usize], iface) {
                    return true;
                }
            }
            return false;
        }
        if n.kind == NodeKind::NODE_FUNCTION_TYPE {
            let ft = n.as_data.function_type;
            for i in 0..ft.params.len {
                if self.tc_mentions_self(imod, unsafe (*ia).list(ft.params)[i as usize], iface) {
                    return true;
                }
            }
            for i in 0..ft.returns.len {
                if self.tc_mentions_self(imod, unsafe (*ia).list(ft.returns)[i as usize], iface) {
                    return true;
                }
            }
            return false;
        }
        return false;
    }

    // The parameters of the interface that declares method `md`, called on dyn receiver `dy`, bound to
    // that interface's arguments: the dyn type's own, or the ones the hierarchy gives a
    // superinterface. Appended to `sp`/`sv` from `n`; the new count.
    fn tc_dyn_method_args(self: &mut Self, dy: &Ty, md: DefId, sp: *mut DefId, sv: *mut TypeId, n: i32) i32 {
        let di = *unsafe (*self.cur_ast()).instance(dy.as_data.inst);
        let mi = self.enclosing(md.module, md.node, NodeKind::NODE_INTERFACE);
        let mut it = di;
        if mi != NODE_NONE && (mi != di.decl || md.module != di.module) {
            let mut clo = Tys8 {};
            let nc = self.tc_dyn_supers(
                DefId { module: di.module, node: di.decl },
                &di.args[0],
                di.n,
                TypeQualifier::TYPE_QUAL_NONE as u8,
                &mut clo[0],
                8,
            );
            it.n = 0;
            for k in 1..nc {
                let ki = *unsafe (*self.cur_ast()).instance(self.type_at(clo[k as usize]).as_data.inst);
                if ki.module == md.module && ki.decl == mi {
                    it = ki;
                }
            }
        }
        let d = DefId { module: it.module, node: it.decl };
        let mut ns = n;
        let mut k: u8 = 0;
        while k < it.n && ns < 8 {
            unsafe sp[ns as usize] = DefId { module: it.module, node: self.tc_gen_slot(d, k) };
            unsafe sv[ns as usize] = unsafe it.args[k as usize];
            ns += 1;
            k += 1;
        }
        return ns;
    }

    // Record on each superinterface bound of interface `id` the dyn type of the arguments it gives,
    // over the interface's own parameters: a vtable reads its superinterfaces from them.
    fn tc_record_supers(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let m = self.cur_module();
        let bs = unsafe (*a).at_const(id).as_data.interface_def.bounds;
        for b in 0..bs.len {
            let bid = unsafe (*a).list(bs)[b as usize];
            let bd = unsafe (*a).resolution_def(bid);
            if bd.node == NODE_NONE || unsafe (*self.mod_ast(bd.module)).at_const(bd.node).kind != NodeKind::NODE_INTERFACE {
                continue;
            }
            let mut ba = Tys8 {};
            let bn = self.tc_bound_args(m, bid, bd, TYPE_NONE, &mut ba[0]);
            let dt = unsafe (*a).intern_dyn(bd.module, bd.node, &ba[0], bn as u8, TypeQualifier::TYPE_QUAL_NONE as u8);
            unsafe (*a).set_type(bid, dt);
        }
    }

    // The superinterface closure of `iface` with arguments `args[0..n]` (itself first, breadth first,
    // each interface once) into `out`, each as the dyn type (qualifier `qual`) of the arguments its
    // bound gives it. The count; -1 past `cap` interfaces, -2 when an interface is reached with two
    // different argument lists.
    fn tc_dyn_supers(self: &mut Self, iface: DefId, args: *const TypeId, n: i32, qual: u8, out: *mut TypeId, cap: i32) i32 {
        unsafe out[0] = unsafe (*self.cur_ast()).intern_dyn(iface.module, iface.node, args, n as u8, qual);
        let mut cnt: i32 = 1;
        let mut scan: i32 = 0;
        while scan < cnt {
            let cy = *self.type_at(unsafe out[scan as usize]);
            let ci = *unsafe (*self.cur_ast()).instance(cy.as_data.inst);
            let cur = DefId { module: ci.module, node: ci.decl };
            let mut sp = Defs8 {};
            let mut sv = Tys8 {};
            let mut ns: i32 = 0;
            while ns < ci.n as i32 {
                sp[ns as usize] = DefId { module: cur.module, node: self.tc_gen_slot(cur, ns as u32) };
                sv[ns as usize] = unsafe ci.args[ns as usize];
                ns += 1;
            }
            let ca = self.mod_ast(cur.module);
            let bs = unsafe (*ca).at_const(cur.node).as_data.interface_def.bounds;
            for b in 0..bs.len {
                let bid = unsafe (*ca).list(bs)[b as usize];
                let bd = unsafe (*ca).resolution_def(bid);
                if bd.node == NODE_NONE || unsafe (*self.mod_ast(bd.module)).at_const(bd.node).kind != NodeKind::NODE_INTERFACE {
                    continue;
                }
                let mut ba = Tys8 {};
                let bn = self.tc_bound_args(cur.module, bid, bd, TYPE_NONE, &mut ba[0]);
                for k in 0..bn {
                    ba[k as usize] = self.subst_type(ba[k as usize], &sp[0], &sv[0], ns);
                }
                let st = unsafe (*self.cur_ast()).intern_dyn(bd.module, bd.node, &ba[0], bn as u8, qual);
                let mut dup = false;
                for k in 0..cnt {
                    let ky = *self.type_at(unsafe out[k as usize]);
                    if ky.module == bd.module && unsafe (*self.cur_ast()).dyn_decl_of(&ky) == bd.node {
                        if unsafe out[k as usize] != st {
                            return -2;
                        }
                        dup = true;
                    }
                }
                if !dup {
                    if cnt == cap {
                        return -1;
                    }
                    unsafe out[cnt as usize] = st;
                    cnt += 1;
                }
            }
            scan += 1;
        }
        return cnt;
    }

    // The transitive superinterface closure of `iface` (itself first), deduped; -1 when it holds
    // more than `cap` interfaces. dyn_compatible rejects such an interface, so the closure of every
    // interned dyn type fits.
    fn dyn_super_closure(self: &mut Self, iface: DefId, out: *mut DefId, cap: i32) i32 {
        let mut n: i32 = 0;
        unsafe out[0] = iface;
        n = 1;
        let mut scan: i32 = 0;
        while scan < n {
            let cur = unsafe out[scan as usize];
            let ca = self.mod_ast(cur.module);
            let bs = unsafe (*ca).at_const(cur.node).as_data.interface_def.bounds;
            for b in 0..bs.len {
                let bd = unsafe (*ca).resolution_def(unsafe (*ca).list(bs)[b as usize]);
                if bd.node == NODE_NONE || unsafe (*self.mod_ast(bd.module)).at_const(bd.node).kind != NodeKind::NODE_INTERFACE {
                    continue;
                }
                let mut dup = false;
                for k in 0..n {
                    if unsafe out[k as usize].module == bd.module && unsafe out[k as usize].node == bd.node {
                        dup = true;
                    }
                }
                if !dup {
                    if n == cap {
                        return -1;
                    }
                    unsafe out[n as usize] = bd;
                    n = n + 1;
                }
            }
            scan = scan + 1;
        }
        return n;
    }

    fn dyn_compatible(self: &mut Self, iface: DefId, at: tok::Span) bool {
        let ia = self.mod_ast(iface.module);
        let isrc = self.mod_src(iface.module);
        let idn = unsafe (*ia).at_const(iface.node).as_data.interface_def;
        let mut why: str = "";
        let mut mn = tok::Span { start: 0, end: 0 };
        let mut mnm = iface.module; // the module whose source `mn` indexes
        // Validate the whole superinterface closure: every method of every interface in it is
        // dispatched through the SAME vtable (inherited methods are named fields), so each must
        // be dyn-able and no two may share a name (they would collide as C struct fields).
        // The root's own parameters stand for the `dyn I<..>` arguments; each superinterface takes
        // the arguments its bound gives it.
        let mut ra = Tys8 {};
        let mut rn: i32 = 0;
        while rn < idn.generics.len as i32 && rn < 8 {
            ra[rn as usize] = self.named_type_of(iface.module, unsafe (*ia).list(idn.generics)[rn as usize]);
            rn += 1;
        }
        let mut cty = Tys8 {};
        let nclo = self.tc_dyn_supers(iface, &ra[0], rn, TypeQualifier::TYPE_QUAL_NONE as u8, &mut cty[0], 8);
        let mut clo = Defs8 {};
        if nclo == -1 {
            why = "its superinterface hierarchy has more than 8 interfaces";
        } else if nclo == -2 {
            why = "a superinterface is reached with two different argument lists";
        }
        for k in 0..nclo {
            let ky = *self.type_at(cty[k as usize]);
            clo[k as usize] = DefId { module: ky.module, node: unsafe (*self.cur_ast()).dyn_decl_of(&ky) };
        }
        // A vtable is built per erased type: a superinterface argument naming an interface's `Self`
        // has no type there.
        for k in 1..nclo {
            let ki = *unsafe (*self.cur_ast()).instance(self.type_at(cty[k as usize]).as_data.inst);
            for j in 0..ki.n {
                for c in 0..nclo {
                    if self.tc_ty_names_param(
                        unsafe ki.args[j as usize],
                        clo[c as usize].module,
                        clo[c as usize].node,
                        0,
                    ) {
                        why = "a superinterface argument names 'Self'";
                    }
                }
            }
        }
        let mut ci: i32 = 0;
        while why.len() == 0 && ci < nclo {
            let cd = clo[ci as usize];
            let ca = self.mod_ast(cd.module);
            let cdn = unsafe (*ca).at_const(cd.node).as_data.interface_def;
            for mi in 0..cdn.items.len {
                let mid0 = unsafe (*ca).list(cdn.items)[mi as usize];
                if !self.dyn_method(cd.module, mid0) {
                    continue;
                }
                let nm0 = unsafe (*ca).at_const(unsafe (*ca).at_const(mid0).as_data.function.name).as_data.name.text;
                let mut cj: i32 = 0;
                while why.len() == 0 && cj < ci {
                    let od = clo[cj as usize];
                    let oa = self.mod_ast(od.module);
                    let odn = unsafe (*oa).at_const(od.node).as_data.interface_def;
                    for oi in 0..odn.items.len {
                        let omid = unsafe (*oa).list(odn.items)[oi as usize];
                        if self.dyn_method(od.module, omid) && spans_eq2(
                            self.mod_src(cd.module),
                            nm0,
                            self.mod_src(od.module),
                            unsafe (*oa).at_const(unsafe (*oa).at_const(omid).as_data.function.name).as_data.name.text,
                        ) {
                            why = "two methods in the superinterface hierarchy share a name";
                            mn = nm0;
                            mnm = cd.module;
                        }
                    }
                    cj = cj + 1;
                }
            }
            ci = ci + 1;
        }
        let mut cx: i32 = 0;
        while why.len() == 0 && cx < nclo {
            if !self.dyn_iface_methods_ok(clo[cx as usize], &mut why, &mut mn) {
                mnm = clo[cx as usize].module;
                break;
            }
            cx = cx + 1;
        }
        if why.len() == 0 {
            return true;
        }
        let inm = unsafe (*ia).at_const(idn.name).as_data.name.text;
        self.errors.emit_span(
            at,
            format("interface '{}' is not dyn-compatible: {}", diag::span_str(isrc, inm.start, inm.end), why),
        );
        if mn.end > mn.start {
            self.errors.note(format("offending method: '{}'", diag::span_str(self.mod_src(mnm), mn.start, mn.end)));
        }
        return false;
    }

    // Per-interface dyn-ability of every method; on failure sets `why`/`mn` and returns false.
    fn dyn_iface_methods_ok(self: &mut Self, iface: DefId, why: &mut str, mnp: &mut tok::Span) bool {
        let ia = self.mod_ast(iface.module);
        let idn = unsafe (*ia).at_const(iface.node).as_data.interface_def;
        let mut i: u32 = 0;
        while why.len() == 0 && i < idn.items.len {
            let mid = unsafe (*ia).list(idn.items)[i as usize];
            if self.dyn_method(iface.module, mid) {
                let m = unsafe (*ia).at_const(mid).as_data.function;
                *mnp = unsafe (*ia).at_const(m.name).as_data.name.text;
                let p0 = unsafe (*ia).list(m.params)[0];
                let st = unsafe (*ia).at_const(p0).as_data.parameter.ty;
                let mut sk = NodeKind::NODE_NONE_KIND;
                if st != NODE_NONE {
                    sk = unsafe (*ia).at_const(st).kind;
                }
                if m.generics.len != 0 {
                    *why = "a method has its own generic parameters";
                } else if sk != NodeKind::NODE_REFERENCE_TYPE && sk != NodeKind::NODE_POINTER_TYPE {
                    *why = "a method takes 'Self' by value";
                }
                let mut p: u32 = 1;
                while why.len() == 0 && p < m.params.len {
                    let pid = unsafe (*ia).list(m.params)[p as usize];
                    if self.tc_mentions_self(iface.module, unsafe (*ia).at_const(pid).as_data.parameter.ty, iface) {
                        *why = "a method mentions 'Self' outside the receiver";
                    }
                    p = p + 1;
                }
                let mut r: u32 = 0;
                while why.len() == 0 && r < m.returns.len {
                    let rid = unsafe (*ia).list(m.returns)[r as usize];
                    let tn = unsafe (*ia).slot_type_node(rid);
                    if self.tc_mentions_self(iface.module, tn, iface) {
                        *why = "a method mentions 'Self' outside the receiver";
                    }
                    r = r + 1;
                }
            }
            i = i + 1;
        }
        return why.len() == 0;
    }

    // Append module `m`'s extends to their peeled targets' lists, in item order. `scoped`: `m` is in
    // the extension scope (see `ext_next`).
    fn ext_index_module(self: &mut Self, m: ModuleId, scoped: bool) {
        self.ext_indexed[m as usize] = 1;
        let a = self.mod_ast(m);
        for i in 0..self.ext_count(m) {
            let iid = self.ext_at(m, i);
            let tn = unsafe (*a).at_const(iid).as_data.extend_def.target_type;
            if tn == NODE_NONE {
                continue;
            }
            let tg = self.tc_peel_target(unsafe (*a).resolution_def(tn));
            if tg.node == NODE_NONE {
                continue;
            }
            let key = tg.module as u64 << 32 | tg.node as u64;
            let at = self.ext_hits.len() as u64;
            self.ext_hits.push(ExtHit { m: m, node: iid, next: EXT_END, scoped: scoped });
            switch self.ext_heads.get_mut(&key) {
                Some(v) => {
                    self.ext_hits[(*v & 0xFFFFFFFFu64) as usize].next = at as u32;
                    *v = *v >> 32 << 32 | at;
                },
                None => {
                    self.ext_heads.insert(key, at << 32 | at);
                },
            };
        }
    }

    /// A cursor over the extends whose peeled target is `(tmod, tdecl)`, in the order the dispatch
    /// rules search them: the target's own module first, then every other module of the extension
    /// scope in scope order, each in item order. The index covers the scope on the first call and a
    /// target module outside it on the first lookup that names it.
    fn ext_begin(self: &mut Self, tmod: ModuleId, tdecl: NodeId) ExtCursor {
        if self.ext_indexed.len() == 0 {
            self.ext_indexed.resize_default(self.pkg_count());
            // The extension scope: the current module, then its import closure.
            self.ext_index_module(self.cur_module(), true);
            let closure = unsafe (*self.package).import_closure(self.cur_module());
            for i in 0..closure.len() {
                if self.ext_indexed[closure[i] as usize] == 0 {
                    self.ext_index_module(closure[i], true);
                }
            }
        }
        if self.ext_indexed[tmod as usize] == 0 {
            self.ext_index_module(tmod, false);
        }
        let head = switch self.ext_heads.get(&(tmod as u64 << 32 | tdecl as u64)) {
            Some(v) => (*v >> 32) as u32,
            None => EXT_END,
        };
        return ExtCursor { tmod: tmod, head: head, at: head, pass: 0 };
    }

    /// The next extend of `c` (module + extend node), or NODE_NONE after the last.
    fn ext_next(self: &Self, c: &mut ExtCursor) DefId {
        loop {
            if c.at == EXT_END {
                if c.pass == 1 {
                    return DefId { module: 0, node: NODE_NONE };
                }
                c.pass = 1;
                c.at = c.head;
                continue;
            }
            let h = self.ext_hits[c.at as usize];
            c.at = h.next;
            if c.pass == 0 && h.m == c.tmod || c.pass == 1 && h.m != c.tmod && h.scoped {
                return DefId { module: h.m, node: h.node };
            }
        }
    }

    // Module `m`'s top-level EXTEND items, in item order, from the package index.
    const fn ext_count(self: &Self, m: ModuleId) usize {
        let x = unsafe &(*self.package).idx;
        return (x.mod_exts[m as usize + 1] - x.mod_exts[m as usize]) as usize;
    }
    const fn ext_at(self: &Self, m: ModuleId, i: usize) NodeId {
        let x = unsafe &(*self.package).idx;
        return x.exts[x.mod_exts[m as usize] as usize + i];
    }

    /// The type-identity an extend's target dispatches on (peeling a transparent alias).
    pub fn tc_peel_target(self: &mut Self, tg: DefId) DefId {
        // Only an alias peels: the kind read costs less than the memo probe it saves.
        if tg.node == NODE_NONE || unsafe (*self.mod_ast(tg.module)).at_const(tg.node).kind != NodeKind::NODE_TYPE_ALIAS {
            return tg;
        }
        // Peel is a pure function of frozen decls; the uncached path's named_type_of
        // interning happens on the first peel, so pool order is unchanged.
        let pk = tg.module as u64 << 32 | tg.node as u64;
        switch self.peel_memo.get(&pk) {
            Some(v) => {
                return DefId { module: (*v >> 32) as ModuleId, node: (*v) as NodeId };
            },
            None => {},
        };
        let r = self.tc_peel_target_uncached(tg);
        self.peel_memo.insert(pk, r.module as u64 << 32 | r.node as u64);
        return r;
    }
    fn tc_peel_target_uncached(self: &mut Self, tg: DefId) DefId {
        let dn = *unsafe (*self.mod_ast(tg.module)).at_const(tg.node);
        if dn.kind != NodeKind::NODE_TYPE_ALIAS || dn.as_data.type_alias.ty == NODE_NONE || dn.as_data.type_alias.generics.len != 0 {
            return tg;
        }
        let ty = *self.type_at(self.named_type_of(tg.module, tg.node));
        if ty.kind == TypeKind::TYPE_BUILTIN {
            let bd = unsafe (*self.package).builtin_decl(ty.as_data.builtin);
            if bd != NODE_NONE {
                return DefId { module: unsafe (*self.package).core_module, node: bd };
            }
            return tg;
        }
        if ty.kind == TypeKind::TYPE_STRUCT || ty.kind == TypeKind::TYPE_ENUM {
            return DefId { module: ty.module, node: ty.as_data.decl };
        }
        if ty.kind == TypeKind::TYPE_INSTANCE {
            let it = *unsafe (*self.cur_ast()).instance(ty.as_data.inst);
            return DefId { module: it.module, node: it.decl };
        }
        return tg;
    }

    @c.always_inline
    fn find_member(self: &Self, m: ModuleId, decl: NodeId, name: tok::Span) NodeId {
        return self.find_member_cstr(m, decl, self.source.slice(name.start as usize, name.end as usize));
    }
    // The field or variant of aggregate `decl` (in module `m`) spelled `name`; NODE_NONE when none.
    fn find_member_cstr(self: &Self, m: ModuleId, decl: NodeId, name: str) NodeId {
        let a = self.mod_ast(m);
        let src = self.mod_src(m);
        let d = unsafe (*a).at_const(decl);
        if d.kind != NodeKind::NODE_STRUCT && d.kind != NodeKind::NODE_ENUM {
            return NODE_NONE;
        }
        let members = d.as_data.aggregate.members;
        for i in 0..members.len {
            let mid = unsafe (*a).list(members)[i as usize];
            let mem = unsafe (*a).at_const(mid);
            let mname = pick(mem.kind == NodeKind::NODE_FIELD, mem.as_data.field.name, mem.as_data.variant.name);
            let sp = unsafe (*a).at_const(mname).as_data.name.text;
            if src.slice(sp.start as usize, sp.end as usize) == name {
                return mid;
            }
        }
        return NODE_NONE;
    }

    // The extend whose `Self` a bare reference to generic aggregate `agg` at type node `id` names:
    // the extend that OWNS `id` (a signature is resolved under its own extend's generics, whichever
    // item is being checked when it is first needed), else the extend being checked. NODE_NONE when
    // that extend does not target `agg`.
    fn self_extend_of(self: &Self, id: NodeId, agg: DefId) NodeId {
        let a = self.cur_ast();
        let mut ext = self.current_extend;
        let pk = unsafe &*self.package;
        let it = gitems::owner_of(pk, self.cur_module(), id);
        if it != loader::ITEM_NONE {
            let meta = *pk.idx.items.at(it as usize);
            if unsafe (*a).at_const(meta.node).kind == NodeKind::NODE_EXTEND {
                ext = meta.node;
            } else if meta.owner != loader::ITEM_NONE {
                ext = pk.idx.items.at(meta.owner as usize).node;
            }
        }
        if ext == NODE_NONE || unsafe (*a).at_const(ext).kind != NodeKind::NODE_EXTEND {
            return NODE_NONE;
        }
        let tg = unsafe (*a).resolution_def(unsafe (*a).at_const(ext).as_data.extend_def.target_type);
        if tg.module != agg.module || tg.node != agg.node {
            return NODE_NONE;
        }
        return ext;
    }

    // The item of `kind` (NODE_EXTEND or NODE_INTERFACE) whose item list holds `method`; NODE_NONE when
    // there is none. Memoized: callers re-resolve the same method's owner repeatedly (tc_method_param +
    // tc_method_ret alone scan twice per operator check). Lazy insert through a const-cast, the
    // codebase's established pattern for caches behind &Self.
    pub fn enclosing(self: &Self, m: ModuleId, method: NodeId, kind: NodeKind) NodeId {
        let key = (kind == NodeKind::NODE_INTERFACE) as u64 << 63 | m as u64 << 32 | method as u64;
        switch self.encl_memo.get(&key) {
            Some(v) => {
                return *v;
            },
            _ => {},
        };
        let a = self.mod_ast(m);
        let mut res = unsafe (*a).container_of(method);
        if res != NODE_NONE && unsafe (*a).at_const(res).kind != kind {
            res = NODE_NONE;
        }
        let mself = (self as *const TypeChecker) as *mut TypeChecker;
        unsafe (*mself).encl_memo.insert(key, res);
        return res;
    }

    // Method names codegen can synthesize calls to WITHOUT a type-checked call node (assert/format
    // templates, auto-free, operator/index/for lowering, `?` conversions). Marks on these must stay
    // unconditional: they can be referenced from emitted C that no tc-visible caller explains.
    const fn tc_mark_always_root(self: &Self, d: DefId) bool {
        let a = self.mod_ast(d.module);
        let f = unsafe (*a).at_const(d.node);
        if f.kind != NodeKind::NODE_FUNCTION {
            return true;
        }
        let nm = unsafe (*a).at_const(f.as_data.function.name).as_data.name.text;
        let t = self.mod_src(d.module).slice(nm.start as usize, nm.end as usize);
        let fh: []str = FORMAT_HELPERS;
        let sy: []str = SYNTH_METHODS;
        for k in 0..fh.len() {
            if fh[k] == t {
                return true;
            }
        }
        for k in 0..sy.len() {
            if sy[k] == t {
                return true;
            }
        }
        return false;
    }
    // Route a method-used mark through its calling context. Inside a non-generic method of a plain
    // generic extend (the shape the demand graph prunes) no mark is set: a mark would pair the callee
    // with every instance of its target even when the caller is pruned. Every other context
    // (top-level code, conformance/interface methods, generic methods, @emit_macro targets: all
    // emitted unconditionally) marks directly.
    fn tc_mark_method_used(self: &mut Self, d: DefId) {
        // Recorded before the early return below: the demand this stands for is per (instance, method),
        // and the first mark settles only the instance it was reached through.
        if d.node != NODE_NONE {
            let r = self.mark_recv;
            if r == TYPE_NONE {
                if self.mark_log != null {
                    let lg = unsafe &mut *self.mark_log;
                    lg.kinds.push(1);
                    lg.a.push(d.module as u64 << 32 | d.node as u64);
                } else {
                    unsafe (*self.package).always_methods.insert(d.module as u64 << 32 | d.node as u64);
                }
            } else {
                let cf = self.icx.current_fn;
                unsafe (*self.cur_ast()).method_refs.push(MethodRef { owner: cf, recv: r, callee: d });
            }
        }
        // Marks repeat heavily (memoized lookups re-fire them): once the callee is already used,
        // the mark is a no-op: skip the context classification. Under
        // the parallel frontier the task-local log dedupes; the driver's module-order replay
        // applies the global-visibility version of this same check.
        if self.mark_log != null {
            if (unsafe &*self.mark_log).used.contains(&(d.module as u64 << 32 | d.node as u64)) {
                return;
            }
        } else if unsafe (*self.package).method_used_get(d) {
            return;
        }
        let cf = self.icx.current_fn;
        if cf != NODE_NONE {
            let m = self.cur_module();
            let ext = self.enclosing(m, cf, NodeKind::NODE_EXTEND);
            if ext != NODE_NONE {
                let a = self.mod_ast(m);
                let ed = unsafe (*a).at_const(ext).as_data.extend_def;
                if ed.generics.len != 0 && ed.interface_type == NODE_NONE && ed.target_type != NODE_NONE && unsafe (*a).at_const(
                    cf,
                ).as_data.function.generics.len == 0 && !self.tc_mark_always_root(d) {
                    let tg = self.tc_peel_target(unsafe (*a).resolution_def(ed.target_type));
                    if tg.node != NODE_NONE && self.tc_attr(tg.module, tg.node, AttrKind::ATTR_EMIT_MACRO) == null {
                        return;
                    }
                }
            }
        }
        if self.mark_log != null {
            let lg = unsafe &mut *self.mark_log;
            lg.kinds.push(2);
            lg.a.push(d.module as u64 << 32 | d.node as u64);
            lg.used.insert(d.module as u64 << 32 | d.node as u64);
        } else {
            unsafe (*self.package).mark_method_used(d);
        }
    }

    // Find a method named `name`/`lit` in an extend of (m,decl); marks it used. Searches the type's home
    // module, then the current module + imports.
    fn find_method_impl(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span, lit: str) DefId {
        // Memoized by (target, name content), misses included; a hit re-fires the
        // idempotent mark_method_used exactly as the scan's hit path did. Only span-form queries
        // are memoized: a span slices self.source (stable for the checker's life), while a caller's
        // `lit` may view a stack buffer (e.g. dyn_coerce_alloc) that dies before the next lookup.
        if lit.len() != 0 {
            return self.find_method_scan(m, decl, name, lit);
        }
        let mq = MQKey { m: m, decl: decl, kind: 0, name: self.source.slice(name.start as usize, name.end as usize) };
        switch self.method_memo.get(&mq) {
            Some(v) => {
                let d = DefId { module: (*v >> 32) as ModuleId, node: (*v) as NodeId };
                if d.node != NODE_NONE {
                    self.tc_mark_method_used(d);
                }
                return d;
            },
            None => {},
        };
        let r = self.find_method_scan(m, decl, name, lit);
        self.method_memo.insert(mq, r.module as u64 << 32 | r.node as u64);
        return r;
    }
    fn find_method_scan(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span, lit: str) DefId {
        let mut c = self.ext_begin(m, decl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return e;
            }
            let mm = e.module;
            let a = self.mod_ast(mm);
            let ms = unsafe (*a).at_const(e.node).as_data.extend_def.items;
            for j in 0..ms.len {
                let mid = unsafe (*a).list(ms)[j as usize];
                let mn = unsafe (*a).at_const(mid);
                // Privacy: a method from another module must be `pub` (mirrors find_assoc_const).
                if mn.kind == NodeKind::NODE_FUNCTION && !(mm != self.cur_module() && !mn.as_data.function.is_public()) {
                    let mname = unsafe (*a).at_const(mn.as_data.function.name).as_data.name.text;
                    let hit = if lit.len() != 0 {
                        span_is(self.mod_src(mm), mname, lit);
                    } else {
                        spans_eq2(self.source, name, self.mod_src(mm), mname);
                    };
                    if hit {
                        self.tc_mark_method_used(DefId { module: mm, node: mid });
                        return DefId { module: mm, node: mid };
                    }
                }
            }
        }
    }
    fn find_method(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span) DefId {
        return self.find_method_impl(m, decl, name, "");
    }

    // Every method named `name` on (m, decl) across the extend scopes: the memoized collector
    // behind overload disambiguation. Stores the first `out.len()` matches and returns the match
    // count, capped at `out.len() + 1` (more than fit).
    fn find_method_all(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span, lit: str, out: &mut Defs8) i32 {
        let qname = if lit.len() != 0 {
            lit;
        } else {
            self.source.slice(name.start as usize, name.end as usize);
        };
        let mq = MQKey { m: m, decl: decl, kind: 2, name: qname };
        switch self.method_all_memo.get(&mq) {
            Some(v) => {
                let start = (*v >> 8) as usize;
                let n = (*v & 0xFF) as i32;
                for i in 0..n {
                    if i as usize == out.len() {
                        break;
                    }
                    out[i as usize] = self.method_all_pool[start + i as usize];
                }
                return n;
            },
            None => {},
        };
        let mut nout: i32 = 0;
        let mut c = self.ext_begin(m, decl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                break;
            }
            let mm = e.module;
            let iid = e.node;
            let a = self.mod_ast(mm);
            let ms = unsafe (*a).at_const(iid).as_data.extend_def.items;
            for j in 0..ms.len {
                let mid = unsafe (*a).list(ms)[j as usize];
                let mn = unsafe (*a).at_const(mid);
                if mn.kind != NodeKind::NODE_FUNCTION || mm != self.cur_module() && !mn.as_data.function.is_public() {
                    continue;
                }
                let mname = unsafe (*a).at_const(mn.as_data.function.name).as_data.name.text;
                let hit = if lit.len() != 0 {
                    span_is(self.mod_src(mm), mname, lit);
                } else {
                    spans_eq2(self.source, name, self.mod_src(mm), mname);
                };
                if hit && nout as usize <= out.len() {
                    if nout as usize < out.len() {
                        out[nout as usize] = DefId { module: mm, node: mid };
                    }
                    nout = nout + 1;
                }
            }
        }
        let start = self.method_all_pool.len();
        for i in 0..nout {
            if i as usize == out.len() {
                break;
            }
            self.method_all_pool.push(out[i as usize]);
        }
        if nout != 0 {
            let d = out[0];
            let a = self.mod_ast(d.module);
            let sp = unsafe (*a).at_const(unsafe (*a).at_const(d.node).as_data.function.name).as_data.name.text;
            let stable = self.mod_src(d.module).slice(sp.start as usize, sp.end as usize);
            self.method_all_memo.insert(
                MQKey { m: m, decl: decl, kind: 2, name: stable },
                start as u64 << 8 | nout as u64,
            );
        } else if lit.len() == 0 {
            let key = MQKey {
                m: m,
                decl: decl,
                kind: 2,
                name: self.source.slice(name.start as usize, name.end as usize),
            };
            self.method_all_memo.insert(key, start as u64 << 8);
        }
        return nout;
    }

    // The adaptability class of an unpinned numeric literal argument, negated or not: 1 = integer,
    // 2 = float, 0 = anything else. A base prefix does not pin a literal; only a type suffix does
    // (the rule of `tc_literal_pinned`).
    const fn tc_peek_lit_class(self: &Self, id: NodeId) u8 {
        let a = self.cur_ast();
        let mut lid = id;
        if unsafe (*a).at_const(lid).kind == NodeKind::NODE_UNARY && unsafe (*a).at_const(lid).as_data.unary.op == TokenType::Minus {
            lid = unsafe (*a).at_const(lid).as_data.unary.operand;
        }
        let n = *unsafe (*a).at_const(lid);
        if n.kind != NodeKind::NODE_LITERAL {
            return 0;
        }
        let tt = n.as_data.literal.token_type;
        if tt != TokenType::IntegerLiteral && tt != TokenType::FloatLiteral || self.tc_literal_pinned(lid) {
            return 0;
        }
        if tt == TokenType::FloatLiteral {
            return 2;
        }
        return 1;
    }

    // The unsuffixed literal under a chain of `&`/`&mut` (`&1`, `&&-2`), else NODE_NONE; `depth`
    // counts the references.
    const fn tc_ref_lit(self: &Self, id: NodeId, depth: &mut u32) NodeId {
        let a = self.cur_ast();
        let mut e = id;
        *depth = 0;
        while unsafe (*a).at_const(e).kind == NodeKind::NODE_UNARY && unsafe (*a).at_const(e).as_data.unary.op == TokenType::Ampersand {
            e = unsafe (*a).at_const(e).as_data.unary.operand;
            *depth += 1;
        }
        return pick(*depth != 0 && self.tc_peek_lit_class(e) != 0, e, NODE_NONE);
    }

    // Literal-default evidence: when value `v` is an unsuffixed literal (also under `&`) and the
    // declared type `pty` reaches, through as many references, a generic parameter still unbound in
    // `bound`, the literal's own type becomes that parameter's lower bound. True when it did.
    fn tc_lit_default(self: &mut Self, v: NodeId, pty: TypeId, bound: *const TypeId) bool {
        let mut lit = v;
        let mut rd: u32 = 0;
        if self.tc_peek_lit_class(v) == 0 {
            lit = self.tc_ref_lit(v, &mut rd);
            if lit == NODE_NONE {
                return false;
            }
        }
        let mut pt = pty;
        for _ in 0..rd {
            if pt == TYPE_NONE || self.type_at(pt).kind != TypeKind::TYPE_REFERENCE && self.type_at(pt).kind != TypeKind::TYPE_POINTER {
                return false;
            }
            pt = self.type_at(pt).as_data.elem;
        }
        if pt == TYPE_NONE || self.type_at(pt).kind != TypeKind::TYPE_GENERIC {
            return false;
        }
        let py = *self.type_at(pt);
        let slot = self.icx.sv.slot_of(DefId { module: py.module, node: py.as_data.decl });
        if slot < 0 || unsafe bound[slot as usize] != TYPE_NONE {
            return false;
        }
        self.icx.sv.s_lb(slot as u32, unsafe (*self.cur_ast()).type_of(lit));
        return true;
    }

    // The type of an argument WITHOUT checking it. Overload selection runs before a call's arguments are
    // typed, and checking them here would record their moves and borrows a second time. Answers only for
    // the shapes that need no evaluation (a name, a struct literal, a reference to either) and
    // TYPE_NONE otherwise, which leaves that argument out of the decision.
    fn tc_peek_arg_type(self: &mut Self, id: NodeId) TypeId {
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        let a = self.cur_ast();
        let n = *unsafe (*a).at_const(id);
        if n.kind == NodeKind::NODE_IDENTIFIER {
            let d = unsafe (*a).resolution_def(id);
            if d.node == NODE_NONE {
                return TYPE_NONE;
            }
            return self.decl_type_in(d.module, d.node);
        }
        if n.kind == NodeKind::NODE_STRUCT_INITIALIZER {
            // An open generic struct, generic alias or generic enum has no instance until the literal is
            // checked.
            if self.tc_lit_generic_alias(n.as_data.struct_initializer.ty).node != NODE_NONE || self.tc_bare_generic_variant(
                id,
            ) {
                return TYPE_NONE;
            }
            let st = self.type_of_type_node(n.as_data.struct_initializer.ty);
            return pick(self.tc_open_generic_struct(st), TYPE_NONE, st);
        }
        if n.kind == NodeKind::NODE_UNARY && n.as_data.unary.op == TokenType::Ampersand {
            let inner = self.tc_peek_arg_type(n.as_data.unary.operand);
            if inner == TYPE_NONE {
                return TYPE_NONE;
            }
            return unsafe (*self.cur_ast()).intern_type(
                Ty {
                    kind: TypeKind::TYPE_REFERENCE,
                    qualifier: n.as_data.unary.qualifier as u8,
                    as_data: TyAs { elem: inner },
                },
            );
        }
        return TYPE_NONE;
    }

    // Whether the call's argument pass checks argument `id` with no expected type: every argument but
    // the ones that take their type from the parameter (closures, ranges, array literals, generic
    // functions and generic variants named bare, interface associated calls).
    const fn tc_arg_self_typed(self: &Self, id: NodeId) bool {
        let k = unsafe (*self.cur_ast()).at_const(id).kind;
        return k != NodeKind::NODE_CLOSURE && k != NodeKind::NODE_RANGE && !self.tc_is_iface_assoc_call(id) && !self.tc_wants_param_type(
            id,
        );
    }

    // The method a call of `name` on `recv` (declaration (bmod, bdecl)) resolves to: with several
    // candidates (an interface default of that name among the type's conformances, or more than one
    // method its extends define), the choice over every conformance (`tc_pick_conf_method`, a
    // default's conformance into `conf`, TYPE_ERROR after a failed choice), else the one method whose
    // extend applies.
    fn tc_call_method(
        self: &mut Self,
        recv: TypeId,
        bmod: ModuleId,
        bdecl: NodeId,
        name: tok::Span,
        want: TypeId,
        conf: &mut TypeId,
    ) DefId {
        *conf = TYPE_NONE;
        if self.tc_overloaded(bmod, bdecl, name) {
            return self.tc_pick_conf_method(recv, bmod, bdecl, name, want, true, conf);
        }
        let m = self.find_method(bmod, bdecl, name);
        if self.tc_method_applies(recv, m) {
            return m;
        }
        return self.tc_applicable_method(bmod, bdecl, name, recv);
    }

    // The method named `name` that a call on receiver `recv` (declaration (bmod, bdecl)) runs, among
    // every method an extend that applies to its instance defines and the interface default each
    // applicable conformance without its own inherits, bound to that conformance (`dyn I<args>` into
    // `conf` for a generic interface, else TYPE_NONE). For a `call`, its arguments (`icx.call_args`)
    // choose under the overload score (peeked, then the self-typed ones checked), then the expected
    // result `want`; for a function value, the expected function type `want`. A tie is an error at
    // `name`, and a choice that failed (reported) sets `conf` to TYPE_ERROR. NODE_NONE when no extend
    // gives the name.
    fn tc_pick_conf_method(
        self: &mut Self,
        recv: TypeId,
        bmod: ModuleId,
        bdecl: NodeId,
        name: tok::Span,
        want: TypeId,
        call: bool,
        conf: &mut TypeId,
    ) DefId {
        *conf = TYPE_NONE;
        let rs = self.strip(recv);
        let nm = self.source.slice(name.start as usize, name.end as usize);
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        let mut tgp = Defs8 {};
        let mut sa = Tys8 {};
        let mut sn: i32 = 0;
        let agg = self.aggregate_of(rs, &mut tm, &mut td, &mut tgp, &mut sa, &mut sn);
        // Per candidate: the method, the extend that gives it, and the conformance a default runs under.
        let mut cm = Defs8 {};
        let mut cx = Defs8 {};
        let mut cc = Tys8 {};
        let mut n: usize = 0;
        let mut c = self.ext_begin(bmod, bdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                break;
            }
            let mut ea = Tys8 {};
            let mut eg: i32 = 0;
            if agg {
                eg = self.tc_ext_args(e.module, e.node, &sa[0], sn, &mut ea[0]);
                if eg < 0 {
                    continue;
                }
            }
            let xa = self.mod_ast(e.module);
            let ed = unsafe (*xa).at_const(e.node).as_data.extend_def;
            // Every method of that name the extend defines, else the default its conformance inherits.
            let n0 = n;
            let mut over = false;
            for j in 0..ed.items.len {
                let mid = unsafe (*xa).list(ed.items)[j as usize];
                let mn = unsafe (*xa).at_const(mid);
                if mn.kind != NodeKind::NODE_FUNCTION || e.module != self.cur_module() && !mn.as_data.function.is_public() {
                    continue;
                }
                let mname = unsafe (*xa).at_const(mn.as_data.function.name).as_data.name.text;
                if spans_eq2(self.source, name, self.mod_src(e.module), mname) {
                    if n == TC_MAX_CANDIDATES {
                        over = true;
                        break;
                    }
                    cm[n] = DefId { module: e.module, node: mid };
                    cx[n] = e;
                    cc[n] = TYPE_NONE;
                    n += 1;
                }
            }
            if n == n0 && !over && ed.interface_type != NODE_NONE {
                let iface = unsafe (*xa).resolution_def(ed.interface_type);
                let d = if iface.node == NODE_NONE {
                    DefId { module: 0, node: NODE_NONE };
                } else {
                    self.find_interface_method(iface.module, iface.node, nm, 0);
                };
                // A superinterface's default comes through that interface's own conformance.
                if d.node != NODE_NONE && d.module == iface.module && self.enclosing(
                    d.module,
                    d.node,
                    NodeKind::NODE_INTERFACE,
                ) == iface.node && unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.function.body != NODE_NONE {
                    if n == TC_MAX_CANDIDATES {
                        over = true;
                    } else {
                        cm[n] = d;
                        cx[n] = e;
                        cc[n] = self.tc_ext_conf(e, iface, &ea[0], eg);
                        n += 1;
                    }
                }
            }
            if over {
                self.err_candidate_budget(name, "");
                break;
            }
        }
        if n == 0 {
            return DefId { module: 0, node: NODE_NONE };
        }
        let k = if n == 1 {
            0;
        } else if call {
            self.tc_pick_conf_cand(rs, name, want, &cm, &cx, &cc, n);
        } else {
            self.tc_pick_value_cand(rs, name, want, &cm, &cx, &cc, n);
        };
        if k == TC_MAX_CANDIDATES {
            *conf = TYPE_ERROR;
            return cm[0];
        }
        *conf = cc[k];
        if cc[k] == TYPE_NONE && self.enclosing(cm[k].module, cm[k].node, NodeKind::NODE_INTERFACE) == NODE_NONE {
            self.mark_recv = rs;
            self.mark_n += 1;
            self.tc_mark_method_used(cm[k]);
        }
        return cm[k];
    }

    // The candidate of `tc_pick_conf_method` the call's arguments choose: the one with the best
    // overload score, then among equal ones the only one whose result is `want`. A tie is an error at
    // `name` and answers TC_MAX_CANDIDATES, as does an argument that failed its check; a call no
    // candidate fits answers the first (the argument pass reports it).
    fn tc_pick_conf_cand(
        self: &mut Self,
        recv: TypeId,
        name: tok::Span,
        want: TypeId,
        cm: &Defs8,
        cx: &Defs8,
        cc: &Tys8,
        n: usize,
    ) usize {
        let ca = self.icx.call_args;
        let nargs = ca.len as i32;
        let npeek = pick(ca.len <= 8, ca.len, 8);
        let mut at_ = Tys8 {};
        let mut lc = Lits8 {};
        let mut open: u8 = 0;
        for i in 0..npeek {
            let aid = unsafe (*self.cur_ast()).list(ca)[i as usize];
            at_[i as usize] = self.tc_peek_arg_type(aid);
            let an = unsafe (*self.cur_ast()).at_const(aid);
            if at_[i as usize] == TYPE_NONE && an.kind == NodeKind::NODE_LITERAL && (an.as_data.literal.token_type == TokenType::True || an.as_data.literal.token_type == TokenType::False) {
                at_[i as usize] = Ast::builtin(BuiltinType::BT_BOOL);
            }
            if at_[i as usize] == TYPE_NONE {
                lc[i as usize] = self.tc_peek_lit_class(aid);
                if lc[i as usize] == 0 && self.tc_arg_self_typed(aid) {
                    open = open | 1u8 << i as u8;
                }
            }
        }
        let mut round: u32 = 0;
        loop {
            // The best-scoring candidates, one bit each.
            let mut tied: u32 = 0;
            let mut bs = CandScore {};
            for i in 0..n {
                let c = cm[i];
                let skip = (unsafe (*self.mod_ast(c.module)).at_const(c.node).as_data.function.params.len) as i32 - nargs;
                if skip != 0 && skip != 1 {
                    continue;
                }
                let sc = self.tc_score_candidate(recv, c, cc[i], skip, &at_[0], &lc[0], npeek as i32);
                if !sc.viable {
                    continue;
                }
                if tied == 0 || score_better(&sc, &bs) {
                    tied = 1u32 << i as u32;
                    bs = sc;
                } else if !score_better(&bs, &sc) {
                    tied = tied | 1u32 << i as u32;
                }
            }
            if tied == 0 {
                return 0;
            }
            let first = tied.trailing_zeros();
            if (tied & tied - 1) == 0 {
                return first;
            }
            if round == 0 && open != 0 {
                // The peek left several: check the self-typed arguments, then decide on their types.
                let cta = self.icx.call_targs;
                self.icx.call_args = NodeList { start: 0, len: 0 };
                self.icx.call_targs = NodeList { start: 0, len: 0 };
                let mut bad = false;
                for i in 0..npeek {
                    if (open >> i as u8 & 1) != 0 {
                        let aid = unsafe (*self.cur_ast()).list(ca)[i as usize];
                        let t = self.check_expr_w(aid, TYPE_NONE);
                        bad = bad || t == TYPE_ERROR;
                        at_[i as usize] = pick(t == TYPE_ERROR, TYPE_NONE, t);
                    }
                }
                self.icx.call_args = ca;
                self.icx.call_targs = cta;
                self.icx.args_pre = open;
                open = 0;
                round = 1;
                if bad {
                    // An argument already reported: no ambiguity error on top of it.
                    return TC_MAX_CANDIDATES;
                }
                continue;
            }
            if want != TYPE_NONE {
                let mut fit: u32 = 0;
                for i in 0..n {
                    if (tied >> i as u32 & 1) != 0 && self.tc_method_sig(recv, cm[i], cc[i], -1) == want {
                        fit = fit | 1u32 << i as u32;
                    }
                }
                if fit != 0 && (fit & fit - 1) == 0 {
                    return fit.trailing_zeros();
                }
            }
            let second = (tied & tied - 1).trailing_zeros();
            if self.tc_dup_conf(cx[first], cx[second]) || self.tc_dup_defs(cx[first], cx[second]) {
                return first;
            }
            self.err_tied_cands(recv, name, cm, cx, cc, first, second);
            return TC_MAX_CANDIDATES;
        }
    }

    // The candidate of `tc_pick_conf_method` a function value (`K::tag` without a call) names: the only
    // one whose function type is `want`. Otherwise an error at `name` that answers TC_MAX_CANDIDATES.
    fn tc_pick_value_cand(
        self: &mut Self,
        recv: TypeId,
        name: tok::Span,
        want: TypeId,
        cm: &Defs8,
        cx: &Defs8,
        cc: &Tys8,
        n: usize,
    ) usize {
        let mut fit: u32 = 0;
        for i in 0..n {
            if want != TYPE_NONE && self.tc_method_fn_type(recv, cm[i], cc[i]) == want {
                fit = fit | 1u32 << i as u32;
            }
        }
        if fit != 0 && (fit & fit - 1) == 0 {
            return fit.trailing_zeros();
        }
        let tied = pick(fit == 0, (1u32 << n as u32) - 1, fit);
        let first = tied.trailing_zeros();
        let second = (tied & tied - 1).trailing_zeros();
        if self.tc_dup_conf(cx[first], cx[second]) || self.tc_dup_defs(cx[first], cx[second]) {
            return first;
        }
        self.err_tied_cands(recv, name, cm, cx, cc, first, second);
        return TC_MAX_CANDIDATES;
    }

    // Whether extends `e1` and `e2` declare one conformance twice (`dup_conf_key`): the duplicate
    // conformance error reports it, so a use the two tie in reports nothing more.
    fn tc_dup_conf(self: &Self, e1: DefId, e2: DefId) bool {
        let k1 = dup_conf_key(unsafe &*self.mod_ast(e1.module), e1.node);
        let k2 = dup_conf_key(unsafe &*self.mod_ast(e2.module), e2.node);
        return k1.iface.node != NODE_NONE && k1.iface.module == k2.iface.module && k1.iface.node == k2.iface.node && k1.tgt.module == k2.tgt.module && k1.tgt.node == k2.tgt.node;
    }

    // Method `c` under conformance `conf` as a function value on `recv` (`tc_method_sig`); TYPE_NONE
    // for more than one result or more than eight slots.
    fn tc_method_fn_type(self: &mut Self, recv: TypeId, c: DefId, conf: TypeId) TypeId {
        let f = unsafe (*self.mod_ast(c.module)).at_const(c.node).as_data.function;
        if f.returns.len > 1 || f.returns.len + f.params.len > 8 {
            return TYPE_NONE;
        }
        let mut slots = Tys8 {};
        if f.returns.len == 1 {
            slots[0] = self.tc_method_sig(recv, c, conf, -1);
        }
        for i in 0..f.params.len {
            slots[(f.returns.len + i) as usize] = self.tc_method_sig(recv, c, conf, i as i32);
        }
        return unsafe (*self.cur_ast()).intern_fn_sig(&slots[0], f.returns.len, f.params.len, false);
    }

    // Candidates `first` and `second` of `tc_pick_conf_method` fit a use of `name` on `recv` equally.
    @c.cold
    fn err_tied_cands(
        self: &mut Self,
        recv: TypeId,
        name: tok::Span,
        cm: &Defs8,
        cx: &Defs8,
        cc: &Tys8,
        first: usize,
        second: usize,
    ) {
        if cc[first] != TYPE_NONE && cm[first].node == cm[second].node && cm[first].module == cm[second].module {
            let iface = self.enclosing(cm[first].module, cm[first].node, NodeKind::NODE_INTERFACE);
            let ia = self.mod_ast(cm[first].module);
            let isp = unsafe (*ia).at_const(unsafe (*ia).at_const(iface).as_data.interface_def.name).as_data.name.text;
            let tb = self.type_buf(recv);
            self.errors.emit_span(
                name,
                format(
                    "ambiguous call to '{}': '{}' conforms to '{}' with several arguments that fit",
                    diag::span_str(self.source, name.start, name.end),
                    str::from_cstr(&tb[0]),
                    diag::span_str(self.mod_src(cm[first].module), isp.start, isp.end),
                ),
            );
            if cx[first].node == cm[first].node && cx[first].module == cm[first].module {
                // Through a type parameter's bounds: the candidates are the bounds.
                self.note_conformances(recv, DefId { module: cm[first].module, node: iface });
            } else {
                self.note_decl_site("the first candidate conformance is declared here", cx[first]);
                self.note_decl_site("the second candidate conformance is declared here", cx[second]);
            }
            return;
        }
        // A default is placed at the conformance that inherits it.
        self.err_ambiguous_candidates(
            name,
            "",
            pick(cc[first] == TYPE_NONE && self.tc_is_own(cm[first]), cm[first], cx[first]),
            pick(cc[second] == TYPE_NONE && self.tc_is_own(cm[second]), cm[second], cx[second]),
        );
    }

    // Call `id` whose member callee `callee_id` has a chosen conformance (`dflt_conf`): the interface's
    // parameters as that conformance's arguments, appended to the substitution `sp`/`sv` at `n`, and
    // the call's bound conformance recorded. The new count.
    fn tc_dflt_subst(self: &mut Self, id: NodeId, callee_id: NodeId, sp: &mut Defs8, sv: &mut Tys8, n: i32) i32 {
        let dc = switch self.dflt_conf.get(&unsafe (*self.cur_ast()).at_const(callee_id).as_data.member.member) {
            Some(v) => *v,
            None => TYPE_NONE,
        };
        if dc == TYPE_NONE {
            return n;
        }
        let di = *unsafe (*self.cur_ast()).instance(self.type_at(dc).as_data.inst);
        let iface = DefId { module: di.module, node: di.decl };
        let mut k: u32 = 0;
        let mut ns = n;
        while k < di.n as u32 && ns < 8 {
            let gid = self.tc_gen_slot(iface, k);
            if gid == NODE_NONE {
                break;
            }
            sp[ns as usize] = DefId { module: iface.module, node: gid };
            sv[ns as usize] = unsafe di.args[k as usize];
            ns += 1;
            k += 1;
        }
        unsafe (*self.cur_ast()).set_bound_call(id, dc);
        return ns;
    }

    // Whether path member `id` is the callee of the call under check, turbofished or not.
    fn tc_is_callee(self: &Self, id: NodeId) bool {
        let c = self.icx.callee_node;
        if c == id || c == NODE_NONE {
            return c == id;
        }
        let cn = unsafe (*self.cur_ast()).at_const(c);
        return cn.kind == NodeKind::NODE_GENERIC_SPECIALIZATION && cn.as_data.specialization.expression == id;
    }

    // Whether path member `id` (`X::f`) is qualified by `Self`.
    fn tc_self_path(self: &Self, id: NodeId) bool {
        let a = self.cur_ast();
        let o = unsafe (*a).at_const(id).as_data.member.object;
        return unsafe (*a).at_const(o).kind == NodeKind::NODE_IDENTIFIER && span_is(
            self.source,
            unsafe (*a).at_const(o).as_data.name.text,
            "Self",
        );
    }

    // Whether a call of `name` on (m, decl) has several candidates: an interface default some
    // conformance may inherit, or more than one method its extends define.
    fn tc_overloaded(self: &mut Self, m: ModuleId, decl: NodeId, name: tok::Span) bool {
        if self.find_default_method(m, decl, name).node != NODE_NONE {
            return true;
        }
        let mut cands = Defs8 {};
        return self.find_method_all(m, decl, name, "", &mut cands) > 1;
    }

    // Whether method `d` is declared in an extend (not an interface default).
    fn tc_is_own(self: &Self, d: DefId) bool {
        return self.enclosing(d.module, d.node, NodeKind::NODE_INTERFACE) == NODE_NONE;
    }

    // Conformance extend `e` as `iface`, for the instance whose extend arguments are `ea[0..eg]`, as
    // the dyn type of its interface arguments; TYPE_NONE for an interface without parameters.
    fn tc_ext_conf(self: &mut Self, e: DefId, iface: DefId, ea: *const TypeId, eg: i32) TypeId {
        let ig = unsafe (*self.mod_ast(iface.module)).at_const(iface.node).as_data.interface_def.generics.len;
        if ig == 0 || ig > 8 {
            return TYPE_NONE;
        }
        let xa = self.mod_ast(e.module);
        let ed = unsafe (*xa).at_const(e.node).as_data.extend_def;
        let mut ita = Tys8 {};
        if self.tc_path_args(e.module, ed.interface_type, iface, &mut ita[0]) as u32 < ig {
            return TYPE_NONE;
        }
        let mut sp = Defs8 {};
        for k in 0..eg {
            sp[k as usize] = DefId { module: e.module, node: unsafe (*xa).list(ed.generics)[k as usize] };
        }
        for k in 0..ig {
            ita[k as usize] = self.subst_type(ita[k as usize], &sp[0], ea, eg);
        }
        return unsafe (*self.cur_ast()).intern_dyn(
            iface.module,
            iface.node,
            &ita[0],
            ig as u8,
            TypeQualifier::TYPE_QUAL_NONE as u8,
        );
    }

    // `t` with the interface parameters of conformance `conf` (`dyn I<args>`) read as its arguments;
    // `t` itself for TYPE_NONE.
    fn tc_conf_subst(self: &mut Self, conf: TypeId, t: TypeId) TypeId {
        if conf == TYPE_NONE || t == TYPE_NONE {
            return t;
        }
        let di = *unsafe (*self.cur_ast()).instance(self.type_at(conf).as_data.inst);
        let iface = DefId { module: di.module, node: di.decl };
        let mut sp = Defs8 {};
        let mut sv = Tys8 {};
        let mut k: u32 = 0;
        while k < di.n as u32 && k < 8 {
            sp[k as usize] = DefId { module: iface.module, node: self.tc_gen_slot(iface, k) };
            sv[k as usize] = unsafe di.args[k as usize];
            k += 1;
        }
        return self.subst_type(t, &sp[0], &sv[0], k as i32);
    }

    // Choose among same-named methods by what their PARAMETERS accept, under the documented
    // lexicographic score: viability first, then fewer reference adjustments,
    // then more exact parameter matches. A tie between distinct viable candidates sets `tie` and,
    // under `report`, is an ambiguity error; the caller that can still learn an argument's type
    // passes `report` false and asks again. Source order never breaks a tie.
    fn tc_pick_by_args(
        self: &mut Self,
        m: ModuleId,
        decl: NodeId,
        name: tok::Span,
        lit: str,
        recv: TypeId,
        first: DefId,
        args: *const TypeId,
        lits: *const u8,
        nargs: i32,
        report: bool,
        tie: &mut bool,
    ) DefId {
        let mut cands = Defs8 {};
        let n = self.find_method_all(m, decl, name, lit, &mut cands);
        if n < 2 {
            return first;
        }
        if n as usize > TC_MAX_CANDIDATES {
            self.err_candidate_budget(name, lit);
            return first;
        }
        let mut best = DefId { module: 0, node: NODE_NONE };
        let mut best2 = DefId { module: 0, node: NODE_NONE };
        let mut bs = CandScore {};
        let mut have = false;
        for i in 0..n {
            let c = cands[i as usize];
            if !self.tc_method_applies(recv, c) {
                continue;
            }
            let np = (unsafe (*self.mod_ast(c.module)).at_const(c.node).as_data.function.params.len) as i32;
            // The receiver is a parameter of the declaration but not of the call: whichever of the two
            // arities lines up is the skip, and a candidate matching neither cannot be this call.
            let skip = np - nargs;
            if skip != 0 && skip != 1 {
                continue;
            }
            let sc = self.tc_score_candidate(recv, c, TYPE_NONE, skip, args, lits, nargs);
            if !sc.viable {
                continue;
            }
            if !have || score_better(&sc, &bs) {
                best = c;
                best2 = DefId { module: 0, node: NODE_NONE };
                bs = sc;
                have = true;
            } else if !score_better(&bs, &sc) && (c.module != best.module || c.node != best.node) {
                best2 = c;
            }
        }
        if have && best2.node != NODE_NONE && !self.tc_dup_defs(
            DefId { module: best.module, node: self.enclosing(best.module, best.node, NodeKind::NODE_EXTEND) },
            DefId { module: best2.module, node: self.enclosing(best2.module, best2.node, NodeKind::NODE_EXTEND) },
        ) {
            *tie = true;
            if report {
                self.err_ambiguous_candidates(name, lit, best, best2);
            }
            return first;
        }
        if have && best.node != NODE_NONE {
            self.mark_recv = recv;
            self.mark_n += 1;
            self.tc_mark_method_used(best);
            return best;
        }
        return first;
    }

    // Score one candidate against the peeked argument information: safe
    // conversions, reference adjustments, literal defaults, generic defaults, exact matches. A
    // generic candidate runs a solver probe: its own parameters take evidence from the known
    // arguments and the score is computed against the substituted signature; the probe rolls back.
    // An interface default reads its interface's parameters as the arguments of `conf`
    // (`tc_conf_subst`).
    fn tc_score_candidate(
        self: &mut Self,
        recv: TypeId,
        c: DefId,
        conf: TypeId,
        skip: i32,
        args: *const TypeId,
        lits: *const u8,
        nargs: i32,
    ) CandScore {
        let ca = self.mod_ast(c.module);
        let gens = unsafe (*ca).at_const(c.node).as_data.function.generics;
        let mut sc = CandScore { viable: true };
        // The call's turbofish binds the leading parameters; one longer than the list names none.
        let tas = self.icx.call_targs;
        let nt = self.tc_targ_count(tas);
        if nt > gens.len {
            sc.viable = false;
            return sc;
        }
        // The probed parameters: the candidate's own, then, without a receiver instance (`W::f()` for
        // a generic `W`), its extend's, which the call's evidence binds as well.
        let mut prm = Defs8 {};
        let mut g: i32 = 0;
        while g < 8 && g as u32 < gens.len {
            prm[g as usize] = DefId { module: c.module, node: unsafe (*ca).list(gens)[g as usize] };
            g += 1;
        }
        let ext = self.enclosing(c.module, c.node, NodeKind::NODE_EXTEND);
        if recv == TYPE_NONE && ext != NODE_NONE {
            let eg = unsafe (*ca).at_const(ext).as_data.extend_def.generics;
            let mut k: u32 = 0;
            while g < 8 && k < eg.len {
                prm[g as usize] = DefId { module: c.module, node: unsafe (*ca).list(eg)[k as usize] };
                g += 1;
                k += 1;
            }
        }
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if g > 0 {
            let mark = self.icx.sv.probe_begin();
            for k in 0..g {
                let _ = self.icx.sv.map_param(
                    prm[k as usize],
                    unsafe (*ca).at_const(prm[k as usize].node).as_data.generic_param.is_const,
                );
            }
            let mut k: u32 = 0;
            let mut i: u32 = 0;
            while i < tas.len && k < gens.len && k < 8 {
                let tid = unsafe (*self.cur_ast()).list(tas)[i as usize];
                i += 1;
                if unsafe (*self.cur_ast()).at_const(tid).kind == NodeKind::NODE_LIFETIME {
                    continue;
                }
                let at = self.tc_slot_const(mark.base + k, unsafe (*self.cur_ast()).type_of(tid));
                if at != TYPE_NONE {
                    self.icx.sv.s_explicit(mark.base + k, at);
                }
                k += 1;
            }
            for j in 0..nargs {
                let at = unsafe args[j as usize];
                if at != TYPE_NONE {
                    let pt0 = self.tc_method_sig(recv, c, conf, j + skip);
                    self.tc_infer_ev(pt0, at, true);
                }
            }
            for k in 0..g {
                ga[k as usize] = self.icx.sv.s_resolve(mark.base + k as u32, it_conv_join);
                if ga[k as usize] == TYPE_NONE {
                    // An unresolved parameter: worse than one the call pins.
                    sc.gdef += 1;
                }
                gn += 1;
            }
            self.icx.sv.probe_end(&mark);
        }
        for j in 0..nargs {
            let mut pt = self.tc_method_sig(recv, c, conf, j + skip);
            if gn > 0 && pt != TYPE_NONE {
                pt = self.subst_type(pt, &prm[0], &ga[0], gn);
            }
            self.tc_score_param(&mut sc, pt, unsafe args[j as usize], unsafe lits[j as usize]);
        }
        return sc;
    }

    // One parameter position's score contribution.
    fn tc_score_param(self: &mut Self, sc: &mut CandScore, pt: TypeId, at: TypeId, lc: u8) {
        if pt == TYPE_NONE || self.tc_infer_ty_open(pt) {
            // Unknown parameter side: this position does not constrain the choice.
            return;
        }
        if at != TYPE_NONE {
            if pt == at {
                sc.exact += 1;
                return;
            }
            let p = *self.type_at(pt);
            let v = *self.type_at(at);
            if p.kind == TypeKind::TYPE_REFERENCE && p.as_data.elem == at {
                sc.radj += 1;
                return;
            }
            if v.kind == TypeKind::TYPE_REFERENCE && v.as_data.elem == pt {
                sc.radj += 1;
                return;
            }
            if p.kind == TypeKind::TYPE_REFERENCE && v.kind == TypeKind::TYPE_REFERENCE && p.as_data.elem == v.as_data.elem {
                sc.radj += 1;
                return;
            }
            if it_conv_join(self.cur_ast(), at, pt) {
                sc.conv += 1;
                return;
            }
            sc.viable = false;
            return;
        }
        if lc == 1 {
            // An unsuffixed integer literal: any integer parameter takes it by adaptation; the
            // default type is the exact match, and a float parameter is a defaulted use.
            let p = *self.type_at(pt);
            if p.kind == TypeKind::TYPE_BUILTIN && bt_is_int(p.as_data.builtin) {
                if p.as_data.builtin == BuiltinType::BT_I32 {
                    sc.exact += 1;
                } else {
                    sc.litd += 1;
                }
                return;
            }
            if p.kind == TypeKind::TYPE_BUILTIN && (bt_is_float(p.as_data.builtin) || bt_is_complex(p.as_data.builtin)) {
                sc.litd += 1;
                return;
            }
            sc.viable = false;
            return;
        }
        if lc == 2 {
            let p = *self.type_at(pt);
            if p.kind == TypeKind::TYPE_BUILTIN && (bt_is_float(p.as_data.builtin) || bt_is_complex(p.as_data.builtin)) {
                if p.as_data.builtin == BuiltinType::BT_F32 {
                    sc.exact += 1;
                } else {
                    sc.litd += 1;
                }
                return;
            }
            sc.viable = false;
            return;
        }
        // No information for this argument: neutral.
    }

    // Two candidates with equal best scores: an ambiguity error, never a source-order pick.
    @c.cold
    fn err_ambiguous_candidates(self: &mut Self, name: tok::Span, lit: str, a1: DefId, a2: DefId) {
        let nm = if lit.len() != 0 {
            lit;
        } else {
            self.source.slice(name.start as usize, name.end as usize);
        };
        self.errors.emit_span(name, format("ambiguous call: two candidates for '{}' fit equally well", nm));
        self.note_decl_site("the first candidate is declared here", a1);
        self.note_decl_site("the second candidate is declared here", a2);
        self.errors.note(format("qualify the call or adjust an argument so one candidate is a strictly better fit"));
    }

    // A note `what` followed by the source site of declaration `d` (file:line:col and its line).
    @c.cold
    fn note_decl_site(self: &mut Self, what: str, d: DefId) {
        let sp = self.tc_decl_site(d);
        let site = diag::render_site(
            self.mod_src(d.module),
            unsafe (*self.package).modules[d.module as usize].file.as_str(),
            sp.start,
            sp.end - sp.start,
        );
        self.errors.note(format("{}\n{}", what, site.as_str()));
    }

    // The span a note points at for declaration `d`: its first line, a function's head up to its
    // body and a conformance up to its interface.
    fn tc_decl_site(self: &Self, d: DefId) tok::Span {
        let n = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        let mut sp = n.span;
        if n.kind == NodeKind::NODE_FUNCTION && n.as_data.function.body != NODE_NONE {
            sp.end = unsafe (*self.mod_ast(d.module)).at_const(n.as_data.function.body).span.start;
        } else if n.kind == NodeKind::NODE_EXTEND && n.as_data.extend_def.interface_type != NODE_NONE {
            sp.end = unsafe (*self.mod_ast(d.module)).at_const(n.as_data.extend_def.interface_type).span.end;
        }
        let src = self.mod_src(d.module);
        let mut e = sp.start;
        while e < sp.end && src[e as usize] != b'\n' {
            e += 1;
        }
        while e > sp.start && (src[(e - 1) as usize] <= b' ' || src[(e - 1) as usize] == b'{') {
            e -= 1;
        }
        sp.end = e;
        return sp;
    }

    // Notes at the candidates a use of `self_ty` through interface `iface` could not choose among:
    // a type parameter's declaration (its bounds), else each conformance of the type to `iface`.
    @c.cold
    fn note_conformances(self: &mut Self, self_ty: TypeId, iface: DefId) {
        let y = *self.type_at(self_ty);
        if y.kind == TypeKind::TYPE_GENERIC {
            self.note_decl_site("the bounds are declared here", DefId { module: y.module, node: y.as_data.decl });
            return;
        }
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        if y.kind == TypeKind::TYPE_BUILTIN {
            tm = unsafe (*self.package).core_module;
            td = unsafe (*self.package).builtin_decl(y.as_data.builtin);
        } else if !self.aggregate_decl(self_ty, &mut tm, &mut td) {
            return;
        }
        let mut c = self.ext_begin(tm, td);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return;
            }
            let it = unsafe (*self.mod_ast(e.module)).at_const(e.node).as_data.extend_def.interface_type;
            if it == NODE_NONE {
                continue;
            }
            let d = unsafe (*self.mod_ast(e.module)).resolution_def(it);
            if d.module == iface.module && d.node == iface.node {
                self.note_decl_site("a conformance is declared here", e);
            }
        }
    }

    // The candidates exceed the fixed cap: dropped candidates could have scored better, so the
    // call must be disambiguated by hand.
    @c.cold
    fn err_candidate_budget(self: &mut Self, name: tok::Span, lit: str) {
        let nm = if lit.len() != 0 {
            lit;
        } else {
            self.source.slice(name.start as usize, name.end as usize);
        };
        self.errors.emit_span(
            name,
            format("the candidate limit ({}) for '{}' was exceeded; qualify the call explicitly", TC_MAX_CANDIDATES, nm),
        );
    }

    fn find_method_cstr(self: &mut Self, m: ModuleId, decl: NodeId, lit: str) DefId {
        return self.find_method_impl(m, decl, tok::Span::empty(), lit);
    }

    // The associated constant `name` of `decl` (module `m`) that a path whose qualifying type is
    // `inst` names: the one whose extend applies to that instance (`tc_ext_args`), or, for a generic
    // type named without arguments (`inst` TYPE_NONE), the only one, else the one whose type is
    // `want`. NODE_NONE when none does; `amb` is set when several remain, and with NODE_NONE when the
    // candidates exceed the budget (reported).
    fn find_assoc_const(
        self: &mut Self,
        m: ModuleId,
        decl: NodeId,
        name: tok::Span,
        inst: TypeId,
        want: TypeId,
        amb: &mut bool,
    ) DefId {
        *amb = false;
        let mut cs = Defs8 {};
        let n = self.tc_assoc_consts(
            self.cur_module(),
            m,
            decl,
            self.source.slice(name.start as usize, name.end as usize),
            &mut cs,
        );
        if n > cs.len() {
            // Dropped candidates could be the ones that apply.
            self.err_candidate_budget(name, "");
            *amb = true;
            return DefId { module: 0, node: NODE_NONE };
        }
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if inst != TYPE_NONE && self.aggregate_of(inst, &mut tm, &mut td, &mut gp, &mut ga, &mut gn) {
            for i in 0..n {
                let ext = self.enclosing(cs[i].module, cs[i].node, NodeKind::NODE_EXTEND);
                let mut ea = Tys8 {};
                if self.tc_ext_args(cs[i].module, ext, &ga[0], gn, &mut ea[0]) >= 0 {
                    return cs[i];
                }
            }
            return DefId { module: 0, node: NODE_NONE };
        }
        let mut fit: u32 = 0;
        for i in 0..n {
            if want != TYPE_NONE && self.decl_type_in(cs[i].module, cs[i].node) == want {
                fit = fit | 1u32 << i as u32;
            }
        }
        if n > 1 && fit != 0 && (fit & fit - 1) == 0 {
            return cs[fit.trailing_zeros()];
        }
        // Several apply only when they define the constant twice, which `check_dup_items` reports.
        let x0 = DefId { module: cs[0].module, node: self.enclosing(cs[0].module, cs[0].node, NodeKind::NODE_EXTEND) };
        for i in 1..n {
            let xi = DefId {
                module: cs[i].module,
                node: self.enclosing(cs[i].module, cs[i].node, NodeKind::NODE_EXTEND),
            };
            if !self.tc_dup_defs(x0, xi) {
                *amb = true;
            }
        }
        return cs[0];
    }

    // Every associated constant `name` of `decl` (module `m`) that code of module `wm` can see, in
    // extend search order, into `out` (the first of them that fit): their count, capped at one more
    // than `out` holds.
    fn tc_assoc_consts(self: &mut Self, wm: ModuleId, m: ModuleId, decl: NodeId, name: str, out: &mut Defs8) usize {
        let mut n: usize = 0;
        let mut c = self.ext_begin(m, decl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE || n > out.len() {
                return n;
            }
            let sm = e.module;
            let a = self.mod_ast(sm);
            let ms = unsafe (*a).at_const(e.node).as_data.extend_def.items;
            for j in 0..ms.len {
                let cid = unsafe (*a).list(ms)[j as usize];
                let cn = unsafe (*a).at_const(cid);
                if cn.kind != NodeKind::NODE_CONST || sm != wm && !cn.as_data.const_def.is_public {
                    continue;
                }
                let cs = unsafe (*a).at_const(cn.as_data.const_def.name).as_data.name.text;
                if n <= out.len() && self.mod_src(sm).slice(cs.start as usize, cs.end as usize) == name {
                    if n < out.len() {
                        out[n] = DefId { module: sm, node: cid };
                    }
                    n += 1;
                }
            }
        }
    }

    fn find_extend_as(self: &mut Self, tmod: ModuleId, tdecl: NodeId, iface: DefId, imod: *mut ModuleId) NodeId {
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return NODE_NONE;
            }
            let a = self.mod_ast(e.module);
            let it = unsafe (*a).at_const(e.node);
            if it.as_data.extend_def.interface_type != NODE_NONE {
                let tr = unsafe (*a).resolution_def(it.as_data.extend_def.interface_type);
                if tr.module == iface.module && tr.node == iface.node {
                    unsafe *imod = e.module;
                    return e.node;
                }
            }
        }
    }

    // The first extend conforming (tmod, tdecl) to `iface` that applies to the instance whose
    // arguments are `ta[0..tn]` (`tc_ext_args`), with its module in `imod`, its own arguments in `ea`
    // and their count in `en`; NODE_NONE when none does.
    fn tc_conform_ext(
        self: &mut Self,
        tmod: ModuleId,
        tdecl: NodeId,
        iface: DefId,
        ta: *const TypeId,
        tn: i32,
        imod: &mut ModuleId,
        ea: &mut Tys8,
        en: &mut i32,
    ) NodeId {
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return NODE_NONE;
            }
            let a = self.mod_ast(e.module);
            let it = unsafe (*a).at_const(e.node);
            if it.as_data.extend_def.interface_type == NODE_NONE {
                continue;
            }
            let tr = unsafe (*a).resolution_def(it.as_data.extend_def.interface_type);
            if tr.module != iface.module || tr.node != iface.node {
                continue;
            }
            let g = self.tc_ext_args(e.module, e.node, ta, tn, &mut ea[0]);
            if g >= 0 {
                *imod = e.module;
                *en = g;
                return e.node;
            }
        }
    }

    // `tc_conform_ext` restricted to a conformance whose interface arguments, read for `self_ty`, are
    // `wa[0..wn]` (`tc_conf_args_match`); any conformance when `wn` is zero.
    fn tc_conform_ext_args(
        self: &mut Self,
        tmod: ModuleId,
        tdecl: NodeId,
        iface: DefId,
        ta: *const TypeId,
        tn: i32,
        self_ty: TypeId,
        wa: *const TypeId,
        wn: i32,
        imod: &mut ModuleId,
        ea: &mut Tys8,
        en: &mut i32,
    ) NodeId {
        if wn == 0 {
            return self.tc_conform_ext(tmod, tdecl, iface, ta, tn, imod, ea, en);
        }
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return NODE_NONE;
            }
            let a = self.mod_ast(e.module);
            let itn = unsafe (*a).at_const(e.node).as_data.extend_def.interface_type;
            if itn == NODE_NONE {
                continue;
            }
            let tr = unsafe (*a).resolution_def(itn);
            if tr.module != iface.module || tr.node != iface.node {
                continue;
            }
            let g = self.tc_ext_args(e.module, e.node, ta, tn, &mut ea[0]);
            if g >= 0 && self.tc_conf_args_match(e.module, e.node, iface, ea, g, self_ty, wa, wn) {
                *imod = e.module;
                *en = g;
                return e.node;
            }
        }
    }

    fn find_interface_method(self: &Self, m: ModuleId, iface: NodeId, name: str, depth: i32) DefId {
        if depth > 8 {
            return DefId { module: 0, node: NODE_NONE };
        }
        let a = self.mod_ast(m);
        let tn = unsafe (*a).at_const(iface);
        if tn.kind != NodeKind::NODE_INTERFACE {
            return DefId { module: 0, node: NODE_NONE };
        }
        let items = tn.as_data.interface_def.items;
        for i in 0..items.len {
            let mid = unsafe (*a).list(items)[i as usize];
            let mn = unsafe (*a).at_const(mid);
            let nt = unsafe (*a).at_const(mn.as_data.function.name).as_data.name.text;
            if mn.kind == NodeKind::NODE_FUNCTION && self.mod_src(m).slice(nt.start as usize, nt.end as usize) == name {
                return DefId { module: m, node: mid };
            }
        }
        let bounds = tn.as_data.interface_def.bounds;
        for i in 0..bounds.len {
            let bid = unsafe (*a).list(bounds)[i as usize];
            let sb = unsafe (*a).resolution_def(bid);
            if sb.node != NODE_NONE {
                let r = self.find_interface_method(sb.module, sb.node, name, depth + 1);
                if r.node != NODE_NONE {
                    return r;
                }
            }
        }
        return DefId { module: 0, node: NODE_NONE };
    }

    // Whether receiver `recv` (of declaration (tmod, tdecl)) inherits interface default method `dm`
    // through a conformance whose extend applies to its instance (`tc_ext_args`).
    fn tc_default_applies(self: &mut Self, recv: TypeId, tmod: ModuleId, tdecl: NodeId, dm: DefId) bool {
        let mut gm: ModuleId = 0;
        let mut gd = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(recv), &mut gm, &mut gd, &mut gp, &mut ga, &mut gn) {
            return true;
        }
        let da = self.mod_ast(dm.module);
        let nsp = unsafe (*da).at_const(unsafe (*da).at_const(dm.node).as_data.function.name).as_data.name.text;
        let mname = self.mod_src(dm.module).slice(nsp.start as usize, nsp.end as usize);
        let mut ea = Tys8 {};
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return false;
            }
            let it = unsafe (*self.mod_ast(e.module)).at_const(e.node);
            if it.as_data.extend_def.interface_type == NODE_NONE {
                continue;
            }
            let iff = unsafe (*self.mod_ast(e.module)).resolution_def(it.as_data.extend_def.interface_type);
            if iff.node == NODE_NONE {
                continue;
            }
            let mth = self.find_interface_method(iff.module, iff.node, mname, 0);
            if mth.module == dm.module && mth.node == dm.node && self.tc_ext_args(
                e.module,
                e.node,
                &ga[0],
                gn,
                &mut ea[0],
            ) >= 0 {
                return true;
            }
        }
    }

    fn find_default_method(self: &mut Self, tmod: ModuleId, tdecl: NodeId, name: tok::Span) DefId {
        return self.find_default_method_cstr(tmod, tdecl, self.source.slice(name.start as usize, name.end as usize));
    }
    // The interface DEFAULT method named `mname` that a conformance of `tdecl` inherits, found through
    // the interface and its superinterfaces. Kind 2 of the method memo: find_interface_method reads only
    // frozen interface bodies.
    fn find_default_method_cstr(self: &mut Self, tmod: ModuleId, tdecl: NodeId, mname: str<'a>) DefId {
        let mq = MQKey { m: tmod, decl: tdecl, kind: 2, name: mname };
        switch self.method_memo.get(&mq) {
            Some(v) => {
                return DefId { module: (*v >> 32) as ModuleId, node: (*v) as NodeId };
            },
            None => {},
        };
        let mut r = DefId { module: 0, node: NODE_NONE };
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                break;
            }
            let a = self.mod_ast(e.module);
            let it = unsafe (*a).at_const(e.node);
            if it.as_data.extend_def.interface_type == NODE_NONE {
                continue;
            }
            let iff = unsafe (*a).resolution_def(it.as_data.extend_def.interface_type);
            if iff.node != NODE_NONE {
                let mth = self.find_interface_method(iff.module, iff.node, mname, 0);
                if mth.node != NODE_NONE && unsafe (*self.mod_ast(mth.module)).at_const(mth.node).as_data.function.body != NODE_NONE {
                    r = mth;
                    break;
                }
            }
        }
        self.method_memo.insert(mq, r.module as u64 << 32 | r.node as u64);
        return r;
    }

    // Append every interface bound of `bounds` (module `m`) to `out`, with its arguments: declared
    // defaults filled in and the interface's `Self` (`Rhs = Self`) read as `self_ty`, the bounded type.
    fn add_bound_ifaces_full(
        self: &mut Self,
        m: ModuleId,
        bounds: NodeList,
        self_ty: TypeId,
        out: *mut BoundIface,
        n: &mut i32,
        cap: i32,
    ) {
        let a = self.mod_ast(m);
        let mut i: u32 = 0;
        while i < bounds.len && *n < cap {
            let bid = unsafe (*a).list(bounds)[i as usize];
            let d = unsafe (*a).resolution_def(bid);
            if d.node != NODE_NONE {
                let mut b = BoundIface { iface: d, n: 0 };
                b.n = self.tc_bound_args(m, bid, d, self_ty, &mut b.args[0]) as u8;
                let idx = *n;
                unsafe out[idx as usize] = b;
                *n = idx + 1;
            }
            i = i + 1;
        }
    }

    // The arguments bound node `bid` (module `m`) gives interface `iface`, into `out`: declared
    // defaults filled in, `Self` read as `self_ty` (kept when TYPE_NONE). Zero for an interface
    // without parameters or a bound that is not a type path.
    fn tc_bound_args(self: &mut Self, m: ModuleId, bid: NodeId, iface: DefId, self_ty: TypeId, out: *mut TypeId) i32 {
        let a = self.mod_ast(m);
        if unsafe (*a).at_const(bid).kind != NodeKind::NODE_TYPE_PATH {
            return 0;
        }
        let ia = self.mod_ast(iface.module);
        let dn = unsafe (*ia).at_const(iface.node);
        if dn.kind != NodeKind::NODE_INTERFACE || dn.as_data.interface_def.generics.len == 0 {
            return 0;
        }
        let n = self.tc_path_args(m, bid, iface, out) as i32;
        if self_ty != TYPE_NONE {
            for k in 0..n {
                unsafe out[k as usize] = self.subst_type(unsafe out[k as usize], &iface, &self_ty, 1);
            }
        }
        return n;
    }

    // The interface bounds known for generic parameter `pdecl` of module `pmod` (its own list and each
    // `where` predicate on it that holds here), with their arguments (`add_bound_ifaces_full`). An
    // interface's `Self` is bounded by the interface itself, its own parameters as the arguments.
    fn collect_param_bounds_full(self: &mut Self, pmod: ModuleId, pdecl: NodeId, out: *mut BoundIface, cap: i32) i32 {
        let pa = self.mod_ast(pmod);
        let pk = unsafe (*pa).at_const(pdecl).kind;
        let self_ty = self.named_type_of(pmod, pdecl);
        if pk == NodeKind::NODE_INTERFACE {
            if cap == 0 {
                return 0;
            }
            let d = DefId { module: pmod, node: pdecl };
            let mut b = BoundIface { iface: d, n: 0 };
            loop {
                let gid = self.tc_gen_slot(d, b.n);
                if gid == NODE_NONE || b.n >= 8 {
                    break;
                }
                unsafe b.args[b.n as usize] = self.named_type_of(pmod, gid);
                b.n += 1;
            }
            unsafe out[0] = b;
            return 1;
        }
        if pk != NodeKind::NODE_GENERIC_PARAM {
            return 0;
        }
        let mut n: i32 = 0;
        self.add_bound_ifaces_full(
            pmod,
            unsafe (*pa).at_const(pdecl).as_data.generic_param.bounds,
            self_ty,
            out,
            &mut n,
            cap,
        );
        let at = if pmod == self.cur_module() {
            self.icx.current_fn;
        } else {
            NODE_NONE;
        };
        for w in 0..unsafe (*pa).where_bounds.len() {
            let sc = unsafe (*pa).where_scope(w, pdecl, at);
            if sc == WHERE_OWN || sc == WHERE_IN {
                let pred = unsafe (*pa).at_const(unsafe (*pa).where_bounds.at(w).pred).as_data.where_predicate;
                self.add_bound_ifaces_full(pmod, pred.bounds, self_ty, out, &mut n, cap);
            }
        }
        return n;
    }

    // The arguments interface `to` takes where interface `from` holds with arguments `fa[0..fnum]` for
    // type `self_ty`: `from`'s own when `to` is `from`, else those the superinterface chain gives it,
    // each hop's bound arguments read under the previous hop's parameters (and `Self` as `self_ty`).
    // Written to `out`; their count, or -1 when `to` is neither `from` nor one of its superinterfaces.
    fn tc_super_args(
        self: &mut Self,
        from: DefId,
        fa: *const TypeId,
        fnum: i32,
        self_ty: TypeId,
        to: DefId,
        out: *mut TypeId,
        depth: i32,
    ) i32 {
        if from.module == to.module && from.node == to.node {
            for k in 0..fnum {
                unsafe out[k as usize] = unsafe fa[k as usize];
            }
            return fnum;
        }
        if depth > BOUND_MAX_DEPTH {
            return -1;
        }
        let ia = self.mod_ast(from.module);
        let idn = *unsafe (*ia).at_const(from.node);
        if idn.kind != NodeKind::NODE_INTERFACE {
            return -1;
        }
        let mut sp = Defs8 {};
        let mut sa = Tys8 {};
        let mut ns: i32 = 0;
        let mut k: i32 = 0;
        while k < fnum && ns < 8 {
            let gid = self.tc_gen_slot(from, k as u32);
            if gid == NODE_NONE {
                break;
            }
            sp[ns as usize] = DefId { module: from.module, node: gid };
            sa[ns as usize] = unsafe fa[k as usize];
            ns += 1;
            k += 1;
        }
        let bounds = idn.as_data.interface_def.bounds;
        for i in 0..bounds.len {
            let bid = unsafe (*ia).list(bounds)[i as usize];
            let sb = unsafe (*ia).resolution_def(bid);
            if sb.node == NODE_NONE {
                continue;
            }
            let mut ba = Tys8 {};
            let bn = self.tc_bound_args(from.module, bid, sb, self_ty, &mut ba[0]);
            for j in 0..bn {
                let t = self.subst_type(ba[j as usize], &sp[0], &sa[0], ns);
                ba[j as usize] = pick(self_ty != TYPE_NONE, self.subst_type(t, &from, &self_ty, 1), t);
            }
            let r = self.tc_super_args(sb, &ba[0], bn, self_ty, to, out, depth + 1);
            if r >= 0 {
                return r;
            }
        }
        return -1;
    }

    // Whether arguments `have[0..hn]` satisfy the wanted `want[0..wn]`: no wanted arguments, no known
    // ones, or equal counts and each wanted argument equal (TYPE_NONE and the error type match any).
    fn tc_args_match(self: &Self, have: *const TypeId, hn: i32, want: *const TypeId, wn: i32) bool {
        if wn == 0 || hn == 0 {
            return true;
        }
        if hn != wn {
            return false;
        }
        for k in 0..wn {
            let w = unsafe want[k as usize];
            let h = unsafe have[k as usize];
            if w != h && w != TYPE_NONE && w != TYPE_ERROR && h != TYPE_ERROR {
                return false;
            }
        }
        return true;
    }

    // Whether generic parameter (or interface `Self`) `pdecl` of module `pmod` conforms to `iface`,
    // with arguments `wa[0..wn]` when `wn` is not zero: one of its bounds is `iface` or has it as a
    // superinterface, with those arguments.
    fn tc_param_entails(self: &mut Self, pmod: ModuleId, pdecl: NodeId, iface: DefId, wa: *const TypeId, wn: i32) bool {
        let mut bs = BoundArr8 {};
        let nb = self.collect_param_bounds_full(pmod, pdecl, &mut bs[0], 8);
        let pty = self.named_type_of(pmod, pdecl);
        for b in 0..nb {
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                bs[b as usize].iface,
                &bs[b as usize].args[0],
                bs[b as usize].n,
                pty,
                iface,
                &mut ga[0],
                0,
            );
            if gn >= 0 && self.tc_args_match(&ga[0], gn, wa, wn) {
                return true;
            }
        }
        return false;
    }

    // The substitution a call of interface method `method` through generic parameter (or interface
    // `Self`) `pdecl` of module `pmod` reads its signature under: the parameters of the method's
    // interface bound to the arguments the first bound reaching that interface gives it (through
    // superinterfaces). For a generic interface, `disp` (when not null) receives `dyn I<args>`: the
    // conformance the call dispatches to in every instance.
    fn bound_method_subst(
        self: &mut Self,
        pmod: ModuleId,
        pdecl: NodeId,
        method: DefId,
        outp: *mut DefId,
        outa: *mut TypeId,
        cap: i32,
        disp: *mut TypeId,
    ) i32 {
        let mi = self.enclosing(method.module, method.node, NodeKind::NODE_INTERFACE);
        if mi == NODE_NONE {
            return 0;
        }
        let md = DefId { module: method.module, node: mi };
        let mut ifaces = BoundArr8 {};
        let ni = self.collect_param_bounds_full(pmod, pdecl, &mut ifaces[0], 8);
        let pty = self.named_type_of(pmod, pdecl);
        for i in 0..ni {
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                ifaces[i as usize].iface,
                &ifaces[i as usize].args[0],
                ifaces[i as usize].n,
                pty,
                md,
                &mut ga[0],
                0,
            );
            if gn < 0 {
                continue;
            }
            let mut n: i32 = 0;
            while n < gn && n < cap {
                let gid = self.tc_gen_slot(md, n as u32);
                if gid == NODE_NONE {
                    break;
                }
                unsafe outp[n as usize] = DefId { module: md.module, node: gid };
                unsafe outa[n as usize] = ga[n as usize];
                n += 1;
            }
            if disp != null && gn > 0 {
                unsafe *disp = unsafe (*self.cur_ast()).intern_dyn(
                    md.module,
                    md.node,
                    &ga[0],
                    gn as u8,
                    TypeQualifier::TYPE_QUAL_NONE as u8,
                );
            }
            return n;
        }
        return 0;
    }
    fn find_bound_method(self: &mut Self, pmod: ModuleId, pdecl: NodeId, name: tok::Span, iface: *mut DefId) DefId {
        let mut ifaces = BoundArr8 {};
        let ni = self.collect_param_bounds_full(pmod, pdecl, &mut ifaces[0], 8);
        for b in 0..ni {
            let id = ifaces[b as usize].iface;
            let m = self.find_interface_method(
                id.module,
                id.node,
                self.source.slice(name.start as usize, name.end as usize),
                0,
            );
            if m.node != NODE_NONE {
                if iface != null {
                    unsafe *iface = id;
                }
                return m;
            }
        }
        return DefId { module: 0, node: NODE_NONE };
    }

    // The conformance (`dyn I<args>`) a call of `name`, interface method `m` of generic interface `I`,
    // runs through generic parameter (pmod, pdecl) when its bounds reach `I` with several argument
    // lists: the call's arguments choose, then its expected result `want` (`tc_pick_conf_cand`; a
    // failed choice is reported and answers TYPE_ERROR). TYPE_NONE with one argument list.
    fn tc_pick_bound_conf(self: &mut Self, pmod: ModuleId, pdecl: NodeId, m: DefId, name: tok::Span, want: TypeId) TypeId {
        let iface = DefId { module: m.module, node: self.enclosing(m.module, m.node, NodeKind::NODE_INTERFACE) };
        if iface.node == NODE_NONE || unsafe (*self.mod_ast(iface.module)).at_const(iface.node).as_data.interface_def.generics.len == 0 {
            return TYPE_NONE;
        }
        let mut bs = BoundArr8 {};
        let nb = self.collect_param_bounds_full(pmod, pdecl, &mut bs[0], 8);
        let pty = self.named_type_of(pmod, pdecl);
        let mut cm = Defs8 {};
        let mut cc = Tys8 {};
        let mut n: usize = 0;
        for b in 0..nb {
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                bs[b as usize].iface,
                &bs[b as usize].args[0],
                bs[b as usize].n,
                pty,
                iface,
                &mut ga[0],
                0,
            );
            if gn <= 0 {
                continue;
            }
            let conf = unsafe (*self.cur_ast()).intern_dyn(
                iface.module,
                iface.node,
                &ga[0],
                gn as u8,
                TypeQualifier::TYPE_QUAL_NONE as u8,
            );
            let mut dup = false;
            for k in 0..n {
                dup = dup || cc[k] == conf;
            }
            if !dup {
                cm[n] = m;
                cc[n] = conf;
                n += 1;
            }
        }
        if n < 2 {
            return TYPE_NONE;
        }
        let k = self.tc_pick_conf_cand(pty, name, want, &cm, &cm, &cc, n);
        return if k == TC_MAX_CANDIDATES {
            TYPE_ERROR;
        } else {
            cc[k];
        };
    }

    // The associated type declaration `type <name>;` of interface `iface` or of one of its
    // superinterfaces; node NODE_NONE when none declares it.
    fn tc_find_assoc_decl(self: &Self, iface: DefId, name: str, depth: i32) DefId {
        let none = DefId { module: 0, node: NODE_NONE };
        if iface.node == NODE_NONE || depth > BOUND_MAX_DEPTH {
            return none;
        }
        let a = self.mod_ast(iface.module);
        let tn = unsafe (*a).at_const(iface.node);
        if tn.kind != NodeKind::NODE_INTERFACE {
            return none;
        }
        let items = tn.as_data.interface_def.items;
        for i in 0..items.len {
            let mid = unsafe (*a).list(items)[i as usize];
            let mn = unsafe (*a).at_const(mid);
            if mn.kind != NodeKind::NODE_TYPE_ALIAS || mn.as_data.type_alias.ty != NODE_NONE {
                continue;
            }
            let nt = unsafe (*a).at_const(mn.as_data.type_alias.name).as_data.name.text;
            if self.mod_src(iface.module).slice(nt.start as usize, nt.end as usize) == name {
                return DefId { module: iface.module, node: mid };
            }
        }
        let bounds = tn.as_data.interface_def.bounds;
        for i in 0..bounds.len {
            let sb = unsafe (*a).resolution_def(unsafe (*a).list(bounds)[i as usize]);
            let r = self.tc_find_assoc_decl(sb, name, depth + 1);
            if r.node != NODE_NONE {
                return r;
            }
        }
        return none;
    }

    // `P::<name>` for generic parameter (or interface `Self`) `pdecl` of module `pmod`: the associated
    // type `name` of the bound that declares it (through superinterfaces), a TYPE_ASSOC over `P` and
    // that bound's arguments for the declaring interface. TYPE_NONE when no bound declares it; with
    // several bounds declaring it differently the error is reported at `sp` and TYPE_ERROR returned.
    fn tc_param_assoc(self: &mut Self, pmod: ModuleId, pdecl: NodeId, name: str, sp: tok::Span) TypeId {
        let mut bs = BoundArr8 {};
        let nb = self.collect_param_bounds_full(pmod, pdecl, &mut bs[0], 8);
        let pty = self.named_type_of(pmod, pdecl);
        let mut found = TYPE_NONE;
        for b in 0..nb {
            let ad = self.tc_find_assoc_decl(bs[b as usize].iface, name, 0);
            if ad.node == NODE_NONE {
                continue;
            }
            let di = DefId { module: ad.module, node: self.enclosing(ad.module, ad.node, NodeKind::NODE_INTERFACE) };
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                bs[b as usize].iface,
                &bs[b as usize].args[0],
                bs[b as usize].n,
                pty,
                di,
                &mut ga[0],
                0,
            );
            if gn < 0 || gn > 7 {
                continue;
            }
            let mut args = Tys8 {};
            args[0] = pty;
            for k in 0..gn {
                args[(k + 1) as usize] = ga[k as usize];
            }
            let t = self.tc_assoc_make(ad.module, ad.node, &args[0], (gn + 1) as u8);
            if found != TYPE_NONE && found != t {
                let pb = self.type_buf(pty);
                self.errors.emit_span(
                    sp,
                    format(
                        "ambiguous associated type '{}': several bounds of '{}' declare it",
                        name,
                        str::from_cstr(&pb[0]),
                    ),
                );
                self.note_decl_site("the bounds are declared here", DefId { module: pmod, node: pdecl });
                return TYPE_ERROR;
            }
            found = t;
        }
        return found;
    }

    // The associated type bindings (`Add<i32, Output = T>`) among the module-arena nodes `(lo, hi]`
    // of the item under check: only a generic parameter's or `where` predicate's interface bound may
    // carry them, each names an associated type of that interface once.
    fn tc_check_bindings(self: &mut Self, lo: NodeId, hi: NodeId) {
        let a = self.cur_ast();
        let mut any = false;
        let mut id = lo + 1;
        while id <= hi {
            let n = *unsafe (*a).at_const(id);
            id += 1;
            if n.kind == NodeKind::NODE_TYPE_PATH && n.as_data.type_path.bindings.len != 0 {
                any = true;
            }
            if n.kind == NodeKind::NODE_GENERIC_PARAM && !n.as_data.generic_param.is_lifetime {
                self.tc_check_bound_kinds(n.as_data.generic_param.bounds);
            } else if n.kind == NodeKind::NODE_WHERE_PREDICATE {
                self.tc_check_bound_kinds(n.as_data.where_predicate.bounds);
            }
        }
        if !any {
            return;
        }
        let mut bounds = Set::<NodeId>::new();
        id = lo + 1;
        while id <= hi {
            let n = *unsafe (*a).at_const(id);
            id += 1;
            let bl = if n.kind == NodeKind::NODE_GENERIC_PARAM {
                n.as_data.generic_param.bounds;
            } else if n.kind == NodeKind::NODE_WHERE_PREDICATE {
                n.as_data.where_predicate.bounds;
            } else {
                NodeList { start: 0, len: 0 };
            };
            for i in 0..bl.len {
                bounds.insert(unsafe (*a).list(bl)[i as usize]);
            }
        }
        id = lo + 1;
        while id <= hi {
            let n = *unsafe (*a).at_const(id);
            id += 1;
            if n.kind != NodeKind::NODE_TYPE_PATH || n.as_data.type_path.bindings.len == 0 {
                continue;
            }
            let bs = n.as_data.type_path.bindings;
            let b0 = unsafe (*a).list(bs)[0];
            if !bounds.contains(&(id - 1)) {
                self.errors.emit_span(
                    unsafe (*a).at_const(b0).span,
                    format("an associated type binding is only allowed in a generic bound"),
                );
                continue;
            }
            let bi = unsafe (*a).resolution_def(id - 1);
            for j in 0..bs.len {
                let bj = unsafe (*a).list(bs)[j as usize];
                let nt = self.name_span(unsafe (*a).at_const(bj).as_data.type_alias.name);
                let nm = self.source.slice(nt.start as usize, nt.end as usize);
                let mut dup = false;
                for k in 0..j {
                    let pk = self.name_span(
                        unsafe (*a).at_const(unsafe (*a).list(bs)[k as usize]).as_data.type_alias.name,
                    );
                    dup = dup || spans_eq2(self.source, pk, self.source, nt);
                }
                if dup {
                    self.errors.emit_span(nt, format("associated type '{}' is bound twice", nm));
                } else if bi.node != NODE_NONE && self.tc_find_assoc_decl(bi, nm, 0).node == NODE_NONE {
                    let isp = self.name_span(unsafe (*a).list(n.as_data.type_path.parts)[0]);
                    self.errors.emit_span(
                        nt,
                        format("no associated type '{}' in '{}'", nm, diag::span_str(self.source, isp.start, isp.end)),
                    );
                }
            }
        }
    }

    // Each named bound of `bounds` (the module under check) names an interface: a struct, an enum or a
    // builtin bounds nothing.
    fn tc_check_bound_kinds(self: &mut Self, bounds: NodeList) {
        let a = self.cur_ast();
        for i in 0..bounds.len {
            let bid = unsafe (*a).list(bounds)[i as usize];
            let bn = *unsafe (*a).at_const(bid);
            if bn.kind != NodeKind::NODE_TYPE_PATH || bn.as_data.type_path.parts.len == 0 {
                continue;
            }
            let d = unsafe (*a).resolution_def(bid);
            let bad = if d.node == NODE_NONE {
                bt_of_name(self.source, self.name_span(unsafe (*a).list(bn.as_data.type_path.parts)[0])) >= 0;
            } else {
                unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_INTERFACE;
            };
            if bad {
                let sp = self.name_span(
                    unsafe (*a).list(bn.as_data.type_path.parts)[bn.as_data.type_path.parts.len - 1],
                );
                self.errors.emit_span(
                    sp,
                    format(
                        "'{}' is not an interface: a bound names an interface or a 'fn' type",
                        diag::span_str(self.source, sp.start, sp.end),
                    ),
                );
            }
        }
    }

    // The type a bound of generic parameter `pdecl` (module `pmod`) binds associated type `ad` to
    // (`T: Add<i32, Output = T>`), for the interface arguments `wa[0..wn]` of the interface declaring
    // `ad`; TYPE_NONE when no bound in scope binds it with those arguments.
    fn tc_param_binding(self: &mut Self, pmod: ModuleId, pdecl: NodeId, ad: DefId, wa: *const TypeId, wn: i32) TypeId {
        let pa = self.mod_ast(pmod);
        if unsafe (*pa).at_const(pdecl).kind != NodeKind::NODE_GENERIC_PARAM {
            return TYPE_NONE;
        }
        let r = self.tc_bounds_binding(
            pmod,
            pdecl,
            unsafe (*pa).at_const(pdecl).as_data.generic_param.bounds,
            ad,
            wa,
            wn,
        );
        if r != TYPE_NONE {
            return r;
        }
        let at = pick(pmod == self.cur_module(), self.icx.current_fn, NODE_NONE);
        for w in 0..unsafe (*pa).where_bounds.len() {
            let sc = unsafe (*pa).where_scope(w, pdecl, at);
            if sc == WHERE_OWN || sc == WHERE_IN {
                let pred = unsafe (*pa).at_const(unsafe (*pa).where_bounds.at(w).pred).as_data.where_predicate;
                let r2 = self.tc_bounds_binding(pmod, pdecl, pred.bounds, ad, wa, wn);
                if r2 != TYPE_NONE {
                    return r2;
                }
            }
        }
        return TYPE_NONE;
    }

    // `tc_param_binding` over one bound list `bounds` of module `m`.
    fn tc_bounds_binding(
        self: &mut Self,
        m: ModuleId,
        pdecl: NodeId,
        bounds: NodeList,
        ad: DefId,
        wa: *const TypeId,
        wn: i32,
    ) TypeId {
        let a = self.mod_ast(m);
        let an = unsafe (*self.mod_ast(ad.module)).at_const(
            unsafe (*self.mod_ast(ad.module)).at_const(ad.node).as_data.type_alias.name,
        ).as_data.name.text;
        let di = DefId { module: ad.module, node: self.enclosing(ad.module, ad.node, NodeKind::NODE_INTERFACE) };
        for i in 0..bounds.len {
            let bid = unsafe (*a).list(bounds)[i as usize];
            let bn = *unsafe (*a).at_const(bid);
            if bn.kind != NodeKind::NODE_TYPE_PATH || bn.as_data.type_path.bindings.len == 0 {
                continue;
            }
            let bs = bn.as_data.type_path.bindings;
            for j in 0..bs.len {
                let al = unsafe (*a).at_const(unsafe (*a).list(bs)[j as usize]).as_data.type_alias;
                if !spans_eq2(
                    self.mod_src(m),
                    unsafe (*a).at_const(al.name).as_data.name.text,
                    self.mod_src(ad.module),
                    an,
                ) {
                    continue;
                }
                let bi = unsafe (*a).resolution_def(bid);
                let hit = self.tc_find_assoc_decl(
                    bi,
                    self.mod_src(ad.module).slice(an.start as usize, an.end as usize),
                    0,
                );
                if hit.module != ad.module || hit.node != ad.node {
                    continue;
                }
                let pty = self.named_type_of(m, pdecl);
                let mut ba = Tys8 {};
                let bnum = self.tc_bound_args(m, bid, bi, pty, &mut ba[0]);
                let mut ga = Tys8 {};
                let gn = self.tc_super_args(bi, &ba[0], bnum, pty, di, &mut ga[0], 0);
                if gn != wn {
                    continue;
                }
                let mut same = true;
                for k in 0..gn {
                    same = same && ga[k as usize] == unsafe wa[k as usize];
                }
                if same {
                    return self.lower_type_in(m, al.ty);
                }
            }
        }
        return TYPE_NONE;
    }

    // Associated type `(am, ad)` (an interface's `type Name;`) of `args[0]` under interface arguments
    // `args[1..n]`: the conformance's `type Name = ..` when `args[0]` is a type with conformances (the
    // conformance whose interface arguments are these), with the extend's parameters bound from
    // `args[0]`; otherwise, or without such a conformance (reported where the bound is checked), the
    // symbolic TYPE_ASSOC.
    fn tc_assoc_make(self: &mut Self, am: ModuleId, ad: NodeId, args: *const TypeId, n: u8) TypeId {
        let r = self.tc_assoc_norm(am, ad, args, n);
        if r != TYPE_NONE {
            return r;
        }
        return unsafe (*self.cur_ast()).intern_assoc(am, ad, args, n);
    }

    // `tc_assoc_make`'s resolved type, or TYPE_NONE when it stays symbolic.
    fn tc_assoc_norm(self: &mut Self, am: ModuleId, ad: NodeId, args: *const TypeId, n: u8) TypeId {
        let st = unsafe args[0];
        if st == TYPE_NONE || st == TYPE_ERROR {
            return TYPE_NONE;
        }
        let y = *self.type_at(st);
        let mut tmod: ModuleId = 0;
        let mut tdecl = NODE_NONE;
        let mut iargs = Tys8 {};
        let mut in2: i32 = 0;
        if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
            tmod = y.module;
            tdecl = y.as_data.decl;
        } else if y.kind == TypeKind::TYPE_INSTANCE {
            let inst = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            tmod = inst.module;
            tdecl = inst.decl;
            while in2 < inst.n as i32 && in2 < 8 {
                iargs[in2 as usize] = unsafe inst.args[in2 as usize];
                in2 += 1;
            }
        } else if y.kind == TypeKind::TYPE_BUILTIN {
            tmod = unsafe (*self.package).core_module;
            tdecl = unsafe (*self.package).builtin_decl(y.as_data.builtin);
        } else if y.kind == TypeKind::TYPE_GENERIC {
            // A type parameter whose bound binds it: `U::Output` is `U` under `U: Add<Output = U>`.
            return self.tc_param_binding(
                y.module,
                y.as_data.decl,
                DefId { module: am, node: ad },
                unsafe (args + 1),
                n as i32 - 1,
            );
        }
        if tdecl == NODE_NONE {
            return TYPE_NONE;
        }
        let iface = DefId { module: am, node: self.enclosing(am, ad, NodeKind::NODE_INTERFACE) };
        let mut imod: ModuleId = 0;
        let mut ea = Tys8 {};
        let mut en: i32 = 0;
        let ext = self.tc_conform_ext_args(
            tmod,
            tdecl,
            iface,
            &iargs[0],
            in2,
            st,
            unsafe (args + 1),
            n as i32 - 1,
            &mut imod,
            &mut ea,
            &mut en,
        );
        if ext == NODE_NONE {
            return TYPE_NONE;
        }
        let xa = self.mod_ast(imod);
        let ia = self.mod_ast(am);
        let an = unsafe (*ia).at_const(unsafe (*ia).at_const(ad).as_data.type_alias.name).as_data.name.text;
        let items = unsafe (*xa).at_const(ext).as_data.extend_def.items;
        let mut hit = NODE_NONE;
        for j in 0..items.len {
            let hid = unsafe (*xa).list(items)[j as usize];
            let hn = unsafe (*xa).at_const(hid);
            if hn.kind == NodeKind::NODE_TYPE_ALIAS && hn.as_data.type_alias.ty != NODE_NONE && spans_eq2(
                self.mod_src(am),
                an,
                self.mod_src(imod),
                unsafe (*xa).at_const(hn.as_data.type_alias.name).as_data.name.text,
            ) {
                hit = hid;
                break;
            }
        }
        if hit == NODE_NONE {
            return TYPE_NONE;
        }
        let at = self.lower_type_in(imod, unsafe (*xa).at_const(hit).as_data.type_alias.ty);
        let gens = unsafe (*xa).at_const(ext).as_data.extend_def.generics;
        let mut gp = Defs8 {};
        let mut gn: i32 = 0;
        while gn < en && gn as u32 < gens.len {
            gp[gn as usize] = DefId { module: imod, node: unsafe (*xa).list(gens)[gn as usize] };
            gn += 1;
        }
        return self.subst_nested(at, &gp[0], &ea[0], gn);
    }

    // The associated type type path `id` of module `m` (resolved to `d`) names: `Self::Name` inside the
    // interface declaring `Name`, or `T::Name` for a type parameter `T` a bound gives `Name`
    // (`tc_param_assoc`). TYPE_NONE when the path is neither.
    fn tc_assoc_path(self: &mut Self, m: ModuleId, id: NodeId, d: DefId) TypeId {
        if d.node == NODE_NONE {
            return TYPE_NONE;
        }
        let a = self.mod_ast(m);
        let tp = unsafe (*a).at_const(id).as_data.type_path;
        let dn = *unsafe (*self.mod_ast(d.module)).at_const(d.node);
        let sp = unsafe (*a).at_const(id).span;
        if dn.kind == NodeKind::NODE_TYPE_ALIAS && dn.as_data.type_alias.ty == NODE_NONE && tp.parts.len >= 2 {
            let ifn = self.enclosing(d.module, d.node, NodeKind::NODE_INTERFACE);
            if ifn == NODE_NONE {
                return TYPE_NONE;
            }
            let nt = unsafe (*self.mod_ast(d.module)).at_const(dn.as_data.type_alias.name).as_data.name.text;
            return self.tc_param_assoc(
                d.module,
                ifn,
                self.mod_src(d.module).slice(nt.start as usize, nt.end as usize),
                sp,
            );
        }
        if dn.kind == NodeKind::NODE_GENERIC_PARAM && !dn.as_data.generic_param.is_const && tp.parts.len == tp.head + 2 {
            let seg = unsafe (*a).list(tp.parts)[(tp.head + 1) as usize];
            let nt = unsafe (*a).at_const(seg).as_data.name.text;
            return self.tc_param_assoc(d.module, d.node, self.mod_src(m).slice(nt.start as usize, nt.end as usize), sp);
        }
        return TYPE_NONE;
    }

    // `subst_type` from inside a substitution: the running one's memo is set aside, so the two never
    // read each other's entries.
    fn subst_nested(self: &mut Self, ty: TypeId, params: *const DefId, args: *const TypeId, n: i32) TypeId {
        let saved = replace(&mut self.subst_memo, Map::<TypeId, TypeId>::new());
        let r = self.subst_type(ty, params, args, n);
        self.subst_memo = saved;
        return r;
    }

    fn interface_declares_cstr(self: &Self, iface: DefId, m: str, depth: i32) bool {
        return iface.node != NODE_NONE && self.find_interface_method(iface.module, iface.node, m, depth).node != NODE_NONE;
    }
    fn tc_param_bound_provides(self: &mut Self, pmod: ModuleId, pdecl: NodeId, m: str) bool {
        let mut ifaces = BoundArr8 {};
        let ni = self.collect_param_bounds_full(pmod, pdecl, &mut ifaces[0], 8);
        for b in 0..ni {
            if self.interface_declares_cstr(ifaces[b as usize].iface, m, 0) {
                return true;
            }
        }
        return false;
    }

    // Every field of `owner` satisfies `iface`? Failures add a NOTE naming the field (the caller
    // emits the spanned bound error), so a reflection loop's bound failure points at the field.
    fn proj_fields_satisfy(self: &mut Self, owner: TypeId, iface: DefId, depth: i32, notes: bool) bool {
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(owner, &mut om, &mut od, &mut gp, &mut ga, &mut gn) {
            return true;
        }
        let da = self.mod_ast(om);
        if unsafe (*da).at_const(od).kind != NodeKind::NODE_STRUCT {
            return true;
        }
        let ag = unsafe (*da).at_const(od).as_data.aggregate;
        let mut ok = true;
        let mut idx: i64 = 0;
        for i in 0..ag.members.len {
            let fid = unsafe (*da).list(ag.members)[i as usize];
            if !ag.is_tuple && unsafe (*da).at_const(fid).kind != NodeKind::NODE_FIELD {
                continue;
            }
            let ft = self.subst_type(self.node_type_in(om, fid), &gp[0], &ga[0], gn);
            if !self.type_satisfies(ft, iface, depth + 1) {
                if !notes {
                    return false;
                }
                let on = self.type_buf(owner);
                let fn2 = self.type_buf(ft);
                if ag.is_tuple {
                    self.errors.note(
                        format(
                            "field {} of '{}' is '{}', which does not satisfy the bound",
                            idx,
                            str::from_cstr(&on[0]),
                            str::from_cstr(&fn2[0]),
                        ),
                    );
                } else {
                    let fsp3 = unsafe (*da).at_const(unsafe (*da).at_const(fid).as_data.field.name).as_data.name.text;
                    self.errors.note(
                        format(
                            "field '{}' of '{}' is '{}', which does not satisfy the bound",
                            diag::span_str(self.mod_src(om), fsp3.start, fsp3.end),
                            str::from_cstr(&on[0]),
                            str::from_cstr(&fn2[0]),
                        ),
                    );
                }
                ok = false;
            }
            idx = idx + 1;
        }
        return ok;
    }

    // The function (or extend method) whose span contains `node`; NODE_NONE at item level.
    fn tc_enclosing_fn(self: &Self, node: NodeId) NodeId {
        let a = self.cur_ast();
        let sp = unsafe (*a).at_const(node).span;
        let items = unsafe (*a).at_const((*a).root).as_data.program.items;
        for i in 0..items.len {
            let iid = unsafe (*a).list(items)[i as usize];
            let ik = unsafe (*a).at_const(iid).kind;
            if ik == NodeKind::NODE_FUNCTION {
                let isp = unsafe (*a).at_const(iid).span;
                if isp.start <= sp.start && sp.end <= isp.end {
                    return iid;
                }
            } else if ik == NodeKind::NODE_EXTEND || ik == NodeKind::NODE_INTERFACE {
                let esp = unsafe (*a).at_const(iid).span;
                if esp.start <= sp.start && sp.end <= esp.end {
                    let ms = if ik == NodeKind::NODE_EXTEND {
                        unsafe (*a).at_const(iid).as_data.extend_def.items;
                    } else {
                        // An interface DEFAULT body: the obligation lands on the interface method,
                        // where every inheriting conformance discharges it with Self bound.
                        unsafe (*a).at_const(iid).as_data.interface_def.items;
                    };
                    for k2 in 0..ms.len {
                        let mid2 = unsafe (*a).list(ms)[k2 as usize];
                        if unsafe (*a).at_const(mid2).kind == NodeKind::NODE_FUNCTION {
                            let msp = unsafe (*a).at_const(mid2).span;
                            if msp.start <= sp.start && sp.end <= msp.end {
                                return mid2;
                            }
                        }
                    }
                }
            }
        }
        return NODE_NONE;
    }

    // Does this module already hold deferred projection obligation `ob`? A recursive call chain
    // hands the same obligation up on every pass, so without this check the driver's discharge
    // passes would never stop growing.
    fn tc_has_proj_ob(self: &Self, ob: ProjOb) bool {
        let obs = unsafe &(*self.cur_ast()).proj_obs;
        for i in 0..obs.len() {
            let o = obs.at(i);
            if o.fnd == ob.fnd && o.owner == ob.owner && o.iface.module == ob.iface.module && o.iface.node == ob.iface.node {
                return true;
            }
        }
        return false;
    }

    // Record a deferred projection obligation unless this module already holds it.
    fn tc_add_proj_ob(self: &mut Self, ob: ProjOb) {
        if !self.tc_has_proj_ob(ob) {
            (unsafe (*self.cur_ast()).proj_obs).push(ob);
        }
    }

    /// Discharge foreign callees' projection obligations against this module's recorded
    /// instantiations. Driven AFTER every module has typechecked, so a callee's obligations exist
    /// regardless of module order. `starts[m]` = the obligation index already processed for callee
    /// module m in earlier passes; a still-symbolic owner re-defers into THIS module's list, and
    /// the driver iterates passes until no list grows: multi-hop chains resolve hop per pass.
    pub fn discharge_foreign_obligations(self: &mut Self, starts: *const u32) bool {
        let mut grew = false;
        let nmu = (unsafe (*self.cur_ast()).mono).len();
        for i in 0..nmu {
            let mu = *(unsafe (*self.cur_ast()).mono).at(i);
            let a = self.cur_ast();
            if unsafe (*a).mono_slot(mu.node) != i as u32 + 1 {
                // Superseded entry: a re-checked node records again.
                continue;
            }
            if unsafe (*a).at_const(mu.node).kind != NodeKind::NODE_CALL {
                continue;
            }
            let mut callee = unsafe (*a).at_const(mu.node).as_data.call.callee;
            if unsafe (*a).at_const(callee).kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
                callee = unsafe (*a).at_const(callee).as_data.specialization.expression;
            }
            let mut cd = unsafe (*a).resolution_def(callee);
            if cd.node == NODE_NONE && unsafe (*a).at_const(callee).kind == NodeKind::NODE_MEMBER {
                cd = unsafe (*a).resolution_def(unsafe (*a).at_const(callee).as_data.member.member);
            }
            if cd.node == NODE_NONE || cd.module == self.cur_module() || cd.module as usize >= self.pkg_count() {
                continue;
            }
            let fa = self.mod_ast(cd.module);
            if unsafe (*fa).at_const(cd.node).kind != NodeKind::NODE_FUNCTION || (unsafe (*fa).proj_obs).len() == 0 {
                continue;
            }
            let gens = unsafe (*fa).at_const(cd.node).as_data.function.generics;
            let mut gp = Defs8 {};
            let mut gn2: i32 = 0;
            while gn2 < gens.len as i32 && gn2 < 8 {
                gp[gn2 as usize] = DefId { module: cd.module, node: unsafe (*fa).list(gens)[gn2 as usize] };
                gn2 = gn2 + 1;
            }
            let mut ga = Tys8 {};
            let mut i2: u8 = 0;
            while i2 < mu.n {
                ga[i2 as usize] = unsafe mu.args[i2 as usize];
                i2 = i2 + 1;
            }
            let nob = (unsafe (*fa).proj_obs).len();
            let ostart = (unsafe starts[cd.module as usize]) as usize;
            // An earlier pass already ran the obligations below `ostart` against this module.
            for oi in ostart..nob {
                let ob = *(unsafe (*fa).proj_obs).at(oi);
                if ob.fnd != cd.node {
                    continue;
                }
                let owner0 = unsafe (*self.cur_ast()).reintern(unsafe &*fa, ob.owner);
                let owner2 = self.subst_type(owner0, &gp[0], &ga[0], gn2);
                if !unsafe (*self.cur_ast()).type_concrete(owner2) {
                    // Still symbolic: this fn's own callers must bind it; hand the obligation up.
                    let host = self.tc_enclosing_fn(mu.node);
                    let up = ProjOb { fnd: host, owner: owner2, iface: ob.iface };
                    if host == NODE_NONE || self.tc_has_proj_ob(up) {
                        continue;
                    }
                    if (unsafe (*self.cur_ast()).proj_obs).len() >= PROJ_OBS_MAX {
                        // Only a generic function that reaches itself with a growing type argument
                        // hands up this many distinct bounds; without the limit the driver's passes
                        // would never end.
                        let sp3 = unsafe (*self.cur_ast()).at_const(mu.node).span;
                        self.errors.emit_span(
                            sp3,
                            format(
                                "this call hands more than {} reflection bounds up to its callers: a generic function reaches itself with a growing type argument",
                                PROJ_OBS_MAX,
                            ),
                        );
                        return false;
                    }
                    (unsafe (*self.cur_ast()).proj_obs).push(up);
                    grew = true;
                    continue;
                }
                if !self.proj_fields_satisfy(owner2, ob.iface, 0, false) {
                    let on2 = self.type_buf(owner2);
                    let sp2 = unsafe (*self.cur_ast()).at_const(mu.node).span;
                    self.errors.emit_span(
                        sp2,
                        format(
                            "a field of '{}' does not satisfy a bound the callee's reflection loop requires",
                            str::from_cstr(&on2[0]),
                        ),
                    );
                    let _ = self.proj_fields_satisfy(owner2, ob.iface, 0, true);
                }
            }
        }
        return grew;
    }

    /// Report cross-module duplicate conformances for interfaces written WITHOUT arguments (Format,
    /// Hash, ..): the same-module case errors in check_extend_conformance; across modules the two
    /// copies would only collide at link as a C redefinition, so name the duplicate here instead.
    /// Only a first declaration in an EARLIER module (`idx`, from `dup_conformance_index`) counts, so
    /// the later declaration carries the error. Argumented conformances
    /// (`Conv<i32>`) are exempt: distinct arguments are legal, and comparing them across pools is
    /// not worth the rare case the linker still catches.
    pub fn check_cross_module_dup_conformances(self: &mut Self, idx: &Map<ConfKey, u64>) {
        let items = unsafe (*self.cur_ast()).at_const((*self.cur_ast()).root).as_data.program.items;
        for i in 0..items.len {
            let id = unsafe (*self.cur_ast()).list(items)[i as usize];
            let key = dup_conf_key(unsafe &*self.cur_ast(), id);
            if key.iface.node == NODE_NONE {
                continue;
            }
            // Earlier modules only: exactly ONE error per duplicate pair, and it embeds the other
            // site's block, so both instances are shown without a mirrored second report.
            let first = switch idx.get(&key) {
                Some(v) => *v,
                None => 0xFFFFFFFFFFFFFFFFu64,
            };
            let j = (first >> 32) as usize;
            if j >= self.cur_module() as usize {
                continue;
            }
            let a = self.mod_ast(j as ModuleId);
            let pit = unsafe (*a).at_const((first & 0xFFFFFFFFu64) as NodeId).as_data.extend_def.interface_type;
            let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
            let sp = unsafe (*self.cur_ast()).at_const(itype).span;
            let psp = unsafe (*a).at_const(pit).span;
            self.errors.emit_span(
                sp,
                format(
                    "duplicate conformance: module '{}' also declares this conformance for the type",
                    unsafe (*self.package).modules[j].path.as_str(),
                ),
            );
            let site = diag::render_site(
                self.mod_src(j as ModuleId),
                unsafe (*self.package).modules[j].file.as_str(),
                psp.start,
                psp.end - psp.start,
            );
            self.errors.note(format("the other conformance is declared here\n{}", site.as_str()));
            self.errors.note(
                format("a type conforms to an interface once across the whole package; remove one of the two"),
            );
        }
    }

    // One conformance obligation against one concrete owner: the error names the owner and the
    // default method, the note pass names the offending field.
    fn tc_conf_ob_check(self: &mut Self, owner: TypeId, ob_iface: DefId, itype: NodeId, rn: tok::Span, imod: ModuleId) {
        if self.proj_fields_satisfy(owner, ob_iface, 0, false) {
            return;
        }
        let on2 = self.type_buf(owner);
        let sp2 = unsafe (*self.cur_ast()).at_const(itype).span;
        self.errors.emit_span(
            sp2,
            format(
                "a field of '{}' does not satisfy a bound required by the interface's default method '{}'",
                str::from_cstr(&on2[0]),
                diag::span_str(self.mod_src(imod), rn.start, rn.end),
            ),
        );
        let _ = self.proj_fields_satisfy(owner, ob_iface, 0, true);
    }

    /// Discharge the reflection-bound obligations carried by interface DEFAULT bodies at every
    /// conformance that INHERITS them: `extend T as Format {}` must prove what `fmt`'s body defers
    /// (each field satisfies Format), with Self bound to T. Runs in the driver's fixpoint alongside
    /// discharge_foreign_obligations (the default's own obligations only exist after its module's
    /// cross-module hand-up) over the [starts, ends) window so no obligation runs against an extend
    /// twice across passes. A conformance whose target is still generic proves nothing here: its
    /// instantiations discharge through their own call sites.
    pub fn discharge_conformance_obligations(self: &mut Self, starts: *const u32, ends: *const u32) {
        let items = unsafe (*self.cur_ast()).at_const((*self.cur_ast()).root).as_data.program.items;
        for i in 0..items.len {
            let id = unsafe (*self.cur_ast()).list(items)[i as usize];
            if unsafe (*self.cur_ast()).at_const(id).kind != NodeKind::NODE_EXTEND {
                continue;
            }
            let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
            if itype == NODE_NONE {
                continue;
            }
            let iface = unsafe (*self.cur_ast()).resolution_def(itype);
            if iface.node == NODE_NONE || iface.module as usize >= self.pkg_count() {
                continue;
            }
            let ostart = (unsafe starts[iface.module as usize]) as usize;
            let oend = (unsafe ends[iface.module as usize]) as usize;
            if ostart >= oend {
                continue;
            }
            let tgt = unsafe (*self.cur_ast()).resolution_def(
                unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.target_type,
            );
            if tgt.node == NODE_NONE {
                continue;
            }
            let ia = self.mod_ast(iface.module);
            if unsafe (*ia).at_const(iface.node).kind != NodeKind::NODE_INTERFACE {
                continue;
            }
            let mut subp = Defs8 {};
            let mut suba = Tys8 {};
            let nsub = self.tc_extend_self_frame(id, iface, &mut subp, &mut suba);
            let req = unsafe (*ia).at_const(iface.node).as_data.interface_def.items;
            for r in 0..req.len {
                let rid = unsafe (*ia).list(req)[r as usize];
                let rm = unsafe (*ia).at_const(rid);
                if rm.kind != NodeKind::NODE_FUNCTION || rm.as_data.function.body == NODE_NONE || rm.as_data.function.generics.len != 0 {
                    continue;
                }
                let rn = unsafe (*ia).at_const(rm.as_data.function.name).as_data.name.text;
                if self.find_extend_item_named(id, rn, iface.module) != NODE_NONE {
                    // Overridden: the extend's own body was checked normally.
                    continue;
                }
                // One error per required bound: the default's call chain hands the same (owner,
                // iface) requirement up once per branch it flows through.
                let mut seen = Defs8 {};
                let mut nseen: i32 = 0;
                for oi in ostart..oend {
                    let ob = *(unsafe (*ia).proj_obs).at(oi);
                    if ob.fnd != rid {
                        continue;
                    }
                    let mut dup = false;
                    for si in 0..nseen {
                        if seen[si as usize].module == ob.iface.module && seen[si as usize].node == ob.iface.node {
                            dup = true;
                        }
                    }
                    if dup {
                        continue;
                    }
                    if nseen < 8 {
                        seen[nseen as usize] = ob.iface;
                        nseen = nseen + 1;
                    }
                    let owner0 = unsafe (*self.cur_ast()).reintern(unsafe &*ia, ob.owner);
                    let owner2 = self.subst_type(owner0, &subp[0], &suba[0], nsub);
                    if unsafe (*self.cur_ast()).type_concrete(owner2) {
                        self.tc_conf_ob_check(owner2, ob.iface, itype, rn, iface.module);
                        continue;
                    }
                    // A GENERIC conformance proves nothing symbolically: run the obligation
                    // against every concrete instantiation of the target the package recorded,
                    // with the extend's parameters bound positionally through the target's
                    // written arguments.
                    let xd = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def;
                    if xd.generics.len == 0 || unsafe (*self.cur_ast()).at_const(xd.target_type).kind != NodeKind::NODE_TYPE_PATH {
                        continue;
                    }
                    let targs = unsafe (*self.cur_ast()).at_const(xd.target_type).as_data.type_path.args;
                    let mut seen3 = Vector::<TypeId>::new();
                    for j in 0..self.pkg_count() {
                        let oa = self.mod_ast(j as ModuleId);
                        let ninst = unsafe (*oa).ninstances();
                        for q in 0..ninst {
                            let it2 = *unsafe (*oa).used_instance(q);
                            if it2.decl != tgt.node || it2.module != tgt.module {
                                continue;
                            }
                            let mut pp = Defs8 {};
                            let mut pa = Tys8 {};
                            let mut np: i32 = 0;
                            let mut usable = true;
                            let mut kk: u32 = 0;
                            while kk < targs.len && kk < it2.n as u32 && np < 8 {
                                let an = unsafe (*self.cur_ast()).list(targs)[kk as usize];
                                let pd = unsafe (*self.cur_ast()).resolution_def(an);
                                let ca = unsafe (*self.cur_ast()).reintern(unsafe &*oa, unsafe it2.args[kk as usize]);
                                if pd.node == NODE_NONE || !unsafe (*self.cur_ast()).type_concrete(ca) {
                                    usable = false;
                                }
                                pp[np as usize] = pd;
                                pa[np as usize] = ca;
                                np = np + 1;
                                kk = kk + 1;
                            }
                            if !usable {
                                continue;
                            }
                            let owner3 = self.subst_type(owner2, &pp[0], &pa[0], np);
                            if !unsafe (*self.cur_ast()).type_concrete(owner3) {
                                continue;
                            }
                            let mut dup3 = false;
                            for z in 0..seen3.len() {
                                if seen3[z] == owner3 {
                                    dup3 = true;
                                }
                            }
                            if dup3 {
                                continue;
                            }
                            seen3.push(owner3);
                            self.tc_conf_ob_check(owner3, ob.iface, itype, rn, iface.module);
                        }
                    }
                }
            }
        }
    }

    fn type_satisfies(self: &mut Self, ty: TypeId, iface: DefId, depth: i32) bool {
        return self.type_satisfies_in(ty, iface, null, 0, depth);
    }

    // Whether `ty` conforms to `iface`, with interface arguments `wa[0..wn]` when `wn` is not zero
    // (`tc_args_match`): a type parameter through its bounds (`tc_param_entails`), an aggregate through
    // a conformance with those arguments.
    fn type_satisfies_in(self: &mut Self, ty: TypeId, iface: DefId, wa: *const TypeId, wn: i32, depth: i32) bool {
        // A field projection: with the owner concrete, the proof IS the per-field proof, made here
        // with the offending field named; a symbolic owner defers the obligation to this fn's call
        // sites (check_generic_bounds), where the owner gets bound.
        if self.type_at(ty).kind == TypeKind::TYPE_FIELD_PROJECTION {
            let powner = self.type_at(ty).as_data.proj.owner;
            if unsafe (*self.cur_ast()).type_concrete(powner) {
                return self.proj_fields_satisfy(powner, iface, depth, false);
            }
            self.tc_add_proj_ob(ProjOb { fnd: self.icx.current_fn, owner: powner, iface: iface });
            return true;
        }
        if ty == TYPE_NONE || ty == TYPE_ERROR || depth > BOUND_MAX_DEPTH {
            return true;
        }
        // `Copy` is derived from the type's shape (a parameter from its own bounds), never from an
        // `extend`: an explicit conformance is accepted only where the derivation holds.
        if self.is_copy_iface(iface) {
            return self.tc_copy_marker(ty, depth);
        }
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_GENERIC {
            let gk = unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl);
            // A const parameter is a value, never bounded by an interface.
            if gk.kind == NodeKind::NODE_GENERIC_PARAM && gk.as_data.generic_param.is_const {
                return true;
            }
            return self.tc_param_entails(y.module, y.as_data.decl, iface, wa, wn);
        }
        if y.kind == TypeKind::TYPE_DYN {
            let di = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            if di.decl == NODE_NONE {
                return false;
            }
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                DefId { module: di.module, node: di.decl },
                &di.args[0],
                di.n,
                ty,
                iface,
                &mut ga[0],
                0,
            );
            return gn >= 0 && self.tc_args_match(&ga[0], gn, wa, wn);
        }
        // Send / Sync are STRUCTURAL markers: no explicit `extend` is required (an explicit one is honored
        // below as an unsafe override). Answer them from the type's shape: this handles pointers /
        // references / closures / slices that the aggregate path below cannot even name.
        if self.is_send_iface(iface) {
            return self.tc_thread_marker(ty, false, depth);
        }
        if self.is_sync_iface(iface) {
            return self.tc_thread_marker(ty, true, depth);
        }
        let mut tmod: ModuleId = 0;
        let mut tdecl = NODE_NONE;
        let mut iargs = Tys8 {};
        let mut in2: i32 = 0;
        if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
            tmod = y.module;
            tdecl = y.as_data.decl;
        } else if y.kind == TypeKind::TYPE_INSTANCE {
            let inst = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
            tmod = inst.module;
            tdecl = inst.decl;
            let mut k: u8 = 0;
            while k < inst.n && in2 < 8 {
                iargs[in2 as usize] = unsafe inst.args[k as usize];
                in2 = in2 + 1;
                k = k + 1;
            }
        } else if y.kind == TypeKind::TYPE_BUILTIN {
            let bd = unsafe (*self.package).builtin_decl(y.as_data.builtin);
            if bd == NODE_NONE {
                return false;
            }
            tmod = unsafe (*self.package).core_module;
            tdecl = bd;
        } else {
            return false;
        }
        let mut imod: ModuleId = 0;
        let mut ea = Tys8 {};
        let mut en: i32 = 0;
        let extnode = self.tc_conform_ext_args(
            tmod,
            tdecl,
            iface,
            &iargs[0],
            in2,
            ty,
            wa,
            wn,
            &mut imod,
            &mut ea,
            &mut en,
        );
        if extnode == NODE_NONE {
            return false;
        }
        // Only an instance's bounds recurse: its verdict is memoized for the query (the wanted
        // arguments as one `dyn I<..>` id; a query with an unknown one is not memoized).
        let mut memo = in2 != 0;
        let mut wid = TYPE_NONE;
        if memo && wn != 0 {
            for k in 0..wn {
                let w = unsafe wa[k as usize];
                memo = memo && w != TYPE_NONE && w != TYPE_ERROR;
            }
            if memo {
                wid = unsafe (*self.cur_ast()).intern_dyn(iface.module, iface.node, wa, wn as u8, 0);
            }
        }
        let key = SatKey { ty: ty, depth: depth, kind: 0, iface: iface, args: wid };
        let mut f = SatFrame { fx: 0, mark_n: 0, on: false };
        if memo {
            let hit = self.sat_open(&key, &mut f);
            if hit >= 0 {
                return hit != 0;
            }
        }
        let r = self.ext_bounds_hold(imod, extnode, &ea[0], en, depth + 1);
        self.sat_close(key, &f, r);
        return r;
    }

    // The side effects a memoized verdict must not skip: diagnostics and deferred obligations.
    fn sat_fx(self: &Self) usize {
        let e = &self.errors;
        return e.errors.len() + e.warns.len() + e.note_pool.len() + e.fixes.len() + (unsafe (*self.cur_ast()).proj_obs).len();
    }

    // Open a `sat_memo` frame for `key`: the stored verdict (0 or 1, with its `mark_recv` write
    // replayed), or -1 with `f` opened.
    fn sat_open(self: &mut Self, key: &SatKey, f: &mut SatFrame) i32 {
        f.on = self.derive_busy.len() == 0;
        if !f.on {
            return -1;
        }
        if self.sat_nest != 0 {
            switch self.sat_memo.get(key) {
                Some(v) => {
                    let w = *v;
                    if (w & 2u64) != 0 {
                        self.mark_recv = (w >> 32) as TypeId;
                        self.mark_n += 1;
                    }
                    return (w & 1u64) as i32;
                },
                None => {},
            };
        }
        f.fx = self.sat_fx();
        f.mark_n = self.mark_n;
        self.sat_nest += 1;
        return -1;
    }

    // Close frame `f` with verdict `r`: store it unless it is the outermost frame, which empties the memo.
    fn sat_close(self: &mut Self, key: SatKey, f: &SatFrame, r: bool) {
        if !f.on {
            return;
        }
        self.sat_nest -= 1;
        if self.sat_nest == 0 {
            // A large table is dropped, not cleared: `clear` costs its capacity on every later query.
            if self.sat_memo.len() > 64 {
                self.sat_memo = Map::<SatKey, u64>::new();
            } else if self.sat_memo.len() != 0 {
                self.sat_memo.clear();
            }
            return;
        }
        if self.sat_fx() == f.fx {
            let w = self.mark_recv as u64 << 32 | pick(self.mark_n != f.mark_n, 2u64, 0u64) | pick(r, 1u64, 0u64);
            self.sat_memo.insert(key, w);
        }
    }

    // Whether `args[g]` satisfies every bound of generic g of extend `ext` (in module `m`), for each g
    // below both the extend's generic count and `n`.
    fn ext_bounds_hold(self: &mut Self, m: ModuleId, ext: NodeId, args: *const TypeId, n: i32, depth: i32) bool {
        let a = self.mod_ast(m);
        let gens = unsafe (*a).at_const(ext).as_data.extend_def.generics;
        let mut ps = Defs8 {};
        let np = pick(n < 8, n, 8);
        for g in 0..np {
            if g as u32 < gens.len {
                ps[g as usize] = DefId { module: m, node: unsafe (*a).list(gens)[g as usize] };
            }
        }
        let mut g: u32 = 0;
        while g < gens.len && g as i32 < n {
            let gb = unsafe (*a).at_const(unsafe (*a).list(gens)[g as usize]).as_data.generic_param.bounds;
            for b in 0..gb.len {
                let bid = unsafe (*a).list(gb)[b as usize];
                let bi = unsafe (*a).resolution_def(bid);
                if bi.node == NODE_NONE {
                    continue;
                }
                let mut wa = Tys8 {};
                let wn = self.tc_bound_want(
                    m,
                    bid,
                    bi,
                    unsafe args[g as usize],
                    &ps[0],
                    args,
                    np,
                    null,
                    null,
                    0,
                    &mut wa,
                );
                if !self.type_satisfies_in(unsafe args[g as usize], bi, &wa[0], wn, depth) {
                    return false;
                }
            }
            g = g + 1;
        }
        return true;
    }

    const fn is_free_iface(self: &Self, tr: DefId) bool {
        if tr.node == NODE_NONE {
            return false;
        }
        let trn = unsafe (*self.mod_ast(tr.module)).at_const(tr.node);
        return trn.kind == NodeKind::NODE_INTERFACE && span_is(
            self.mod_src(tr.module),
            unsafe (*self.mod_ast(tr.module)).at_const(trn.as_data.interface_def.name).as_data.name.text,
            "Free",
        );
    }
    const fn iface_named(self: &Self, tr: DefId, name: str) bool {
        if tr.node == NODE_NONE {
            return false;
        }
        let trn = unsafe (*self.mod_ast(tr.module)).at_const(tr.node);
        return trn.kind == NodeKind::NODE_INTERFACE && span_is(
            self.mod_src(tr.module),
            unsafe (*self.mod_ast(tr.module)).at_const(trn.as_data.interface_def.name).as_data.name.text,
            name,
        );
    }
    const fn is_send_iface(self: &Self, tr: DefId) bool {
        return self.iface_named(tr, "Send");
    }
    const fn is_copy_iface(self: &Self, tr: DefId) bool {
        return self.iface_named(tr, "Copy");
    }
    // Structural `Copy`: may a value of `ty` be duplicated bitwise, leaving both copies usable? Scalars,
    // `str`, raw pointers, shared references and `&dyn`, `fn` pointers and closures that own nothing,
    // and arrays of Copy are; `&mut T`, owned `Box<dyn I>` and every owning value are not. A type
    // parameter is Copy exactly when it does not own (`tc_param_owns`: its bounds reach `Copy`, or a
    // plain `fn` bound). An aggregate is Copy when it is not `Free` and every member is Copy under the
    // instance's arguments.
    fn tc_copy_marker(self: &mut Self, ty: TypeId, depth: i32) bool {
        if ty == TYPE_NONE || ty == TYPE_ERROR {
            return true;
        }
        // A nesting deeper than the cap answers the conservative verdict: a copy is never granted
        // unchecked.
        if depth > BOUND_MAX_DEPTH {
            return false;
        }
        let y = *self.type_at(ty);
        let k = y.kind;
        if k == TypeKind::TYPE_GENERIC {
            return !self.tc_param_owns(y.module, y.as_data.decl);
        }
        if k == TypeKind::TYPE_ASSOC {
            return false; // `T::Output` is known per instance only: it is not `Copy`
        }
        if k == TypeKind::TYPE_BUILTIN || k == TypeKind::TYPE_POINTER || k == TypeKind::TYPE_NEVER {
            return true;
        }
        if k == TypeKind::TYPE_REFERENCE {
            return y.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8;
        }
        if k == TypeKind::TYPE_DYN {
            return y.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8;
        }
        if k == TypeKind::TYPE_SLICE || k == TypeKind::TYPE_ARRAY {
            return self.tc_copy_marker(y.as_data.elem, depth + 1);
        }
        if k == TypeKind::TYPE_FUNCTION {
            return !self.fn_owns(ty);
        }
        let key = SatKey { ty: ty, depth: depth, kind: 1, iface: DefId { module: 0, node: NODE_NONE }, args: TYPE_NONE };
        let mut f = SatFrame { fx: 0, mark_n: 0, on: false };
        let hit = self.sat_open(&key, &mut f);
        if hit >= 0 {
            return hit != 0;
        }
        let r = self.tc_copy_aggregate(ty, depth);
        self.sat_close(key, &f, r);
        return r;
    }
    // `tc_copy_marker` of an aggregate: not `Free`, and every member Copy.
    fn tc_copy_aggregate(self: &mut Self, ty: TypeId, depth: i32) bool {
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(ty, &mut om, &mut od, &mut gp, &mut ga, &mut gn) || self.tc_type_is_free(ty) {
            return false;
        }
        let dn = *unsafe (*self.mod_ast(om)).at_const(od);
        let is_enum = dn.kind == NodeKind::NODE_ENUM;
        if dn.kind != NodeKind::NODE_STRUCT && !is_enum {
            return false;
        }
        let a = self.mod_ast(om);
        let is_tuple = dn.as_data.aggregate.is_tuple;
        let ms = dn.as_data.aggregate.members;
        for i in 0..ms.len {
            let mid = unsafe (*a).list(ms)[i as usize];
            let mn = *unsafe (*a).at_const(mid);
            if !is_enum && (mn.kind == NodeKind::NODE_FIELD || is_tuple) {
                let tn = pick(mn.kind == NodeKind::NODE_FIELD, mn.as_data.field.ty, mid);
                let ft = self.tc_member_type(self.lower_type_in(om, tn), &gp[0], &ga[0], gn);
                if !self.tc_copy_marker(ft, depth + 1) {
                    return false;
                }
            } else if is_enum && mn.kind == NodeKind::NODE_VARIANT {
                for p in 0..mn.as_data.variant.payload.len {
                    let pid = unsafe (*a).list(mn.as_data.variant.payload)[p as usize];
                    let pe = *unsafe (*a).at_const(pid);
                    let tn = pick(pe.kind == NodeKind::NODE_FIELD, pe.as_data.field.ty, pid);
                    let ft = self.tc_member_type(self.lower_type_in(om, tn), &gp[0], &ga[0], gn);
                    if !self.tc_copy_marker(ft, depth + 1) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    // True while checking a method of the prelude `UnsafeCell`: the one place `&T as *mut T` is allowed
    // (its `get` is the sanctioned interior-mutability hole).
    fn in_unsafe_cell(self: &Self) bool {
        if self.current_self == NODE_NONE {
            return false;
        }
        let hit = self.ph_unsafecell;
        return hit.node != NODE_NONE && unsafe (*self.cur_ast()).module == hit.mid && self.current_self == hit.node;
    }
    const fn is_sync_iface(self: &Self, tr: DefId) bool {
        return self.iface_named(tr, "Sync");
    }
    // Is this aggregate the prelude `UnsafeCell`? See the `Sync` rule in `tc_thread_marker`.
    fn is_unsafe_cell_decl(self: &Self, om: ModuleId, od: NodeId) bool {
        let hit = self.ph_unsafecell;
        return hit.node != NODE_NONE && hit.mid == om && hit.node == od;
    }
    // Structural `Send`/`Sync`: is `ty` safe to transfer to (`sync=false`) or share with (`sync=true`)
    // another thread? Scalars/str yes; a raw pointer no (so is anything transitively holding one); a
    // reference reduces to `Sync` of its pointee; a closure to all its captures; an aggregate to all its
    // fields, but an explicit `extend T as Send/Sync {}` overrides the field walk (the unsafe escape
    // hatch, e.g. Arc). Mirrors tc_type_is_free's decomposition; the depth cap breaks reference cycles.
    fn tc_thread_marker(self: &mut Self, ty: TypeId, sync: bool, depth: i32) bool {
        if ty == TYPE_NONE || depth > BOUND_MAX_DEPTH {
            return true;
        }
        let y = *self.type_at(ty);
        let k = y.kind;
        if k == TypeKind::TYPE_GENERIC || k == TypeKind::TYPE_ASSOC {
            // A generic param or its associated type: enforced where it is instantiated.
            return true;
        }
        if k == TypeKind::TYPE_POINTER {
            // Raw pointer: neither Send nor Sync.
            return false;
        }
        if k == TypeKind::TYPE_REFERENCE {
            // &T needs T: Sync.
            return self.tc_thread_marker(y.as_data.elem, true, depth + 1);
        }
        if k == TypeKind::TYPE_SLICE || k == TypeKind::TYPE_ARRAY {
            return self.tc_thread_marker(y.as_data.elem, sync, depth + 1);
        }
        if k == TypeKind::TYPE_BUILTIN {
            // Scalars, bool, char, str view.
            return true;
        }
        if k == TypeKind::TYPE_DYN {
            // A trait object does not advertise Send/Sync: conservative.
            return false;
        }
        if k == TypeKind::TYPE_FUNCTION {
            let fa = self.mod_ast(y.module);
            let fnn = unsafe (*fa).at_const(y.as_data.decl);
            if fnn.kind != NodeKind::NODE_CLOSURE {
                // A bare fn pointer captures nothing.
                return true;
            }
            let caps = fnn.as_data.closure.captures;
            let cl = fnn.as_data.closure;
            if sync && cl.mut_caps != 0 {
                // Two threads calling it at once would both write the binding it captures `&mut`.
                return false;
            }
            for i in 0..caps.len {
                let cid = unsafe (*fa).list(caps)[i as usize];
                let ct1 = self.tc_foreign_type_of(y.module, cid);
                let cty = unsafe (*self.cur_ast()).reintern(unsafe &*fa, ct1);
                // A borrowed capture is a `&T`: sending or sharing it shares T (T: Sync).
                let ci = self.marker_iface(sync || (cl.ref_caps >> i & 1u32) != 0);
                if ci.node != NODE_NONE && !self.type_satisfies(cty, ci, depth + 1) {
                    return false;
                }
            }
            return true;
        }
        let key = SatKey {
            ty: ty,
            depth: depth,
            kind: pick(sync, 3u32, 2u32),
            iface: DefId { module: 0, node: NODE_NONE },
            args: TYPE_NONE,
        };
        let mut f = SatFrame { fx: 0, mark_n: 0, on: false };
        let hit = self.sat_open(&key, &mut f);
        if hit >= 0 {
            return hit != 0;
        }
        let r = self.tc_thread_aggregate(ty, sync, depth);
        self.sat_close(key, &f, r);
        return r;
    }
    // `tc_thread_marker` of an aggregate: an explicit conformance is an unsafe override; otherwise
    // every field must qualify.
    fn tc_thread_aggregate(self: &mut Self, ty: TypeId, sync: bool, depth: i32) bool {
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(ty), &mut om, &mut od, &mut gp, &mut ga, &mut gn) {
            return false;
        }
        // `UnsafeCell<T>` is never `Sync`. It hands out a `*mut T` from a SHARED borrow, so two threads
        // holding `&UnsafeCell<T>` can write the same value at once, and the field walk below would read
        // straight through the cell to its payload and grant `Sync` for free, which is the whole hole
        // interior mutability is supposed to be gated by. Anything built on one (`Atomic`, `Mutex`,
        // `RwLock`) is shareable only by ASSERTING `Sync`, which is where its discipline is written down.
        if sync && self.is_unsafe_cell_decl(om, od) {
            return false;
        }
        let ci = self.marker_iface(sync);
        if ci.node != NODE_NONE {
            let mut imod: ModuleId = 0;
            let mut ea = Tys8 {};
            let mut en: i32 = 0;
            let extnode = self.tc_conform_ext(om, od, ci, &ga[0], gn, &mut imod, &mut ea, &mut en);
            if extnode != NODE_NONE {
                // Explicit `extend T as Send/Sync {}`: an unsafe override, but its own bounds still hold
                // (e.g. `extend<T: Send + Sync> Arc<T> as Send` is Send only for a Send + Sync payload).
                return self.ext_bounds_hold(imod, extnode, &ea[0], en, depth + 1);
            }
        }
        let dn = *unsafe (*self.mod_ast(om)).at_const(od);
        let is_enum = dn.kind == NodeKind::NODE_ENUM;
        if dn.kind != NodeKind::NODE_STRUCT && !is_enum {
            return false;
        }
        let a = self.mod_ast(om);
        let is_tuple = dn.as_data.aggregate.is_tuple;
        let ms = dn.as_data.aggregate.members;
        let mids = unsafe (*a).list(ms);
        for i in 0..ms.len {
            let mid = unsafe mids[i as usize];
            let mn = *unsafe (*a).at_const(mid);
            // Tuple members are bare type nodes; named members carry their type in field.ty.
            if !is_enum && (mn.kind == NodeKind::NODE_FIELD || is_tuple) {
                let tn = pick(mn.kind == NodeKind::NODE_FIELD, mn.as_data.field.ty, mid);
                if !self.tc_member_marker(om, tn, &gp[0], &ga[0], gn, sync, depth) {
                    return false;
                }
            } else if is_enum && mn.kind == NodeKind::NODE_VARIANT {
                let pids = unsafe (*a).list(mn.as_data.variant.payload);
                for p in 0..mn.as_data.variant.payload.len {
                    let pe = *unsafe (*a).at_const(unsafe pids[p as usize]);
                    let tn = pick(pe.kind == NodeKind::NODE_FIELD, pe.as_data.field.ty, unsafe pids[p as usize]);
                    if !self.tc_member_marker(om, tn, &gp[0], &ga[0], gn, sync, depth) {
                        return false;
                    }
                }
            }
        }
        return true;
    }
    fn marker_iface(self: &mut Self, sync: bool) DefId {
        let h = if sync {
            self.ph_sync;
        } else {
            self.ph_send;
        };
        return DefId { module: h.mid, node: h.node };
    }
    fn tc_member_marker(
        self: &mut Self,
        om: ModuleId,
        tnode: NodeId,
        gp: *const DefId,
        ga: *const TypeId,
        gn: i32,
        sync: bool,
        depth: i32,
    ) bool {
        let mut ft = self.lower_type_in(om, tnode);
        let mut conc = true;
        for k in 0..gn {
            if !unsafe (*self.cur_ast()).type_concrete(unsafe ga[k as usize]) {
                conc = false;
            }
        }
        if gn > 0 && conc {
            ft = self.subst_type(ft, gp, ga, gn);
        }
        let ci = self.marker_iface(sync);
        if ci.node == NODE_NONE {
            return true;
        }
        return self.type_satisfies(ft, ci, depth + 1);
    }
    // Leak check (lint, error-level): structs and enums DERIVE Free when their members own
    // memory, but a UNION cannot (only the author knows the active member), so an owning union
    // with no explicit Free conformance silently leaks: reject it. No machine fix: a generated
    // body freeing every overlapping member would double-free.
    fn tc_lint_missing_free(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let sty = unsafe (*a).intern_type(
            Ty { kind: TypeKind::TYPE_STRUCT, module: self.cur_module(), as_data: TyAs { decl: id } },
        );
        if self.tc_type_is_free(sty) {
            return;
        }
        let agg = unsafe (*a).at_const(id).as_data.aggregate;
        let sname = unsafe (*a).at_const(agg.name).as_data.name.text;
        let nm = diag::span_str(self.source, sname.start, sname.end);
        let ms = agg.members;
        let mut fields = String::new();
        for i in 0..ms.len {
            let fid = unsafe (*a).list(ms)[i as usize];
            let fnd = unsafe (*a).at_const(fid);
            if fnd.kind != NodeKind::NODE_FIELD {
                continue;
            }
            let ft = self.resolve_type(fnd.as_data.field.ty);
            if ft == TYPE_NONE {
                continue;
            }
            let fk = self.type_at(ft).kind;
            // A member of a bare type parameter is the deliberate never-dropped cell (`forget`'s): the
            // union is how a generic body abandons a value on purpose.
            if fk == TypeKind::TYPE_POINTER || fk == TypeKind::TYPE_REFERENCE || fk == TypeKind::TYPE_GENERIC {
                continue;
            }
            if !self.tc_type_is_free(ft) {
                continue;
            }
            let fsp = unsafe (*a).at_const(fnd.as_data.field.name).as_data.name.text;
            if fields.len() != 0 {
                fields.push_str("', '");
            }
            fields.push_str(diag::span_str(self.source, fsp.start, fsp.end));
        }
        if fields.len() == 0 {
            return;
        }
        self.errors.emit_span(
            sname,
            format(
                "union '{}' has owning fields ('{}') but no 'free': unions never free implicitly",
                nm,
                fields.as_str(),
            ),
        );
        self.errors.note(format("implement Free for '{}' and free the ACTIVE member there", nm));
    }
    fn tc_member_owns(self: &mut Self, om: ModuleId, member: NodeId, gp: *const DefId, ga: *const TypeId, gn: i32) bool {
        let ft = self.tc_member_type(self.node_type_in(om, member), gp, ga, gn);
        if ft == TYPE_NONE {
            return false;
        }
        let fk = self.type_at(ft).kind;
        if fk == TypeKind::TYPE_POINTER || fk == TypeKind::TYPE_REFERENCE {
            return false;
        }
        return self.tc_type_is_free(ft);
    }
    // A member type `ft` of an aggregate whose parameters `gp` are bound to `ga`. A fully concrete
    // instantiation substitutes; otherwise only a member that IS a parameter maps to its argument:
    // substituting deeper would intern novel partially-generic instances into the pool (they emit as
    // undefined C type names), so a nested member keeps the declaration's parameter, whose verdict is
    // the conservative one (it owns, it is not Copy).
    fn tc_member_type(self: &mut Self, ft: TypeId, gp: *const DefId, ga: *const TypeId, gn: i32) TypeId {
        if ft == TYPE_NONE || gn <= 0 {
            return ft;
        }
        let mut conc = true;
        for k in 0..gn {
            if !unsafe (*self.cur_ast()).type_concrete(unsafe ga[k as usize]) {
                conc = false;
            }
        }
        if conc {
            return self.subst_type(ft, gp, ga, gn);
        }
        let y = *self.type_at(ft);
        if y.kind == TypeKind::TYPE_GENERIC {
            for k in 0..gn {
                if unsafe gp[k as usize].module == y.module && unsafe gp[k as usize].node == y.as_data.decl {
                    return unsafe ga[k as usize];
                }
            }
        }
        return ft;
    }
    fn tc_type_derives_free(self: &mut Self, om: ModuleId, od: NodeId, gp: *const DefId, ga: *const TypeId, gn: i32) bool {
        let a = self.mod_ast(om);
        let dn = *unsafe (*a).at_const(od);
        let is_enum = dn.kind == NodeKind::NODE_ENUM;
        if dn.kind != NodeKind::NODE_STRUCT && !is_enum {
            return false;
        }
        if !is_enum && dn.as_data.aggregate.is_union {
            return false;
        }
        let key = om as u64 << 32 | od as u64;
        if gn == 0 {
            switch self.free_derive_memo.get(&key) {
                Some(v) => {
                    return *v == 2u64;
                },
                _ => {},
            };
        }
        let mut owns = false;
        let is_tuple = dn.as_data.aggregate.is_tuple;
        let ms = dn.as_data.aggregate.members;
        let mids = unsafe (*a).list(ms);
        for i in 0..ms.len {
            let mid = unsafe mids[i as usize];
            let mn = *unsafe (*a).at_const(mid);
            // Tuple members are bare type nodes; named members carry their type in field.ty.
            if !is_enum && (mn.kind == NodeKind::NODE_FIELD || is_tuple) {
                if self.tc_member_owns(om, mid, gp, ga, gn) {
                    owns = true;
                }
            } else if is_enum && mn.kind == NodeKind::NODE_VARIANT {
                let pids = unsafe (*a).list(mn.as_data.variant.payload);
                for k in 0..mn.as_data.variant.payload.len {
                    let pid = unsafe pids[k as usize];
                    if self.tc_member_owns(om, pid, gp, ga, gn) {
                        owns = true;
                    }
                }
            }
        }
        // The caller (`tc_type_is_free`) holds this type on top of the busy stack: the verdict is
        // final only when the members assumed nothing about a type entered before it.
        if gn == 0 && self.derive_low >= self.derive_busy.len() as i64 - 1 {
            self.free_derive_memo.insert(
                key,
                if owns {
                    2u64;
                } else {
                    1u64;
                },
            );
        }
        return owns;
    }
    // Does a value of `ty` occupy no bytes? A struct with no fields, or whose every field is itself
    // zero-sized (`Global`, any allocator tag). The depth cap breaks reference cycles.
    fn tc_type_is_zero_sized(self: &mut Self, ty: TypeId, depth: u32) bool {
        if ty == TYPE_NONE || depth > 8 {
            return false;
        }
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_ARRAY {
            return !y.arr_sym() && y.as_data.arr.len == 0 || self.tc_type_is_zero_sized(y.as_data.arr.elem, depth + 1);
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(ty, &mut om, &mut od, &mut gp, &mut ga, &mut gn) {
            return false;
        }
        let dn = unsafe (*self.mod_ast(om)).at_const(od);
        if dn.kind != NodeKind::NODE_STRUCT {
            // An enum carries a tag; a union is as big as its widest member.
            return false;
        }
        let is_tuple = dn.as_data.aggregate.is_tuple;
        let ms = dn.as_data.aggregate.members;
        for i in 0..ms.len {
            let fid = unsafe (*self.mod_ast(om)).list(ms)[i as usize];
            if !is_tuple && unsafe (*self.mod_ast(om)).at_const(fid).kind != NodeKind::NODE_FIELD {
                continue;
            }
            let ft0 = if is_tuple {
                self.lower_type_in(om, fid);
            } else {
                self.decl_type_in(om, fid);
            };
            let ft = self.subst_type(ft0, &gp[0], &ga[0], gn);
            if !self.tc_type_is_zero_sized(ft, depth + 1) {
                return false;
            }
        }
        return true;
    }

    // The stateful allocator a constant of `ty` would EMBED, or TYPE_NONE. A constant's storage is static
    // data no allocator provided, so an allocator value stored beside it describes memory that does not
    // exist, and a state field holding a compile-time pointer bakes that block into the binary as
    // read-only data the allocator could never legally hand out. Walks stored fields only: a pointer is
    // not embedded state, and elements a program deliberately stores are data, not the container's
    // allocator.
    fn tc_const_alloc_state(self: &mut Self, ty: TypeId, depth: u32) TypeId {
        if ty == TYPE_NONE || depth > 8 {
            return TYPE_NONE;
        }
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_ARRAY {
            return self.tc_const_alloc_state(y.as_data.arr.elem, depth + 1);
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(ty, &mut om, &mut od, &mut gp, &mut ga, &mut gn) {
            return TYPE_NONE;
        }
        if unsafe (*self.mod_ast(om)).at_const(od).kind != NodeKind::NODE_STRUCT {
            return TYPE_NONE;
        }
        let is_tuple = unsafe (*self.mod_ast(om)).at_const(od).as_data.aggregate.is_tuple;
        let ms = unsafe (*self.mod_ast(om)).at_const(od).as_data.aggregate.members;
        for i in 0..ms.len {
            let fid = unsafe (*self.mod_ast(om)).list(ms)[i as usize];
            if !is_tuple && unsafe (*self.mod_ast(om)).at_const(fid).kind != NodeKind::NODE_FIELD {
                continue;
            }
            let ft0 = if is_tuple {
                self.lower_type_in(om, fid);
            } else {
                self.decl_type_in(om, fid);
            };
            let ft = self.subst_type(ft0, &gp[0], &ga[0], gn);
            if ft == TYPE_NONE {
                continue;
            }
            let fk = self.type_at(ft).kind;
            if fk == TypeKind::TYPE_POINTER || fk == TypeKind::TYPE_REFERENCE {
                // A pointer field is not embedded state.
                continue;
            }
            if self.tc_is_stateful_allocator(ft) {
                return ft;
            }
            let inner = self.tc_const_alloc_state(ft, depth + 1);
            if inner != TYPE_NONE {
                return inner;
            }
        }
        return TYPE_NONE;
    }

    // Does `ty` implement Allocator AND occupy bytes? Those bytes are the state a constant cannot carry.
    fn tc_is_stateful_allocator(self: &mut Self, ty: TypeId) bool {
        if self.tc_type_is_zero_sized(ty, 0) {
            return false;
        }
        let h = self.ph_allocator;
        if h.node == NODE_NONE {
            return false;
        }
        return self.type_satisfies(ty, DefId { module: h.mid, node: h.node }, 0);
    }

    fn tc_param_has_free_bound(self: &Self, m: ModuleId, gp: NodeId) bool {
        let a = self.mod_ast(m);
        let bs = unsafe (*a).at_const(gp).as_data.generic_param.bounds;
        for i in 0..bs.len {
            let bd = unsafe (*a).resolution_def(unsafe (*a).list(bs)[i as usize]);
            if self.is_free_iface(bd) {
                return true;
            }
        }
        return false;
    }
    // Is interface `d` the `Copy` marker, or does its superinterface closure reach it? The same bounded
    // breadth-first walk as the borrow checker's `Owner::iface_requires_copy`, so both agree.
    fn tc_iface_requires_copy(self: &mut Self, d: DefId) bool {
        if d.node == NODE_NONE || unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_INTERFACE {
            return false;
        }
        let mut clo = Array::<DefId, 16> {};
        let n = self.dyn_super_closure(d, &mut clo[0], 16);
        for i in 0..n {
            if self.is_copy_iface(clo[i as usize]) {
                return true;
            }
        }
        return false;
    }

    // Is one of `bs` a `fn` bound (`*is_fn` set, the result is its `move` mark) or a bound that reaches
    // `Copy` (the result is false)? True when neither: the bounds leave the parameter owning.
    fn tc_bounds_own(self: &mut Self, m: ModuleId, bs: NodeList, is_fn: &mut bool) bool {
        let a = self.mod_ast(m);
        for i in 0..bs.len {
            let bid = unsafe (*a).list(bs)[i as usize];
            if unsafe (*a).at_const(bid).kind == NodeKind::NODE_FUNCTION_TYPE {
                *is_fn = true;
                return unsafe (*a).at_const(bid).as_data.function_type.is_move;
            }
            if self.tc_iface_requires_copy(unsafe (*a).resolution_def(bid)) {
                return false;
            }
        }
        return true;
    }

    /// Does a value of the type parameter `gp` own? Rust's default: yes, unless its bounds (inline or in
    /// a `where` clause that applies in the current function, see `Ast::where_scope`) reach `Copy`. A
    /// `fn` bound keeps its own rule: `fn move` owns, a plain `fn` copies. `Self` in an interface's
    /// default body is copyable only when the interface requires `Copy`. Mirrors the borrow checker's
    /// `Owner::param_owns`.
    pub fn tc_param_owns(self: &mut Self, m: ModuleId, gp: NodeId) bool {
        let a = self.mod_ast(m);
        let k = unsafe (*a).at_const(gp).kind;
        if k == NodeKind::NODE_INTERFACE {
            return !self.tc_iface_requires_copy(DefId { module: m, node: gp });
        }
        if k != NodeKind::NODE_GENERIC_PARAM {
            return true;
        }
        let mut is_fn = false;
        let r = self.tc_bounds_own(m, unsafe (*a).at_const(gp).as_data.generic_param.bounds, &mut is_fn);
        if is_fn || !r {
            return r;
        }
        let at = if m == self.cur_module() {
            self.icx.current_fn;
        } else {
            NODE_NONE;
        };
        for w in 0..unsafe (*a).where_bounds.len() {
            let sc = unsafe (*a).where_scope(w, gp, at);
            if sc >= WHERE_IN {
                // The verdict depends on the current function: keep it out of `type_free_memo`.
                self.derive_low = -1;
            }
            if sc == WHERE_OWN || sc == WHERE_IN {
                let pred = unsafe (*a).at_const(unsafe (*a).where_bounds.at(w).pred).as_data.where_predicate;
                let rw = self.tc_bounds_own(m, pred.bounds, &mut is_fn);
                if is_fn || !rw {
                    return rw;
                }
            }
        }
        return true;
    }

    /// Does a value of `ty` own memory (i.e. is it Free)? An explicit Free extend decides first (its
    /// per-param Free bounds re-checked against the instance args); an instance it does not cover, and
    /// a type with no such extend, DERIVE Free
    /// when any field/payload owns, transitively: unions never derive. Owning closures (a by-copy Free
    /// capture) and owned `Box<dyn>` count too. References/pointers peel to their referent: callers that
    /// must treat a borrow as non-owning gate on the pointer kind first.
    pub fn tc_type_is_free(self: &mut Self, ty: TypeId) bool {
        if ty == TYPE_NONE {
            return false;
        }
        let d = ty_dense(ty);
        let c = memo2_get(&self.type_free_memo, d);
        if c >= 0 {
            return c != 0;
        }
        // Cycle and depth guard. `derive_busy` holds the types on the walk's stack, keyed by type
        // (so `W<W<String>>` and `W<String>` are distinct entries). A type met again assumes false:
        // the verdict is a union over members, so a cycle adds nothing and false is the least
        // fixpoint. That assumption is exact for the type that opened the cycle only, so a verdict
        // is memoized only when it assumed nothing about a type entered before it. `derive_low` is
        // the lowest stack index assumed so far (FREE_BUSY_NONE: none; -1: never memoize, after a
        // depth cut, which only an ever-growing chain of substitutions reaches, or a verdict that
        // read a `where` bound scoped to the current function).
        let key = ty as u64;
        for b in 0..self.derive_busy.len() {
            if self.derive_busy[b] == key {
                if b as i64 < self.derive_low {
                    self.derive_low = b as i64;
                }
                return false;
            }
        }
        if self.derive_busy.len() >= FREE_WALK_MAX {
            self.derive_low = -1;
            return false;
        }
        let outer = self.derive_low;
        self.derive_busy.push(key);
        let at = self.derive_busy.len() as i64 - 1;
        self.derive_low = FREE_BUSY_NONE;
        let r = self.tc_type_is_free_impl(ty);
        let _ = self.derive_busy.pop();
        let exact = self.derive_low >= at;
        if exact || outer < self.derive_low {
            self.derive_low = outer;
        }
        if exact {
            memo2_set(&mut self.type_free_memo, d, r);
        }
        return r;
    }

    fn tc_type_is_free_impl(self: &mut Self, ty: TypeId) bool {
        let y0 = *self.type_at(ty);
        if y0.kind == TypeKind::TYPE_FUNCTION {
            return self.fn_owns(ty);
        }
        if y0.kind == TypeKind::TYPE_DYN {
            return y0.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8;
        }
        if y0.kind == TypeKind::TYPE_GENERIC {
            return self.tc_param_owns(y0.module, y0.as_data.decl);
        }
        if y0.kind == TypeKind::TYPE_ASSOC {
            return true; // `T::Output` is known per instance only: it owns, as an unbounded parameter does
        }
        if y0.kind == TypeKind::TYPE_ARRAY {
            // An array owns exactly what its elements own (the borrow checker's owner rule).
            return self.tc_type_is_free(y0.as_data.arr.elem);
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(ty), &mut om, &mut od, &mut gp, &mut ga, &mut gn) {
            return false;
        }
        // The (first) Free extend of a (module, decl) is a parse-time fact; memoize it and
        // re-run only the per-instance bound check below. 0 = "no Free extend".
        let key = om as u64 << 32 | od as u64;
        let mut fm: ModuleId = 0;
        let mut fx = NODE_NONE;
        let mut have = false;
        switch self.free_ext_memo.get(&key) {
            Some(v) => {
                if *v == 0u64 {
                    return self.tc_type_derives_free(om, od, &gp[0], &ga[0], gn);
                }
                fm = (*v >> 32) as ModuleId;
                fx = (*v & 0xFFFFFFFFu64) as NodeId;
                have = true;
            },
            _ => {},
        };
        if !have {
            let mut c = self.ext_begin(om, od);
            while !have {
                let e = self.ext_next(&mut c);
                if e.node == NODE_NONE {
                    break;
                }
                let a = self.mod_ast(e.module);
                let it = unsafe (*a).at_const(e.node);
                if it.as_data.extend_def.interface_type != NODE_NONE && self.is_free_iface(
                    unsafe (*a).resolution_def(it.as_data.extend_def.interface_type),
                ) {
                    fm = e.module;
                    fx = e.node;
                    have = true;
                }
            }
            if !have {
                self.free_ext_memo.insert(key, 0u64);
                return self.tc_type_derives_free(om, od, &gp[0], &ga[0], gn);
            }
            self.free_ext_memo.insert(key, fm as u64 << 32 | fx as u64);
        }
        let fa = self.mod_ast(fm);
        let gens = unsafe (*fa).at_const(fx).as_data.extend_def.generics;
        let mut k: u32 = 0;
        while k < gens.len && k as i32 < gn {
            let gid = unsafe (*fa).list(gens)[k as usize];
            if self.tc_param_has_free_bound(fm, gid) && !self.tc_type_is_free(ga[k as usize]) {
                // The extend does not cover this instance: it derives Free from its members.
                return self.tc_type_derives_free(om, od, &gp[0], &ga[0], gn);
            }
            k = k + 1;
        }
        return true;
    }

    // Does user `free` method `md` destroy `target`? Its extend covers an instance only when
    // every argument of a `Free`-bounded parameter owns memory (the rule `tc_type_is_free` applies).
    fn tc_free_covers(self: &mut Self, target: TypeId, md: DefId) bool {
        let extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if extnode == NODE_NONE || !self.aggregate_of(target, &mut tm, &mut td, &mut gp, &mut ga, &mut gn) {
            return true;
        }
        let gens = unsafe (*self.mod_ast(md.module)).at_const(extnode).as_data.extend_def.generics;
        let mut k: u32 = 0;
        while k < gens.len && k as i32 < gn {
            let gid = unsafe (*self.mod_ast(md.module)).list(gens)[k as usize];
            if self.tc_param_has_free_bound(md.module, gid) && !self.tc_type_is_free(ga[k as usize]) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }

    fn method_extend_bounds_hold(self: &mut Self, target: TypeId, md: DefId) bool {
        if target == TYPE_NONE || md.node == NODE_NONE {
            return true;
        }
        let extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
        if extnode == NODE_NONE {
            return true;
        }
        let ia = self.mod_ast(md.module);
        let gens = unsafe (*ia).at_const(extnode).as_data.extend_def.generics;
        if gens.len == 0 {
            return true;
        }
        let mut tm: ModuleId = 0;
        let mut td = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(target), &mut tm, &mut td, &mut gp, &mut ga, &mut gn) {
            return true;
        }
        let mut ea = Tys8 {};
        let en = self.tc_ext_args(md.module, extnode, &ga[0], gn, &mut ea[0]);
        return en < 0 || en == gens.len as i32 && self.ext_bounds_hold(md.module, extnode, &ea[0], en, 0);
    }
    fn err_method_extend_bounds(self: &mut Self, at: tok::Span, target: TypeId, md: DefId) {
        let ty = self.type_buf(self.strip(target));
        let ma = self.mod_ast(md.module);
        let mn = unsafe (*ma).at_const(unsafe (*ma).at_const(md.node).as_data.function.name).as_data.name.text;
        self.errors.emit_span(
            at,
            format(
                "cannot call '{}::{}': unsatisfied interface bounds",
                str::from_cstr(&ty[0]),
                diag::span_str(self.mod_src(md.module), mn.start, mn.end),
            ),
        );
        self.errors.note(format("these bounds come from the extend block that defines the method"));
    }

    fn mark_format_helpers(self: &mut Self) {
        if self.fmt_marked {
            return;
        }
        let sh = self.ph_string;
        if sh.node == NODE_NONE {
            return;
        }
        self.fmt_marked = true;
        // Resolved by decl with no receiver: they land in always_methods, which is what the print
        // lowering needs: it names them for whatever String instance it happens to build.
        self.mark_recv = TYPE_NONE;
        self.mark_n += 1;
        let fh: []str = FORMAT_HELPERS;
        for k in 0..fh.len() {
            self.find_method_cstr(sh.mid, sh.node, fh[k]);
        }
    }

    fn resolve_conversion(self: &mut Self, name: tok::Span, want: TypeId) DefId {
        let is_into = span_is(self.source, name, "into");
        let is_try = span_is(self.source, name, "try_into");
        if !is_into && !is_try || want == TYPE_NONE {
            return DefId { module: 0, node: NODE_NONE };
        }
        let mut m: ModuleId = 0;
        let mut decl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(self.strip(want), &mut m, &mut decl, &mut gp, &mut ga, &mut gn) {
            return DefId { module: 0, node: NODE_NONE };
        }
        if is_try {
            if gn < 1 {
                return DefId { module: 0, node: NODE_NONE };
            }
            if !self.aggregate_of(self.strip(ga[0]), &mut m, &mut decl, &mut gp, &mut ga, &mut gn) {
                return DefId { module: 0, node: NODE_NONE };
            }
        }
        let mut lit = "from";
        if is_try {
            lit = "try_from";
        }
        return self.find_method_cstr(m, decl, lit);
    }

    // The type a `.into()` / `.try_into()` call builds, when `mname` is one of those and it resolved to
    // the mirror `from` / `try_from`. That is the type whose generic arguments the call substitutes
    // through; TYPE_NONE for any ordinary method call. Mirrors resolve_conversion's unwrapping: the
    // fallible pair names `Result<Target, E>`, so the target is its first argument.
    fn tc_conversion_target(self: &mut Self, mname: NodeId, md: DefId, want: TypeId) TypeId {
        if md.node == NODE_NONE || want == TYPE_NONE {
            return TYPE_NONE;
        }
        let nsp = self.name_span(mname);
        let is_into = span_is(self.source, nsp, "into");
        let is_try = span_is(self.source, nsp, "try_into");
        if !is_into && !is_try {
            return TYPE_NONE;
        }
        let mn = unsafe (*self.mod_ast(md.module)).at_const(md.node);
        if mn.kind != NodeKind::NODE_FUNCTION {
            return TYPE_NONE;
        }
        let fnm = unsafe (*self.mod_ast(md.module)).at_const(mn.as_data.function.name).as_data.name.text;
        let msrc = self.mod_src(md.module);
        let mut ok = span_is(msrc, fnm, "from");
        if is_try {
            ok = span_is(msrc, fnm, "try_from");
        }
        if !ok {
            return TYPE_NONE;
        }
        if !is_try {
            return self.strip(want);
        }
        let mut m: ModuleId = 0;
        let mut decl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        let ok2 = self.aggregate_of(self.strip(want), &mut m, &mut decl, &mut gp, &mut ga, &mut gn);
        if !ok2 || gn < 1 {
            return TYPE_NONE;
        }
        return self.strip(ga[0]);
    }

    fn tc_find_from_for(self: &mut Self, target: TypeId, src: TypeId) DefId {
        let ty = *self.type_at(self.strip(target));
        if ty.kind != TypeKind::TYPE_STRUCT && ty.kind != TypeKind::TYPE_ENUM {
            return DefId { module: 0, node: NODE_NONE };
        }
        let m = ty.module;
        let decl = ty.as_data.decl;
        let mut c = self.ext_begin(m, decl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                return e;
            }
            let mm = e.module;
            let a = self.mod_ast(mm);
            let it = unsafe (*a).at_const(e.node);
            if it.as_data.extend_def.generics.len != 0 {
                continue;
            }
            let ms = it.as_data.extend_def.items;
            for j in 0..ms.len {
                let mid = unsafe (*a).list(ms)[j as usize];
                let mn = unsafe (*a).at_const(mid);
                if mn.kind == NodeKind::NODE_FUNCTION && span_is(
                    self.mod_src(mm),
                    unsafe (*a).at_const(mn.as_data.function.name).as_data.name.text,
                    "from",
                ) {
                    let ps = mn.as_data.function.params;
                    if ps.len == 1 && self.decl_type_in(mm, unsafe (*a).list(ps)[0]) == src {
                        self.tc_mark_method_used(DefId { module: mm, node: mid });
                        return DefId { module: mm, node: mid };
                    }
                }
            }
        }
    }

    // The conformance of `src` (declaration `(tmod, tdecl)`) to `iface` with the arguments of dyn
    // instance `di`: DYN_CONF_OK with that extend in `conf`; DYN_CONF_NONE when `src` has no
    // applicable conformance to `iface`; DYN_CONF_REPORTED when every applicable one has other
    // arguments (DYN_CONF_NONE under `probe`, which reports nothing).
    fn tc_dyn_conf(
        self: &mut Self,
        src: TypeId,
        tmod: ModuleId,
        tdecl: NodeId,
        iface: DefId,
        di: &TyInstance,
        dyn_ty: TypeId,
        sp: tok::Span,
        probe: bool,
        conf: &mut DefId,
    ) u8 {
        let mut ta = Tys8 {};
        let mut tn: i32 = 0;
        let sy = *self.type_at(src);
        if sy.kind == TypeKind::TYPE_INSTANCE {
            let inst = *unsafe (*self.cur_ast()).instance(sy.as_data.inst);
            while tn < inst.n as i32 {
                ta[tn as usize] = unsafe inst.args[tn as usize];
                tn += 1;
            }
        }
        let mut other = DefId { module: 0, node: NODE_NONE };
        let mut c = self.ext_begin(tmod, tdecl);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE {
                break;
            }
            let ea0 = self.mod_ast(e.module);
            let itn = unsafe (*ea0).at_const(e.node).as_data.extend_def.interface_type;
            if itn == NODE_NONE {
                continue;
            }
            let tr = unsafe (*ea0).resolution_def(itn);
            if tr.module != iface.module || tr.node != iface.node {
                continue;
            }
            let mut ea = Tys8 {};
            let g = self.tc_ext_args(e.module, e.node, &ta[0], tn, &mut ea[0]);
            if g < 0 {
                continue;
            }
            if !self.tc_conf_args_eq(e.module, e.node, iface, &ea, g, di) {
                if other.node == NODE_NONE {
                    other = e;
                }
                continue;
            }
            if !self.ext_bounds_hold(e.module, e.node, &ea[0], g, 1) {
                return DYN_CONF_NONE;
            }
            *conf = e;
            return DYN_CONF_OK;
        }
        if other.node == NODE_NONE || probe {
            return DYN_CONF_NONE;
        }
        let sn = self.type_buf(src);
        let dn = self.type_buf(dyn_ty);
        self.errors.emit_span(
            sp,
            format(
                "cannot erase '{}' to '{}': '{}' conforms to this interface only with other arguments",
                str::from_cstr(&sn[0]),
                str::from_cstr(&dn[0]),
                str::from_cstr(&sn[0]),
            ),
        );
        let oa = self.mod_ast(other.module);
        let osp = unsafe (*oa).at_const(unsafe (*oa).at_const(other.node).as_data.extend_def.interface_type).span;
        let site = diag::render_site(
            self.mod_src(other.module),
            unsafe (*self.package).modules[other.module as usize].file.as_str(),
            osp.start,
            osp.end - osp.start,
        );
        self.errors.note(format("a conformance with other arguments is declared here\n{}", site.as_str()));
        return DYN_CONF_REPORTED;
    }

    // Whether extend `ext` of module `m`, its own parameters bound to `ea[0..g]`, conforms to `iface`
    // with exactly the arguments of `di` (type and const arguments, declared defaults filled in).
    fn tc_conf_args_eq(self: &mut Self, m: ModuleId, ext: NodeId, iface: DefId, ea: &Tys8, g: i32, di: &TyInstance) bool {
        return self.tc_conf_args_match(m, ext, iface, ea, g, TYPE_NONE, &di.args[0], di.n);
    }

    // Whether extend `ext` of module `m`, its own parameters bound to `ea[0..g]`, conforms to `iface`
    // with the arguments `wa[0..wn]` (declared defaults filled in, the interface's `Self` read as
    // `self_ty` unless TYPE_NONE; a wanted TYPE_NONE or error type matches any).
    fn tc_conf_args_match(
        self: &mut Self,
        m: ModuleId,
        ext: NodeId,
        iface: DefId,
        ea: &Tys8,
        g: i32,
        self_ty: TypeId,
        wa: *const TypeId,
        wn: i32,
    ) bool {
        let a = self.mod_ast(m);
        let itn = unsafe (*a).at_const(ext).as_data.extend_def.interface_type;
        if unsafe (*a).at_const(itn).kind != NodeKind::NODE_TYPE_PATH {
            return false;
        }
        let mut ca = Tys8 {};
        let cn = self.tc_path_args(m, itn, iface, &mut ca[0]) as i32;
        if cn != wn {
            return false;
        }
        let gens = unsafe (*a).at_const(ext).as_data.extend_def.generics;
        let mut ps = Defs8 {};
        let mut pa = Tys8 {};
        for i in 0..g {
            ps[i as usize] = DefId { module: m, node: unsafe (*a).list(gens)[i as usize] };
            pa[i as usize] = ea[i as usize];
        }
        let mut np = g;
        if self_ty != TYPE_NONE && np < 8 {
            ps[np as usize] = iface;
            pa[np as usize] = self_ty;
            np += 1;
        }
        for k in 0..cn {
            let w = unsafe wa[k as usize];
            if w != TYPE_NONE && w != TYPE_ERROR && self.subst_type(ca[k as usize], &ps[0], &pa[0], np) != w {
                return false;
            }
        }
        return true;
    }

    // The method named `name` that extend `ext` itself defines; node NODE_NONE when it defines none
    // (or `ext` is none).
    fn tc_ext_method(self: &Self, ext: DefId, name: str) DefId {
        if ext.node == NODE_NONE {
            return ext;
        }
        let a = self.mod_ast(ext.module);
        let ms = unsafe (*a).at_const(ext.node).as_data.extend_def.items;
        for j in 0..ms.len {
            let mid = unsafe (*a).list(ms)[j as usize];
            let mn = unsafe (*a).at_const(mid);
            if mn.kind == NodeKind::NODE_FUNCTION && span_is(
                self.mod_src(ext.module),
                unsafe (*a).at_const(mn.as_data.function.name).as_data.name.text,
                name,
            ) {
                return DefId { module: ext.module, node: mid };
            }
        }
        return DefId { module: 0, node: NODE_NONE };
    }

    // `probe` = answer without observable effects (no diagnostics, no dyn-use recording): a path that
    // would diagnose reports false instead. (A probe may still warm idempotent caches/method-used
    // marks: harmless.) Used by the redundant-cast lint.
    fn dyn_coerce_alloc(self: &mut Self, node: NodeId, src: TypeId, dyn_ty: TypeId, balloc: TypeId, probe: bool) bool {
        let dy = *self.type_at(dyn_ty);
        let iface = DefId { module: dy.module, node: unsafe (*self.cur_ast()).dyn_decl_of(&dy) };
        let sy = *self.type_at(src);
        let sp = unsafe (*self.cur_ast()).at_const(node).span;
        if sy.kind == TypeKind::TYPE_GENERIC {
            if probe {
                return false;
            }
            self.errors.emit_span(sp, format("cannot erase a generic type parameter to 'dyn'"));
            return true;
        }
        let mut tmod: ModuleId = 0;
        let mut tdecl = NODE_NONE;
        if !self.aggregate_decl(src, &mut tmod, &mut tdecl) {
            if sy.kind == TypeKind::TYPE_BUILTIN && unsafe (*self.package).builtin_decl(sy.as_data.builtin) != NODE_NONE {
                tmod = unsafe (*self.package).core_module;
                tdecl = unsafe (*self.package).builtin_decl(sy.as_data.builtin);
            } else {
                return false;
            }
        }
        // A generic interface: the conformance must have the dyn type's arguments, or the vtable
        // would run another conformance's methods on these argument types.
        let di = *unsafe (*self.cur_ast()).instance(dy.as_data.inst);
        let mut conf = DefId { module: 0, node: NODE_NONE };
        if di.n != 0 {
            let r = self.tc_dyn_conf(src, tmod, tdecl, iface, &di, dyn_ty, sp, probe, &mut conf);
            if r != DYN_CONF_OK {
                return r == DYN_CONF_REPORTED;
            }
        } else if !self.type_satisfies(src, iface, 0) {
            return false;
        }
        let ia = self.mod_ast(iface.module);
        let isrc = self.mod_src(iface.module);
        let items = unsafe (*ia).at_const(iface.node).as_data.interface_def.items;
        for i in 0..items.len {
            let mid = unsafe (*ia).list(items)[i as usize];
            if self.dyn_method(iface.module, mid) {
                let mn = unsafe (*ia).at_const(unsafe (*ia).at_const(mid).as_data.function.name).as_data.name.text;
                let mut nmb = Buf96 {};
                unsafe stdio::snprintf(
                    &mut nmb[0],
                    96,
                    "%.*s".ptr() as *const char,
                    (mn.end - mn.start) as i32,
                    src_at(isrc, mn.start),
                );
                // The vtable calls the matching conformance's own method: mark that one used.
                let cm = self.tc_ext_method(conf, str::from_cstr(&nmb[0]));
                if cm.node != NODE_NONE {
                    self.tc_mark_method_used(cm);
                    continue;
                }
                if self.find_method_cstr(tmod, tdecl, str::from_cstr(&nmb[0])).node != NODE_NONE {
                    continue;
                }
                let mut emod: ModuleId = 0;
                if unsafe (*ia).at_const(mid).as_data.function.body != NODE_NONE && self.find_extend_as(
                    tmod,
                    tdecl,
                    iface,
                    &mut emod,
                ) != NODE_NONE {
                    continue;
                }
                if probe {
                    return false;
                }
                let tn = self.type_buf(src);
                self.errors.emit_span(
                    sp,
                    format(
                        "cannot erase '{}' to 'dyn': method '{}' has no emittable implementation",
                        str::from_cstr(&tn[0]),
                        str::from_cstr(&nmb[0]),
                    ),
                );
                self.errors.note(format("implement the method in an 'extend .. as ..' block or give it a default body"));
                return true;
            }
        }
        if probe {
            // Erasure would succeed; record nothing.
            return true;
        }
        // Synthesize (superinterface, src) uses FIRST so codegen emits their vtables (the root
        // vtable's __super_* fields point at them); the real use goes last so dyn_at[node] wins.
        let mut sclo = Tys8 {};
        let nsc = self.tc_dyn_supers(iface, &di.args[0], di.n, dy.qualifier, &mut sclo[0], 8);
        let mut si: i32 = 1;
        while si < nsc {
            unsafe (*self.cur_ast()).add_dyn_use_alloc(node, src, sclo[si as usize], balloc);
            si = si + 1;
        }
        unsafe (*self.cur_ast()).add_dyn_use_alloc(node, src, dyn_ty, balloc);
        return true;
    }

    // Attach the ` as T` deletion fix for the unnecessary-cast lints. Grouping parens are dropped
    // without re-spanning (`(x) as T` records x's span without the parens), so the deletion starts
    // after any closing parens between the expression end and the `as` keyword.
    @c.cold
    fn tc_cast_drop_fix(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let csp = unsafe (*a).at_const(id).span;
        let esp = unsafe (*a).at_const(unsafe (*a).at_const(id).as_data.cast.expression).span;
        if esp.end >= csp.end || esp.start < csp.start {
            return;
        }
        let mut fs = esp.end;
        let mut j = esp.end;
        while j < csp.end && self.source[j as usize] != b'a' {
            if self.source[j as usize] == b')' {
                fs = j + 1;
            }
            j = j + 1;
        }
        self.errors.fix(fs, csp.end, 0);
    }

    // Lint: `E as P` at a position expecting exactly P, where E converts to P implicitly; the cast
    // is redundant (dropping it typechecks identically). Delegates to compatible_in(probe): whatever
    // the language accepts implicitly, this flags, by construction. Casts with no expected type stay
    // exempt (an unannotated `let x = E as P` uses the cast to pick the binding's type), as do pinned
    // (suffixed) literals via the probe itself. Fires once per cast node.
    @c.cold
    fn tc_lint_redundant_coalesce(self: &mut Self, expected: TypeId, node: NodeId) {
        let a = self.cur_ast();
        // Peel `move`/`unsafe` wrappers: `unsafe (E as P)` is as redundant as the bare cast.
        let mut nid = node;
        while unsafe (*a).at_const(nid).kind == NodeKind::NODE_UNARY && (unsafe (*a).at_const(nid).as_data.unary.op == TokenType::Move || unsafe (*a).at_const(
            nid,
        ).as_data.unary.op == TokenType::Unsafe) {
            nid = unsafe (*a).at_const(nid).as_data.unary.operand;
        }
        if unsafe (*a).at_const(nid).kind != NodeKind::NODE_CAST {
            return;
        }
        let opn = unsafe (*a).at_const(nid).as_data.cast.expression;
        if !unsafe (*a).valid(opn) {
            return;
        }
        let ot = unsafe (*a).type_of(opn);
        if ot == expected {
            // Same-type casts belong to the existing unnecessary-cast lint.
            return;
        }
        if ot == TYPE_NONE {
            // Only the `null` literal is untyped by design; any other operand without a recorded
            // type (an inference term still open) proves nothing, and the probe would accept it.
            let on = unsafe (*a).at_const(opn);
            if on.kind != NodeKind::NODE_LITERAL || on.as_data.literal.token_type != TokenType::Null {
                return;
            }
        }
        if !self.compatible_in(expected, opn, true) {
            return;
        }
        let key = self.cur_module() as u64 << 32 | nid as u64;
        if self.reported.contains(&key) {
            return;
        }
        self.reported.insert(key);
        let mut f = Buf96 {};
        if ot == TYPE_NONE {
            unsafe stdio::snprintf(&mut f[0], 96, "%s".ptr() as *const char, "null".ptr() as *const char);
        } else {
            self.render_type(ot, &mut f[0], 96);
        }
        let d = self.type_buf(expected);
        let sp = unsafe (*a).at_const(nid).span;
        self.errors.warn_span(
            sp,
            format(
                "unnecessary cast: '{}' converts to '{}' implicitly here",
                str::from_cstr(&f[0]),
                str::from_cstr(&d[0]),
            ),
        );
        self.tc_cast_drop_fix(nid);
    }

    fn compatible(self: &mut Self, expected: TypeId, node: NodeId) bool {
        return self.compatible_in(expected, node, false);
    }

    // The oracle, plus the USER-DEFINED conversions. A type that provides `From<S>` accepts an S
    // wherever it is expected, which is what makes a library integer usable where a built-in one is:
    // `let a: u128 = 42`, `a + 1`, `f(a)`. Tried only after every built-in rule has failed, so nothing
    // that converted before converts differently now.
    fn compatible_in(self: &mut Self, expected: TypeId, node: NodeId, probe: bool) bool {
        if self.compatible_core(expected, node, probe) {
            return true;
        }
        return self.tc_coerce_from(expected, node, probe);
    }

    fn tc_coerce_from(self: &mut Self, expected: TypeId, node: NodeId, probe: bool) bool {
        if expected == TYPE_NONE || node == NODE_NONE || self.icx.coerce_depth > 2 {
            return false;
        }
        let want = self.strip(expected);
        let wk = self.type_at(want).kind;
        if wk != TypeKind::TYPE_STRUCT && wk != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let mut m: ModuleId = 0;
        let mut decl = NODE_NONE;
        if !self.aggregate_decl(want, &mut m, &mut decl) {
            return false;
        }
        let md = self.find_method_cstr(m, decl, "from");
        if md.node != NODE_NONE {
            let pt = self.tc_method_param(want, md, 0);
            // Only NUMERIC conversions apply implicitly. A `From<str>` on an owning type would let a
            // bare string literal allocate without a call in sight; a `From<u64>` on an integer type is
            // the built-in widening rule extended to library integers, which is all this is for.
            if pt != TYPE_NONE && pt != want && self.is_int(pt) {
                self.icx.coerce_depth = self.icx.coerce_depth + 1;
                let fits = self.compatible_in(pt, node, true);
                self.icx.coerce_depth = self.icx.coerce_depth - 1;
                if fits {
                    if !probe {
                        // Re-run unprobed so a literal takes the CONVERSION's parameter type.
                        self.icx.coerce_depth = self.icx.coerce_depth + 1;
                        let _ = self.compatible_in(pt, node, false);
                        self.icx.coerce_depth = self.icx.coerce_depth - 1;
                        unsafe (*self.cur_ast()).set_coerce(node, want, md);
                    }
                    return true;
                }
            }
        }
        return self.tc_coerce_named(want, node, "widen", probe);
    }

    // `expr as T` where the source or target is a generic INSTANCE. Returns true when it settled the
    // cast (by recording a conversion, or by reporting it invalid) and false to leave the cast to
    // the built-in rules. Only VALUE casts are taken (both sides an instance, struct or builtin):
    // pointer, reference and enum casts keep their existing meaning.
    fn tc_cast_conv(self: &mut Self, id: NodeId, expr: NodeId, src: TypeId, dst: TypeId) bool {
        let sk = self.type_at(src).kind;
        let dk = self.type_at(dst).kind;
        if sk != TypeKind::TYPE_INSTANCE && dk != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let value_kinds = (sk == TypeKind::TYPE_INSTANCE || sk == TypeKind::TYPE_STRUCT || sk == TypeKind::TYPE_BUILTIN) && (dk == TypeKind::TYPE_INSTANCE || dk == TypeKind::TYPE_STRUCT || dk == TypeKind::TYPE_BUILTIN);
        if !value_kinds {
            return false;
        }
        // Target an instance: the implicit path first (identical to the binding this cast is redundant
        // with), then the C-semantics `cast_unsigned` / `cast_signed` pair.
        if dk == TypeKind::TYPE_INSTANCE {
            // The C-semantics pair first: total over widths and signedness, so a narrowing cast never
            // reaches `widen` (whose narrowing rejection is for the IMPLICIT path). The implicit path
            // then covers what the pair cannot: a literal or built-in value source, through `from`.
            if self.tc_coerce_named(dst, expr, "cast_unsigned", false) || self.tc_coerce_named(
                dst,
                expr,
                "cast_signed",
                false,
            ) {
                return true;
            }
            if self.tc_coerce_from(dst, expr, false) {
                return true;
            }
            // A FLOAT source: the target's own truncating conversion, `from_f64`.
            if sk == TypeKind::TYPE_BUILTIN && bt_is_float(self.type_at(src).as_data.builtin) {
                let mut m: ModuleId = 0;
                let mut decl = NODE_NONE;
                if self.aggregate_decl(dst, &mut m, &mut decl) {
                    let md = self.find_method_cstr(m, decl, "from_f64");
                    if md.node != NODE_NONE {
                        unsafe (*self.cur_ast()).set_coerce(expr, dst, md);
                        return true;
                    }
                }
            }
        }
        // Target a built-in scalar: the value's own conversion, and the built-in cast then narrows;
        // integers through to_u64/to_i64, floats through to_f32/to_f64.
        if sk == TypeKind::TYPE_INSTANCE && dk == TypeKind::TYPE_BUILTIN {
            let dst_int = self.is_int(dst);
            let dst_flt = bt_is_float(self.type_at(dst).as_data.builtin);
            let mut m: ModuleId = 0;
            let mut decl = NODE_NONE;
            if (dst_int || dst_flt) && self.aggregate_decl(src, &mut m, &mut decl) {
                let mut md = DefId { module: 0, node: NODE_NONE };
                if dst_int {
                    md = self.find_method_cstr(m, decl, "to_u64");
                    if md.node == NODE_NONE {
                        md = self.find_method_cstr(m, decl, "to_i64");
                    }
                } else {
                    if self.type_at(dst).as_data.builtin == BuiltinType::BT_F32 {
                        md = self.find_method_cstr(m, decl, "to_f32");
                    }
                    if md.node == NODE_NONE {
                        md = self.find_method_cstr(m, decl, "to_f64");
                    }
                }
                if md.node != NODE_NONE {
                    let ret = self.tc_method_ret(src, md);
                    if ret != TYPE_NONE && self.type_at(ret).kind == TypeKind::TYPE_BUILTIN {
                        unsafe (*self.cur_ast()).set_coerce(expr, ret, md);
                        return true;
                    }
                }
            }
        }
        let s = self.type_buf(src);
        let d = self.type_buf(dst);
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        self.errors.emit_span(
            sp,
            format("invalid cast from '{}' to '{}'", str::from_cstr(&s[0]), str::from_cstr(&d[0])),
        );
        return true;
    }

    // Are `want` and `actual` instances of one decl differing in a single CONST argument, with the
    // source's larger? The shape of a width parameter: what makes `UInt<256> -> UInt<128>` narrowing.
    const fn tc_const_arg_shrinks(self: &mut Self, want: TypeId, actual: TypeId) bool {
        let wy = *self.type_at(want);
        let ay = *self.type_at(actual);
        if wy.kind != TypeKind::TYPE_INSTANCE || ay.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let wi = *unsafe (*self.cur_ast()).instance(wy.as_data.inst);
        let ai = *unsafe (*self.cur_ast()).instance(ay.as_data.inst);
        if wi.decl != ai.decl || wi.module != ai.module || wi.n != 1 || ai.n != 1 {
            return false;
        }
        let wa = *self.type_at(wi.args[0]);
        let aa = *self.type_at(ai.args[0]);
        if wa.kind != TypeKind::TYPE_CONST || aa.kind != TypeKind::TYPE_CONST {
            return false;
        }
        return aa.cval() > wa.cval();
    }

    // A conversion that is generic in its SOURCE: `widen<M>(&UInt<M>)` (and `cast_unsigned<M>` for `as`)
    // accepts any width, so one method covers every pair. M is not fixed by the receiver, so it is
    // inferred by unifying each candidate's declared parameter against what is there: the
    // candidates are same-named overloads (a signed and an unsigned source), and unification is what
    // picks between them. The instantiation is recorded here because this use site is not a call node,
    // so nothing else will record it.
    fn tc_coerce_named(self: &mut Self, want: TypeId, node: NodeId, lit: str, probe: bool) bool {
        let mut m: ModuleId = 0;
        let mut decl = NODE_NONE;
        if !self.aggregate_decl(want, &mut m, &mut decl) {
            return false;
        }
        let actual = self.strip(unsafe (*self.cur_ast()).type_of(node));
        if actual == TYPE_NONE || actual == want || !self.type_at(actual).concrete {
            return false;
        }
        let mut cands = Defs8 {};
        let mut nc = self.find_method_all(m, decl, tok::Span::empty(), lit, &mut cands);
        if nc as usize > cands.len() {
            nc = cands.len() as i32;
        }
        for c in 0..nc {
            let md = cands[c as usize];
            let gens = unsafe (*self.mod_ast(md.module)).at_const(md.node).as_data.function.generics;
            if gens.len == 0 || gens.len > 8 {
                continue;
            }
            let mut pt = self.tc_method_param(want, md, 0);
            if pt == TYPE_NONE {
                continue;
            }
            if self.type_at(pt).kind == TypeKind::TYPE_REFERENCE {
                pt = self.type_at(pt).as_data.elem;
            }
            let mark = self.icx.sv.probe_begin();
            let mut prm = Defs8 {};
            let mut bnd = Tys8 {};
            let mut np: i32 = 0;
            while np < gens.len as i32 && np < 8 {
                let pgid = unsafe (*self.mod_ast(md.module)).list(gens)[np as usize];
                prm[np as usize] = DefId { module: md.module, node: pgid };
                let is_c9 = unsafe (*self.mod_ast(md.module)).at_const(pgid).as_data.generic_param.is_const;
                let _ = self.icx.sv.map_param(DefId { module: md.module, node: pgid }, is_c9);
                np = np + 1;
            }
            self.tc_infer_ev(pt, actual, false);
            let mut all = true;
            for i in 0..np {
                bnd[i as usize] = self.icx.sv.s_resolve(mark.base + i as u32, it_conv_join);
                if bnd[i as usize] == TYPE_NONE {
                    all = false;
                }
            }
            self.icx.sv.probe_end(&mark);
            if !all || self.subst_type(pt, &prm[0], &bnd[0], np) != actual {
                continue;
            }
            // `widen` is the IMPLICIT conversion, so it must be lossless: when source and target are
            // instances of one decl differing in a single const argument, a larger source is refused
            // here: the mismatch then reports normally instead of tripping the method's own
            // static_assert in the emitted C.
            if lit == "widen" && self.tc_const_arg_shrinks(want, actual) {
                continue;
            }
            if !probe {
                self.mark_recv = want;
                self.mark_n += 1;
                self.tc_mark_method_used(md);
                unsafe (*self.cur_ast()).set_coerce(node, want, md);
                unsafe (*self.cur_ast()).set_type_args(node, &bnd[0], np as u8);
            }
            return true;
        }
        return false;
    }

    // The one implicit-conversion oracle. `probe` answers "would this coerce, cleanly?" with no
    // observable effects: paths that would diagnose report false, and nothing is recorded
    // (set_type/dyn uses). The redundant-cast lint probes the cast OPERAND against the expected type
    // through this, so it covers every implicit conversion by construction.
    fn compatible_core(self: &mut Self, expected: TypeId, node: NodeId, probe: bool) bool {
        let actual = unsafe (*self.cur_ast()).type_of(node);
        if expected == TYPE_ERROR || actual == TYPE_ERROR {
            return true; // a rejected type was reported where it was rejected
        }
        if actual == TYPE_NONE && expected != TYPE_NONE {
            // `null` types as TYPE_NONE; don't let the wildcard below accept it for value types
            // (str, structs, ints): it is only a raw-pointer/fn-pointer literal. References are
            // never null: accepting one here would emit C that takes the address of an rvalue.
            let n = unsafe (*self.cur_ast()).at_const(node);
            if n.kind == NodeKind::NODE_LITERAL && n.as_data.literal.token_type == TokenType::Null {
                let ek = self.type_at(expected).kind;
                return ek == TypeKind::TYPE_POINTER || ek == TypeKind::TYPE_FUNCTION;
            }
        }
        if expected == TYPE_NONE || expected == actual {
            if self.lint && expected != TYPE_NONE && !probe {
                self.tc_lint_redundant_coalesce(expected, node);
            }
            return true;
        }
        if actual == TYPE_NONE {
            // An untyped expression: only lenient as error recovery. In an error-free compile an
            // untyped node reaching a compat check is a typechecker hole, not a wildcard match.
            return self.errors.errors.len() != 0;
        }
        let ex = *self.type_at(expected);
        let ac = *self.type_at(actual);
        if ac.kind == TypeKind::TYPE_NEVER {
            return true;
        }
        // Two unfolded const-generic expressions are interned per NODE, so the same `{N * 2}` written in
        // a return type and in the value returned are different ids. They denote the same width, and
        // structural equality is what says so until a substitution folds both to one value.
        if self.tc_const_expr_same(expected, actual) {
            return true;
        }
        // A reference coalesces to its raw-pointer form (`&T` -> `*const T`, `&mut T` -> `*mut T`).
        // Normalizing it here lets the single pointer rule below apply transitively, so `&T` reaches
        // `*const void` via `*const T` (ref -> ptr -> void) with no special case. A BARE `*T` accepts
        // references of either mutability (`&T`/`&mut T` -> `*T`); the reverse (pointer -> reference)
        // is never implicit: it needs an explicit cast inside `unsafe`.
        let mut acp = ac;
        if ac.kind == TypeKind::TYPE_REFERENCE && ex.kind == TypeKind::TYPE_POINTER {
            // Coercing a reference into a RAW POINTER ERASES the borrow. A raw pointer carries no
            // region, and it is precisely the boundary at which this language hands lifetime
            // responsibility to the programmer (dereferencing it needs `unsafe`). Keeping the borrow
            // live would pin the referent for as long as whatever stored the pointer lives (which
            // the checker cannot see) and would reject correct code like
            // `interp_new(&mut p)` where the parameter is `*mut Package`.
            acp.kind = TypeKind::TYPE_POINTER;
            if acp.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 {
                acp.qualifier = TypeQualifier::TYPE_QUAL_CONST as u8;
            }
            if ex.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 {
                acp.qualifier = TypeQualifier::TYPE_QUAL_NONE as u8;
            }
        }
        if ex.kind == TypeKind::TYPE_REFERENCE && ac.kind == TypeKind::TYPE_REFERENCE && ex.as_data.elem == ac.as_data.elem && ex.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 && ac.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
            return true;
        }
        if ex.kind == TypeKind::TYPE_POINTER && acp.kind == TypeKind::TYPE_POINTER && (ex.as_data.elem == acp.as_data.elem || ex.as_data.elem == Ast::builtin(
            BuiltinType::BT_VOID,
        )) && (ex.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8 || acp.qualifier != TypeQualifier::TYPE_QUAL_CONST as u8) {
            return true;
        }
        if ex.kind == TypeKind::TYPE_FUNCTION && ac.kind == TypeKind::TYPE_FUNCTION {
            if self.fn_compatible(expected, actual) {
                return true;
            }
            // The actual may be a GENERIC function named as a value: its declared signature still
            // mentions its type parameters, so it matches only once they are bound.
            return !probe && self.tc_coerce_generic_fn(expected, node);
        }
        if ex.kind == TypeKind::TYPE_ARRAY && ac.kind == TypeKind::TYPE_ARRAY {
            // An array literal types with its own extent. Against a count it is strict both ways
            // for plain positional literals: excess initializers are a C constraint violation
            // downstream, missing ones a silent zero-fill. A designated literal may underfill (sparse
            // zero-fill is that feature) and then takes the expected length, but never exceeds. A
            // precise error beats the generic mismatch, so emit and report compatible.
            let an = unsafe (*self.cur_ast()).at_const(node);
            let lit = an.kind == NodeKind::NODE_ARRAY_LITERAL && !an.as_data.array_literal.repeat;
            let same_len = ex.arr_sym() == ac.arr_sym() && (ex.as_data.arr.len == ac.as_data.arr.len || ex.arr_sym() && self.tc_const_expr_same(
                ex.as_data.arr.len,
                ac.as_data.arr.len,
            ));
            if !same_len && lit && !ex.arr_sym() && !ac.arr_sym() {
                let mut sparse = false;
                let ext = self.tc_array_lit_extent(node, &mut sparse);
                let bad = ext > ex.as_data.arr.len as i64 || !sparse && ext < ex.as_data.arr.len as i64;
                if bad && probe {
                    return false;
                }
                if bad {
                    self.errors.emit_span(
                        an.span,
                        format(
                            "array literal has {} elements but the expected type has length {}",
                            ext,
                            ex.as_data.arr.len,
                        ),
                    );
                    return true;
                }
                if !probe {
                    let wide = unsafe (*self.cur_ast()).intern_type(
                        Ty {
                            kind: TypeKind::TYPE_ARRAY,
                            as_data: TyAs { arr: TyArr { elem: ac.as_data.arr.elem, len: ex.as_data.arr.len } },
                        },
                    );
                    unsafe (*self.cur_ast()).set_type(node, wide);
                }
            } else if !same_len {
                return false;
            }
            if ex.as_data.arr.elem == ac.as_data.arr.elem {
                return true;
            }
            let ee = self.type_at(ex.as_data.arr.elem).kind;
            let ae = self.type_at(ac.as_data.arr.elem).kind;
            return ee == TypeKind::TYPE_FUNCTION && ae == TypeKind::TYPE_FUNCTION && self.fn_compatible(
                ex.as_data.arr.elem,
                ac.as_data.arr.elem,
            );
        }
        if ac.kind == TypeKind::TYPE_ARRAY {
            let mut selem: TypeId = TYPE_NONE;
            let sk = self.slice_kind(expected, &mut selem);
            if sk != 0 && selem == ac.as_data.arr.elem && (sk == 1 || self.is_assignable(node)) {
                if !probe && unsafe (*self.cur_ast()).at_const(node).kind == NodeKind::NODE_CALL {
                    // A call keeps its array result type (its C result is the array): the view is
                    // a conversion of that value.
                    unsafe (*self.cur_ast()).set_coerce(node, expected, DefId { module: 0, node: NODE_NONE });
                } else if !probe {
                    unsafe (*self.cur_ast()).set_type(node, expected);
                }
                return true;
            }
        }
        // Deref coercion: `&W` reaches a `&Target` parameter through W's Deref, the same step
        // `w.method()` already takes. Only tightens (`&mut W` also satisfies `&Target`); the reverse
        // would hand out mutability the source never had.
        if ex.kind == TypeKind::TYPE_REFERENCE && ac.kind == TypeKind::TYPE_REFERENCE && ex.as_data.elem != ac.as_data.elem && (ex.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 || ac.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8) {
            let mut dm = DefId { module: 0, node: NODE_NONE };
            let dt = self.tc_deref_step(ac.as_data.elem, &mut dm, ex.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8);
            if dt == ex.as_data.elem && dt != TYPE_NONE {
                if !probe {
                    self.tc_record_deref(node, ac.as_data.elem, dm, dt);
                    unsafe (*self.cur_ast()).set_type(node, expected);
                }
                return true;
            }
        }
        if ex.kind == TypeKind::TYPE_DYN {
            let exsig = self.tc_dyn_fn_sig(&ex);
            let sp = unsafe (*self.cur_ast()).at_const(node).span;
            if ac.kind == TypeKind::TYPE_DYN {
                let qual_ok = ex.qualifier == ac.qualifier || ex.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8 && ac.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
                if self.tc_dyn_same(&ex, &ac) {
                    return qual_ok;
                }
                // upcast: dyn X coerces to dyn Y when Y is in X's superinterface closure; the fat
                // value's data is reused and the vtable comes from the __super_* embed.
                if qual_ok && exsig == TYPE_NONE && unsafe (*self.mod_ast(ac.module)).at_const(
                    unsafe (*self.cur_ast()).dyn_decl_of(&ac),
                ).kind == NodeKind::NODE_INTERFACE {
                    // A generic superinterface is reached with the arguments the hierarchy gives it.
                    let adi = *unsafe (*self.cur_ast()).instance(ac.as_data.inst);
                    let mut uclo = Tys8 {};
                    let nu = self.tc_dyn_supers(
                        DefId { module: ac.module, node: unsafe (*self.cur_ast()).dyn_decl_of(&ac) },
                        &adi.args[0],
                        adi.n,
                        TypeQualifier::TYPE_QUAL_NONE as u8,
                        &mut uclo[0],
                        8,
                    );
                    let mut ui: i32 = 1;
                    while ui < nu {
                        let uy = *self.type_at(uclo[ui as usize]);
                        if self.tc_dyn_same(&ex, &uy) {
                            if !probe {
                                unsafe (*self.cur_ast()).add_dyn_use(node, actual, expected);
                            }
                            return true;
                        }
                        ui = ui + 1;
                    }
                }
                return false;
            }
            if ex.qualifier != TypeQualifier::TYPE_QUAL_NONE as u8 && ac.kind == TypeKind::TYPE_REFERENCE {
                let rel = *self.type_at(ac.as_data.elem);
                if rel.kind == TypeKind::TYPE_DYN {
                    if rel.qualifier != TypeQualifier::TYPE_QUAL_NONE as u8 || !self.tc_dyn_same(&ex, &rel) {
                        return false;
                    }
                    if !probe {
                        unsafe (*self.cur_ast()).add_dyn_use(node, TYPE_NONE, expected);
                    }
                    return true;
                }
                if exsig != TYPE_NONE {
                    if rel.kind != TypeKind::TYPE_FUNCTION || !self.dynfn_sig_ok(exsig, ac.as_data.elem) {
                        return false;
                    }
                    if !probe {
                        unsafe (*self.cur_ast()).add_dyn_use(node, ac.as_data.elem, expected);
                    }
                    return true;
                }
                if ex.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 && ac.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 {
                    return false;
                }
                return self.dyn_coerce_alloc(node, ac.as_data.elem, expected, TYPE_NONE, probe);
            }
            if ex.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 && ac.kind == TypeKind::TYPE_INSTANCE {
                // `Box<T>` to `Box<dyn I>`, and a boxed closure to `Box<dyn fn(..)>`: the payload
                // pointer moves into the fat value.
                let mut inner: TypeId = TYPE_NONE;
                let mut galloc = false;
                if self.tc_box_of(&ac, &mut inner, &mut galloc) && (exsig == TYPE_NONE || self.type_at(inner).kind == TypeKind::TYPE_FUNCTION) {
                    let it2 = *unsafe (*self.cur_ast()).instance(ac.as_data.inst);
                    let mut balloc = TYPE_NONE;
                    if !galloc && it2.n >= 2 {
                        balloc = it2.args[1];
                        // The 2-word fat value cannot carry allocator state: the free glue
                        // reconstructs the allocator via Default.
                        let dh = unsafe (*self.package).prelude_lookup("Default", true);
                        let ddef = DefId { module: dh.mid, node: dh.node };
                        if !self.type_satisfies(balloc, ddef, 0) {
                            if probe {
                                return false;
                            }
                            self.errors.emit_span(
                                sp,
                                format(
                                    "the Box allocator must implement 'Default' to be erased to 'Box<dyn I>' (its state is not carried)",
                                ),
                            );
                            return true;
                        }
                    }
                    if exsig == TYPE_NONE {
                        return self.dyn_coerce_alloc(node, inner, expected, balloc, probe);
                    }
                    if self.type_at(inner).fn_sig() || !self.dynfn_sig_ok(exsig, inner) {
                        return false;
                    }
                    if !probe {
                        unsafe (*self.cur_ast()).add_dyn_use_alloc(node, inner, expected, balloc);
                    }
                    return true;
                }
            }
            if exsig != TYPE_NONE && ac.kind == TypeKind::TYPE_FUNCTION {
                if ac.fn_sig() {
                    if probe {
                        return false;
                    }
                    self.errors.emit_span(
                        sp,
                        format("a runtime 'fn(..)' pointer cannot erase to 'dyn fn'; wrap it in a closure"),
                    );
                    return true;
                }
                if !self.dynfn_sig_ok(exsig, actual) {
                    return false;
                }
                if ex.qualifier != TypeQualifier::TYPE_QUAL_NONE as u8 && self.fn_is_capturing(actual) {
                    if probe {
                        return false;
                    }
                    self.errors.emit_span(
                        sp,
                        format("a capturing closure must be borrowed to view it as '&dyn fn': write '&f'"),
                    );
                    return true;
                }
                if !probe {
                    unsafe (*self.cur_ast()).add_dyn_use(node, actual, expected);
                }
                return true;
            }
            return false;
        }
        // Literal-only arithmetic takes the expected numeric type as one literal does, before widening:
        // `1 << 31` expecting i64 is 2147483648, not the widened i32 result.
        if ex.kind == TypeKind::TYPE_BUILTIN && ac.kind == TypeKind::TYPE_BUILTIN && !self.tc_lit_is_leaf(node) {
            let lk = self.tc_lit_kind(node);
            if lk == 1 && bt_is_int(ex.as_data.builtin) {
                if probe {
                    return self.tc_lit_set_int(node, expected, false, true, false);
                }
                let _ = self.tc_lit_set_int(node, expected, true, false, false);
                return true;
            }
            if lk == 2 && bt_is_float(ex.as_data.builtin) {
                if !probe {
                    self.tc_lit_set_flt(node, expected);
                    let _ = self.tc_lit_frange(node, expected, true);
                }
                return true;
            }
        }
        if ex.kind == TypeKind::TYPE_BUILTIN && ac.kind == TypeKind::TYPE_BUILTIN && bt_widens(
            ac.as_data.builtin,
            ex.as_data.builtin,
        ) {
            return true;
        }
        // An unsuffixed literal under `&`/`&mut` adopts the expected pointee type, at every depth
        // (`&1` for `&u64`, `&&1` for `&&u8`); any other operand keeps pointee equality.
        let mut rdepth: u32 = 0;
        if (ex.kind == TypeKind::TYPE_REFERENCE || ex.kind == TypeKind::TYPE_POINTER) && ac.kind == TypeKind::TYPE_REFERENCE && (ex.qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 || ac.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8) && self.tc_ref_lit(
            node,
            &mut rdepth,
        ) != NODE_NONE {
            let opnd = unsafe (*self.cur_ast()).at_const(node).as_data.unary.operand;
            if !self.compatible_core(ex.as_data.elem, opnd, probe) {
                return false;
            }
            if !probe {
                unsafe (*self.cur_ast()).set_type(
                    node,
                    unsafe (*self.cur_ast()).intern_type(
                        Ty {
                            kind: TypeKind::TYPE_REFERENCE,
                            qualifier: ac.qualifier,
                            as_data: TyAs { elem: unsafe (*self.cur_ast()).type_of(opnd) },
                        },
                    ),
                );
            }
            return true;
        }
        let mut vid = node;
        let v0 = unsafe (*self.cur_ast()).at_const(node);
        if v0.kind == NodeKind::NODE_UNARY && v0.as_data.unary.op == TokenType::Minus {
            vid = v0.as_data.unary.operand;
        }
        let v = unsafe (*self.cur_ast()).at_const(vid);
        if v.kind != NodeKind::NODE_LITERAL {
            return false;
        }
        let et = *self.type_at(expected);
        let tt = v.as_data.literal.token_type;
        if tt == TokenType::IntegerLiteral {
            if self.tc_literal_pinned(vid) {
                return false;
            }
            // An integer literal never becomes a float (`let f: f32 = 1;` is an error).
            if et.kind != TypeKind::TYPE_BUILTIN || !(bt_is_int(et.as_data.builtin) || bt_is_complex(et.as_data.builtin)) {
                return false;
            }
            if bt_is_int(et.as_data.builtin) {
                let mut mag: u64 = 0;
                let neg = vid != node;
                if neg && bt_is_uint(et.as_data.builtin) {
                    if probe {
                        return false;
                    }
                    self.err_neg_unsigned(node, expected);
                    return true;
                }
                let got = self.lit_mag(vid, &mut mag);
                if got && !tc_lit_in_range(et.as_data.builtin, mag, neg, self.tc_ptr32()) {
                    if probe {
                        return false;
                    }
                    self.err_lit_range(node, expected);
                    return true;
                }
                if !neg && !probe {
                    unsafe (*self.cur_ast()).set_type(node, expected);
                }
            }
            return true;
        }
        if tt == TokenType::CharacterLiteral {
            return et.kind == TypeKind::TYPE_BUILTIN && bt_is_int(et.as_data.builtin);
        }
        if tt == TokenType::FloatLiteral {
            if self.tc_literal_pinned(vid) {
                return false;
            }
            let okf = et.kind == TypeKind::TYPE_BUILTIN && (bt_is_float(et.as_data.builtin) || bt_is_complex(
                et.as_data.builtin,
            ));
            let mut fv: f64 = 0.0;
            if okf && (et.as_data.builtin == BuiltinType::BT_F32 || et.as_data.builtin == BuiltinType::BT_C32) && self.tc_flit_value(
                vid,
                &mut fv,
            ) && fv.abs() >= F32_LIMIT {
                if probe {
                    return false;
                }
                let tn = self.type_buf(expected);
                let sp = unsafe (*self.cur_ast()).at_const(node).span;
                self.errors.emit_span(sp, format("float literal is out of range for '{}'", str::from_cstr(&tn[0])));
                return true;
            }
            // Record the CONTEXT's type on the literal, exactly as the integer branch does. The emitted C
            // is right either way (the literal passes through textually) but the compile-time
            // evaluator folds from the RECORDED type, and an f64 context with an f32 record folded
            // `f64_bits(0.1)` at single precision.
            if okf && !probe && !bt_is_complex(et.as_data.builtin) {
                unsafe (*self.cur_ast()).set_type(node, expected);
            }
            return okf;
        }
        if tt == TokenType::StringLiteral || tt == TokenType::MatchertextLiteral {
            if et.kind != TypeKind::TYPE_POINTER || et.qualifier != TypeQualifier::TYPE_QUAL_CONST as u8 {
                return false;
            }
            let pe = self.type_at(et.as_data.elem);
            if pe.kind != TypeKind::TYPE_BUILTIN || pe.as_data.builtin != BuiltinType::BT_CHAR && pe.as_data.builtin != BuiltinType::BT_U8 {
                return false;
            }
            if !probe {
                unsafe (*self.cur_ast()).set_type(node, expected);
            }
            return true;
        }
        if tt == TokenType::Null {
            return et.kind == TypeKind::TYPE_POINTER;
        }
        return false;
    }

    fn return_list_is_explicit_void(self: &mut Self, rets: NodeList) bool {
        if rets.len != 1 {
            return false;
        }
        let r0 = unsafe (*self.cur_ast()).list(rets)[0];
        let tn = unsafe (*self.cur_ast()).slot_type_node(r0);
        return self.is_void_type(self.resolve_type(tn));
    }

    fn range_type(self: &mut Self, id: NodeId, start: TypeId, end: TypeId) TypeId {
        let n = unsafe (*self.cur_ast()).at_const(id).as_data.pattern_range;
        let has_start = n.start != NODE_NONE;
        let has_end = n.end != NODE_NONE;
        if start == TYPE_ERROR || end == TYPE_ERROR {
            return TYPE_ERROR;
        }
        let start_ok = !has_start || start == TYPE_NONE || self.is_int(start);
        let end_ok = !has_end || end == TYPE_NONE || self.is_int(end);
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        if !start_ok || !end_ok {
            self.errors.emit_span(sp, format("range bounds must be integers"));
            return TYPE_NONE;
        }
        if !has_start {
            return end;
        }
        if !has_end {
            return start;
        }
        if start == TYPE_NONE {
            return end;
        }
        if end == TYPE_NONE || start == end {
            return start;
        }
        if self.is_integer_literal_node(n.start) && self.compatible(end, n.start) {
            return end;
        }
        if self.is_integer_literal_node(n.end) && self.compatible(start, n.end) {
            return start;
        }
        self.err_mismatch(n.end, start);
        return TYPE_NONE;
    }

    // Every read and write of a `static mut` is an unsafe operation, on the same footing as dereferencing a
    // raw pointer. A `static mut` is unsynchronised shared mutable state reachable from any task without
    // being captured, so it slips past the `Send`/`Sync` check on a `launch`: there is nothing to capture
    // and so nothing to check. Nothing in the type system can prove such an access is free of a data race,
    // so the compiler stops guessing and makes the author say so: the marker is the audit trail.
    //
    // Use an `Atomic`, or a `Mutex`, or keep the state in the task. `unsafe` here is a claim that the
    // accesses are ordered by something the compiler cannot see.
    fn tc_static_mut_use(self: &mut Self, id: NodeId, d: DefId) {
        if d.node == NODE_NONE {
            return;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if dn.kind != NodeKind::NODE_CONST || !dn.as_data.const_def.is_static_mut {
            return;
        }
        if self.tc_needs_unsafe() {
            self.err_unsafe(unsafe (*self.cur_ast()).at_const(id).span, "accessing a 'static mut'");
        }
    }
    const fn tc_path_static_mut(self: &Self, id: NodeId) bool {
        let d = self.tc_path_def(id);
        return self.tc_path_const(id) && unsafe (*self.mod_ast(d.module)).at_const(d.node).as_data.const_def.is_static_mut;
    }
    // Does this qualified path name a constant? A constant emits as a named object with an address,
    // so `mod::C` is a PLACE; borrowing through it (`mod::TABLE.at(i)`) is rooted in that object,
    // not in a temporary. (Assignability is decided separately, and a constant is never assignable.)
    const fn tc_path_const(self: &Self, id: NodeId) bool {
        let d = self.tc_path_def(id);
        return d.node != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_CONST;
    }
    // The declaration qualified path `id` names: the path's own resolution, else its member's.
    const fn tc_path_def(self: &Self, id: NodeId) DefId {
        let d = unsafe (*self.cur_ast()).resolution_def(id);
        if d.node != NODE_NONE {
            return d;
        }
        return unsafe (*self.cur_ast()).resolution_def(unsafe (*self.cur_ast()).at_const(id).as_data.member.member);
    }
    fn is_assignable(self: &mut Self, node_in: NodeId) bool {
        let node = unsafe (*self.cur_ast()).peel(node_in, false);
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(node).kind;
        if nk == NodeKind::NODE_IDENTIFIER {
            let dd = unsafe (*a).resolution_def(node);
            if dd.node != NODE_NONE && dd.module != self.cur_module() {
                let fdn = unsafe (*self.mod_ast(dd.module)).at_const(dd.node);
                return fdn.kind == NodeKind::NODE_CONST && fdn.as_data.const_def.is_static_mut;
            }
            let d = unsafe (*a).resolution(node);
            if d == NODE_NONE {
                return false;
            }
            let dn = unsafe (*a).at_const(d);
            if dn.kind == NodeKind::NODE_CONST {
                return dn.as_data.const_def.is_static_mut;
            }
            // Every caller is a genuine mutation requirement (assignment LHS, `&mut`, `&mut self`
            // receiver, mut-slice coercion): a positive answer through a local binding marks it for
            // the unnecessary-mut lint.
            if dn.kind == NodeKind::NODE_LET {
                if dn.as_data.let_stmt.is_mutable {
                    self.tc_mark_mut_used(d);
                    return true;
                }
                // Split declaration/initialization: an immutable binding declared WITHOUT a value is
                // assignable; the borrow checker enforces exactly-once on every path. Requiring no
                // mutability is what keeps the C emission const-free only for these bindings.
                return dn.as_data.let_stmt.value == NODE_NONE;
            }
            if dn.kind == NodeKind::NODE_PARAMETER {
                if dn.as_data.parameter.is_mutable {
                    self.tc_mark_mut_used(d);
                    return true;
                }
                return false;
            }
            if dn.kind == NodeKind::NODE_PATTERN_NAME {
                if unsafe (*a).at_const(dn.as_data.pattern.name).as_data.name.is_mutable {
                    self.tc_mark_mut_used(d);
                    return true;
                }
                return false;
            }
            if dn.kind == NodeKind::NODE_IDENTIFIER {
                // A tuple-let element: `mut` on the element or on the whole `let`.
                if dn.as_data.name.is_mutable {
                    self.tc_mark_mut_used(d);
                    return true;
                }
                let letn = unsafe (*a).resolution(d);
                if letn != NODE_NONE && unsafe (*a).at_const(letn).kind == NodeKind::NODE_LET && unsafe (*a).at_const(
                    letn,
                ).as_data.let_stmt.is_mutable {
                    self.tc_mark_mut_used(letn);
                    return true;
                }
                return false;
            }
            return false;
        }
        if nk == NodeKind::NODE_UNARY {
            if unsafe (*a).at_const(node).as_data.unary.op != TokenType::Star {
                return false;
            }
            let ot = self.type_at(unsafe (*a).type_of(unsafe (*a).at_const(node).as_data.unary.operand));
            return (ot.kind == TypeKind::TYPE_POINTER || ot.kind == TypeKind::TYPE_REFERENCE) && ot.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
        }
        if nk == NodeKind::NODE_INDEX || nk == NodeKind::NODE_MEMBER {
            if nk == NodeKind::NODE_MEMBER && unsafe (*a).at_const(node).as_data.member.path {
                return self.tc_path_static_mut(node);
            }
            // A member reached through an auto-deref chain mutates only through `deref_mut`; every
            // caller is a genuine mutation requirement, so the hops are patched here.
            if nk == NodeKind::NODE_MEMBER && self.tc_deref_hops_mut(unsafe (*a).at_const(node).as_data.member.member) != TYPE_NONE {
                return false;
            }
            let obj = pick(
                nk == NodeKind::NODE_INDEX,
                unsafe (*a).at_const(node).as_data.index.object,
                unsafe (*a).at_const(node).as_data.member.object,
            );
            let mut oty = unsafe (*a).type_of(obj);
            // `f.value` through a fields(&mut v) binder is as mutable as the subject reference;
            // `f.other` is ALWAYS read-only: it shares value's type (so a generic callee unifies
            // both), and mutability of the place is denied by NAME instead.
            if nk == NodeKind::NODE_MEMBER && oty != TYPE_NONE && self.type_at(oty).kind == TypeKind::TYPE_FIELD_PROJECTION {
                if span_is(self.source, self.name_span(unsafe (*a).at_const(node).as_data.member.member), "other") {
                    return false;
                }
                return self.type_at(oty).qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
            }
            let mut via_ref = false;
            let mut ref_mut = false;
            if nk == NodeKind::NODE_INDEX {
                let mut y = *self.type_at(oty);
                while y.kind == TypeKind::TYPE_REFERENCE {
                    via_ref = true;
                    ref_mut = y.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
                    oty = y.as_data.elem;
                    y = *self.type_at(oty);
                }
            }
            let mut sk: i32 = 0;
            if nk == NodeKind::NODE_INDEX {
                sk = self.slice_kind(oty, null);
            }
            if sk != 0 {
                return sk == 2;
            }
            let ot = *self.type_at(oty);
            if nk == NodeKind::NODE_INDEX && ot.kind == TypeKind::TYPE_GENERIC {
                // Through a bound: a mutated element is `index_mut`'s (`T: IndexMut<E, S>`); the
                // requirement is genuine, so the recorded method is switched here.
                let mut r = TYPE_NONE;
                let ix = unsafe (*a).at_const(node).as_data.index.index;
                if !self.tc_param_bound_provides(ot.module, ot.as_data.decl, "index_mut") {
                    return false;
                }
                // Once per node: a later requirement finds `index_mut` recorded.
                let prev = switch unsafe (*self.cur_ast()).op_method.get(&node) {
                    Some(v) => *v,
                    None => 0u64,
                };
                let pm = (prev >> 32) as ModuleId;
                let pn = (prev & 0xFFFFFFFFu64) as NodeId;
                let done = prev != 0 && span_is(
                    self.mod_src(pm),
                    unsafe (*self.mod_ast(pm)).at_const(unsafe (*self.mod_ast(pm)).at_const(pn).as_data.function.name).as_data.name.text,
                    "index_mut",
                );
                if !done && !self.tc_bound_op(node, oty, "index_mut", ix, &mut r) {
                    return false;
                }
                if via_ref {
                    return ref_mut;
                }
                return self.is_assignable(obj);
            }
            if nk == NodeKind::NODE_INDEX && (ot.kind == TypeKind::TYPE_STRUCT || ot.kind == TypeKind::TYPE_INSTANCE) {
                let mut om: ModuleId = 0;
                let mut od = NODE_NONE;
                if !self.aggregate_decl(oty, &mut om, &mut od) {
                    return false;
                }
                let im = self.find_method_cstr(om, od, "index_mut");
                if im.node == NODE_NONE {
                    return false;
                }
                let ia = self.mod_ast(im.module);
                let irs = unsafe (*ia).at_const(im.node).as_data.function.returns;
                if irs.len != 1 {
                    return false;
                }
                let ir0 = unsafe (*ia).list(irs)[0];
                let itn = unsafe (*ia).slot_type_node(ir0);
                if itn == NODE_NONE || unsafe (*ia).at_const(itn).kind != NodeKind::NODE_REFERENCE_TYPE {
                    return false;
                }
                if via_ref {
                    return ref_mut;
                }
                return self.is_assignable(obj);
            }
            if ot.kind == TypeKind::TYPE_POINTER || ot.kind == TypeKind::TYPE_REFERENCE {
                return ot.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
            }
            if via_ref {
                return ref_mut;
            }
            return self.is_assignable(obj);
        }
        return false;
    }
    /// Syntactic place (lvalue) test; a path member (`E::x`) counts only when it names a 'static mut'.
    pub fn is_place(self: &Self, id: NodeId) bool {
        let node = unsafe (*self.cur_ast()).peel(id, false);
        let n = unsafe (*self.cur_ast()).at_const(node);
        if n.kind == NodeKind::NODE_IDENTIFIER || n.kind == NodeKind::NODE_INDEX {
            return true;
        }
        if n.kind == NodeKind::NODE_MEMBER {
            return !n.as_data.member.path || self.tc_path_static_mut(node) || self.tc_path_const(node);
        }
        if n.kind == NodeKind::NODE_UNARY {
            return n.as_data.unary.op == TokenType::Star;
        }
        return false;
    }
    fn receiver_mutable(self: &mut Self, recv: NodeId) bool {
        let rt = unsafe (*self.cur_ast()).type_of(recv);
        if rt != TYPE_NONE {
            let rty = self.type_at(rt);
            if rty.kind == TypeKind::TYPE_POINTER || rty.kind == TypeKind::TYPE_REFERENCE {
                return rty.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8;
            }
        }
        if self.is_place(recv) {
            return self.is_assignable(recv);
        }
        return true;
    }

    /// True when `decl` is queued for late (post-module) checking.
    pub fn tc_is_late(self: &Self, decl: NodeId) bool {
        for i in 0..self.nlate {
            if unsafe self.late[i as usize] == decl {
                return true;
            }
        }
        return false;
    }

    /// Queue `decl` for late checking (idempotent; drops silently past the fixed capacity).
    pub fn tc_add_late(self: &mut Self, decl: NodeId) {
        if self.tc_is_late(decl) {
            return;
        }
        if self.nlate < 256 {
            let k = self.nlate;
            unsafe self.late[k as usize] = decl;
            self.nlate = k + 1;
        }
    }

    /// Definitely-returns test: a return, a block whose LAST statement returns, an `if` with BOTH
    /// branches returning, or a never-typed expression statement.
    pub fn tc_stmt_returns(self: &Self, id: NodeId) bool {
        if id == NODE_NONE {
            return false;
        }
        let n = unsafe (*self.cur_ast()).at_const(id);
        if n.kind == NodeKind::NODE_RETURN {
            return true;
        }
        if n.kind == NodeKind::NODE_BLOCK {
            let ss = n.as_data.block.statements;
            return ss.len != 0 && self.tc_stmt_returns(unsafe (*self.cur_ast()).list(ss)[(ss.len - 1) as usize]);
        }
        if n.kind == NodeKind::NODE_IF {
            return n.as_data.if_stmt.else_branch != NODE_NONE && self.tc_stmt_returns(n.as_data.if_stmt.then_branch) && self.tc_stmt_returns(
                n.as_data.if_stmt.else_branch,
            );
        }
        if n.kind == NodeKind::NODE_EXPRESSION_STATEMENT {
            let ty = unsafe (*self.cur_ast()).type_of(n.as_data.single.value);
            return ty != TYPE_NONE && self.type_at(ty).kind == TypeKind::TYPE_NEVER;
        }
        return false;
    }

    fn place_index_const(self: &Self, idx: NodeId, out: &mut i64) bool {
        let n = unsafe (*self.cur_ast()).at_const(idx);
        if n.kind != NodeKind::NODE_LITERAL || n.as_data.literal.token_type != TokenType::IntegerLiteral {
            return false;
        }
        let lr = n.as_data.literal.raw;
        let mut p = unsafe (self.source.ptr() + lr.start as usize);
        let mut len = (lr.end - lr.start) as usize;
        let (base, skip) = lit_base_prefix(p, len);
        p = unsafe (p + skip);
        len = len - skip;
        let mut acc: u64 = 0;
        if !lit_digits(p, len, base, 0x7FFFFFFFFFFFFFFFu64, &mut acc) {
            return false;
        }
        *out = acc as i64;
        return true;
    }

    fn tc_type_is_union(self: &Self, ty: TypeId) bool {
        let mut m: ModuleId = 0;
        let mut d = NODE_NONE;
        if ty == TYPE_NONE || !self.aggregate_decl(ty, &mut m, &mut d) {
            return false;
        }
        let dn = unsafe (*self.mod_ast(m)).at_const(d);
        return dn.kind == NodeKind::NODE_STRUCT && dn.as_data.aggregate.is_union;
    }

    /// Decompose a place `x.f[i]...` into its root binding + access steps (leaf-first). Returns the
    /// root local decl, or NODE_NONE when the chain crosses a raw pointer, indexes through a
    /// reference, or does not end at a local binding. A union member access drops the steps below it
    /// (all members overlap).
    pub fn place_decompose(self: &mut Self, place0: NodeId, steps: *mut PStep, nsteps: &mut i32, cap: i32) NodeId {
        *nsteps = 0;
        let a = self.cur_ast();
        let mut place = place0;
        loop {
            let pn = unsafe (*a).at_const(place);
            if pn.kind == NodeKind::NODE_UNARY && (pn.as_data.unary.op == TokenType::Move || pn.as_data.unary.op == TokenType::Unsafe) {
                place = pn.as_data.unary.operand;
                continue;
            }
            if pn.kind == NodeKind::NODE_UNARY && pn.as_data.unary.op == TokenType::Star {
                let op = pn.as_data.unary.operand;
                let ot = unsafe (*a).type_of(op);
                if ot == TYPE_NONE || self.type_at(ot).kind != TypeKind::TYPE_REFERENCE {
                    return NODE_NONE;
                }
                if *nsteps < cap {
                    let k = *nsteps;
                    unsafe steps[k as usize] = PStep { kind: PS_DEREF };
                    *nsteps = k + 1;
                }
                place = op;
                continue;
            }
            let mut base = NODE_NONE;
            let mut step = PStep { kind: PS_FIELD };
            if pn.kind == NodeKind::NODE_MEMBER && !pn.as_data.member.path {
                base = pn.as_data.member.object;
                step.kind = PS_FIELD;
                step.name = self.name_span(pn.as_data.member.member);
            } else if pn.kind == NodeKind::NODE_INDEX {
                base = pn.as_data.index.object;
                step.kind = PS_INDEX;
                let mut v: i64 = 0;
                if self.place_index_const(pn.as_data.index.index, &mut v) {
                    step.index_const = true;
                    step.index_val = v;
                }
            } else {
                break;
            }
            let bt = unsafe (*a).type_of(base);
            if bt == TYPE_NONE {
                return NODE_NONE;
            }
            let btk = *self.type_at(bt);
            let mut union_ty = bt;
            if btk.kind == TypeKind::TYPE_REFERENCE {
                union_ty = btk.as_data.elem;
            }
            let base_union = pn.kind == NodeKind::NODE_MEMBER && self.tc_type_is_union(union_ty);
            if base_union {
                *nsteps = 0;
            }
            if btk.kind == TypeKind::TYPE_REFERENCE {
                if pn.kind == NodeKind::NODE_INDEX {
                    return NODE_NONE;
                }
                if !base_union && *nsteps < cap {
                    let k = *nsteps;
                    unsafe steps[k as usize] = step;
                    *nsteps = k + 1;
                }
                if *nsteps < cap {
                    let k = *nsteps;
                    unsafe steps[k as usize] = PStep { kind: PS_DEREF };
                    *nsteps = k + 1;
                }
                place = base;
                continue;
            }
            if btk.kind == TypeKind::TYPE_POINTER {
                return NODE_NONE;
            }
            if pn.kind == NodeKind::NODE_INDEX && btk.kind != TypeKind::TYPE_ARRAY {
                // An overloaded Index result views the container it was called on, so `v[i]` is a
                // sub-place of `v`; unlike a real array, distinct constant indices prove nothing
                // about distinct storage, so they must keep overlapping.
                step.index_const = false;
            }
            if !base_union && *nsteps < cap {
                let k = *nsteps;
                unsafe steps[k as usize] = step;
                *nsteps = k + 1;
            }
            place = base;
        }
        if unsafe (*a).at_const(place).kind != NodeKind::NODE_IDENTIFIER {
            return NODE_NONE;
        }
        let d = unsafe (*a).resolution_def(place);
        if d.node == NODE_NONE || d.module != self.cur_module() {
            return NODE_NONE;
        }
        let dk = unsafe (*a).at_const(d.node).kind;
        if dk == NodeKind::NODE_PARAMETER || dk == NodeKind::NODE_LET || dk == NodeKind::NODE_PATTERN_NAME || dk == NodeKind::NODE_IDENTIFIER || dk == NodeKind::NODE_FOR || dk == NodeKind::NODE_INLINE_FOR {
            return d.node;
        }
        return NODE_NONE;
    }
    /// Do two places alias? Conservative: same root required; differing field names or differing
    /// constant indices prove disjoint, everything else (unknown indices, step-kind mismatch) reports
    /// overlap. False whenever either place fails to decompose.
    pub fn places_overlap(self: &mut Self, aN: NodeId, bN: NodeId) bool {
        let mut sa = Steps16 {};
        let mut sb = Steps16 {};
        let mut na: i32 = 0;
        let mut nb: i32 = 0;
        let ra = self.place_decompose(aN, &mut sa[0], &mut na, PLACE_MAX_STEPS);
        let rb = self.place_decompose(bN, &mut sb[0], &mut nb, PLACE_MAX_STEPS);
        if ra == NODE_NONE || rb == NODE_NONE || ra != rb {
            return false;
        }
        let mut common = na;
        if nb < na {
            common = nb;
        }
        for i in 0..common {
            let pa = sa[(na - 1 - i) as usize];
            let pb = sb[(nb - 1 - i) as usize];
            if pa.kind != pb.kind {
                return true;
            }
            if pa.kind == PS_FIELD {
                let la = pa.name.end - pa.name.start;
                let lb = pb.name.end - pb.name.start;
                if la != lb || unsafe cstring::memcmp(
                    self.source.ptr() + pa.name.start as usize,
                    self.source.ptr() + pb.name.start as usize,
                    la as usize,
                ) != 0 {
                    return false;
                }
            } else if pa.kind == PS_INDEX && pa.index_const && pb.index_const && pa.index_val != pb.index_val {
                return false;
            }
        }
        return true;
    }

    /// The local binding a place reaches THROUGH a reference (`*p` -> p, `r.f` with `r: &T` -> r), or
    /// NODE_NONE when no hop dereferences a reference binding.
    pub fn place_through_binding(self: &Self, place0: NodeId) NodeId {
        let a = self.cur_ast();
        let mut place = place0;
        loop {
            let pn = unsafe (*a).at_const(place);
            let mut base = NODE_NONE;
            if pn.kind == NodeKind::NODE_UNARY && pn.as_data.unary.op == TokenType::Star {
                base = pn.as_data.unary.operand;
            } else if pn.kind == NodeKind::NODE_MEMBER && !pn.as_data.member.path {
                base = pn.as_data.member.object;
            } else if pn.kind == NodeKind::NODE_INDEX {
                base = pn.as_data.index.object;
            } else {
                return NODE_NONE;
            }
            let bt = unsafe (*a).type_of(base);
            let mut is_ref = false;
            if bt != TYPE_NONE && self.type_at(bt).kind == TypeKind::TYPE_REFERENCE {
                is_ref = true;
            }
            if (pn.kind == NodeKind::NODE_UNARY || is_ref) && unsafe (*a).at_const(base).kind == NodeKind::NODE_IDENTIFIER {
                let d = unsafe (*a).resolution_def(base);
                if d.node != NODE_NONE && d.module == self.cur_module() {
                    return d.node;
                }
                return NODE_NONE;
            }
            place = base;
        }
    }

    /// One pass over the resolution table records, per local decl, the LAST node that
    /// resolves to it. "any use after `after`" then collapses to one compare. Typechecker-added
    /// resolutions never target a value binding except break/continue -> loop node (a `for` node IS
    /// its loop binding), which tc_note_resolution folds in at the set site.
    pub fn tc_build_last_use(self: &mut Self) {
        self.last_use_built = true;
        if self.last_use_view != null {
            return;
        }
        let n = unsafe (*self.cur_ast()).nnodes();
        self.last_use.clear();
        let mut i: usize = 0;
        while i < n {
            self.last_use.push(NODE_NONE);
            i = i + 1;
        }
        let nb9 = unsafe (*self.cur_ast()).nodes.len();
        for k in 0..n {
            let nid = Ast::nth_id_n(nb9, k);
            let rd = unsafe (*self.cur_ast()).resolution_def(nid);
            if rd.node != NODE_NONE && rd.module == self.cur_module() && unsafe (*self.cur_ast()).valid(rd.node) {
                self.last_use.set(unsafe (*self.cur_ast()).dense(rd.node), nid);
            }
        }
    }
    /// The last node resolving to declaration index `dk`, from the shared table or this
    /// checker's own; NODE_NONE past either.
    pub const fn last_use_at(self: &Self, dk: usize) NodeId {
        if self.last_use_view != null {
            if dk < self.last_use_vn {
                return unsafe self.last_use_view[dk];
            }
            return NODE_NONE;
        }
        if dk < self.last_use.len() {
            return self.last_use[dk];
        }
        return NODE_NONE;
    }

    /// Hand the module its shared last-use table (the type check's close): built here when no
    /// item needed it yet.
    pub fn share_last_use(self: &mut Self) {
        if self.last_use_view != null {
            return;
        }
        if !self.last_use_built {
            self.tc_build_last_use();
        }
        unsafe (*self.cur_ast()).last_use = replace(&mut self.last_use, Vector::<NodeId>::new());
        self.last_use_built = false;
    }

    const fn tc_note_resolution(self: &mut Self, ref_id: NodeId, decl: NodeId) {
        if !self.last_use_built || self.last_use_view != null {
            return;
        }
        let dk = unsafe (*self.cur_ast()).dense(decl);
        if dk < self.last_use.len() && ref_id > self.last_use[dk] {
            self.last_use.set(dk, ref_id);
        }
    }

    fn find_extend_item_named(self: &Self, extnode: NodeId, name: tok::Span, nmod: ModuleId) NodeId {
        let a = self.cur_ast();
        let have = unsafe (*a).at_const(extnode).as_data.extend_def.items;
        for j in 0..have.len {
            let hid = unsafe (*a).list(have)[j as usize];
            let hm = unsafe (*a).at_const(hid);
            if hm.kind == NodeKind::NODE_FUNCTION && spans_eq2(
                self.mod_src(nmod),
                name,
                self.source,
                unsafe (*a).at_const(hm.as_data.function.name).as_data.name.text,
            ) {
                return hid;
            }
        }
        return NODE_NONE;
    }
    // An interface type node `Self::Assoc` projected to the IMPL's concrete associated type (`type
    // Assoc = X` in the extend), or TYPE_NONE if the node is not such a projection. This is what lets a
    // method returning `Self::Item` conform: the interface's abstract `Self::Item` becomes the impl's i32.
    fn tc_project_self_assoc(self: &mut Self, m: ModuleId, tynode: NodeId, ext: NodeId) TypeId {
        if tynode == NODE_NONE || ext == NODE_NONE {
            return TYPE_NONE;
        }
        let n = unsafe (*self.mod_ast(m)).at_const(tynode);
        if n.kind != NodeKind::NODE_TYPE_PATH || n.as_data.type_path.parts.len < 2 {
            return TYPE_NONE;
        }
        let p0 = unsafe (*self.mod_ast(m)).list(n.as_data.type_path.parts)[0];
        if !span_is(self.mod_src(m), unsafe (*self.mod_ast(m)).at_const(p0).as_data.name.text, "Self") {
            return TYPE_NONE;
        }
        let assoc = unsafe (*self.mod_ast(m)).at_const(unsafe (*self.mod_ast(m)).list(n.as_data.type_path.parts)[1]).as_data.name.text;
        let hm = self.tc_find_extend_alias(ext, assoc, m);
        if hm == NODE_NONE {
            return TYPE_NONE;
        }
        let aliased = unsafe (*self.cur_ast()).at_const(hm).as_data.type_alias.ty;
        if aliased == NODE_NONE {
            return TYPE_NONE;
        }
        return self.lower_type_in(self.cur_module(), aliased);
    }

    // The interface-side type for a conformance comparison: a `Self::Assoc` projects through the impl;
    // otherwise it is lowered and substituted with the interface's generic arguments as before.
    fn tc_iface_cmp_type(
        self: &mut Self,
        m: ModuleId,
        tynode: NodeId,
        ext: NodeId,
        subp: *const DefId,
        suba: *const TypeId,
        nsub: i32,
    ) TypeId {
        let proj = self.tc_project_self_assoc(m, tynode, ext);
        if proj != TYPE_NONE {
            return proj;
        }
        return self.subst_type(self.lower_type_in(m, tynode), subp, suba, nsub);
    }

    // Whether method `have` of extend `ext` implements interface method `req`, with the interface's
    // parameters read as `subp`/`suba`. Method generics match by position: the same count and kinds,
    // bounds equal once the interface method's parameters are read as the implementation's, which
    // is also how its parameter and result types compare.
    fn extend_method_signature_matches(
        self: &mut Self,
        req: DefId,
        have: NodeId,
        ext: NodeId,
        subp0: *const DefId,
        suba0: *const TypeId,
        nsub0: i32,
    ) bool {
        let ra = self.mod_ast(req.module);
        let rf = unsafe (*ra).at_const(req.node).as_data.function;
        let hf = unsafe (*self.cur_ast()).at_const(have).as_data.function;
        if rf.params.len != hf.params.len {
            return false;
        }
        let mut fp = Array::<DefId, 16> {};
        let mut fa = Array::<TypeId, 16> {};
        for k in 0..nsub0 {
            fp[k as usize] = unsafe subp0[k as usize];
            fa[k as usize] = unsafe suba0[k as usize];
        }
        let nsub = self.tc_method_gen_frame(
            req,
            DefId { module: self.cur_module(), node: have },
            &mut fp,
            &mut fa,
            nsub0,
        );
        if nsub < 0 {
            return false;
        }
        let subp = (&fp[0]) as *const DefId;
        let suba = (&fa[0]) as *const TypeId;
        for i in 0..rf.params.len {
            let rp = unsafe (*ra).list(rf.params)[i as usize];
            let hp = unsafe (*self.cur_ast()).list(hf.params)[i as usize];
            let rt = self.tc_iface_cmp_type(
                req.module,
                unsafe (*ra).at_const(rp).as_data.parameter.ty,
                ext,
                subp,
                suba,
                nsub,
            );
            let ht = self.lower_type_in(self.cur_module(), unsafe (*self.cur_ast()).at_const(hp).as_data.parameter.ty);
            if rt != ht && (i != 0 || !self.receiver_type_eq(rt, ht)) {
                return false;
            }
        }
        if rf.returns.len != hf.returns.len && (rf.returns.len > 1 || hf.returns.len > 1) {
            return false;
        }
        // The lengths are equal or 0 and 1 here, so the bitwise or is their maximum.
        let nr = rf.returns.len | hf.returns.len;
        // A missing return (0 against 1) compares as TYPE_NONE; `ret_eq` decides whether that matches.
        for k in 0..nr {
            let mut rt = TYPE_NONE;
            let mut ht = TYPE_NONE;
            if k < rf.returns.len {
                let rn = unsafe (*ra).slot_type_node(unsafe (*ra).list(rf.returns)[k as usize]);
                rt = self.tc_iface_cmp_type(req.module, rn, ext, subp, suba, nsub);
            }
            if k < hf.returns.len {
                let hn = unsafe (*self.cur_ast()).slot_type_node(unsafe (*self.cur_ast()).list(hf.returns)[k as usize]);
                ht = self.lower_type_in(self.cur_module(), hn);
            }
            if !self.ret_eq(rt, ht) {
                return false;
            }
        }
        return true;
    }
    // Extend the substitution `fp`/`fa[0..n]` with method `req`'s type-level generic parameters read
    // as method `have`'s, by position. The new count, or -1 when the two lists differ in count, in
    // kind (type or const), in a const parameter's type, or in bounds (inline and `where` bounds on
    // each parameter, compared as sets once the renaming applies).
    fn tc_method_gen_frame(
        self: &mut Self,
        req: DefId,
        have: DefId,
        fp: &mut Array<DefId, 16>,
        fa: &mut Array<TypeId, 16>,
        n: i32,
    ) i32 {
        let mut k: u32 = 0;
        let mut out = n;
        loop {
            let rg = self.tc_gen_slot(req, k);
            let hg = self.tc_gen_slot(have, k);
            if rg == NODE_NONE || hg == NODE_NONE {
                if rg != hg {
                    return -1;
                }
                break;
            }
            if out >= 16 {
                return -1;
            }
            fp[out as usize] = DefId { module: req.module, node: rg };
            fa[out as usize] = self.named_type_of(have.module, hg);
            out += 1;
            k += 1;
        }
        for j in n..out {
            let rg = fp[j as usize].node;
            let hg = self.type_at(fa[j as usize]).as_data.decl;
            let rgp = unsafe (*self.mod_ast(req.module)).at_const(rg).as_data.generic_param;
            let hgp = unsafe (*self.mod_ast(have.module)).at_const(hg).as_data.generic_param;
            if rgp.is_const != hgp.is_const {
                return -1;
            }
            if rgp.is_const && self.subst_type(self.lower_type_in(req.module, rgp.const_type), &fp[0], &fa[0], out) != self.lower_type_in(
                have.module,
                hgp.const_type,
            ) {
                return -1;
            }
            if !self.tc_gen_bounds_cover(req, rg, have, hg, fp, fa, out, true) || !self.tc_gen_bounds_cover(
                have,
                hg,
                req,
                rg,
                fp,
                fa,
                out,
                false,
            ) {
                return -1;
            }
        }
        return out;
    }

    // The `i`th bound on generic parameter `g` of function `f`: its inline bounds, then those of the
    // function's `where` predicates on it. NODE_NONE past the last.
    fn tc_gen_bound_at(self: &Self, f: DefId, g: NodeId, i: u32) NodeId {
        let a = self.mod_ast(f.module);
        let inl = unsafe (*a).at_const(g).as_data.generic_param.bounds;
        if i < inl.len {
            return unsafe (*a).list(inl)[i as usize];
        }
        let mut k = i - inl.len;
        let wc = unsafe (*a).at_const(f.node).as_data.function.where_clause;
        for w in 0..wc.len {
            let wp = unsafe (*a).at_const(unsafe (*a).list(wc)[w as usize]).as_data.where_predicate;
            if unsafe (*a).resolution(wp.ty) != g {
                continue;
            }
            if k < wp.bounds.len {
                return unsafe (*a).list(wp.bounds)[k as usize];
            }
            k -= wp.bounds.len;
        }
        return NODE_NONE;
    }

    // Whether every bound on parameter `g` of function `f` has an equal bound on parameter `og` of
    // function `of`. The frame `fp`/`fa[0..n]` reads the interface side (`f` when `f_req`, else
    // `of`) in the implementation's parameters.
    fn tc_gen_bounds_cover(
        self: &mut Self,
        f: DefId,
        g: NodeId,
        of: DefId,
        og: NodeId,
        fp: &Array<DefId, 16>,
        fa: &Array<TypeId, 16>,
        n: i32,
        f_req: bool,
    ) bool {
        let mut i: u32 = 0;
        loop {
            let b = self.tc_gen_bound_at(f, g, i);
            if b == NODE_NONE {
                return true;
            }
            let mut found = false;
            let mut j: u32 = 0;
            while !found {
                let ob = self.tc_gen_bound_at(of, og, j);
                if ob == NODE_NONE {
                    break;
                }
                found = if f_req {
                    self.tc_bound_node_eq(f.module, b, g, of.module, ob, og, fp, fa, n);
                } else {
                    self.tc_bound_node_eq(of.module, ob, og, f.module, b, g, fp, fa, n);
                };
                j += 1;
            }
            if !found {
                return false;
            }
            i += 1;
        }
    }

    // Whether bound node `rb` on parameter `rg` of module `rm` (the interface side, read through the
    // frame `fp`/`fa[0..n]`) equals bound node `hb` on parameter `hg` of module `hm`: the same
    // interface with equal arguments and associated type bindings, or equal function types with the
    // same `move`.
    fn tc_bound_node_eq(
        self: &mut Self,
        rm: ModuleId,
        rb: NodeId,
        rg: NodeId,
        hm: ModuleId,
        hb: NodeId,
        hg: NodeId,
        fp: &Array<DefId, 16>,
        fa: &Array<TypeId, 16>,
        n: i32,
    ) bool {
        let ra = self.mod_ast(rm);
        let ha = self.mod_ast(hm);
        let rn = *unsafe (*ra).at_const(rb);
        let hn = *unsafe (*ha).at_const(hb);
        if rn.kind != hn.kind {
            return false;
        }
        if rn.kind == NodeKind::NODE_FUNCTION_TYPE {
            return rn.as_data.function_type.is_move == hn.as_data.function_type.is_move && self.subst_type(
                self.lower_type_in(rm, rb),
                &fp[0],
                &fa[0],
                n,
            ) == self.lower_type_in(hm, hb);
        }
        let ri = unsafe (*ra).resolution_def(rb);
        let hi = unsafe (*ha).resolution_def(hb);
        if ri.node == NODE_NONE || ri.module != hi.module || ri.node != hi.node {
            return false;
        }
        let mut rx = Tys8 {};
        let mut hx = Tys8 {};
        let rself = self.named_type_of(rm, rg);
        let hself = self.named_type_of(hm, hg);
        let rc = self.tc_bound_args(rm, rb, ri, rself, &mut rx[0]);
        let hc = self.tc_bound_args(hm, hb, hi, hself, &mut hx[0]);
        if rc != hc {
            return false;
        }
        for k in 0..rc {
            if self.subst_type(rx[k as usize], &fp[0], &fa[0], n) != hx[k as usize] {
                return false;
            }
        }
        if rn.kind != NodeKind::NODE_TYPE_PATH {
            return true;
        }
        let rbs = rn.as_data.type_path.bindings;
        let hbs = hn.as_data.type_path.bindings;
        if rbs.len != hbs.len {
            return false;
        }
        for k in 0..rbs.len {
            let rj = *unsafe (*ra).at_const(unsafe (*ra).list(rbs)[k as usize]);
            let rnm = unsafe (*ra).at_const(rj.as_data.type_alias.name).as_data.name.text;
            let mut ok = false;
            for q in 0..hbs.len {
                let hj = *unsafe (*ha).at_const(unsafe (*ha).list(hbs)[q as usize]);
                let hnm = unsafe (*ha).at_const(hj.as_data.type_alias.name).as_data.name.text;
                if spans_eq2(self.mod_src(rm), rnm, self.mod_src(hm), hnm) && self.subst_type(
                    self.lower_type_in(rm, rj.as_data.type_alias.ty),
                    &fp[0],
                    &fa[0],
                    n,
                ) == self.lower_type_in(hm, hj.as_data.type_alias.ty) {
                    ok = true;
                }
            }
            if !ok {
                return false;
            }
        }
        return true;
    }

    // A type alias named `name` among an extend's items, or NODE_NONE.
    fn tc_find_extend_alias(self: &Self, extnode: NodeId, name: tok::Span, nmod: ModuleId) NodeId {
        let a = self.cur_ast();
        let have = unsafe (*a).at_const(extnode).as_data.extend_def.items;
        for j in 0..have.len {
            let hid = unsafe (*a).list(have)[j as usize];
            let hm = unsafe (*a).at_const(hid);
            if hm.kind == NodeKind::NODE_TYPE_ALIAS && spans_eq2(
                self.mod_src(nmod),
                name,
                self.source,
                unsafe (*a).at_const(hm.as_data.type_alias.name).as_data.name.text,
            ) {
                return hid;
            }
        }
        return NODE_NONE;
    }

    fn check_interface_requirements(
        self: &mut Self,
        extnode: NodeId,
        iface: DefId,
        self_ty: TypeId,
        subp: *const DefId,
        suba: *const TypeId,
        nsub: i32,
        depth: i32,
    ) {
        if iface.node == NODE_NONE || depth > 8 {
            return;
        }
        let ia = self.mod_ast(iface.module);
        if unsafe (*ia).at_const(iface.node).kind != NodeKind::NODE_INTERFACE {
            return;
        }
        let req = unsafe (*ia).at_const(iface.node).as_data.interface_def.items;
        for i in 0..req.len {
            let rid = unsafe (*ia).list(req)[i as usize];
            let rm = unsafe (*ia).at_const(rid);
            // An ASSOCIATED TYPE requirement (`type Item<'a>;`, no definition). The impl must
            // provide it with the same lifetime and type-generic arity: the interface's declared
            // shape is a contract even though lifetimes are erased from the interned types.
            if rm.kind == NodeKind::NODE_TYPE_ALIAS && rm.as_data.type_alias.ty == NODE_NONE {
                let rn = unsafe (*ia).at_const(rm.as_data.type_alias.name).as_data.name.text;
                let hm = self.tc_find_extend_alias(extnode, rn, iface.module);
                let at = unsafe (*self.cur_ast()).at_const(
                    unsafe (*self.cur_ast()).at_const(extnode).as_data.extend_def.interface_type,
                ).span;
                if hm == NODE_NONE {
                    self.errors.emit_span(
                        at,
                        format(
                            "missing associated type '{}' required by this interface",
                            diag::span_str(self.mod_src(iface.module), rn.start, rn.end),
                        ),
                    );
                } else {
                    // The type every later stage reads for `T::Name` through this conformance.
                    self.resolve_type(unsafe (*self.cur_ast()).at_const(hm).as_data.type_alias.ty);
                    let want_lt = unsafe (*ia).lifetimes_of(rid).len;
                    let have_lt = unsafe (*self.cur_ast()).lifetimes_of(hm).len;
                    let want_g = rm.as_data.type_alias.generics.len;
                    let have_g = unsafe (*self.cur_ast()).at_const(hm).as_data.type_alias.generics.len;
                    if want_lt != have_lt || want_g != have_g {
                        let hat = unsafe (*self.cur_ast()).at_const(hm).span;
                        self.errors.emit_span(
                            hat,
                            format(
                                "associated type '{}' does not match the interface: it declares {} lifetime and {} type parameter(s)",
                                diag::span_str(self.mod_src(iface.module), rn.start, rn.end),
                                want_lt,
                                want_g,
                            ),
                        );
                    }
                }
                continue;
            }
            if rm.kind == NodeKind::NODE_FUNCTION && rm.as_data.function.body == NODE_NONE {
                let rn = unsafe (*ia).at_const(rm.as_data.function.name).as_data.name.text;
                let hm = self.find_extend_item_named(extnode, rn, iface.module);
                let reqdef = DefId { module: iface.module, node: rid };
                if hm == NODE_NONE {
                    let at = unsafe (*self.cur_ast()).at_const(
                        unsafe (*self.cur_ast()).at_const(extnode).as_data.extend_def.interface_type,
                    ).span;
                    self.errors.emit_span(
                        at,
                        format(
                            "missing method '{}' required by this interface",
                            diag::span_str(self.mod_src(iface.module), rn.start, rn.end),
                        ),
                    );
                } else if !self.extend_method_signature_matches(reqdef, hm, extnode, subp, suba, nsub) {
                    let at = unsafe (*self.cur_ast()).at_const(hm).span;
                    self.errors.emit_span(
                        at,
                        format(
                            "method '{}' does not match interface signature",
                            diag::span_str(self.mod_src(iface.module), rn.start, rn.end),
                        ),
                    );
                } else {
                    self.check_method_qualifiers(reqdef, hm, rn);
                }
            }
        }
        let bounds = unsafe (*ia).at_const(iface.node).as_data.interface_def.bounds;
        for i in 0..bounds.len {
            let sbid = unsafe (*ia).list(bounds)[i as usize];
            let sb = unsafe (*ia).resolution_def(sbid);
            if sb.node == NODE_NONE {
                continue;
            }
            // The superinterface with the arguments this conformance gives it.
            let mut wa = Tys8 {};
            let wn = self.tc_bound_want(iface.module, sbid, sb, self_ty, subp, suba, nsub, null, null, 0, &mut wa);
            if !self.type_satisfies_in(self_ty, sb, &wa[0], wn, 0) {
                let at = unsafe (*self.cur_ast()).at_const(
                    unsafe (*self.cur_ast()).at_const(extnode).as_data.extend_def.interface_type,
                ).span;
                self.errors.emit_span(at, format("type does not satisfy required superinterface"));
            }
        }
    }
    // `Copy` is derived, so a written `extend T as Copy {}` restates the derivation and must agree with it:
    // a copy of a value that owns memory would free that memory twice.
    fn check_copy_conformance(self: &mut Self, id: NodeId, iface: DefId, self_ty: TypeId) {
        if !self.is_copy_iface(iface) || self_ty == TYPE_NONE || self.tc_copy_marker(self_ty, 0) {
            return;
        }
        let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
        let sp = unsafe (*self.cur_ast()).at_const(itype).span;
        let ty = self.type_buf(self_ty);
        let why = if self.tc_type_is_free(self_ty) {
            "it owns memory, and a bitwise copy would free that memory twice";
        } else {
            "a member is not 'Copy'";
        };
        self.errors.emit_span(sp, format("'Copy' cannot be declared for '{}': {}", str::from_cstr(&ty[0]), why));
    }
    // `Send` and `Sync` are the two conformances the compiler cannot verify. Every other interface is checked
    // against its requirements; these two are DERIVED structurally, and writing one by hand overrides that
    // derivation: it asserts a synchronisation discipline living outside the type system (an `Arc`'s
    // refcount, a `Mutex`'s lock, an atomic instruction). Nothing checks the claim, so the claim is marked:
    // `unsafe extend` puts every such assertion one grep away from an audit.
    fn check_marker_is_unsafe(self: &mut Self, id: NodeId, iface: DefId) {
        let send = self.is_send_iface(iface);
        if !send && !self.is_sync_iface(iface) {
            return;
        }
        if unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.is_unsafe {
            return;
        }
        let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
        let sp = unsafe (*self.cur_ast()).at_const(itype).span;
        let name = if send {
            "Send";
        } else {
            "Sync";
        };
        self.errors.emit_span(sp, format("asserting '{}' requires 'unsafe extend'", name));
        self.errors.note(
            format(
                "{}",
                "nothing verifies this: write 'unsafe extend' to take responsibility for it, or let the compiler derive the marker from the fields",
            ),
        );
    }

    // An interface method's `const` and `unsafe` are part of the REQUIREMENT, not decoration on it.
    //
    // `unsafe` must match exactly, and the direction that matters is an implementation MORE unsafe than its
    // declaration: a caller reaching it through the bound sees the safe declaration, promises nothing, and
    // lands in an unsafe body: the mark laundered away by the interface. The other direction is only
    // confusing (a direct call needs no mark while a call through the bound does), so both are errors and
    // the two signatures agree.
    //
    // `const` only has to be strong ENOUGH. An implementation may be `const fn` where the interface asks for
    // a plain one: it is more capable, and `std` leans on this throughout (`Array as Default` is const
    // where `Default` is not). It may not be plain where the interface asks for `const`, or a `const fn`
    // calling through the bound would fail at the fold, far from the implementation that caused it.
    fn check_method_qualifiers(self: &mut Self, req: DefId, hm: NodeId, rn: tok::Span) {
        let rf = unsafe (*self.mod_ast(req.module)).at_const(req.node).as_data.function;
        let hf = unsafe (*self.cur_ast()).at_const(hm).as_data.function;
        let at = unsafe (*self.cur_ast()).at_const(hm).span;
        let name = diag::span_str(self.mod_src(req.module), rn.start, rn.end);
        if rf.is_unsafe() != hf.is_unsafe() {
            let what = if rf.is_unsafe() {
                "is declared 'unsafe fn' by this interface";
            } else {
                "is not declared 'unsafe fn' by this interface, so a caller through the bound makes no promise";
            };
            self.errors.emit_span(at, format("method '{}' {}", name, what));
        }
        if rf.is_const() && !hf.is_const() {
            self.errors.emit_span(at, format("method '{}' is declared 'const fn' by this interface", name));
        }
    }

    // The conformance's substitution frame: Self -> the implementing type, then the interface's
    // spelled (or defaulted) generic parameters. Shared by check_extend_conformance and the driver's
    // default-body obligation discharge; returns the frame length.
    fn tc_extend_self_frame(self: &mut Self, id: NodeId, iface: DefId, subp: &mut Defs8, suba: &mut Tys8) i32 {
        let target = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.target_type;
        subp[0] = DefId { module: iface.module, node: iface.node };
        suba[0] = self.resolve_type(target);
        let mut nsub: i32 = 1;
        let ia = self.mod_ast(iface.module);
        let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
        if unsafe (*ia).at_const(iface.node).kind == NodeKind::NODE_INTERFACE && unsafe (*self.cur_ast()).at_const(
            itype,
        ).kind == NodeKind::NODE_TYPE_PATH {
            let gens = unsafe (*ia).at_const(iface.node).as_data.interface_def.generics;
            let targs = unsafe (*self.cur_ast()).at_const(itype).as_data.type_path.args;
            let mut i: u32 = 0;
            while i < gens.len && i < targs.len && nsub < 8 {
                let gid = unsafe (*ia).list(gens)[i as usize];
                let aid = unsafe (*self.cur_ast()).list(targs)[i as usize];
                let m = self.cur_module();
                let want = self.tc_gen_bt(iface, i);
                let is_c = self.tc_arg_is_const(m, aid);
                let t = if is_c {
                    self.tc_const_arg(m, aid, want);
                } else {
                    self.tc_const_pos(self.tc_arg_type(m, aid, iface, i), want, m, aid);
                };
                subp[nsub as usize] = DefId { module: iface.module, node: gid };
                suba[nsub as usize] = self.tc_const_enum_arg(
                    self.tc_arg_kind(t, m, aid, iface, i, is_c),
                    m,
                    aid,
                    iface.module,
                    self.tc_gen_param(iface, i),
                );
                nsub = nsub + 1;
                i = i + 1;
            }
            // A parameter the conformance did not spell takes its DEFAULT: `Mul<Rhs = Self>` written as a
            // bare `as Mul`. Lowered through the frame built so far, so `Self` in the default is the
            // implementing type and a later default may name an earlier parameter.
            while i < gens.len && nsub < 8 {
                let gid = unsafe (*ia).list(gens)[i as usize];
                let dft = unsafe (*ia).at_const(gid).as_data.generic_param.default_type;
                if dft == NODE_NONE {
                    break;
                }
                let d = self.lower_type_in(iface.module, dft);
                subp[nsub as usize] = DefId { module: iface.module, node: gid };
                suba[nsub as usize] = self.subst_type(d, &subp[0], &suba[0], nsub);
                nsub = nsub + 1;
                i = i + 1;
            }
        }
        return nsub;
    }

    // The position of param node `p` among `ext`'s type parameters, -1 when it is not one of them.
    const fn tc_gp_index(self: &Self, ext: NodeId, p: NodeId) i32 {
        let gens = unsafe (*self.cur_ast()).at_const(ext).as_data.extend_def.generics;
        for i in 0..gens.len {
            if unsafe (*self.cur_ast()).list(gens)[i as usize] == p {
                return i as i32;
            }
        }
        return -1;
    }

    // Structural type equality for the duplicate-conformance comparison: interned identity, with two
    // extends' OWN type parameters equal by POSITION (`extend<A> P<A> as I<A>` written twice names
    // the same conformance even though the two `A`s are different nodes).
    fn tc_dup_ty_eq(self: &Self, ta: TypeId, tb: TypeId, ea: NodeId, eb: NodeId) bool {
        if ta == tb {
            return true;
        }
        let ya = *self.type_at(ta);
        let yb = *self.type_at(tb);
        if ya.kind != yb.kind {
            return false;
        }
        if ya.kind == TypeKind::TYPE_GENERIC {
            let pa = self.tc_gp_index(ea, ya.as_data.decl);
            return pa >= 0 && pa == self.tc_gp_index(eb, yb.as_data.decl);
        }
        if ya.kind == TypeKind::TYPE_INSTANCE {
            let ia = *unsafe (*self.cur_ast()).instance(ya.as_data.inst);
            let ib = *unsafe (*self.cur_ast()).instance(yb.as_data.inst);
            if ia.module != ib.module || ia.decl != ib.decl || ia.n != ib.n {
                return false;
            }
            for k in 0..ia.n {
                if !self.tc_dup_ty_eq(unsafe ia.args[k as usize], unsafe ib.args[k as usize], ea, eb) {
                    return false;
                }
            }
            return true;
        }
        if ya.kind == TypeKind::TYPE_POINTER || ya.kind == TypeKind::TYPE_REFERENCE || ya.kind == TypeKind::TYPE_SLICE {
            return ya.qualifier == yb.qualifier && self.tc_dup_ty_eq(ya.as_data.elem, yb.as_data.elem, ea, eb);
        }
        return false;
    }

    // Fill `dup_heads` / `dup_next` over the module's items: each list in item order.
    fn dup_index_build(self: &mut Self) {
        let a = self.cur_ast();
        let items = unsafe (*a).at_const((*a).root).as_data.program.items;
        for _ in 0..items.len {
            self.dup_next.push(EXT_END);
        }
        let mut i = items.len;
        while i > 0 {
            i = i - 1;
            let id = unsafe (*a).list(items)[i as usize];
            let n = unsafe (*a).at_const(id);
            if n.kind != NodeKind::NODE_EXTEND || n.as_data.extend_def.interface_type == NODE_NONE {
                continue;
            }
            let key = ConfKey {
                iface: unsafe (*a).resolution_def(n.as_data.extend_def.interface_type),
                tgt: unsafe (*a).resolution_def(n.as_data.extend_def.target_type),
            };
            switch self.dup_heads.get(&key) {
                Some(v) => {
                    self.dup_next[i as usize] = *v;
                },
                None => {},
            };
            self.dup_heads.insert(key, i);
        }
        self.dup_built = true;
    }

    // The name of associated item `it` (a method or a constant) of module `m`; empty for any other item.
    const fn tc_item_name(self: &Self, m: ModuleId, it: NodeId) tok::Span {
        let n = unsafe (*self.mod_ast(m)).at_const(it);
        if n.kind == NodeKind::NODE_FUNCTION {
            return unsafe (*self.mod_ast(m)).at_const(n.as_data.function.name).as_data.name.text;
        }
        if n.kind == NodeKind::NODE_CONST {
            return unsafe (*self.mod_ast(m)).at_const(n.as_data.const_def.name).as_data.name.text;
        }
        return tok::Span::empty();
    }

    // The item of extend `e` named `name` (source `src`), NODE_NONE when there is none.
    fn tc_ext_item_named(self: &Self, e: DefId, src: str, name: tok::Span) NodeId {
        let items = unsafe (*self.mod_ast(e.module)).at_const(e.node).as_data.extend_def.items;
        for k in 0..items.len {
            let it = unsafe (*self.mod_ast(e.module)).list(items)[k as usize];
            let nm = self.tc_item_name(e.module, it);
            if nm.end != nm.start && spans_eq2(src, name, self.mod_src(e.module), nm) {
                return it;
            }
        }
        return NODE_NONE;
    }

    // Whether extends `x1` and `x2` of one target define their same-named items twice: both are plain
    // (no conformance) and apply to a common instance. The duplicate-definition error reports them, so
    // a use the two tie in reports nothing more.
    fn tc_dup_defs(self: &mut Self, x1: DefId, x2: DefId) bool {
        if x1.node == NODE_NONE || x2.node == NODE_NONE {
            return false;
        }
        let n1 = unsafe (*self.mod_ast(x1.module)).at_const(x1.node);
        let n2 = unsafe (*self.mod_ast(x2.module)).at_const(x2.node);
        // A bound's candidates stand for conformances, not extends.
        if n1.kind != NodeKind::NODE_EXTEND || n2.kind != NodeKind::NODE_EXTEND || n1.as_data.extend_def.interface_type != NODE_NONE || n2.as_data.extend_def.interface_type != NODE_NONE {
            return false;
        }
        return x1.module == x2.module && x1.node == x2.node || self.tc_exts_overlap(x1, x2);
    }

    // A method or constant a plain extend defines is defined once per instance of its target: an item
    // named like an earlier item of the same extend, or of an earlier plain extend of the same target
    // in this module that applies to a common instance (`tc_exts_overlap`), is a duplicate definition,
    // reported at the later item. Distinct conformances and disjoint extends (`extend P<u8>`,
    // `extend P<i32>`) may reuse a name; other modules are compared once every module is checked
    // (`check_cross_module_dup_items`).
    fn check_dup_items(self: &mut Self, id: NodeId) {
        let m = self.cur_module();
        let ed = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def;
        let tg = self.tc_peel_target(unsafe (*self.cur_ast()).resolution_def(ed.target_type));
        if tg.node == NODE_NONE {
            return;
        }
        // The earlier plain extends of this module that apply to a common instance, in item order.
        let mut prior = Vector::<NodeId>::new();
        let mut c = self.ext_begin(tg.module, tg.node);
        loop {
            let e = self.ext_next(&mut c);
            if e.node == NODE_NONE || e.module == m && e.node == id {
                break;
            }
            if e.module == m && self.tc_dup_defs(e, DefId { module: m, node: id }) {
                prior.push(e.node);
            }
        }
        for j in 0..ed.items.len {
            let it = unsafe (*self.cur_ast()).list(ed.items)[j as usize];
            let nm = self.tc_item_name(m, it);
            if nm.end == nm.start {
                continue;
            }
            let mut first = NODE_NONE;
            for k in 0..prior.len() {
                first = self.tc_ext_item_named(DefId { module: m, node: prior[k] }, self.source, nm);
                if first != NODE_NONE {
                    break;
                }
            }
            for k in 0..j {
                let pk = unsafe (*self.cur_ast()).list(ed.items)[k as usize];
                let pn = self.tc_item_name(m, pk);
                if first == NODE_NONE && pn.end != pn.start && spans_eq2(self.source, nm, self.source, pn) {
                    first = pk;
                }
            }
            if first != NODE_NONE {
                let tsp = unsafe (*self.cur_ast()).at_const(ed.target_type).span;
                self.errors.emit_span(
                    nm,
                    format(
                        "duplicate definition of '{}' for '{}'",
                        diag::span_str(self.source, nm.start, nm.end),
                        diag::span_str(self.source, tsp.start, tsp.end),
                    ),
                );
                let fsp = self.tc_item_name(m, first);
                let pf = unsafe (*self.package).modules[m as usize].file.as_str();
                let site = diag::render_site(self.source, pf, fsp.start, fsp.end - fsp.start);
                self.errors.note(format("the first definition is here\n{}", site.as_str()));
                self.errors.note(
                    format(
                        "a name is defined once for any one instance: only extends that apply to no common instance, or distinct conformances, may each define it",
                    ),
                );
            }
        }
    }

    // Whether module `a` comes before module `b` for a definition on a type of module `home`: the
    // prelude, then `home`, then module order, so the module that extends another's type carries the
    // error.
    fn tc_module_before(self: &Self, a: ModuleId, b: ModuleId, home: ModuleId) bool {
        let ra = pick(unsafe (*self.package).modules[a as usize].prelude, 0, pick(a == home, 1, 2));
        let rb = pick(unsafe (*self.package).modules[b as usize].prelude, 0, pick(b == home, 1, 2));
        return ra < rb || ra == rb && a < b;
    }

    /// Report the items a plain extend of this module defines that an overlapping plain extend of the
    /// same target in a module before this one (`tc_module_before`) already defines (`check_dup_items`
    /// covers one module): the later module carries the error, once per item. Decidable only once
    /// every module is checked.
    pub fn check_cross_module_dup_items(self: &mut Self) {
        let m = self.cur_module();
        // This module's plain extends and their peeled targets, then every plain extend of another
        // module that comes before this one for the same target: one pass over the package.
        let mut mine = Vector::<NodeId>::new();
        let mut tgs = Vector::<DefId>::new();
        for i in 0..self.ext_count(m) {
            let id = self.ext_at(m, i);
            let ed = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def;
            if ed.interface_type != NODE_NONE || ed.target_type == NODE_NONE {
                continue;
            }
            let tg = self.tc_peel_target(unsafe (*self.cur_ast()).resolution_def(ed.target_type));
            if tg.node != NODE_NONE {
                mine.push(id);
                tgs.push(tg);
            }
        }
        if mine.len() == 0 {
            return;
        }
        let mut others = Vector::<DefId>::new();
        let mut owner = Vector::<usize>::new();
        for oi in 0..self.pkg_count() {
            let om = oi as ModuleId;
            if om == m {
                continue;
            }
            for i in 0..self.ext_count(om) {
                let e = DefId { module: om, node: self.ext_at(om, i) };
                let oed = unsafe (*self.mod_ast(om)).at_const(e.node).as_data.extend_def;
                if oed.interface_type != NODE_NONE || oed.target_type == NODE_NONE {
                    continue;
                }
                let otg = self.tc_peel_target(unsafe (*self.mod_ast(om)).resolution_def(oed.target_type));
                for k in 0..tgs.len() {
                    if tgs[k].module != otg.module || tgs[k].node != otg.node || !self.tc_module_before(
                        om,
                        m,
                        otg.module,
                    ) {
                        continue;
                    }
                    others.push(e);
                    owner.push(k);
                }
            }
        }
        for k in 0..mine.len() {
            let id = mine[k];
            let ed = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def;
            for j in 0..ed.items.len {
                let it = unsafe (*self.cur_ast()).list(ed.items)[j as usize];
                let nm = self.tc_item_name(m, it);
                if nm.end == nm.start {
                    continue;
                }
                // The definition that comes first (`tc_module_before`, then item order).
                let mut first = DefId { module: 0, node: NODE_NONE };
                for o in 0..others.len() {
                    if owner[o] != k {
                        continue;
                    }
                    if first.node != NODE_NONE && !self.tc_module_before(others[o].module, first.module, tgs[k].module) {
                        continue;
                    }
                    let pk = self.tc_ext_item_named(others[o], self.source, nm);
                    if pk != NODE_NONE && self.tc_exts_overlap(others[o], DefId { module: m, node: id }) {
                        first = DefId { module: others[o].module, node: pk };
                    }
                }
                if first.node == NODE_NONE {
                    continue;
                }
                let tsp = unsafe (*self.cur_ast()).at_const(ed.target_type).span;
                self.errors.emit_span(
                    nm,
                    format(
                        "duplicate definition of '{}' for '{}': module '{}' also defines it",
                        diag::span_str(self.source, nm.start, nm.end),
                        diag::span_str(self.source, tsp.start, tsp.end),
                        unsafe (*self.package).modules[first.module as usize].path.as_str(),
                    ),
                );
                let fsp = self.tc_item_name(first.module, first.node);
                let site = diag::render_site(
                    self.mod_src(first.module),
                    unsafe (*self.package).modules[first.module as usize].file.as_str(),
                    fsp.start,
                    fsp.end - fsp.start,
                );
                self.errors.note(format("the other definition is here\n{}", site.as_str()));
                self.errors.note(
                    format(
                        "a name is defined once for any one instance across the whole package: rename or remove one of the two",
                    ),
                );
            }
        }
    }

    fn check_extend_conformance(self: &mut Self, id: NodeId) {
        let itype = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
        let iface = unsafe (*self.cur_ast()).resolution_def(itype);
        if iface.node == NODE_NONE {
            return;
        }
        self.check_marker_is_unsafe(id, iface);
        let mut subp = Defs8 {};
        let mut suba = Tys8 {};
        let nsub = self.tc_extend_self_frame(id, iface, &mut subp, &mut suba);
        // Each spelled interface argument keeps its type on its node: the instance graph binds the
        // interface's parameters from them where it walks the default bodies of the conformance.
        let itn = unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type;
        if unsafe (*self.cur_ast()).at_const(itn).kind == NodeKind::NODE_TYPE_PATH {
            let targs = unsafe (*self.cur_ast()).at_const(itn).as_data.type_path.args;
            let mut i: u32 = 0;
            while i < targs.len && (i + 1) as i32 < nsub {
                let an = unsafe (*self.cur_ast()).list(targs)[i as usize];
                if unsafe (*self.cur_ast()).type_of(an) == TYPE_NONE {
                    unsafe (*self.cur_ast()).set_type(an, suba[(i + 1) as usize]);
                }
                i += 1;
            }
        }
        // The conformance's whole argument list, defaults included, as `dyn I<args>` on the interface
        // path: associated types resolve per instance through the conformance with the bound's
        // arguments (`Mangler::assoc_norm`).
        if nsub > 0 && unsafe (*self.cur_ast()).type_of(itn) == TYPE_NONE {
            let dt = unsafe (*self.cur_ast()).intern_dyn(
                iface.module,
                iface.node,
                &suba[1],
                (nsub - 1) as u8,
                TypeQualifier::TYPE_QUAL_NONE as u8,
            );
            unsafe (*self.cur_ast()).set_type(itn, dt);
        }
        self.check_copy_conformance(id, iface, suba[0]);
        // A type states one conformance per (interface, arguments) pair: `Conv<i32>` and
        // `Conv<bool>` are distinct, a repeat of either could only redefine its methods. Scan the
        // EARLIER siblings with this interface and target (`dup_heads`) so the later extend carries the error; a cross-module duplicate still
        // surfaces at link.
        let tgt = unsafe (*self.cur_ast()).resolution_def(
            unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.target_type,
        );
        let items = unsafe (*self.cur_ast()).at_const((*self.cur_ast()).root).as_data.program.items;
        if !self.dup_built {
            self.dup_index_build();
        }
        let mut at = switch self.dup_heads.get(&ConfKey { iface: iface, tgt: tgt }) {
            Some(v) => *v,
            None => EXT_END,
        };
        while at != EXT_END {
            let prev = unsafe (*self.cur_ast()).list(items)[at as usize];
            if prev == id {
                break;
            }
            at = self.dup_next[at as usize];
            let pit = unsafe (*self.cur_ast()).at_const(prev).as_data.extend_def.interface_type;
            let mut psubp = Defs8 {};
            let mut psuba = Tys8 {};
            let pnsub = self.tc_extend_self_frame(prev, iface, &mut psubp, &mut psuba);
            let mut same = pnsub == nsub;
            let mut k: i32 = 0;
            while same && k < nsub {
                same = self.tc_dup_ty_eq(psuba[k as usize], suba[k as usize], prev, id);
                k = k + 1;
            }
            if same {
                let sp = unsafe (*self.cur_ast()).at_const(itype).span;
                self.errors.emit_span(
                    sp,
                    format(
                        "duplicate conformance: the type already declares 'as {}'",
                        diag::span_str(self.source, sp.start, sp.end),
                    ),
                );
                let pf = unsafe (*self.package).modules[self.cur_module() as usize].file.as_str();
                let psp = unsafe (*self.cur_ast()).at_const(pit).span;
                let site = diag::render_site(self.source, pf, psp.start, psp.end - psp.start);
                self.errors.note(format("the first conformance is declared here\n{}", site.as_str()));
                self.errors.note(
                    format(
                        "a type conforms to an interface once; merge the items into the first 'extend', or remove one",
                    ),
                );
                return;
            }
        }
        self.check_interface_requirements(id, iface, suba[0], &subp[0], &suba[0], nsub, 0);
    }

    fn method_recv_subst(self: &mut Self, recv: TypeId, md: DefId, rsubp: *mut DefId, rsuba: *mut TypeId) i32 {
        let mut nrsub: i32 = 0;
        let rvy = *self.type_at(self.strip(recv));
        if rvy.kind == TypeKind::TYPE_DYN {
            // Dyn receiver over an instantiated generic interface: map the interface's generic
            // params to the dyn type's arguments (method sigs mention them directly).
            let dinst = *unsafe (*self.cur_ast()).instance(rvy.as_data.inst);
            if dinst.decl != NODE_NONE && unsafe (*self.mod_ast(dinst.module)).at_const(dinst.decl).kind == NodeKind::NODE_INTERFACE {
                nrsub = self.tc_dyn_method_args(&rvy, md, rsubp, rsuba, 0);
                if nrsub > 0 {
                    return nrsub;
                }
            }
        }
        // A method declared ON THE INTERFACE (an inherited default body): its signature's Self
        // substitutes to the receiver.
        let ienc = self.enclosing(md.module, md.node, NodeKind::NODE_INTERFACE);
        if ienc != NODE_NONE && nrsub < 8 {
            unsafe rsubp[nrsub as usize] = DefId { module: md.module, node: ienc };
            unsafe rsuba[nrsub as usize] = self.strip(recv);
            nrsub = nrsub + 1;
            // Through a type parameter's bound: the interface's parameters are the bound's arguments.
            let ry = *self.type_at(self.strip(recv));
            if ry.kind == TypeKind::TYPE_GENERIC && nrsub < 8 {
                nrsub = nrsub + self.bound_method_subst(
                    ry.module,
                    ry.as_data.decl,
                    md,
                    unsafe (rsubp + nrsub as usize),
                    unsafe (rsuba + nrsub as usize),
                    8 - nrsub,
                    null,
                );
            }
        }
        let mut rmod: ModuleId = 0;
        let mut rdecl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut sn: i32 = 0;
        let agok = self.aggregate_of(self.strip(recv), &mut rmod, &mut rdecl, &mut gp, &mut ga, &mut sn);
        if agok && sn > 0 {
            let extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
            if extnode != NODE_NONE {
                self.frame_ext(md.module, extnode, &ga[0], sn, rsubp, rsuba, &mut nrsub);
            }
        }
        return nrsub;
    }
    /// Method `md`'s single return type as seen on receiver `recv` (owner-extend / dyn-interface
    /// generics substituted); void when none is declared, TYPE_NONE for multi-return methods.
    pub fn tc_method_ret(self: &mut Self, recv: TypeId, md: DefId) TypeId {
        return self.tc_method_sig(recv, md, TYPE_NONE, -1);
    }
    /// Method `md`'s parameter `idx` type on receiver `recv`, with the same substitution as tc_method_ret.
    pub fn tc_method_param(self: &mut Self, recv: TypeId, md: DefId, idx: i32) TypeId {
        return self.tc_method_sig(recv, md, TYPE_NONE, idx);
    }
    /// Method `md`'s parameter `idx` (its single result for -1) on receiver `recv`, the parameters of
    /// its interface read first as the arguments of conformance `conf` (`tc_conf_subst`), so that a
    /// type parameter receiver's first bound does not fix them.
    fn tc_method_sig(self: &mut Self, recv: TypeId, md: DefId, conf: TypeId, idx: i32) TypeId {
        let fa = self.mod_ast(md.module);
        let fnn = unsafe (*fa).at_const(md.node);
        if fnn.kind != NodeKind::NODE_FUNCTION {
            return TYPE_NONE;
        }
        let tl = if idx < 0 {
            fnn.as_data.function.returns;
        } else {
            fnn.as_data.function.params;
        };
        let at = if idx < 0 {
            0;
        } else {
            idx;
        };
        if idx < 0 && tl.len == 0 {
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        if idx < 0 && tl.len > 1 || tl.len as i32 <= at {
            return TYPE_NONE;
        }
        let t = self.tc_conf_subst(conf, self.node_type_in(md.module, unsafe (*fa).list(tl)[at as usize]));
        let mut rsubp = Defs8 {};
        let mut rsuba = Tys8 {};
        let nrsub = self.method_recv_subst(recv, md, &mut rsubp[0], &mut rsuba[0]);
        return self.subst_type(t, &rsubp[0], &rsuba[0], nrsub);
    }
    fn method_self_kind(self: &mut Self, md: DefId) i32 {
        let fa = self.mod_ast(md.module);
        let fnn = unsafe (*fa).at_const(md.node);
        if fnn.kind != NodeKind::NODE_FUNCTION || fnn.as_data.function.params.len == 0 {
            return 0;
        }
        let pt = self.decl_type_in(md.module, unsafe (*fa).list(fnn.as_data.function.params)[0]);
        let y = self.type_at(pt);
        if y.kind != TypeKind::TYPE_REFERENCE && y.kind != TypeKind::TYPE_POINTER {
            return 0;
        }
        if y.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
            return 2;
        }
        return 1;
    }
    fn operand_fits_param(self: &mut Self, pt: TypeId, operand: NodeId) bool {
        if pt == TYPE_NONE || self.compatible(pt, operand) {
            return true;
        }
        let p = *self.type_at(pt);
        return p.kind == TypeKind::TYPE_REFERENCE && self.compatible(p.as_data.elem, operand);
    }
}

// Compound-assignment token -> the same overload method its binary form uses ("<<=" -> shl).
// `x / d` into `q` when it divides exactly (`d` is not zero).
fn lin_div_exact(x: i128, d: i128, q: &mut i128) bool {
    let mut r = i128::zero();
    let v = x.divmod(&d, &mut r);
    if !r.is_zero() {
        return false;
    }
    *q = v;
    return true;
}

// Only when every part divides exactly: `{(N * 4) / 2}` is `{N * 2}`, and `{N / 2}` is not an integer
// form of anything this can compare.
// Span `sp` of source `src` widened over the parentheses its operands' spans leave out: a binary
// node spans its operands, so `(N - 10) / 4` reads `N - 10) / 4`.
fn paren_span(src: str, sp: tok::Span) tok::Span {
    let mut open: i64 = 0;
    for i in sp.start..sp.end {
        if src[i as usize] == b'(' {
            open += 1;
        } else if src[i as usize] == b')' {
            open -= 1;
        }
    }
    let mut r = sp;
    let mut k = r.start;
    while open < 0 && k > 0 {
        k -= 1;
        let c = src[k as usize];
        if c == b'(' {
            open += 1;
            r.start = k;
        } else if c != b' ' && c != b'\t' && c != b'\n' && c != b'\r' {
            break;
        }
    }
    k = r.end;
    while open > 0 && k as usize < src.len() {
        let c = src[k as usize];
        k += 1;
        if c == b')' {
            open -= 1;
            r.end = k;
        } else if c != b' ' && c != b'\t' && c != b'\n' && c != b'\r' {
            break;
        }
    }
    return r;
}

fn lin_divide(src: &ConstLin, d: i128, out: &mut ConstLin) bool {
    if src.div_of() != i128::one() {
        // Dividing a divided form would stack floors; nothing writes that.
        return false;
    }
    let mut q = i128::zero();
    if !lin_div_exact(src.k, d, &mut q) || !lin_acc(&mut out.k, i128::one(), q) {
        return false;
    }
    for i in 0..src.n {
        if !lin_div_exact(unsafe src.c[i as usize], d, &mut q) || !out.add_term(unsafe src.p[i as usize], q) {
            return false;
        }
    }
    return true;
}

extend TypeChecker {
    fn check_unary(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let op = unsafe (*a).at_const(id).as_data.unary.op;
        let operand = unsafe (*a).at_const(id).as_data.unary.operand;
        let qual = unsafe (*a).at_const(id).as_data.unary.qualifier;
        // A negative literal past i64, where the context expects Int<N>: the sign belongs to the
        // literal, so the pair becomes one wide value here: checking the operand alone would only
        // reject it.
        if op == TokenType::Minus && unsafe (*a).at_const(operand).kind == NodeKind::NODE_LITERAL && unsafe (*a).at_const(
            operand,
        ).as_data.literal.token_type == TokenType::IntegerLiteral {
            if self.tc_wide_literal(operand, id, true, expected) {
                return unsafe (*self.cur_ast()).type_of(id);
            }
            let lr = unsafe (*a).at_const(operand).as_data.literal.raw;
            let mut ws: u32 = 0;
            let wt = self.tc_lit_wide_suffix(lr, &mut ws);
            if wt != TYPE_NONE {
                let mut wb: i64 = 0;
                if self.tc_wide_target(wt, &mut wb) == 2 && self.tc_wide_literal_at(operand, id, true, wt, ws, true) {
                    return unsafe (*self.cur_ast()).type_of(id);
                }
            }
        }
        if op == TokenType::Ampersand {
            self.icx.addr_ctx = true;
        }
        let outer_unsafe_used = self.icx.unsafe_used;
        if op == TokenType::Unsafe {
            self.icx.unsafe_depth = self.icx.unsafe_depth + 1;
            self.icx.unsafe_used = 0;
        }
        // `&e` / `&mut e` expecting a reference or pointer: `e` expects the pointee.
        let mut owant = TYPE_NONE;
        if op == TokenType::Ampersand && expected != TYPE_NONE && (self.type_at(expected).kind == TypeKind::TYPE_REFERENCE || self.type_at(
            expected,
        ).kind == TypeKind::TYPE_POINTER) {
            owant = self.type_at(expected).as_data.elem;
        }
        let opnd = self.check_expr_w(operand, owant);
        if op == TokenType::Unsafe {
            self.icx.unsafe_depth = self.icx.unsafe_depth - 1;
            // An `unsafe` take of a Free field through a reference is CONSUMED by the borrow
            // checker's E0507 exemption (a later pass this lint cannot see): count it as used.
            if self.icx.unsafe_used == 0 {
                let w = unsafe (*a).peel(operand, false);
                let wk = unsafe (*a).at_const(w).kind;
                if (wk == NodeKind::NODE_MEMBER && !unsafe (*a).at_const(w).as_data.member.path || wk == NodeKind::NODE_INDEX) && self.tc_type_is_free(
                    opnd,
                ) {
                    self.icx.unsafe_used = 1;
                }
            }
            // Code the platform filter removed inside the operand may be what needs `unsafe`.
            if self.lint && self.icx.unsafe_used == 0 && !unsafe (*a).bc_cut_at(id, unsafe (*a).at_const(id).span) {
                let usp = unsafe (*a).at_const(id).span;
                self.errors.warn(usp.start, 6, format("unnecessary 'unsafe': nothing inside requires it"));
                // Prefix form only: a bare block is not an expression, so `unsafe { .. }` keeps its marker.
                // Delete only the keyword + trailing blanks: the operand span excludes dropped grouping
                // parens, so deleting up to it would swallow a '(' (`unsafe (a + 1)`).
                if unsafe (*a).at_const(operand).kind != NodeKind::NODE_BLOCK {
                    let mut fe = usp.start + 6;
                    while fe as usize < self.source.len() && (self.source[fe as usize] == b' ' || self.source[fe as usize] == b'\t') {
                        fe = fe + 1;
                    }
                    self.errors.fix(usp.start, fe, 0);
                }
            }
            self.icx.unsafe_used = outer_unsafe_used;
        }
        let sp = unsafe (*a).at_const(id).span;
        if op == TokenType::Minus {
            if !untyped(opnd) && !self.is_numeric(opnd) {
                self.errors.emit_span(sp, format("unary '-' requires a numeric operand"));
                return TYPE_ERROR;
            } else if !untyped(opnd) && bt_is_uint(self.bt_of(opnd)) {
                self.err_neg_unsigned(id, opnd);
            }
            return opnd;
        }
        if op == TokenType::Bang {
            if !untyped(opnd) && !self.is_bool(opnd) {
                self.errors.emit_span(sp, format("unary '!' requires a 'bool' operand"));
            }
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        if op == TokenType::Tilde {
            let mut ov: TypeId = TYPE_NONE;
            if self.check_bit_not_overload(id, opnd, &mut ov) {
                return ov;
            }
            if !untyped(opnd) && !self.is_int(opnd) {
                self.errors.emit_span(sp, format("unary '~' requires an integer operand"));
                return TYPE_ERROR;
            }
            return opnd;
        }
        if op == TokenType::Star {
            // Lint: `*&x` (any mutability) yields the place/value x itself; both tokens cancel.
            if self.lint && unsafe (*a).at_const(operand).kind == NodeKind::NODE_UNARY && unsafe (*a).at_const(operand).as_data.unary.op == TokenType::Ampersand {
                let usp = unsafe (*a).at_const(id).span;
                self.errors.warn_span(usp, format("unnecessary '*&': the expression can be used directly"));
                self.tc_lint_pair_fix(
                    usp.start,
                    unsafe (*a).at_const(unsafe (*a).at_const(operand).as_data.unary.operand).span.start,
                );
            }
            if untyped(opnd) {
                return TYPE_NONE;
            }
            let ot = *self.type_at(opnd);
            if ot.kind == TypeKind::TYPE_POINTER || ot.kind == TypeKind::TYPE_REFERENCE {
                if ot.kind == TypeKind::TYPE_POINTER && self.tc_needs_unsafe() {
                    self.err_unsafe(sp, "dereferencing a raw pointer");
                }
                return ot.as_data.elem;
            }
            // `*x` on a type that implements Deref is that impl's job, exactly as `x.method()` is.
            let mut dm = DefId { module: 0, node: NODE_NONE };
            let dt = self.tc_deref_step(self.strip(opnd), &mut dm, false);
            if dt != TYPE_NONE {
                self.tc_record_deref(id, self.strip(opnd), dm, dt);
                return dt;
            }
            self.errors.emit_span(sp, format("cannot dereference a non-pointer"));
            return TYPE_NONE;
        }
        if op == TokenType::Ampersand {
            let mut2 = qual == TypeQualifier::TYPE_QUAL_MUT;
            if mut2 {
                self.tc_note_capture_mut(operand);
            }
            // Lint: `&*r` on a shared reference re-produces r; both tokens cancel. (`&mut *r`
            // reborrows and `&*p` on a raw pointer materializes a reference: both meaningful.)
            if self.lint && !mut2 && unsafe (*a).at_const(operand).kind == NodeKind::NODE_UNARY && unsafe (*a).at_const(
                operand,
            ).as_data.unary.op == TokenType::Star {
                let inner = unsafe (*a).at_const(operand).as_data.unary.operand;
                let it = unsafe (*a).type_of(inner);
                if it != TYPE_NONE && self.type_at(it).kind == TypeKind::TYPE_REFERENCE && self.type_at(it).qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 {
                    let usp = unsafe (*a).at_const(id).span;
                    self.errors.warn_span(usp, format("unnecessary '&*': the reference can be used directly"));
                    self.tc_lint_pair_fix(usp.start, unsafe (*a).at_const(inner).span.start);
                }
            }
            if mut2 && self.is_place(operand) && !self.is_assignable(operand) {
                let osp = unsafe (*a).at_const(operand).span;
                self.errors.emit_span(osp, format("cannot take '&mut' of an immutable binding (bind it with 'mut')"));
            }
            let opw = unsafe (*a).peel(operand, false);
            let onk = unsafe (*a).at_const(opw).kind;
            if !self.is_place(opw) && !untyped(opnd) && self.type_at(opnd).kind != TypeKind::TYPE_BUILTIN && (onk == NodeKind::NODE_CALL || onk == NodeKind::NODE_IF || onk == NodeKind::NODE_MATCH || onk == NodeKind::NODE_BLOCK || onk == NodeKind::NODE_BINARY || onk == NodeKind::NODE_ASSIGNMENT || onk == NodeKind::NODE_CAST) {
                let osp = unsafe (*a).at_const(opw).span;
                self.errors.emit_span(
                    osp,
                    format("cannot take the address of a temporary value; bind it to a 'let' first"),
                );
            }
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_REFERENCE, qualifier: qual as u8, as_data: TyAs { elem: opnd } },
            );
        }
        if op == TokenType::Question {
            if untyped(opnd) {
                return TYPE_NONE;
            }
            let os = self.strip(opnd);
            let mut oa = Tys8 {};
            let mut fa = Tys8 {};
            let nopt = self.prelude_instance_args_hit(os, self.ph_option, &mut oa[0], 2);
            let mut nres: i32 = -1;
            if nopt < 0 {
                nres = self.prelude_instance_args_hit(os, self.ph_result, &mut oa[0], 2);
            }
            if nopt < 0 && nres < 0 {
                self.errors.emit_span(sp, format("'?' requires an Option or Result operand"));
                self.errors.note(format("the operand must be an Option<T> or Result<T, E> value"));
                return TYPE_NONE;
            }
            let mut fnret: TypeId = TYPE_NONE;
            if self.icx.current_returns.len == 1 {
                let r0 = unsafe (*self.cur_ast()).list(self.icx.current_returns)[0];
                fnret = self.resolve_type(unsafe (*self.cur_ast()).slot_type_node(r0));
            }
            let mut frs = TYPE_NONE;
            if fnret != TYPE_NONE {
                frs = self.strip(fnret);
            }
            if nopt >= 0 {
                if self.prelude_instance_args_hit(frs, self.ph_option, &mut fa[0], 2) < 0 {
                    self.errors.emit_span(sp, format("'?' on an Option requires the function to return an Option"));
                    self.errors.note(format("change the function return type or handle None explicitly"));
                }
                return oa[0];
            }
            if self.prelude_instance_args_hit(frs, self.ph_result, &mut fa[0], 2) < 0 {
                self.errors.emit_span(sp, format("'?' on a Result requires the function to return a Result"));
                self.errors.note(format("the function must return Result<_, E> with the same error type"));
            } else if oa[1] != fa[1] {
                let conv = self.tc_find_from_for(fa[1], oa[1]);
                if conv.node != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(id, conv);
                } else {
                    let a1 = self.type_buf(oa[1]);
                    let a2 = self.type_buf(fa[1]);
                    self.errors.emit_span(
                        sp,
                        format(
                            "'?' error type '{}' does not match the function's error type '{}'",
                            str::from_cstr(&a1[0]),
                            str::from_cstr(&a2[0]),
                        ),
                    );
                }
            }
            return oa[0];
        }
        return opnd;
    }

    // `lk`/`rk`: the operands' literal-only kinds (tc_lit_kind).
    fn binary_numeric(
        self: &mut Self,
        id: NodeId,
        l: TypeId,
        ln: NodeId,
        lk: u8,
        r: TypeId,
        rn: NodeId,
        rk: u8,
        require_int: bool,
    ) TypeId {
        if untyped(l) || untyped(r) {
            return TYPE_NONE;
        }
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        let mut ok = self.is_numeric(l) && self.is_numeric(r);
        if require_int {
            ok = self.is_int(l) && self.is_int(r);
        }
        if !ok {
            let mut w = "numeric".ptr() as *const char;
            if require_int {
                w = "integer".ptr() as *const char;
            }
            self.errors.emit_span(sp, format("operator requires {} operands", str::from_cstr(w)));
            return TYPE_NONE;
        }
        if l == r {
            return l;
        }
        // An unpinned literal, or literal-only arithmetic, takes the other operand's type; of two, the
        // narrower takes the wider's. A character literal (kind 3 here) takes an integer type.
        let la = pick(lk == 0 && self.tc_char_lit(ln), 3u8, lk);
        let ra = pick(rk == 0 && self.tc_char_lit(rn), 3u8, rk);
        if la != 0 && (ra == 0 || bt_widens(self.bt_of(l), self.bt_of(r))) {
            if !self.lit_adopt(ln, la, r) {
                self.err_mismatch(ln, r);
            }
            return r;
        }
        if ra != 0 {
            if !self.lit_adopt(rn, ra, l) {
                self.err_mismatch(rn, l);
            }
            return l;
        }
        if bt_widens(self.bt_of(l), self.bt_of(r)) {
            return r;
        }
        if bt_widens(self.bt_of(r), self.bt_of(l)) {
            return l;
        }
        self.err_mismatch(rn, l);
        return l;
    }

    fn check_ptr_arith(self: &mut Self, id: NodeId, l: TypeId, r: TypeId, handled: &mut bool) TypeId {
        *handled = false;
        if untyped(l) || untyped(r) {
            return TYPE_NONE;
        }
        let lp = self.type_at(l).kind == TypeKind::TYPE_POINTER;
        let rp = self.type_at(r).kind == TypeKind::TYPE_POINTER;
        if !lp && !rp {
            return TYPE_NONE;
        }
        *handled = true;
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        if self.tc_needs_unsafe() {
            self.err_unsafe(sp, "raw pointer arithmetic");
        }
        let minus = unsafe (*self.cur_ast()).at_const(id).as_data.binary.op == TokenType::Minus;
        if lp && rp {
            if minus && l == r {
                return Ast::builtin(BuiltinType::BT_ISIZE);
            }
            self.errors.emit_span(sp, format("invalid pointer arithmetic"));
            return TYPE_NONE;
        }
        if lp && self.is_int(r) {
            return l;
        }
        if rp && !minus && self.is_int(l) {
            return r;
        }
        self.errors.emit_span(sp, format("pointer arithmetic requires an integer offset"));
        return TYPE_NONE;
    }

    fn check_arith_overload(self: &mut Self, id: NodeId, l: TypeId, out: &mut TypeId) bool {
        let op = unsafe (*self.cur_ast()).at_const(id).as_data.binary.op;
        let m = op.op_method();
        if m.len() == 0 {
            return false;
        }
        let mut ls = l;
        while ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_REFERENCE {
            ls = self.type_at(ls).as_data.elem;
        }
        if ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_POINTER {
            return false;
        }
        if ls == TYPE_NONE {
            return false;
        }
        let lt = *self.type_at(ls);
        let right = unsafe (*self.cur_ast()).at_const(id).as_data.binary.right;
        if lt.kind == TypeKind::TYPE_GENERIC {
            if !self.tc_bound_op(id, ls, m, right, out) {
                let sp = unsafe (*self.cur_ast()).at_const(id).span;
                let ty = self.type_buf(ls);
                self.errors.emit_span(
                    sp,
                    format(
                        "type parameter '{}' has no '{}' method for this operator (add a bound that provides it)",
                        str::from_cstr(&ty[0]),
                        m,
                    ),
                );
                *out = TYPE_NONE;
            }
            return true;
        }
        if lt.kind != TypeKind::TYPE_STRUCT && lt.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        *out = ls;
        if self.aggregate_decl(ls, &mut om, &mut od) {
            let mut md = self.find_method_cstr(om, od, m);
            // Two conformances may provide this operator for different right operands; the operand is
            // already typed here, so it picks between them.
            if md.node != NODE_NONE {
                let mut rt = Tys8 {};
                let rl = Lits8 {};
                rt[0] = unsafe (*self.cur_ast()).type_of(right);
                let mut tie = false;
                md = self.tc_pick_by_args(om, od, tok::Span::empty(), m, ls, md, &rt[0], &rl[0], 1, true, &mut tie);
                unsafe (*self.cur_ast()).op_method.insert(id, md.module as u64 << 32 | md.node as u64);
            }
            if md.node == NODE_NONE {
                // An interface DEFAULT the conformance inherits (a derived `eq`/`cmp`) provides the
                // operator too.
                md = self.find_default_method_cstr(om, od, m);
                if md.node != NODE_NONE {
                    unsafe (*self.cur_ast()).op_method.insert(id, md.module as u64 << 32 | md.node as u64);
                }
            }
            if md.node == NODE_NONE {
                let sp = unsafe (*self.cur_ast()).at_const(id).span;
                let ty = self.type_buf(ls);
                self.errors.emit_span(
                    sp,
                    format("'{}' has no '{}' method for this operator", str::from_cstr(&ty[0]), m),
                );
                *out = TYPE_NONE;
            } else {
                if !self.method_extend_bounds_hold(ls, md) {
                    let sp = unsafe (*self.cur_ast()).at_const(id).span;
                    self.err_method_extend_bounds(sp, ls, md);
                    *out = TYPE_NONE;
                    return true;
                }
                let p1 = self.tc_method_param(ls, md, 1);
                if !self.operand_fits_param(p1, right) {
                    self.err_mismatch(right, p1);
                }
                let ret = self.tc_method_ret(ls, md);
                if ret != TYPE_NONE {
                    *out = ret;
                }
            }
        }
        return true;
    }

    // Operator method `m` on a value of type parameter `ls`: the interface method a bound provides,
    // recorded as the operator's method (`op_method`) with the conformance every instance dispatches
    // to (`bound_call`, for a generic interface), its result the method's return type through that
    // bound (`T::Output`, `tc_method_ret`). With several bounds reaching the interface, the first whose
    // parameter accepts right operand `right` (NODE_NONE for a unary operator). False when no bound
    // provides `m`.
    fn tc_bound_op(self: &mut Self, id: NodeId, ls: TypeId, m: str, right: NodeId, out: &mut TypeId) bool {
        let lt = *self.type_at(ls);
        let mut bs = BoundArr8 {};
        let nb = self.collect_param_bounds_full(lt.module, lt.as_data.decl, &mut bs[0], 8);
        let mut md = DefId { module: 0, node: NODE_NONE };
        let mut disp = TYPE_NONE;
        let mut sp = Defs8 {};
        let mut sa = Tys8 {};
        let mut ns: i32 = 0;
        for b in 0..nb {
            let mb = self.find_interface_method(bs[b as usize].iface.module, bs[b as usize].iface.node, m, 0);
            if mb.node == NODE_NONE {
                continue;
            }
            let mi = DefId { module: mb.module, node: self.enclosing(mb.module, mb.node, NodeKind::NODE_INTERFACE) };
            let mut ga = Tys8 {};
            let gn = self.tc_super_args(
                bs[b as usize].iface,
                &bs[b as usize].args[0],
                bs[b as usize].n,
                ls,
                mi,
                &mut ga[0],
                0,
            );
            if gn < 0 || gn > 7 {
                continue;
            }
            let mut cp = Defs8 {};
            let mut ca = Tys8 {};
            cp[0] = mi;
            ca[0] = ls;
            let mut cn: i32 = 1;
            while cn - 1 < gn {
                let gid = self.tc_gen_slot(mi, (cn - 1) as u32);
                if gid == NODE_NONE {
                    break;
                }
                cp[cn as usize] = DefId { module: mi.module, node: gid };
                ca[cn as usize] = ga[(cn - 1) as usize];
                cn += 1;
            }
            let mut fits = right == NODE_NONE;
            if !fits {
                let fa = self.mod_ast(mb.module);
                let ps = unsafe (*fa).at_const(mb.node).as_data.function.params;
                if ps.len > 1 {
                    let p1 = self.subst_type(self.node_type_in(mb.module, unsafe (*fa).list(ps)[1]), &cp[0], &ca[0], cn);
                    let py = *self.type_at(p1);
                    fits = self.compatible_in(p1, right, true) || py.kind == TypeKind::TYPE_REFERENCE && self.compatible_in(
                        py.as_data.elem,
                        right,
                        true,
                    );
                }
            }
            if md.node == NODE_NONE || fits {
                md = mb;
                sp = cp;
                sa = ca;
                ns = cn;
                disp = pick(
                    gn > 0,
                    unsafe (*self.cur_ast()).intern_dyn(
                        mi.module,
                        mi.node,
                        &ga[0],
                        gn as u8,
                        TypeQualifier::TYPE_QUAL_NONE as u8,
                    ),
                    TYPE_NONE,
                );
            }
            if fits {
                break;
            }
        }
        if md.node == NODE_NONE {
            return false;
        }
        unsafe (*self.cur_ast()).op_method.insert(id, md.module as u64 << 32 | md.node as u64);
        if disp != TYPE_NONE {
            unsafe (*self.cur_ast()).set_bound_call(id, disp);
        }
        let fa = self.mod_ast(md.module);
        let fnn = *unsafe (*fa).at_const(md.node);
        if right != NODE_NONE && fnn.as_data.function.params.len > 1 {
            let p1 = self.subst_type(
                self.node_type_in(md.module, unsafe (*fa).list(fnn.as_data.function.params)[1]),
                &sp[0],
                &sa[0],
                ns,
            );
            if !self.operand_fits_param(p1, right) {
                self.err_mismatch(right, p1);
            }
        }
        *out = Ast::builtin(BuiltinType::BT_VOID);
        if fnn.as_data.function.returns.len == 1 {
            *out = self.subst_type(
                self.node_type_in(md.module, unsafe (*fa).list(fnn.as_data.function.returns)[0]),
                &sp[0],
                &sa[0],
                ns,
            );
        }
        return true;
    }

    // Unary `~` on an aggregate: the same dispatch the binary operators get, through `bit_not`. Reports
    // against the operator rather than falling through to "requires an integer operand", which would name
    // the wrong problem for a type that has no such method.
    fn check_bit_not_overload(self: &mut Self, id: NodeId, opnd: TypeId, out: &mut TypeId) bool {
        let mut os = opnd;
        while os != TYPE_NONE && self.type_at(os).kind == TypeKind::TYPE_REFERENCE {
            os = self.type_at(os).as_data.elem;
        }
        if os == TYPE_NONE {
            return false;
        }
        let ot = *self.type_at(os);
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        if ot.kind == TypeKind::TYPE_GENERIC {
            if !self.tc_bound_op(id, os, "bit_not", NODE_NONE, out) {
                let ty = self.type_buf(os);
                self.errors.emit_span(
                    sp,
                    format(
                        "type parameter '{}' has no 'bit_not' method for this operator (add a bound that provides it)",
                        str::from_cstr(&ty[0]),
                    ),
                );
                *out = TYPE_NONE;
                return true;
            }
            return true;
        }
        if ot.kind != TypeKind::TYPE_STRUCT && ot.kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        *out = os;
        if self.aggregate_decl(os, &mut om, &mut od) {
            let md = self.find_method_cstr(om, od, "bit_not");
            if md.node != NODE_NONE {
                unsafe (*self.cur_ast()).op_method.insert(id, md.module as u64 << 32 | md.node as u64);
            }
            if md.node == NODE_NONE {
                let ty = self.type_buf(os);
                self.errors.emit_span(
                    sp,
                    format("type '{}' has no 'bit_not' method for this operator", str::from_cstr(&ty[0])),
                );
                *out = TYPE_NONE;
                return true;
            }
            let ret = self.tc_method_ret(os, md);
            if ret != TYPE_NONE {
                *out = ret;
            }
        }
        return true;
    }

    // A left-associative chain (`x + x + ... + x`) nests on its left operand. The left spine is
    // checked with a loop, innermost node first, so the stack depth does not grow with the chain. Its
    // literal-only bottom (`2 * 3` in `2 * 3 + x`, all of `2 * 3 + 4`) is typed as one expression.
    fn check_binary(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let base = self.bin_spine.len();
        let mut n = id;
        while unsafe (*a).at_const(n).kind == NodeKind::NODE_BINARY {
            self.bin_spine.push(n);
            n = unsafe (*a).at_const(n).as_data.binary.left;
        }
        let mut k = self.tc_lit_kind(n);
        let mut top = self.bin_spine.len();
        while k != 0 && top > base {
            let bk = self.tc_lit_step(*self.bin_spine.at(top - 1), k);
            if bk == 0 {
                break;
            }
            k = bk;
            top -= 1;
        }
        let mut l = TYPE_NONE;
        if top < self.bin_spine.len() {
            let unit = *self.bin_spine.at(top);
            while self.bin_spine.len() > top {
                let _ = self.bin_spine.pop();
            }
            if top == base {
                return self.tc_lit_arith(id, k, expected);
            }
            l = self.tc_lit_arith(unit, k, TYPE_NONE);
        } else {
            l = self.check_expr(n);
        }
        // Only the innermost remaining node has a literal-only left operand.
        let mut lk = k;
        while self.bin_spine.len() > base {
            let b = self.bin_spine.pop().unwrap();
            l = self.check_binary_ops(b, l, lk);
            lk = 0;
            unsafe (*a).set_type(b, l);
        }
        return l;
    }

    // The checks of binary node `id` whose left operand has type `l` and literal-only kind `lk`
    // (tc_lit_kind).
    fn check_binary_ops(self: &mut Self, id: NodeId, l: TypeId, lk: u8) TypeId {
        let a = self.cur_ast();
        let bd = unsafe (*a).at_const(id).as_data.binary;
        let ln = bd.left;
        let rn = bd.right;
        let op = bd.op;
        let logic = op == TokenType::AmpersandAmpersand || op == TokenType::PipePipe;
        let rlk = pick(logic, 0u8, self.tc_lit_kind(rn));
        // A wide-integer operand: the left side's UInt<N>/Int<N> is what an integer literal on the
        // right means, exactly as the operators' Rhs = Self default reads. Without this the literal
        // is checked contextless and a >64-bit one has nowhere to go.
        let rk = unsafe (*a).at_const(rn).kind;
        let mut rwant = TYPE_NONE;
        if (rk == NodeKind::NODE_LITERAL || rk == NodeKind::NODE_UNARY) && !logic {
            let mut wbits: i64 = 0;
            if self.tc_wide_target(l, &mut wbits) != 0 {
                rwant = l;
            }
        }
        // Literal-only arithmetic on the right is computed in the left operand's numeric type of its kind.
        if rwant == TYPE_NONE && l != TYPE_NONE && (rlk == 1 && self.is_int(l) || rlk == 2 && bt_is_float(self.bt_of(l))) {
            rwant = l;
        }
        // `o == Option::None`: the comparison's right operand has the left operand's value type.
        let eq = op == TokenType::EqualEqual || op == TokenType::BangEqual;
        if eq && l != TYPE_NONE && self.tc_bare_generic_variant(rn) {
            rwant = self.strip(l);
        }
        let r = self.check_expr_w(rn, rwant);
        if eq {
            self.tc_profile_check(ln, rn);
            self.tc_profile_check(rn, ln);
        }
        let sp = unsafe (*a).at_const(id).span;
        if op == TokenType::Plus || op == TokenType::Minus {
            let mut ov: TypeId = TYPE_NONE;
            if self.check_arith_overload(id, l, &mut ov) {
                return ov;
            }
            let mut handled = false;
            let pt = self.check_ptr_arith(id, l, r, &mut handled);
            if handled {
                return pt;
            }
            return self.binary_numeric(id, l, ln, lk, r, rn, rlk, false);
        }
        if op == TokenType::Star || op == TokenType::Slash || op == TokenType::Percent {
            let mut ov: TypeId = TYPE_NONE;
            if self.check_arith_overload(id, l, &mut ov) {
                return ov;
            }
            return self.binary_numeric(id, l, ln, lk, r, rn, rlk, false);
        }
        if op == TokenType::Ampersand || op == TokenType::Pipe || op == TokenType::Caret || op == TokenType::LeftShift || op == TokenType::RightShift {
            let mut ov: TypeId = TYPE_NONE;
            if self.check_arith_overload(id, l, &mut ov) {
                return ov;
            }
            return self.binary_numeric(id, l, ln, lk, r, rn, rlk, true);
        }
        if op == TokenType::AmpersandAmpersand || op == TokenType::PipePipe {
            if !untyped(l) && !self.is_bool(l) || !untyped(r) && !self.is_bool(r) {
                self.errors.emit_span(sp, format("logical operator requires 'bool' operands"));
            }
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        // Comparisons.
        let ord = op == TokenType::LessThan || op == TokenType::LessThanEqual || op == TokenType::GreaterThan || op == TokenType::GreaterThanEqual;
        // `null == value` mirror of the null-operand check in the struct-eq branch below.
        let lnn = unsafe (*self.cur_ast()).at_const(ln);
        if lnn.kind == NodeKind::NODE_LITERAL && lnn.as_data.literal.token_type == TokenType::Null && r != TYPE_NONE {
            let mut rs = r;
            while self.type_at(rs).kind == TypeKind::TYPE_REFERENCE {
                rs = self.type_at(rs).as_data.elem;
            }
            let rk = self.type_at(rs).kind;
            if rk == TypeKind::TYPE_STRUCT || rk == TypeKind::TYPE_INSTANCE {
                let ty = self.type_buf(rs);
                self.errors.emit_span(
                    sp,
                    format("cannot compare '{}' with 'null' (it is a value, not a pointer)", str::from_cstr(&ty[0])),
                );
                return Ast::builtin(BuiltinType::BT_BOOL);
            }
        }
        let mut ls = l;
        while ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_REFERENCE {
            ls = self.type_at(ls).as_data.elem;
        }
        let mut rstrip = r;
        while rstrip != TYPE_NONE && self.type_at(rstrip).kind == TypeKind::TYPE_REFERENCE {
            rstrip = self.type_at(rstrip).as_data.elem;
        }
        // A raw pointer compares by ADDRESS, a reference by VALUE: one of each in a comparison has
        // no consistent meaning, so it is rejected instead of silently picking a side.
        let lptr = ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_POINTER;
        let rptr = rstrip != TYPE_NONE && self.type_at(rstrip).kind == TypeKind::TYPE_POINTER;
        if lptr != rptr && (lptr && r != rstrip || rptr && l != ls) {
            self.errors.emit_span(
                sp,
                format(
                    "cannot compare a raw pointer with a reference (pointers compare by address, references by value)",
                ),
            );
            self.errors.note(
                format(
                    "cast the reference with 'as' to compare addresses, or dereference the pointer to compare values",
                ),
            );
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        if lptr {
            if l != TYPE_NONE && r != TYPE_NONE && l != r && !self.compatible(l, rn) && !self.compatible(r, ln) {
                self.err_mismatch(rn, l);
            }
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        let ls_enum = ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_ENUM;
        let mut native_enum = false;
        if ls != TYPE_NONE && (self.type_at(ls).kind == TypeKind::TYPE_STRUCT || self.type_at(ls).kind == TypeKind::TYPE_INSTANCE || ls_enum) {
            let mut om: ModuleId = 0;
            let mut od = NODE_NONE;
            if self.aggregate_decl(ls, &mut om, &mut od) {
                let mut mm = "eq";
                if ord {
                    mm = "cmp";
                }
                let rnn = unsafe (*self.cur_ast()).at_const(rn);
                if !ls_enum && rnn.kind == NodeKind::NODE_LITERAL && rnn.as_data.literal.token_type == TokenType::Null {
                    let ty = self.type_buf(ls);
                    self.errors.emit_span(
                        sp,
                        format("cannot compare '{}' with 'null' (it is a value, not a pointer)", str::from_cstr(&ty[0])),
                    );
                    return Ast::builtin(BuiltinType::BT_BOOL);
                }
                let mut md = self.find_method_cstr(om, od, mm);
                if md.node == NODE_NONE {
                    // An interface DEFAULT the conformance inherits (a derived `eq`/`cmp`) serves
                    // the operator too.
                    md = self.find_default_method_cstr(om, od, mm);
                }
                if md.node == NODE_NONE && ls_enum {
                    // No conformance: the native discriminant comparison below.
                    native_enum = true;
                } else if md.node == NODE_NONE {
                    let ty = self.type_buf(ls);
                    let mut iface = "Eq".ptr() as *const char;
                    if ord {
                        iface = "Ord".ptr() as *const char;
                    }
                    self.errors.emit_span(
                        sp,
                        format(
                            "'{}' has no '{}' method for this operator (implement {})",
                            str::from_cstr(&ty[0]),
                            mm,
                            str::from_cstr(iface),
                        ),
                    );
                    self.errors.note(format("operator overloads are resolved through interface-style methods"));
                } else if !self.method_extend_bounds_hold(ls, md) {
                    self.err_method_extend_bounds(sp, ls, md);
                } else {
                    let p1 = self.tc_method_param(ls, md, 1);
                    if !self.operand_fits_param(p1, rn) {
                        self.err_mismatch(rn, p1);
                    }
                }
            }
            if !native_enum {
                return Ast::builtin(BuiltinType::BT_BOOL);
            }
        }
        if ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_GENERIC {
            let gy = *self.type_at(ls);
            let mut mm = "eq";
            if ord {
                mm = "cmp";
            }
            if !self.tc_param_bound_provides(gy.module, gy.as_data.decl, mm) {
                let mut iface = "Eq".ptr() as *const char;
                if ord {
                    iface = "Ord".ptr() as *const char;
                }
                self.errors.emit_span(
                    sp,
                    format(
                        "type parameter has no '{}' method for this operator (add a `{}` bound)",
                        mm,
                        str::from_cstr(iface),
                    ),
                );
            }
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        // Scalar comparison: references compare by value, so validate the reference-STRIPPED types
        // (`&i32 == &i32`, `&i32 == i32`, `i32 == &i32` are all i32-value comparisons). Raw pointers
        // were handled by the pointer branch above.
        if ls != TYPE_NONE && rstrip != TYPE_NONE && ls != rstrip && !self.compatible(ls, rn) && !self.compatible(
            rstrip,
            ln,
        ) {
            self.err_mismatch(rn, ls);
        }
        return Ast::builtin(BuiltinType::BT_BOOL);
    }

    fn check_variant_call(self: &mut Self, id: NodeId, vmod: ModuleId, variant: NodeId, callee_ty: TypeId) TypeId {
        let a = self.cur_ast();
        let args = unsafe (*a).at_const(id).as_data.call.args;
        let va = self.mod_ast(vmod);
        let payload = unsafe (*va).at_const(variant).as_data.variant.payload;
        // A payload argument expects its declared type, as a struct literal field does, when the
        // callee's instance (or a payload type naming no parameter) makes that type concrete.
        let mut amod0: ModuleId = 0;
        let mut adecl0 = NODE_NONE;
        let mut gp0 = Defs8 {};
        let mut ga0 = Tys8 {};
        let mut gn0: i32 = 0;
        let _ = self.aggregate_of(callee_ty, &mut amod0, &mut adecl0, &mut gp0, &mut ga0, &mut gn0);
        for i in 0..args.len {
            let mut want = TYPE_NONE;
            if i < payload.len {
                let pw = self.subst_type(
                    self.node_type_in(vmod, unsafe (*va).list(payload)[i as usize]),
                    &gp0[0],
                    &ga0[0],
                    gn0,
                );
                want = pick(pw != TYPE_NONE && unsafe (*self.cur_ast()).type_concrete(pw), pw, TYPE_NONE);
            }
            self.check_expr_w(unsafe (*a).list(args)[i as usize], want);
        }
        let sp = unsafe (*a).at_const(id).span;
        let mut enum_ty = callee_ty;
        if enum_ty != TYPE_NONE && self.type_at(enum_ty).kind == TypeKind::TYPE_ENUM {
            enum_ty = self.tc_infer_variant_instance(id, vmod, variant, enum_ty);
            if enum_ty == TYPE_NONE {
                return TYPE_NONE;
            }
        }
        let mut amod: ModuleId = 0;
        let mut adecl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        let inst = self.aggregate_of(enum_ty, &mut amod, &mut adecl, &mut gp, &mut ga, &mut gn);
        if args.len != payload.len {
            let s2 = plural(payload.len);
            self.errors.emit_span(
                sp,
                format("variant expects {} argument{}, found {}", payload.len, str::from_cstr(s2), args.len),
            );
        } else {
            for k in 0..args.len {
                let pid = unsafe (*va).list(payload)[k as usize];
                let raw = self.node_type_in(vmod, pid);
                let mut pt = raw;
                if inst {
                    pt = self.subst_type(raw, &gp[0], &ga[0], gn);
                }
                let aid = unsafe (*a).list(args)[k as usize];
                if !self.compatible(pt, aid) {
                    self.err_mismatch(aid, pt);
                }
            }
        }
        return enum_ty;
    }

    // A generic enum's variant called without type arguments and without an expected instance
    // (`Option::Some(x)`): the payload arguments bind the enum's parameters as the value arguments
    // of a generic function call bind its parameters. The callee takes the instance, as a turbofish
    // would give it. A non-generic enum is returned as is.
    fn tc_infer_variant_instance(self: &mut Self, id: NodeId, vmod: ModuleId, variant: NodeId, enum_ty: TypeId) TypeId {
        let et = *self.type_at(enum_ty);
        let gens = unsafe (*self.mod_ast(et.module)).at_const(et.as_data.decl).as_data.aggregate.generics;
        let a = self.cur_ast();
        let args = unsafe (*a).at_const(id).as_data.call.args;
        let va = self.mod_ast(vmod);
        let payload = unsafe (*va).at_const(variant).as_data.variant.payload;
        if gens.len == 0 || gens.len > 8 || args.len != payload.len {
            return enum_ty;
        }
        let mut ptys = Vector::<TypeId>::new();
        let mut vals = Vector::<NodeId>::new();
        ptys.reserve(args.len as usize);
        vals.reserve(args.len as usize);
        for k in 0..args.len {
            let pid = unsafe (*va).list(payload)[k as usize];
            ptys.push(self.node_type_in(vmod, pid));
            vals.push(unsafe (*a).list(args)[k as usize]);
        }
        let inst = self.tc_infer_agg_instance(unsafe (*a).at_const(id).span, enum_ty, &ptys, &vals, true);
        if inst != TYPE_NONE {
            unsafe (*self.cur_ast()).set_type(unsafe (*a).at_const(id).as_data.call.callee, inst);
        }
        return inst;
    }

    // The instance of generic aggregate `ety` (a struct or enum named without type arguments) that
    // the checked values `vals` give against their members' declared types `ptys`, in the evidence
    // order of a generic call: non-literal values bind, then the declared defaults apply, then
    // unsuffixed literals (also under `&`) default the parameters still open. TYPE_NONE when a value
    // has no type (its own error is reported) or a parameter stays open (reported at `sp`, worded
    // for a call when `call`, else for a struct literal).
    fn tc_infer_agg_instance(
        self: &mut Self,
        sp: tok::Span,
        ety: TypeId,
        ptys: &Vector<TypeId>,
        vals: &Vector<NodeId>,
        call: bool,
    ) TypeId {
        let et = *self.type_at(ety);
        let gens = unsafe (*self.mod_ast(et.module)).at_const(et.as_data.decl).as_data.aggregate.generics;
        let mut ta = Tys8 {};
        if !self.tc_infer_gen_args(sp, et.module, gens, ptys, vals, call, false, &mut ta[0]) {
            return TYPE_NONE;
        }
        return unsafe (*self.cur_ast()).intern_instance(et.module, et.as_data.decl, &ta[0], gens.len as u8);
    }

    // The arguments `ta` of the generic parameters `gens` (of module `em`) that the checked values
    // `vals` give against the types `ptys` (see `tc_infer_agg_instance`). False when a value has no
    // type or a parameter stays open (reported at `sp`). `want_err`: the context expects TYPE_ERROR,
    // which unifies with every instance, so a parameter still open is TYPE_ERROR and not reported.
    fn tc_infer_gen_args(
        self: &mut Self,
        sp: tok::Span,
        em: ModuleId,
        gens: NodeList,
        ptys: &Vector<TypeId>,
        vals: &Vector<NodeId>,
        call: bool,
        want_err: bool,
        ta: *mut TypeId,
    ) bool {
        let ea = self.mod_ast(em);
        let a = self.cur_ast();
        for k in 0..vals.len() {
            if unsafe (*a).type_of(*vals.at(k)) == TYPE_NONE {
                return false;
            }
        }
        let outer = self.icx.sv.session_open();
        for k in 0..gens.len {
            let gid = unsafe (*ea).list(gens)[k as usize];
            let _ = self.icx.sv.map_param(
                DefId { module: em, node: gid },
                unsafe (*ea).at_const(gid).as_data.generic_param.is_const,
            );
        }
        for k in 0..vals.len() {
            let v = *vals.at(k);
            let mut rd: u32 = 0;
            if self.tc_peek_lit_class(v) == 0 && self.tc_ref_lit(v, &mut rd) == NODE_NONE {
                self.tc_infer_ev(*ptys.at(k), unsafe (*a).type_of(v), true);
            }
        }
        for k in 0..gens.len {
            unsafe ta[k as usize] = self.icx.sv.s_resolve(k, it_conv_join);
            if unsafe ta[k as usize] == TYPE_NONE {
                unsafe ta[k as usize] = self.tc_default_arg(em, gens, k as u8, ta);
            }
        }
        let mut lits = false;
        for k in 0..vals.len() {
            if self.tc_lit_default(*vals.at(k), *ptys.at(k), ta) {
                lits = true;
            }
        }
        for k in 0..gens.len {
            if unsafe ta[k as usize] == TYPE_NONE && lits {
                unsafe ta[k as usize] = self.icx.sv.s_resolve(k, it_conv_join);
            }
        }
        self.tc_report_const_conflicts(sp);
        self.tc_report_type_conflicts(sp);
        let mut all = true;
        for k in 0..gens.len {
            if unsafe ta[k as usize] != TYPE_NONE {
                continue;
            }
            if want_err {
                unsafe ta[k as usize] = TYPE_ERROR;
                continue;
            }
            all = false;
            let gid = unsafe (*ea).list(gens)[k as usize];
            if call {
                self.err_unresolved_generic(sp, em, gid);
            } else {
                let gsp = unsafe (*ea).at_const(unsafe (*ea).at_const(gid).as_data.generic_param.name).as_data.name.text;
                self.errors.emit_span(
                    sp,
                    format(
                        "cannot infer the generic argument '{}' of this struct literal; give it an expected type or explicit type arguments",
                        diag::span_str(self.mod_src(em), gsp.start, gsp.end),
                    ),
                );
            }
        }
        self.icx.sv.session_close(&outer);
        return all;
    }

    // The arguments `ta` of generic alias `d` whose body `body` the expected type `want` gives;
    // false when one stays open.
    fn tc_alias_args_from(self: &mut Self, d: DefId, body: TypeId, want: TypeId, ta: *mut TypeId) bool {
        let da = self.mod_ast(d.module);
        let gens = unsafe (*da).at_const(d.node).as_data.type_alias.generics;
        let outer = self.icx.sv.session_open();
        for k in 0..gens.len {
            let gid = unsafe (*da).list(gens)[k as usize];
            let _ = self.icx.sv.map_param(
                DefId { module: d.module, node: gid },
                unsafe (*da).at_const(gid).as_data.generic_param.is_const,
            );
        }
        self.tc_infer_ev(body, want, false);
        let mut all = true;
        for k in 0..gens.len {
            unsafe ta[k as usize] = self.icx.sv.s_resolve(k, it_conv_join);
            all = all && unsafe ta[k as usize] != TYPE_NONE;
        }
        self.icx.sv.session_close(&outer);
        return all;
    }

    const fn tc_is_iface_assoc_call(self: &Self, e: NodeId) bool {
        let a = self.cur_ast();
        let en = unsafe (*a).at_const(e);
        if en.kind != NodeKind::NODE_CALL {
            return false;
        }
        let cn = unsafe (*a).at_const(en.as_data.call.callee);
        if cn.kind != NodeKind::NODE_MEMBER || !cn.as_data.member.path {
            return false;
        }
        let ob = unsafe (*a).resolution_def(cn.as_data.member.object);
        return ob.node != NODE_NONE && (ob.module == self.cur_module() || ob.module as usize < self.pkg_count()) && unsafe (*self.mod_ast(
            ob.module,
        )).at_const(ob.node).kind == NodeKind::NODE_INTERFACE;
    }

    // The declared type of element `i` of tuple-struct constructor `callee` (an instance's element
    // under its arguments), which its argument expects as a struct literal field does, when it is
    // concrete; TYPE_NONE otherwise.
    fn tc_tuple_ctor_elem(self: &mut Self, callee: TypeId, i: u32) TypeId {
        if callee == TYPE_NONE || self.type_at(callee).kind != TypeKind::TYPE_STRUCT && self.type_at(callee).kind != TypeKind::TYPE_INSTANCE {
            return TYPE_NONE;
        }
        let mut tmod: ModuleId = 0;
        let mut tdecl = NODE_NONE;
        let mut tgp = Defs8 {};
        let mut tga = Tys8 {};
        let mut tgn: i32 = 0;
        if !self.aggregate_of(callee, &mut tmod, &mut tdecl, &mut tgp, &mut tga, &mut tgn) {
            return TYPE_NONE;
        }
        let sd = unsafe (*self.mod_ast(tmod)).at_const(tdecl);
        if sd.kind != NodeKind::NODE_STRUCT || !sd.as_data.aggregate.is_tuple || i >= sd.as_data.aggregate.members.len {
            return TYPE_NONE;
        }
        let mt = self.node_type_in(tmod, unsafe (*self.mod_ast(tmod)).list(sd.as_data.aggregate.members)[i as usize]);
        let et = self.subst_type(mt, &tgp[0], &tga[0], tgn);
        return pick(et != TYPE_NONE && unsafe (*self.cur_ast()).type_concrete(et), et, TYPE_NONE);
    }

    fn tc_param_expected(self: &mut Self, callee: TypeId, callee_node: NodeId, argi: u32) TypeId {
        if callee == TYPE_NONE {
            return TYPE_NONE;
        }
        let ct = *self.type_at(callee);
        if ct.kind != TypeKind::TYPE_FUNCTION {
            // A generic fn callee has no concrete fn TYPE this early, but its declared params that
            // do not mention a type parameter are still exact: `range(0..n, ..)`'s Range<usize>
            // should reach the range literal even though the fn is generic over its closure.
            let mut cd = unsafe (*self.cur_ast()).resolution_def(callee_node);
            if cd.node == NODE_NONE && unsafe (*self.cur_ast()).at_const(callee_node).kind == NodeKind::NODE_MEMBER {
                cd = unsafe (*self.cur_ast()).resolution_def(
                    unsafe (*self.cur_ast()).at_const(callee_node).as_data.member.member,
                );
            }
            if cd.node != NODE_NONE && cd.module as usize < self.pkg_count() && unsafe (*self.mod_ast(cd.module)).at_const(
                cd.node,
            ).kind == NodeKind::NODE_FUNCTION {
                let fd = unsafe (*self.mod_ast(cd.module)).at_const(cd.node).as_data.function;
                if fd.generics.len > 0 && argi < fd.params.len {
                    let pn = unsafe (*self.mod_ast(cd.module)).list(fd.params)[argi as usize];
                    let ptn = unsafe (*self.mod_ast(cd.module)).at_const(pn).as_data.parameter.ty;
                    if ptn != NODE_NONE {
                        let pt0 = self.decl_type_in(cd.module, pn);
                        if self.tc_expected_known(pt0) {
                            return pt0;
                        }
                    }
                }
            }
            return TYPE_NONE;
        }
        if ct.fn_sig() {
            // A call THROUGH a fn-pointer value: the parameter types are the signature's own.
            if argi >= unsafe (*self.cur_ast()).sig_len(&ct, false) {
                return TYPE_NONE;
            }
            return unsafe (*self.cur_ast()).sig_at(&ct, false, argi);
        }
        let fa = self.mod_ast(ct.module);
        let fnn = unsafe (*fa).at_const(ct.as_data.decl);
        if fnn.kind != NodeKind::NODE_FUNCTION {
            return TYPE_NONE;
        }
        let cnn = unsafe (*self.cur_ast()).at_const(callee_node);
        let mut skip: u32 = 0;
        if cnn.kind == NodeKind::NODE_MEMBER && !cnn.as_data.member.path && fnn.as_data.function.params.len > 0 {
            let md = unsafe (*self.cur_ast()).resolution_def(cnn.as_data.member.member);
            if md.node != NODE_NONE && unsafe (*self.mod_ast(md.module)).at_const(md.node).kind == NodeKind::NODE_FUNCTION {
                skip = 1;
            }
        }
        if argi + skip >= fnn.as_data.function.params.len {
            return TYPE_NONE;
        }
        let mut pt = self.decl_type_in(
            ct.module,
            unsafe (*fa).list(fnn.as_data.function.params)[(argi + skip) as usize],
        );
        if pt != TYPE_NONE && self.type_at(pt).kind == TypeKind::TYPE_GENERIC {
            let g = *self.type_at(pt);
            let fb = self.generic_fn_bound(g.module, g.as_data.decl);
            if fb != NODE_NONE {
                pt = self.lower_type_in(ct.module, fb);
            }
        }
        if pt != TYPE_NONE && !unsafe (*self.cur_ast()).type_concrete(pt) && skip != 0 {
            let md = unsafe (*self.cur_ast()).resolution_def(cnn.as_data.member.member);
            let mut extnode = NODE_NONE;
            if md.node != NODE_NONE {
                extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
            }
            let mut rm: ModuleId = 0;
            let mut rd = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            let agok = extnode != NODE_NONE && self.aggregate_of(
                self.strip(unsafe (*self.cur_ast()).type_of(cnn.as_data.member.object)),
                &mut rm,
                &mut rd,
                &mut gp,
                &mut ga,
                &mut gn,
            );
            if agok && gn > 0 {
                let mut sp2 = Defs8 {};
                let mut sa = Tys8 {};
                let mut ns: i32 = 0;
                self.frame_ext(md.module, extnode, &ga[0], gn, &mut sp2[0], &mut sa[0], &mut ns);
                pt = self.subst_type(pt, &sp2[0], &sa[0], ns);
            }
        }
        if self.tc_expected_known(pt) {
            return pt;
        }
        return TYPE_NONE;
    }

    // Can parameter type `pt` be an argument's expected type before the call's generic arguments
    // are inferred? A concrete type can, and so can an array with a symbolic length and a concrete
    // element: an array literal takes its element type from it and the length stays evidence. A
    // function type always can: a closure argument takes its shape, and waits for the call's
    // inference while a parameter it gives is still open (`tc_infer_ty_open`).
    fn tc_expected_known(self: &Self, pt: TypeId) bool {
        if pt == TYPE_NONE {
            return false;
        }
        let y = *self.type_at(pt);
        return y.concrete || y.kind == TypeKind::TYPE_FUNCTION || y.arr_sym() && self.type_at(y.as_data.arr.elem).concrete;
    }

    // `forid` receives the selected `next` (call_info) and its substituted Option return type
    // (type_args): the facts Core IR lowering replays instead of re-deriving the protocol.
    fn iter_elem_type(self: &mut Self, forid: NodeId, it: TypeId) TypeId {
        let mut im: ModuleId = 0;
        let mut idl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(it, &mut im, &mut idl, &mut gp, &mut ga, &mut gn) {
            return TYPE_NONE;
        }
        let nx = self.find_method_cstr(im, idl, "next");
        if nx.node == NODE_NONE {
            return TYPE_NONE;
        }
        let na = self.mod_ast(nx.module);
        let rets = unsafe (*na).at_const(nx.node).as_data.function.returns;
        if rets.len != 1 {
            return TYPE_NONE;
        }
        let r0 = unsafe (*na).list(rets)[0];
        let mut ret = self.node_type_in(nx.module, r0);
        let extnode = self.enclosing(nx.module, nx.node, NodeKind::NODE_EXTEND);
        if extnode != NODE_NONE && gn > 0 {
            let mut ip = Defs8 {};
            let mut ia = Tys8 {};
            let mut in2: i32 = 0;
            self.frame_ext(nx.module, extnode, &ga[0], gn, &mut ip[0], &mut ia[0], &mut in2);
            ret = self.subst_type(ret, &ip[0], &ia[0], in2);
        }
        let rt = self.type_at(ret);
        if rt.kind == TypeKind::TYPE_INSTANCE {
            let oi = *unsafe (*self.cur_ast()).instance(rt.as_data.inst);
            if oi.n >= 1 {
                unsafe (*self.cur_ast()).call_info.insert(forid, nx.module as u64 << 40 | nx.node as u64 << 8);
                let tt = ret;
                unsafe (*self.cur_ast()).set_type_args(forid, &tt, 1);
                return oi.args[0];
            }
        }
        return TYPE_NONE;
    }

    // Node builders for the rewrite; each keeps the resolution/type side tables sized (they were
    // sized before typecheck, and these are the only nodes built during it).
    fn tc_add_node(self: &mut Self, n: Node) NodeId {
        let nid = unsafe (*self.cur_ast()).add(n);
        unsafe (*self.cur_ast()).grow_sidetables();
        return nid;
    }
    fn tc_ident(self: &mut Self, span: tok::Span) NodeId {
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_IDENTIFIER,
                span: span,
                as_data: NodeAs { name: NameData { text: span, is_mutable: false } },
            },
        );
    }
    fn tc_local_use(self: &mut Self, span: tok::Span, letn: NodeId) NodeId {
        let u = self.tc_ident(span);
        let m = unsafe (*self.cur_ast()).module;
        unsafe (*self.cur_ast()).seed_resolution(u, DefId { module: m, node: letn });
        return u;
    }
    fn tc_ref_of(self: &mut Self, operand: NodeId, mutable: bool) NodeId {
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_UNARY,
                span: unsafe (*self.cur_ast()).at_const(operand).span,
                as_data: NodeAs {
                    unary: UnaryData {
                        op: TokenType::Ampersand,
                        operand: operand,
                        qualifier: if mutable {
                            TypeQualifier::TYPE_QUAL_MUT;
                        } else {
                            TypeQualifier::TYPE_QUAL_NONE;
                        },
                    },
                },
            },
        );
    }
    fn tc_deref_of(self: &mut Self, operand: NodeId) NodeId {
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_UNARY,
                span: unsafe (*self.cur_ast()).at_const(operand).span,
                as_data: NodeAs {
                    unary: UnaryData { op: TokenType::Star, operand: operand, qualifier: TypeQualifier::TYPE_QUAL_NONE },
                },
            },
        );
    }
    fn tc_expr_stmt(self: &mut Self, value: NodeId, span: tok::Span) NodeId {
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_EXPRESSION_STATEMENT,
                span: span,
                as_data: NodeAs { single: SingleData { value: value } },
            },
        );
    }
    fn tc_lit(self: &mut Self, from: u32, to: u32, tt2: TokenType, seg: bool) NodeId {
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_LITERAL,
                span: tok::Span { start: from, end: to },
                as_data: NodeAs {
                    literal: LiteralData { raw: tok::Span { start: from, end: to }, token_type: tt2, seg: seg },
                },
            },
        );
    }
    // `let [mut] f = sugar_fmt_new();` at `kw`, pushed onto the open statement list; the binding.
    fn fmt_open(self: &mut Self, kw: tok::Span, mutable: bool) NodeId {
        let newc = self.tc_shim_call("sugar_fmt_new", kw, null, 0);
        let letf = self.tc_add_node(
            Node {
                kind: NodeKind::NODE_LET,
                span: kw,
                as_data: NodeAs {
                    let_stmt: LetData { name: self.tc_ident(kw), ty: NODE_NONE, value: newc, is_mutable: mutable },
                },
            },
        );
        unsafe (*self.cur_ast()).push(letf);
        return letf;
    }

    // End a format rewrite: `tail` closes the statements pushed since `mark`, node `id` becomes their
    // block, and the block is checked.
    fn fmt_close(self: &mut Self, id: NodeId, mark: u32, tail: NodeId) TypeId {
        unsafe (*self.cur_ast()).push(tail);
        let stmts = unsafe (*self.cur_ast()).commit(mark);
        unsafe (*self.cur_ast()).at(id).kind = NodeKind::NODE_BLOCK;
        unsafe (*self.cur_ast()).at(id).as_data = NodeAs { block: BlockData { statements: stmts } };
        // The arguments were checked and linted before the rewrite: a warning (and its fix) that
        // checking them again inside the block adds repeats one of theirs or names synthesized code.
        let nw = self.errors.warns.len();
        let nf = self.errors.fixes.len();
        let r = self.check_expr(id);
        self.errors.warns.truncate(nw);
        self.errors.fixes.truncate(nf);
        return r;
    }

    // A call to a prelude `sugar_fmt_*` shim (std/string.spc): the callee identifier's text is
    // never read because its resolution is seeded here.
    fn tc_shim_call(self: &mut Self, name: str, span: tok::Span, sa: *const NodeId, n: u32) NodeId {
        let h = unsafe (*self.package).prelude_lookup(name, false);
        let callee = self.tc_ident(span);
        unsafe (*self.cur_ast()).seed_resolution(callee, DefId { module: h.mid, node: h.node });
        let mark = unsafe (*self.cur_ast()).mark();
        for i in 0..n {
            unsafe (*self.cur_ast()).push(unsafe sa[i as usize]);
        }
        let cargs = unsafe (*self.cur_ast()).commit(mark);
        return self.tc_add_node(
            Node {
                kind: NodeKind::NODE_CALL,
                span: span,
                as_data: NodeAs { call: CallData { callee: callee, args: cargs } },
            },
        );
    }
    // `sugar_fmt_<shim>(first, v, ...extra)`: the String always threads by value as `first`.
    fn tc_fmt_call(self: &mut Self, shim: str, kw: tok::Span, first: NodeId, v: NodeId, extra: NodeId) NodeId {
        let mut sa = Nodes8 {};
        let mut n: u32 = 0;
        if first != NODE_NONE {
            sa[0] = first;
            n = 1;
        }
        if v != NODE_NONE {
            sa[n as usize] = v;
            n = n + 1;
        }
        if extra != NODE_NONE {
            sa[n as usize] = extra;
            n = n + 1;
        }
        return self.tc_shim_call(shim, kw, &sa[0], n);
    }
    // `f = <call>;` pushed as a statement.
    fn tc_fmt_assign(self: &mut Self, letf: NodeId, kw: tok::Span, call: NodeId) {
        let asg = self.tc_add_node(
            Node {
                kind: NodeKind::NODE_ASSIGNMENT,
                span: kw,
                as_data: NodeAs {
                    binary: BinaryData { left: self.tc_local_use(kw, letf), op: TokenType::Equal, right: call },
                },
            },
        );
        let stmt = self.tc_expr_stmt(asg, kw);
        unsafe (*self.cur_ast()).push(stmt);
    }
    // `f = sugar_fmt_<shim>(f, v);` pushed as a statement.
    fn tc_fmt_push(self: &mut Self, letf: NodeId, kw: tok::Span, shim: str, v: NodeId, extra: NodeId) {
        let call = self.tc_fmt_call(shim, kw, self.tc_local_use(kw, letf), v, extra);
        self.tc_fmt_assign(letf, kw, call);
    }

    // One placeholder: dispatch on the ARGUMENT's checked type to a shim whose value parameter
    // every source type reaches by implicit lossless widening (no synthesized casts), mirroring
    // what the old codegen lowering emitted per type. A width spec renders the value through the
    // SAME shim onto a fresh String and pads it in as a piece. False = reported, caller abandons.
    fn tc_fmt_arg(
        self: &mut Self,
        letf: NodeId,
        kw: tok::Span,
        argid: NodeId,
        sty: u8,
        prec_s: u32,
        prec_e: u32,
        width_s: u32,
        width_e: u32,
        fill_s: u32,
        fill_e: u32,
        align: u8,
        mt: bool,
    ) bool {
        let at = unsafe (*self.cur_ast()).type_of(argid);
        let y = *self.type_at(at);
        let asp = unsafe (*self.cur_ast()).at_const(argid).span;
        let b = if y.kind == TypeKind::TYPE_BUILTIN {
            y.as_data.builtin;
        } else {
            BuiltinType::BT_COUNT;
        };
        let prec_seen = prec_e > prec_s;
        if prec_seen && !(b == BuiltinType::BT_F32 || b == BuiltinType::BT_F64) {
            self.errors.emit_span(asp, format("{}", "`{:.N}` precision requires a float argument"));
            return false;
        }
        let signed = b as u8 >= BuiltinType::BT_I8 as u8 && b as u8 <= BuiltinType::BT_ISIZE as u8;
        let unsig = b as u8 >= BuiltinType::BT_U8 as u8 && b as u8 <= BuiltinType::BT_USIZE as u8;
        let mut shim: str = "";
        let mut varg = argid;
        let mut extra = NODE_NONE;
        if sty != 0 as u8 {
            if sty == b'b' {
                if b == BuiltinType::BT_I8 || b == BuiltinType::BT_U8 {
                    shim = "sugar_fmt_bin8";
                } else if b == BuiltinType::BT_I16 || b == BuiltinType::BT_U16 {
                    shim = "sugar_fmt_bin16";
                } else if b == BuiltinType::BT_I32 || b == BuiltinType::BT_U32 {
                    shim = "sugar_fmt_bin32";
                } else if b == BuiltinType::BT_I64 {
                    shim = "sugar_fmt_bin64i";
                } else if b == BuiltinType::BT_U64 {
                    shim = "sugar_fmt_bin64u";
                } else if b == BuiltinType::BT_ISIZE {
                    shim = "sugar_fmt_bin_is";
                } else if b == BuiltinType::BT_USIZE {
                    shim = "sugar_fmt_bin_us";
                } else if b == BuiltinType::BT_CHAR {
                    shim = "sugar_fmt_bin_c";
                }
            } else if b == BuiltinType::BT_ISIZE {
                shim = if sty == b'X' {
                    "sugar_fmt_hex_is_up";
                } else {
                    "sugar_fmt_hex_is";
                };
            } else if b == BuiltinType::BT_USIZE {
                shim = if sty == b'X' {
                    "sugar_fmt_hex_us_up";
                } else {
                    "sugar_fmt_hex_us";
                };
            } else if signed {
                shim = if sty == b'X' {
                    "sugar_fmt_hex_i_up";
                } else {
                    "sugar_fmt_hex_i";
                };
            } else if unsig {
                shim = if sty == b'X' {
                    "sugar_fmt_hex_u_up";
                } else {
                    "sugar_fmt_hex_u";
                };
            } else if b == BuiltinType::BT_CHAR {
                shim = if sty == b'X' {
                    "sugar_fmt_hex_c_up";
                } else {
                    "sugar_fmt_hex_c";
                };
            }
            if shim.len() == 0 {
                self.errors.emit_span(asp, format("{}", "`{:x}`/`{:X}`/`{:b}` formats require an integer argument"));
                return false;
            }
        } else if prec_seen {
            shim = "sugar_fmt_f64_prec";
            extra = self.tc_lit(prec_s, prec_e, TokenType::IntegerLiteral, false);
        } else if b != BuiltinType::BT_COUNT {
            shim = if b == BuiltinType::BT_BOOL {
                "sugar_fmt_bool";
            } else if b == BuiltinType::BT_CHAR {
                "sugar_fmt_char";
            } else if b == BuiltinType::BT_ISIZE {
                "sugar_fmt_isize";
            } else if b == BuiltinType::BT_USIZE {
                "sugar_fmt_usize";
            } else if signed {
                "sugar_fmt_i64";
            } else if unsig {
                "sugar_fmt_u64";
            } else if b == BuiltinType::BT_F32 || b == BuiltinType::BT_F64 {
                "sugar_fmt_f64";
            } else {
                "";
            };
            if shim.len() == 0 {
                return self.tc_fmt_unformattable(asp);
            }
        } else if at == self.prelude_str_type() {
            shim = "sugar_fmt_str";
        } else {
            // Strip references; aggregates and generic params go through the `Format` bound.
            let mut vt = at;
            let mut rd: u32 = 0;
            while self.type_at(vt).kind == TypeKind::TYPE_REFERENCE {
                vt = self.type_at(vt).as_data.elem;
                rd = rd + 1;
            }
            let vy = *self.type_at(vt);
            if rd == 0 && vy.kind == TypeKind::TYPE_INSTANCE {
                // A Global-allocated String pushes directly; other allocators format via `fmt`.
                let ii = *unsafe (*self.cur_ast()).instance(vy.as_data.inst);
                let sh = self.ph_string;
                let gh = self.ph_global;
                if ii.decl == sh.node && ii.module == sh.mid && ii.n == 1 && ii.args[0] == self.named_type_of(
                    gh.mid,
                    gh.node,
                ) {
                    if self.is_place(argid) {
                        shim = "sugar_fmt_string";
                        varg = self.tc_ref_of(argid, false);
                    } else {
                        shim = "sugar_fmt_owned";
                    }
                }
            }
            if shim.len() == 0 {
                if vy.kind == TypeKind::TYPE_STRUCT || vy.kind == TypeKind::TYPE_ENUM || vy.kind == TypeKind::TYPE_INSTANCE || vy.kind == TypeKind::TYPE_GENERIC {
                    if rd == 0 && !self.is_place(argid) {
                        shim = "sugar_fmt_val_owned";
                    } else {
                        shim = "sugar_fmt_val";
                        if rd == 0 {
                            varg = self.tc_ref_of(argid, false);
                        } else {
                            let mut k: u32 = 1;
                            while k < rd {
                                varg = self.tc_deref_of(varg);
                                k = k + 1;
                            }
                        }
                    }
                } else {
                    return self.tc_fmt_unformattable(asp);
                }
            }
        }
        if width_e > width_s {
            // `f = sugar_fmt_pad_X(f, <shim>(sugar_fmt_new(), v), width, fill);`.
            let pshim = if align == b'<' {
                "sugar_fmt_pad_l";
            } else if align == b'^' {
                "sugar_fmt_pad_c";
            } else if align == b'>' {
                "sugar_fmt_pad_r";
            } else if self.is_numeric(at) {
                "sugar_fmt_pad_r";
            } else {
                "sugar_fmt_pad_l";
            };
            let newc = self.tc_fmt_call("sugar_fmt_new", kw, NODE_NONE, NODE_NONE, NODE_NONE);
            let piece = self.tc_fmt_call(shim, kw, newc, varg, extra);
            let mut pa = Nodes8 {};
            pa[0] = self.tc_local_use(kw, letf);
            pa[1] = piece;
            pa[2] = self.tc_lit(width_s, width_e, TokenType::IntegerLiteral, false);
            // The fill character rides as a RAW one-byte segment literal (escaping-proof).
            pa[3] = self.tc_lit(fill_s, fill_e, TokenType::RawStringLiteral, true);
            let pc = self.tc_shim_call(pshim, kw, &pa[0], 4);
            self.tc_fmt_assign(letf, kw, pc);
        } else if mt && (shim == "sugar_fmt_str" || shim == "sugar_fmt_char" || shim == "sugar_fmt_string" || shim == "sugar_fmt_owned" || shim == "sugar_fmt_val" || shim == "sugar_fmt_val_owned") {
            // Matchertext hole whose piece can carry matcher bytes: render it onto a fresh String
            // and splice through the runtime matchertext check (numeric/bool pieces never can, and
            // append directly). `f = sugar_mt_splice(f, <shim>(sugar_fmt_new(), v));`.
            let newc = self.tc_fmt_call("sugar_fmt_new", kw, NODE_NONE, NODE_NONE, NODE_NONE);
            let piece = self.tc_fmt_call(shim, kw, newc, varg, extra);
            let mut pa = Nodes8 {};
            pa[0] = self.tc_local_use(kw, letf);
            pa[1] = piece;
            let pc = self.tc_shim_call("sugar_mt_splice", kw, &pa[0], 2);
            self.tc_fmt_assign(letf, kw, pc);
        } else {
            self.tc_fmt_push(letf, kw, shim, varg, extra);
        }
        return true;
    }

    fn tc_fmt_unformattable(self: &mut Self, asp: tok::Span) bool {
        self.errors.emit_span(asp, format("{}", "argument is not directly formattable (call its .fmt())"));
        self.errors.note(format("implement Format for this type or pass a value that already formats directly"));
        return false;
    }

    // `format("a{}b", v)` rewrites IN PLACE into a value block
    //     { let mut f = sugar_fmt_new(); sugar_fmt_str(&mut f, "a"); sugar_fmt_i64(&mut f, v); ... f; }
    // then the block is typechecked like handwritten code: downstream passes never see a `format`
    // call, so const-eval folds it through the ordinary interpreter and codegen needs no format
    // lowering. Template diagnostics live here now; every error path leaves the node as the
    // (already reported) call, which nothing downstream runs on.
    // `pkind`: 0 = `format()` (block value = the String); 1..4 = the print family
    // (print/println/eprint/eprintln): the block tail CALLS the matching String method instead,
    // so the print expansion is settled here once and every later stage sees plain calls.
    fn tc_check_format_p(self: &mut Self, id: NodeId, pkind: u32) TypeId {
        let sh = self.ph_string;
        let gh = self.ph_global;
        let mut sa = Tys8 {};
        sa[0] = self.named_type_of(gh.mid, gh.node);
        let sret = unsafe (*self.cur_ast()).intern_instance(sh.mid, sh.node, &sa[0], 1);
        unsafe (*self.cur_ast()).set_type(id, sret);
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        let args = unsafe (*self.cur_ast()).at_const(id).as_data.call.args;
        let mut is_raw = false;
        let mut ok_lit = false;
        if args.len > 0 {
            let a0 = unsafe (*self.cur_ast()).list(args)[0];
            if unsafe (*self.cur_ast()).at_const(a0).kind == NodeKind::NODE_LITERAL {
                let t0 = unsafe (*self.cur_ast()).at_const(a0).as_data.literal.token_type;
                is_raw = t0 == TokenType::MatchertextLiteral;
                ok_lit = t0 == TokenType::StringLiteral || is_raw;
            }
        }
        if !ok_lit {
            self.errors.emit_span(sp, format("format string must be a string literal"));
            self.errors.note(format("format strings are parsed at compile time so placeholders can be checked"));
            return sret;
        }
        let ne0 = self.errors.errors.len();
        for i in 1..args.len {
            if untyped(self.check_expr(unsafe (*self.cur_ast()).list(args)[i as usize])) {
                return sret;
            }
        }
        if self.errors.errors.len() != ne0 {
            return sret;
        }
        let a0 = unsafe (*self.cur_ast()).list(args)[0];
        let rawsp = unsafe (*self.cur_ast()).at_const(a0).as_data.literal.raw;
        let src = self.source;
        let content = if is_raw {
            tc_mt_content(src, rawsp);
        } else {
            tok::Span { start: rawsp.start + 1, end: rawsp.end - 1 };
        };
        let mut kw = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).at_const(id).as_data.call.callee).span;
        if pkind == 5 {
            // Member callee: the synthetic local's ident must be the METHOD name alone.
            let mm = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).at_const(id).as_data.call.callee).as_data.member.member;
            kw = unsafe (*self.cur_ast()).at_const(mm).span;
        }
        // Template segments decode verbatim for BOTH raw and matchertext templates, and `{{`/`}}`
        // collapsing applies to every format template, so they ride as raw segments. (Matchertext
        // segment literals are reserved for NODE_INTERP, where braces stay plain matchers.)
        let seg_tt = if is_raw {
            TokenType::RawStringLiteral;
        } else {
            TokenType::StringLiteral;
        };
        let mark = unsafe (*self.cur_ast()).mark();
        // Every segment/placeholder append reassigns the binding; an empty template appends nothing,
        // so `mut` would lint as unneeded.
        let letf = self.fmt_open(kw, content.start < content.end);
        let endc = content.end;
        let mut i = content.start;
        let mut seg = i;
        let mut ai: u32 = 1;
        let mut bad = false;
        while i < endc {
            let c = src[i as usize];
            if (c == b'{' || c == b'}') && i + 1 < endc && src[(i + 1) as usize] == c {
                i = i + 2;
                continue;
            }
            if c == b'{' {
                // Scan the spec keeping SPANS: every literal the rewrite builds points at real text.
                let mut fill_s = i;
                let mut fill_e = i;
                let mut align: u8 = 0;
                let mut width_s = i;
                let mut width_e = i;
                let mut prec_s = i;
                let mut prec_e = i;
                let mut sty: u8 = 0;
                let mut j = i + 1;
                if j < endc && src[j as usize] == b':' {
                    j = j + 1;
                    if j + 1 < endc && (src[(j + 1) as usize] == b'<' || src[(j + 1) as usize] == b'>' || src[(j + 1) as usize] == b'^') && src[j as usize] != b'}' {
                        fill_s = j;
                        fill_e = j + 1;
                        align = src[(j + 1) as usize];
                        j = j + 2;
                    } else if j < endc && (src[j as usize] == b'<' || src[j as usize] == b'>' || src[j as usize] == b'^') {
                        align = src[j as usize];
                        j = j + 1;
                    }
                    if j < endc && src[j as usize] == b'0' && fill_e == fill_s {
                        fill_s = j;
                        fill_e = j + 1;
                        j = j + 1;
                    }
                    width_s = j;
                    while j < endc && src[j as usize] >= b'0' && src[j as usize] <= b'9' {
                        j = j + 1;
                    }
                    width_e = j;
                    if j < endc && src[j as usize] == b'.' {
                        j = j + 1;
                        prec_s = j;
                        while j < endc && src[j as usize] >= b'0' && src[j as usize] <= b'9' {
                            j = j + 1;
                        }
                        prec_e = j;
                    }
                    if j < endc && (src[j as usize] == b'x' || src[j as usize] == b'X' || src[j as usize] == b'b') {
                        sty = src[j as usize];
                        j = j + 1;
                    }
                }
                if j < endc && src[j as usize] == b'}' {
                    if i > seg {
                        let sl = self.tc_lit(seg, i, seg_tt, true);
                        self.tc_fmt_push(letf, kw, "sugar_fmt_str", sl, NODE_NONE);
                    }
                    if ai >= args.len {
                        self.errors.emit_span(sp, format("{}", "more `{}` placeholders than arguments"));
                        self.errors.note(
                            format(
                                "{}",
                                "add an argument for each placeholder or escape literal braces as '{{' and '}}'",
                            ),
                        );
                        bad = true;
                        break;
                    }
                    let argid = unsafe (*self.cur_ast()).list(args)[ai as usize];
                    if !self.tc_fmt_arg(
                        letf,
                        kw,
                        argid,
                        sty,
                        prec_s,
                        prec_e,
                        width_s,
                        width_e,
                        fill_s,
                        fill_e,
                        align,
                        false,
                    ) {
                        bad = true;
                        break;
                    }
                    ai = ai + 1;
                    i = j + 1;
                    seg = i;
                    continue;
                }
            }
            i = i + 1;
        }
        if !bad && ai < args.len {
            self.errors.emit_span(sp, format("{}", "more arguments than `{}` placeholders"));
            self.errors.note(format("{}", "remove the extra argument or add a matching '{}' placeholder"));
            bad = true;
        }
        if bad {
            // Abandon the partial rewrite; the nodes stay, unreferenced.
            unsafe (*self.cur_ast()).commit(mark);
            return sret;
        }
        if endc > seg {
            let sl = self.tc_lit(seg, endc, seg_tt, true);
            self.tc_fmt_push(letf, kw, "sugar_fmt_str", sl, NODE_NONE);
        }
        let mut tail = NODE_NONE;
        if pkind == 0 {
            tail = self.tc_expr_stmt(self.tc_local_use(kw, letf), kw);
        } else if pkind == 5 {
            // `buf.format_into(fmt, ...)`: absorb the rendered piece into `&mut buf`.
            let recv = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).at_const(id).as_data.call.callee).as_data.member.object;
            // A receiver that is ALREADY a mutable reference passes through unwrapped.
            let rvt = self.type_at(unsafe (*self.cur_ast()).type_of(recv)).kind;
            let mut rref = recv;
            if rvt != TypeKind::TYPE_REFERENCE && rvt != TypeKind::TYPE_POINTER {
                rref = self.tc_add_node(
                    Node {
                        kind: NodeKind::NODE_UNARY,
                        span: kw,
                        as_data: NodeAs {
                            unary: UnaryData {
                                op: TokenType::Ampersand,
                                operand: recv,
                                qualifier: TypeQualifier::TYPE_QUAL_MUT,
                            },
                        },
                    },
                );
            }
            let mut sa2 = Nodes8 {};
            sa2[0] = rref;
            sa2[1] = self.tc_local_use(kw, letf);
            let pcall = self.tc_shim_call("sugar_format_into", kw, &sa2[0], 2);
            tail = self.tc_expr_stmt(pcall, kw);
        } else {
            // The consuming print tails write and free the buffer in one move.
            let mut shim2: str = "sugar_print";
            if pkind == 2 {
                shim2 = "sugar_println";
            } else if pkind == 3 {
                shim2 = "sugar_eprint";
            } else if pkind == 4 {
                shim2 = "sugar_eprintln";
            }
            let mut sa2 = Nodes8 {};
            sa2[0] = self.tc_local_use(kw, letf);
            let pcall = self.tc_shim_call(shim2, kw, &sa2[0], 1);
            tail = self.tc_expr_stmt(pcall, kw);
        }
        return self.fmt_close(id, mark, tail);
    }

    // An interpolating matchertext literal rewrites IN PLACE into the same `sugar_fmt_*` value
    // block `format()` desugars to: each verbatim segment pushes as a str piece, each hole
    // expression dispatches through tc_fmt_arg with no format spec. Downstream passes never see
    // NODE_INTERP.
    fn tc_check_interp(self: &mut Self, id: NodeId) TypeId {
        let sh = self.ph_string;
        let gh = self.ph_global;
        let mut sa = Tys8 {};
        sa[0] = self.named_type_of(gh.mid, gh.node);
        let sret = unsafe (*self.cur_ast()).intern_instance(sh.mid, sh.node, &sa[0], 1);
        unsafe (*self.cur_ast()).set_type(id, sret);
        let kids = unsafe (*self.cur_ast()).at_const(id).as_data.block.statements;
        // The rewrite's identifiers render from their span text, so use only the leading `M`.
        let sp0 = unsafe (*self.cur_ast()).at_const(id).span;
        let kw = tok::Span { start: sp0.start, end: sp0.start + 1 };
        let ne0 = self.errors.errors.len();
        for i in 0..kids.len {
            let kid = unsafe (*self.cur_ast()).list(kids)[i as usize];
            let kn = unsafe (*self.cur_ast()).at_const(kid);
            if kn.kind == NodeKind::NODE_LITERAL && kn.as_data.literal.seg {
                continue;
            }
            if untyped(self.check_expr(kid)) {
                return sret;
            }
        }
        if self.errors.errors.len() != ne0 {
            return sret;
        }
        let mark = unsafe (*self.cur_ast()).mark();
        let letf = self.fmt_open(kw, true);
        let mut bad = false;
        for i in 0..kids.len {
            let kid = unsafe (*self.cur_ast()).list(kids)[i as usize];
            let kn = unsafe (*self.cur_ast()).at_const(kid);
            if kn.kind == NodeKind::NODE_LITERAL && kn.as_data.literal.seg {
                self.tc_fmt_push(letf, kw, "sugar_fmt_str", kid, NODE_NONE);
            } else if !self.tc_fmt_arg(letf, kw, kid, 0, 0, 0, 0, 0, 0, 0, 0, true) {
                bad = true;
                break;
            }
        }
        if bad {
            // Abandon the partial rewrite; the nodes stay, unreferenced.
            unsafe (*self.cur_ast()).commit(mark);
            return sret;
        }
        let tail = self.tc_expr_stmt(self.tc_local_use(kw, letf), kw);
        return self.fmt_close(id, mark, tail);
    }

    fn tc_check_assert(self: &mut Self, id: NodeId, kind: i32) TypeId {
        let a = self.cur_ast();
        let args = unsafe (*a).at_const(id).as_data.call.args;
        let sp = unsafe (*a).at_const(id).span;
        if kind == 1 {
            if args.len < 1 || args.len > 2 {
                self.errors.emit_span(sp, format("'assert' takes a condition and an optional str message"));
                for i in 0..args.len {
                    self.check_expr(unsafe (*a).list(args)[i as usize]);
                }
                return Ast::builtin(BuiltinType::BT_VOID);
            }
            let ct = self.check_expr(unsafe (*a).list(args)[0]);
            if !untyped(ct) && !self.is_bool(ct) {
                self.errors.emit_span(sp, format("'assert' condition must be 'bool'"));
            }
            if args.len == 2 {
                let mt = self.check_expr(unsafe (*a).list(args)[1]);
                if !untyped(mt) && self.strip(mt) != self.prelude_str_type() {
                    self.errors.emit_span(sp, format("'assert' message must be a 'str'"));
                }
            }
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        let mut nm = "assert_eq".ptr() as *const char;
        if kind == 3 {
            nm = "assert_ne".ptr() as *const char;
        }
        if args.len != 2 {
            self.errors.emit_span(sp, format("'{}' takes exactly two arguments", str::from_cstr(nm)));
            for i in 0..args.len {
                self.check_expr(unsafe (*a).list(args)[i as usize]);
            }
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        let lt = self.check_expr(unsafe (*a).list(args)[0]);
        let rt = self.check_expr_w(unsafe (*a).list(args)[1], lt);
        if untyped(lt) || untyped(rt) {
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        if lt != rt && !self.compatible(lt, unsafe (*a).list(args)[1]) && !self.compatible(
            rt,
            unsafe (*a).list(args)[0],
        ) {
            self.err_mismatch(unsafe (*a).list(args)[1], lt);
        }
        let base = self.strip(lt);
        let y = *self.type_at(base);
        let mut comparable = y.kind == TypeKind::TYPE_BUILTIN && y.as_data.builtin != BuiltinType::BT_VOID && y.as_data.builtin != BuiltinType::BT_VALIST;
        if base == self.prelude_str_type() {
            comparable = true;
        }
        if !comparable && (y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_INSTANCE || y.kind == TypeKind::TYPE_ENUM) {
            let mut om: ModuleId = 0;
            let mut od = NODE_NONE;
            if self.aggregate_decl(base, &mut om, &mut od) {
                comparable = self.find_method_cstr(om, od, "eq").node != NODE_NONE;
                if !comparable && self.is_plain_enum(base) {
                    comparable = true;
                }
                if comparable {
                    self.find_method_cstr(om, od, "as_str");
                }
            }
        }
        if !comparable {
            let ty = self.type_buf(lt);
            self.errors.emit_span(
                sp,
                format("'{}' cannot compare values of type '{}'", str::from_cstr(nm), str::from_cstr(&ty[0])),
            );
            self.errors.note(format("implement 'Eq' (an 'eq' method) for the type, or compare a field/element instead"));
        }
        return Ast::builtin(BuiltinType::BT_VOID);
    }

    // Changed-slot worklist: a slot's obligations (the declared fn bound and its
    // interface bounds) run exactly once, when the slot first resolves. Obligation evidence can
    // resolve further slots; the loop continues to a fixed point. Every round but the last
    // processes a new slot, so a call runs at most `g` + 1 rounds. `processed` persists across
    // re-entry so the expected-result round only touches newly resolvable slots. A slot whose
    // bounds found several fitting conformances (bit in `ambig`) runs again whenever a round
    // resolved another slot, until one conformance fits or the fixed point leaves it ambiguous
    // (`tc_report_ambiguous`).
    fn tc_infer_worklist(
        self: &mut Self,
        fmod: ModuleId,
        fdecl: NodeId,
        gens: NodeList,
        bound: *mut TypeId,
        g: i32,
        processed: *mut u32,
        ambig: *mut u32,
    ) {
        let fa = self.mod_ast(fmod);
        let mut making_progress = true;
        while making_progress {
            making_progress = false;
            for k in 0..g {
                if unsafe bound[k as usize] == TYPE_NONE {
                    unsafe bound[k as usize] = self.icx.sv.s_resolve(k as u32, it_conv_join);
                }
                if unsafe bound[k as usize] == TYPE_NONE || (unsafe *processed & 1u32 << k as u32) != 0 {
                    continue;
                }
                unsafe {
                    *processed = *processed | 1u32 << k as u32;
                }
                making_progress = true;
                let gid9 = unsafe (*fa).list(gens)[k as usize];
                if self.type_at(unsafe bound[k as usize]).kind == TypeKind::TYPE_FUNCTION {
                    let fb = self.generic_fn_bound(fmod, gid9);
                    if fb != NODE_NONE {
                        self.tc_infer_ev(self.lower_type_in(fmod, fb), unsafe bound[k as usize], false);
                    }
                }
                if self.tc_slot_obligations(
                    fmod,
                    fdecl,
                    gid9,
                    unsafe bound[k as usize],
                    gens,
                    bound,
                    g,
                    false,
                    tok::Span::empty(),
                ) {
                    unsafe {
                        *ambig = *ambig | 1u32 << k as u32;
                    }
                }
            }
            if !making_progress {
                // Retry the ambiguous slots under the bindings the rounds added.
                for k in 0..g {
                    if (unsafe *ambig & 1u32 << k as u32) == 0 {
                        continue;
                    }
                    let gid9 = unsafe (*fa).list(gens)[k as usize];
                    if !self.tc_slot_obligations(
                        fmod,
                        fdecl,
                        gid9,
                        unsafe bound[k as usize],
                        gens,
                        bound,
                        g,
                        false,
                        tok::Span::empty(),
                    ) {
                        unsafe {
                            *ambig = *ambig & ~(1u32 << k as u32);
                        }
                        for j in 0..g {
                            if unsafe bound[j as usize] == TYPE_NONE && self.icx.sv.s_resolve(j as u32, it_conv_join) != TYPE_NONE {
                                making_progress = true;
                            }
                        }
                    }
                }
            }
        }
    }

    // After the fixed point: every slot still ambiguous (`ambig`) reports the parameter its
    // conformances disagree on (`tc_slot_obligations` with `last`), which then counts as reported.
    fn tc_report_ambiguous(
        self: &mut Self,
        fmod: ModuleId,
        fdecl: NodeId,
        gens: NodeList,
        bound: *mut TypeId,
        g: i32,
        ambig: u32,
        sp: tok::Span,
    ) {
        let fa = self.mod_ast(fmod);
        for k in 0..g {
            if (ambig & 1u32 << k as u32) != 0 {
                let gid9 = unsafe (*fa).list(gens)[k as usize];
                let _ = self.tc_slot_obligations(fmod, fdecl, gid9, unsafe bound[k as usize], gens, bound, g, true, sp);
            }
        }
    }

    // One slot's interface-bound obligations: with `self_ty` known for generic parameter `gid`,
    // find each declared bound's conformances whose interface arguments fit the call's current
    // bindings (`bound[0..g]` for the parameters `gens`) and feed the instantiated interface
    // arguments of the one that fits back as evidence. Several fitting conformances that differ
    // where a parameter is still open infer nothing: true (ambiguous); with `last` the open
    // parameter is reported ("cannot infer 'A': 'P' conforms to 'I' with several arguments") and
    // bound to the error type.
    fn tc_slot_obligations(
        self: &mut Self,
        fmod: ModuleId,
        fdecl: NodeId,
        gid: NodeId,
        self_ty: TypeId,
        gens: NodeList,
        bound: *mut TypeId,
        g: i32,
        last: bool,
        sp: tok::Span,
    ) bool {
        let fa = self.mod_ast(fmod);
        let mut bs = BoundArr8 {};
        let mut nb: i32 = 0;
        let gty = self.named_type_of(fmod, gid);
        self.add_bound_ifaces_full(
            fmod,
            unsafe (*fa).at_const(gid).as_data.generic_param.bounds,
            gty,
            &mut bs[0],
            &mut nb,
            8,
        );
        let wc = unsafe (*fa).at_const(fdecl).as_data.function.where_clause;
        for w in 0..wc.len {
            let wid = unsafe (*fa).list(wc)[w as usize];
            let wp = unsafe (*fa).at_const(wid).as_data.where_predicate;
            if unsafe (*fa).resolution(wp.ty) == gid {
                self.add_bound_ifaces_full(fmod, wp.bounds, gty, &mut bs[0], &mut nb, 8);
            }
        }
        // The call's current substitution: a resolved parameter reads its binding, an open one stays.
        let mut cp = Defs8 {};
        let mut ca = Tys8 {};
        let mut cn: i32 = 0;
        for k in 0..g {
            if unsafe bound[k as usize] != TYPE_NONE && unsafe bound[k as usize] != TYPE_ERROR {
                cp[cn as usize] = DefId { module: fmod, node: unsafe (*fa).list(gens)[k as usize] };
                ca[cn as usize] = unsafe bound[k as usize];
                cn += 1;
            }
        }
        let mut ambiguous = false;
        for b in 0..nb {
            let n = bs[b as usize].n as i32;
            if n == 0 {
                continue;
            }
            let iface = bs[b as usize].iface;
            let mut want = Tys8 {};
            for kk in 0..n {
                want[kk as usize] = self.subst_type(unsafe bs[b as usize].args[kk as usize], &cp[0], &ca[0], cn);
            }
            // The interface arguments `self_ty` conforms with: each conformance of an aggregate or a
            // builtin (its extend's parameters solved from the instance), each bound of a type
            // parameter (through superinterfaces).
            let mut cands = Vector::<Tys8>::new();
            let sy = *self.type_at(self.strip(self_ty));
            if sy.kind == TypeKind::TYPE_GENERIC {
                let mut pb = BoundArr8 {};
                let pn = self.collect_param_bounds_full(sy.module, sy.as_data.decl, &mut pb[0], 8);
                for q in 0..pn {
                    let mut ga = Tys8 {};
                    let gnum = self.tc_super_args(
                        pb[q as usize].iface,
                        &pb[q as usize].args[0],
                        pb[q as usize].n,
                        self.strip(self_ty),
                        iface,
                        &mut ga[0],
                        0,
                    );
                    if gnum >= n {
                        cands.push(ga);
                    }
                }
            } else {
                let mut tm: ModuleId = 0;
                let mut td = NODE_NONE;
                let mut tgp = Defs8 {};
                let mut sa = Tys8 {};
                let mut sn: i32 = 0;
                if sy.kind == TypeKind::TYPE_BUILTIN {
                    tm = unsafe (*self.package).core_module;
                    td = unsafe (*self.package).builtin_decl(sy.as_data.builtin);
                } else if !self.aggregate_of(self.strip(self_ty), &mut tm, &mut td, &mut tgp, &mut sa, &mut sn) {
                    td = NODE_NONE;
                }
                if td != NODE_NONE {
                    let mut c = self.ext_begin(tm, td);
                    loop {
                        let e = self.ext_next(&mut c);
                        if e.node == NODE_NONE {
                            break;
                        }
                        let ia = self.mod_ast(e.module);
                        let itn = unsafe (*ia).at_const(e.node).as_data.extend_def.interface_type;
                        if itn == NODE_NONE || unsafe (*ia).at_const(itn).kind != NodeKind::NODE_TYPE_PATH {
                            continue;
                        }
                        let tr = unsafe (*ia).resolution_def(itn);
                        if tr.module != iface.module || tr.node != iface.node {
                            continue;
                        }
                        let mut ega = Tys8 {};
                        let egn = self.tc_ext_args(e.module, e.node, &sa[0], sn, &mut ega[0]);
                        if egn < 0 {
                            continue;
                        }
                        let egids = unsafe (*ia).at_const(e.node).as_data.extend_def.generics;
                        let mut egp = Defs8 {};
                        for k in 0..egn {
                            egp[k as usize] = DefId { module: e.module, node: unsafe (*ia).list(egids)[k as usize] };
                        }
                        let mut ita = Tys8 {};
                        let itn2 = self.tc_path_args(e.module, itn, iface, &mut ita[0]) as i32;
                        if itn2 < n {
                            continue;
                        }
                        for kk in 0..n {
                            ita[kk as usize] = self.subst_type(ita[kk as usize], &egp[0], &ega[0], egn);
                        }
                        cands.push(ita);
                    }
                }
            }
            // The candidates whose arguments fit the known ones: the first, how many, and the first
            // argument two of them disagree on.
            let mut fit = Tys8 {};
            let mut nfit: u32 = 0;
            let mut differ = -1;
            for ci in 0..cands.len() {
                let ita = *cands.at(ci);
                let mut ok = true;
                for kk in 0..n {
                    ok = ok && self.tc_bound_arg_fits(want[kk as usize], ita[kk as usize], fmod, gens, bound, g, 0);
                }
                if !ok {
                    continue;
                }
                if nfit == 0 {
                    fit = ita;
                } else {
                    for kk in 0..n {
                        if differ < 0 && fit[kk as usize] != ita[kk as usize] {
                            differ = kk;
                        }
                    }
                }
                nfit += 1;
            }
            if nfit == 0 {
                continue;
            }
            if differ >= 0 {
                ambiguous = true;
                if last {
                    self.tc_err_ambiguous_conf(fmod, gens, bound, g, want[differ as usize], self_ty, iface, sp);
                }
                continue;
            }
            for kk in 0..n {
                self.tc_infer_ev(unsafe bs[b as usize].args[kk as usize], fit[kk as usize], false);
            }
        }
        return ambiguous;
    }

    // Whether bound argument `w` (the call's current substitution applied) can be conformance
    // argument `c`: equal, with a parameter of `gens` the call leaves open (`bound`) matching anything.
    fn tc_bound_arg_fits(
        self: &Self,
        w: TypeId,
        c: TypeId,
        fmod: ModuleId,
        gens: NodeList,
        bound: *const TypeId,
        g: i32,
        depth: i32,
    ) bool {
        if w == c {
            return true;
        }
        if depth > 16 || w == TYPE_NONE || c == TYPE_NONE {
            return false;
        }
        let wy = *self.type_at(w);
        if wy.kind == TypeKind::TYPE_GENERIC && wy.module == fmod {
            let fa = self.mod_ast(fmod);
            for k in 0..g {
                if unsafe (*fa).list(gens)[k as usize] == wy.as_data.decl {
                    return unsafe bound[k as usize] == TYPE_NONE;
                }
            }
        }
        let cy = *self.type_at(c);
        if wy.kind != cy.kind || wy.qualifier != cy.qualifier {
            return false;
        }
        if wy.kind == TypeKind::TYPE_POINTER || wy.kind == TypeKind::TYPE_REFERENCE || wy.kind == TypeKind::TYPE_SLICE {
            return self.tc_bound_arg_fits(wy.as_data.elem, cy.as_data.elem, fmod, gens, bound, g, depth + 1);
        }
        if wy.rec() != NO_REC {
            let wi = *unsafe (*self.cur_ast()).instance(wy.rec());
            let ci = *unsafe (*self.cur_ast()).instance(cy.rec());
            if wi.module != ci.module || wi.decl != ci.decl || wi.n != ci.n {
                return false;
            }
            for i in 0..wi.n {
                if !self.tc_bound_arg_fits(
                    unsafe wi.args[i as usize],
                    unsafe ci.args[i as usize],
                    fmod,
                    gens,
                    bound,
                    g,
                    depth + 1,
                ) {
                    return false;
                }
            }
            return true;
        }
        return false;
    }

    // Whether type `t` names generic parameter `gid` of module `m`.
    fn tc_ty_names_param(self: &Self, t: TypeId, m: ModuleId, gid: NodeId, depth: i32) bool {
        if t == TYPE_NONE || depth > 16 || unsafe (*self.cur_ast()).type_concrete(t) {
            return false;
        }
        let y = *self.type_at(t);
        if y.kind == TypeKind::TYPE_GENERIC {
            return y.module == m && y.as_data.decl == gid;
        }
        if y.kind == TypeKind::TYPE_POINTER || y.kind == TypeKind::TYPE_REFERENCE || y.kind == TypeKind::TYPE_SLICE || y.kind == TypeKind::TYPE_ARRAY {
            return self.tc_ty_names_param(y.as_data.elem, m, gid, depth + 1);
        }
        if y.rec() != NO_REC {
            let it = *unsafe (*self.cur_ast()).instance(y.rec());
            for i in 0..it.n {
                if self.tc_ty_names_param(unsafe it.args[i as usize], m, gid, depth + 1) {
                    return true;
                }
            }
        }
        return false;
    }

    // Report the open parameter of bound argument `w` (the first of `gens` it names that `bound`
    // leaves open) that `self_ty`'s several conformances to `iface` cannot decide, and bind it to the
    // error type so it is not reported again.
    fn tc_err_ambiguous_conf(
        self: &mut Self,
        fmod: ModuleId,
        gens: NodeList,
        bound: *mut TypeId,
        g: i32,
        w: TypeId,
        self_ty: TypeId,
        iface: DefId,
        sp: tok::Span,
    ) {
        let fa = self.mod_ast(fmod);
        for k in 0..g {
            let gid = unsafe (*fa).list(gens)[k as usize];
            if unsafe bound[k as usize] != TYPE_NONE || !self.tc_ty_names_param(w, fmod, gid, 0) {
                continue;
            }
            let nsp = unsafe (*fa).at_const(unsafe (*fa).at_const(gid).as_data.generic_param.name).as_data.name.text;
            let tb = self.type_buf(self_ty);
            let isp = unsafe (*self.mod_ast(iface.module)).at_const(
                unsafe (*self.mod_ast(iface.module)).at_const(iface.node).as_data.interface_def.name,
            ).as_data.name.text;
            self.errors.emit_span(
                sp,
                format(
                    "cannot infer '{}': '{}' conforms to '{}' with several arguments",
                    diag::span_str(self.mod_src(fmod), nsp.start, nsp.end),
                    str::from_cstr(&tb[0]),
                    diag::span_str(self.mod_src(iface.module), isp.start, isp.end),
                ),
            );
            self.note_conformances(self_ty, iface);
            self.errors.note(
                format("give '{}' an explicit argument", diag::span_str(self.mod_src(fmod), nsp.start, nsp.end)),
            );
            unsafe bound[k as usize] = TYPE_ERROR;
            return;
        }
    }

    // An unresolved generic argument after defaults is a call-site error, not a
    // downstream emission failure.
    @c.cold
    fn err_unresolved_generic(self: &mut Self, sp: tok::Span, gmod: ModuleId, gid: NodeId) {
        let ga2 = self.mod_ast(gmod);
        let nsp = unsafe (*ga2).at_const(unsafe (*ga2).at_const(gid).as_data.generic_param.name).as_data.name.text;
        self.errors.emit_span(
            sp,
            format(
                "cannot infer the generic argument '{}' for this call; add an explicit argument",
                diag::span_str(self.mod_src(gmod), nsp.start, nsp.end),
            ),
        );
    }

    fn fn_compatible_subst(
        self: &mut Self,
        exid: TypeId,
        acid: TypeId,
        gp: *const DefId,
        ga: *const TypeId,
        gn: i32,
        rp: *const DefId,
        ra: *const TypeId,
        rn: i32,
    ) bool {
        if exid != acid && self.fn_owns(acid) {
            let exy = *self.type_at(exid);
            if !exy.fn_sig() || (exy.qualifier & FN_MOVE) == 0 {
                return false;
            }
        }
        let es = self.fn_sig(exid);
        let as2 = self.fn_sig(acid);
        if es.np != as2.np {
            return false;
        }
        let er2 = self.subst_type(self.subst_type(es.ret, rp, ra, rn), gp, ga, gn);
        if !self.ret_eq(er2, as2.ret) {
            return false;
        }
        for i in 0..es.np {
            let ep2 = self.subst_type(self.subst_type(self.fn_param(&es, i), rp, ra, rn), gp, ga, gn);
            if ep2 != self.fn_param(&as2, i) {
                return false;
            }
        }
        return true;
    }

    fn check_field_visibility(self: &mut Self, m: ModuleId, field: NodeId, owner: NodeId, at: tok::Span) {
        let f = unsafe (*self.mod_ast(m)).at_const(field);
        let inside_owner = m == self.cur_module() && owner == self.current_self;
        if f.kind == NodeKind::NODE_FIELD && !f.as_data.field.is_public && !inside_owner {
            self.errors.emit_span(at, format("field '{}' is private", diag::span_str(self.source, at.start, at.end)));
        }
    }

    fn check_call(self: &mut Self, id: NodeId, want: TypeId) TypeId {
        let a = self.cur_ast();
        let callee_id = unsafe (*a).at_const(id).as_data.call.callee;
        let pck = unsafe (*a).at_const(callee_id).kind;
        // The method-name node, captured while the callee is definitely a member: a later stage may
        // rewrite the callee node in place (its `as_data` becomes another variant), after which
        // re-reading `.as_data.member.member` off it would misread the union and yield a stray id.
        let cmem = if pck == NodeKind::NODE_MEMBER {
            unsafe (*a).at_const(callee_id).as_data.member.member;
        } else {
            NODE_NONE;
        };
        let mut callee = TYPE_NONE;
        // Binder metadata reads: `f.has_meta("k")` / `f.meta_bool` / `f.meta_int` / `f.meta_str`
        // on a fields/variants/payloads binder: per-copy CONSTANTS the emitter (and the binder-const
        // `if` elision) computes from the declaration's `@reflect` entries. The key must be a string
        // LITERAL; a missing key reads false / 0 / "".
        // Neither intrinsic below takes a turbofish: one written goes to the ordinary member call.
        let intr_ok = pck == NodeKind::NODE_MEMBER && unsafe (*a).at_const(callee_id).as_data.member.targs.len == 0;
        if intr_ok && !unsafe (*a).at_const(callee_id).as_data.member.path {
            let mobj = unsafe (*a).at_const(callee_id).as_data.member.object;
            if unsafe (*a).at_const(mobj).kind == NodeKind::NODE_IDENTIFIER {
                let blid = unsafe (*a).resolution(mobj);
                if blid != NODE_NONE && unsafe (*a).at_const(blid).kind == NodeKind::NODE_INLINE_FOR && unsafe (*a).type_of(
                    blid,
                ) != TYPE_NONE && self.type_at(unsafe (*a).type_of(blid)).kind == TypeKind::TYPE_FIELD_PROJECTION {
                    let mnm = self.name_span(cmem);
                    let is_has = span_is(self.source, mnm, "has_meta");
                    let is_b = span_is(self.source, mnm, "meta_bool");
                    let is_i = span_is(self.source, mnm, "meta_int");
                    let is_s = span_is(self.source, mnm, "meta_str");
                    if is_has || is_b || is_i || is_s {
                        switch self.proj_cbase.get(&blid) {
                            Some(cb) => {
                                if self.icx.closure_depth > *cb {
                                    let csp3 = unsafe (*a).at_const(id).span;
                                    self.errors.emit_span(
                                        csp3,
                                        format("a closure cannot capture the field binder (its type differs per field)"),
                                    );
                                    return TYPE_NONE;
                                }
                            },
                            None => {},
                        };
                        let margs = unsafe (*a).at_const(id).as_data.call.args;
                        let mut lit_ok = margs.len == 1;
                        if lit_ok {
                            let a0 = unsafe (*a).at_const(unsafe (*a).list(margs)[0]);
                            lit_ok = a0.kind == NodeKind::NODE_LITERAL && a0.as_data.literal.token_type == TokenType::StringLiteral;
                        }
                        if !lit_ok {
                            let sp4 = unsafe (*a).at_const(id).span;
                            self.errors.emit_span(
                                sp4,
                                format("a binder metadata read takes exactly one string literal key"),
                            );
                            return TYPE_NONE;
                        }
                        let kt = self.prelude_str_type();
                        unsafe (*self.cur_ast()).set_type(unsafe (*a).list(margs)[0], kt);
                        if is_i {
                            let rt4 = Ast::builtin(BuiltinType::BT_I64);
                            unsafe (*self.cur_ast()).set_type(id, rt4);
                            return rt4;
                        }
                        if is_s {
                            let rt5 = self.prelude_str_type();
                            unsafe (*self.cur_ast()).set_type(id, rt5);
                            return rt5;
                        }
                        let rt6 = Ast::builtin(BuiltinType::BT_BOOL);
                        unsafe (*self.cur_ast()).set_type(id, rt6);
                        return rt6;
                    }
                }
            }
        }
        // `x.free()` intrinsic no-op check.
        if intr_ok && !unsafe (*a).at_const(callee_id).as_data.member.path && unsafe (*a).at_const(id).as_data.call.args.len == 0 {
            let mem = cmem;
            if span_is(self.mod_src(self.cur_module()), unsafe (*a).at_const(mem).as_data.name.text, "free") {
                let obj = unsafe (*a).at_const(callee_id).as_data.member.object;
                let rt = self.check_expr(obj);
                let fname = self.name_span(mem);
                let mut resolvable = false;
                if rt != TYPE_NONE {
                    let rty = *self.type_at(self.strip(rt));
                    if rty.kind == TypeKind::TYPE_STRUCT || rty.kind == TypeKind::TYPE_INSTANCE {
                        let mut om: ModuleId = 0;
                        let mut od = NODE_NONE;
                        if self.aggregate_decl(self.strip(rt), &mut om, &mut od) {
                            // A `free` whose extend does not cover this instance is not its
                            // destructor: the intrinsic runs the derived one.
                            let fmd = self.find_method_cstr(om, od, "free");
                            resolvable = fmd.node != NODE_NONE && self.tc_free_covers(self.strip(rt), fmd);
                        }
                    } else if rty.kind == TypeKind::TYPE_GENERIC {
                        let mut iface = DefId { module: 0, node: NODE_NONE };
                        resolvable = self.find_bound_method(rty.module, rty.as_data.decl, fname, &mut iface).node != NODE_NONE;
                    } else if rty.kind == TypeKind::TYPE_DYN && rty.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 {
                        return Ast::builtin(BuiltinType::BT_VOID);
                    }
                }
                if !resolvable {
                    return Ast::builtin(BuiltinType::BT_VOID);
                }
            }
        }
        // The arguments overload selection already checked (`InferenceContext.args_pre`).
        let mut pre: u8 = 0;
        if pck == NodeKind::NODE_MEMBER && unsafe (*a).at_const(callee_id).as_data.member.path {
            self.icx.call_args = unsafe (*a).at_const(id).as_data.call.args;
            self.icx.call_targs = NodeList { start: 0, len: 0 };
            self.icx.args_pre = 0;
            self.icx.callee_node = callee_id;
            callee = self.check_expr_w(callee_id, want);
            self.icx.callee_node = NODE_NONE;
            pre = self.icx.args_pre;
            self.icx.args_pre = 0;
            self.icx.call_args = NodeList { start: 0, len: 0 };
            let vd = unsafe (*a).resolution_def(cmem);
            if vd.node != NODE_NONE && unsafe (*self.mod_ast(vd.module)).at_const(vd.node).kind == NodeKind::NODE_VARIANT {
                return self.check_variant_call(id, vd.module, vd.node, callee);
            }
        } else if pck == NodeKind::NODE_MEMBER {
            // A method's turbofish (`x.m::<T>(..)`) is typed before overload selection weighs it, as a
            // turbofished path's is.
            let mtargs = unsafe (*a).at_const(callee_id).as_data.member.targs;
            self.tc_check_targs(DefId { module: 0, node: NODE_NONE }, mtargs);
            self.icx.call_args = unsafe (*a).at_const(id).as_data.call.args;
            self.icx.call_targs = mtargs;
            self.icx.args_pre = 0;
            callee = self.check_member(callee_id, true, want);
            pre = self.icx.args_pre;
            self.icx.args_pre = 0;
            self.icx.call_args = NodeList { start: 0, len: 0 };
            self.icx.call_targs = NodeList { start: 0, len: 0 };
            let fd = unsafe (*a).resolution_def(cmem);
            if fd.node != NODE_NONE && (fd.module == self.cur_module() || fd.module as usize < self.pkg_count()) && unsafe (*self.mod_ast(
                fd.module,
            )).at_const(fd.node).kind == NodeKind::NODE_FIELD {
                unsafe (*self.cur_ast()).set_type(callee_id, callee);
                if mtargs.len != 0 && !untyped(callee) {
                    self.err_field_targs(cmem, mtargs);
                    return TYPE_ERROR;
                }
            }
        } else {
            // A turbofished path (`K::f::<T>(x)`) chooses among overloads by these arguments too.
            self.icx.call_args = unsafe (*a).at_const(id).as_data.call.args;
            self.icx.call_targs = if pck == NodeKind::NODE_GENERIC_SPECIALIZATION {
                unsafe (*a).at_const(callee_id).as_data.specialization.types;
            } else {
                NodeList { start: 0, len: 0 };
            };
            self.icx.args_pre = 0;
            self.icx.callee_node = callee_id;
            callee = self.check_expr(callee_id);
            self.icx.callee_node = NODE_NONE;
            pre = self.icx.args_pre;
            self.icx.args_pre = 0;
            self.icx.call_args = NodeList { start: 0, len: 0 };
            self.icx.call_targs = NodeList { start: 0, len: 0 };
        }
        if pck == NodeKind::NODE_MEMBER {
            let md = unsafe (*a).resolution_def(cmem);
            let addressable = md.module == self.cur_module() || md.module as usize < self.pkg_count();
            if md.node != NODE_NONE && addressable && unsafe (*self.mod_ast(md.module)).at_const(md.node).kind == NodeKind::NODE_FUNCTION {
                self.tc_check_test_ref(md, unsafe (*a).at_const(id).span);
            }
        }
        // fields(&v)/variants(&e) anywhere but as an `inline for` iterable (never reaches here).
        if pck == NodeKind::NODE_IDENTIFIER && unsafe (*a).resolution_def(callee_id).node == NODE_NONE && unsafe (*a).resolution(
            callee_id,
        ) == NODE_NONE && (span_is(self.source, unsafe (*a).at_const(callee_id).as_data.name.text, "fields") || span_is(
            self.source,
            unsafe (*a).at_const(callee_id).as_data.name.text,
            "variants",
        ) || span_is(self.source, unsafe (*a).at_const(callee_id).as_data.name.text, "payloads")) {
            let fsp2 = unsafe (*a).at_const(id).span;
            self.errors.emit_span(
                fsp2,
                format("fields(&v)/variants(&e) are only valid as the iterable of an 'inline for'"),
            );
            return TYPE_NONE;
        }
        // Assert builtins.
        if pck == NodeKind::NODE_IDENTIFIER {
            let ad = unsafe (*a).resolution_def(callee_id);
            if ad.node != NODE_NONE && ad.module as usize < self.pkg_count() && unsafe (*self.package).modules[ad.module as usize].prelude && unsafe (*self.mod_ast(
                ad.module,
            )).at_const(ad.node).kind == NodeKind::NODE_FUNCTION {
                let anm = unsafe (*self.mod_ast(ad.module)).at_const(
                    unsafe (*self.mod_ast(ad.module)).at_const(ad.node).as_data.function.name,
                ).as_data.name.text;
                let mut akind: i32 = 0;
                if span_is(self.mod_src(ad.module), anm, "assert") {
                    akind = 1;
                } else if span_is(self.mod_src(ad.module), anm, "assert_eq") {
                    akind = 2;
                } else if span_is(self.mod_src(ad.module), anm, "assert_ne") {
                    akind = 3;
                }
                if akind != 0 {
                    return self.tc_check_assert(id, akind);
                }
                if span_is(self.mod_src(ad.module), anm, "format") {
                    return self.tc_check_format_p(id, 0);
                }
                let mut pkind: u32 = 0;
                if span_is(self.mod_src(ad.module), anm, "print") {
                    pkind = 1;
                } else if span_is(self.mod_src(ad.module), anm, "println") {
                    pkind = 2;
                } else if span_is(self.mod_src(ad.module), anm, "eprint") {
                    pkind = 3;
                } else if span_is(self.mod_src(ad.module), anm, "eprintln") {
                    pkind = 4;
                }
                if pkind != 0 {
                    return self.tc_check_format_p(id, pkind);
                }
            }
        }
        // dyn_cast::<T>(d): compiler intrinsic; vtable type-id compare, Option<&T> result.
        if pck == NodeKind::NODE_GENERIC_SPECIALIZATION {
            let spx = unsafe (*a).at_const(callee_id).as_data.specialization;
            let tp_args = spx.types;
            let ex = unsafe (*a).at_const(spx.expression);
            let mut intr = "";
            if ex.kind == NodeKind::NODE_IDENTIFIER && unsafe (*a).resolution_def(spx.expression).node == NODE_NONE {
                intr = self.source.slice(ex.as_data.name.text.start as usize, ex.as_data.name.text.end as usize);
            }
            let sp2 = unsafe (*a).at_const(id).span;
            let args2 = unsafe (*a).at_const(id).as_data.call.args;
            // Every intrinsic below takes one type argument; dyn_cast also takes one value.
            let nvals: u32 = if intr == "dyn_cast" {
                1;
            } else {
                0;
            };
            if (intr == "dyn_cast" || intr == "zeroed" || intr == "type_info" || intr == "dangling") && (tp_args.len != 1 || args2.len != nvals) {
                let what = if nvals == 1 {
                    "one value";
                } else {
                    "no values";
                };
                self.errors.emit_span(sp2, format("{} takes exactly one type argument and {}", intr, what));
                return TYPE_NONE;
            }
            if intr == "dyn_cast" {
                let tt = self.resolve_type(unsafe (*a).list(tp_args)[0]);
                let av = self.check_expr(unsafe (*a).list(args2)[0]);
                if av == TYPE_ERROR {
                    return TYPE_NONE;
                }
                let ay = *self.type_at(av);
                if ay.kind != TypeKind::TYPE_DYN || ay.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 || self.tc_dyn_fn_sig(
                    &ay,
                ) != TYPE_NONE {
                    self.errors.emit_span(sp2, format("dyn_cast expects a '&dyn I' or '&mut dyn I' value"));
                    return TYPE_NONE;
                }
                let mut rq = TypeQualifier::TYPE_QUAL_CONST as u8;
                if ay.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
                    rq = TypeQualifier::TYPE_QUAL_MUT as u8;
                }
                let rt2 = unsafe (*self.cur_ast()).intern_type(
                    Ty { kind: TypeKind::TYPE_REFERENCE, qualifier: rq, module: 0, as_data: TyAs { elem: tt } },
                );
                let oh = self.ph_option;
                let mut oa = Tys8 {};
                oa[0] = rt2;
                let ot = unsafe (*self.cur_ast()).intern_instance(oh.mid, oh.node, &oa[0], 1);
                unsafe (*self.cur_ast()).set_type(id, ot);
                return ot;
            }
            // zeroed::<T>(): compiler intrinsic; an all-zero-bytes T, the `unsafe` seed the
            // reflection constructors (reflect_default / reflect_clone) then fill field by field.
            if intr == "zeroed" {
                if self.tc_needs_unsafe() {
                    self.errors.emit_span(
                        sp2,
                        format(
                            "'zeroed' requires an unsafe context (all-zero bytes are not a valid value of every type)",
                        ),
                    );
                }
                let tt = self.resolve_type(unsafe (*a).list(tp_args)[0]);
                if untyped(tt) {
                    return TYPE_NONE;
                }
                unsafe (*self.cur_ast()).set_type_args(id, &tt, 1);
                unsafe (*self.cur_ast()).set_type(id, tt);
                return tt;
            }
            // type_info::<T>(): compiler intrinsic; a TypeInfo descriptor of T, folded at compile
            // time (const-eval builds the object graph; codegen emits static data at runtime uses).
            if intr == "type_info" {
                let tt = self.resolve_type(unsafe (*a).list(tp_args)[0]);
                if untyped(tt) {
                    return TYPE_NONE;
                }
                if self.type_at(tt).kind == TypeKind::TYPE_OPAQUE {
                    self.errors.emit_span(
                        sp2,
                        format("type_info cannot describe an opaque type (its layout is unknown)"),
                    );
                    return TYPE_NONE;
                }
                let th = unsafe (*self.package).prelude_lookup("TypeInfo", true);
                if th.node == NODE_NONE {
                    self.errors.emit_span(sp2, format("type_info requires the std prelude"));
                    return TYPE_NONE;
                }
                unsafe (*self.cur_ast()).set_type_args(id, &tt, 1);
                let rt3 = self.named_type_of(th.mid, th.node);
                unsafe (*self.cur_ast()).set_type(id, rt3);
                return rt3;
            }
            // dangling::<T>(): compiler intrinsic; a non-null, T-aligned `*mut T` backed by no
            // storage (the backend's per-alignment sentinel). The portable pointer for zero-sized
            // element buffers: never dereferenced, never freed.
            if intr == "dangling" {
                let tt = self.resolve_type(unsafe (*a).list(tp_args)[0]);
                if untyped(tt) {
                    return TYPE_NONE;
                }
                unsafe (*self.cur_ast()).set_type_args(id, &tt, 1);
                let rt3 = unsafe (*self.cur_ast()).intern_type(
                    Ty {
                        kind: TypeKind::TYPE_POINTER,
                        qualifier: TypeQualifier::TYPE_QUAL_MUT as u8,
                        as_data: TyAs { elem: tt },
                    },
                );
                unsafe (*self.cur_ast()).set_type(id, rt3);
                return rt3;
            }
        }
        let args = unsafe (*a).at_const(id).as_data.call.args;
        for i in 0..args.len {
            if i < 8 && (pre >> i as u8 & 1) != 0 {
                continue;
            }
            let aid = unsafe (*a).list(args)[i as usize];
            // `[]`, a generic fn named as a value, and a range literal all take their type from the
            // parameter (a range's bounds adopt the parameter's element type, like bare literals do).
            let mut awant = TYPE_NONE;
            if self.tc_is_iface_assoc_call(aid) || unsafe (*a).at_const(aid).kind == NodeKind::NODE_CLOSURE || unsafe (*a).at_const(
                aid,
            ).kind == NodeKind::NODE_RANGE || self.tc_wants_param_type(aid) {
                awant = self.tc_param_expected(callee, callee_id, i);
            }
            if awant == TYPE_NONE {
                awant = self.tc_tuple_ctor_elem(callee, i);
            }
            // Postponed closure: an unannotated closure whose parameter type
            // still mentions the callee's generics is checked once, after call inference has
            // resolved them, never per candidate.
            if unsafe (*a).at_const(aid).kind == NodeKind::NODE_CLOSURE && awant != TYPE_NONE && self.tc_infer_ty_open(
                awant,
            ) && self.tc_closure_unannotated(aid) {
                continue;
            }
            self.check_expr_w(aid, awant);
        }
        if untyped(callee) {
            return TYPE_NONE;
        }
        let mut ct = *self.type_at(callee);
        let sp = unsafe (*a).at_const(id).span;
        if ct.kind == TypeKind::TYPE_GENERIC {
            let fb = self.generic_fn_bound(ct.module, ct.as_data.decl);
            if fb != NODE_NONE {
                callee = self.lower_type_in(ct.module, fb);
                ct = *self.type_at(callee);
            }
        }
        if ct.kind == TypeKind::TYPE_DYN {
            let ds = self.tc_dyn_fn_sig(&ct);
            if ds != TYPE_NONE {
                callee = ds;
                ct = *self.type_at(callee);
            }
        }
        // Tuple-struct constructor `Wrap(a, b)` (and the generic `Pair::<A, B>(a, b)`): positional
        // aggregate construction, not a call. aggregate_of covers both the plain struct and its
        // instances, binding the element types under the instance's generic args.
        if ct.kind == TypeKind::TYPE_STRUCT || ct.kind == TypeKind::TYPE_INSTANCE {
            let mut tmod: ModuleId = 0;
            let mut tdecl = NODE_NONE;
            let mut tgp = Defs8 {};
            let mut tga = Tys8 {};
            let mut tgn: i32 = 0;
            if self.aggregate_of(callee, &mut tmod, &mut tdecl, &mut tgp, &mut tga, &mut tgn) {
                let sd = unsafe (*self.mod_ast(tmod)).at_const(tdecl);
                if sd.kind == NodeKind::NODE_STRUCT && sd.as_data.aggregate.is_tuple {
                    let members = sd.as_data.aggregate.members;
                    if args.len != members.len {
                        let s2 = plural(members.len);
                        self.errors.emit_span(
                            sp,
                            format("tuple struct takes {} element{}, got {}", members.len, str::from_cstr(s2), args.len),
                        );
                        return TYPE_NONE;
                    }
                    for k in 0..args.len {
                        let mt = self.node_type_in(tmod, unsafe (*self.mod_ast(tmod)).list(members)[k as usize]);
                        let et = self.subst_type(mt, &tgp[0], &tga[0], tgn);
                        let aid = unsafe (*a).list(args)[k as usize];
                        if !self.compatible(et, aid) {
                            self.err_mismatch(aid, et);
                        }
                    }
                    return callee;
                }
            }
        }
        if ct.kind != TypeKind::TYPE_FUNCTION {
            self.errors.emit_span(sp, format("called value is not a function"));
            return TYPE_NONE;
        }
        if ct.fn_sig() {
            let fts = self.tc_call_targs(callee_id);
            if fts.len != 0 {
                self.errors.emit_span(
                    unsafe (*a).at_const(unsafe (*a).list(fts)[0]).span,
                    format("a function pointer takes no generic arguments"),
                );
                return TYPE_ERROR;
            }
            return self.check_sig_call(id, callee, args);
        }
        let fmod = ct.module;
        let fdecl = ct.as_data.decl;
        let fa = self.mod_ast(fmod);
        let fk = unsafe (*fa).at_const(fdecl).kind;
        let named = fk == NodeKind::NODE_FUNCTION;
        if named && unsafe (*fa).at_const(fdecl).as_data.function.is_extern() && self.tc_needs_unsafe() {
            self.err_unsafe(sp, "calling an extern \"C\" function");
        } else if named && unsafe (*fa).at_const(fdecl).as_data.function.is_unsafe() && self.tc_needs_unsafe() {
            self.err_unsafe(sp, "calling an unsafe function");
        }
        let clos = fk == NodeKind::NODE_CLOSURE;
        let mut params = NodeList { start: 0, len: 0 };
        let mut returns = NodeList { start: 0, len: 0 };
        if named {
            params = unsafe (*fa).at_const(fdecl).as_data.function.params;
            returns = unsafe (*fa).at_const(fdecl).as_data.function.returns;
        } else if clos {
            params = unsafe (*fa).at_const(fdecl).as_data.closure.params;
            returns = unsafe (*fa).at_const(fdecl).as_data.closure.returns;
        }
        let mut fmt_builtin = false;
        if named && fmod as usize < self.pkg_count() && unsafe (*self.package).modules[fmod as usize].prelude {
            let fnm = unsafe (*fa).at_const(unsafe (*fa).at_const(fdecl).as_data.function.name).as_data.name.text;
            fmt_builtin = span_is(self.mod_src(fmod), fnm, "format_into") || span_is(self.mod_src(fmod), fnm, "print") || span_is(
                self.mod_src(fmod),
                fnm,
                "println",
            ) || span_is(self.mod_src(fmod), fnm, "eprint") || span_is(self.mod_src(fmod), fnm, "eprintln");
            if fmt_builtin {
                self.mark_format_helpers();
            }
            if fmt_builtin && span_is(self.mod_src(fmod), fnm, "format_into") && pck == NodeKind::NODE_MEMBER {
                return self.tc_check_format_p(id, 5);
            }
        }
        let mut skip: u32 = 0;
        let cn_path = pck == NodeKind::NODE_MEMBER && unsafe (*a).at_const(callee_id).as_data.member.path;
        if named && !cn_path && params.len > 0 {
            let md = unsafe (*a).resolution_def(cmem);
            if md.node != NODE_NONE && unsafe (*self.mod_ast(md.module)).at_const(md.node).kind == NodeKind::NODE_FUNCTION {
                skip = 1;
            }
        }
        // Generic-instance receiver substitution + generic call inference.
        let ret = self.check_call_finish(
            id,
            callee_id,
            fmod,
            fdecl,
            named,
            clos,
            params,
            returns,
            args,
            skip,
            want,
            fmt_builtin,
        );
        // A method whose RESULT carries a borrow (`Option<&V>`, a view, ...) borrows its receiver
        // as much as one returning a bare `&T`. check_call_receiver can only inspect the
        // DECLARED return node, which is not enough: the borrow may sit inside a generic argument
        // that exists only after substitution (`Map::get` is declared `Option<T>`, and is
        // `Option<&i64>` only here). Re-check with the resolved type and persist the receiver borrow
        // so the container cannot be mutated while the returned view is live.
        return ret;
    }

    // A call through a value of function-pointer type `callee`: arity, each argument against its
    // parameter, then the results (several go through the multi-result stash, as for a function).
    fn check_sig_call(self: &mut Self, id: NodeId, callee: TypeId, args: NodeList) TypeId {
        let a = self.cur_ast();
        let fy = *self.type_at(callee);
        let np = unsafe (*a).sig_len(&fy, false);
        if args.len != np {
            let sp = unsafe (*a).at_const(id).span;
            let s2 = plural(np);
            self.errors.emit_span(sp, format("expected {} argument{}, found {}", np, str::from_cstr(s2), args.len));
        } else {
            let none = Defs8 {};
            let nonet = Tys8 {};
            for i in 0..np {
                let pt = unsafe (*a).sig_at(&fy, false, i);
                let aid = unsafe (*a).list(args)[i as usize];
                if unsafe (*a).at_const(aid).kind == NodeKind::NODE_CLOSURE && unsafe (*a).type_of(aid) == TYPE_NONE {
                    let _ct = self.check_expr_w(aid, pt);
                }
                if self.type_at(pt).kind == TypeKind::TYPE_FUNCTION {
                    let at = unsafe (*a).type_of(aid);
                    if pt != at && at != TYPE_NONE && self.fn_is_capturing(at) {
                        let asp = unsafe (*a).at_const(aid).span;
                        self.errors.emit_span(
                            asp,
                            format("a capturing closure cannot be passed as a bare 'fn' pointer"),
                        );
                    } else if at == TYPE_NONE || self.type_at(at).kind != TypeKind::TYPE_FUNCTION || !self.fn_compatible_subst(
                        pt,
                        at,
                        &none[0],
                        &nonet[0],
                        0,
                        &none[0],
                        &nonet[0],
                        0,
                    ) && !self.tc_coerce_generic_fn(pt, aid) {
                        self.err_mismatch(aid, pt);
                    }
                } else if !self.compatible(pt, aid) {
                    self.err_mismatch(aid, pt);
                }
            }
        }
        let nr = unsafe (*a).sig_len(&fy, true);
        if nr == 1 {
            return unsafe (*a).sig_at(&fy, true, 0);
        }
        if nr == 0 {
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        self.icx.mret_n = pick(nr < 8, nr as u8, 8);
        self.icx.mret_total = nr;
        for i in 0..self.icx.mret_n {
            unsafe self.icx.mret_types[i as usize] = unsafe (*a).sig_at(&fy, true, i);
        }
        self.icx.mret_call = id;
        return TYPE_NONE;
    }

    // Postponed-closure completion: check each still-untyped closure argument
    // once its parameter shape is closed under the current substitution, seeding its unannotated
    // parameters first, and feed the checked type back as call evidence. `final9` forces the check
    // even with an open shape: the post-defaults last chance, whose failures are the user's
    // annotation-required diagnostics.
    fn tc_check_postponed(
        self: &mut Self,
        fmod: ModuleId,
        args: NodeList,
        params: NodeList,
        skip: u32,
        rsubp: *const DefId,
        rsuba: *const TypeId,
        nrsub: i32,
        gparams: *const DefId,
        bound: *const TypeId,
        g: i32,
        final9: bool,
    ) bool {
        let a = self.cur_ast();
        let fa = self.mod_ast(fmod);
        let mut checked = false;
        for i in 0..args.len {
            let aid9 = unsafe (*a).list(args)[i as usize];
            if unsafe (*a).at_const(aid9).kind != NodeKind::NODE_CLOSURE || unsafe (*a).type_of(aid9) != TYPE_NONE {
                continue;
            }
            let pid9 = unsafe (*fa).list(params)[(i + skip) as usize];
            let raw9 = self.decl_type_in(fmod, pid9);
            let mut open9 = false;
            // A decl-referenced fn type does not substitute as a whole: seed each unannotated
            // closure parameter with its substituted component instead.
            if self.type_at(raw9).kind == TypeKind::TYPE_FUNCTION {
                let clp9 = unsafe (*a).at_const(aid9).as_data.closure.params;
                let fs9 = self.fn_sig(raw9);
                let mut j: u32 = 0;
                while j < clp9.len && j < fs9.np {
                    let cpid = unsafe (*a).list(clp9)[j as usize];
                    if unsafe (*a).at_const(cpid).as_data.parameter.ty == NODE_NONE {
                        let st9 = self.subst_type(
                            self.subst_type(self.fn_param(&fs9, j), rsubp, rsuba, nrsub),
                            gparams,
                            bound,
                            g,
                        );
                        if st9 != TYPE_NONE && !self.tc_infer_ty_open(st9) {
                            unsafe (*self.cur_ast()).set_type(cpid, st9);
                        } else {
                            open9 = true;
                        }
                    }
                    j += 1;
                }
            }
            if open9 && !final9 {
                // Shape still open: the literal-default pass may close it.
                continue;
            }
            // The closure body may make generic calls of its own: they run in a nested session.
            let outer9 = self.icx.sv.session_open();
            let ct9 = self.check_expr_w(aid9, raw9);
            self.icx.sv.session_close(&outer9);
            self.tc_infer_ev(raw9, ct9, true);
            checked = true;
        }
        return checked;
    }

    fn check_call_finish(
        self: &mut Self,
        id: NodeId,
        callee_id: NodeId,
        fmod: ModuleId,
        fdecl: NodeId,
        named: bool,
        clos: bool,
        params: NodeList,
        returns: NodeList,
        args: NodeList,
        skip: u32,
        want: TypeId,
        fmt_builtin: bool,
    ) TypeId {
        let a = self.cur_ast();
        let fa = self.mod_ast(fmod);
        // Record what the flow pass replays for this call: the resolved function and receiver skip.
        if named && fdecl != NODE_NONE {
            unsafe (*self.cur_ast()).call_info.insert(id, fmod as u64 << 40 | fdecl as u64 << 8 | skip as u64);
        }
        let sp = unsafe (*a).at_const(id).span;
        let cn_kind = unsafe (*a).at_const(callee_id).kind;
        let cn_path = cn_kind == NodeKind::NODE_MEMBER && unsafe (*a).at_const(callee_id).as_data.member.path;
        let mut cdu: *const DerefUse = null;
        if cn_kind == NodeKind::NODE_MEMBER && !cn_path {
            cdu = unsafe (*a).deref_use_at(unsafe (*a).at_const(callee_id).as_data.member.member);
        }
        let mut rsubp = Defs8 {};
        let mut rsuba = Tys8 {};
        let mut nrsub: i32 = 0;
        let mut conv_target = TYPE_NONE;
        if cn_kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            // `W::<u8>::f::<i32>()`: the qualifying instance binds the extend's parameters, as it does
            // without the function's own arguments.
            let inner = unsafe (*a).at_const(callee_id).as_data.specialization.expression;
            let im = unsafe (*a).at_const(inner);
            if im.kind == NodeKind::NODE_MEMBER && im.as_data.member.path {
                let md = unsafe (*a).resolution_def(im.as_data.member.member);
                let mut rmod: ModuleId = 0;
                let mut rdecl = NODE_NONE;
                let mut gp = Defs8 {};
                let mut ga = Tys8 {};
                let mut sn: i32 = 0;
                if md.node != NODE_NONE && self.aggregate_of(
                    self.strip(unsafe (*a).type_of(im.as_data.member.object)),
                    &mut rmod,
                    &mut rdecl,
                    &mut gp,
                    &mut ga,
                    &mut sn,
                ) && sn > 0 {
                    let extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
                    if extnode != NODE_NONE {
                        self.frame_ext(md.module, extnode, &ga[0], sn, &mut rsubp[0], &mut rsuba[0], &mut nrsub);
                    }
                }
            }
        }
        if cn_kind == NodeKind::NODE_MEMBER {
            let md = unsafe (*a).resolution_def(unsafe (*a).at_const(callee_id).as_data.member.member);
            let mut recvbase = self.strip(unsafe (*a).type_of(unsafe (*a).at_const(callee_id).as_data.member.object));
            if cdu != null {
                recvbase = unsafe (*cdu).target;
            }
            // `x.into()` calls `Target::from(x)`, so the generics to bind are the TARGET's, taken from
            // the expected type: the object is the argument here, not the receiver. Without this a
            // generic target (`let v: Vector<i32> = [..].into()`) kept its parameters unbound.
            conv_target = self.tc_conversion_target(unsafe (*a).at_const(callee_id).as_data.member.member, md, want);
            if conv_target != TYPE_NONE {
                recvbase = conv_target;
            }
            let mut rmod: ModuleId = 0;
            let mut rdecl = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut sn: i32 = 0;
            let mdfn = md.node != NODE_NONE && unsafe (*self.mod_ast(md.module)).at_const(md.node).kind == NodeKind::NODE_FUNCTION;
            let agok = mdfn && self.aggregate_of(recvbase, &mut rmod, &mut rdecl, &mut gp, &mut ga, &mut sn);
            if agok && sn > 0 {
                let extnode = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
                if extnode != NODE_NONE {
                    self.frame_ext(md.module, extnode, &ga[0], sn, &mut rsubp[0], &mut rsuba[0], &mut nrsub);
                }
            }
            // Dyn receiver over an instantiated generic interface: interface generics -> dyn args.
            if nrsub == 0 {
                let rvy2 = *self.type_at(recvbase);
                if rvy2.kind == TypeKind::TYPE_DYN {
                    let dinst = *unsafe (*self.cur_ast()).instance(rvy2.as_data.inst);
                    if dinst.decl != NODE_NONE && unsafe (*self.mod_ast(dinst.module)).at_const(dinst.decl).kind == NodeKind::NODE_INTERFACE {
                        nrsub = self.tc_dyn_method_args(&rvy2, md, &mut rsubp[0], &mut rsuba[0], nrsub);
                    }
                }
            }
        }
        // A path callee with its own turbofish (`T::conv::<u8>`) is the path under the arguments.
        let mut pcal = callee_id;
        if cn_kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            let inner = unsafe (*a).at_const(callee_id).as_data.specialization.expression;
            if unsafe (*a).at_const(inner).kind == NodeKind::NODE_MEMBER && unsafe (*a).at_const(inner).as_data.member.path {
                pcal = inner;
            }
        }
        let p_path = cn_path || pcal != callee_id;
        // `T::default()` reaching an interface DEFAULT: the qualified type IS Self.
        if p_path && nrsub < 8 {
            let md = unsafe (*a).resolution_def(unsafe (*a).at_const(pcal).as_data.member.member);
            let mut tr = NODE_NONE;
            if md.node != NODE_NONE {
                tr = self.enclosing(md.module, md.node, NodeKind::NODE_INTERFACE);
            }
            if tr != NODE_NONE {
                let pobj = unsafe (*a).at_const(pcal).as_data.member.object;
                let mut target = self.strip(unsafe (*a).type_of(pobj));
                if target == TYPE_NONE {
                    // A bare `P::` base records no type; its resolution names the aggregate.
                    let ob = unsafe (*a).resolution_def(pobj);
                    if ob.node != NODE_NONE {
                        let obk = unsafe (*self.mod_ast(ob.module)).at_const(ob.node).kind;
                        if obk == NodeKind::NODE_STRUCT || obk == NodeKind::NODE_ENUM {
                            target = self.named_type_of(ob.module, ob.node);
                        }
                    }
                }
                let ty2 = *self.type_at(target);
                if ty2.kind == TypeKind::TYPE_STRUCT || ty2.kind == TypeKind::TYPE_ENUM || ty2.kind == TypeKind::TYPE_INSTANCE {
                    rsubp[nrsub as usize] = DefId { module: md.module, node: tr };
                    rsuba[nrsub as usize] = target;
                    nrsub = nrsub + 1;
                    nrsub = self.tc_dflt_subst(id, pcal, &mut rsubp, &mut rsuba, nrsub);
                }
            }
        }
        // Method through a generic bound: substitute interface Self.
        if cn_kind == NodeKind::NODE_MEMBER && !cn_path && nrsub < 8 {
            let md = unsafe (*a).resolution_def(unsafe (*a).at_const(callee_id).as_data.member.member);
            let mut tr = NODE_NONE;
            if md.node != NODE_NONE {
                tr = self.enclosing(md.module, md.node, NodeKind::NODE_INTERFACE);
            }
            if tr != NODE_NONE {
                let mut target = self.strip(unsafe (*a).type_of(unsafe (*a).at_const(callee_id).as_data.member.object));
                if cdu != null {
                    target = unsafe (*cdu).target;
                }
                rsubp[nrsub as usize] = DefId { module: md.module, node: tr };
                rsuba[nrsub as usize] = target;
                nrsub = nrsub + 1;
                let ro = *self.type_at(target);
                // An inherited default's conformance, or a bound chosen among several
                // (`tc_pick_bound_conf`), is recorded; else a generic receiver's one bound reaching it.
                let n0 = nrsub;
                nrsub = self.tc_dflt_subst(id, callee_id, &mut rsubp, &mut rsuba, nrsub);
                if nrsub == n0 && ro.kind == TypeKind::TYPE_GENERIC && nrsub < 8 {
                    let mut disp = TYPE_NONE;
                    nrsub = nrsub + self.bound_method_subst(
                        ro.module,
                        ro.as_data.decl,
                        md,
                        unsafe ((&mut rsubp[0]) as *mut DefId + nrsub as usize),
                        unsafe ((&mut rsuba[0]) as *mut TypeId + nrsub as usize),
                        8 - nrsub,
                        &mut disp,
                    );
                    if disp != TYPE_NONE {
                        unsafe (*self.cur_ast()).set_bound_call(id, disp);
                    }
                }
            }
        }
        // `T::assoc()` (a static interface method on a type param): substitute the interface's Self by the
        // param's type, so a `Self` return resolves to T inside the generic function.
        if p_path && nrsub < 8 {
            let md = unsafe (*a).resolution_def(unsafe (*a).at_const(pcal).as_data.member.member);
            let mut tr = NODE_NONE;
            if md.node != NODE_NONE {
                tr = self.enclosing(md.module, md.node, NodeKind::NODE_INTERFACE);
            }
            let ob = unsafe (*a).resolution_def(unsafe (*a).at_const(pcal).as_data.member.object);
            let mut ob_kind = NodeKind::NODE_NONE_KIND;
            if ob.node != NODE_NONE {
                ob_kind = unsafe (*self.mod_ast(ob.module)).at_const(ob.node).kind;
            }
            // An interface's `Self::f()` calls through the interface as `T::f()` does through a bound.
            let self_iface = ob_kind == NodeKind::NODE_INTERFACE && self.tc_self_path(pcal);
            if tr != NODE_NONE && ob.node != NODE_NONE && (ob_kind == NodeKind::NODE_GENERIC_PARAM || self_iface) {
                rsubp[nrsub as usize] = DefId { module: md.module, node: tr };
                rsuba[nrsub as usize] = self.named_type_of(ob.module, ob.node);
                nrsub = nrsub + 1;
                // A bound chosen among several (`tc_pick_bound_conf`) is recorded.
                let n0 = nrsub;
                nrsub = self.tc_dflt_subst(id, pcal, &mut rsubp, &mut rsuba, nrsub);
                if nrsub == n0 && nrsub < 8 {
                    let mut disp = TYPE_NONE;
                    nrsub = nrsub + self.bound_method_subst(
                        ob.module,
                        ob.node,
                        md,
                        unsafe ((&mut rsubp[0]) as *mut DefId + nrsub as usize),
                        unsafe ((&mut rsuba[0]) as *mut TypeId + nrsub as usize),
                        8 - nrsub,
                        &mut disp,
                    );
                    if disp != TYPE_NONE {
                        unsafe (*self.cur_ast()).set_bound_call(id, disp);
                    }
                }
            }
            // `Interface::assoc()` on a generic instance target (`let v: Vector<String> = Default::default();`):
            // the resolved method's signature uses the EXTEND's type params: bind them to the target's args.
            if ob.node != NODE_NONE && md.node != NODE_NONE && ob_kind == NodeKind::NODE_INTERFACE && !self_iface {
                let mut em: ModuleId = 0;
                let mut ed = NODE_NONE;
                let mut egp2 = Defs8 {};
                let mut ega2 = Tys8 {};
                let mut egn2: i32 = 0;
                let mut agg = false;
                if want != TYPE_NONE {
                    let sw = self.strip(want);
                    agg = self.aggregate_of(sw, &mut em, &mut ed, &mut egp2, &mut ega2, &mut egn2);
                }
                if agg && egn2 > 0 {
                    let ext = self.enclosing(md.module, md.node, NodeKind::NODE_EXTEND);
                    if ext != NODE_NONE {
                        self.frame_ext(md.module, ext, &ega2[0], egn2, &mut rsubp[0], &mut rsuba[0], &mut nrsub);
                    }
                }
            }
        }
        // Method-extend bounds check.
        if cn_kind == NodeKind::NODE_MEMBER || pcal != callee_id {
            let md = unsafe (*a).resolution_def(unsafe (*a).at_const(pcal).as_data.member.member);
            if md.node != NODE_NONE && unsafe (*self.mod_ast(md.module)).at_const(md.node).kind == NodeKind::NODE_FUNCTION {
                let mut mt = TYPE_NONE;
                if !p_path {
                    if cdu != null {
                        mt = unsafe (*cdu).target;
                    } else {
                        mt = self.strip(unsafe (*a).type_of(unsafe (*a).at_const(pcal).as_data.member.object));
                    }
                } else {
                    let ob = unsafe (*a).resolution_def(unsafe (*a).at_const(pcal).as_data.member.object);
                    if ob.node != NODE_NONE && unsafe (*self.mod_ast(ob.module)).at_const(ob.node).kind == NodeKind::NODE_INTERFACE && want != TYPE_NONE {
                        mt = self.strip(want);
                    } else {
                        mt = self.strip(unsafe (*a).type_of(unsafe (*a).at_const(pcal).as_data.member.object));
                    }
                }
                if mt != TYPE_NONE && !self.method_extend_bounds_hold(mt, md) {
                    self.err_method_extend_bounds(sp, mt, md);
                    return TYPE_NONE;
                }
            }
        }
        // The turbofish of a path or a method call: its type-level arguments bind the leading
        // parameters, in order, and may not outnumber them.
        let tas = self.tc_call_targs(callee_id);
        if tas.len != 0 && !named {
            self.errors.emit_span(
                unsafe (*a).at_const(unsafe (*a).list(tas)[0]).span,
                format("a closure takes no generic arguments"),
            );
            return TYPE_ERROR;
        }
        if tas.len != 0 && !self.tc_targ_arity_ok(DefId { module: fmod, node: fdecl }, tas) {
            return TYPE_ERROR;
        }
        // Generic function call inference.
        let mut gparams = Defs8 {};
        let mut gargs = Tys8 {};
        let mut gn: i32 = 0;
        if named && unsafe (*fa).at_const(fdecl).as_data.function.generics.len != 0 {
            let gens = unsafe (*fa).at_const(fdecl).as_data.function.generics;
            let mut g = gens.len as i32;
            if g > 8 {
                g = 8;
            }
            for ii in 0..g {
                gparams[ii as usize] = DefId { module: fmod, node: unsafe (*fa).list(gens)[ii as usize] };
                gargs[ii as usize] = TYPE_NONE;
            }
            // Session-driven inference: every use of a repeated
            // parameter feeds one solver variable, top-level argument positions record directional
            // bounds joined under the safe-conversion oracle, and const evidence conflicts are
            // detected instead of silently keeping the first binding.
            self.icx.sv.session_begin();
            for ii in 0..g {
                let gid9 = unsafe (*fa).list(gens)[ii as usize];
                let _ = self.icx.sv.map_param(
                    DefId { module: fmod, node: gid9 },
                    unsafe (*fa).at_const(gid9).as_data.generic_param.is_const,
                );
            }
            let mut bound = Tys8 {};
            let mut nexplicit: i32 = 0;
            let mut i: u32 = 0;
            while i < tas.len && nexplicit < g {
                let tid = unsafe (*a).list(tas)[i as usize];
                i = i + 1;
                if unsafe (*a).at_const(tid).kind == NodeKind::NODE_LIFETIME {
                    continue;
                }
                let at = self.tc_slot_const(nexplicit as u32, unsafe (*a).type_of(tid));
                bound[nexplicit as usize] = pick(at == TYPE_NONE, TYPE_ERROR, at);
                if at != TYPE_NONE {
                    self.icx.sv.s_explicit(nexplicit as u32, at);
                }
                nexplicit = nexplicit + 1;
            }
            if nexplicit < g && args.len == params.len - skip {
                for i in 0..args.len {
                    let pid = unsafe (*fa).list(params)[(i + skip) as usize];
                    let arg9 = unsafe (*a).list(args)[i as usize];
                    let aty = unsafe (*a).type_of(arg9);
                    let mut rd: u32 = 0;
                    if self.tc_peek_lit_class(arg9) == 0 && self.tc_ref_lit(arg9, &mut rd) == NODE_NONE {
                        self.tc_infer_ev(self.decl_type_in(fmod, pid), aty, true);
                    }
                }
                let mut processed: u32 = 0; // bit k = slot k's obligations ran
                let mut ambig: u32 = 0; // bit k = slot k's bounds fit several conformances
                self.tc_infer_worklist(fmod, fdecl, gens, &mut bound[0], g, &mut processed, &mut ambig);
                // Use the expected result to resolve parameters before applying defaults.
                if want != TYPE_NONE && returns.len == 1 {
                    let mut unresolved = false;
                    for k in 0..g {
                        if bound[k as usize] == TYPE_NONE {
                            unresolved = true;
                        }
                    }
                    if unresolved {
                        let r0 = unsafe (*fa).list(returns)[0];
                        let rty = self.subst_type(self.node_type_in(fmod, r0), &rsubp[0], &rsuba[0], nrsub);
                        self.tc_infer_ev(rty, self.strip(want), true);
                        self.tc_infer_worklist(fmod, fdecl, gens, &mut bound[0], g, &mut processed, &mut ambig);
                    }
                }
                // A postponed closure whose parameter shape is known now is checked once with
                // the substituted parameter type, and its checked type feeds back as evidence for
                // parameters that depend on the closure's result. A closure whose shape is still
                // open waits for the literal-default pass below (final = false); after defaults it
                // is checked unconditionally: if the shape is still open then, the body errors
                // and the unresolved-generic report tell the user an annotation is required.
                let mut clos_checked = self.tc_check_postponed(
                    fmod,
                    args,
                    params,
                    skip,
                    &rsubp[0],
                    &rsuba[0],
                    nrsub,
                    &gparams[0],
                    &bound[0],
                    g,
                    false,
                );
                if clos_checked {
                    self.tc_infer_worklist(fmod, fdecl, gens, &mut bound[0], g, &mut processed, &mut ambig);
                }
                let mut used_literal_default = false;
                for i in 0..args.len {
                    let pid9 = unsafe (*fa).list(params)[(i + skip) as usize];
                    if self.tc_lit_default(unsafe (*a).list(args)[i as usize], self.decl_type_in(fmod, pid9), &bound[0]) {
                        used_literal_default = true;
                    }
                }
                if used_literal_default {
                    self.tc_infer_worklist(fmod, fdecl, gens, &mut bound[0], g, &mut processed, &mut ambig);
                }
                clos_checked = self.tc_check_postponed(
                    fmod,
                    args,
                    params,
                    skip,
                    &rsubp[0],
                    &rsuba[0],
                    nrsub,
                    &gparams[0],
                    &bound[0],
                    g,
                    true,
                );
                if clos_checked {
                    self.tc_infer_worklist(fmod, fdecl, gens, &mut bound[0], g, &mut processed, &mut ambig);
                }
                self.tc_report_const_conflicts(sp);
                self.tc_report_type_conflicts(sp);
                if ambig != 0 {
                    self.tc_report_ambiguous(fmod, fdecl, gens, &mut bound[0], g, ambig, sp);
                }
                for k in 0..g {
                    if bound[k as usize] == TYPE_NONE {
                        self.err_unresolved_generic(sp, fmod, unsafe (*fa).list(gens)[k as usize]);
                    }
                }
                nexplicit = g;
            }
            for i in 0..nexplicit {
                gargs[i as usize] = bound[i as usize];
            }
            gn = nexplicit;
            // A closure written inside a generic body is monomorphized with that body, so its C form
            // differs per instantiation. Binding it to ANOTHER function's type parameter would make
            // that function's instance depend on which instantiation produced the closure, which the
            // closure's type does not record, so both would collapse onto one wrong symbol.
            if self.tc_fn_is_generic(self.cur_module(), self.icx.current_fn) {
                let mut bad = false;
                for i in 0..gn {
                    if self.tc_is_local_closure(gargs[i as usize]) {
                        bad = true;
                    }
                }
                if bad {
                    self.errors.emit_span(
                        sp,
                        format(
                            "a closure declared inside a generic function cannot be passed to another generic function; call it directly, or take the callback as a plain 'fn' pointer type",
                        ),
                    );
                }
            }
            if gn == g {
                unsafe (*self.cur_ast()).set_type_args(id, &gargs[0], gn as u8);
                // Enforce bounds (best-effort; diagnostics).
                self.check_generic_bounds(
                    id,
                    fmod,
                    fdecl,
                    gens,
                    &gparams[0],
                    &gargs[0],
                    gn,
                    &rsubp[0],
                    &rsuba[0],
                    nrsub,
                );
            }
        }
        // Owner (extend) generics for a static/associated call: a constructor like `Box::new(w)` calls
        // `new`, which has NO generics of its own: `T`/`A` belong to `extend<T, A> Box<T, A>`. The
        // function-generic pass above therefore binds nothing, and no receiver instance supplies the
        // owner args (nrsub == 0). Infer them from the arguments the way function-own generics are, then
        // fill any that remain with the extend's declared defaults (e.g. `A = Global`). Result and
        // parameter types below are substituted through rsubp/rsuba, so `T` resolves to the argument's
        // concrete type and `Box<T>` coerces to `Box<dyn I>` at the use site: no turbofish needed.
        if nrsub == 0 && named && fdecl != NODE_NONE && args.len == params.len - skip {
            let extnode = self.enclosing(fmod, fdecl, NodeKind::NODE_EXTEND);
            if extnode != NODE_NONE {
                let ig = unsafe (*fa).at_const(extnode).as_data.extend_def.generics;
                let mut og = ig.len as i32;
                if og > 8 {
                    og = 8;
                }
                if og > 0 {
                    // The owner type's own generic list (`struct Box<T, A = Global>`) supplies the
                    // DEFAULTS, which the extend's re-declared `<T, A: Allocator + Default>` does not.
                    let target = unsafe (*fa).at_const(extnode).as_data.extend_def.target_type;
                    let sdef = self.tc_peel_target(unsafe (*fa).resolution_def(target));
                    let mut sgens = NodeList { start: 0, len: 0 };
                    if sdef.node != NODE_NONE {
                        let sdn = unsafe (*self.mod_ast(sdef.module)).at_const(sdef.node);
                        if sdn.kind == NodeKind::NODE_STRUCT || sdn.kind == NodeKind::NODE_ENUM {
                            sgens = sdn.as_data.aggregate.generics;
                        }
                    }
                    let mut oparams = Defs8 {};
                    let mut obound = Tys8 {};
                    self.icx.sv.session_begin();
                    for k in 0..og {
                        let ogid = unsafe (*fa).list(ig)[k as usize];
                        oparams[k as usize] = DefId { module: fmod, node: ogid };
                        obound[k as usize] = TYPE_NONE;
                        let _ = self.icx.sv.map_param(
                            DefId { module: fmod, node: ogid },
                            unsafe (*fa).at_const(ogid).as_data.generic_param.is_const,
                        );
                    }
                    for i in 0..args.len {
                        let pid = unsafe (*fa).list(params)[(i + skip) as usize];
                        let arg9 = unsafe (*a).list(args)[i as usize];
                        self.tc_infer_ev(self.decl_type_in(fmod, pid), unsafe (*a).type_of(arg9), true);
                    }
                    for k in 0..og {
                        obound[k as usize] = self.icx.sv.s_resolve(k as u32, it_conv_join);
                    }
                    // Use the expected result to resolve owner parameters before applying defaults.
                    if want != TYPE_NONE && returns.len == 1 {
                        let mut ounresolved = false;
                        for k in 0..og {
                            if obound[k as usize] == TYPE_NONE {
                                ounresolved = true;
                            }
                        }
                        if ounresolved {
                            let r0 = unsafe (*fa).list(returns)[0];
                            self.tc_infer_ev(self.node_type_in(fmod, r0), self.strip(want), true);
                            for k in 0..og {
                                if obound[k as usize] == TYPE_NONE {
                                    obound[k as usize] = self.icx.sv.s_resolve(k as u32, it_conv_join);
                                }
                            }
                        }
                    }
                    self.tc_report_const_conflicts(sp);
                    self.tc_report_type_conflicts(sp);
                    let mut ia = Tys8 {};
                    let mut ic: u8 = 0;
                    for k in 0..og {
                        let mut b = obound[k as usize];
                        if b == TYPE_NONE && k as u32 < sgens.len {
                            let dft = unsafe (*self.mod_ast(sdef.module)).at_const(
                                unsafe (*self.mod_ast(sdef.module)).list(sgens)[k as usize],
                            ).as_data.generic_param.default_type;
                            if dft != NODE_NONE {
                                b = self.lower_type_in(sdef.module, dft);
                            }
                        }
                        if b != TYPE_NONE && nrsub < 8 {
                            rsubp[nrsub as usize] = oparams[k as usize];
                            rsuba[nrsub as usize] = b;
                            nrsub = nrsub + 1;
                            ia[ic as usize] = b;
                            ic = ic + 1;
                        } else if b == TYPE_NONE {
                            self.err_unresolved_generic(sp, fmod, unsafe (*fa).list(ig)[k as usize]);
                        }
                    }
                    // Make the inferred owner instance visible to codegen and monomorphization: give the
                    // callee's type object the concrete instance type (`Box<W2, Global>`), exactly as an
                    // explicit `Box::<W2>` turbofish would, so the static method is mangled and emitted.
                    if ic > 0 && cn_kind == NodeKind::NODE_MEMBER && cn_path && sdef.node != NODE_NONE {
                        let inst = unsafe (*self.cur_ast()).intern_instance(sdef.module, sdef.node, &ia[0], ic);
                        unsafe (*self.cur_ast()).set_type(unsafe (*a).at_const(callee_id).as_data.member.object, inst);
                    }
                }
            }
        }
        // `x.into()` hands the OBJECT to `from`'s parameter; it is never in `args`, so its conversions
        // (an array reaching a slice parameter, most of all) have to be checked here, or the value goes
        // to codegen unconverted.
        if conv_target != TYPE_NONE && skip == 1 && params.len == 1 {
            let pid0 = unsafe (*fa).list(params)[0];
            let raw0 = self.node_type_in(fmod, pid0);
            // Receiver frame FIRST: an inferred method binding may mention the very parameters the
            // receiver frame rebinds ({1*BITS} under BITS := {2*BITS}); the old order substituted twice.
            let pt0 = self.subst_type(self.subst_type(raw0, &rsubp[0], &rsuba[0], nrsub), &gparams[0], &gargs[0], gn);
            let obj0 = unsafe (*a).at_const(callee_id).as_data.member.object;
            if pt0 != TYPE_NONE && !self.compatible(pt0, obj0) {
                self.err_mismatch(obj0, pt0);
            }
        }
        // Arity + arg compatibility.
        let variadic = named && unsafe (*fa).at_const(fdecl).as_data.function.is_variadic();
        let expected = params.len - skip;
        let bad = if variadic {
            args.len < expected;
        } else {
            args.len != expected;
        };
        if bad {
            let s2 = plural(expected);
            if variadic {
                self.errors.emit_span(
                    sp,
                    format("expected at least {} argument{}, found {}", expected, str::from_cstr(s2), args.len),
                );
            } else {
                self.errors.emit_span(
                    sp,
                    format("expected {} argument{}, found {}", expected, str::from_cstr(s2), args.len),
                );
            }
        } else {
            for i in 0..expected {
                let pid = unsafe (*fa).list(params)[(i + skip) as usize];
                let raw = self.node_type_in(fmod, pid);
                let pt = self.subst_type(self.subst_type(raw, &rsubp[0], &rsuba[0], nrsub), &gparams[0], &gargs[0], gn);
                let aid = unsafe (*a).list(args)[i as usize];
                // A closure postponed on a path that skipped call inference is checked here, once,
                // with the fully substituted parameter type.
                if unsafe (*a).at_const(aid).kind == NodeKind::NODE_CLOSURE && unsafe (*a).type_of(aid) == TYPE_NONE {
                    let _ct = self.check_expr_w(aid, pt);
                }
                if self.type_at(pt).kind == TypeKind::TYPE_FUNCTION {
                    let at = unsafe (*a).type_of(aid);
                    if pt != at && at != TYPE_NONE && self.fn_is_capturing(at) {
                        let asp = unsafe (*a).at_const(aid).span;
                        self.errors.emit_span(
                            asp,
                            format("a capturing closure cannot be passed as a bare 'fn' pointer"),
                        );
                    } else if at == TYPE_NONE || self.type_at(at).kind != TypeKind::TYPE_FUNCTION || !self.fn_compatible_subst(
                        pt,
                        at,
                        &gparams[0],
                        &gargs[0],
                        gn,
                        &rsubp[0],
                        &rsuba[0],
                        nrsub,
                    ) && !self.tc_coerce_generic_fn(pt, aid) {
                        self.err_mismatch(aid, pt);
                    }
                } else if !self.compatible(pt, aid) {
                    self.err_mismatch(aid, pt);
                }
            }
        }
        // C-vararg string-literal default to *const char.
        if variadic && !fmt_builtin && args.len >= expected {
            let cstr = unsafe (*self.cur_ast()).intern_type(
                Ty {
                    kind: TypeKind::TYPE_POINTER,
                    qualifier: TypeQualifier::TYPE_QUAL_CONST as u8,
                    as_data: TyAs { elem: Ast::builtin(BuiltinType::BT_CHAR) },
                },
            );
            let mut i = expected;
            while i < args.len {
                let aid = unsafe (*a).list(args)[i as usize];
                let an = unsafe (*a).at_const(aid);
                if an.kind == NodeKind::NODE_LITERAL && (an.as_data.literal.token_type == TokenType::StringLiteral || an.as_data.literal.token_type == TokenType::MatchertextLiteral) {
                    unsafe (*self.cur_ast()).set_type(aid, cstr);
                }
                i = i + 1;
            }
        }
        // &mut self receiver mutability.
        if skip == 1 && cn_kind == NodeKind::NODE_MEMBER && params.len > 0 {
            let selfp = *self.type_at(self.decl_type_in(fmod, unsafe (*fa).list(params)[0]));
            if (selfp.kind == TypeKind::TYPE_REFERENCE || selfp.kind == TypeKind::TYPE_POINTER) && selfp.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
                let recv = unsafe (*a).at_const(callee_id).as_data.member.object;
                let rvt = *self.type_at(unsafe (*a).type_of(recv));
                let rsp = unsafe (*a).at_const(recv).span;
                let is_dyn = rvt.kind == TypeKind::TYPE_DYN;
                if rvt.kind != TypeKind::TYPE_REFERENCE && rvt.kind != TypeKind::TYPE_POINTER {
                    self.tc_note_capture_mut(recv); // the call borrows the receiver `&mut`
                }
                // A by-value receiver's `free` consumes it: no `mut` binding needed.
                let consuming_free = !is_dyn && rvt.kind != TypeKind::TYPE_REFERENCE && rvt.kind != TypeKind::TYPE_POINTER && span_is(
                    self.mod_src(self.cur_module()),
                    unsafe (*a).at_const(unsafe (*a).at_const(callee_id).as_data.member.member).as_data.name.text,
                    "free",
                );
                if is_dyn && rvt.qualifier == TypeQualifier::TYPE_QUAL_CONST as u8 {
                    self.errors.emit_span(
                        rsp,
                        format("cannot call a '&mut self' method through '&dyn' (use '&mut dyn')"),
                    );
                } else if (is_dyn && rvt.qualifier == TypeQualifier::TYPE_QUAL_NONE as u8 || !is_dyn && !consuming_free) && !self.receiver_mutable(
                    recv,
                ) {
                    self.errors.emit_span(
                        rsp,
                        format("cannot call a '&mut self' method on an immutable binding (bind it with 'mut')"),
                    );
                }
            }
        }
        if clos && unsafe (*fa).at_const(fdecl).as_data.closure.expr_body {
            return unsafe (*fa).type_of(unsafe (*fa).at_const(fdecl).as_data.closure.body);
        }
        if named && self.tc_attr(fmod, fdecl, AttrKind::ATTR_NORETURN) != null {
            return unsafe (*self.cur_ast()).intern_type(Ty { kind: TypeKind::TYPE_NEVER });
        }
        if returns.len != 1 {
            if returns.len > 1 {
                self.icx.mret_n = pick(returns.len < 8, returns.len as u8, 8);
                self.icx.mret_total = returns.len;
                for i in 0..self.icx.mret_n {
                    let mrid = unsafe (*fa).list(returns)[i as usize];
                    let mrt = self.node_type_in(fmod, mrid);
                    unsafe self.icx.mret_types[i as usize] = self.subst_type(
                        self.subst_type(mrt, &gparams[0], &gargs[0], gn),
                        &rsubp[0],
                        &rsuba[0],
                        nrsub,
                    );
                }
                self.icx.mret_call = id;
                return TYPE_NONE;
            }
            // An omitted return type IS void: the call must not type-check leniently.
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        let r0 = unsafe (*fa).list(returns)[0];
        let ret = self.node_type_in(fmod, r0);
        return self.subst_type(self.subst_type(ret, &rsubp[0], &rsuba[0], nrsub), &gparams[0], &gargs[0], gn);
    }

    // Whether `ty` satisfies bound node `bid` of module `fmod`: a function-type bound is a signature match
    // under the call's substitutions, an interface bound a conformance. An absent or generic type passes a
    // function-type bound; an unresolved interface bound passes.
    fn bound_holds(
        self: &mut Self,
        fmod: ModuleId,
        bid: NodeId,
        ty: TypeId,
        gparams: *const DefId,
        gargs: *const TypeId,
        gn: i32,
        rsubp: *const DefId,
        rsuba: *const TypeId,
        nrsub: i32,
    ) bool {
        let fa = self.mod_ast(fmod);
        if unsafe (*fa).at_const(bid).kind == NodeKind::NODE_FUNCTION_TYPE {
            let bt = self.lower_type_in(fmod, bid);
            if ty == TYPE_NONE || ty == TYPE_ERROR {
                return true;
            }
            let y = *self.type_at(ty);
            return y.kind == TypeKind::TYPE_GENERIC || y.kind == TypeKind::TYPE_FUNCTION && self.fn_compatible_subst(
                bt,
                ty,
                gparams,
                gargs,
                gn,
                rsubp,
                rsuba,
                nrsub,
            );
        }
        let bi = unsafe (*fa).resolution_def(bid);
        if bi.node == NODE_NONE {
            return true;
        }
        self.bind_miss.clear();
        let mut wa = Tys8 {};
        let wn = self.tc_bound_want(fmod, bid, bi, ty, gparams, gargs, gn, rsubp, rsuba, nrsub, &mut wa);
        if !self.type_satisfies_in(ty, bi, &wa[0], wn, 0) {
            return false;
        }
        // Each associated type binding (`Output = T`) must be the type's own, under the call's
        // substitutions.
        let bn = *unsafe (*fa).at_const(bid);
        if bn.kind != NodeKind::NODE_TYPE_PATH || ty == TYPE_NONE || ty == TYPE_ERROR {
            return true;
        }
        let bs = bn.as_data.type_path.bindings;
        for j in 0..bs.len {
            let al = unsafe (*fa).at_const(unsafe (*fa).list(bs)[j as usize]).as_data.type_alias;
            let nt = unsafe (*fa).at_const(al.name).as_data.name.text;
            let ad = self.tc_find_assoc_decl(bi, self.mod_src(fmod).slice(nt.start as usize, nt.end as usize), 0);
            if ad.node == NODE_NONE {
                continue; // reported at the bound (`tc_check_bindings`)
            }
            let di = DefId { module: ad.module, node: self.enclosing(ad.module, ad.node, NodeKind::NODE_INTERFACE) };
            let mut ga = Tys8 {};
            let gnum = self.tc_super_args(bi, &wa[0], wn, ty, di, &mut ga[0], 0);
            if gnum < 0 || gnum > 7 {
                continue;
            }
            let mut args = Tys8 {};
            args[0] = ty;
            for k in 0..gnum {
                args[(k + 1) as usize] = ga[k as usize];
            }
            let have = self.tc_assoc_make(ad.module, ad.node, &args[0], (gnum + 1) as u8);
            let want = self.subst_type(
                self.subst_type(self.lower_type_in(fmod, al.ty), gparams, gargs, gn),
                rsubp,
                rsuba,
                nrsub,
            );
            if have != want && have != TYPE_ERROR && want != TYPE_ERROR {
                let hb = self.type_buf(have);
                self.bind_miss = format(
                    "its '{}' is '{}'",
                    self.mod_src(fmod).slice(nt.start as usize, nt.end as usize),
                    str::from_cstr(&hb[0]),
                );
                return false;
            }
        }
        return true;
    }

    // The interface arguments bound `bid` (module `fmod`) requires of `ty`: written or defaulted,
    // `Self` read as `ty`, under the call's substitutions. Zero for an interface without parameters.
    fn tc_bound_want(
        self: &mut Self,
        fmod: ModuleId,
        bid: NodeId,
        bi: DefId,
        ty: TypeId,
        gparams: *const DefId,
        gargs: *const TypeId,
        gn: i32,
        rsubp: *const DefId,
        rsuba: *const TypeId,
        nrsub: i32,
        wa: &mut Tys8,
    ) i32 {
        let wn = self.tc_bound_args(fmod, bid, bi, ty, &mut wa[0]);
        for k in 0..wn {
            wa[k as usize] = self.subst_type(self.subst_type(wa[k as usize], gparams, gargs, gn), rsubp, rsuba, nrsub);
        }
        return wn;
    }

    fn check_generic_bounds(
        self: &mut Self,
        id: NodeId,
        fmod: ModuleId,
        fdecl: NodeId,
        gens: NodeList,
        gparams: *const DefId,
        gargs: *const TypeId,
        gn: i32,
        rsubp: *const DefId,
        rsuba: *const TypeId,
        nrsub: i32,
    ) {
        let a = self.cur_ast();
        let fa = self.mod_ast(fmod);
        let sp = unsafe (*a).at_const(id).span;
        for i in 0..gn {
            let gid = unsafe (*fa).list(gens)[i as usize];
            let pb = unsafe (*fa).at_const(gid).as_data.generic_param.bounds;
            // Before any bound reads the closure's captures (Send, Sync, the fn bound itself).
            self.tc_plain_fn_borrows(fa, pb, unsafe gargs[i as usize]);
            for b in 0..pb.len {
                let bid = unsafe (*fa).list(pb)[b as usize];
                let garg = unsafe gargs[i as usize];
                if !self.bound_holds(fmod, bid, garg, gparams, gargs, gn, rsubp, rsuba, nrsub) {
                    let tn = self.type_buf(garg);
                    let bsp = unsafe (*fa).at_const(bid).span;
                    if self.bind_miss.len() != 0 {
                        self.err_bind_miss(
                            sp,
                            garg,
                            format("bound '{}'", diag::span_str(self.mod_src(fmod), bsp.start, bsp.end)),
                        );
                        continue;
                    }
                    let mut om: ModuleId = 0;
                    let mut osp = tok::Span::empty();
                    if self.tc_other_args_at(garg, unsafe (*fa).resolution_def(bid), &mut om, &mut osp) {
                        self.err_bound_other_args(
                            sp,
                            garg,
                            format("bound '{}'", diag::span_str(self.mod_src(fmod), bsp.start, bsp.end)),
                            om,
                            osp,
                        );
                        continue;
                    }
                    self.errors.emit_span(
                        sp,
                        format(
                            "type '{}' does not satisfy bound '{}'",
                            str::from_cstr(&tn[0]),
                            diag::span_str(self.mod_src(fmod), bsp.start, bsp.end),
                        ),
                    );
                    // Notes attach to the error emitted last: name the failing field(s).
                    let bi = unsafe (*fa).resolution_def(bid);
                    let gy2 = *self.type_at(garg);
                    if bi.node != NODE_NONE && gy2.kind == TypeKind::TYPE_FIELD_PROJECTION && unsafe (*self.cur_ast()).type_concrete(
                        gy2.as_data.proj.owner,
                    ) {
                        let _ = self.proj_fields_satisfy(gy2.as_data.proj.owner, bi, 0, true);
                    }
                }
            }
        }
        // The callee's deferred field-projection obligations (same module: obligations live with
        // the checker that created them): with the owner now bound, prove every field; or, still
        // symbolic, hand the obligation up to the current fn's own call sites.
        if fmod == self.cur_module() {
            let nobs = (unsafe (*self.cur_ast()).proj_obs).len();
            let mut oi: usize = 0;
            while oi < nobs {
                let ob = *(unsafe (*self.cur_ast()).proj_obs).at(oi);
                oi = oi + 1;
                if ob.fnd != fdecl {
                    continue;
                }
                let owner2 = self.subst_type(ob.owner, gparams, gargs, gn);
                if !unsafe (*self.cur_ast()).type_concrete(owner2) {
                    self.tc_add_proj_ob(ProjOb { fnd: self.icx.current_fn, owner: owner2, iface: ob.iface });
                    continue;
                }
                if !self.proj_fields_satisfy(owner2, ob.iface, 0, false) {
                    let on2 = self.type_buf(owner2);
                    self.errors.emit_span(
                        sp,
                        format(
                            "a field of '{}' does not satisfy a bound the callee's reflection loop requires",
                            str::from_cstr(&on2[0]),
                        ),
                    );
                    let _ = self.proj_fields_satisfy(owner2, ob.iface, 0, true);
                }
            }
        }
        // Where clause.
        let wc = unsafe (*fa).at_const(fdecl).as_data.function.where_clause;
        for w in 0..wc.len {
            let wp = unsafe (*fa).at_const(unsafe (*fa).list(wc)[w as usize]).as_data.where_predicate;
            let wt = self.subst_type(self.lower_type_in(fmod, wp.ty), gparams, gargs, gn);
            self.tc_plain_fn_borrows(fa, wp.bounds, wt);
            for b in 0..wp.bounds.len {
                let wbid = unsafe (*fa).list(wp.bounds)[b as usize];
                if !self.bound_holds(fmod, wbid, wt, gparams, gargs, gn, rsubp, rsuba, nrsub) {
                    if self.bind_miss.len() != 0 {
                        let wsp = unsafe (*fa).at_const(wbid).span;
                        self.err_bind_miss(
                            sp,
                            wt,
                            format("where-clause bound '{}'", diag::span_str(self.mod_src(fmod), wsp.start, wsp.end)),
                        );
                        continue;
                    }
                    let mut om: ModuleId = 0;
                    let mut osp = tok::Span::empty();
                    if self.tc_other_args_at(wt, unsafe (*fa).resolution_def(wbid), &mut om, &mut osp) {
                        let wsp = unsafe (*fa).at_const(wbid).span;
                        self.err_bound_other_args(
                            sp,
                            wt,
                            format("where-clause bound '{}'", diag::span_str(self.mod_src(fmod), wsp.start, wsp.end)),
                            om,
                            osp,
                        );
                        continue;
                    }
                    let tn = self.type_buf(wt);
                    self.errors.emit_span(
                        sp,
                        format("type '{}' does not satisfy a where-clause bound", str::from_cstr(&tn[0])),
                    );
                }
            }
        }
    }
}

extend TypeChecker {
    // Whether every argument of instance `ty` of a generic struct or enum satisfies the bounds its
    // parameter declares (with their interface arguments, under the instance's other arguments);
    // each failure is reported at `node`.
    fn tc_inst_bounds(self: &mut Self, node: NodeId, ty: TypeId) {
        let y = *self.type_at(ty);
        if y.kind != TypeKind::TYPE_INSTANCE {
            return;
        }
        let it = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
        let da = self.mod_ast(it.module);
        let dn = unsafe (*da).at_const(it.decl);
        if dn.kind != NodeKind::NODE_STRUCT && dn.kind != NodeKind::NODE_ENUM {
            return;
        }
        let gens = dn.as_data.aggregate.generics;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        for i in 0..gens.len {
            if gn >= 8 || gn >= it.n as i32 {
                break;
            }
            gp[gn as usize] = DefId { module: it.module, node: unsafe (*da).list(gens)[i as usize] };
            ga[gn as usize] = unsafe it.args[gn as usize];
            gn += 1;
        }
        let sp = unsafe (*self.cur_ast()).at_const(node).span;
        for g in 0..gn {
            let pb = unsafe (*da).at_const(gp[g as usize].node).as_data.generic_param.bounds;
            for b in 0..pb.len {
                let bid = unsafe (*da).list(pb)[b as usize];
                let bi = unsafe (*da).resolution_def(bid);
                let arg = ga[g as usize];
                if bi.node == NODE_NONE || unsafe (*da).at_const(bid).kind == NodeKind::NODE_FUNCTION_TYPE || self.bound_holds(
                    it.module,
                    bid,
                    arg,
                    &gp[0],
                    &ga[0],
                    gn,
                    null,
                    null,
                    0,
                ) {
                    continue;
                }
                let bsp = unsafe (*da).at_const(bid).span;
                let bs = diag::span_str(self.mod_src(it.module), bsp.start, bsp.end);
                if self.bind_miss.len() != 0 {
                    self.err_bind_miss(sp, arg, format("bound '{}'", bs));
                    continue;
                }
                let mut om: ModuleId = 0;
                let mut osp = tok::Span::empty();
                if self.tc_other_args_at(arg, bi, &mut om, &mut osp) {
                    self.err_bound_other_args(sp, arg, format("bound '{}'", bs), om, osp);
                    continue;
                }
                let tn = self.type_buf(arg);
                self.errors.emit_span(sp, format("type '{}' does not satisfy bound '{}'", str::from_cstr(&tn[0]), bs));
            }
        }
    }

    // After a bound on interface `iface` failed for `ty`: whether `ty` conforms to `iface` with other
    // arguments, with the site that says so (a conformance, or a type parameter's bound) in `m`/`sp`.
    fn tc_other_args_at(self: &mut Self, ty: TypeId, iface: DefId, m: &mut ModuleId, sp: &mut tok::Span) bool {
        if iface.node == NODE_NONE || ty == TYPE_NONE || !self.type_satisfies(ty, iface, 0) {
            return false;
        }
        let y = *self.type_at(ty);
        if y.kind == TypeKind::TYPE_GENERIC {
            let pa = self.mod_ast(y.module);
            if unsafe (*pa).at_const(y.as_data.decl).kind != NodeKind::NODE_GENERIC_PARAM {
                return false;
            }
            let at = if y.module == self.cur_module() {
                self.icx.current_fn;
            } else {
                NODE_NONE;
            };
            let mut lists = Vector::<NodeList>::new();
            lists.push(unsafe (*pa).at_const(y.as_data.decl).as_data.generic_param.bounds);
            for w in 0..unsafe (*pa).where_bounds.len() {
                let sc = unsafe (*pa).where_scope(w, y.as_data.decl, at);
                if sc == WHERE_OWN || sc == WHERE_IN {
                    lists.push(
                        unsafe (*pa).at_const(unsafe (*pa).where_bounds.at(w).pred).as_data.where_predicate.bounds,
                    );
                }
            }
            for l in 0..lists.len() {
                for i in 0..lists[l].len {
                    let bid = unsafe (*pa).list(lists[l])[i as usize];
                    let bd = unsafe (*pa).resolution_def(bid);
                    let none = Tys8 {};
                    let mut ga = Tys8 {};
                    if bd.node != NODE_NONE && self.tc_super_args(bd, &none[0], 0, ty, iface, &mut ga[0], 0) >= 0 {
                        *m = y.module;
                        *sp = unsafe (*pa).at_const(bid).span;
                        return true;
                    }
                }
            }
            return false;
        }
        let mut tmod: ModuleId = 0;
        let mut tdecl = NODE_NONE;
        if !self.aggregate_decl(ty, &mut tmod, &mut tdecl) {
            if y.kind != TypeKind::TYPE_BUILTIN || unsafe (*self.package).builtin_decl(y.as_data.builtin) == NODE_NONE {
                return false;
            }
            tmod = unsafe (*self.package).core_module;
            tdecl = unsafe (*self.package).builtin_decl(y.as_data.builtin);
        }
        let mut em: ModuleId = 0;
        let ext = self.find_extend_as(tmod, tdecl, iface, &mut em);
        if ext == NODE_NONE {
            return false;
        }
        let ea = self.mod_ast(em);
        *m = em;
        *sp = unsafe (*ea).at_const(unsafe (*ea).at_const(ext).as_data.extend_def.interface_type).span;
        return true;
    }

    // "type 'T' does not satisfy <what>: 'T' conforms to this interface only with other arguments", with
    // a note at the conformance or bound (`tc_other_args_at`) at `sp` of module `m`.
    @c.cold
    // A bound `what` that failed on an associated type binding (`bind_miss`), reported at `at`.
    fn err_bind_miss(self: &mut Self, at: tok::Span, ty: TypeId, what: String) {
        let tn = self.type_buf(ty);
        self.errors.emit_span(
            at,
            format("type '{}' does not satisfy {}: {}", str::from_cstr(&tn[0]), what.as_str(), self.bind_miss.as_str()),
        );
        self.bind_miss.clear();
    }

    fn err_bound_other_args(self: &mut Self, at: tok::Span, ty: TypeId, what: String, m: ModuleId, sp: tok::Span) {
        let tn = self.type_buf(ty);
        self.errors.emit_span(
            at,
            format(
                "type '{}' does not satisfy {}: '{}' conforms to this interface only with other arguments",
                str::from_cstr(&tn[0]),
                what.as_str(),
                str::from_cstr(&tn[0]),
            ),
        );
        let site = diag::render_site(
            self.mod_src(m),
            unsafe (*self.package).modules[m as usize].file.as_str(),
            sp.start,
            sp.end - sp.start,
        );
        let kind = if self.type_at(ty).kind == TypeKind::TYPE_GENERIC {
            "a bound";
        } else {
            "a conformance";
        };
        self.errors.note(format("{} with other arguments is declared here\n{}", kind, site.as_str()));
    }

    // Is `ty` a closure's own type (not a fn pointer, not a named function)?
    const fn tc_is_local_closure(self: &Self, ty: TypeId) bool {
        if ty == TYPE_NONE {
            return false;
        }
        let y = *self.type_at(ty);
        return y.kind == TypeKind::TYPE_FUNCTION && unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl).kind == NodeKind::NODE_CLOSURE;
    }

    // Does `decl` carry type parameters of its own, or inherit an extend's?
    fn tc_fn_is_generic(self: &mut Self, m: ModuleId, decl: NodeId) bool {
        if decl == NODE_NONE || unsafe (*self.mod_ast(m)).at_const(decl).kind != NodeKind::NODE_FUNCTION {
            return false;
        }
        if unsafe (*self.mod_ast(m)).at_const(decl).as_data.function.generics.len != 0 {
            return true;
        }
        let ext = self.enclosing(m, decl, NodeKind::NODE_EXTEND);
        return ext != NODE_NONE && unsafe (*self.mod_ast(m)).at_const(ext).as_data.extend_def.generics.len != 0;
    }

    // One `Deref` step: the type behind `ty`, with the `deref` (or `deref_mut` for a mutable use)
    // that produces it written to `out`. TYPE_NONE when `ty` has no such method, or the method
    // does not return a reference (a raw pointer is never dereferenced implicitly).
    fn tc_deref_step(self: &mut Self, ty: TypeId, out: &mut DefId, want_mut: bool) TypeId {
        *out = DefId { module: 0, node: NODE_NONE };
        let mut cm: ModuleId = 0;
        let mut cd = NODE_NONE;
        if !self.aggregate_decl(ty, &mut cm, &mut cd) {
            return TYPE_NONE;
        }
        let mut mn = "deref";
        if want_mut {
            mn = "deref_mut";
        }
        let dm = self.find_method_cstr(cm, cd, mn);
        if dm.node == NODE_NONE {
            return TYPE_NONE;
        }
        let dret = self.tc_method_ret(ty, dm);
        if dret == TYPE_NONE {
            return TYPE_NONE;
        }
        let dry = *self.type_at(dret);
        if dry.kind != TypeKind::TYPE_REFERENCE {
            return TYPE_NONE;
        }
        *out = dm;
        return dry.as_data.elem;
    }

    // Patch every method hop of the auto-deref chain recorded at `node` to `deref_mut`, so a
    // mutable place use (assignment, `&mut`, `&mut self` receiver) never mutates through the
    // shared `deref`. Returns TYPE_NONE on success (or when no chain is recorded), else the first
    // hop type that has `deref` but no `deref_mut`: that place stays read-only.
    fn tc_deref_hops_mut(self: &mut Self, node: NodeId) TypeId {
        let du = unsafe (*self.cur_ast()).deref_use_mut(node);
        if du == null {
            return TYPE_NONE;
        }
        for hi in 0..unsafe (*du).n {
            if unsafe (*du).method[hi as usize].node == NODE_NONE {
                // A raw pointer/reference hop has no method to swap.
                continue;
            }
            let recv = unsafe (*du).recv[hi as usize];
            let mut hm: ModuleId = 0;
            let mut hd = NODE_NONE;
            if !self.aggregate_decl(recv, &mut hm, &mut hd) {
                return recv;
            }
            let dmm = self.find_method_cstr(hm, hd, "deref_mut");
            if dmm.node == NODE_NONE {
                return recv;
            }
            unsafe (*du).method[hi as usize] = dmm;
        }
        return TYPE_NONE;
    }

    // Record the single deref hop `node` needs, so codegen emits `T__deref(&x)` around it.
    fn tc_record_deref(self: &mut Self, node: NodeId, recv: TypeId, dm: DefId, target: TypeId) {
        let mut du = DerefUse { node: node, target: target, n: 1 };
        du.recv[0] = recv;
        du.method[0] = dm;
        unsafe (*self.cur_ast()).add_deref_use(&du);
    }

    fn check_member(self: &mut Self, id: NodeId, prefer_method: bool, want: TypeId) TypeId {
        let obj_node = unsafe (*self.cur_ast()).at_const(id).as_data.member.object;
        // A call in the receiver (`a.b().c(x)`) ends by clearing the call window: restore this call's.
        let ca = self.icx.call_args;
        let cta = self.icx.call_targs;
        self.icx.proj_obj_ok = true;
        let obj = self.check_expr(obj_node);
        self.icx.proj_obj_ok = false;
        self.icx.call_args = ca;
        self.icx.call_targs = cta;
        if obj == TYPE_NONE || obj == TYPE_ERROR {
            return obj;
        }
        if self.lint {
            self.tc_lint_unnecessary_deref(obj_node);
        }
        let t = self.check_member_of(id, obj_node, obj, prefer_method, want);
        if t != TYPE_NONE && self.through_raw_pointer(obj) {
            self.tc_raw_member(id, obj_node, obj);
        }
        return t;
    }

    // A member reached through a raw pointer: no auto-dereference, so a field or a method whose
    // `self` is not the raw pointer type itself is an error naming the explicit `(*p).m` form.
    @c.cold
    fn tc_raw_member(self: &mut Self, id: NodeId, obj_node: NodeId, obj: TypeId) {
        let a = self.cur_ast();
        let mn = unsafe (*a).at_const(id).as_data.member.member;
        let hit = unsafe (*a).resolution_def(mn);
        let mut is_fn = false;
        if hit.node != NODE_NONE {
            let ha = self.mod_ast(hit.module);
            let hn = unsafe (*ha).at_const(hit.node);
            is_fn = hn.kind == NodeKind::NODE_FUNCTION;
            if is_fn && hn.as_data.function.params.len != 0 {
                let p0 = unsafe (*ha).list(hn.as_data.function.params)[0];
                let oy = *self.type_at(obj);
                if self.type_at(self.decl_type_in(hit.module, p0)).kind == TypeKind::TYPE_POINTER && oy.kind == TypeKind::TYPE_POINTER && !self.through_raw_pointer(
                    oy.as_data.elem,
                ) {
                    return;
                }
            }
        }
        let sp = unsafe (*a).at_const(obj_node).span;
        let name = self.name_span(mn);
        let form = if is_fn {
            "(..)";
        } else {
            "";
        };
        self.errors.emit_span(
            sp,
            format(
                "no auto-dereference through a raw pointer: write '(*{}).{}{}' inside 'unsafe'",
                diag::span_str(self.source, sp.start, sp.end),
                diag::span_str(self.source, name.start, name.end),
                form,
            ),
        );
    }

    fn check_member_of(self: &mut Self, id: NodeId, obj_node: NodeId, obj: TypeId, prefer_method: bool, want: TypeId) TypeId {
        let a = self.cur_ast();
        let mname = unsafe (*a).at_const(id).as_data.member.member;
        let name = self.name_span(mname);
        let base = self.strip(obj);
        // The reflection binder: `f.name`/`f.index` are ordinary data, `f.value` is the projected
        // field place (the projection type itself, one concrete type per emitted copy).
        if self.type_at(base).kind == TypeKind::TYPE_FIELD_PROJECTION {
            // A closure has ONE lifted C form; a binder use inside it would need one per copy.
            let blid = unsafe (*a).resolution(obj_node);
            if blid != NODE_NONE {
                switch self.proj_cbase.get(&blid) {
                    Some(cb) => {
                        if self.icx.closure_depth > *cb {
                            let csp2 = unsafe (*a).at_const(id).span;
                            self.errors.emit_span(
                                csp2,
                                format("a closure cannot capture the field binder (its type differs per field)"),
                            );
                            return TYPE_NONE;
                        }
                    },
                    None => {},
                };
            }
            if span_is(self.source, name, "value") {
                return base;
            }
            if span_is(self.source, name, "name") {
                return self.prelude_str_type();
            }
            if span_is(self.source, name, "index") {
                return Ast::builtin(BuiltinType::BT_USIZE);
            }
            // The variants binder adds the enum-only members.
            let mut vmode = false;
            if blid != NODE_NONE && unsafe (*a).at_const(blid).kind == NodeKind::NODE_INLINE_FOR {
                let vit = unsafe (*a).at_const(blid).as_data.for_stmt.iterable;
                if unsafe (*a).at_const(vit).kind == NodeKind::NODE_CALL {
                    let vcl = unsafe (*a).at_const(vit).as_data.call.callee;
                    vmode = unsafe (*a).at_const(vcl).kind == NodeKind::NODE_IDENTIFIER && span_is(
                        self.source,
                        unsafe (*a).at_const(vcl).as_data.name.text,
                        "variants",
                    );
                }
            }
            // Two-subject loops add `.other` (fields/payloads: the second subject's same field, a
            // read-only place) and `.other_active` (variants: the second subject's tag test).
            if !vmode && span_is(self.source, name, "other") {
                if self.tc_binder_nsubj(blid) != 2 {
                    let osp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(osp, format("'.other' requires a two-subject loop: write fields(&a, &b)"));
                    return TYPE_NONE;
                }
                // Value's own type: one projection per binder, so generic callees unify.
                return base;
            }
            if vmode && span_is(self.source, name, "other_active") {
                if self.tc_binder_nsubj(blid) != 2 {
                    let osp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(
                        osp,
                        format("'.other_active' requires a two-subject loop: write variants(&a, &b)"),
                    );
                    return TYPE_NONE;
                }
                return Ast::builtin(BuiltinType::BT_BOOL);
            }
            if !vmode && (span_is(self.source, name, "offset") || span_is(self.source, name, "size")) {
                return Ast::builtin(BuiltinType::BT_USIZE);
            }
            if !vmode && span_is(self.source, name, "kind") {
                let th2 = unsafe (*self.package).prelude_lookup("TypeTag", true);
                if th2.node != NODE_NONE {
                    return self.named_type_of(th2.mid, th2.node);
                }
                return TYPE_NONE;
            }
            if vmode && span_is(self.source, name, "tag") {
                return Ast::builtin(BuiltinType::BT_I32);
            }
            if vmode && span_is(self.source, name, "payload") {
                return Ast::builtin(BuiltinType::BT_USIZE);
            }
            if vmode && span_is(self.source, name, "is_active") {
                return Ast::builtin(BuiltinType::BT_BOOL);
            }
            let sp0 = unsafe (*a).at_const(id).span;
            if vmode {
                self.errors.emit_span(
                    sp0,
                    format(
                        "a variant binder has '.name', '.index', '.tag', '.payload', '.is_active', '.value', and '.other_active' (two subjects) -- nothing else",
                    ),
                );
            } else {
                self.errors.emit_span(
                    sp0,
                    format(
                        "a field binder has '.name', '.index', '.value', '.offset', '.size', '.kind', and '.other' (two subjects) -- nothing else",
                    ),
                );
            }
            return TYPE_NONE;
        }
        let mut bmod: ModuleId = 0;
        let mut bdecl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if self.aggregate_of(base, &mut bmod, &mut bdecl, &mut gp, &mut ga, &mut gn) {
            let mut mhit = DefId { module: 0, node: NODE_NONE };
            let mut fhit = NODE_NONE;
            let mut digits = name.end > name.start && name.end - name.start <= 2;
            let mut di = name.start;
            while di < name.end && digits {
                if self.source[di as usize] < b'0' || self.source[di as usize] > b'9' {
                    digits = false;
                }
                di = di + 1;
            }
            if digits {
                let bd0 = unsafe (*self.mod_ast(bmod)).at_const(bdecl);
                if bd0.kind == NodeKind::NODE_STRUCT && bd0.as_data.aggregate.is_tuple {
                    let mut idx: u32 = 0;
                    let mut k = name.start;
                    while k < name.end {
                        idx = idx * 10 + (self.source[k as usize] - b'0') as u32;
                        k = k + 1;
                    }
                    if idx >= bd0.as_data.aggregate.members.len {
                        self.errors.emit_span(name, format("tuple struct has no element {}", idx));
                        return TYPE_NONE;
                    }
                    let tnode = unsafe (*self.mod_ast(bmod)).list(bd0.as_data.aggregate.members)[idx as usize];
                    unsafe (*self.cur_ast()).set_resolution_def(mname, DefId { module: bmod, node: tnode });
                    return self.subst_type(self.node_type_in(bmod, tnode), &gp[0], &ga[0], gn);
                }
                let mut fld = Buf96 {};
                unsafe stdio::snprintf(
                    &mut fld[0],
                    8,
                    "_%.*s".ptr() as *const char,
                    (name.end - name.start) as i32,
                    src_at(self.source, name.start),
                );
                fhit = self.find_member_cstr(bmod, bdecl, str::from_cstr(&fld[0]));
            }
            let mut dconf = TYPE_NONE;
            if fhit == NODE_NONE && prefer_method {
                mhit = self.tc_call_method(base, bmod, bdecl, name, want, &mut dconf);
                if mhit.node == NODE_NONE {
                    fhit = self.find_member(bmod, bdecl, name);
                }
            } else if fhit == NODE_NONE {
                fhit = self.find_member(bmod, bdecl, name);
                if fhit == NODE_NONE {
                    mhit = self.tc_applicable_method(bmod, bdecl, name, base);
                }
            }
            if mhit.node != NODE_NONE {
                unsafe (*self.cur_ast()).set_resolution_def(mname, mhit);
                if dconf == TYPE_ERROR {
                    return TYPE_ERROR;
                }
                if dconf != TYPE_NONE {
                    self.dflt_conf.insert(mname, dconf);
                }
                return self.subst_type(self.decl_type_in(mhit.module, mhit.node), &gp[0], &ga[0], gn);
            }
            if fhit != NODE_NONE {
                unsafe (*self.cur_ast()).set_resolution_def(mname, DefId { module: bmod, node: fhit });
                let fty = self.subst_type(self.decl_type_in(bmod, fhit), &gp[0], &ga[0], gn);
                if unsafe (*self.mod_ast(bmod)).at_const(fhit).kind == NodeKind::NODE_FIELD {
                    self.check_field_visibility(bmod, fhit, bdecl, name);
                    // A field through a raw pointer is rejected by `tc_raw_member` (no auto-dereference);
                    // the explicit `(*p).f` form is gated by the dereference itself.
                    // A reference-typed field of an untagged UNION overlaps every other field, so
                    // accessing it materializes a `&T` from arbitrary bytes: an int->reference
                    // transmute. Gate it behind `unsafe` (a raw *pointer* field stays free: its
                    // deref is already gated). is_union is on the aggregate decl.
                    let fty_is_ref = fty != TYPE_NONE && self.type_at(fty).kind == TypeKind::TYPE_REFERENCE;
                    let owner_is_union = unsafe (*self.mod_ast(bmod)).at_const(bdecl).as_data.aggregate.is_union;
                    if fty_is_ref && owner_is_union && self.tc_needs_unsafe() {
                        self.err_unsafe(unsafe (*a).at_const(id).span, "accessing a reference-typed field of a union");
                    }
                }
                return fty;
            }
        }
        // Builtin method.
        let bty = *self.type_at(base);
        if bty.kind == TypeKind::TYPE_BUILTIN {
            let bd = unsafe (*self.package).builtin_decl(bty.as_data.builtin);
            if bd != NODE_NONE {
                let cm = unsafe (*self.package).core_module;
                let mut bconf = TYPE_NONE;
                let mut mhit = if prefer_method {
                    self.tc_call_method(base, cm, bd, name, want, &mut bconf);
                } else {
                    self.find_method(cm, bd, name);
                };
                if mhit.node == NODE_NONE && !prefer_method {
                    mhit = self.find_default_method(cm, bd, name);
                }
                if mhit.node != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(mname, mhit);
                    if bconf == TYPE_ERROR {
                        return TYPE_ERROR;
                    }
                    if bconf != TYPE_NONE {
                        self.dflt_conf.insert(mname, bconf);
                    }
                    return self.decl_type_in(mhit.module, mhit.node);
                }
            }
        }
        // Generic/dyn receiver bound method.
        let bt2 = *self.type_at(base);
        if bt2.kind == TypeKind::TYPE_GENERIC || bt2.kind == TypeKind::TYPE_DYN {
            let bdecl = if bt2.kind == TypeKind::TYPE_DYN {
                unsafe (*self.cur_ast()).dyn_decl_of(&bt2);
            } else {
                bt2.as_data.decl;
            };
            let gd = unsafe (*self.mod_ast(bt2.module)).at_const(bdecl);
            if gd.kind == NodeKind::NODE_INTERFACE {
                let m = self.find_interface_method(
                    bt2.module,
                    bdecl,
                    self.source.slice(name.start as usize, name.end as usize),
                    0,
                );
                if m.node != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(mname, m);
                    return self.decl_type_in(m.module, m.node);
                }
            } else {
                let mut iface = DefId { module: 0, node: NODE_NONE };
                let m = self.find_bound_method(bt2.module, bt2.as_data.decl, name, &mut iface);
                if m.node != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(mname, m);
                    if prefer_method {
                        let bc = self.tc_pick_bound_conf(bt2.module, bt2.as_data.decl, m, name, want);
                        if bc == TYPE_ERROR {
                            return TYPE_ERROR;
                        }
                        if bc != TYPE_NONE {
                            self.dflt_conf.insert(mname, bc);
                        }
                    }
                    return self.decl_type_in(m.module, m.node);
                }
            }
        }
        // Into/try_into conversion.
        if prefer_method {
            let conv = self.resolve_conversion(name, want);
            if conv.node != NODE_NONE {
                unsafe (*self.cur_ast()).set_resolution_def(mname, conv);
                return self.decl_type_in(conv.module, conv.node);
            }
        }
        // Auto-deref chain, for fields as well as methods: `b.v` through a Deref is the same step
        // `b.peek()` takes, and stopping at methods left the field unreachable.
        let mut deref_capped = false;
        {
            let mut du = DerefUse { node: mname, n: 0 };
            let mut cur = base;
            let mut seen = Tys8 {};
            seen[0] = base;
            let mut nseen: i32 = 1;
            loop {
                if du.n >= 8 {
                    break;
                }
                let mut cm: ModuleId = 0;
                let mut cd = NODE_NONE;
                if !self.aggregate_decl(cur, &mut cm, &mut cd) {
                    break;
                }
                let dm = self.find_method_cstr(cm, cd, "deref");
                if dm.node == NODE_NONE {
                    break;
                }
                let dret = self.tc_method_ret(cur, dm);
                if dret == TYPE_NONE {
                    break;
                }
                let dry = *self.type_at(dret);
                if dry.kind != TypeKind::TYPE_REFERENCE {
                    break;
                }
                let target = dry.as_data.elem;
                let mut cyc = false;
                for z in 0..nseen {
                    if seen[z as usize] == target {
                        cyc = true;
                    }
                }
                if cyc {
                    self.errors.emit_span(
                        name,
                        format(
                            "cyclic deref chain while resolving '{}'",
                            diag::span_str(self.source, name.start, name.end),
                        ),
                    );
                    return TYPE_NONE;
                }
                unsafe du.recv[du.n as usize] = cur;
                unsafe du.method[du.n as usize] = dm;
                du.n = du.n + 1;
                seen[nseen as usize] = target;
                nseen = nseen + 1;
                let mut tm: ModuleId = 0;
                let mut td = NODE_NONE;
                let mut tgp = Defs8 {};
                let mut tga = Tys8 {};
                let mut tgn: i32 = 0;
                let mut mhit = DefId { module: 0, node: NODE_NONE };
                let mut tconf = TYPE_NONE;
                let mut tfhit = NODE_NONE;
                let tty = *self.type_at(target);
                if self.aggregate_of(target, &mut tm, &mut td, &mut tgp, &mut tga, &mut tgn) {
                    if prefer_method {
                        mhit = self.tc_call_method(target, tm, td, name, want, &mut tconf);
                    }
                    if mhit.node == NODE_NONE {
                        tfhit = self.find_member(tm, td, name);
                    }
                } else if tty.kind == TypeKind::TYPE_BUILTIN && prefer_method {
                    let bd = unsafe (*self.package).builtin_decl(tty.as_data.builtin);
                    if bd != NODE_NONE {
                        mhit = self.tc_call_method(
                            target,
                            unsafe (*self.package).core_module,
                            bd,
                            name,
                            want,
                            &mut tconf,
                        );
                    }
                }
                if mhit.node != NODE_NONE && tconf == TYPE_ERROR {
                    unsafe (*self.cur_ast()).set_resolution_def(mname, mhit);
                    return TYPE_ERROR;
                }
                if mhit.node != NODE_NONE {
                    let sk = self.method_self_kind(mhit);
                    if sk == 0 && tty.kind != TypeKind::TYPE_BUILTIN {
                        self.errors.emit_span(name, format("cannot call a by-value 'self' method through auto-deref"));
                        return TYPE_NONE;
                    }
                    du.target = target;
                    unsafe (*self.cur_ast()).add_deref_use(&du);
                    if sk == 2 {
                        let bad = self.tc_deref_hops_mut(mname);
                        if bad != TYPE_NONE {
                            let tn = self.type_buf(bad);
                            self.errors.emit_span(
                                name,
                                format(
                                    "cannot call a '&mut self' method through '{}': it has 'deref' but no 'deref_mut'",
                                    str::from_cstr(&tn[0]),
                                ),
                            );
                            return TYPE_NONE;
                        }
                    }
                    unsafe (*self.cur_ast()).set_resolution_def(mname, mhit);
                    if tconf != TYPE_NONE {
                        self.dflt_conf.insert(mname, tconf);
                    }
                    return self.subst_type(self.decl_type_in(mhit.module, mhit.node), &tgp[0], &tga[0], tgn);
                }
                if tfhit != NODE_NONE {
                    du.target = target;
                    unsafe (*self.cur_ast()).add_deref_use(&du);
                    unsafe (*self.cur_ast()).set_resolution_def(mname, DefId { module: tm, node: tfhit });
                    if unsafe (*self.mod_ast(tm)).at_const(tfhit).kind == NodeKind::NODE_FIELD {
                        self.check_field_visibility(tm, tfhit, td, name);
                    }
                    return self.subst_type(self.decl_type_in(tm, tfhit), &tgp[0], &tga[0], tgn);
                }
                cur = target;
            }
            deref_capped = du.n == 8;
        }
        let ty = self.type_buf(base);
        self.errors.emit_span(
            name,
            format(
                "no field or method '{}' on '{}'",
                diag::span_str(self.source, name.start, name.end),
                str::from_cstr(&ty[0]),
            ),
        );
        let mut bm: ModuleId = 0;
        let mut bd = NODE_NONE;
        if deref_capped {
            self.errors.note(format("auto-deref stopped after its maximum of 8 hops"));
        } else if self.aggregate_decl(base, &mut bm, &mut bd) && self.find_method(bm, bd, name).node != NODE_NONE {
            self.errors.note(format("the extend that declares it has a target these generic arguments do not match"));
        } else {
            self.errors.note(
                format(
                    "fields are accessed as 'value.name'; methods must be declared in an 'extend' block or provided by a bound",
                ),
            );
        }
        return TYPE_NONE;
    }

    // The type-level arguments of turbofish `tas` (its lifetimes bind no generic parameter).
    const fn tc_targ_count(self: &Self, tas: NodeList) u32 {
        let mut n: u32 = 0;
        for i in 0..tas.len {
            if unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).list(tas)[i as usize]).kind != NodeKind::NODE_LIFETIME {
                n += 1;
            }
        }
        return n;
    }

    // The turbofish of call callee `callee_id`: a path's (`f::<T>`) or a method's (`x.m::<T>`).
    const fn tc_call_targs(self: &Self, callee_id: NodeId) NodeList {
        let n = unsafe (*self.cur_ast()).at_const(callee_id);
        if n.kind == NodeKind::NODE_GENERIC_SPECIALIZATION {
            return n.as_data.specialization.types;
        }
        if n.kind == NodeKind::NODE_MEMBER {
            return n.as_data.member.targs;
        }
        return NodeList { start: 0, len: 0 };
    }

    // Turbofish `tas` names more type-level arguments than function `fd` declares parameters: an
    // error at the first extra argument, answering false.
    fn tc_targ_arity_ok(self: &mut Self, fd: DefId, tas: NodeList) bool {
        let fa = self.mod_ast(fd.module);
        let f = unsafe (*fa).at_const(fd.node).as_data.function;
        let nt = self.tc_targ_count(tas);
        if nt <= f.generics.len {
            return true;
        }
        let a = self.cur_ast();
        let mut k: u32 = 0;
        let mut extra = NODE_NONE;
        for i in 0..tas.len {
            let tid = unsafe (*a).list(tas)[i as usize];
            if unsafe (*a).at_const(tid).kind != NodeKind::NODE_LIFETIME {
                if k == f.generics.len {
                    extra = tid;
                    break;
                }
                k += 1;
            }
        }
        let fnm = unsafe (*fa).at_const(f.name).as_data.name.text;
        let s2 = plural(f.generics.len);
        self.errors.emit_span(
            unsafe (*a).at_const(extra).span,
            format(
                "'{}' takes {} generic argument{} but {} {} supplied",
                diag::span_str(self.mod_src(fd.module), fnm.start, fnm.end),
                f.generics.len,
                str::from_cstr(s2),
                nt,
                pick(nt == 1, "was", "were"),
            ),
        );
        return false;
    }

    // A turbofish after field `mem`, which is no generic function.
    @c.cold
    fn err_field_targs(self: &mut Self, mem: NodeId, tas: NodeList) {
        let a = self.cur_ast();
        let fsp = self.name_span(mem);
        self.errors.emit_span(
            unsafe (*a).at_const(unsafe (*a).list(tas)[0]).span,
            format("field '{}' takes no generic arguments", diag::span_str(self.source, fsp.start, fsp.end)),
        );
    }

    // Type each argument of turbofish `types`, whose generic item is `sd` (NODE_NONE while a method's
    // candidates are still open): a const-generic value argument caches its TYPE_CONST so the aggregate
    // instance and the function's explicit arguments (`type_of`) both see it.
    fn tc_check_targs(self: &mut Self, sd: DefId, types: NodeList) {
        let a = self.cur_ast();
        let mut ti: u32 = 0;
        for i in 0..types.len {
            let tid = unsafe (*a).list(types)[i as usize];
            // A lifetime binds no type-level parameter and has no type.
            if unsafe (*a).at_const(tid).kind == NodeKind::NODE_LIFETIME {
                continue;
            }
            let gid = self.tc_gen_param(sd, ti);
            let want = self.tc_gen_bt(sd, ti);
            let slot = sd;
            let si = ti;
            ti = ti + 1;
            if self.tc_arg_is_const(self.cur_module(), tid) {
                let ct = self.tc_arg_kind(
                    self.tc_const_arg(self.cur_module(), tid, want),
                    self.cur_module(),
                    tid,
                    slot,
                    si,
                    true,
                );
                let et = self.tc_const_enum_arg(ct, self.cur_module(), tid, sd.module, gid);
                unsafe (*self.cur_ast()).set_type(tid, et);
            } else {
                let rt = self.tc_arg_type(self.cur_module(), tid, slot, si);
                let ct = self.tc_const_enum_arg(
                    self.tc_arg_kind(
                        self.tc_const_pos(rt, want, self.cur_module(), tid),
                        self.cur_module(),
                        tid,
                        slot,
                        si,
                        false,
                    ),
                    self.cur_module(),
                    tid,
                    sd.module,
                    gid,
                );
                unsafe (*self.cur_ast()).set_type(tid, ct);
            }
        }
    }

    fn check_path_member(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let direct = unsafe (*a).resolution_def(id);
        let mem = unsafe (*a).at_const(id).as_data.member.member;
        if direct.node != NODE_NONE {
            let dnk = unsafe (*self.mod_ast(direct.module)).at_const(direct.node).kind;
            if dnk == NodeKind::NODE_FUNCTION || dnk == NodeKind::NODE_CONST || dnk == NodeKind::NODE_LET {
                unsafe (*self.cur_ast()).set_resolution_def(mem, direct);
                // `mod::G` reaches the same shared state as a bare `G`.
                self.tc_static_mut_use(id, direct);
                return self.decl_type_in(direct.module, direct.node);
            }
            return self.named_type_of(direct.module, direct.node);
        }
        let obj = unsafe (*a).at_const(id).as_data.member.object;
        let on_kind = unsafe (*a).at_const(obj).kind;
        let mut bmod: ModuleId = 0;
        let mut bdecl = NODE_NONE;
        let mut inst_ty = TYPE_NONE;
        if on_kind == NodeKind::NODE_IDENTIFIER {
            let b = unsafe (*a).resolution_def(obj);
            bmod = b.module;
            bdecl = b.node;
            if bdecl == NODE_NONE {
                let bb = bt_of_name(self.source, unsafe (*a).at_const(obj).span);
                let mut bnd = NODE_NONE;
                if bb >= 0 {
                    bnd = unsafe (*self.package).builtin_decl(bb as BuiltinType);
                }
                if bnd != NODE_NONE {
                    bmod = unsafe (*self.package).core_module;
                    bdecl = bnd;
                }
            }
            if bdecl != NODE_NONE && unsafe (*self.mod_ast(bmod)).at_const(bdecl).kind == NodeKind::NODE_TYPE_ALIAS {
                let at = if unsafe (*self.mod_ast(bmod)).at_const(bdecl).as_data.type_alias.generics.len > 0 {
                    self.tc_bare_alias(obj, b);
                } else {
                    self.named_type_of(bmod, bdecl);
                };
                if at == TYPE_ERROR {
                    return TYPE_ERROR;
                }
                if at != TYPE_NONE {
                    let aty = *self.type_at(at);
                    if aty.kind == TypeKind::TYPE_BUILTIN {
                        bmod = unsafe (*self.package).core_module;
                        bdecl = unsafe (*self.package).builtin_decl(aty.as_data.builtin);
                    } else if aty.kind == TypeKind::TYPE_STRUCT || aty.kind == TypeKind::TYPE_ENUM {
                        bmod = aty.module;
                        bdecl = aty.as_data.decl;
                    } else if aty.kind == TypeKind::TYPE_INSTANCE {
                        let ai = *unsafe (*self.cur_ast()).instance(aty.as_data.inst);
                        bmod = ai.module;
                        bdecl = ai.decl;
                        inst_ty = at;
                        unsafe (*self.cur_ast()).set_type(obj, at);
                    }
                }
            }
            if bdecl != NODE_NONE {
                let bdn = unsafe (*self.mod_ast(bmod)).at_const(bdecl);
                let generic = (bdn.kind == NodeKind::NODE_STRUCT || bdn.kind == NodeKind::NODE_ENUM) && bdn.as_data.aggregate.generics.len > 0;
                // `Self` in a generic extend is its target instance (`W<T>`), as a `Self` type is.
                let sext = if generic && inst_ty == TYPE_NONE && self.tc_self_path(id) {
                    self.self_extend_of(obj, DefId { module: bmod, node: bdecl });
                } else {
                    NODE_NONE;
                };
                if sext != NODE_NONE {
                    inst_ty = self.resolve_type(unsafe (*a).at_const(sext).as_data.extend_def.target_type);
                    unsafe (*self.cur_ast()).set_type(obj, inst_ty);
                } else if generic && self.agg_has_default_at(bmod, bdecl, 0) {
                    let mut ta = Tys8 {};
                    let mut tn: u8 = 0;
                    self.apply_default_args(bmod, bdecl, &mut ta[0], &mut tn);
                    if tn == bdn.as_data.aggregate.generics.len as u8 {
                        inst_ty = unsafe (*self.cur_ast()).intern_instance(bmod, bdecl, &ta[0], tn);
                        unsafe (*self.cur_ast()).set_type(obj, inst_ty);
                    }
                }
            }
        } else {
            let bt = self.check_expr(obj);
            if bt == TYPE_ERROR {
                return TYPE_ERROR;
            }
            let ty = *self.type_at(bt);
            if ty.kind == TypeKind::TYPE_INSTANCE {
                let it = *unsafe (*self.cur_ast()).instance(ty.as_data.inst);
                bmod = it.module;
                bdecl = it.decl;
                inst_ty = bt;
            } else if ty.kind == TypeKind::TYPE_BUILTIN {
                bmod = unsafe (*self.package).core_module;
                bdecl = unsafe (*self.package).builtin_decl(ty.as_data.builtin);
            } else {
                bmod = ty.module;
                bdecl = pick(
                    bt != TYPE_NONE && (ty.kind == TypeKind::TYPE_STRUCT || ty.kind == TypeKind::TYPE_ENUM),
                    ty.as_data.decl,
                    NODE_NONE,
                );
            }
        }
        let mname = self.name_span(mem);
        let mut bd_kind = NodeKind::NODE_NONE_KIND;
        if bdecl != NODE_NONE {
            bd_kind = unsafe (*self.mod_ast(bmod)).at_const(bdecl).kind;
        }
        if bdecl != NODE_NONE && (bd_kind == NodeKind::NODE_GENERIC_PARAM || bd_kind == NodeKind::NODE_INTERFACE && self.tc_self_path(
            id,
        )) {
            let mut iface = DefId { module: 0, node: NODE_NONE };
            let m = self.find_bound_method(bmod, bdecl, mname, &mut iface);
            if m.node != NODE_NONE {
                unsafe (*self.cur_ast()).set_resolution_def(mem, m);
                if self.tc_is_callee(id) {
                    let bc = self.tc_pick_bound_conf(bmod, bdecl, m, mname, expected);
                    if bc == TYPE_ERROR {
                        return TYPE_ERROR;
                    }
                    if bc != TYPE_NONE {
                        self.dflt_conf.insert(mem, bc);
                    }
                }
                return self.decl_type_in(m.module, m.node);
            }
        }
        if bdecl != NODE_NONE && bd_kind == NodeKind::NODE_INTERFACE && expected != TYPE_NONE {
            let mut emod: ModuleId = 0;
            let mut edecl = NODE_NONE;
            if self.aggregate_decl(self.strip(expected), &mut emod, &mut edecl) {
                let m = self.find_method(emod, edecl, mname);
                if m.node != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(mem, m);
                    return self.decl_type_in(m.module, m.node);
                }
            }
        }
        if bdecl == NODE_NONE || bd_kind != NodeKind::NODE_STRUCT && bd_kind != NodeKind::NODE_ENUM {
            let sp = unsafe (*a).at_const(id).span;
            if bdecl != NODE_NONE && bd_kind == NodeKind::NODE_INTERFACE {
                self.errors.emit_span(sp, format("cannot infer the implementing type for this interface call"));
            } else {
                self.errors.emit_span(sp, format("'::' base must be a struct or enum type"));
            }
            return TYPE_NONE;
        }
        if bd_kind == NodeKind::NODE_ENUM {
            let variant = self.find_member(bmod, bdecl, mname);
            if variant != NODE_NONE && unsafe (*self.mod_ast(bmod)).at_const(variant).kind == NodeKind::NODE_VARIANT {
                unsafe (*self.cur_ast()).set_resolution_def(mem, DefId { module: bmod, node: variant });
                // A generic enum named without type arguments (`Option::None`, `Option::Some(x)`)
                // takes its instance from an expected instance of the same enum.
                if inst_ty == TYPE_NONE && expected != TYPE_NONE && self.type_at(expected).kind == TypeKind::TYPE_INSTANCE {
                    let ei = *unsafe (*self.cur_ast()).instance(self.type_at(expected).as_data.inst);
                    if ei.module == bmod && ei.decl == bdecl {
                        inst_ty = expected;
                    }
                }
                // A unit variant has no payload to bind the parameters from: without an instance
                // it names no type.
                let ba = self.mod_ast(bmod);
                let bgens = unsafe (*ba).at_const(bdecl).as_data.aggregate.generics;
                if inst_ty == TYPE_NONE && bgens.len > 0 && unsafe (*ba).at_const(variant).as_data.variant.payload.len == 0 {
                    if expected == TYPE_ERROR {
                        return TYPE_ERROR; // the expected type was rejected where it was written
                    }
                    let gnm = unsafe (*ba).at_const(unsafe (*ba).list(bgens)[0]).as_data.generic_param.name;
                    let gsp = unsafe (*ba).at_const(gnm).as_data.name.text;
                    let sp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(
                        sp,
                        format(
                            "cannot infer the generic argument '{}' of this variant; give it an expected type or explicit type arguments",
                            diag::span_str(self.mod_src(bmod), gsp.start, gsp.end),
                        ),
                    );
                    return TYPE_NONE;
                }
                return pick(inst_ty != TYPE_NONE, inst_ty, self.named_type_of(bmod, bdecl));
            }
        }
        // `T::assoc()` names its type rather than passing a receiver, so aggregate_of never sees it:
        // hand the qualifying instance to the used-marking directly.
        self.mark_recv = inst_ty;
        self.mark_n += 1;
        // A call chooses among the type's same-named methods and the defaults its conformances inherit
        // by its arguments, the receiver first (`K::sum(&k, true, false)`), as a method call does.
        let precv = if inst_ty != TYPE_NONE {
            inst_ty;
        } else if unsafe (*self.mod_ast(bmod)).at_const(bdecl).as_data.aggregate.generics.len == 0 {
            self.named_type_of(bmod, bdecl);
        } else {
            TYPE_NONE;
        };
        // A generic type named without arguments (`W::f()`) has no instance to filter the candidates
        // by: each is weighed with its extend's parameters open, as the call's evidence binds them.
        let mut pconf = TYPE_NONE;
        let mut cands = Defs8 {};
        let picked = self.tc_overloaded(bmod, bdecl, mname) && (precv != TYPE_NONE || self.find_method_all(
            bmod,
            bdecl,
            mname,
            "",
            &mut cands,
        ) > 1);
        let mut method = if picked {
            self.tc_pick_conf_method(precv, bmod, bdecl, mname, expected, self.tc_is_callee(id), &mut pconf);
        } else {
            self.find_method(bmod, bdecl, mname);
        };
        if picked && precv == TYPE_NONE && pconf != TYPE_ERROR && method.node != NODE_NONE && !self.tc_is_own(method) {
            // An inherited default runs under an instance the path does not name.
            let bg = unsafe (*self.mod_ast(bmod)).at_const(bdecl).as_data.aggregate.generics;
            self.err_unresolved_generic(unsafe (*a).at_const(id).span, bmod, unsafe (*self.mod_ast(bmod)).list(bg)[0]);
            return TYPE_ERROR;
        }
        if !picked {
            if method.node != NODE_NONE && inst_ty != TYPE_NONE && !self.tc_method_applies(inst_ty, method) {
                method = self.tc_applicable_method(bmod, bdecl, mname, inst_ty);
            }
            if method.node == NODE_NONE {
                // An interface DEFAULT the conformance inherits (a derived `default()`) is reachable
                // through the qualified path too.
                method = self.find_default_method(bmod, bdecl, mname);
                if method.node != NODE_NONE && inst_ty != TYPE_NONE && !self.tc_default_applies(
                    inst_ty,
                    bmod,
                    bdecl,
                    method,
                ) {
                    method = DefId { module: 0, node: NODE_NONE };
                }
            }
        }
        if method.node != NODE_NONE {
            unsafe (*self.cur_ast()).set_resolution_def(mem, method);
            if pconf == TYPE_ERROR {
                return TYPE_ERROR;
            }
            if pconf != TYPE_NONE {
                self.dflt_conf.insert(mem, pconf);
            }
            // An inherited default runs with `Self` as the qualifying type, which the lowering reads
            // from the qualifier.
            if precv != TYPE_NONE && on_kind == NodeKind::NODE_IDENTIFIER && !self.tc_is_own(method) && unsafe (*a).type_of(
                obj,
            ) == TYPE_NONE {
                unsafe (*self.cur_ast()).set_type(obj, precv);
            }
            return self.decl_type_in(method.module, method.node);
        }
        let mut amb = false;
        let ac = self.find_assoc_const(bmod, bdecl, mname, inst_ty, expected, &mut amb);
        if ac.node != NODE_NONE {
            unsafe (*self.cur_ast()).set_resolution_def(mem, ac);
            let ext = self.enclosing(ac.module, ac.node, NodeKind::NODE_EXTEND);
            if !amb && unsafe (*self.mod_ast(ac.module)).at_const(ext).as_data.extend_def.generics.len == 0 {
                return self.decl_type_in(ac.module, ac.node);
            }
            // A generic extend's constant has a value per instance: the instance binds the extend's
            // parameters, and the path records the target's arguments (as `Type::<Args>::assoc()`).
            let mut tm: ModuleId = 0;
            let mut td = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            if inst_ty == TYPE_NONE || !self.aggregate_of(inst_ty, &mut tm, &mut td, &mut gp, &mut ga, &mut gn) {
                let mut cs = Defs8 {};
                let nm = self.source.slice(mname.start as usize, mname.end as usize);
                let n = self.tc_assoc_consts(self.cur_module(), bmod, bdecl, nm, &mut cs);
                self.err_assoc_const_args(mname, nm, &cs, n);
                return TYPE_NONE;
            }
            let mut ea = Tys8 {};
            let en = self.tc_ext_args(ac.module, ext, &ga[0], gn, &mut ea[0]);
            if en < 0 {
                self.errors.emit_span(
                    mname,
                    format(
                        "no associated method or constant '{}' on this type",
                        diag::span_str(self.source, mname.start, mname.end),
                    ),
                );
                return TYPE_NONE;
            }
            if !self.ext_bounds_hold(ac.module, ext, &ea[0], en, 0) {
                let ty = self.type_buf(inst_ty);
                self.errors.emit_span(
                    mname,
                    format(
                        "cannot use '{}::{}': unsatisfied interface bounds",
                        str::from_cstr(&ty[0]),
                        diag::span_str(self.source, mname.start, mname.end),
                    ),
                );
                self.errors.note(format("these bounds come from the extend block that defines the constant"));
                return TYPE_NONE;
            }
            unsafe (*self.cur_ast()).set_type_args(id, &ga[0], gn as u8);
            let mut ps = Defs8 {};
            let mut ts = Tys8 {};
            let mut k: i32 = 0;
            self.frame_ext(ac.module, ext, &ga[0], gn, &mut ps[0], &mut ts[0], &mut k);
            return self.subst_type(self.decl_type_in(ac.module, ac.node), &ps[0], &ts[0], k);
        }
        let mut kindw = "associated method or constant".ptr() as *const char;
        if bd_kind == NodeKind::NODE_ENUM {
            kindw = "variant, method, or constant".ptr() as *const char;
        }
        self.errors.emit_span(
            mname,
            format(
                "no {} '{}' on this type",
                str::from_cstr(kindw),
                diag::span_str(self.source, mname.start, mname.end),
            ),
        );
        return TYPE_NONE;
    }

    fn check_struct_init(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let stn = unsafe (*a).at_const(id).as_data.struct_initializer.ty;
        // A generic struct (or generic alias) named without type arguments takes its instance the way
        // a generic call does: an expected instance of the same struct, else the field values, then
        // the defaults. `inferred`: the field values are already checked (and unknown fields reported).
        let mut inferred = false;
        let ad = self.tc_lit_generic_alias(stn);
        let mut sty = if ad.node != NODE_NONE {
            self.named_type_of(ad.module, ad.node);
        } else {
            self.type_of_type_node(stn);
        };
        if ad.node != NODE_NONE {
            let gens = unsafe (*self.mod_ast(ad.module)).at_const(ad.node).as_data.type_alias.generics;
            let mut ta = Tys8 {};
            if expected == TYPE_NONE || !self.tc_alias_args_from(ad, sty, self.strip(expected), &mut ta[0]) {
                inferred = true;
                if !self.tc_infer_struct_init(id, sty, NODE_NONE, ad.module, gens, expected == TYPE_ERROR, &mut ta[0]) {
                    return TYPE_NONE;
                }
            }
            sty = self.tc_alias_expand(self.cur_module(), stn, ad, &ta[0], gens.len as u8);
            // Codegen renders the literal's type from this node.
            unsafe (*self.cur_ast()).set_type(stn, sty);
        } else if self.tc_open_generic_struct(sty) {
            if self.tc_instance_of(expected, self.type_at(sty).module, self.type_at(sty).as_data.decl) {
                sty = expected;
            }
            if sty != expected {
                inferred = true;
                let y = *self.type_at(sty);
                let gens = unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl).as_data.aggregate.generics;
                let mut ta = Tys8 {};
                if !self.tc_infer_struct_init(id, sty, NODE_NONE, y.module, gens, expected == TYPE_ERROR, &mut ta[0]) {
                    return TYPE_NONE;
                }
                sty = unsafe (*self.cur_ast()).intern_instance(y.module, y.as_data.decl, &ta[0], gens.len as u8);
            }
            // Codegen renders the literal's type from this node.
            unsafe (*self.cur_ast()).set_type(stn, sty);
        }
        let mut smod: ModuleId = 0;
        let mut decl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(sty, &mut smod, &mut decl, &mut gp, &mut ga, &mut gn) {
            decl = NODE_NONE;
        }
        let mut variant = NODE_NONE;
        if unsafe (*a).at_const(stn).kind == NodeKind::NODE_TYPE_PATH {
            let tp = unsafe (*a).at_const(stn).as_data.type_path;
            if tp.parts.len >= 2 {
                let last = unsafe (*a).list(tp.parts)[(tp.parts.len - 1) as usize];
                let vd = unsafe (*a).resolution_def(last);
                if vd.node != NODE_NONE && unsafe (*self.mod_ast(vd.module)).at_const(vd.node).kind == NodeKind::NODE_VARIANT {
                    variant = vd.node;
                }
            }
            if variant != NODE_NONE && tp.args.len != 0 {
                let vn = self.name_span(unsafe (*a).list(tp.parts)[(tp.parts.len - 1) as usize]);
                if unsafe (*a).at_const(unsafe (*a).list(tp.args)[0]).span.start > vn.start {
                    let en = self.name_span(unsafe (*a).list(tp.parts)[(tp.parts.len - 2) as usize]);
                    self.err_variant_targs(unsafe (*a).at_const(stn).span, en, vn);
                    return TYPE_NONE;
                }
            }
            // A struct-payload variant of a generic enum named without type arguments (`Sh::Pt { .. }`)
            // takes its instance like a tuple variant: an expected instance of the enum, else the field
            // values, then the defaults.
            let gens = if variant != NODE_NONE {
                unsafe (*self.mod_ast(smod)).at_const(decl).as_data.aggregate.generics;
            } else {
                NodeList { start: 0, len: 0 };
            };
            if gens.len != 0 && tp.args.len == 0 {
                if self.tc_instance_of(expected, smod, decl) {
                    sty = expected;
                } else {
                    inferred = true;
                    let mut ta = Tys8 {};
                    if !self.tc_infer_struct_init(
                        id,
                        self.named_type_of(smod, decl),
                        variant,
                        smod,
                        gens,
                        expected == TYPE_ERROR,
                        &mut ta[0],
                    ) {
                        return TYPE_NONE;
                    }
                    sty = unsafe (*self.cur_ast()).intern_instance(smod, decl, &ta[0], gens.len as u8);
                }
                // Codegen renders the literal's type from this node.
                unsafe (*self.cur_ast()).set_type(stn, sty);
                self.aggregate_of(sty, &mut smod, &mut decl, &mut gp, &mut ga, &mut gn);
            }
        }
        if inferred {
            self.tc_inst_bounds(id, sty);
        }
        let fields = unsafe (*a).at_const(id).as_data.struct_initializer.fields;
        for i in 0..fields.len {
            let fid = unsafe (*a).list(fields)[i as usize];
            let fnn = unsafe (*a).at_const(fid).as_data.field_initializer.name;
            let fval = unsafe (*a).at_const(fid).as_data.field_initializer.value;
            let fname = self.name_span(fnn);
            let field = if variant != NODE_NONE {
                self.variant_field(smod, variant, fname);
            } else if decl != NODE_NONE {
                self.find_member(smod, decl, fname);
            } else {
                NODE_NONE;
            };
            let ft = pick(
                field != NODE_NONE,
                self.subst_type(self.decl_type_in(smod, field), &gp[0], &ga[0], gn),
                TYPE_NONE,
            );
            // A field's own type is the expected type for its initializer: the same contextual type a
            // `let` with an annotation gives. Without it an array literal in field position has nothing to
            // widen towards, so `Plain { b: [3, 0, 0, 7] }` typed itself `[i32]` and was rejected against a
            // `[i64; 4]` field. The reason applies to every initializer, not only an interface assoc call.
            if !inferred {
                self.check_expr_w(fval, pick(self.tc_expected_known(ft), ft, TYPE_NONE));
            }
            if variant == NODE_NONE && decl == NODE_NONE {
                continue;
            }
            if field == NODE_NONE {
                if !inferred {
                    self.err_no_field(fname, sty);
                }
                continue;
            }
            unsafe (*self.cur_ast()).set_resolution_def(fnn, DefId { module: smod, node: field });
            if variant == NODE_NONE {
                self.check_field_visibility(smod, field, decl, fname);
            }
            if !self.compatible(ft, fval) {
                self.err_mismatch(fval, ft);
            }
        }
        return sty;
    }

    // Is `ty` an instance of aggregate `decl` of module `m`?
    fn tc_instance_of(self: &Self, ty: TypeId, m: ModuleId, decl: NodeId) bool {
        if ty == TYPE_NONE || self.type_at(ty).kind != TypeKind::TYPE_INSTANCE {
            return false;
        }
        let it = unsafe (*self.cur_ast()).instance(self.type_at(ty).as_data.inst);
        return it.module == m && it.decl == decl;
    }

    // The payload field of variant `variant` (module `m`) spelled `name`; NODE_NONE when none.
    fn variant_field(self: &Self, m: ModuleId, variant: NodeId, name: tok::Span) NodeId {
        let va = self.mod_ast(m);
        let vpl = unsafe (*va).at_const(variant).as_data.variant.payload;
        for j in 0..vpl.len {
            let pfid = unsafe (*va).list(vpl)[j as usize];
            let pf = unsafe (*va).at_const(pfid);
            if pf.kind == NodeKind::NODE_FIELD && spans_eq2(
                self.source,
                name,
                self.mod_src(m),
                unsafe (*va).at_const(pf.as_data.field.name).as_data.name.text,
            ) {
                return pfid;
            }
        }
        return NODE_NONE;
    }

    // Is `n` a path `E::V` naming a variant of enum `E`?
    fn tc_variant_path(self: &Self, n: NodeId) bool {
        let a = self.cur_ast();
        let nn = unsafe (*a).at_const(n);
        if nn.kind != NodeKind::NODE_MEMBER || !nn.as_data.member.path {
            return false;
        }
        let d = unsafe (*a).resolution_def(nn.as_data.member.object);
        if d.node == NODE_NONE || unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_ENUM {
            return false;
        }
        let v = self.find_member(d.module, d.node, self.name_span(nn.as_data.member.member));
        return v != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(v).kind == NodeKind::NODE_VARIANT;
    }

    // `Q::V::<T> { .. }` or `Q::V::<T>(..)` at `sp`, enum name `en`, variant name `vn`: the type
    // arguments belong to the enum.
    fn err_variant_targs(self: &mut Self, sp: tok::Span, en: tok::Span, vn: tok::Span) {
        self.errors.emit_span(
            sp,
            format(
                "type arguments of a generic enum follow the enum name: write '{}::<..>::{}'",
                diag::span_str(self.source, en.start, en.end),
                diag::span_str(self.source, vn.start, vn.end),
            ),
        );
    }

    // Is `ty` a generic struct named without its type arguments (`Pair` for `Pair<A, B>`)?
    fn tc_open_generic_struct(self: &Self, ty: TypeId) bool {
        if ty == TYPE_NONE || self.type_at(ty).kind != TypeKind::TYPE_STRUCT {
            return false;
        }
        let y = *self.type_at(ty);
        let dn = unsafe (*self.mod_ast(y.module)).at_const(y.as_data.decl);
        return dn.kind == NodeKind::NODE_STRUCT && dn.as_data.aggregate.generics.len != 0;
    }

    // The generic alias struct literal type node `stn` names without type arguments (`Q1` for
    // `type Q1<T> = Pair<T, T>`), or a NODE_NONE def.
    const fn tc_lit_generic_alias(self: &Self, stn: NodeId) DefId {
        let none = DefId { module: 0, node: NODE_NONE };
        if unsafe (*self.cur_ast()).at_const(stn).kind != NodeKind::NODE_IDENTIFIER {
            return none;
        }
        let d = unsafe (*self.cur_ast()).resolution_def(stn);
        if d.node == NODE_NONE || d.module != self.cur_module() && d.module as usize >= self.pkg_count() {
            return none;
        }
        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
        if dn.kind != NodeKind::NODE_TYPE_ALIAS || dn.as_data.type_alias.generics.len == 0 {
            return none;
        }
        return d;
    }

    // Struct literal `id` of the open generic struct (or generic alias body) `sty` without an
    // expected instance: check each field value (a field whose type under `sty` names no parameter
    // gives it that expected type) and infer the arguments `ta` of the parameters `gens` (of module
    // `em`) from the values. False when one stays open (reported).
    fn tc_infer_struct_init(
        self: &mut Self,
        id: NodeId,
        sty: TypeId,
        variant: NodeId,
        em: ModuleId,
        gens: NodeList,
        want_err: bool,
        ta: *mut TypeId,
    ) bool {
        let a = self.cur_ast();
        let mut smod: ModuleId = 0;
        let mut sdecl = NODE_NONE;
        let mut gp = Defs8 {};
        let mut ga = Tys8 {};
        let mut gn: i32 = 0;
        if !self.aggregate_of(sty, &mut smod, &mut sdecl, &mut gp, &mut ga, &mut gn) {
            return false;
        }
        let fields = unsafe (*a).at_const(id).as_data.struct_initializer.fields;
        let mut ptys = Vector::<TypeId>::new();
        let mut vals = Vector::<NodeId>::new();
        ptys.reserve(fields.len as usize);
        vals.reserve(fields.len as usize);
        for i in 0..fields.len {
            let fid = unsafe (*a).list(fields)[i as usize];
            let fval = unsafe (*a).at_const(fid).as_data.field_initializer.value;
            let fname = self.name_span(unsafe (*a).at_const(fid).as_data.field_initializer.name);
            let field = if variant != NODE_NONE {
                self.variant_field(smod, variant, fname);
            } else {
                self.find_member(smod, sdecl, fname);
            };
            if field == NODE_NONE {
                self.err_no_field(fname, sty);
            }
            let ft = pick(
                field != NODE_NONE,
                self.subst_type(self.decl_type_in(smod, field), &gp[0], &ga[0], gn),
                TYPE_NONE,
            );
            let fwant = pick(ft != TYPE_NONE && unsafe (*self.cur_ast()).type_concrete(ft), ft, TYPE_NONE);
            self.check_expr_w(fval, fwant);
            if ft != TYPE_NONE {
                ptys.push(ft);
                vals.push(fval);
            }
        }
        return self.tc_infer_gen_args(unsafe (*a).at_const(id).span, em, gens, &ptys, &vals, false, want_err, ta);
    }

    fn check_if_stmt(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let ifd = unsafe (*a).at_const(id).as_data.if_stmt;
        self.check_cond(ifd.condition, "if");
        self.lint_const_cond(id, ifd.condition, false, true);
        self.check_stmt(ifd.then_branch);
        self.check_stmt(ifd.else_branch);
    }

    // Does this pattern match every value (wildcard or pure binding, through or-alternatives)?
    // Matrix-consistent: a variant name or `@`-bound subpattern is NOT a catch-all.
    fn pat_catchall(self: &Self, pid: NodeId) bool {
        if pid == NODE_NONE {
            return false;
        }
        let a = self.cur_ast();
        let p = unsafe (*a).at_const(pid);
        if p.kind == NodeKind::NODE_PATTERN_WILDCARD || p.kind == NodeKind::NODE_IDENTIFIER {
            return true;
        }
        if p.kind == NodeKind::NODE_PATTERN_NAME && p.as_data.pattern.children.len == 0 {
            let d = unsafe (*a).resolution_def(p.as_data.pattern.name);
            return d.node == NODE_NONE || unsafe (*self.mod_ast(d.module)).at_const(d.node).kind != NodeKind::NODE_VARIANT;
        }
        if p.kind == NodeKind::NODE_PATTERN_OR {
            let ch = p.as_data.pattern.children;
            for i in 0..ch.len {
                if self.pat_catchall(unsafe (*a).list(ch)[i as usize]) {
                    return true;
                }
            }
        }
        return false;
    }

    // The shared pattern matrix (pattern::pattern) decides coverage. A switch whose matrix exceeds
    // the work budget cannot be proven exhaustive and must end in a catch-all arm.
    fn check_match_exhaustive(self: &mut Self, id: NodeId, scrut: TypeId) {
        if untyped(scrut) {
            return;
        }
        let a = self.cur_ast();
        let base = self.strip(scrut);
        let mut emod2: ModuleId = 0;
        let mut edecl2 = NODE_NONE;
        let agok2 = self.aggregate_decl(base, &mut emod2, &mut edecl2);
        let is_enum2 = agok2 && unsafe (*self.mod_ast(emod2)).at_const(edecl2).kind == NodeKind::NODE_ENUM;
        // Short-circuit: an unguarded catch-all arm (wildcard or pure binding) makes the matrix
        // verdict trivially "exhaustive": skip building it.
        let arms2 = unsafe (*a).at_const(id).as_data.match_expr.arms;
        for i in 0..arms2.len {
            let arm = unsafe (*a).at_const(unsafe (*a).list(arms2)[i as usize]);
            if arm.as_data.match_arm.guard == NODE_NONE && self.pat_catchall(arm.as_data.match_arm.pattern) {
                return;
            }
        }
        let mut cx = pat::PatCx::new(self.package, a, self.source);
        for i in 0..arms2.len {
            let arm = unsafe (*a).at_const(unsafe (*a).list(arms2)[i as usize]);
            if arm.as_data.match_arm.guard == NODE_NONE {
                cx.add_arm(arm.as_data.match_arm.pattern, i);
            }
        }
        if !cx.overflow {
            let sp2 = unsafe (*a).at_const(unsafe (*a).at_const(id).as_data.match_expr.value).span;
            if is_enum2 {
                let variants2 = unsafe (*self.mod_ast(emod2)).at_const(edecl2).as_data.aggregate.members;
                if variants2.len <= MATCH_MAX_VARIANTS {
                    let mut nmiss: u32 = 0;
                    for k in 0..variants2.len {
                        let vd = DefId {
                            module: emod2,
                            node: unsafe (*self.mod_ast(emod2)).list(variants2)[k as usize],
                        };
                        if cx.variant_missing(vd, k) {
                            nmiss = nmiss + 1;
                        }
                    }
                    if !cx.overflow {
                        if nmiss == 0 {
                            return;
                        }
                        let s2 = plural(nmiss);
                        self.errors.emit_span(
                            sp2,
                            format("switch is not exhaustive: missing {} variant{}", nmiss, str::from_cstr(s2)),
                        );
                        self.errors.note(format("match every variant or add a '_' arm"));
                        return;
                    }
                }
            }
            if !cx.overflow {
                let missing = cx.wildcard_useful();
                if !cx.overflow {
                    if !missing {
                        return;
                    }
                    self.errors.emit_span(sp2, format("switch is not exhaustive"));
                    self.errors.note(format("add a '_' arm to cover the remaining values"));
                    return;
                }
            }
        }
        // Budget overflow (adversarial or-expansion): coverage is unknown, so the switch is rejected
        // instead of assumed exhaustive.
        let sp3 = unsafe (*a).at_const(unsafe (*a).at_const(id).as_data.match_expr.value).span;
        self.errors.emit_span(
            sp3,
            format("switch exhaustiveness cannot be checked: its patterns exceed the analysis budget"),
        );
        self.errors.note(format("add a '_' arm to cover the remaining values"));
    }

    // Matrix usefulness marks the first arm no value can reach (earlier GUARDED arms
    // cover nothing for later arms: their guard may fail). One report per switch; a budget
    // overflow reports nothing.
    fn lint_unreachable_arms(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let mut cx = pat::PatCx::new(self.package, a, self.source);
        let arms = unsafe (*a).at_const(id).as_data.match_expr.arms;
        for i in 0..arms.len {
            let arm = unsafe (*a).at_const(unsafe (*a).list(arms)[i as usize]).as_data.match_arm;
            if i != 0 && !cx.arm_reachable(arm.pattern, i) {
                let psp = unsafe (*a).at_const(arm.pattern).span;
                self.errors.warn_span(psp, format("unreachable arm: a previous arm matches every value"));
                return;
            }
            if arm.guard == NODE_NONE {
                cx.add_arm(arm.pattern, i);
            }
        }
    }

    // The parameter a compound assignment's right operand answers to, when the overload takes it BY
    // VALUE. `x <<= 3` lowers to `x = x.shl(3)`, so 3 is a count and not another x. A by-reference
    // parameter (`add(self, other: &Self)`) keeps the plain same-type check, which is what it means.
    fn compound_param_type(self: &mut Self, op: TokenType, l: TypeId) TypeId {
        let m = op.op_method();
        if m.len() == 0 || l == TYPE_NONE {
            return TYPE_NONE;
        }
        let mut ls = l;
        while ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_REFERENCE {
            ls = self.type_at(ls).as_data.elem;
        }
        let k = self.type_at(ls).kind;
        if k != TypeKind::TYPE_STRUCT && k != TypeKind::TYPE_INSTANCE {
            return TYPE_NONE;
        }
        let mut om: ModuleId = 0;
        let mut od = NODE_NONE;
        if !self.aggregate_decl(ls, &mut om, &mut od) {
            return TYPE_NONE;
        }
        let md = self.find_method_cstr(om, od, m);
        if md.node == NODE_NONE {
            return TYPE_NONE;
        }
        let p1 = self.tc_method_param(ls, md, 1);
        if p1 == TYPE_NONE || self.type_at(p1).kind == TypeKind::TYPE_REFERENCE {
            return TYPE_NONE;
        }
        return p1;
    }

    fn check_assignment(self: &mut Self, id: NodeId) TypeId {
        let a = self.cur_ast();
        let bd = unsafe (*a).at_const(id).as_data.binary;
        let l = self.check_expr(bd.left);
        self.tc_note_capture_mut(bd.left);
        let ls = self.strip(l);
        let m = bd.op.op_method();
        if m.len() != 0 && ls != TYPE_NONE && self.type_at(ls).kind == TypeKind::TYPE_GENERIC {
            // `t op= r` through a bound is `t = t op r`: the bound's result must be `T` itself, as a
            // binding says (`T: Add<Output = T>`).
            self.check_expr(bd.right);
            let mut res = TYPE_NONE;
            if !self.is_assignable(bd.left) {
                let sp = unsafe (*a).at_const(bd.left).span;
                self.errors.emit_span(sp, format("cannot assign to this expression"));
            } else if !self.tc_bound_op(id, ls, m, bd.right, &mut res) {
                let sp = unsafe (*a).at_const(id).span;
                let ty = self.type_buf(ls);
                self.errors.emit_span(
                    sp,
                    format(
                        "type parameter '{}' has no '{}' method for this operator (add a bound that provides it)",
                        str::from_cstr(&ty[0]),
                        m,
                    ),
                );
            } else if res != ls && res != TYPE_ERROR {
                let sp = unsafe (*a).at_const(id).span;
                let rb = self.type_buf(res);
                let tb = self.type_buf(ls);
                self.errors.emit_span(
                    sp,
                    format(
                        "mismatched types: the operator's result '{}' is not '{}'",
                        str::from_cstr(&rb[0]),
                        str::from_cstr(&tb[0]),
                    ),
                );
                self.errors.note(format("bind the result in the bound: 'Output = {}'", str::from_cstr(&tb[0])));
            }
            return l;
        }
        let pt = self.compound_param_type(bd.op, l);
        self.check_expr_w(bd.right, pick(pt != TYPE_NONE, pt, l));
        if !self.is_assignable(bd.left) {
            let sp = unsafe (*a).at_const(bd.left).span;
            self.errors.emit_span(sp, format("cannot assign to this expression"));
        } else if pt != TYPE_NONE {
            if !self.operand_fits_param(pt, bd.right) {
                self.err_mismatch(bd.right, pt);
            }
        } else if !self.compatible(l, bd.right) {
            self.err_mismatch(bd.right, l);
        }
        return l;
    }
    // True when `t` still mentions unresolved generics. A decl-referenced function type reports
    // concrete, so its signature components are inspected one level deep.
    fn tc_infer_ty_open(self: &mut Self, t: TypeId) bool {
        if t == TYPE_NONE {
            return false;
        }
        if !unsafe (*self.cur_ast()).type_concrete(t) {
            return true;
        }
        if self.type_at(t).kind == TypeKind::TYPE_FUNCTION {
            let sh = self.fn_sig(t);
            for i in 0..sh.np {
                if !unsafe (*self.cur_ast()).type_concrete(self.fn_param(&sh, i)) {
                    return true;
                }
            }
            if sh.ret != TYPE_NONE && !unsafe (*self.cur_ast()).type_concrete(sh.ret) {
                return true;
            }
        }
        return false;
    }

    // True when the closure has at least one parameter with no type annotation: the ones whose
    // check must wait for an expected function shape.
    const fn tc_closure_unannotated(self: &Self, cid: NodeId) bool {
        let a = self.cur_ast();
        let ps = unsafe (*a).at_const(cid).as_data.closure.params;
        for i in 0..ps.len {
            if unsafe (*a).at_const(unsafe (*a).list(ps)[i as usize]).as_data.parameter.ty == NODE_NONE {
                return true;
            }
        }
        return false;
    }

    fn check_closure(self: &mut Self, id: NodeId, cwant: TypeId) TypeId {
        // Inside a fields loop a closure is fine as long as it never touches the binder: its one
        // lifted C form serves every copy. Binder USES check the depth watermark (proj_cbase).
        self.icx.closure_depth = self.icx.closure_depth + 1;
        let cres = self.check_closure_in(id, cwant);
        self.icx.closure_depth = self.icx.closure_depth - 1;
        return cres;
    }

    fn check_closure_in(self: &mut Self, id: NodeId, cwant: TypeId) TypeId {
        let a = self.cur_ast();
        let params = unsafe (*a).at_const(id).as_data.closure.params;
        // The expected signature, read at the first unannotated parameter.
        let mut sig = FnShape { m: 0, ps: NodeList { start: 0, len: 0 }, ret: TYPE_NONE, sig: TYPE_NONE, np: 0 };
        let mut have_sig = false;
        for i in 0..params.len {
            let pid = unsafe (*a).list(params)[i as usize];
            if unsafe (*a).at_const(pid).as_data.parameter.ty != NODE_NONE {
                continue;
            }
            if !have_sig {
                have_sig = true;
                if cwant != TYPE_NONE && self.type_at(cwant).kind == TypeKind::TYPE_FUNCTION {
                    sig = self.fn_sig(cwant);
                }
            }
            let mut spt = TYPE_NONE;
            if i < sig.np {
                spt = self.fn_param(&sig, i);
            }
            if unsafe (*a).type_of(pid) != TYPE_NONE {
                // Pre-seeded by the postponed-closure site with the substituted parameter type.
            } else if spt != TYPE_NONE {
                unsafe (*self.cur_ast()).set_type(pid, spt);
            } else {
                let psp = unsafe (*a).at_const(pid).span;
                self.errors.emit_span(
                    psp,
                    format("closure parameter needs a type annotation (no expected function type supplies one)"),
                );
                self.errors.note(
                    format("annotate it (`|x: i32| ..`) or bind the closure where a 'fn' type is expected"),
                );
            }
        }
        for i in 0..params.len {
            self.decl_type(unsafe (*a).list(params)[i as usize]);
        }
        if self.icx.nclos >= 8 {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("closures nested too deeply (max 8)"));
            return TYPE_NONE;
        }
        let cn = self.icx.nclos;
        unsafe self.icx.clos_stack[cn as usize] = id;
        self.icx.nclos = cn + 1;
        let saved_lf = self.loop_floor;
        self.loop_floor = self.nloops;
        if unsafe (*a).at_const(id).as_data.closure.expr_body {
            let body = unsafe (*a).at_const(id).as_data.closure.body;
            self.check_expr(body);
            if unsafe (*a).at_const(body).kind == NodeKind::NODE_ASSIGNMENT {
                // `|x| t += x` is a statement body: the closure returns nothing, not the target's value.
                unsafe (*self.cur_ast()).set_type(body, Ast::builtin(BuiltinType::BT_VOID));
            }
        } else {
            let saved = self.icx.current_returns;
            self.icx.current_returns = unsafe (*a).at_const(id).as_data.closure.returns;
            self.check_stmt(unsafe (*a).at_const(id).as_data.closure.body);
            self.icx.current_returns = saved;
        }
        self.loop_floor = saved_lf;
        self.icx.nclos = self.icx.nclos - 1;
        // Capture validation, and the closure's emission facts (the mutable-capture mask is
        // finalized by the borrow checker).
        let caps = unsafe (*a).at_const(id).as_data.closure.captures;
        let mut_caps = (unsafe (*a).at_const(id).as_data.closure.mut_caps) as u64;
        let mut cfs = Vector::<CapFact>::new();
        cfs.reserve(caps.len as usize);
        for i in 0..caps.len {
            let cid = unsafe (*a).list(caps)[i as usize];
            cfs.push(CapFact { name: unsafe (*a).decl_name_span(cid), ty: self.decl_type(cid) });
        }
        // The signature as the C spelling reads it: each parameter's annotation type (the
        // parameter node's own when bare), then the return type, which an expression body carries
        // on the body node.
        let cparams = unsafe (*a).at_const(id).as_data.closure.params;
        for i in 0..cparams.len {
            let pid = unsafe (*a).list(cparams)[i as usize];
            let mut anchor = pid;
            if unsafe (*a).at_const(pid).kind == NodeKind::NODE_PARAMETER && unsafe (*a).at_const(pid).as_data.parameter.ty != NODE_NONE {
                anchor = unsafe (*a).at_const(pid).as_data.parameter.ty;
            }
            cfs.push(CapFact { name: tok::Span::empty(), ty: unsafe (*a).type_of(anchor) });
        }
        let crets = unsafe (*a).at_const(id).as_data.closure.returns;
        let mut nrets: u32 = crets.len;
        for i in 0..crets.len {
            let r0 = unsafe (*a).list(crets)[i as usize];
            let rtn = unsafe (*a).slot_type_node(r0);
            cfs.push(CapFact { name: tok::Span::empty(), ty: unsafe (*a).type_of(rtn) });
        }
        if crets.len == 0 && unsafe (*a).at_const(id).as_data.closure.expr_body {
            nrets = 1;
            cfs.push(
                CapFact {
                    name: tok::Span::empty(),
                    ty: unsafe (*a).type_of(unsafe (*a).at_const(id).as_data.closure.body),
                },
            );
        }
        let ref_caps = (unsafe (*a).at_const(id).as_data.closure.ref_caps) as u64;
        unsafe (*self.cur_ast()).record_closure(id, true, cparams.len, nrets, mut_caps, ref_caps, cfs);
        return unsafe (*self.cur_ast()).intern_type(
            Ty { kind: TypeKind::TYPE_FUNCTION, module: self.cur_module(), as_data: TyAs { decl: id } },
        );
    }

    fn check_index(self: &mut Self, id: NodeId, addr_ctx: bool) TypeId {
        let a = self.cur_ast();
        let obj_n = unsafe (*a).at_const(id).as_data.index.object;
        let index_n = unsafe (*a).at_const(id).as_data.index.index;
        self.icx.addr_ctx = addr_ctx;
        let mut obj = self.check_expr(obj_n);
        if self.type_at(obj).kind == TypeKind::TYPE_REFERENCE {
            let mut p = obj;
            let mut y = *self.type_at(p);
            while y.kind == TypeKind::TYPE_REFERENCE {
                p = y.as_data.elem;
                y = *self.type_at(p);
            }
            obj = p;
        }
        let ot = *self.type_at(obj);
        let idxn_kind = unsafe (*a).at_const(index_n).kind;
        if idxn_kind == NodeKind::NODE_RANGE {
            let mut elem = TYPE_NONE;
            let mut selem: TypeId = TYPE_NONE;
            let mut user_result = TYPE_NONE;
            if ot.kind == TypeKind::TYPE_ARRAY || ot.kind == TypeKind::TYPE_POINTER {
                if ot.kind == TypeKind::TYPE_POINTER && self.tc_needs_unsafe() {
                    self.err_unsafe(unsafe (*a).at_const(obj_n).span, "slicing a raw pointer");
                }
                elem = ot.as_data.elem;
            } else if self.slice_kind(obj, &mut selem) != 0 {
                elem = selem;
            } else if ot.kind == TypeKind::TYPE_STRUCT || ot.kind == TypeKind::TYPE_INSTANCE {
                let mut om: ModuleId = 0;
                let mut od = NODE_NONE;
                let sp = unsafe (*a).at_const(obj_n).span;
                if self.aggregate_decl(self.strip(obj), &mut om, &mut od) {
                    let md = self.find_method_cstr(om, od, "index_range");
                    if md.node == NODE_NONE {
                        let ty = self.type_buf(self.strip(obj));
                        self.errors.emit_span(
                            sp,
                            format("'{}' has no 'index_range' method for '[..]'", str::from_cstr(&ty[0])),
                        );
                    } else if !self.method_extend_bounds_hold(self.strip(obj), md) {
                        self.err_method_extend_bounds(sp, self.strip(obj), md);
                    } else {
                        if unsafe (*a).at_const(index_n).as_data.pattern_range.end == NODE_NONE && self.find_method_cstr(
                            om,
                            od,
                            "len",
                        ).node == NODE_NONE {
                            let ty = self.type_buf(self.strip(obj));
                            self.errors.emit_span(
                                sp,
                                format(
                                    "an open-ended range index needs a 'len' method on '{}' to supply the end",
                                    str::from_cstr(&ty[0]),
                                ),
                            );
                        }
                        self.prelude_range_type(Ast::builtin(BuiltinType::BT_USIZE));
                        user_result = self.tc_method_ret(self.strip(obj), md);
                    }
                }
            } else if !untyped(obj) {
                let sp = unsafe (*a).at_const(obj_n).span;
                self.errors.emit_span(sp, format("cannot slice this expression"));
            }
            let bstart = unsafe (*a).at_const(index_n).as_data.pattern_range.start;
            let bend = unsafe (*a).at_const(index_n).as_data.pattern_range.end;
            if bstart != NODE_NONE {
                let bt = self.check_expr(bstart);
                if !untyped(bt) && !self.is_int(bt) && unsafe (*a).at_const(bstart).kind != NodeKind::NODE_LITERAL {
                    let sp = unsafe (*a).at_const(bstart).span;
                    self.errors.emit_span(sp, format("range bound must be an integer"));
                }
            }
            if bend != NODE_NONE {
                let bt = self.check_expr(bend);
                if !untyped(bt) && !self.is_int(bt) && unsafe (*a).at_const(bend).kind != NodeKind::NODE_LITERAL {
                    let sp = unsafe (*a).at_const(bend).span;
                    self.errors.emit_span(sp, format("range bound must be an integer"));
                }
            }
            // Slicing a raw `[T; N]` follows the raw-array indexing rule: every written bound must
            // const-fold with 0 <= start <= end <= N (a missing bound is 0 / N), else the view is
            // unproven and needs 'unsafe'. A provably out-of-range constant bound is a hard error.
            if ot.kind == TypeKind::TYPE_ARRAY {
                let n = ot.as_data.arr.len as i64;
                let inclusive = unsafe (*a).at_const(index_n).as_data.pattern_range.inclusive;
                let mut lo: i64 = 0;
                let mut hi: i64 = n;
                let mut proven = !ot.arr_sym();
                if proven && bstart != NODE_NONE {
                    proven = self.tc_fold_int(bstart, &mut lo);
                }
                if proven && bend != NODE_NONE {
                    proven = self.tc_fold_int(bend, &mut hi);
                    if proven && inclusive {
                        hi = hi + 1;
                    }
                }
                let sp = unsafe (*a).at_const(id).span;
                if proven && (lo < 0 || lo > hi || hi > n) {
                    self.errors.emit_span(
                        sp,
                        format("range [{}, {}) is out of bounds for an array of length {}", lo, hi, n),
                    );
                } else if !proven && self.tc_needs_unsafe() {
                    let mut c: i64 = 0;
                    if ot.arr_sym() && (bstart == NODE_NONE || self.tc_fold_int(bstart, &mut c)) && (bend == NODE_NONE || self.tc_fold_int(
                        bend,
                        &mut c,
                    )) {
                        self.err_unsafe(sp, "slicing an array of unknown length");
                    } else {
                        self.err_unsafe(sp, "slicing an array with a non-constant range");
                    }
                }
            }
            let mut sresult = user_result;
            if sresult == TYPE_NONE && elem != TYPE_NONE {
                sresult = self.prelude_slice_type(elem, false);
            }
            return sresult;
        }
        let idx = self.check_expr(index_n);
        let mut overloaded = false;
        let mut result = TYPE_NONE;
        if !untyped(obj) {
            let mut selem: TypeId = TYPE_NONE;
            if ot.kind == TypeKind::TYPE_ARRAY || ot.kind == TypeKind::TYPE_POINTER {
                if ot.kind == TypeKind::TYPE_POINTER && self.tc_needs_unsafe() {
                    self.err_unsafe(unsafe (*a).at_const(obj_n).span, "indexing a raw pointer");
                }
                // Raw `[T; N]` indexing is unsafe-gated like raw pointers UNLESS the index
                // const-folds in bounds; a constant provably out of bounds is a hard error (never
                // unsafe-able). Against a symbolic length a constant index outside `unsafe` is
                // checked for every instance (`tc_index_step`). Safe dynamic indexing lives in the
                // std views (Array/Slice/Vector).
                if ot.kind == TypeKind::TYPE_ARRAY {
                    let n = ot.as_data.arr.len as i64;
                    let mut v: i64 = 0;
                    let konst = self.tc_fold_int(index_n, &mut v);
                    if konst && (v < 0 || !ot.arr_sym() && v >= n) {
                        let sp = unsafe (*a).at_const(id).span;
                        if ot.arr_sym() {
                            self.errors.emit_span(sp, format("index {} is out of bounds for an array", v));
                        } else {
                            self.errors.emit_span(
                                sp,
                                format("index {} is out of bounds for an array of length {}", v, n),
                            );
                        }
                    } else if konst && ot.arr_sym() && self.tc_needs_unsafe() {
                        // Under `unsafe` the index is the programmer's, as a raw pointer's is.
                        self.tc_index_step(id, ot.as_data.arr.len, v);
                    } else if !konst && self.tc_needs_unsafe() {
                        self.err_unsafe(unsafe (*a).at_const(obj_n).span, "indexing an array with a non-constant index");
                    }
                }
                result = ot.as_data.elem;
            } else if self.slice_kind(obj, &mut selem) != 0 {
                result = selem;
            } else if ot.kind == TypeKind::TYPE_STRUCT || ot.kind == TypeKind::TYPE_INSTANCE {
                overloaded = true;
                let mut om: ModuleId = 0;
                let mut od = NODE_NONE;
                let sp = unsafe (*a).at_const(obj_n).span;
                if self.aggregate_decl(self.strip(obj), &mut om, &mut od) {
                    let md = self.find_method_cstr(om, od, "index");
                    if md.node == NODE_NONE {
                        let ty = self.type_buf(self.strip(obj));
                        self.errors.emit_span(sp, format("'{}' has no 'index' method for '[]'", str::from_cstr(&ty[0])));
                    } else if !self.method_extend_bounds_hold(self.strip(obj), md) {
                        self.err_method_extend_bounds(sp, self.strip(obj), md);
                        result = TYPE_NONE;
                    } else {
                        let p1 = self.tc_method_param(self.strip(obj), md, 1);
                        if !self.operand_fits_param(p1, index_n) {
                            self.err_mismatch(index_n, p1);
                        }
                        result = self.tc_method_ret(self.strip(obj), md);
                        if result != TYPE_NONE && self.type_at(result).kind == TypeKind::TYPE_REFERENCE {
                            result = self.type_at(result).as_data.elem;
                        }
                    }
                }
            } else if ot.kind == TypeKind::TYPE_GENERIC {
                // Through a bound (`T: Index<E, S>`): the conformance's `index`, its element place.
                overloaded = true;
                if !self.tc_bound_op(id, obj, "index", index_n, &mut result) {
                    let sp = unsafe (*a).at_const(obj_n).span;
                    let ty = self.type_buf(obj);
                    self.errors.emit_span(
                        sp,
                        format(
                            "type parameter '{}' has no 'index' method for '[]' (add a bound that provides it)",
                            str::from_cstr(&ty[0]),
                        ),
                    );
                    result = TYPE_NONE;
                } else if result != TYPE_NONE && self.type_at(result).kind == TypeKind::TYPE_REFERENCE {
                    result = self.type_at(result).as_data.elem;
                }
            } else {
                let sp = unsafe (*a).at_const(obj_n).span;
                self.errors.emit_span(sp, format("cannot index this expression"));
            }
        }
        if !overloaded && !untyped(idx) && !self.is_int(idx) && unsafe (*a).at_const(index_n).kind != NodeKind::NODE_LITERAL {
            let sp = unsafe (*a).at_const(index_n).span;
            self.errors.emit_span(sp, format("index must be an integer"));
        }
        return result;
    }

    fn check_match_expr(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let scrut = self.check_expr(unsafe (*a).at_const(id).as_data.match_expr.value);
        let arms = unsafe (*a).at_const(id).as_data.match_expr.arms;
        let mut first = true;
        let mut result = TYPE_NONE;
        let mut lits = false;
        for i in 0..arms.len {
            let aid = unsafe (*a).list(arms)[i as usize];
            let arm = unsafe (*a).at_const(aid).as_data.match_arm;
            self.check_pattern(arm.pattern, scrut, 0);
            self.tc_profile_check(unsafe (*a).at_const(id).as_data.match_expr.value, arm.pattern);
            let g = self.check_expr(arm.guard);
            if arm.guard != NODE_NONE && !untyped(g) && !self.is_bool(g) {
                let sp = unsafe (*a).at_const(arm.guard).span;
                self.errors.emit_span(sp, format("match guard must be 'bool'"));
            }
            let mut body = self.check_expr_w(arm.body, expected);
            if expected != TYPE_NONE {
                self.tc_tail_adapt(expected, arm.body);
                body = unsafe (*self.cur_ast()).type_of(arm.body);
            }
            let body_never = body != TYPE_NONE && self.type_at(body).kind == TypeKind::TYPE_NEVER;
            if expected != TYPE_NONE {
                // A context type is known: each arm coerces to IT (widening, adaptation, the works)
                // instead of having to equal the first arm exactly.
                if body != TYPE_NONE && !body_never && !self.compatible(expected, arm.body) {
                    self.err_mismatch(arm.body, expected);
                }
                if first {
                    result = body;
                    first = false;
                } else if !body_never {
                    result = expected;
                }
            } else {
                // Without a context type an unpinned literal arm takes the type of the other arms:
                // `lits` holds while every value arm so far is such a literal.
                let blit = self.tc_branch_lit(arm.body);
                if first || result != TYPE_NONE && self.type_at(result).kind == TypeKind::TYPE_NEVER {
                    result = body;
                    first = false;
                    lits = blit != NODE_NONE;
                } else if !body_never && result != body && !untyped(body) && !untyped(result) {
                    if blit != NODE_NONE && self.tc_branch_adopt(arm.body, blit, result, false) {
                        // this literal arm took the earlier arms' type
                    } else if lits && self.tc_arms_adopt(arms, i, body) {
                        result = body;
                    } else {
                        self.err_mismatch(arm.body, result);
                        result = TYPE_NONE;
                    }
                }
                if !body_never && blit == NODE_NONE {
                    lits = false;
                }
            }
        }
        self.check_match_exhaustive(id, scrut);
        if self.lint && !untyped(scrut) {
            self.lint_unreachable_arms(id);
        }
        return result;
    }

    // The unpinned numeric literal that branch `br` yields (the branch itself or its block's tail),
    // or NODE_NONE.
    fn tc_branch_lit(self: &Self, br: NodeId) NodeId {
        let a = self.cur_ast();
        let mut v = br;
        if unsafe (*a).at_const(v).kind == NodeKind::NODE_BLOCK {
            let stmts = unsafe (*a).at_const(v).as_data.block.statements;
            if stmts.len == 0 {
                return NODE_NONE;
            }
            let last = unsafe (*a).at_const(unsafe (*a).list(stmts)[(stmts.len - 1) as usize]);
            if last.kind != NodeKind::NODE_EXPRESSION_STATEMENT {
                return NODE_NONE;
            }
            v = last.as_data.single.value;
        }
        return pick(self.tc_peek_lit_class(v) != 0, v, NODE_NONE);
    }

    // Give branch `br`, whose value is the unpinned literal `lit`, the numeric type `ty` of the other
    // branches (range-checked like any literal). A probe changes nothing.
    fn tc_branch_adopt(self: &mut Self, br: NodeId, lit: NodeId, ty: TypeId, probe: bool) bool {
        if !self.is_numeric(ty) || !self.compatible_in(ty, lit, probe) {
            return false;
        }
        if !probe {
            unsafe (*self.cur_ast()).set_type(br, ty);
        }
        return true;
    }

    // Arms [0, n) are all unpinned literals or diverge: give every literal arm the type `ty`, or
    // change nothing when one of them cannot take it.
    fn tc_arms_adopt(self: &mut Self, arms: NodeList, n: u32, ty: TypeId) bool {
        for pass in 0..2 {
            for j in 0..n {
                let body = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).list(arms)[j as usize]).as_data.match_arm.body;
                let lit = self.tc_branch_lit(body);
                if lit != NODE_NONE && !self.tc_branch_adopt(body, lit, ty, pass == 0) {
                    return false;
                }
            }
        }
        return true;
    }

    fn check_expr(self: &mut Self, id: NodeId) TypeId {
        return self.check_expr_w(id, TYPE_NONE);
    }

    // Bidirectional expression check: `expected` is an explicit argument; the
    // expectation a parent grants this one child: never shared state, so a nested expectation
    // cannot leak to a sibling expression.
    fn check_expr_w(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        if id == NODE_NONE {
            return TYPE_NONE;
        }
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(id).kind;
        let addr_ctx = self.icx.addr_ctx;
        self.icx.addr_ctx = false;
        let ne0 = self.errors.errors.len();
        let nx0 = self.err_exprs;
        let mut result = TYPE_NONE;
        switch nk {
            NODE_LITERAL => {
                result = self.check_literal(id, expected);
            },
            NODE_INTERP => {
                result = self.tc_check_interp(id);
            },
            NODE_IDENTIFIER => {
                let d = unsafe (*a).resolution_def(id);
                result = self.decl_type_in(d.module, d.node);
                if d.node != NODE_NONE && unsafe (*self.mod_ast(d.module)).at_const(d.node).kind == NodeKind::NODE_FUNCTION {
                    self.tc_check_test_ref(d, unsafe (*a).at_const(id).span);
                }
                self.tc_local_const_env(id, d, result);
                self.tc_static_mut_use(id, d);
            },
            NODE_UNARY => {
                // `-(2 * 3)` and `-5` are literal-only arithmetic; a negative literal expecting Int<N> is
                // check_unary's.
                let mut wb: i64 = 0;
                let mut k: u8 = 0;
                if unsafe (*a).at_const(id).as_data.unary.op == TokenType::Minus && (expected == TYPE_NONE || self.tc_wide_target(
                    expected,
                    &mut wb,
                ) == 0) {
                    k = self.tc_lit_kind(id);
                }
                result = if k != 0 {
                    self.tc_lit_arith(id, k, expected);
                } else {
                    self.check_unary(id, expected);
                };
            },
            NODE_BINARY => {
                result = self.check_binary(id, expected);
            },
            NODE_ASSIGNMENT => {
                result = self.check_assignment(id);
            },
            NODE_CALL => {
                result = self.check_call(id, expected);
            },
            NODE_CLOSURE => {
                result = self.check_closure(id, expected);
            },
            NODE_INDEX => {
                result = self.check_index(id, addr_ctx);
            },
            NODE_MEMBER => {
                self.icx.addr_ctx = addr_ctx;
                if unsafe (*a).at_const(id).as_data.member.path {
                    result = self.check_path_member(id, expected);
                } else {
                    result = self.check_member(id, false, expected);
                    // A method has no value form: `v.m` names no bound receiver, so it must be called.
                    let mn = unsafe (*a).at_const(id).as_data.member.member;
                    let md = unsafe (*a).resolution_def(mn);
                    let mtargs = unsafe (*a).at_const(id).as_data.member.targs;
                    let mut mk = NodeKind::NODE_NONE_KIND;
                    if md.node != NODE_NONE && (md.module == self.cur_module() || md.module as usize < self.pkg_count()) {
                        mk = unsafe (*self.mod_ast(md.module)).at_const(md.node).kind;
                    }
                    if mtargs.len != 0 && !untyped(result) && mk == NodeKind::NODE_FIELD {
                        self.err_field_targs(mn, mtargs);
                        result = TYPE_ERROR;
                    } else if mk == NodeKind::NODE_FUNCTION {
                        let nsp = self.name_span(mn);
                        self.errors.emit_span(
                            nsp,
                            format(
                                "'{}' is a method, not a value: call it with '()'",
                                diag::span_str(self.source, nsp.start, nsp.end),
                            ),
                        );
                        result = TYPE_NONE;
                    }
                }
            },
            NODE_CAST => {
                let src = self.check_expr(unsafe (*a).at_const(id).as_data.cast.expression);
                let dst = self.resolve_type(unsafe (*a).at_const(id).as_data.cast.ty);
                if self.lint && src != TYPE_NONE && src == dst && unsafe (*a).at_const(
                    unsafe (*a).at_const(id).as_data.cast.expression,
                ).kind != NodeKind::NODE_LITERAL {
                    let csp = unsafe (*a).at_const(id).span;
                    self.errors.warn_span(csp, format("unnecessary cast: the expression already has this type"));
                    self.tc_cast_drop_fix(id);
                }
                if src != TYPE_NONE && dst != TYPE_NONE && self.type_at(src).kind == TypeKind::TYPE_POINTER && self.type_at(
                    dst,
                ).kind == TypeKind::TYPE_REFERENCE {
                    // Materializing a reference from a raw pointer asserts validity: unsafe territory.
                    if self.tc_needs_unsafe() {
                        let sp = unsafe (*a).at_const(id).span;
                        self.errors.emit_span(sp, format("casting a raw pointer to a reference requires 'unsafe'"));
                    }
                }
                // Forming a MUTABLE raw pointer from an IMMUTABLE reference launders the shared-borrow
                // guarantee into mutation (interior mutability). Rejected everywhere except UnsafeCell::get,
                // the one sanctioned hole: use `&mut`, or wrap the value in an `UnsafeCell`.
                if src != TYPE_NONE && dst != TYPE_NONE && self.type_at(src).kind == TypeKind::TYPE_REFERENCE && self.type_at(
                    src,
                ).qualifier != TypeQualifier::TYPE_QUAL_MUT as u8 && self.type_at(dst).kind == TypeKind::TYPE_POINTER && self.type_at(
                    dst,
                ).qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 && !self.in_unsafe_cell() {
                    let sp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(
                        sp,
                        format(
                            "cannot cast an immutable reference to a '*mut' pointer; use '&mut', or 'UnsafeCell' for interior mutability",
                        ),
                    );
                }
                // A cast whose source or target is a generic INSTANCE dispatches to a conversion: the
                // implicit path first (`from`/`widen`, so `x as u256` behaves exactly like the binding
                // it is redundant with), then the `cast_unsigned` / `cast_signed` pair, which carry C's
                // cast semantics: truncate when narrower, sign- or zero-extend per the SOURCE's
                // signedness when wider.
                // A cast to a built-in integer goes through the value's own `to_u64`/`to_i64`, and the
                // built-in cast then narrows that. Without a conversion the cast is invalid: the C a
                // struct cast would emit does not compile.
                // A cast to a dyn type is the erasure (or upcast) the coercion performs.
                let erased = src != TYPE_NONE && dst != TYPE_NONE && src != dst && self.type_at(dst).kind == TypeKind::TYPE_DYN && self.compatible_in(
                    dst,
                    unsafe (*a).at_const(id).as_data.cast.expression,
                    false,
                );
                let converted = erased || src != TYPE_NONE && dst != TYPE_NONE && src != dst && self.tc_cast_conv(
                    id,
                    unsafe (*a).at_const(id).as_data.cast.expression,
                    src,
                    dst,
                );
                if !converted && src != TYPE_NONE && dst != TYPE_NONE && src != dst {
                    let sk = self.type_at(src).kind;
                    let dk = self.type_at(dst).kind;
                    let aggregate = sk == TypeKind::TYPE_STRUCT || sk == TypeKind::TYPE_ENUM || sk == TypeKind::TYPE_FUNCTION || dk == TypeKind::TYPE_STRUCT || dk == TypeKind::TYPE_ENUM || dk == TypeKind::TYPE_FUNCTION || dk == TypeKind::TYPE_DYN;
                    let enum_int = self.is_plain_enum(src) && self.is_int(dst) || self.is_plain_enum(dst) && self.is_int(
                        src,
                    );
                    let complex_lossy = sk == TypeKind::TYPE_BUILTIN && bt_is_complex(self.type_at(src).as_data.builtin) && dk == TypeKind::TYPE_BUILTIN && !bt_is_complex(
                        self.type_at(dst).as_data.builtin,
                    );
                    // A function item casts to a function-pointer type of its signature (`f as fn() i32`).
                    let fn_ptr = sk == TypeKind::TYPE_FUNCTION && self.type_at(dst).fn_sig() && self.fn_compatible(
                        dst,
                        src,
                    );
                    if aggregate && !enum_int && !fn_ptr || complex_lossy {
                        let s = self.type_buf(src);
                        let d = self.type_buf(dst);
                        let sp = unsafe (*a).at_const(id).span;
                        self.errors.emit_span(
                            sp,
                            format("invalid cast from '{}' to '{}'", str::from_cstr(&s[0]), str::from_cstr(&d[0])),
                        );
                    }
                }
                result = dst;
            },
            NODE_SIZEOF | NODE_ALIGNOF => {
                let v = unsafe (*a).at_const(id).as_data.single.value;
                let d = unsafe (*a).resolution_def(v);
                let mut dk = NodeKind::NODE_NONE_KIND;
                if d.node != NODE_NONE && d.module == self.cur_module() {
                    dk = unsafe (*a).at_const(d.node).kind;
                }
                if dk == NodeKind::NODE_LET || dk == NodeKind::NODE_PARAMETER || dk == NodeKind::NODE_FOR || dk == NodeKind::NODE_INLINE_FOR || dk == NodeKind::NODE_IDENTIFIER || dk == NodeKind::NODE_PATTERN_NAME || dk == NodeKind::NODE_CONST {
                    let vt = unsafe (*a).type_of(d.node);
                    if vt == TYPE_NONE {
                        let vsp = unsafe (*a).at_const(v).span;
                        self.errors.emit_span(vsp, format("cannot take the size of this value here"));
                    }
                    unsafe (*self.cur_ast()).set_type(v, vt);
                } else {
                    self.resolve_type(v);
                }
                result = Ast::builtin(BuiltinType::BT_USIZE);
            },
            NODE_VA_EXPR => {
                let vo = unsafe (*a).at_const(id).as_data.va_op;
                let apt = self.check_expr(vo.ap);
                if apt != TYPE_NONE {
                    let ay = *self.type_at(apt);
                    if !(ay.kind == TypeKind::TYPE_BUILTIN && ay.as_data.builtin == BuiltinType::BT_VALIST) {
                        let sp = unsafe (*a).at_const(vo.ap).span;
                        let ty = self.type_buf(apt);
                        self.errors.emit_span(sp, format("expected a 'va_list', found '{}'", str::from_cstr(&ty[0])));
                    }
                }
                if vo.op == VA_ARG {
                    result = self.resolve_type(vo.extra);
                } else {
                    if vo.op == VA_START {
                        self.check_expr(vo.extra);
                    }
                    result = Ast::builtin(BuiltinType::BT_VOID);
                }
            },
            NODE_GENERIC_SPECIALIZATION => {
                let inner = unsafe (*a).at_const(id).as_data.specialization.expression;
                let types = unsafe (*a).at_const(id).as_data.specialization.types;
                self.tc_check_targs(unsafe (*a).resolution_def(inner), types);
                let d = unsafe (*a).resolution_def(inner);
                let mut is_agg = false;
                let mut is_alias = false;
                if d.node != NODE_NONE {
                    let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
                    is_alias = dn.kind == NodeKind::NODE_TYPE_ALIAS && dn.as_data.type_alias.generics.len > 0;
                    is_agg = is_alias || (dn.kind == NodeKind::NODE_ENUM || dn.kind == NodeKind::NODE_STRUCT) && dn.as_data.aggregate.generics.len > 0 && types.len > 0;
                }
                if is_agg && !self.tc_targ_count_ok(self.cur_module(), types, d, id) {
                    result = TYPE_ERROR;
                } else if is_agg {
                    if types.len > 8 {
                        let sp = unsafe (*a).at_const(id).span;
                        self.errors.emit_span(
                            sp,
                            format("too many generic arguments ({}; the maximum is 8)", types.len),
                        );
                    }
                    let mut ta = Tys8 {};
                    let mut tn: u8 = 0;
                    let mut j: u32 = 0;
                    while j < types.len && tn < 8 {
                        let tj = unsafe (*a).list(types)[j as usize];
                        j = j + 1;
                        if unsafe (*a).at_const(tj).kind == NodeKind::NODE_LIFETIME {
                            continue;
                        }
                        ta[tn as usize] = if self.tc_arg_is_const(self.cur_module(), tj) {
                            unsafe (*a).type_of(tj);
                        } else {
                            self.resolve_type(tj);
                        };
                        tn = tn + 1;
                    }
                    self.apply_default_args(d.module, d.node, &mut ta[0], &mut tn);
                    result = if is_alias {
                        self.tc_alias_expand(self.cur_module(), id, d, &ta[0], tn);
                    } else {
                        unsafe (*self.cur_ast()).intern_instance(d.module, d.node, &ta[0], tn);
                    };
                } else if self.tc_variant_path(inner) {
                    let en = unsafe (*a).at_const(unsafe (*a).at_const(inner).as_data.member.object).span;
                    let vn = self.name_span(unsafe (*a).at_const(inner).as_data.member.member);
                    self.err_variant_targs(unsafe (*a).at_const(id).span, en, vn);
                } else {
                    // A turbofished generic fn used as a VALUE (`f::<T>` fn pointer): record the explicit
                    // type args on this node so codegen names and emits the monomorphized instance, exactly
                    // as a call callee's MonoUse does. Without this the fn-pointer value emits the bare
                    // generic name and the C link fails.
                    let mut fsig = TYPE_NONE;
                    if d.node != NODE_NONE && types.len > 0 {
                        let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
                        if dn.kind == NodeKind::NODE_FUNCTION && dn.as_data.function.generics.len > 0 {
                            let mut ta = Tys8 {};
                            let mut tn: u8 = 0;
                            let mut j: u32 = 0;
                            while j < types.len && tn < 8 {
                                // The arguments the loop above typed.
                                let tj = unsafe (*a).list(types)[j as usize];
                                j = j + 1;
                                if unsafe (*a).at_const(tj).kind == NodeKind::NODE_LIFETIME {
                                    continue;
                                }
                                ta[tn as usize] = unsafe (*a).type_of(tj);
                                tn = tn + 1;
                            }
                            unsafe (*self.cur_ast()).set_type_args(id, &ta[0], tn);
                            if tn as u32 == dn.as_data.function.generics.len && id != self.icx.callee_node {
                                fsig = self.tc_fn_value_sig(id, d, &ta[0], tn);
                            }
                        }
                    }
                    result = self.check_expr(inner);
                    // A function value's turbofish may not name more arguments than it declares (a
                    // call's is checked with the call).
                    let vd = unsafe (*a).resolution_def(inner);
                    if id != self.icx.callee_node && !untyped(result) && vd.node != NODE_NONE && (vd.module == self.cur_module() || vd.module as usize < self.pkg_count()) && unsafe (*self.mod_ast(
                        vd.module,
                    )).at_const(vd.node).kind == NodeKind::NODE_FUNCTION && !self.tc_targ_arity_ok(vd, types) {
                        result = TYPE_ERROR;
                        fsig = TYPE_NONE;
                    }
                    if fsig != TYPE_NONE {
                        // Every type argument is given: the value is a pointer to that instance.
                        result = fsig;
                    }
                }
            },
            NODE_MATCH => {
                result = self.check_match_expr(id, expected);
            },
            NODE_NEW => {
                let init = unsafe (*a).at_const(id).as_data.new_expr.initializer;
                // `new S { .. }` infers a bare generic `S` as its literal does.
                let declared = self.resolve_type_at(
                    unsafe (*a).at_const(id).as_data.new_expr.ty,
                    init != NODE_NONE && unsafe (*a).at_const(init).kind == NodeKind::NODE_STRUCT_INITIALIZER,
                );
                let mut inner = declared;
                if init != NODE_NONE {
                    // `new S { .. }` for an expected `*mut S<..>`: the literal expects the pointee.
                    let mut iwant = TYPE_NONE;
                    if expected != TYPE_NONE && self.type_at(expected).kind == TypeKind::TYPE_POINTER {
                        iwant = self.type_at(expected).as_data.elem;
                    }
                    let it = self.check_expr_w(init, iwant);
                    if unsafe (*a).at_const(init).kind == NodeKind::NODE_STRUCT_INITIALIZER {
                        inner = it;
                    } else if !self.compatible(declared, init) {
                        self.err_mismatch(init, declared);
                    }
                }
                result = unsafe (*self.cur_ast()).intern_type(
                    Ty {
                        kind: TypeKind::TYPE_POINTER,
                        qualifier: TypeQualifier::TYPE_QUAL_MUT as u8,
                        as_data: TyAs { elem: inner },
                    },
                );
            },
            NODE_ARRAY_LITERAL => {
                result = self.check_array_literal(id, expected);
            },
            NODE_STRUCT_INITIALIZER => {
                result = self.check_struct_init(id, expected);
            },
            NODE_BLOCK => {
                result = self.check_block_value(id, expected);
            },
            NODE_WHILE => {
                self.loop_depth = self.loop_depth + 1;
                let le = self.tc_loop_push(tok::Span { start: 0, end: 0 }, id, true);
                self.check_stmt(unsafe (*a).at_const(id).as_data.while_stmt.body);
                if le >= 0 {
                    result = unsafe self.loop_stack[le as usize].break_ty;
                    self.tc_loop_pop(le, unsafe (*a).at_const(id).span);
                }
                if result == TYPE_NONE {
                    result = unsafe (*self.cur_ast()).intern_type(Ty { kind: TypeKind::TYPE_NEVER });
                }
                self.loop_depth = self.loop_depth - 1;
            },
            NODE_IF => {
                result = self.check_if_value(id, expected);
            },
            NODE_TUPLE => {
                result = self.check_tuple_value(id, expected);
            },
            NODE_RANGE => {
                // An expected Range<E> reaches the bounds, so `0..100` against Range<usize> types
                // its literals usize: the same adoption a bare literal argument gets.
                let mut want = TYPE_NONE;
                if self.prelude_instance_args_hit(expected, self.ph_range, &mut want, 1) != 1 {
                    want = TYPE_NONE;
                }
                let rs = unsafe (*a).at_const(id).as_data.pattern_range.start;
                let re = unsafe (*a).at_const(id).as_data.pattern_range.end;
                let s = self.check_expr_w(rs, want);
                let e = self.check_expr_w(re, want);
                let mut elem = self.range_type(id, s, e);
                // Literal bounds adopt the expected element type (bare literals only re-type through
                // `compatible`, so the adoption is decided here, where Range<E> is known).
                if want != TYPE_NONE && elem != TYPE_NONE && elem != want && self.compatible(want, rs) && self.compatible(
                    want,
                    re,
                ) {
                    elem = want;
                    unsafe (*self.cur_ast()).set_type(rs, want);
                    unsafe (*self.cur_ast()).set_type(re, want);
                }
                if unsafe (*a).at_const(id).as_data.pattern_range.start == NODE_NONE || unsafe (*a).at_const(id).as_data.pattern_range.end == NODE_NONE {
                    let sp = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(sp, format("a range value needs both a start and an end"));
                } else {
                    result = pick(elem != TYPE_NONE, self.prelude_range_type(elem), TYPE_NONE);
                }
            },
            _ => {},
        };
        // The reflection binder never stands alone: without a member access there is no copy for it
        // to mean, so a bare `f` (stored, returned, passed) is rejected here, where its use is.
        if nk == NodeKind::NODE_IDENTIFIER && result != TYPE_NONE && self.type_at(result).kind == TypeKind::TYPE_FIELD_PROJECTION && !self.icx.proj_obj_ok {
            let bsp2 = unsafe (*a).at_const(id).span;
            self.errors.emit_span(bsp2, format("the field binder is only used through '.name', '.index', or '.value'"));
        }
        // An expression left without a type because its check, or a sub-expression's, was rejected
        // has the error type: its users accept it silently instead of reporting the same root again.
        if result == TYPE_NONE && (self.errors.errors.len() != ne0 || self.err_exprs != nx0) {
            result = TYPE_ERROR;
        }
        if result == TYPE_ERROR {
            self.err_exprs += 1;
        }
        unsafe (*self.cur_ast()).set_type(id, result);
        return result;
    }

    // The expected type as a wide-integer target: 1 = UInt<bits>, 2 = Int<bits>, 0 = neither.
    fn tc_wide_target(self: &Self, t: TypeId, bits: &mut i64) i32 {
        let mut arg = TYPE_NONE;
        let mut kind = 0;
        if self.prelude_instance_args_hit(t, self.ph_uint, &mut arg, 1) == 1 {
            kind = 1;
        } else if self.prelude_instance_args_hit(t, self.ph_int, &mut arg, 1) == 1 {
            kind = 2;
        }
        if kind == 0 || arg == TYPE_NONE {
            return 0;
        }
        let ay = *self.type_at(arg);
        if ay.kind != TypeKind::TYPE_CONST || ay.as_data.value < 1 || ay.as_data.value > 1024 {
            // Symbolic width: nothing to validate the digits against.
            return 0;
        }
        *bits = ay.as_data.value;
        return kind;
    }

    // A literal too wide for 64 bits (or a negative one past i64), where the context expects the
    // prelude's UInt<N>/Int<N>: the digits are parsed here, validated against N, stored as the
    // STORAGE's limbs (two's-complemented for a negative), and the node typed as the target:
    // codegen then emits the limbs directly. Everything 64-bit-sized keeps the From conversions.
    // A literal's `[iu]<width>` suffix as the prelude type it names: `5i128` is Int<128>, `7u100`
    // is UInt<100>, or TYPE_NONE when the literal carries none. The builtin suffixes never reach
    // here: ast_numeric_suffix takes them first.
    fn tc_lit_wide_suffix(self: &mut Self, lr: tok::Span, sfx: &mut u32) TypeId {
        let src = self.source;
        let mut bsf = lr.end;
        if ast_numeric_suffix(src, lr.start, lr.end, &mut bsf) != BuiltinType::BT_COUNT {
            // A BUILTIN suffix (`1i64`): never a library width.
            return TYPE_NONE;
        }
        let mut i = lr.end;
        while i > lr.start && src[(i - 1) as usize] >= b'0' && src[(i - 1) as usize] <= b'9' {
            i = i - 1;
        }
        if i == lr.end || i <= lr.start + 1 {
            return TYPE_NONE;
        }
        let c = src[(i - 1) as usize];
        if c != b'i' && c != b'u' {
            return TYPE_NONE;
        }
        let mut w: i64 = 0;
        let mut j = i;
        while j < lr.end {
            w = w * 10 + (src[j as usize] - b'0') as i64;
            if w > 100000 {
                return TYPE_NONE;
            }
            j = j + 1;
        }
        if w < 1 || w > 1024 {
            return TYPE_NONE;
        }
        let hit = if c == b'i' {
            self.ph_int;
        } else {
            self.ph_uint;
        };
        if hit.node == NODE_NONE {
            return TYPE_NONE;
        }
        *sfx = i - 1;
        let arg = unsafe (*self.cur_ast()).const_value(w, BuiltinType::BT_USIZE);
        return unsafe (*self.cur_ast()).intern_instance(hit.mid, hit.node, &arg, 1);
    }

    fn tc_wide_literal(self: &mut Self, lit: NodeId, outer: NodeId, neg: bool, expected: TypeId) bool {
        return self.tc_wide_literal_at(lit, outer, neg, expected, 0, false);
    }

    fn tc_wide_literal_at(
        self: &mut Self,
        lit: NodeId,
        outer: NodeId,
        neg: bool,
        expected: TypeId,
        sfx_at: u32,
        forced: bool,
    ) bool {
        let mut bits: i64 = 0;
        let kind = self.tc_wide_target(expected, &mut bits);
        if kind == 0 {
            return false;
        }
        if neg && kind == 1 {
            // A negative literal cannot be unsigned; the ordinary diagnostic says so.
            return false;
        }
        let a = self.cur_ast();
        let lr = unsafe (*a).at_const(lit).as_data.literal.raw;
        let mut sfx = lr.end;
        if sfx_at != 0 {
            // A `[iu]<width>` suffix: the caller resolved it, the digits end here.
            sfx = sfx_at;
        } else {
            let sb = ast_numeric_suffix(self.source, lr.start, lr.end, &mut sfx);
            if sb != BuiltinType::BT_COUNT {
                // A suffix names a BUILTIN type; it cannot also mean UInt<N>.
                return false;
            }
        }
        let mut p = unsafe (self.source.ptr() + lr.start as usize);
        let mut len = (sfx - lr.start) as usize;
        let (base, skip) = lit_base_prefix(p, len);
        p = unsafe (p + skip);
        len = len - skip;
        let mut limbs: [u64; 16] = [0; 16];
        let mut nl: usize = 1; // live limbs; grows as carries land
        let mut i: usize = 0;
        let sp = unsafe (*a).at_const(outer).span;
        while i < len {
            let ch = unsafe p[i];
            i = i + 1;
            if ch == b'_' {
                continue;
            }
            let d = hex_digit(ch) as u64;
            // `limbs = limbs * base + d`, multi-precision: each limb splits so the partials stay in 64 bits.
            let mut carry = d;
            for j in 0..nl {
                let v = unsafe limbs[j];
                let lo = (v & 0xFFFFFFFFu64) * base + carry;
                let hi = (v >> 32) * base + (lo >> 32);
                unsafe limbs[j] = lo & 0xFFFFFFFFu64 | hi << 32;
                carry = hi >> 32;
            }
            if carry != 0 {
                if nl == 16 {
                    self.errors.emit_span(
                        sp,
                        format("integer literal is too large: 1024 bits is the widest a literal reaches"),
                    );
                    // Consumed: the diagnostic here beats the 64-bit one.
                    return true;
                }
                unsafe limbs[nl] = carry;
                nl = nl + 1;
            }
        }
        // The magnitude's highest set bit, for the range check.
        let mut top: i64 = 0 - 1;
        let mut j = 16;
        while j > 0 {
            j = j - 1;
            let v = unsafe limbs[j];
            if v != 0 && top < 0 {
                let mut b2: i64 = 63;
                while b2 >= 0 {
                    if (v >> b2 as u64 & 1u64) != 0 {
                        top = j as i64 * 64 + b2;
                        b2 = 0 - 1;
                    } else {
                        b2 = b2 - 1;
                    }
                }
            }
        }
        // 64-bit-sized values keep the From conversions (they fold; this table is for the rest):
        // except under a width SUFFIX, where the literal IS the type and always encodes directly.
        if !forced {
            if kind == 1 && top < 64 {
                return false;
            }
            if kind == 2 && !neg && top < 63 {
                return false;
            }
            let l0 = limbs[0];
            if kind == 2 && neg && (top < 63 || top == 63 && l0 == 0x8000000000000000u64) {
                return false;
            }
        }
        let limit = if kind == 1 {
            // Unsigned: the value needs at most `bits` bits.
            bits;
        } else if neg {
            // -2^(bits-1) is in range: its magnitude has bit (bits-1) set and nothing above.
            bits;
        } else {
            // Positive signed: at most bits-1.
            bits - 1;
        };
        let in_range = if kind == 2 && neg {
            // Magnitude <= 2^(bits-1): top bit at most bits-1, and if AT bits-1, nothing below it.
            let mut ok = top < bits;
            if ok && top == bits - 1 {
                for j2 in 0..16 {
                    let v = unsafe limbs[j2];
                    let expect: u64 = if j2 as i64 == (bits - 1) / 64 {
                        1u64 << ((bits - 1) % 64) as u64;
                    } else if j2 as i64 < (bits - 1) / 64 {
                        0u64;
                    } else {
                        0u64;
                    };
                    if j2 as i64 <= (bits - 1) / 64 && v != expect {
                        ok = false;
                    }
                }
            }
            ok;
        } else {
            top < limit;
        };
        if !in_range {
            self.errors.emit_span(sp, format("integer literal does not fit the expected type's {} bits", bits));
            return true;
        }
        if neg {
            // Two's complement at the width: invert, add one, mask the partial top limb.
            let mut carry: u64 = 1;
            for j2 in 0..16 {
                let v = ~unsafe limbs[j2];
                let sum = v.wrapping_add(carry);
                carry = if sum < v {
                    1u64;
                } else {
                    0u64;
                };
                unsafe limbs[j2] = sum;
            }
        }
        // Bits past the width do not exist: mask the top limb, zero everything above (the negative
        // fill reaches all 16 limbs otherwise).
        let nlimbs = ((bits + 63) / 64) as usize;
        for j2 in 0usize..16 {
            if j2 >= nlimbs {
                unsafe limbs[j2] = 0;
            } else if j2 + 1 == nlimbs && bits % 64 != 0 {
                unsafe limbs[j2] = unsafe limbs[j2] & (1u64 << (bits % 64) as u64) - 1;
            }
        }
        unsafe (*self.cur_ast()).wide_lits.push(WideLit { node: outer, ty: expected, limbs: limbs });
        unsafe (*self.cur_ast()).set_type(outer, expected);
        if outer != lit {
            unsafe (*self.cur_ast()).set_type(lit, expected);
        }
        return true;
    }

    fn check_literal(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let tt = unsafe (*a).at_const(id).as_data.literal.token_type;
        let lr = unsafe (*a).at_const(id).as_data.literal.raw;
        if tt == TokenType::IntegerLiteral {
            let mut sfx = lr.end;
            let sb = ast_numeric_suffix(self.source, lr.start, lr.end, &mut sfx);
            let mut result = Ast::builtin(BuiltinType::BT_I32);
            if sb != BuiltinType::BT_COUNT {
                result = Ast::builtin(sb);
            }
            if sb == BuiltinType::BT_COUNT {
                // `5i128`, `0xFFu256`: a library-width suffix IS the type; the digits encode directly.
                let mut ws: u32 = 0;
                let wt = self.tc_lit_wide_suffix(lr, &mut ws);
                if wt != TYPE_NONE {
                    if self.tc_wide_literal_at(id, id, false, wt, ws, true) {
                        return unsafe (*self.cur_ast()).type_of(id);
                    }
                    // The range diagnostic already fired; the type still stands.
                    return wt;
                }
                // The lexer admits any `[iu]<digits>` tail; one that named no type must stop HERE,
                // not surface as broken C.
                let mut k = lr.end;
                let src2 = self.source;
                while k > lr.start && src2[(k - 1) as usize] >= b'0' && src2[(k - 1) as usize] <= b'9' {
                    k = k - 1;
                }
                if k > lr.start && k < lr.end && (src2[(k - 1) as usize] == b'i' || src2[(k - 1) as usize] == b'u') && k - 1 > lr.start {
                    let sp2 = unsafe (*a).at_const(id).span;
                    self.errors.emit_span(
                        sp2,
                        format("no integer type is this literal's suffix: widths run from 1 to 1024"),
                    );
                    return result;
                }
            }
            let mut p = unsafe (self.source.ptr() + lr.start as usize);
            let mut len = (sfx - lr.start) as usize;
            let (base, skip) = lit_base_prefix(p, len);
            p = unsafe (p + skip);
            len = len - skip;
            // The lexer admits only digits of `base`, so a false result means overflow.
            let mut acc: u64 = 0;
            let overflow = !lit_digits(p, len, base, 0xFFFFFFFFFFFFFFFFu64, &mut acc);
            let sp = unsafe (*a).at_const(id).span;
            if overflow || sb == BuiltinType::BT_COUNT && acc > 0x7FFFFFFFFFFFFFFFu64 {
                // Wider than a 64-bit carrier (or past i64 with a signed wide expectation): where the
                // context expects UInt<N>/Int<N>, the literal becomes that value directly.
                if self.tc_wide_literal(id, id, false, expected) {
                    return unsafe (*self.cur_ast()).type_of(id);
                }
            }
            if overflow {
                self.errors.emit_span(sp, format("integer literal is too large to fit in a 64-bit integer"));
            } else if sb != BuiltinType::BT_COUNT && bt_int_max(sb, self.tc_ptr32()) != 0 && acc > bt_int_max(
                sb,
                self.tc_ptr32(),
            ) {
                self.errors.emit_span(sp, format("integer literal does not fit in its suffixed type"));
            } else if sb == BuiltinType::BT_COUNT && acc > 0x7FFFFFFFu64 {
                // An unsuffixed literal past i32 takes the first type that holds it, as in C.
                result = Ast::builtin(pick(acc > 0x7FFFFFFFFFFFFFFFu64, BuiltinType::BT_U64, BuiltinType::BT_I64));
            }
            return result;
        }
        if tt == TokenType::FloatLiteral {
            let mut sfx: u32 = 0;
            let sb = ast_numeric_suffix(self.source, lr.start, lr.end, &mut sfx);
            // Past the f32 range an unsuffixed literal is an f64; past its type's range it is an error.
            let mut v: f64 = 0.0;
            let known = self.tc_flit_value(id, &mut v);
            let big = known && v.abs() >= F32_LIMIT;
            let inf = known && v - v != 0.0;
            let sp = unsafe (*a).at_const(id).span;
            if sb != BuiltinType::BT_COUNT && (inf || big && sb == BuiltinType::BT_F32) {
                self.errors.emit_span(sp, format("float literal does not fit in its suffixed type"));
            } else if sb == BuiltinType::BT_COUNT && inf {
                self.errors.emit_span(sp, format("float literal is out of range for 'f64'"));
            }
            if sb == BuiltinType::BT_F64 || sb == BuiltinType::BT_COUNT && big {
                return Ast::builtin(BuiltinType::BT_F64);
            }
            return Ast::builtin(BuiltinType::BT_F32);
        }
        if tt == TokenType::CharacterLiteral {
            if tok::char_literal_value(self.source, lr).unwrap_or(0) > 0xFF {
                let sp = unsafe (*a).at_const(id).span;
                self.errors.emit_span(
                    sp,
                    format("character literal does not fit in 'char' (one byte); use a string or an integer"),
                );
            }
            return Ast::builtin(BuiltinType::BT_CHAR);
        }
        if tt == TokenType::ByteCharacterLiteral {
            return Ast::builtin(BuiltinType::BT_U8);
        }
        if tt == TokenType::True || tt == TokenType::False {
            return Ast::builtin(BuiltinType::BT_BOOL);
        }
        if tt == TokenType::StringLiteral || tt == TokenType::RawStringLiteral || tt == TokenType::MatchertextLiteral {
            return self.prelude_str_type();
        }
        if tt == TokenType::ByteStringLiteral {
            return self.prelude_slice_type(Ast::builtin(BuiltinType::BT_U8), false);
        }
        return TYPE_NONE;
    }

    // The index extent an array literal covers: positional elements advance a cursor, a designated
    // element jumps it to its (const) index + 1, C-style. -1 when a designator cannot be folded (its
    // own diagnostic already fired): callers skip length checking then. `sparse` reports whether any
    // designator appeared: a designated literal intentionally underfills (zero-fill is the feature),
    // so only excess is an error for it.
    fn tc_array_lit_extent(self: &mut Self, id: NodeId, sparse: &mut bool) i64 {
        let a = self.cur_ast();
        let elements = unsafe (*a).at_const(id).as_data.array_literal.elements;
        let mut cursor: i64 = 0;
        let mut extent: i64 = 0;
        for i in 0..elements.len {
            let eid = unsafe (*a).list(elements)[i as usize];
            let el = unsafe (*a).at_const(eid);
            let mut pos = cursor;
            if el.kind == NodeKind::NODE_FIELD_INITIALIZER {
                *sparse = true;
                let ceptr = self.cir();
                if ceptr == null {
                    return -1;
                }
                let lv = self.ev(self.cur_module(), el.as_data.field_initializer.name);
                if lv.kind != iri::IV_INT || lv.i < 0 {
                    return -1;
                }
                // Clamped so the extent stays representable: any index past u32::MAX is too large.
                pos = lv.i;
                if pos > 0xFFFFFFFFi64 {
                    pos = 0xFFFFFFFFi64;
                }
            }
            if pos + 1 > extent {
                extent = pos + 1;
            }
            cursor = pos + 1;
        }
        return extent;
    }

    // Check array literal element `eid` against the wanted element type `we` when the element takes
    // its type from the context, as a call argument does from its parameter: a generic variant
    // without type arguments, a closure, a tuple (its function items become `we`'s fn pointers),
    // and a generic fn named as a value (bound to `we`'s signature). The other elements check
    // alone; the literal reconciles their types.
    fn tc_check_elem(self: &mut Self, eid: NodeId, we: TypeId) TypeId {
        if we == TYPE_NONE {
            return self.check_expr(eid);
        }
        if self.tc_generic_fn_named(eid).node != NODE_NONE {
            let et = self.check_expr(eid);
            if et != TYPE_NONE && self.type_at(we).kind == TypeKind::TYPE_FUNCTION && self.type_at(et).kind == TypeKind::TYPE_FUNCTION && !self.fn_compatible(
                we,
                et,
            ) && self.tc_coerce_generic_fn(we, eid) {
                return we;
            }
            return et;
        }
        let ek = unsafe (*self.cur_ast()).at_const(eid).kind;
        if ek == NodeKind::NODE_CLOSURE || ek == NodeKind::NODE_TUPLE || self.tc_bare_generic_variant(eid) || self.tc_bare_generic_struct_lit(
            eid,
        ) {
            return self.check_expr_w(eid, we);
        }
        if ek == NodeKind::NODE_ARRAY_LITERAL && self.type_at(we).kind == TypeKind::TYPE_ARRAY {
            // A nested literal is stored into its slot, so it is checked against the slot type.
            if self.check_expr_w(eid, we) == TYPE_NONE {
                return TYPE_NONE;
            }
            if !self.compatible(we, eid) {
                self.err_mismatch(eid, we);
            }
            return we;
        }
        return self.check_expr(eid);
    }

    // The element type the surrounding context asked for (an array or a prelude slice), or TYPE_NONE.
    const fn wanted_elem(self: &mut Self, expected: TypeId) TypeId {
        if expected == TYPE_NONE {
            return TYPE_NONE;
        }
        let ex = *self.type_at(expected);
        if ex.kind == TypeKind::TYPE_ARRAY {
            return ex.as_data.arr.elem;
        }
        let mut se = TYPE_NONE;
        let _ = self.slice_kind(expected, &mut se);
        return se;
    }

    // Would every element convert cleanly to `we`? Probing, so nothing is recorded and nothing is reported
    // for the elements that would not: the caller keeps its own inferred type and diagnoses from there.
    fn elements_fit(self: &mut Self, elements: NodeList, we: TypeId) bool {
        for i in 0..elements.len {
            let eid = unsafe (*self.cur_ast()).list(elements)[i as usize];
            let el = unsafe (*self.cur_ast()).at_const(eid);
            let vid = if el.kind == NodeKind::NODE_FIELD_INITIALIZER {
                el.as_data.field_initializer.value;
            } else {
                eid;
            };
            if !self.compatible_in(we, vid, true) {
                return false;
            }
        }
        return true;
    }

    fn check_array_literal(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        self.eng_hold(true);
        let r9 = self.check_array_literal_i(id, expected);
        self.eng_hold(false);
        return r9;
    }

    fn check_array_literal_i(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let elements = unsafe (*a).at_const(id).as_data.array_literal.elements;
        if unsafe (*a).at_const(id).as_data.array_literal.repeat {
            return self.check_array_repeat(elements, expected);
        }
        if elements.len == 0 {
            // `[]` carries no element type of its own: take it from the context (an array or a
            // slice), which is the only place a zero-length array can come from.
            let ee = self.wanted_elem(expected);
            if ee != TYPE_NONE {
                return unsafe (*self.cur_ast()).intern_type(
                    Ty { kind: TypeKind::TYPE_ARRAY, as_data: TyAs { arr: TyArr { elem: ee, len: 0 } } },
                );
            }
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("cannot infer the element type of an empty array literal"));
            return TYPE_NONE;
        }
        let mut elem = TYPE_NONE;
        let mut mis = NODE_NONE; // first cross-element mismatch, deferred until the context has spoken
        let mut mis_t = TYPE_NONE;
        let we = self.wanted_elem(expected);
        for i in 0..elements.len {
            let eid = unsafe (*a).list(elements)[i as usize];
            let el = unsafe (*a).at_const(eid);
            let mut et = TYPE_NONE;
            if el.kind == NodeKind::NODE_FIELD_INITIALIZER {
                let it = self.check_expr(el.as_data.field_initializer.name);
                if !untyped(it) {
                    let iy = *self.type_at(it);
                    if !(iy.kind == TypeKind::TYPE_BUILTIN && (bt_is_int(iy.as_data.builtin) || iy.as_data.builtin == BuiltinType::BT_CHAR)) {
                        let sp = unsafe (*a).at_const(el.as_data.field_initializer.name).span;
                        self.errors.emit_span(sp, format("array designator index must be an integer"));
                    } else {
                        let ceptr = self.cir();
                        self.ev_err = false;
                        if ceptr != null && self.ev(self.cur_module(), el.as_data.field_initializer.name).kind == iri::IV_NONE && !self.ev_err {
                            let sp = unsafe (*a).at_const(el.as_data.field_initializer.name).span;
                            if unsafe (*ceptr).trap_get().len() != 0 {
                                self.errors.emit_span(
                                    sp,
                                    format(
                                        "array designator index must be a constant expression: {}",
                                        unsafe (*ceptr).trap_detail(),
                                    ),
                                );
                            } else {
                                self.errors.emit_span(
                                    sp,
                                    format("array designator index must be a constant expression"),
                                );
                            }
                        }
                    }
                }
                et = self.tc_check_elem(el.as_data.field_initializer.value, we);
            } else {
                et = self.tc_check_elem(eid, we);
            }
            // An untyped element (`null`) takes the type of the others or of the context.
            if elem == TYPE_NONE {
                elem = et;
            } else if et != elem && et != TYPE_NONE {
                let e0 = self.type_at(elem).kind;
                let ei = self.type_at(et).kind;
                if !(e0 == TypeKind::TYPE_FUNCTION && ei == TypeKind::TYPE_FUNCTION && self.fn_compatible(elem, et)) && mis == NODE_NONE {
                    // Deferred, not emitted: the context (or the first element's type) may still absorb
                    // the difference below, exactly as it absorbs `let x: u64 = 1`.
                    mis = eid;
                    mis_t = et;
                }
            }
        }
        if elem == TYPE_NONE && we != TYPE_NONE && self.elements_fit(elements, we) {
            elem = we;
        }
        if elem == TYPE_NONE && self.tc_all_null(elements) {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(
                sp,
                format("cannot infer the element type of an array literal of 'null'; annotate the pointer type"),
            );
            return TYPE_NONE;
        }
        if elem != TYPE_NONE {
            // The context may want a WIDER element than the elements gave themselves. An integer literal is
            // i32 on its own, so `let a: [i64; 4] = [3, 0, 0, 7]` was rejected over a difference the same
            // lossless widening already smooths away for a scalar `let x: i64 = 3`. Adopt the wanted element
            // type when every element converts to it cleanly: also when elements DISAGREE among
            // themselves (`[0u64, 1, 2]`), where the wanted type (or, absent one, the first element's)
            // settles what each literal means. Otherwise leave the inferred type so the mismatch is
            // reported against what was written.
            if we != TYPE_NONE && (we != elem || mis != NODE_NONE) && self.elements_fit(elements, we) {
                elem = we;
                mis = NODE_NONE;
                self.tc_retype_array_elems(elements, we);
                self.tc_view_array_elems(elements, we);
            } else if mis != NODE_NONE && we == TYPE_NONE && self.elements_fit(elements, elem) {
                mis = NODE_NONE;
                self.tc_retype_array_elems(elements, elem);
            }
            if mis != NODE_NONE {
                let ey = *self.type_at(elem);
                let my = *self.type_at(mis_t);
                if ey.kind == TypeKind::TYPE_ARRAY && my.kind == TypeKind::TYPE_ARRAY && !ey.arr_sym() && !my.arr_sym() && ey.as_data.arr.len != my.as_data.arr.len {
                    // An array of arrays stores its elements inline, so they must all have one length.
                    self.errors.emit_span(
                        unsafe (*a).at_const(mis).span,
                        format(
                            "array literal element has length {}, but the first element has length {}",
                            my.as_data.arr.len,
                            ey.as_data.arr.len,
                        ),
                    );
                } else {
                    self.err_mismatch(mis, elem);
                }
                return TYPE_NONE;
            }
            let mut sparse = false;
            let ext = self.tc_array_lit_extent(id, &mut sparse);
            if ext > 0xFFFFFFFFi64 {
                self.errors.emit_span(
                    unsafe (*a).at_const(id).span,
                    format("array literal extent exceeds the maximum array length 4294967295"),
                );
                return TYPE_NONE;
            }
            if ext < 0 {
                return TYPE_NONE;
            }
            return unsafe (*self.cur_ast()).intern_type(
                Ty { kind: TypeKind::TYPE_ARRAY, as_data: TyAs { arr: TyArr { elem: elem, len: ext as u32 } } },
            );
        }
        return TYPE_NONE;
    }

    // Whether every element of an array literal is the untyped `null`.
    fn tc_all_null(self: &Self, elements: NodeList) bool {
        for i in 0..elements.len {
            let mut v = unsafe (*self.cur_ast()).list(elements)[i as usize];
            if unsafe (*self.cur_ast()).at_const(v).kind == NodeKind::NODE_FIELD_INITIALIZER {
                v = unsafe (*self.cur_ast()).at_const(v).as_data.field_initializer.value;
            }
            let n = unsafe (*self.cur_ast()).at_const(v);
            if n.kind != NodeKind::NODE_LITERAL || n.as_data.literal.token_type != TokenType::Null {
                return false;
            }
        }
        return true;
    }

    // Record the slice coercion of every array element adopted into slice element type `we`
    // (`[x, y]` as `[[]u8; 2]`): lowering builds each view from the element's recorded type.
    fn tc_view_array_elems(self: &mut Self, elements: NodeList, we: TypeId) {
        let mut se = TYPE_NONE;
        if self.slice_kind(we, &mut se) == 0 {
            return;
        }
        for i in 0..elements.len {
            let mut v = unsafe (*self.cur_ast()).list(elements)[i as usize];
            if unsafe (*self.cur_ast()).at_const(v).kind == NodeKind::NODE_FIELD_INITIALIZER {
                v = unsafe (*self.cur_ast()).at_const(v).as_data.field_initializer.value;
            }
            let vt = unsafe (*self.cur_ast()).type_of(v);
            if vt != TYPE_NONE && self.type_at(vt).kind == TypeKind::TYPE_ARRAY {
                let _ = self.compatible(we, v);
            }
        }
    }

    // Give every element that is itself a (non-repeat) array literal the adopted element type
    // `we`, at every depth: a nested literal is stored into its slot, so it must have the slot's
    // length (a designated inner literal zero-fills the rest of it).
    fn tc_retype_array_elems(self: &mut Self, elements: NodeList, we: TypeId) {
        let wy = *self.type_at(we);
        if wy.kind != TypeKind::TYPE_ARRAY {
            return;
        }
        for i in 0..elements.len {
            let mut v = unsafe (*self.cur_ast()).list(elements)[i as usize];
            if unsafe (*self.cur_ast()).at_const(v).kind == NodeKind::NODE_FIELD_INITIALIZER {
                v = unsafe (*self.cur_ast()).at_const(v).as_data.field_initializer.value;
            }
            let vn = unsafe (*self.cur_ast()).at_const(v);
            if vn.kind == NodeKind::NODE_ARRAY_LITERAL && !vn.as_data.array_literal.repeat {
                unsafe (*self.cur_ast()).set_type(v, we);
                self.tc_retype_array_elems(vn.as_data.array_literal.elements, wy.as_data.arr.elem);
            }
        }
    }

    // `[v; N]`: one value and a count. The count must be a constant (the length is part of the type) so
    // it is folded here, with the same const-eval every other array length goes through.
    fn check_array_repeat(self: &mut Self, elements: NodeList, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let vid = unsafe (*a).list(elements)[0];
        let nid = unsafe (*a).list(elements)[1];
        let mut elem = self.check_expr(vid);
        let we = self.wanted_elem(expected); // same widening as the element-list form above
        if we != TYPE_NONE && we != elem && elem != TYPE_NONE && self.compatible_in(we, vid, true) {
            if self.type_at(elem).kind == TypeKind::TYPE_ARRAY {
                let _ = self.compatible(we, vid); // record the slice coercion, as for element lists
            }
            elem = we;
        }
        let cnt = self.check_expr(nid);
        let sp = unsafe (*a).at_const(nid).span;
        if cnt == TYPE_ERROR {
            return TYPE_ERROR;
        }
        if cnt != TYPE_NONE {
            let cy = *self.type_at(cnt);
            if !(cy.kind == TypeKind::TYPE_BUILTIN && bt_is_int(cy.as_data.builtin)) {
                self.errors.emit_span(sp, format("an array repeat count must be an integer"));
                return TYPE_NONE;
            }
        }
        let ceptr = self.cir();
        let mut n: i64 = -1;
        let mut slen = TYPE_NONE;
        if ceptr != null {
            self.ev_err = false;
            let cv = self.ev(self.cur_module(), nid);
            if self.ev_err {
                return TYPE_ERROR;
            }
            if cv.kind == iri::IV_INT {
                n = cv.i;
            } else if cv.kind == iri::IV_NONE {
                // A count over the enclosing generic's const parameters: every instance folds it.
                slen = self.tc_sym_len(self.cur_module(), nid);
                if self.lin_err {
                    return TYPE_NONE;
                }
            }
        }
        if n < 0 && slen == TYPE_NONE {
            self.errors.emit_span(sp, format("an array repeat count must be a constant expression"));
            return TYPE_NONE;
        }
        if n > 0xFFFFFFFFi64 {
            self.errors.emit_span(
                sp,
                format("an array repeat count of {} exceeds the maximum array length 4294967295", n),
            );
            return TYPE_NONE;
        }
        if elem == TYPE_NONE {
            return TYPE_NONE;
        }
        // Every slot holds its own copy: a `Free` value cannot be copied into more than one owner, and
        // a `&mut` cannot alias. A symbolic count may exceed one in some instance.
        if (n > 1 || slen != TYPE_NONE) && !self.tc_copy_marker(elem, 0) {
            let vsp = unsafe (*a).at_const(vid).span;
            if self.tc_type_is_free(elem) {
                self.errors.emit_span(
                    vsp,
                    format("an array repeat needs a value that can be copied; this one owns resources"),
                );
            } else {
                let tb = self.type_buf(elem);
                self.errors.emit_span(
                    vsp,
                    format(
                        "an array repeat needs a value that can be copied; '{}' is not 'Copy'",
                        str::from_cstr(&tb[0]),
                    ),
                );
            }
            return TYPE_NONE;
        }
        if slen != TYPE_NONE {
            return unsafe (*self.cur_ast()).intern_array(elem, slen);
        }
        return unsafe (*self.cur_ast()).intern_type(
            Ty { kind: TypeKind::TYPE_ARRAY, as_data: TyAs { arr: TyArr { elem: elem, len: n as u32 } } },
        );
    }

    // Adapt a branch/arm/block-tail LITERAL to the expected type. Literal adaptation is the one
    // implicit conversion that is position-sensitive (it must run ON the literal node) so the
    // expected type is pushed into value-position branches and applied here; every other conversion
    // keeps working on the merged value at the outer coercion site, unchanged.
    fn tc_tail_adapt(self: &mut Self, expected: TypeId, lv: NodeId) {
        if expected == TYPE_NONE || lv == NODE_NONE {
            return;
        }
        let a = self.cur_ast();
        let mut vid = lv;
        let v0 = unsafe (*a).at_const(lv);
        if v0.kind == NodeKind::NODE_UNARY && v0.as_data.unary.op == TokenType::Minus {
            vid = v0.as_data.unary.operand;
        }
        if unsafe (*a).at_const(vid).kind != NodeKind::NODE_LITERAL {
            // A non-literal tail needs no adaptation, but a cast tail that now matches the context
            // type exactly is the redundant-cast lint's business (arms/tails see expected now).
            if self.lint && unsafe (*a).valid(lv) && unsafe (*a).type_of(lv) == expected {
                self.tc_lint_redundant_coalesce(expected, lv);
            }
            return;
        }
        let _ = self.compatible(expected, lv); // the literal path adapts + range-checks in place
    }

    fn check_block_value(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let stmts = unsafe (*a).at_const(id).as_data.block.statements;
        for i in 0..stmts.len {
            let sid = unsafe (*a).list(stmts)[i as usize];
            if expected != TYPE_NONE && i == stmts.len - 1 && unsafe (*a).at_const(sid).kind == NodeKind::NODE_EXPRESSION_STATEMENT {
                // The tail is this block's value: it sees the context type directly.
                let _bt = self.check_expr_w(unsafe (*a).at_const(sid).as_data.single.value, expected);
            } else {
                self.check_stmt(sid);
            }
        }
        if stmts.len > 0 {
            let lastid = unsafe (*a).list(stmts)[(stmts.len - 1) as usize];
            let last = unsafe (*a).at_const(lastid);
            let lv = pick(last.kind == NodeKind::NODE_EXPRESSION_STATEMENT, last.as_data.single.value, NODE_NONE);
            if lv != NODE_NONE && unsafe (*a).at_const(lv).kind != NodeKind::NODE_ASSIGNMENT {
                self.tc_tail_adapt(expected, lv);
                return unsafe (*a).type_of(lv);
            }
            // A block that ends in `return`, `break`, `continue` or a diverging call yields no value.
            if self.stmt_diverges(lastid, 0) {
                return unsafe (*self.cur_ast()).intern_type(Ty { kind: TypeKind::TYPE_NEVER });
            }
            return Ast::builtin(BuiltinType::BT_VOID);
        }
        return Ast::builtin(BuiltinType::BT_VOID);
    }

    fn check_if_value(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let ifd = unsafe (*a).at_const(id).as_data.if_stmt;
        self.check_cond(ifd.condition, "if");
        self.lint_const_cond(id, ifd.condition, false, false);
        let then_ty = self.check_expr_w(ifd.then_branch, expected);
        if ifd.else_branch == NODE_NONE {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("an 'if' used as a value must have an 'else' branch"));
            return TYPE_NONE;
        }
        let else_ty = self.check_expr_w(ifd.else_branch, expected);
        let then_never = then_ty != TYPE_NONE && self.type_at(then_ty).kind == TypeKind::TYPE_NEVER;
        let else_never = else_ty != TYPE_NONE && self.type_at(else_ty).kind == TypeKind::TYPE_NEVER;
        if then_never || else_never {
            return pick(then_never, else_ty, then_ty);
        }
        if expected != TYPE_NONE {
            // A context type is known: each branch coerces to IT (widening, adaptation, the works)
            // instead of having to equal the other branch exactly.
            if then_ty != TYPE_NONE && !self.compatible(expected, ifd.then_branch) {
                self.err_mismatch(ifd.then_branch, expected);
            }
            if else_ty != TYPE_NONE && !self.compatible(expected, ifd.else_branch) {
                self.err_mismatch(ifd.else_branch, expected);
            }
            return expected;
        }
        if then_ty != else_ty && then_ty != TYPE_NONE && else_ty != TYPE_NONE {
            // Without a context type an unpinned literal branch takes the other branch's type.
            let elit = self.tc_branch_lit(ifd.else_branch);
            if elit != NODE_NONE && self.tc_branch_adopt(ifd.else_branch, elit, then_ty, false) {
                return then_ty;
            }
            let tlit = self.tc_branch_lit(ifd.then_branch);
            if tlit != NODE_NONE && self.tc_branch_adopt(ifd.then_branch, tlit, else_ty, false) {
                return else_ty;
            }
            self.err_mismatch(ifd.else_branch, then_ty);
            return TYPE_NONE;
        }
        return then_ty;
    }

    fn check_tuple_value(self: &mut Self, id: NodeId, expected: TypeId) TypeId {
        let a = self.cur_ast();
        let elems = unsafe (*a).at_const(id).as_data.array_literal.elements;
        if elems.len > 4 {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("tuple arity is limited to 4 elements"));
            return TYPE_NONE;
        }
        let mut wargs = Tys8 {};
        let mut wn: i32 = -1;
        if expected != TYPE_NONE {
            wn = self.tuple_args_of(self.strip(expected), &mut wargs[0], 4);
        }
        let mut targs = Tys8 {};
        for i in 0..elems.len {
            let eid = unsafe (*a).list(elems)[i as usize];
            let et = self.check_expr(eid);
            targs[i as usize] = et;
            if i as i32 < wn && et != wargs[i as usize] && self.compatible(wargs[i as usize], eid) {
                targs[i as usize] = wargs[i as usize];
                unsafe (*self.cur_ast()).set_type(eid, wargs[i as usize]);
            }
        }
        return self.prelude_tuple_type(&targs[0], elems.len);
    }

    fn check_tuple_let(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let value = unsafe (*a).at_const(id).as_data.let_stmt.value;
        let nm = unsafe (*a).at_const(id).as_data.let_stmt.name;
        let names = unsafe (*a).at_const(nm).as_data.pattern.children;
        self.icx.mret_call = NODE_NONE;
        let vt = self.check_expr(value);
        let stashed = value != NODE_NONE && self.icx.mret_call == value;
        if vt == TYPE_ERROR && !stashed {
            for i in 0..names.len {
                unsafe (*self.cur_ast()).set_type(unsafe (*self.cur_ast()).list(names)[i as usize], TYPE_ERROR);
            }
            return;
        }
        let mut targs = Tys8 {};
        let mut tn: i32 = -1;
        if !stashed && value != NODE_NONE {
            tn = self.tuple_args_of(self.strip(unsafe (*a).type_of(value)), &mut targs[0], 4);
        }
        let mut returns = NodeList { start: 0, len: 0 };
        let mut ok = false;
        if value != NODE_NONE && unsafe (*a).at_const(value).kind == NodeKind::NODE_CALL {
            let calleeId = unsafe (*a).at_const(value).as_data.call.callee;
            let callee = unsafe (*a).type_of(calleeId);
            if callee != TYPE_NONE {
                let ct = *self.type_at(callee);
                if ct.kind == TypeKind::TYPE_FUNCTION {
                    // A closure's or a function pointer's results come from the call's stash.
                    let fnn = unsafe (*self.mod_ast(ct.module)).at_const(ct.as_data.decl);
                    if fnn.kind == NodeKind::NODE_FUNCTION {
                        returns = fnn.as_data.function.returns;
                    }
                    ok = true;
                }
            } else {
                let cn = unsafe (*a).at_const(calleeId);
                if cn.kind == NodeKind::NODE_MEMBER {
                    let md = unsafe (*a).resolution_def(cn.as_data.member.member);
                    if md.node != NODE_NONE && md.module == self.cur_module() && unsafe (*self.mod_ast(md.module)).at_const(
                        md.node,
                    ).kind == NodeKind::NODE_FUNCTION {
                        returns = unsafe (*self.mod_ast(md.module)).at_const(md.node).as_data.function.returns;
                        ok = true;
                    }
                }
            }
        }
        if !ok && !stashed && tn < 0 {
            let sp = unsafe (*a).at_const(id).span;
            self.errors.emit_span(sp, format("a tuple binding requires a multi-value function call or a tuple value"));
            return;
        }
        let nret = pick(stashed, self.icx.mret_total, pick(tn >= 0, tn as u32, returns.len));
        if names.len != nret {
            let sp = unsafe (*a).at_const(id).span;
            let s1 = plural(names.len);
            let s2 = plural(nret);
            self.errors.emit_span(
                sp,
                format(
                    "expected {} binding{}, the call returns {} value{}",
                    names.len,
                    str::from_cstr(s1),
                    nret,
                    str::from_cstr(s2),
                ),
            );
        }
        for i in 0..names.len {
            let mut et = TYPE_NONE;
            if stashed && i < self.icx.mret_n as u32 {
                et = unsafe self.icx.mret_types[i as usize];
            } else if tn >= 0 {
                et = pick(i < tn as u32, targs[i as usize], TYPE_NONE);
            } else if i < returns.len {
                let r0 = unsafe (*self.cur_ast()).list(returns)[i as usize];
                et = self.resolve_type(unsafe (*self.cur_ast()).slot_type_node(r0));
            }
            unsafe (*self.cur_ast()).set_type(unsafe (*self.cur_ast()).list(names)[i as usize], et);
        }
    }

    fn check_return(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let values = unsafe (*a).at_const(id).as_data.return_stmt.values;
        let rets = self.icx.current_returns;
        let returns_void = self.return_list_is_explicit_void(rets);
        let mut rvwant = TYPE_NONE;
        if values.len == 1 && !returns_void && rets.len == 1 {
            let r0 = unsafe (*a).list(rets)[0];
            rvwant = self.resolve_type(unsafe (*a).slot_type_node(r0));
        }
        for i in 0..values.len {
            let vid = unsafe (*a).list(values)[i as usize];
            self.check_expr_w(vid, rvwant);
        }
        let expected = pick(returns_void, 0, rets.len);
        if values.len != expected {
            let sp = unsafe (*a).at_const(id).span;
            let s2 = plural(expected);
            self.errors.emit_span(
                sp,
                format("expected {} return value{}, found {}", expected, str::from_cstr(s2), values.len),
            );
            return;
        }
        if returns_void {
            return;
        }
        for i in 0..values.len {
            let vid = unsafe (*a).list(values)[i as usize];
            let r0 = unsafe (*a).list(rets)[i as usize];
            let rt = self.resolve_type(unsafe (*a).slot_type_node(r0));
            if !self.compatible(rt, vid) {
                self.err_mismatch(vid, rt);
            }
        }
    }

    // Does the expression contain a call? A call-bearing const initializer requires execution to
    // have a value, so its aggregate must also capture as static data at compile time.
    fn expr_has_call(self: &Self, id: NodeId, depth: u32) bool {
        if id == NODE_NONE || depth > 64 {
            return depth > 64;
        }
        let a = self.cur_ast();
        let n = unsafe (*a).at_const(id);
        switch n.kind {
            NODE_CALL => {
                return true;
            },
            NODE_UNARY => {
                return self.expr_has_call(n.as_data.unary.operand, depth + 1);
            },
            NODE_BINARY | NODE_ASSIGNMENT => {
                return self.expr_has_call(n.as_data.binary.left, depth + 1) || self.expr_has_call(
                    n.as_data.binary.right,
                    depth + 1,
                );
            },
            NODE_CAST => {
                return self.expr_has_call(n.as_data.cast.expression, depth + 1);
            },
            NODE_MEMBER => {
                if n.as_data.member.path {
                    return false;
                }
                return self.expr_has_call(n.as_data.member.object, depth + 1);
            },
            NODE_INDEX => {
                return self.expr_has_call(n.as_data.index.object, depth + 1) || self.expr_has_call(
                    n.as_data.index.index,
                    depth + 1,
                );
            },
            NODE_STRUCT_INITIALIZER => {
                let fields = n.as_data.struct_initializer.fields;
                for i in 0..fields.len {
                    let fid = unsafe (*a).list(fields)[i as usize];
                    if unsafe (*a).at_const(fid).kind == NodeKind::NODE_FIELD_INITIALIZER && self.expr_has_call(
                        unsafe (*a).at_const(fid).as_data.field_initializer.value,
                        depth + 1,
                    ) {
                        return true;
                    }
                }
                return false;
            },
            NODE_ARRAY_LITERAL | NODE_TUPLE => {
                let elements = n.as_data.array_literal.elements;
                for i in 0..elements.len {
                    if self.expr_has_call(unsafe (*a).list(elements)[i as usize], depth + 1) {
                        return true;
                    }
                }
                return false;
            },
            NODE_IF | NODE_MATCH | NODE_BLOCK => {
                // Requires execution, like a call.
                return true;
            },
            _ => {},
        };
        return false;
    }

    // Mandatory evaluation of a const initializer: failure with a trap is an error, undecidable in
    // module order defers to flush_consts (mirrors check_static_assert).
    fn tc_mandatory_const(self: &mut Self, id: NodeId, value: NodeId) {
        self.eng_hold(true);
        self.tc_mandatory_const_i(id, value);
        self.eng_hold(false);
    }

    fn tc_mandatory_const_i(self: &mut Self, id: NodeId, value: NodeId) {
        let ceptr = self.cir();
        if ceptr == null {
            return;
        }
        let m = self.cur_module();
        self.ev_err = false;
        let v = self.ev(m, value);
        if v.kind != iri::IV_NONE || self.ev_err {
            return;
        }
        // a call-free aggregate folded (its static capture is the emission's); a call-bearing one
        // must also capture
        let calls = self.expr_has_call(value, 0);
        if unsafe (*ceptr).trap_get().len() == 0 && (!calls && unsafe (*ceptr).folded_agg(m, value) || self.ev_static(
            m,
            value,
        ).ok) {
            return;
        }
        // a call-free initializer reports a trap of a referenced constant there, unless it is a cycle
        // this constant takes part in or depends on
        let tk = unsafe (*ceptr).trap_kind_get();
        if !calls && tk != iri::IT_TRAP_NONE && tk != iri::IT_TRAP_CYCLE && unsafe (*ceptr).trap_in_item() {
            return;
        }
        if unsafe (*ceptr).trap_get().len() != 0 {
            let cd = unsafe (*self.cur_ast()).at_const(id).as_data.const_def;
            let sp = self.name_span(cd.name);
            self.errors.emit_span(
                sp,
                format(
                    "constant '{}' cannot be evaluated at compile time: {}",
                    diag::span_str(self.source, sp.start, sp.end),
                    unsafe (*ceptr).trap_detail(),
                ),
            );
        } else {
            unsafe (*ceptr).defer_const(m, id);
        }
    }

    // An explicit enum discriminant must fold: the C tag and every cast and switch take its value.
    fn tc_discriminant(self: &mut Self, value: NodeId) {
        let ceptr = self.cir();
        if ceptr == null {
            return;
        }
        self.eng_hold(true);
        self.ev_err = false;
        let v = self.ev(self.cur_module(), value);
        if v.kind != iri::IV_INT && !self.ev_err {
            let sp = unsafe (*self.cur_ast()).at_const(value).span;
            let why = if unsafe (*ceptr).trap_get().len() != 0 {
                unsafe (*ceptr).trap_detail();
            } else {
                "it does not fold to a constant";
            };
            self.errors.emit_span(sp, format("enum discriminant cannot be evaluated at compile time: {}", why));
        }
        self.eng_hold(false);
    }

    // Every discriminant of enum `id` must be a distinct value in the i32 range of a C enum
    // constant: the tag, every tag test and every switch case take it. An extern enum is C's own
    // (a C header may alias values), and an enum with no explicit value numbers 0, 1, 2, ..
    fn tc_enum_tags(self: &mut Self, id: NodeId) {
        let ceptr = self.cir();
        let a = self.cur_ast();
        let agg = unsafe (*a).at_const(id).as_data.aggregate;
        if ceptr == null || agg.is_extern {
            return;
        }
        let ms = agg.members;
        let mut any = false;
        for i in 0..ms.len {
            any = any || unsafe (*a).at_const(unsafe (*a).list(ms)[i as usize]).as_data.variant.value != NODE_NONE;
        }
        if !any {
            return;
        }
        let m = self.cur_module();
        let mut seen = Map::<i64, NodeId>::new();
        let mut cur: i64 = 0 - 1;
        self.eng_hold(true);
        for i in 0..ms.len {
            let vid = unsafe (*a).list(ms)[i as usize];
            if !unsafe (*ceptr).discr(m, vid, cur, &mut cur) {
                break; // `tc_discriminant` reported the value
            }
            let nsp = unsafe (*a).at_const(unsafe (*a).at_const(vid).as_data.variant.name).span;
            if cur < -2147483648 || cur > 2147483647 {
                self.errors.emit_span(
                    nsp,
                    format("enum discriminant {} is outside the i32 range of a C enum constant", cur),
                );
                break;
            }
            switch seen.get(&cur) {
                Some(prev) => {
                    let psp = unsafe (*a).at_const(unsafe (*a).at_const(*prev).as_data.variant.name).span;
                    self.errors.emit_span(
                        nsp,
                        format(
                            "duplicate enum discriminant {}: variant '{}' already has it",
                            cur,
                            diag::span_str(self.source, psp.start, psp.end),
                        ),
                    );
                },
                None => {
                    seen.insert(cur, vid);
                },
            };
        }
        self.eng_hold(false);
    }

    // `asm(..)` hands a template straight to the C compiler, so the checker owns the SHAPE, not the
    // contents: the template and every constraint must be string literals, an output must be assignable
    // (the assembly writes it), and the whole statement needs `unsafe`: nothing here can know what the
    // instructions do.
    fn tc_check_asm(self: &mut Self, id: NodeId) {
        let d = unsafe (*self.cur_ast()).at_const(id).as_data.asm_stmt;
        let sp = unsafe (*self.cur_ast()).at_const(id).span;
        if self.tc_needs_unsafe() {
            self.err_unsafe(sp, "inline assembly");
        }
        self.tc_asm_literal(d.template, "an asm template");
        let mut i: u32 = 0;
        while i < d.outputs.len {
            let c = unsafe (*self.cur_ast()).list(d.outputs)[i as usize];
            self.tc_asm_literal(c, "an asm constraint");
            if i + 1 < d.outputs.len {
                let e = unsafe (*self.cur_ast()).list(d.outputs)[(i + 1) as usize];
                self.check_expr(e);
                if !self.is_assignable(e) {
                    let esp = unsafe (*self.cur_ast()).at_const(e).span;
                    self.errors.emit_span(
                        esp,
                        format("an asm output must be an assignable place (the assembly writes it)"),
                    );
                }
            }
            i = i + 2;
        }
        i = 0;
        while i < d.inputs.len {
            let c = unsafe (*self.cur_ast()).list(d.inputs)[i as usize];
            self.tc_asm_literal(c, "an asm constraint");
            if i + 1 < d.inputs.len {
                self.check_expr(unsafe (*self.cur_ast()).list(d.inputs)[(i + 1) as usize]);
            }
            i = i + 2;
        }
        for k in 0..d.clobbers.len {
            self.tc_asm_literal(unsafe (*self.cur_ast()).list(d.clobbers)[k as usize], "an asm clobber");
        }
    }

    fn tc_asm_literal(self: &mut Self, e: NodeId, what: str) {
        if e == NODE_NONE {
            return;
        }
        self.check_expr(e);
        let n = unsafe (*self.cur_ast()).at_const(e);
        let lit = n.kind == NodeKind::NODE_LITERAL && (n.as_data.literal.token_type == TokenType::StringLiteral || n.as_data.literal.token_type == TokenType::MatchertextLiteral);
        if !lit {
            let sp = n.span;
            self.errors.emit_span(sp, format("{} must be a string literal", what));
        }
    }

    fn check_static_assert(self: &mut Self, id: NodeId) {
        self.eng_hold(true);
        self.check_static_assert_i(id);
        self.eng_hold(false);
    }

    fn check_static_assert_i(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let left = unsafe (*a).at_const(id).as_data.binary.left;
        if !self.check_cond(left, "static_assert") {
            return;
        }
        let sp = unsafe (*a).at_const(left).span;
        let ceptr = self.cir();
        if ceptr == null {
            return;
        }
        self.ev_err = false;
        let v = self.ev(self.cur_module(), left);
        if v.kind == iri::IV_BOOL && v.i == 0 {
            self.errors.emit_span(sp, format("static assertion failed"));
        } else if v.kind == iri::IV_NONE && !self.ev_err {
            let trap = unsafe (*ceptr).trap_get();
            if trap.len() != 0 {
                self.errors.emit_span(
                    sp,
                    format("static assertion cannot be evaluated: {}", unsafe (*ceptr).trap_detail()),
                );
            } else {
                unsafe (*ceptr).defer_assert(self.cur_module(), left);
            }
        }
    }

    // The loop statement kinds live in their own frames so check_stmt, which recurses once per
    // nested statement, keeps a small frame. @c.noinline keeps LTO from folding them back.
    @c.noinline
    fn tc_check_while(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        self.loop_depth = self.loop_depth + 1;
        let le = self.tc_loop_push(unsafe (*a).at_const(id).as_data.while_stmt.label, id, false);
        self.check_cond(unsafe (*a).at_const(id).as_data.while_stmt.condition, "while");
        self.lint_const_cond(id, unsafe (*a).at_const(id).as_data.while_stmt.condition, true, true);
        let body = unsafe (*a).at_const(id).as_data.while_stmt.body;
        self.check_stmt(body);
        if le >= 0 {
            // A `loop` no `break` leaves is a statement of type `!`: the statement after it is
            // unreachable (`stmt_diverges`).
            let e = unsafe self.loop_stack[le as usize];
            if self.lint && unsafe (*a).at_const(id).as_data.while_stmt.condition == NODE_NONE && !e.saw_bare && !e.saw_value {
                let never = unsafe (*self.cur_ast()).intern_type(Ty { kind: TypeKind::TYPE_NEVER });
                unsafe (*self.cur_ast()).set_type(id, never);
            }
            self.tc_loop_pop(le, unsafe (*self.cur_ast()).at_const(id).span);
        }
        self.loop_depth = self.loop_depth - 1;
    }
    // How many subjects the binder loop `blid` projects from: `fields(&a, &b)` has two, and
    // `payloads(v)` reads through the OUTER variants loop's own subjects.
    fn tc_binder_nsubj(self: &Self, blid: NodeId) u32 {
        let a = self.cur_ast();
        if blid == NODE_NONE || unsafe (*a).at_const(blid).kind != NodeKind::NODE_INLINE_FOR {
            return 1;
        }
        let it = unsafe (*a).at_const(blid).as_data.for_stmt.iterable;
        if unsafe (*a).at_const(it).kind != NodeKind::NODE_CALL {
            return 1;
        }
        let cl = unsafe (*a).at_const(it).as_data.call.callee;
        let args = unsafe (*a).at_const(it).as_data.call.args;
        if unsafe (*a).at_const(cl).kind == NodeKind::NODE_IDENTIFIER && span_is(
            self.source,
            unsafe (*a).at_const(cl).as_data.name.text,
            "payloads",
        ) && args.len == 1 {
            return self.tc_binder_nsubj(unsafe (*a).resolution(unsafe (*a).list(args)[0]));
        }
        return args.len;
    }

    // A pattern binding of `for` loop `id` destructures each element of type `elem` like a `let`
    // would, so it must match every element.
    fn tc_for_pattern(self: &mut Self, id: NodeId, elem: TypeId) {
        let a = self.cur_ast();
        let pat = unsafe (*a).at_const(id).as_data.for_stmt.binding;
        if unsafe (*a).at_const(pat).kind == NodeKind::NODE_IDENTIFIER || elem == TYPE_NONE {
            return;
        }
        self.check_pattern(pat, elem, 0);
        if elem == TYPE_ERROR {
            return;
        }
        if self.pat_catchall(pat) {
            return;
        }
        let mut cx = pat::PatCx::new(self.package, a, self.source);
        cx.add_arm(pat, 0);
        // A budget overflow leaves coverage unknown: reject, as a switch does.
        let refutable = cx.overflow || cx.wildcard_useful();
        if refutable || cx.overflow {
            let sp = unsafe (*a).at_const(pat).span;
            self.errors.emit_span(sp, format("a 'for' pattern must match every element"));
            self.errors.note(format("bind the element and use 'switch' or 'if let' in the body"));
        }
    }

    @c.noinline
    fn tc_check_for(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        self.loop_depth = self.loop_depth + 1;
        let le = self.tc_loop_push(unsafe (*a).at_const(id).as_data.for_stmt.label, id, false);
        let iter = unsafe (*a).at_const(id).as_data.for_stmt.iterable;
        // `inline for f in fields(&v)`: the reflection binder mode. `f` (and `f.value`) get ONE
        // symbolic type (the field projection of v's type against this loop) so the body checks
        // once; enumeration and the emitter's per-copy state make it each field's type in turn.
        if unsafe (*a).at_const(id).kind == NodeKind::NODE_INLINE_FOR && unsafe (*a).at_const(iter).kind == NodeKind::NODE_CALL {
            let fcallee = unsafe (*a).at_const(iter).as_data.call.callee;
            if unsafe (*a).at_const(fcallee).kind == NodeKind::NODE_IDENTIFIER && unsafe (*a).resolution_def(fcallee).node == NODE_NONE && unsafe (*a).resolution(
                fcallee,
            ) == NODE_NONE && (span_is(self.source, unsafe (*a).at_const(fcallee).as_data.name.text, "fields") || span_is(
                self.source,
                unsafe (*a).at_const(fcallee).as_data.name.text,
                "variants",
            ) || span_is(self.source, unsafe (*a).at_const(fcallee).as_data.name.text, "payloads")) {
                let is_vars = span_is(self.source, unsafe (*a).at_const(fcallee).as_data.name.text, "variants");
                let is_pay = span_is(self.source, unsafe (*a).at_const(fcallee).as_data.name.text, "payloads");
                let fargs = unsafe (*a).at_const(iter).as_data.call.args;
                let fsp = unsafe (*a).at_const(iter).span;
                let mut owner = TYPE_NONE;
                let mut pq = TypeQualifier::TYPE_QUAL_NONE as u8;
                if is_pay {
                    // payloads(v): v IS a variants binder; the projection shares its enum owner.
                    let mut pok = false;
                    if fargs.len == 1 {
                        let pav = unsafe (*a).list(fargs)[0];
                        if unsafe (*a).at_const(pav).kind == NodeKind::NODE_IDENTIFIER {
                            let plid = unsafe (*a).resolution(pav);
                            self.icx.proj_obj_ok = true;
                            let pty = self.check_expr(pav);
                            self.icx.proj_obj_ok = false;
                            if plid != NODE_NONE && unsafe (*a).at_const(plid).kind == NodeKind::NODE_INLINE_FOR && pty != TYPE_NONE && self.type_at(
                                pty,
                            ).kind == TypeKind::TYPE_FIELD_PROJECTION {
                                owner = self.type_at(pty).as_data.proj.owner;
                                pq = self.type_at(pty).qualifier;
                                pok = true;
                            }
                        }
                    }
                    if !pok {
                        self.errors.emit_span(
                            fsp,
                            format("payloads takes the variants binder itself: 'inline for p in payloads(v)'"),
                        );
                        owner = TYPE_NONE;
                    }
                } else if fargs.len != 1 && fargs.len != 2 {
                    self.errors.emit_span(fsp, format("fields takes one or two reference arguments"));
                } else {
                    let av = self.check_expr(unsafe (*a).list(fargs)[0]);
                    let ay = *self.type_at(av);
                    if ay.kind == TypeKind::TYPE_REFERENCE {
                        owner = ay.as_data.elem;
                        // Fields(&mut v): every f.value is a mutable place.
                        pq = ay.qualifier;
                    } else if !untyped(av) {
                        self.errors.emit_span(fsp, format("fields borrows its subject: write fields(&v)"));
                    }
                    // fields(&a, &b): a PAIRED loop; `.other` projects b's same field. The second
                    // subject is read-only and must be the same type, or the pairing means nothing.
                    if fargs.len == 2 && owner != TYPE_NONE {
                        let bv = self.check_expr(unsafe (*a).list(fargs)[1]);
                        let by = *self.type_at(bv);
                        if bv != TYPE_ERROR && (by.kind != TypeKind::TYPE_REFERENCE || by.as_data.elem != owner) {
                            self.errors.emit_span(
                                fsp,
                                format("the second subject must be a reference to the same type as the first"),
                            );
                            owner = TYPE_NONE;
                        }
                    }
                }
                if owner != TYPE_NONE && !is_pay {
                    let ok2 = *self.type_at(owner);
                    if is_vars {
                        if ok2.kind != TypeKind::TYPE_ENUM && ok2.kind != TypeKind::TYPE_INSTANCE && ok2.kind != TypeKind::TYPE_GENERIC {
                            self.errors.emit_span(
                                fsp,
                                format(
                                    "variants iterates an enum with payload variants (or a type parameter standing for one)",
                                ),
                            );
                            owner = TYPE_NONE;
                        }
                    } else if ok2.kind != TypeKind::TYPE_STRUCT && ok2.kind != TypeKind::TYPE_INSTANCE && ok2.kind != TypeKind::TYPE_GENERIC {
                        self.errors.emit_span(
                            fsp,
                            format("fields iterates a struct, tuple, or union (or a type parameter standing for one)"),
                        );
                        owner = TYPE_NONE;
                    }
                }
                if owner != TYPE_NONE {
                    let pt = unsafe (*self.cur_ast()).intern_type(
                        Ty {
                            kind: TypeKind::TYPE_FIELD_PROJECTION,
                            qualifier: pq,
                            module: self.cur_module(),
                            as_data: TyAs { proj: TyProj { owner: owner, binder: id } },
                        },
                    );
                    unsafe (*self.cur_ast()).set_type(iter, pt);
                    unsafe (*self.cur_ast()).set_type(id, pt);
                }
                self.proj_cbase.insert(id, self.icx.closure_depth);
                self.fields_depth = self.fields_depth + 1;
                self.check_stmt(unsafe (*self.cur_ast()).at_const(id).as_data.for_stmt.body);
                self.fields_depth = self.fields_depth - 1;
                if le >= 0 {
                    self.tc_loop_pop(le, unsafe (*self.cur_ast()).at_const(id).span);
                }
                self.loop_depth = self.loop_depth - 1;
                return;
            }
        }
        // `inline for` unrolls at emission: its iterable must be a closed `a..b` range; there is
        // nothing to unroll over an iterator, and an open bound has no count.
        if unsafe (*a).at_const(id).kind == NodeKind::NODE_INLINE_FOR && (unsafe (*a).at_const(iter).kind != NodeKind::NODE_RANGE || unsafe (*a).at_const(
            iter,
        ).as_data.pattern_range.start == NODE_NONE || unsafe (*a).at_const(iter).as_data.pattern_range.end == NODE_NONE) {
            let sp = unsafe (*a).at_const(iter).span;
            self.errors.emit_span(sp, format("'inline for' iterates a closed constant range ('a..b' or 'a..=b')"));
        }
        let mut elem = TYPE_NONE;
        if unsafe (*a).at_const(iter).kind == NodeKind::NODE_RANGE {
            let s = self.check_expr(unsafe (*a).at_const(iter).as_data.pattern_range.start);
            let e = self.check_expr(unsafe (*a).at_const(iter).as_data.pattern_range.end);
            elem = self.range_type(iter, s, e);
            unsafe (*self.cur_ast()).set_type(iter, elem);
        } else {
            let it = self.check_expr(iter);
            let ity = *self.type_at(it);
            let mut selem: TypeId = TYPE_NONE;
            if ity.kind == TypeKind::TYPE_ARRAY {
                elem = ity.as_data.elem;
                let owns = self.tc_type_is_free(elem);
                unsafe (*self.cur_ast()).at(id).as_data.for_stmt.consumes = owns;
            } else if self.slice_kind(it, &mut selem) != 0 {
                elem = selem;
            } else {
                elem = self.range_instance_elem(it);
            }
            if it == TYPE_ERROR {
                elem = TYPE_ERROR;
            }
            if elem == TYPE_NONE && it != TYPE_NONE {
                elem = self.iter_elem_type(id, it);
            }
            if elem == TYPE_NONE && it != TYPE_NONE {
                let sp = unsafe (*self.cur_ast()).at_const(iter).span;
                self.errors.emit_span(
                    sp,
                    format("cannot iterate over this value (need an array, slice, range, or an Iterator)"),
                );
            }
        }
        unsafe (*self.cur_ast()).set_type(id, elem);
        self.tc_for_pattern(id, elem);
        self.check_stmt(unsafe (*self.cur_ast()).at_const(id).as_data.for_stmt.body);
        if le >= 0 {
            self.tc_loop_pop(le, unsafe (*self.cur_ast()).at_const(id).span);
        }
        self.loop_depth = self.loop_depth - 1;
    }
    fn check_stmt(self: &mut Self, id: NodeId) {
        if id == NODE_NONE {
            return;
        }
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(id).kind;
        switch nk {
            NODE_STATIC_ASSERT => {
                self.check_static_assert(id);
            },
            NODE_BLOCK => {
                let stmts = unsafe (*a).at_const(id).as_data.block.statements;
                // Re-read the list base every iteration: the `format` rewrite APPENDS children
                // mid-check, so a pointer cached across the recursion can dangle on regrowth.
                let mut diverged = false;
                for i in 0..stmts.len {
                    let sid = unsafe (*a).list(stmts)[i as usize];
                    let sk = unsafe (*a).at_const(sid).kind;
                    // Lint: the first statement after a diverging one (return/break/continue, or an
                    // expression of type `!`) never executes. static_asserts are compile-time: exempt.
                    if diverged && sk != NodeKind::NODE_STATIC_ASSERT {
                        let ssp = unsafe (*a).at_const(sid).span;
                        self.errors.warn_span(ssp, format("unreachable statement"));
                        // Once per block.
                        diverged = false;
                    }
                    self.check_stmt(sid);
                    // A statement holding code the platform filter removed diverges on this target only.
                    if self.lint && !diverged && !unsafe (*a).bc_cut_at(sid, unsafe (*a).at_const(sid).span) {
                        diverged = self.stmt_diverges(sid, 0);
                    }
                }
            },
            NODE_LET => {
                let nm = unsafe (*a).at_const(id).as_data.let_stmt.name;
                if unsafe (*a).at_const(nm).kind == NodeKind::NODE_PATTERN_TUPLE {
                    self.check_tuple_let(id);
                    return;
                }
                let tyn = unsafe (*a).at_const(id).as_data.let_stmt.ty;
                let value = unsafe (*a).at_const(id).as_data.let_stmt.value;
                let annotated = tyn != NODE_NONE;
                let valued = value != NODE_NONE;
                let declared = pick(annotated, self.resolve_type(tyn), TYPE_NONE);
                if valued {
                    self.check_expr_w(value, declared);
                }
                let mut binding = TYPE_NONE;
                if annotated {
                    if valued && !self.compatible(declared, value) {
                        self.err_mismatch(value, declared);
                    }
                    binding = declared;
                } else if valued {
                    binding = unsafe (*self.cur_ast()).type_of(value);
                    // A generic function has no type of its own: only a fn POINTER to one of its
                    // instances does, and nothing here says which signature that pointer has (the type
                    // arguments fix the parameters, not the reverse). Reject it: codegen would
                    // otherwise emit the unsubstituted signature, which is not valid C.
                    if !untyped(binding) && !self.type_at(binding).fn_sig() && self.tc_generic_fn_named(value).node != NODE_NONE {
                        let sp = unsafe (*a).at_const(value).span;
                        self.errors.emit_span(
                            sp,
                            format(
                                "cannot infer the type of a generic function used as a value; annotate the binding with its signature, e.g. 'let f: fn(i32) i32 = ..'",
                            ),
                        );
                        binding = TYPE_NONE;
                    }
                } else {
                    let sp = self.name_span(nm);
                    self.errors.emit_span(
                        sp,
                        format("cannot infer type of '{}'", diag::span_str(self.source, sp.start, sp.end)),
                    );
                }
                unsafe (*self.cur_ast()).set_type(id, binding);
                if annotated && !valued {
                    // tc_type_is_free peels to the referent, so gate on the kind first: a `&String`
                    // binding borrows an owner, it does not become one.
                    let bk = self.type_at(binding).kind;
                    if bk != TypeKind::TYPE_POINTER && bk != TypeKind::TYPE_REFERENCE && self.tc_type_is_free(binding) {
                        let sp = self.name_span(nm);
                        self.errors.emit_span(
                            sp,
                            format("a Free-typed binding must be initialized when declared (it is freed at scope exit)"),
                        );
                    }
                }
            },
            NODE_CONST => {
                let declared = self.resolve_type(unsafe (*a).at_const(id).as_data.const_def.ty);
                self.check_const_decl(id, declared);
                unsafe (*self.cur_ast()).set_type(id, declared);
            },
            NODE_RETURN => {
                self.check_return(id);
            },
            NODE_DEFER => {
                let _dv = self.check_expr(unsafe (*a).at_const(id).as_data.single.value);
            },
            NODE_ASM => {
                self.tc_check_asm(id);
            },
            NODE_IF => {
                self.check_if_stmt(id);
            },
            NODE_WHILE => {
                self.tc_check_while(id);
            },
            NODE_FOR | NODE_INLINE_FOR => {
                self.tc_check_for(id);
            },
            NODE_EXPRESSION_STATEMENT => {
                let _es = self.check_expr(unsafe (*a).at_const(id).as_data.single.value);
            },
            NODE_BREAK | NODE_CONTINUE => {
                let lb = unsafe (*a).at_const(id).as_data.flow.label;
                let le = self.tc_find_loop(lb);
                if le < 0 {
                    let sp = unsafe (*a).at_const(id).span;
                    if lb.end > lb.start {
                        self.errors.emit_span(
                            sp,
                            format("no enclosing loop is labeled {}", diag::span_str(self.source, lb.start, lb.end)),
                        );
                    } else {
                        let mut w = "continue".ptr() as *const char;
                        if nk == NodeKind::NODE_BREAK {
                            w = "break".ptr() as *const char;
                        }
                        self.errors.emit_span(sp, format("'{}' outside of a loop", str::from_cstr(w)));
                    }
                    let fv = unsafe (*a).at_const(id).as_data.flow.value;
                    if fv != NODE_NONE {
                        self.check_expr(fv);
                    }
                    return;
                }
                unsafe (*self.cur_ast()).set_resolution(id, self.loop_stack[le as usize].node);
                self.tc_note_resolution(id, unsafe self.loop_stack[le as usize].node);
                // An unrolled loop has no backedge and no end label to jump to.
                if unsafe (*self.cur_ast()).at_const(unsafe self.loop_stack[le as usize].node).kind == NodeKind::NODE_INLINE_FOR {
                    let sp2 = unsafe (*self.cur_ast()).at_const(id).span;
                    self.errors.emit_span(
                        sp2,
                        format("'break' and 'continue' cannot target an 'inline for' (its body is unrolled)"),
                    );
                }
                if nk != NodeKind::NODE_BREAK {
                    return;
                }
                let fv = unsafe (*self.cur_ast()).at_const(id).as_data.flow.value;
                if fv == NODE_NONE {
                    unsafe self.loop_stack[le as usize].saw_bare = true;
                    return;
                }
                let vt = self.check_expr_w(fv, unsafe self.loop_stack[le as usize].break_ty);
                let sp = unsafe (*self.cur_ast()).at_const(id).span;
                if !unsafe self.loop_stack[le as usize].value_loop {
                    self.errors.emit_span(sp, format("'break' can only carry a value inside a 'loop' expression"));
                } else if unsafe self.loop_stack[le as usize].break_ty == TYPE_NONE {
                    unsafe self.loop_stack[le as usize].break_ty = vt;
                } else if !self.compatible(unsafe self.loop_stack[le as usize].break_ty, fv) {
                    self.err_mismatch(fv, unsafe self.loop_stack[le as usize].break_ty);
                }
                unsafe self.loop_stack[le as usize].saw_value = true;
            },
            _ => {},
        };
    }

    // `bind_ref` is the binding mode: 0 binds by value, 1 by `&`, 2 by `&mut`. A destructuring
    // pattern matched against a reference reads the referent and switches the mode for its
    // bindings: a shared reference makes it 1, a `&mut` keeps 2 unless it is already 1.
    fn check_pattern(self: &mut Self, id: NodeId, expected: TypeId, mode: i32) {
        if id == NODE_NONE {
            return;
        }
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(id).kind;
        let mut bind_ref = mode;
        let paren = nk == NodeKind::NODE_PATTERN_TUPLE && unsafe (*a).at_const(id).as_data.pattern.name == NODE_NONE && unsafe (*a).at_const(
            id,
        ).as_data.pattern.children.len == 1;
        if nk == NodeKind::NODE_PATTERN_STRUCT || nk == NodeKind::NODE_PATTERN_TUPLE && !paren {
            let mut y = *self.type_at(expected);
            while y.kind == TypeKind::TYPE_REFERENCE || y.kind == TypeKind::TYPE_POINTER {
                if bind_ref != 1 {
                    bind_ref = if y.qualifier == TypeQualifier::TYPE_QUAL_MUT as u8 {
                        2;
                    } else {
                        1;
                    };
                }
                y = *self.type_at(y.as_data.elem);
            }
        }
        if nk == NodeKind::NODE_IDENTIFIER {
            unsafe (*self.cur_ast()).set_type(id, pick(bind_ref != 0, self.tc_ref(expected, bind_ref == 2), expected));
        } else if nk == NodeKind::NODE_PATTERN_NAME {
            let nameId = unsafe (*a).at_const(id).as_data.pattern.name;
            let mut bmod: ModuleId = 0;
            let mut decl = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            let agok = self.aggregate_of(self.strip(expected), &mut bmod, &mut decl, &mut gp, &mut ga, &mut gn);
            if agok && unsafe (*self.mod_ast(bmod)).at_const(decl).kind == NodeKind::NODE_ENUM {
                let v = self.find_member(bmod, decl, self.name_span(nameId));
                if v != NODE_NONE && unsafe (*self.mod_ast(bmod)).at_const(v).kind == NodeKind::NODE_VARIANT && unsafe (*self.mod_ast(
                    bmod,
                )).at_const(v).as_data.variant.payload.len == 0 {
                    unsafe (*self.cur_ast()).set_resolution_def(nameId, DefId { module: bmod, node: v });
                    return;
                }
            }
            unsafe (*self.cur_ast()).set_type(id, pick(bind_ref != 0, self.tc_ref(expected, bind_ref == 2), expected));
            let subs = unsafe (*self.cur_ast()).at_const(id).as_data.pattern.children;
            for i in 0..subs.len {
                self.check_pattern(unsafe (*self.cur_ast()).list(subs)[i as usize], expected, bind_ref);
            }
        } else if nk == NodeKind::NODE_PATTERN_STRUCT {
            let base = self.strip(expected);
            let nameId = unsafe (*a).at_const(id).as_data.pattern.name;
            let mut bmod: ModuleId = 0;
            let mut decl = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            let agg = self.aggregate_of(base, &mut bmod, &mut decl, &mut gp, &mut ga, &mut gn);
            let mut variant = NODE_NONE;
            if agg && nameId != NODE_NONE && unsafe (*self.mod_ast(bmod)).at_const(decl).kind == NodeKind::NODE_ENUM {
                let v = self.find_member(bmod, decl, self.name_span(nameId));
                if v != NODE_NONE && unsafe (*self.mod_ast(bmod)).at_const(v).kind == NodeKind::NODE_VARIANT {
                    variant = v;
                    unsafe (*self.cur_ast()).set_resolution_def(nameId, DefId { module: bmod, node: variant });
                }
            }
            let children = unsafe (*self.cur_ast()).at_const(id).as_data.pattern.children;
            if variant != NODE_NONE {
                let va = self.mod_ast(bmod);
                let vpl = unsafe (*va).at_const(variant).as_data.variant.payload;
                for i in 0..children.len {
                    let fid = unsafe (*self.cur_ast()).list(children)[i as usize];
                    let fldName = unsafe (*self.cur_ast()).at_const(fid).as_data.pattern.name;
                    let fn2 = self.name_span(fldName);
                    let mut ft = TYPE_NONE;
                    let mut matchId = NODE_NONE;
                    for j in 0..vpl.len {
                        let pfid = unsafe (*va).list(vpl)[j as usize];
                        let pf = unsafe (*va).at_const(pfid);
                        if pf.kind == NodeKind::NODE_FIELD && spans_eq2(
                            self.source,
                            fn2,
                            self.mod_src(bmod),
                            unsafe (*va).at_const(pf.as_data.field.name).as_data.name.text,
                        ) {
                            matchId = pfid;
                            ft = self.subst_type(self.decl_type_in(bmod, pfid), &gp[0], &ga[0], gn);
                            break;
                        }
                    }
                    if matchId != NODE_NONE {
                        unsafe (*self.cur_ast()).set_resolution_def(fldName, DefId { module: bmod, node: matchId });
                    } else {
                        self.err_no_field(fn2, base);
                    }
                    let fc = unsafe (*self.cur_ast()).at_const(fid).as_data.pattern.children;
                    for k in 0..fc.len {
                        self.check_pattern(unsafe (*self.cur_ast()).list(fc)[k as usize], ft, bind_ref);
                    }
                }
            } else {
                if agg && nameId != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(nameId, DefId { module: bmod, node: decl });
                }
                for i in 0..children.len {
                    self.check_pattern(unsafe (*self.cur_ast()).list(children)[i as usize], base, bind_ref);
                }
            }
        } else if nk == NodeKind::NODE_PATTERN_FIELD {
            let base = self.strip(expected);
            let nameId = unsafe (*a).at_const(id).as_data.pattern.name;
            let mut bmod: ModuleId = 0;
            let mut decl = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            let agg = self.aggregate_of(base, &mut bmod, &mut decl, &mut gp, &mut ga, &mut gn);
            let mut field_type = pick(base == TYPE_ERROR, TYPE_ERROR, TYPE_NONE);
            if agg && nameId != NODE_NONE {
                let fname = self.name_span(nameId);
                let field = self.find_member(bmod, decl, fname);
                if field != NODE_NONE {
                    unsafe (*self.cur_ast()).set_resolution_def(nameId, DefId { module: bmod, node: field });
                    self.check_field_visibility(bmod, field, decl, fname);
                    field_type = self.subst_type(self.decl_type_in(bmod, field), &gp[0], &ga[0], gn);
                } else {
                    self.err_no_field(fname, base);
                }
            }
            let children = unsafe (*self.cur_ast()).at_const(id).as_data.pattern.children;
            for i in 0..children.len {
                self.check_pattern(unsafe (*self.cur_ast()).list(children)[i as usize], field_type, bind_ref);
            }
        } else if paren {
            self.check_pattern(unsafe (*a).list(unsafe (*a).at_const(id).as_data.pattern.children)[0], expected, mode);
        } else if nk == NodeKind::NODE_PATTERN_TUPLE && unsafe (*a).at_const(id).as_data.pattern.name == NODE_NONE {
            self.check_tuple_pattern(id, expected, bind_ref);
        } else if nk == NodeKind::NODE_PATTERN_TUPLE {
            let base = self.strip(expected);
            let nameId = unsafe (*a).at_const(id).as_data.pattern.name;
            let mut bmod: ModuleId = self.cur_module();
            let mut decl0 = NODE_NONE;
            let mut gp = Defs8 {};
            let mut ga = Tys8 {};
            let mut gn: i32 = 0;
            let agok = self.aggregate_of(base, &mut bmod, &mut decl0, &mut gp, &mut ga, &mut gn);
            let agg = agok && unsafe (*self.mod_ast(bmod)).at_const(decl0).kind == NodeKind::NODE_ENUM;
            let decl = pick(agg, decl0, NODE_NONE);
            let mut variant = NODE_NONE;
            if nameId != NODE_NONE && base != TYPE_ERROR {
                let vname = self.name_span(nameId);
                if decl == NODE_NONE {
                    let ty = self.type_buf(base);
                    self.errors.emit_span(
                        vname,
                        format(
                            "pattern '{}(..)' expects an enum, but the value has type '{}'",
                            diag::span_str(self.source, vname.start, vname.end),
                            str::from_cstr(&ty[0]),
                        ),
                    );
                } else {
                    variant = self.find_member(bmod, decl, vname);
                    if variant != NODE_NONE {
                        unsafe (*self.cur_ast()).set_resolution_def(nameId, DefId { module: bmod, node: variant });
                    } else {
                        let ty = self.type_buf(base);
                        self.errors.emit_span(
                            vname,
                            format(
                                "no variant '{}' on '{}'",
                                diag::span_str(self.source, vname.start, vname.end),
                                str::from_cstr(&ty[0]),
                            ),
                        );
                    }
                }
            }
            let children = unsafe (*self.cur_ast()).at_const(id).as_data.pattern.children;
            let mut payload = NodeList { start: 0, len: 0 };
            let mut va: *mut Ast = a;
            if variant != NODE_NONE {
                va = self.mod_ast(bmod);
                payload = unsafe (*va).at_const(variant).as_data.variant.payload;
            }
            for i in 0..children.len {
                let mut pt = pick(base == TYPE_ERROR, TYPE_ERROR, TYPE_NONE);
                if i < payload.len {
                    let plid = unsafe (*va).list(payload)[i as usize];
                    let pe = unsafe (*va).at_const(plid);
                    pt = self.subst_type(
                        self.lower_type_in(bmod, pick(pe.kind == NodeKind::NODE_FIELD, pe.as_data.field.ty, plid)),
                        &gp[0],
                        &ga[0],
                        gn,
                    );
                }
                self.check_pattern(unsafe (*self.cur_ast()).list(children)[i as usize], pt, bind_ref);
            }
        } else if nk == NodeKind::NODE_PATTERN_OR {
            let children = unsafe (*a).at_const(id).as_data.pattern.children;
            for i in 0..children.len {
                self.check_pattern(unsafe (*self.cur_ast()).list(children)[i as usize], expected, bind_ref);
            }
        } else if nk == NodeKind::NODE_PATTERN_LITERAL {
            self.tc_pat_value(id, expected);
        } else if nk == NodeKind::NODE_PATTERN_RANGE {
            let r = unsafe (*a).at_const(id).as_data.pattern_range;
            self.tc_pat_value(r.start, expected);
            self.tc_pat_value(r.end, expected);
        }
    }

    // A literal pattern or a range bound `v` (bare or in its PATTERN_LITERAL wrapper), checked against the
    // matched value's type `expected`, read through references: a literal or a builtin limit takes that
    // type (`9223372036854775808` and `i64::MAX` against a `u64` are `u64`s), and a value it cannot take
    // is an error. A name or a qualified path must name a constant (`MAX`, `i64::MAX`, `Foo::K`); an
    // integer value is recorded for the pattern matrix (`Ast.pat_vals`).
    fn tc_pat_value(self: &mut Self, v: NodeId, expected: TypeId) {
        if v == NODE_NONE {
            return;
        }
        let a = self.cur_ast();
        let e = pick(
            unsafe (*a).at_const(v).kind == NodeKind::NODE_PATTERN_LITERAL,
            unsafe (*a).at_const(v).as_data.single.value,
            v,
        );
        let mut want = expected;
        while want != TYPE_NONE && self.type_at(want).kind == TypeKind::TYPE_REFERENCE {
            want = self.type_at(want).as_data.elem;
        }
        let en = *unsafe (*a).at_const(e);
        let named = en.kind == NodeKind::NODE_IDENTIFIER || en.kind == NodeKind::NODE_MEMBER;
        if en.kind == NodeKind::NODE_MEMBER {
            let mut hd = DefId { module: 0, node: NODE_NONE };
            let vp = self.tc_value_path(self.cur_module(), e, &mut hd);
            if vp.node != NODE_NONE && unsafe (*self.mod_ast(vp.module)).at_const(vp.node).kind == NodeKind::NODE_VARIANT {
                let vs = self.name_span(en.as_data.member.member);
                self.errors.emit_span(
                    tok::Span { start: en.span.start, end: vs.start },
                    format(
                        "a pattern names a variant without its enum: write '{}', not '{}'",
                        diag::span_str(self.source, vs.start, vs.end),
                        diag::span_str(self.source, en.span.start, vs.end),
                    ),
                );
                return;
            }
        }
        // A builtin limit reads as the literal of its value, so it takes an integer scrutinee's type.
        let got = if self.tc_lim(e) == 1 && bt_is_int(self.bt_of(want)) {
            self.tc_lit_arith(e, 1, want);
        } else {
            self.check_expr_w(e, want);
        };
        if got == TYPE_NONE {
            return;
        }
        if want != TYPE_NONE && got != want && !self.compatible(want, e) {
            self.err_mismatch(e, want);
            return;
        }
        if named {
            let d = unsafe (*a).resolution_def(pick(en.kind == NodeKind::NODE_MEMBER, en.as_data.member.member, e));
            let dn = unsafe (*self.mod_ast(d.module)).at_const(d.node);
            if d.node == NODE_NONE || dn.kind != NodeKind::NODE_CONST || dn.as_data.const_def.is_static_mut || dn.as_data.const_def.is_extern {
                self.errors.emit_span(
                    en.span,
                    format(
                        "a pattern value must be a constant: '{}' is not one",
                        diag::span_str(self.source, en.span.start, en.span.end),
                    ),
                );
                return;
            }
        }
        let wb = self.bt_of(want);
        let mut bits: u64 = 0;
        if (bt_is_int(wb) || wb == BuiltinType::BT_CHAR) && self.tc_pat_bits(e, &mut bits) {
            // The wrapper carries the matched type: a constant of a narrower type keeps its own.
            unsafe (*self.cur_ast()).pat_vals.insert(e, bits);
            if v != e {
                unsafe (*self.cur_ast()).set_type(v, want);
            }
        }
    }

    // The value of integer constant pattern `e` (a literal, a negated one, a builtin limit, a named or
    // associated constant) as two's complement bits; false when it has none.
    fn tc_pat_bits(self: &mut Self, e: NodeId, out: &mut u64) bool {
        let a = self.cur_ast();
        let n = *unsafe (*a).at_const(e);
        let neg = n.kind == NodeKind::NODE_UNARY && n.as_data.unary.op == TokenType::Minus;
        let leaf = pick(neg, n.as_data.unary.operand, e);
        let ln = *unsafe (*a).at_const(leaf);
        let mut mag: u64 = 0;
        if ln.kind == NodeKind::NODE_LITERAL && (ln.as_data.literal.token_type == TokenType::CharacterLiteral || ln.as_data.literal.token_type == TokenType::ByteCharacterLiteral) {
            switch tok::char_literal_value(self.source, ln.as_data.literal.raw) {
                Some(c) => {
                    mag = c as u64;
                },
                None => {
                    return false;
                },
            };
        } else if ln.kind == NodeKind::NODE_LITERAL {
            if ln.as_data.literal.token_type != TokenType::IntegerLiteral || !self.lit_mag(leaf, &mut mag) {
                return false;
            }
        } else if neg {
            return false;
        } else if self.tc_lim(e) == 1 {
            let mut lneg = false;
            self.tc_lim_int(e, &mut mag, &mut lneg);
            *out = pick(lneg, mag.wrapping_neg(), mag);
            return true;
        } else {
            if self.cir() == null {
                return false;
            }
            let cv = self.ev(self.cur_module(), e);
            if cv.kind != iri::IV_INT {
                return false;
            }
            *out = cv.i as u64;
            return true;
        }
        *out = pick(neg, mag.wrapping_neg(), mag);
        return true;
    }

    // A tuple pattern `(p0, p1, ..)`: element i checks against the tuple's element type i.
    fn check_tuple_pattern(self: &mut Self, id: NodeId, expected: TypeId, bind_ref: i32) {
        let children = unsafe (*self.cur_ast()).at_const(id).as_data.pattern.children;
        let base = self.strip(expected);
        let mut targs = Tys8 {};
        let tn = self.tuple_args_of(base, &mut targs[0], 4);
        if !untyped(base) && tn != children.len as i32 {
            let ty = self.type_buf(base);
            self.errors.emit_span(
                unsafe (*self.cur_ast()).at_const(id).span,
                format(
                    "a tuple pattern with {} elements cannot match a value of type '{}'",
                    children.len,
                    str::from_cstr(&ty[0]),
                ),
            );
        }
        for i in 0..children.len {
            let mut et = pick(base == TYPE_ERROR, TYPE_ERROR, TYPE_NONE);
            if tn > 0 && i < tn as u32 {
                et = targs[i as usize];
            }
            self.check_pattern(unsafe (*self.cur_ast()).list(children)[i as usize], et, bind_ref);
        }
    }

    // Whether aggregate declaration `(m, d)`, with the instance arguments `gp`/`ga` substituted into
    // its members (none for the declaration itself), holds `(tm, td)` by value: as a member, an
    // array element, or through a member aggregate. 1 = it does; -1 = the walk passed
    // BYVAL_MAX_DEPTH aggregates; 0 = it does not. `seen` lists the types walked without a hit.
    fn tc_holds_by_value(
        self: &mut Self,
        m: ModuleId,
        d: NodeId,
        gp: &Defs8,
        ga: &Tys8,
        gn: i32,
        tm: ModuleId,
        td: NodeId,
        depth: i32,
        seen: &mut Vector<TypeId>,
    ) i32 {
        let a = self.mod_ast(m);
        let dn = *unsafe (*a).at_const(d);
        let members = dn.as_data.aggregate.members;
        for i in 0..members.len {
            let mid = unsafe (*a).list(members)[i as usize];
            let mn = *unsafe (*a).at_const(mid);
            let mut n: u32 = 1;
            if !dn.as_data.aggregate.is_tuple && mn.kind == NodeKind::NODE_VARIANT {
                n = mn.as_data.variant.payload.len;
            } else if !dn.as_data.aggregate.is_tuple && mn.kind != NodeKind::NODE_FIELD {
                n = 0;
            }
            for j in 0..n {
                let mut tn = mid;
                if !dn.as_data.aggregate.is_tuple && mn.kind == NodeKind::NODE_FIELD {
                    tn = mn.as_data.field.ty;
                } else if !dn.as_data.aggregate.is_tuple {
                    tn = unsafe (*a).member_type_node(unsafe (*a).list(mn.as_data.variant.payload)[j as usize], true);
                }
                let lt = self.lower_type_in(m, tn);
                let mut ft = self.subst_type(lt, &gp[0], &ga[0], gn);
                let mut y = *self.type_at(ft);
                while y.kind == TypeKind::TYPE_ARRAY {
                    ft = y.as_data.elem;
                    y = *self.type_at(ft);
                }
                let mut cm: ModuleId = 0;
                let mut cd = NODE_NONE;
                let mut cgp = Defs8 {};
                let mut cga = Tys8 {};
                let mut cgn: i32 = 0;
                if y.kind == TypeKind::TYPE_STRUCT || y.kind == TypeKind::TYPE_ENUM {
                    cm = y.module;
                    cd = y.as_data.decl;
                } else if y.kind == TypeKind::TYPE_INSTANCE {
                    let it = *unsafe (*self.cur_ast()).instance(y.as_data.inst);
                    cm = it.module;
                    cd = it.decl;
                    let gens = unsafe (*self.mod_ast(cm)).at_const(cd).as_data.aggregate.generics;
                    while cgn as u32 < gens.len && cgn < it.n as i32 && cgn as usize < cgp.len() {
                        cgp[cgn as usize] = DefId {
                            module: cm,
                            node: unsafe (*self.mod_ast(cm)).list(gens)[cgn as usize],
                        };
                        cga[cgn as usize] = unsafe it.args[cgn as usize];
                        cgn += 1;
                    }
                } else {
                    continue;
                }
                if cm == tm && cd == td {
                    return 1;
                }
                let mut walked = false;
                for k in 0..seen.len() {
                    walked = walked || seen[k] == ft;
                }
                if walked {
                    continue;
                }
                if depth == BYVAL_MAX_DEPTH {
                    return -1;
                }
                seen.push(ft);
                let r = self.tc_holds_by_value(cm, cd, &cgp, &cga, cgn, tm, td, depth + 1, seen);
                if r != 0 {
                    return r;
                }
            }
        }
        return 0;
    }

    fn check_item(self: &mut Self, id: NodeId) {
        let a = self.cur_ast();
        let nk = unsafe (*a).at_const(id).kind;
        switch nk {
            NODE_STATIC_ASSERT => {
                self.check_static_assert(id);
            },
            NODE_FUNCTION => {
                let params = unsafe (*a).at_const(id).as_data.function.params;
                for i in 0..params.len {
                    self.decl_type(unsafe (*a).list(params)[i as usize]);
                }
                let fnd = unsafe (*self.cur_ast()).at_const(id).as_data.function;
                // `@blocking` is implemented by packing the call's arguments into a frame the pool thread
                // runs from, and a variadic call has no fixed shape to pack, so say so here rather than
                // let codegen quietly emit an ordinary (worker-blocking) call.
                if fnd.is_variadic() && self.tc_attr(self.cur_module(), id, AttrKind::ATTR_BLOCKING) != null {
                    let sp = self.name_span(fnd.name);
                    self.errors.emit_span(
                        sp,
                        format(
                            "'@blocking' cannot apply to a variadic function: its arguments cannot be forwarded to the blocking pool",
                        ),
                    );
                }
                if fnd.is_variadic() && !fnd.is_extern() && params.len == 0 {
                    let sp = self.name_span(fnd.name);
                    self.errors.emit_span(
                        sp,
                        format("a variadic function needs at least one fixed parameter before '...'"),
                    );
                }
                // ISO C has no portable by-value zero-sized object: an extern boundary cannot
                // carry one. Layout decides (extern fns are never generic), never syntax.
                if fnd.is_extern() {
                    let mut lsv = lay::Svc::new(self.package);
                    for i in 0..params.len {
                        let pid = unsafe (*a).list(params)[i as usize];
                        let pn9 = unsafe (*self.cur_ast()).at_const(pid);
                        if pn9.kind != NodeKind::NODE_PARAMETER {
                            continue;
                        }
                        let pt9 = unsafe (*self.cur_ast()).type_of(pn9.as_data.parameter.ty);
                        let lo9 = lsv.layout(self.cur_module(), pt9);
                        if lo9.ok && lo9.size == 0 {
                            let sp9 = self.name_span(fnd.name);
                            self.errors.emit_span(
                                sp9,
                                format(
                                    "an extern \"C\" function cannot take a zero-sized type by value (C has no representation for it); pass a pointer or a positive-size wrapper",
                                ),
                            );
                            break;
                        }
                    }
                    let rets9 = fnd.returns;
                    if rets9.len == 1 {
                        let r9 = unsafe (*a).list(rets9)[0];
                        let rt9 = unsafe (*self.cur_ast()).type_of(unsafe (*self.cur_ast()).slot_type_node(r9));
                        let lo9 = lsv.layout(self.cur_module(), rt9);
                        if lo9.ok && lo9.size == 0 {
                            let sp9 = self.name_span(fnd.name);
                            self.errors.emit_span(
                                sp9,
                                format(
                                    "an extern \"C\" function cannot return a zero-sized type by value (C has no representation for it); return a pointer or a positive-size wrapper",
                                ),
                            );
                        }
                    }
                    lsv.free();
                }
                if span_is(self.source, self.name_span(fnd.name), "main") {
                    let rets = fnd.returns;
                    let mut rt = TYPE_NONE;
                    if rets.len == 1 {
                        let r0 = unsafe (*self.cur_ast()).list(rets)[0];
                        rt = self.resolve_type(unsafe (*self.cur_ast()).slot_type_node(r0));
                    }
                    if !self.tc_main_params_ok(params) || rets.len != 1 || rt != Ast::builtin(BuiltinType::BT_I32) {
                        let sp = self.name_span(fnd.name);
                        self.errors.emit_span(
                            sp,
                            format("'main' must be declared 'fn main() i32' or 'fn main(argv: Vector<str>) i32'"),
                        );
                    }
                }
                if fnd.is_const() {
                    // '@no_const' in the signature disqualifies the const contract outright: no such
                    // value can exist at compile time, so the shallow body scan need not prove it.
                    let mut ncsite = NODE_NONE;
                    for i in 0..params.len {
                        let pid = unsafe (*self.cur_ast()).list(params)[i as usize];
                        let tnode = unsafe (*self.cur_ast()).slot_type_node(pid);
                        if self.tc_ty_no_const(self.resolve_type(tnode), 0) {
                            ncsite = pid;
                        }
                    }
                    let rets = fnd.returns;
                    for i in 0..rets.len {
                        let rid = unsafe (*self.cur_ast()).list(rets)[i as usize];
                        let tnode = unsafe (*self.cur_ast()).slot_type_node(rid);
                        if self.tc_ty_no_const(self.resolve_type(tnode), 0) {
                            ncsite = rid;
                        }
                    }
                    if ncsite != NODE_NONE {
                        let sp = unsafe (*self.cur_ast()).at_const(ncsite).span;
                        self.errors.emit_span(
                            sp,
                            format(
                                "a 'const fn' signature cannot use a '@no_const' type: no such value can exist at compile time",
                            ),
                        );
                    }
                }
                let saved = self.icx.current_returns;
                let savedfn = self.icx.current_fn;
                let saved_wm = self.err_wm;
                self.icx.current_returns = fnd.returns;
                self.icx.current_fn = id;
                self.err_wm = self.errors.errors.len();
                self.loop_depth = 0;
                if fnd.body != NODE_NONE {
                    // An `unsafe fn` body is one big unsafe context: raw-pointer work inside needs
                    // no per-statement markers; the safety obligation sits at the call sites.
                    if fnd.is_unsafe() {
                        self.icx.unsafe_depth = self.icx.unsafe_depth + 1;
                    }
                    // Nodes a desugar appends belong to the arena of the body they extend.
                    unsafe (*self.cur_ast()).sink_body = Ast::in_body(fnd.body);
                    let appended_from = if Ast::in_body(fnd.body) {
                        unsafe (*self.cur_ast()).b.nodes.len();
                    } else {
                        unsafe (*self.cur_ast()).nodes.len();
                    };
                    self.check_stmt(fnd.body);
                    unsafe (*self.cur_ast()).sink_body = false;
                    self.tc_record_free_touches(id, fnd, appended_from);
                    if fnd.is_unsafe() {
                        self.icx.unsafe_depth = self.icx.unsafe_depth - 1;
                    }
                }
                // Def-site `const fn` validation, AFTER the body walk: type-based disqualifiers
                // ('@no_const' mentions) only exist once the body is typed, so a pre-body verdict
                // would be blind to them (fn_recheck also overwrites any blind memoized verdict).
                if fnd.is_const() && fnd.body != NODE_NONE && !fnd.is_extern() {
                    let ceptr = self.cir();
                    self.ev_err = false;
                    if ceptr != null && self.fn_recheck_as(self.cur_module(), id) == iri::FX_NO && !self.ev_err {
                        let sp = self.name_span(fnd.name);
                        // The actionable token is the `const` keyword itself: [pub] [unsafe] const fn
                        // is the canonical order, so scan back from the name across `fn`.
                        let mut cstart = sp.start;
                        let mut cend = sp.end;
                        let mut i = sp.start as usize;
                        while i > 0 && (self.source[i - 1] == b' ' || self.source[i - 1] == b'\t' || self.source[i - 1] == b'\n' || self.source[i - 1] == b'\r') {
                            i = i - 1;
                        }
                        if i >= 2 && self.source[i - 2] == b'f' && self.source[i - 1] == b'n' {
                            let mut j = i - 2;
                            while j > 0 && (self.source[j - 1] == b' ' || self.source[j - 1] == b'\t' || self.source[j - 1] == b'\n' || self.source[j - 1] == b'\r') {
                                j = j - 1;
                            }
                            if j >= 5 && diag::span_str(self.source, (j - 5) as u32, j as u32) == "const" {
                                cstart = (j - 5) as u32;
                                cend = j as u32;
                            }
                        }
                        let mut why: str = "cannot be evaluated at compile time";
                        let r = unsafe (*ceptr).fx_no_reason(self.cur_module(), id);
                        if r != null {
                            why = unsafe (*r).why;
                        }
                        self.errors.emit(
                            cstart,
                            cend - cstart,
                            format(
                                "function '{}' is declared 'const fn' but {}",
                                diag::span_str(self.source, sp.start, sp.end),
                                why,
                            ),
                        );
                        if r != null && unsafe (*r).site != NODE_NONE {
                            let ss = unsafe (*self.cur_ast()).at_const(unsafe (*r).site).span;
                            let mut line: u32 = 1;
                            for k in 0..ss.start as usize {
                                if self.source[k] == b'\n' {
                                    line = line + 1;
                                }
                            }
                            self.errors.note(
                                format(
                                    "disqualified at '{}' (line {})",
                                    diag::span_str(self.source, ss.start, ss.end),
                                    line,
                                ),
                            );
                        }
                    }
                }
                self.loop_depth = 0;
                self.icx.current_returns = saved;
                self.icx.current_fn = savedfn;
                self.err_wm = saved_wm;
            },
            NODE_STRUCT | NODE_ENUM => {
                let agg = unsafe (*a).at_const(id).as_data.aggregate;
                let members = agg.members;
                if agg.is_tuple {
                    for i in 0..members.len {
                        self.resolve_type(unsafe (*self.cur_ast()).list(members)[i as usize]);
                    }
                } else {
                    for i in 0..members.len {
                        let mid = unsafe (*self.cur_ast()).list(members)[i as usize];
                        let mn = *unsafe (*self.cur_ast()).at_const(mid);
                        if mn.kind == NodeKind::NODE_FIELD {
                            // The field's own record: every reader takes it from the slot.
                            self.decl_type(mid);
                        } else {
                            if mn.as_data.variant.value != NODE_NONE {
                                let vt = self.check_expr(mn.as_data.variant.value);
                                if vt != TYPE_NONE && !self.is_int(vt) {
                                    let sp = unsafe (*self.cur_ast()).at_const(mn.as_data.variant.value).span;
                                    self.errors.emit_span(sp, format("enum discriminant must be an integer"));
                                } else if vt != TYPE_NONE {
                                    self.tc_discriminant(mn.as_data.variant.value);
                                }
                            }
                            let payload = mn.as_data.variant.payload;
                            for j in 0..payload.len {
                                let plid = unsafe (*self.cur_ast()).list(payload)[j as usize];
                                if unsafe (*self.cur_ast()).at_const(plid).kind == NodeKind::NODE_FIELD {
                                    self.decl_type(plid);
                                } else {
                                    self.resolve_type(plid);
                                }
                            }
                        }
                    }
                }
                if unsafe (*a).at_const(id).kind == NodeKind::NODE_ENUM {
                    self.tc_enum_tags(id);
                }
                let mut seen = Vector::<TypeId>::new();
                let no_params = Defs8 {};
                let no_args = Tys8 {};
                let held = self.tc_holds_by_value(
                    self.cur_module(),
                    id,
                    &no_params,
                    &no_args,
                    0,
                    self.cur_module(),
                    id,
                    0,
                    &mut seen,
                );
                if held == 1 {
                    let sp = unsafe (*self.cur_ast()).at_const(id).span;
                    self.errors.emit_span(
                        sp,
                        format("this type embeds itself by value, so it would have infinite size"),
                    );
                    self.errors.note(format("break the cycle with a pointer ('*mut T'), a reference, or 'Box<T>'"));
                } else if held == -1 {
                    let sp = unsafe (*self.cur_ast()).at_const(id).span;
                    self.errors.emit_span(
                        sp,
                        format("this type holds more than {} nested aggregates by value", BYVAL_MAX_DEPTH),
                    );
                    self.errors.note(
                        format("a generic type that holds itself with a growing type argument has infinite size"),
                    );
                }
                if self.lint && agg.generics.len == 0 && agg.is_union {
                    self.tc_lint_missing_free(id);
                }
            },
            NODE_INTERFACE => {
                self.tc_record_supers(id);
                self.check_associated(unsafe (*a).at_const(id).as_data.interface_def.items);
            },
            NODE_EXTEND => {
                let tgt = unsafe (*a).at_const(id).as_data.extend_def.target_type;
                let td = unsafe (*a).resolution_def(tgt);
                if td.node != NODE_NONE && unsafe (*self.mod_ast(td.module)).at_const(td.node).kind == NodeKind::NODE_TYPE_ALIAS && unsafe (*self.mod_ast(
                    td.module,
                )).at_const(td.node).as_data.type_alias.generics.len > 0 {
                    let sp = unsafe (*a).at_const(tgt).span;
                    self.errors.emit_span(
                        sp,
                        format("a generic type alias cannot be extended; extend the aliased type"),
                    );
                    return;
                }
                let saved = self.current_self;
                let saved_impl = self.current_extend;
                self.current_self = unsafe (*a).resolution(tgt);
                self.current_extend = id;
                self.tc_check_ext_target(id);
                if unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.interface_type != NODE_NONE {
                    self.check_extend_conformance(id);
                } else {
                    self.check_dup_items(id);
                }
                self.check_associated(unsafe (*self.cur_ast()).at_const(id).as_data.extend_def.items);
                self.current_self = saved;
                self.current_extend = saved_impl;
            },
            NODE_CONST => {
                // The declaration's own record (`decl_type_in`): the lowering reads the slot.
                let declared = self.decl_type(id);
                self.check_const_decl(id, declared);
            },
            NODE_TYPE_ALIAS => {
                let _ = self.resolve_type(unsafe (*a).at_const(id).as_data.type_alias.ty);
            },
            NODE_EXTERN_BLOCK => {
                self.check_associated(unsafe (*a).at_const(id).as_data.extern_block.items);
            },
            _ => {},
        };
    }

    // The checks a `const` or `static mut` declaration gets, at item level or in a block: the value is
    // checked against the declared type, a constant is evaluated, and neither may hold what static
    // storage cannot represent.
    fn check_const_decl(self: &mut Self, id: NodeId, declared: TypeId) {
        let cd = unsafe (*self.cur_ast()).at_const(id).as_data.const_def;
        let dtk = self.type_at(declared).kind;
        // An owning (Free) type IS representable: its object graph, heap blocks included,
        // materializes into static storage with relocations, exactly as a malloc'd graph does.
        // What makes it sound is that nothing can ever free or mutate it: the value is
        // immutable, and borrowck refuses to move it out of the const (bc_const_move), so no
        // copy exists to run free() on storage the allocator never handed out.
        // The one thing that does NOT survive materialization is allocator STATE: the constant's
        // storage is static data, so state describing it is fiction, and a state field holding a
        // compile-time pointer would freeze that block into the binary as read-only data.
        if !cd.is_extern && !cd.is_static_mut && dtk != TypeKind::TYPE_BUILTIN {
            let bad = self.tc_const_alloc_state(declared, 0);
            if bad != TYPE_NONE {
                let sp = self.name_span(cd.name);
                let tn = self.type_buf(bad);
                self.errors.emit_span(
                    sp,
                    format("a constant cannot use the stateful allocator '{}'", str::from_cstr(&tn[0])),
                );
                self.errors.note(
                    format(
                        "a constant's storage is static data that no allocator provided, so allocator state beside it describes memory that does not exist; use a zero-sized allocator",
                    ),
                );
            }
        }
        if cd.value != NODE_NONE {
            // `[..].into()` and `[]` take their type from here.
            self.check_expr_w(cd.value, declared);
            if !self.compatible(declared, cd.value) {
                self.err_mismatch(cd.value, declared);
            }
            if !cd.is_extern && !cd.is_static_mut {
                self.tc_mandatory_const(id, cd.value);
            }
        }
        // A raw pointer / reference never owns its pointee (`tc_type_is_free` peels them via
        // `strip`, so it would wrongly report `*mut FreeStruct` as owning): a `static mut` holding
        // one is fine, which is how a heap-managed global singleton is expressed.
        if cd.is_static_mut && dtk != TypeKind::TYPE_POINTER && dtk != TypeKind::TYPE_REFERENCE && self.tc_type_is_free(
            declared,
        ) {
            let sp = unsafe (*self.cur_ast()).at_const(id).span;
            self.errors.emit_span(sp, format("a 'static mut' cannot hold an owning (Free) type"));
            self.errors.note(format("no scope ever frees a global; store a scalar/view or manage the value locally"));
        }
    }

    // Members are checked in declaration order under their extend or interface; each names
    // itself as the engine's reader, so an earlier member's body is visible to a later one.
    fn check_associated(self: &mut Self, items: NodeList) {
        let saved = self.cur_item;
        for i in 0..items.len {
            let mid = unsafe (*self.cur_ast()).list(items)[i as usize];
            if saved != loader::ITEM_NONE {
                let rec = unsafe (*self.package).item_of(self.cur_module(), mid);
                if rec != loader::ITEM_NONE {
                    self.cur_item = rec;
                }
            }
            self.check_item(mid);
        }
        self.cur_item = saved;
    }

    fn close_instances(self: &mut Self) {
        // Each module's generic extends by target node, filled on the module's first instance:
        // `heads` maps module << 32 | target to the first package extend index (`PkgIndex.exts`),
        // `next` links an extend to the next one of its target in item order (EXT_END ends a list).
        let mut heads = Map::<u64, u32>::new();
        let mut next = Vector::<u32>::new();
        let mut filled = Vector::<bool>::new();
        let mut ii: usize = 0;
        while ii < unsafe (*self.cur_ast()).ninstances() {
            let it = *unsafe (*self.cur_ast()).used_instance(ii);
            let mut concrete = true;
            for k in 0..it.n {
                if !unsafe (*self.cur_ast()).type_concrete(it.args[k as usize]) {
                    concrete = false;
                }
            }
            if !concrete {
                ii = ii + 1;
                continue;
            }
            let ma = self.mod_ast(it.module);
            if filled.len() == 0 {
                filled.resize_default(self.pkg_count());
                for _ in 0..(unsafe (*self.package).idx.exts).len() {
                    next.push(EXT_END);
                }
            }
            if !filled[it.module as usize] {
                filled[it.module as usize] = true;
                let base = (unsafe (*self.package).idx.mod_exts)[it.module as usize];
                let mut i = self.ext_count(it.module);
                while i > 0 {
                    i = i - 1;
                    let en = unsafe (*ma).at_const(self.ext_at(it.module, i));
                    if en.as_data.extend_def.generics.len != 0 {
                        let key = it.module as u64 << 32 | (unsafe (*ma).resolution(en.as_data.extend_def.target_type)) as u64;
                        switch heads.get(&key) {
                            Some(v) => {
                                next[base as usize + i] = *v;
                            },
                            None => {},
                        };
                        heads.insert(key, base + i as u32);
                    }
                }
            }
            let mut at = switch heads.get(&(it.module as u64 << 32 | it.decl as u64)) {
                Some(v) => *v,
                None => EXT_END,
            };
            while at != EXT_END {
                let iid = (unsafe (*self.package).idx.exts)[at as usize];
                at = next[at as usize];
                let itn = unsafe (*ma).at_const(iid);
                // A plain generic extend's methods are instantiated per (instance, method) pair instead,
                // by the instance graph (`expand_method`): closing their signatures for every instance is what a
                // method returning a wider view of its own receiver turns into an endless chain.
                let demand = itn.as_data.extend_def.interface_type == NODE_NONE && self.tc_attr(
                    it.module,
                    it.decl,
                    AttrKind::ATTR_EMIT_MACRO,
                ) == null;
                let mut ip = Defs8 {};
                let mut ia = Tys8 {};
                let mut ipn: i32 = 0;
                self.frame_ext(it.module, iid, &it.args[0], it.n, &mut ip[0], &mut ia[0], &mut ipn);
                let ms = unsafe (*ma).at_const(iid).as_data.extend_def.items;
                for j in 0..ms.len {
                    let mid = unsafe (*ma).list(ms)[j as usize];
                    let mn = unsafe (*ma).at_const(mid);
                    if mn.kind == NodeKind::NODE_FUNCTION && mn.as_data.function.generics.len == 0 && !demand {
                        let ps = mn.as_data.function.params;
                        for p in 0..ps.len {
                            let pid = unsafe (*ma).list(ps)[p as usize];
                            self.subst_type(
                                self.lower_type_in(it.module, unsafe (*ma).at_const(pid).as_data.parameter.ty),
                                &ip[0],
                                &ia[0],
                                ipn,
                            );
                        }
                        let rs = mn.as_data.function.returns;
                        if rs.len == 1 {
                            let r0 = unsafe (*ma).list(rs)[0];
                            self.subst_type(
                                self.lower_type_in(it.module, unsafe (*ma).slot_type_node(r0)),
                                &ip[0],
                                &ia[0],
                                ipn,
                            );
                        }
                    }
                }
            }
            ii = ii + 1;
        }
    }

    // is_assignable marks every binding whose mutability answered a requirement; a `mut`
    // binding that is referenced but never marked can drop the keyword. Unreferenced bindings are
    // the unused-variable lint's business (and cover @platform-dropped items, which never resolve).
    @c.cold
    // Duplicates are harmless: tc_lint_unneeded_mut folds the list into a per-node table.
    fn tc_mark_mut_used(self: &mut Self, decl: NodeId) {
        if self.lint {
            self.mut_used.push(decl);
        }
    }

    // Delete [from, to) when it holds no grouping parens (`*(&x)` would leave text unbalanced).
    @c.cold
    fn tc_lint_pair_fix(self: &mut Self, from: u32, to: u32) {
        let mut j = from;
        while j < to {
            if self.source[j as usize] == b'(' || self.source[j as usize] == b')' {
                return;
            }
            j = j + 1;
        }
        if from < to {
            self.errors.fix(from, to, 0);
        }
    }

    // Lint: `(*e).member` with `e` a reference; member access auto-derefs references, so the explicit
    // `(*...)` deref is redundant; `e.member` resolves to the identical field/method. Warns and offers a
    // replace fix rewriting `(*e)` to `e`. A raw pointer is never auto-dereferenced: its `(*e)` stays.
    fn tc_lint_unnecessary_deref(self: &mut Self, obj_node: NodeId) {
        let a = self.cur_ast();
        let on = *unsafe (*a).at_const(obj_node);
        if on.kind != NodeKind::NODE_UNARY || on.as_data.unary.op != TokenType::Star {
            return;
        }
        let operand = on.as_data.unary.operand;
        if operand == NODE_NONE {
            return;
        }
        let ot = unsafe (*a).type_of(operand);
        if ot == TYPE_NONE || self.type_at(ot).kind != TypeKind::TYPE_REFERENCE || self.through_raw_pointer(ot) {
            return;
        }
        let star = on.span.start; // the `*`
        let n = self.source.len();
        // Postfix (`.`/`()`/`[]`) binds tighter than the deref, so `(*E).m` only parses with the receiver
        // parenthesized: the `(` sits immediately before the `*` (across horizontal whitespace). Its
        // matching `)` is then found by a balanced scan: the operand's own node span excludes any parens
        // it carries, so a nested `(*(*pp))` needs true paren matching, not the span's end.
        let mut lp = star;
        while lp > 0 && (self.source[(lp - 1) as usize] == b' ' || self.source[(lp - 1) as usize] == b'\t') {
            lp = lp - 1;
        }
        if lp == 0 || self.source[(lp - 1) as usize] != b'(' {
            return;
        }
        // The `(`.
        lp = lp - 1;
        let mut depth: i32 = 0;
        let mut j = lp;
        let mut rpe: u32 = 0; // past the matching `)`; 0 = not found
        while j as usize < n {
            let c = self.source[j as usize];
            if c == b'"' || c == b'\'' {
                // Skip a string/char literal so a `)` inside it never miscounts the depth.
                j = j + 1;
                while j as usize < n {
                    let d = self.source[j as usize];
                    if d == b'\\' {
                        j = j + 2;
                        continue;
                    }
                    j = j + 1;
                    if d == c {
                        break;
                    }
                }
                continue;
            }
            if c == b'(' {
                depth = depth + 1;
            } else if c == b')' {
                depth = depth - 1;
                if depth == 0 {
                    rpe = j + 1;
                    break;
                }
            }
            j = j + 1;
        }
        if rpe == 0 {
            return;
        }
        // Keep everything after the `*`, trimmed: that is E exactly as written (its own parens included).
        let mut ts = star + 1;
        while ts < rpe - 1 && (self.source[ts as usize] == b' ' || self.source[ts as usize] == b'\t') {
            ts = ts + 1;
        }
        let mut te = rpe - 1;
        while te > ts && (self.source[(te - 1) as usize] == b' ' || self.source[(te - 1) as usize] == b'\t') {
            te = te - 1;
        }
        self.errors.warn(
            lp,
            rpe - lp,
            format("unnecessary deref: '.' auto-derefs the receiver, so '(*...)' is redundant"),
        );
        self.errors.fix_replace(lp, rpe, String::from_str(diag::span_str(self.source, ts, te)));
    }

    // Attach the `mut ` deletion fix: the keyword sits right before the name, across whitespace.
    @c.cold
    fn tc_lint_mut_fix(self: &mut Self, nsp: tok::Span) {
        let mut i = nsp.start as usize;
        while i > 0 && (self.source[i - 1] == b' ' || self.source[i - 1] == b'\t' || self.source[i - 1] == b'\n' || self.source[i - 1] == b'\r') {
            i = i - 1;
        }
        if i >= 3 && self.source[i - 3] == b'm' && self.source[i - 2] == b'u' && self.source[i - 1] == b't' {
            self.errors.fix((i - 3) as u32, nsp.start, 0);
        }
    }

    // A `free` method's body: every module declaration a node inside it resolves to, recorded
    // for the free-glue emission (`Ast::free_touched`), which runs after the body syntax is gone.
    // The body's nodes are the post-order run ending at its block (walked back while the span
    // starts inside the block) plus what this check appended from `appended_from`.
    fn tc_record_free_touches(self: &mut Self, fnid: NodeId, fnd: FunctionData, appended_from: usize) {
        if fnd.params.len == 0 || fnd.body == NODE_NONE {
            return;
        }
        let a = self.cur_ast();
        let nsp = unsafe (*a).at_const(fnd.name).as_data.name.text;
        if self.source.slice(nsp.start as usize, nsp.end as usize) != "free" {
            return;
        }
        let bsp = unsafe (*a).at_const(fnd.body).span;
        let m = self.cur_module();
        let tag = fnd.body & NODE_BODY;
        let root = (fnd.body & NODE_BODY_MASK) as usize;
        let mut lo = root;
        while lo > 0 && unsafe (*a).at_const((lo - 1) as NodeId | tag).span.start >= bsp.start {
            lo -= 1;
        }
        let end = if tag != 0 {
            unsafe (*a).b.nodes.len();
        } else {
            unsafe (*a).nodes.len();
        };
        let mut i = lo;
        while i < end {
            if i > root && i < appended_from {
                i = appended_from;
                continue;
            }
            let d = unsafe (*a).resolution_def(i as NodeId | tag);
            if d.module == m && d.node != NODE_NONE {
                unsafe (*a).record_free_touch(fnid, d.node);
            }
            i += 1;
        }
    }

    fn tc_lint_unneeded_mut(self: &mut Self) {
        let a = self.cur_ast();
        let n = unsafe (*a).nnodes();
        let mut used = Vector::<bool>::new();
        let mut marked = Vector::<bool>::new();
        used.reserve(n);
        marked.reserve(n);
        for i in 0..n {
            used.push(false);
            marked.push(false);
        }
        for k in 0..n {
            let i = unsafe (*a).nth_id(k);
            let d = unsafe (*a).resolution_def(i);
            if d.node != NODE_NONE && d.module == self.cur_module() && unsafe (*a).valid(d.node) && i != d.node {
                used.set(unsafe (*a).dense(d.node), true);
            }
        }
        for i in 0..self.mut_used.len() {
            if unsafe (*a).valid(self.mut_used[i]) {
                marked.set(unsafe (*a).dense(self.mut_used[i]), true);
            }
        }
        let mut k9: usize = 1;
        while k9 < n {
            let i = unsafe (*a).nth_id(k9);
            let nd = *unsafe (*a).at_const(i);
            let mut nn = NODE_NONE;
            if nd.kind == NodeKind::NODE_LET && nd.as_data.let_stmt.is_mutable && nd.as_data.let_stmt.name != NODE_NONE {
                nn = nd.as_data.let_stmt.name;
            } else if nd.kind == NodeKind::NODE_PARAMETER && nd.as_data.parameter.is_mutable {
                nn = nd.as_data.parameter.name;
            } else if nd.kind == NodeKind::NODE_PATTERN_NAME && nd.as_data.pattern.name != NODE_NONE && unsafe (*a).at_const(
                nd.as_data.pattern.name,
            ).as_data.name.is_mutable {
                nn = nd.as_data.pattern.name;
            } else if nd.kind == NodeKind::NODE_IDENTIFIER && nd.as_data.name.is_mutable {
                nn = i; // a tuple-let element (a parameter's name node is never a use target)
            }
            if nn != NODE_NONE && used[k9] && !marked[k9] {
                let sp = unsafe (*a).at_const(nn).as_data.name.text;
                // Code the platform filter removed may hold the only write.
                if sp.end > sp.start && self.source[sp.start as usize] != b'_' && !unsafe (*a).bc_removed_name(
                    self.source.slice(sp.start as usize, sp.end as usize),
                ) {
                    self.errors.warn_span(
                        sp,
                        format("'{}' does not need to be mutable", diag::span_str(self.source, sp.start, sp.end)),
                    );
                    self.tc_lint_mut_fix(sp);
                }
            }
            k9 += 1;
        }
    }

    /// Entry point: types every top-level item in declaration order, closes concrete generic
    /// instances (interning their methods' signature types), runs whole-module lints, and
    /// finalizes diagnostics. The typed Ast stays in its module slot; the borrowck pass re-walks
    /// it from there. The driver's item scheduler runs the same three steps per item.
    pub fn check(self: &mut Self) {
        self.check_open();
        let items = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).root).as_data.program.items;
        let mut prev: NodeId = 0;
        for i in 0..items.len {
            let it9 = unsafe (*self.cur_ast()).list(items)[i as usize];
            self.check_one(it9, prev);
            prev = it9;
        }
        self.check_close();
    }

    /// The module's first step: the item index (a pipeline without the driver's resolve
    /// frontier, the lint and the harness, opens it here: the engine's visibility query needs
    /// the item records) and the type side tables.
    pub fn check_open(self: &mut Self) {
        if !unsafe (*self.package).sched.built {
            gitems::open(unsafe &mut *self.package);
        }
        unsafe (*self.cur_ast()).init_types();
        unsafe (*self.cur_ast()).clear_steps();
    }

    /// Check top-level item `it9`; `lo` is the node of the top-level item before it (0 for the
    /// first): the exclusive start of its own module-arena range. Readiness: Checking while the
    /// item's facts are written, Checked once they are published (the constant engine
    /// interprets a function body only from Checked: an unchecked body would evaluate with
    /// degraded widths).
    pub fn check_one(self: &mut Self, it9: NodeId, lo: NodeId) {
        let mut t0: u64 = 0;
        self.cur_top = it9;
        self.cur_lo = lo;
        let rec9 = unsafe (*self.package).item_of(self.cur_module(), it9);
        if rec9 != loader::ITEM_NONE {
            unsafe (*self.package).set_item_state_deep(rec9, loader::IS_CHECKING);
        }
        if unsafe (*self.package).icost_on {
            t0 = std::parallel::platform::now_ns();
        }
        self.cur_item = rec9;
        self.reach_ready();
        self.tc_check_bindings(lo, it9);
        self.check_item(it9);
        if rec9 != loader::ITEM_NONE {
            self.tc_publish_steps(rec9);
        }
        if t0 != 0 {
            unsafe (*self.package).icost_tc.push(self.cur_module() as u64 << 32 | it9 as u64);
            unsafe (*self.package).icost_tc.push(std::parallel::platform::now_ns() - t0);
        }
        if rec9 != loader::ITEM_NONE {
            unsafe (*self.package).set_item_state_deep(rec9, loader::IS_CHECKED);
        }
        self.cur_item = loader::ITEM_NONE;
        self.cur_top = NODE_NONE;
        self.cur_lo = 0;
    }

    /// The module's last step, after every item: the instance closure, the whole-module lints,
    /// the finalized diagnostics.
    pub fn check_close(self: &mut Self) {
        assert(self.st_pend.len() == 0, "every const-generic step is published with its item's check");
        self.close_instances();
        if self.lint {
            self.tc_lint_unneeded_mut();
        }
        let mut file: str = "";
        if self.cur_module() as usize < self.pkg_count() {
            file = unsafe (*self.package).modules[self.cur_module() as usize].file.as_str();
        }
        self.errors.finalize(self.source, file);
        if unsafe TS_ON {
            ts_add(TS_LOWER_MEMO_N, self.lower_memo.len() as u64);
        }
    }

    /// Check the module's top-level nodes that are no item (a `static_assert`) after every item
    /// of the module: the reader is the module's last item with every component the module's
    /// items depend on, and the module's own, as visible (`gitems::Reach::of_module`). Each
    /// node's diagnostics land in `orphan_errs`, in declaration order.
    pub fn check_orphans(self: &mut Self) {
        if !unsafe (*self.package).sched.built {
            return;
        }
        let m = self.cur_module();
        let i0 = unsafe (*self.package).idx.mod_items[m as usize];
        let i1 = unsafe (*self.package).idx.mod_items[m as usize + 1];
        if i1 == i0 {
            return;
        }
        let items = unsafe (*self.cur_ast()).at_const(unsafe (*self.cur_ast()).root).as_data.program.items;
        let mut prev: NodeId = 0;
        let mut set = false;
        for i in 0..items.len {
            let it9 = unsafe (*self.cur_ast()).list(items)[i as usize];
            if unsafe (*self.package).item_of(m, it9) != loader::ITEM_NONE {
                prev = it9;
                continue;
            }
            if !set {
                self.reach.of_module(unsafe &*self.package, m as usize);
                self.cur_item = i1 - 1;
                set = true;
            }
            self.cur_top = it9;
            self.cur_lo = prev;
            let held = replace(&mut self.errors, diag::Errors::new());
            self.check_item(it9);
            let mine = replace(&mut self.errors, held);
            self.orphan_errs.push(mine);
            prev = it9;
        }
        self.cur_item = loader::ITEM_NONE;
        self.cur_top = NODE_NONE;
        self.cur_lo = 0;
    }

    /// Is declaration `decl` of the current module inside the item under check: a body-arena
    /// node (only the item's own bodies hold those), a module-arena node in the item's own range,
    /// or a node appended after parsing (a desugar or a rewrite inside the body it extends)?
    /// Outside `check_one` (the borrow pass, the obligation passes) nothing is own: those
    /// readers lower privately and write no slot.
    const fn decl_is_own(self: &Self, decl: NodeId) bool {
        if self.cur_top == NODE_NONE {
            return false;
        }
        return Ast::in_body(decl) || decl > self.cur_lo && decl <= self.cur_top || decl >= unsafe (*self.cur_ast()).hir_base;
    }

    /// Is the checked state of node `n` of module `m` visible to the item under check
    /// (`gitems::visible`)? Everything is once no item is under check.
    fn node_visible(self: &mut Self, m: ModuleId, n: NodeId) bool {
        if self.cur_item == loader::ITEM_NONE {
            return true;
        }
        let t = gitems::owner_of(unsafe &*self.package, m, n);
        if t == loader::ITEM_NONE {
            return true;
        }
        return gitems::visible(unsafe &*self.package, self.cur_item, t, &mut self.reach);
    }

    /// Point `reach` at the item under check's component.
    fn reach_ready(self: &mut Self) {
        let sch = unsafe &(*self.package).sched;
        if sch.ncomp != 0 && self.cur_item != loader::ITEM_NONE {
            self.reach.of_comp(unsafe &*self.package, sch.comp[self.cur_item as usize]);
        }
    }

    // Take (`on`) or release the constant engine's lock; no-op without an engine.
    fn eng_hold(self: &Self, on: bool) {
        let ce = self.cir();
        if ce != null && on {
            unsafe (*ce).eng_lock();
        } else if ce != null {
            unsafe (*ce).eng_unlock();
        }
    }

    // Take the engine's lock and read as the item under check (`on`), or stop reading and release it.
    fn eng_read(self: &mut Self, on: bool) {
        let ce = self.cir();
        if on {
            unsafe (*ce).eng_lock();
            unsafe (*ce).set_reader(self.cur_item, &mut self.reach);
        } else {
            unsafe (*ce).set_reader(loader::ITEM_NONE, null);
            unsafe (*ce).eng_unlock();
        }
    }

    /// Fold node `id` of module `m` through the engine as the item under check: the engine
    /// answers with the item's visibility (a callee it may not see is a refusal, never a value).
    fn ev(self: &mut Self, m: ModuleId, id: NodeId) iri::IVal {
        let ce = self.cir();
        self.eng_read(true);
        unsafe (*ce).err_refused = false;
        let v = unsafe (*ce).eval(m, id);
        self.ev_err = self.ev_err || unsafe (*ce).err_refused;
        self.eng_read(false);
        return v;
    }

    fn ev_static(self: &mut Self, m: ModuleId, id: NodeId) iri::StaticRes {
        let ce = self.cir();
        self.eng_read(true);
        unsafe (*ce).err_refused = false;
        let r = unsafe (*ce).eval_static(m, id);
        self.ev_err = self.ev_err || unsafe (*ce).err_refused;
        self.eng_read(false);
        return r;
    }

    /// The def-site `const fn` re-scan as the item under check (its visibility decides what the
    /// scan reads as typed).
    fn fn_recheck_as(self: &mut Self, m: ModuleId, id: NodeId) u8 {
        let ce = self.cir();
        self.eng_read(true);
        unsafe (*ce).err_refused = false;
        let r = unsafe (*ce).fn_recheck(m, id);
        self.ev_err = self.ev_err || unsafe (*ce).err_refused;
        self.eng_read(false);
        return r;
    }

    /// True once any type error is recorded.
    pub const fn has_errors(self: &Self) bool {
        return self.errors.has_errors();
    }
    /// Print the accumulated diagnostics to stderr.
    pub fn log_errors(self: &Self) {
        self.errors.log();
    }
}
