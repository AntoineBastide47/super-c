        AtanP => horner(z, &ATAN_P),
        ErfP => horner(z, &ERF_P),
        ExpT => horner(z, &EXP_T),
        LogT => horner(z, &LOG_T),
        LogTP => horner(z, &LOG_T),
        SinhP => horner(z, &SINH_P),
        TanhP => horner(z, &TANH_P),
        ExpF => horner(z, &EXP_F),
        ExpB => horner(z, &EXP_B),
        LogF => horner(z, &LOG_F),
        SinF => horner(z, &SIN_F),
        TanF => horner(z, &TAN_F),
        AsinF => horner(z, &ASIN_F),
        AtanF => horner(z, &ATAN_F),
