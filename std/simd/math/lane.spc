// The shared kernels of the vector math classes (`std::simd::math`, `balanced`, `fast`): the `Lane`
// interface that gives each float lane type its constants, polynomials and bit-level steps, and the
// building blocks over it: exact double-word sums and products, scaling by 2^k, the exponential and
// logarithm kernels and the pi/2 reduction. Every block is a fixed sequence of portable operations
// (one rounding per `fma`), so a result is the same on every target and at compile time, a NaN's sign
// and payload aside (the hardware's default NaN differs). The classes are the stable interface; this
// module is theirs.
import std::simd::math::coeffs_f32 as c32;
import std::simd::math::coeffs_f64 as c64;

/// The constants of one lane type's kernels; `coeffs_f32.spc` and `coeffs_f64.spc` (generated by
/// `tools/simd_math`) hold the values. A `*_hi`, `*_lo` pair is a double word: `hi` the constant
/// rounded, `lo` the rest rounded.
pub struct Konsts<T> {
    pub emin: T, // the smallest normal exponent
    pub emax: T, // the largest exponent
    pub min_normal: T,
    pub sub_scale: T, // 2^sub_bits lifts a subnormal to a normal
    pub sub_bits: T,
    pub ln2_hi: T,
    pub ln2_lo: T,
    pub exp_max: T, // above: e^x overflows
    pub exp_min: T, // below: e^x rounds to 0
    pub exp2_max: T,
    pub exp2_min: T,
    pub log2_10: T,
    pub lg2_hi: T, // log10(2)
    pub lg2_lo: T,
    pub ln10_hi: T,
    pub ln10_lo: T,
    pub exp10_max: T,
    pub exp10_min: T,
    pub expm1_min: T, // below: e^x - 1 rounds to -1
    pub sqrt2: T,
    pub log2e_hi: T, // 1 / ln 2 (rounded: the multiplier of the reductions)
    pub log2e_lo: T,
    pub log10e_hi: T, // 1 / ln 10
    pub log10e_lo: T,
    pub two_thirds_hi: T,
    pub two_thirds_lo: T,
    pub two_fifths_hi: T,
    pub two_fifths_lo: T,
    pub two_over_pi: T,
    pub pio2_1: T, // pi/2 = pio2_1 + .. + pio2_4: the first three short enough for exact k pio2_i
    pub pio2_2: T,
    pub pio2_3: T,
    pub pio2_4: T,
    pub pio2_2f: T, // pi/2 = pio2_1 + pio2_2f + pio2_3f, the last two rounded
    pub pio2_3f: T,
    pub cw_max: T, // from here the bit reduction (`rem_pio2_big`)
    pub pio2_hi: T, // pi/4: pio2_hi and pio2_lo times 1/2, exact
    pub pio2_lo: T,
    pub pi_hi: T,
    pub pi_lo: T,
    pub tan_pio8: T,
    pub tan_3pio8: T,
    pub tiny: T, // below: sin x, tan x, sinh x, asinh x, atanh x, .. round to x
    pub big: T, // above: asinh x and acosh x are log(2x)
    pub hyp_big: T, // above: e^-|x| no longer reaches cosh, sinh, tanh
    pub cosh_max: T, // above: cosh and sinh overflow
    pub tanh_one: T, // above: tanh rounds to 1
    pub two_sqrtpi_hi: T, // 2 / sqrt(pi)
    pub two_sqrtpi_lo: T,
    pub erfc_max: T, // above: erfc rounds to 0; the end of the erfc table
    pub hyp_lo: T, // hypot: from here to `hyp_hi` the squares neither overflow nor lose bits
    pub hyp_hi: T,
    pub exp_norm: T, // below: e^x is subnormal (the fast class flushes it)
    pub exp10_norm: T, // below: 10^x is subnormal
    pub inv_ln2n: T, // 128 / ln2: the table exp (f64), x = k ln2/128 + r
    pub ln2n_hi: T, // ln2/128, k ln2n_hi exact for |k| < 2^18
    pub ln2n_lo: T,
    pub inv_lg2n: T, // 128 log2(10): the table 10^x
    pub lg2n_hi: T, // log10(2)/128 in two parts, as ln2n
    pub lg2n_lo: T,
}

/// The polynomials of the classes, by name: `coeffs_f32.spc` and `coeffs_f64.spc` hold one array per
/// name with its interval, degree and achieved error.
pub enum Poly {
    ExpP,
    LogP,
    LogkP,
    SinP,
    CosP,
    TanP,
    AsinP,
    AtanP,
    ErfP,
    ExpT,
    LogT,
    LogTP,
    SinhP,
    TanhP,
    ExpF,
    ExpB,
    LogF,
    SinF,
    TanF,
    AsinF,
    AtanF,
    CbrtP,
    CbrtB,
}

/// A float lane type of the math kernels: `f32` or `f64`.
pub interface Lane: SimdFloat {
    /// `v` in this type, for the constants the kernels write as literals (each exact in both types).
    fn c(v: f64) Self;
    /// The kernel constants of this type.
    fn kc() &'static Konsts<Self>;
    /// Polynomial `P` at `z`.
    fn poly<const P: Poly, const N: usize>(z: Simd<Self, N>) Simd<Self, N>;
    /// 2^k for integer-valued k in [emin, emax] (another k gives bits the caller discards).
    fn pow2i<const N: usize>(k: Simd<Self, N>) Simd<Self, N>;
    /// `(m, e)` with x = m 2^e, m in [1, 2), for positive normal x.
    fn frexp<const N: usize>(x: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>);
    /// The pi/2 reduction of finite |x| >= `cw_max` (`rem_pio2`'s contract): f64 by exact integer
    /// arithmetic on the bits of 2/pi, f32 by the f64 reduction of x.
    fn rem_pio2_big<const N: usize>(x: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>, Simd<Self, N>);
    /// `n` as an exact double word.
    fn of_i32<const N: usize>(n: Simd<i32, N>) (Simd<Self, N>, Simd<Self, N>);
    /// y 2^k by an add to the exponent field (wrapping: a lane outside the range below gives bits the
    /// caller discards): for integer-valued k and a normal, finite result; y itself for a NaN k.
    fn add_exp<const N: usize>(y: Simd<Self, N>, k: Simd<Self, N>) Simd<Self, N>;
    /// erfc(a) e^(a^2) as a double word from piece `i` of the erfc table (`erfc_dw`).
    fn erfc_g<const N: usize>(a: Simd<Self, N>, i: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>);
    /// e^(xh + xl) = (h + l) 2^k, h + l within a factor 2 of 1, for a small xl (below 2^-p |xh|), l
    /// not normalized (up to 2^-8 h): f32 by `expk_p`, f64 by a 128-entry table to about 2^-62.
    fn expk<const N: usize>(xh: Simd<Self, N>, xl: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>, Simd<Self, N>);
    /// `(e, a, b, im)` for positive x: log x = e ln2 + a + b, a + b = log m as a double word for x =
    /// m 2^e, and im about 1/m (to 2^-10): f32 by `log_parts_p`, f64 by a 128-entry table.
    fn log_parts<const N: usize>(x: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>, Simd<Self, N>, Simd<Self, N>);
    /// log x as a double word for positive x, the logarithm `pow` needs (an error of y log x is one of
    /// the result times |y log x|): f32 by `logk_p` to 2^-(2p - 16), f64 by the table to 2^-68.
    fn logk<const N: usize>(x: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>);
    /// `(e, v, im)` for positive x = m 2^e: v = log m in one word (the `balanced` class's), im about
    /// 1/m (to 2^-10): f32 by `log1p_f`, f64 by the table.
    fn log_b<const N: usize>(x: Simd<Self, N>) (Simd<Self, N>, Simd<Self, N>, Simd<Self, N>);
    /// An integer-valued, non-negative k below 2^31 as a table index.
    fn index<const N: usize>(k: Simd<Self, N>) Simd<u32, N>;
    /// +infinity in every lane, from its encoding.
    fn inf<const N: usize>() Simd<Self, N>;
    /// The positive quiet NaN in every lane, from its encoding.
    fn nan<const N: usize>() Simd<Self, N>;
}

/// `v` in every lane.
pub fn sp<T: Lane, const N: usize>(v: f64) Simd<T, N> {
    return Simd::splat(T::c(v));
}

/// +infinity in every lane. From the encoding, not 1/0: a C compiler keeps a division that raises a
/// floating-point exception, at run time.
pub fn inf<T: Lane, const N: usize>() Simd<T, N> {
    return T::inf::<N>();
}

/// max_num(v, lo) for a bound lo that is neither NaN nor -0, as one comparison and choice (x86's
/// `maxps`; its `max_num` is a sequence): lo for a NaN v.
pub const fn at_least<T: Lane, const N: usize>(v: Simd<T, N>, lo: Simd<T, N>) Simd<T, N> {
    return choose(v.greater_than(lo), v, lo);
}

/// min_num(v, hi) for a nonzero bound hi that is not NaN, as `at_least`: hi for a NaN v.
pub const fn at_most<T: Lane, const N: usize>(v: Simd<T, N>, hi: Simd<T, N>) Simd<T, N> {
    return choose(v.less_than(hi), v, hi);
}

/// `p(z)` for coefficients `c`, lowest power first (`eval_pairs`).
pub fn horner<T: SimdFloat, const N: usize, const K: usize>(z: Simd<T, N>, c: &[T; K]) Simd<T, N> {
    let mut v: [Simd<T, N>; K] = [Simd::<T, N>::splat(unsafe c[0]); K];
    for i in 1..K {
        unsafe v[i] = Simd::splat(unsafe c[i]);
    }
    return eval_pairs(z, &mut v, K);
}

/// `v[0] + v[1] z + .. + v[n - 1] z^(n - 1)`, n at most K: the pairs a + b z, then Horner's rule over
/// them in z^2. No power past z^2 is formed (z^4 of a small f32 z underflows, and an x86 core takes a
/// microcode assist for each subnormal result), and the dependency chain is half of Horner's rule over
/// z. `v` is scratch.
pub fn eval_pairs<T: SimdFloat, const N: usize, const K: usize>(z: Simd<T, N>, v: &mut [Simd<T, N>; K], n: usize) Simd<
    T,
    N
> {
    for j in 0..n / 2 {
        unsafe v[j] = unsafe v[2 * j + 1].fma(z, unsafe v[2 * j]);
    }
    if n % 2 == 1 {
        unsafe v[n / 2] = unsafe v[n - 1];
    }
    let m = (n + 1) / 2;
    let z2 = z * z;
    let mut r = unsafe v[m - 1];
    for j in 1..m {
        r = r.fma(z2, unsafe v[m - 1 - j]);
    }
    return r;
}

/// P(u) as a double word, u = a - mid, from piece `i` of table `t` of S values per piece: mid, then P
/// lowest power first, its constant as hi and lo (u is exact: a is within a sixteenth of mid).
pub fn table_poly<T: Lane, const N: usize, const S: usize>(a: Simd<T, N>, i: Simd<T, N>, t: []T) (
    Simd<T, N>,
    Simd<T, N>
) {
    // Each lane's row is contiguous: its start read once, then every value at a fixed offset from it.
    let b = T::index(i * T::c(S as f64)).to_array();
    let u = a - col::<T, N>(t, &b, 0);
    // P(u) = c0 + u (c1 + c2 u + ..), c0 the double word t[1], t[2], c1.. from t[3]: the n values from
    // t[3] by `eval_pairs`'s steps, each pair read where it is used (an array of them stays in memory
    // in gcc's code).
    let n = S - 3;
    let u2 = u * u;
    let mut r = if n % 2 == 1 {
        col::<T, N>(t, &b, 2 + n);
    } else {
        col::<T, N>(t, &b, 2 + n).fma(u, col::<T, N>(t, &b, 1 + n));
    };
    for jj in 1..(n + 1) / 2 {
        let j = (n + 1) / 2 - 1 - jj;
        r = r.fma(u2, col::<T, N>(t, &b, 4 + 2 * j).fma(u, col::<T, N>(t, &b, 3 + 2 * j)));
    }
    let (h, l) = fast_two_sum(col::<T, N>(t, &b, 1), u.fma(r, col::<T, N>(t, &b, 2)));
    return h, l;
}

// Value `k` of each lane's row: lane j's from t[b[j] + k].
fn col<T: Lane, const N: usize>(t: []T, b: &[u32; N], k: usize) Simd<T, N> {
    let mut v: [T; N] = [T::c(0.0); N];
    for j in 0..N {
        // In the table: the index is a clamped argument's piece (`erfc_g`).
        unsafe v[j] = *unsafe t.get_unsafe((unsafe b[j]) as usize + k);
    }
    return Simd::from_array(v);
}

/// `(s, e)` with s + e = a + b exactly (Knuth).
pub const fn two_sum<T: Lane, const N: usize>(a: Simd<T, N>, b: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let s = a + b;
    let bb = s - a;
    return s, a - (s - bb) + (b - bb);
}

/// `two_sum` when |a| >= |b| or a = 0 in every lane (Dekker).
pub const fn fast_two_sum<T: Lane, const N: usize>(a: Simd<T, N>, b: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let s = a + b;
    return s, b - (s - a);
}

/// `(p, e)` with p + e = a b exactly.
pub const fn two_prod<T: Lane, const N: usize>(a: Simd<T, N>, b: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let p = a * b;
    return p, a.fma(b, -p);
}

/// `(h + l) / (dh + dl)` as a double word, about 2^-2p relative error: one division, q = h (1/dh), and
/// the remainder (h + l) - q (dh + dl) (its first product exact in an fma) times 1/dh.
pub fn dw_div<T: Lane, const N: usize>(h: Simd<T, N>, l: Simd<T, N>, dh: Simd<T, N>, dl: Simd<T, N>) (
    Simd<T, N>,
    Simd<T, N>
) {
    let r = sp::<T, N>(1.0) / dh;
    let q = h * r;
    let (zh, zl) = fast_two_sum(q, (-q).fma(dl, (-q).fma(dh, h) + l) * r);
    return zh, zl;
}

/// `sqrt(h + l)` as a double word, for h + l >= 0.
pub fn dw_sqrt<T: Lane, const N: usize>(h: Simd<T, N>, l: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let s = h.sqrt();
    return s, choose(h.equal(sp(0.0)), h, ((-s).fma(s, h) + l) / (s + s));
}

/// NaN in every lane (as `inf`, from the encoding).
pub fn nan<T: Lane, const N: usize>() Simd<T, N> {
    return T::nan::<N>();
}

/// `(m, e)` with x = m 2^e, m in [1, 2), for positive x (subnormals included).
pub fn frexp_any<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let sub = x.less_than(Simd::splat(kc.min_normal));
    let (m, e) = T::frexp(choose(sub, x * kc.sub_scale, x));
    return m, e - choose(sub, Simd::splat(kc.sub_bits), sp::<T, N>(0.0));
}

/// y 2^k for integer-valued k: one product where 2^k is normal, else two (the first exact for y in
/// [1/2, 2], or a scale up), so that a subnormal result rounds once; a k past twice the exponent range
/// overflows or underflows. A lane's product does not depend on its neighbors' k.
pub fn scale<T: Lane, const N: usize>(y: Simd<T, N>, k: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    // k outside [emin, emax] = [1 - emax, emax]: one comparison, |k - 1/2| > emax - 1/2.
    let far = (k - T::c(0.5)).abs().greater_than(Simd::<T, N>::splat(kc.emax) - T::c(0.5));
    if unlikely(far.any()) {
        let kk = at_most(
            at_least(k, Simd::<T, N>::splat(kc.emin) * T::c(2.0)),
            Simd::<T, N>::splat(kc.emax) * T::c(2.0),
        );
        let h = choose(far, (kk * T::c(0.5)).floor(), sp(0.0));
        return y * T::pow2i(h) * T::pow2i(kk - h);
    }
    return y * T::pow2i(k);
}

/// y, or inf where x > hi, or `under` where x < lo: an exponential's range ends.
pub fn exp_range<T: Lane, const N: usize>(x: Simd<T, N>, hi: T, lo: T, under: f64, y: Simd<T, N>) Simd<T, N> {
    return choose(x.greater_than(Simd::splat(hi)), inf(), choose(x.less_than(Simd::splat(lo)), sp(under), y));
}

/// The exponential y 2^k of x (k from x by rounding): one product while 2^k is normal, which puts x
/// inside the range ends; else `scale` and `exp_range` (hi, lo, under), only when a lane needs them. A
/// NaN x has a NaN y.
pub fn exp_fin<T: Lane, const N: usize>(x: Simd<T, N>, hi: T, lo: T, under: f64, y: Simd<T, N>, k: Simd<T, N>) Simd<
    T,
    N
> {
    let kc = T::kc();
    let r = y * T::pow2i(k);
    let out = k.greater_than(Simd::splat(kc.emax)) | k.less_than(Simd::splat(kc.emin));
    if unlikely(out.any()) {
        return choose(out, exp_range(x, hi, lo, under, scale(y, k)), r);
    }
    return r;
}

/// e^(r + rl) as h + l for |r| <= ln2/2 and a small rl (below 2^-(p/2)), about 2^-(p + 7) relative
/// error: 1 + r and r^2/2 exact, r^3 P(r) the rounded rest, and rl as the factor 1 + rl (l is not
/// normalized against h).
pub fn exp_core<T: Lane, const N: usize>(r: Simd<T, N>, rl: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let (r2h, r2l) = two_prod(r, r);
    let (h, l) = fast_two_sum(sp::<T, N>(1.0), r);
    let (h2, l2) = fast_two_sum(h, r2h * T::c(0.5));
    let lo = l2 + (l + (r2h * r).fma(T::poly::<{Poly::ExpP}>(r), r2l * T::c(0.5)));
    // e^(r + rl) = e^r (1 + rl), e^r = h2 + lo.
    return h2, rl.fma(h2 + lo, lo);
}

/// e^(r + rl) rounded once, for |r| <= ln2/2 and a small rl (below 2^-(p/2)): 1 + r exact, e^r - 1 - r
/// = r^2 (1/2 + r P(r)) in one word, and the factor 1 + rl; about a fifth of an ULP before the rounding.
pub fn exp_rw<T: Lane, const N: usize>(r: Simd<T, N>, rl: Simd<T, N>) Simd<T, N> {
    let w = r * r * r.fma(T::poly::<{Poly::ExpP}>(r), sp(0.5));
    let (h, lo) = fast_two_sum(sp::<T, N>(1.0), r);
    return h + (lo + rl.fma(h + w, w));
}

/// e^(xh + xl) = (h + l) 2^k with h + l in [0.7, 1.42], 2^-(p + 4) relative error.
pub fn expk_p<T: Lane, const N: usize>(xh: Simd<T, N>, xl: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let k = (xh * kc.log2e_hi).round_even();
    let r1 = (-k).fma(Simd::splat(kc.ln2_hi), xh); // exact: |r1| < 1 needs at most p bits
    let t = k * kc.ln2_lo;
    let (r, e) = two_sum(r1, -t);
    let (h, l) = exp_core(r, e + xl - k.fma(Simd::splat(kc.ln2_lo), -t));
    return h, l, k;
}

/// The Annex F results of a logarithm of x around its value `y`: -inf at 0, NaN below 0 and for NaN,
/// inf at inf.
pub fn log_special<T: Lane, const N: usize>(x: Simd<T, N>, y: Simd<T, N>) Simd<T, N> {
    let r = choose(x.equal(inf()), x, choose(x.equal(sp(0.0)), -inf::<T, N>(), y));
    return choose(x.greater_equal(sp(0.0)), r, nan());
}

/// `(f, e)`: x = (1 + f) 2^e with 1 + f in [sqrt(1/2), sqrt(2)) and f exact, for positive x.
pub fn log_split<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let (m0, e0) = frexp_any(x);
    let (f, e) = log_split_m(m0, e0);
    return f, e;
}

/// `log_split` from x = m0 2^e0, m0 in [1, 2).
pub fn log_split_m<T: Lane, const N: usize>(m0: Simd<T, N>, e0: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let big = m0.greater_than(Simd::splat(T::kc().sqrt2));
    return choose(big, m0 * T::c(0.5), m0) - T::c(1.0), choose(big, e0 + T::c(1.0), e0);
}

/// `Lane::log_parts` by a polynomial: x = (1 + f) 2^e, 1 + f in [sqrt(1/2), sqrt(2)), log(1 + f) =
/// f - f^2/2 + s (f^2/2 + s^2 P(s^2)) with s = f / (2 + f), and 1/(1 + f) = (1 - s)/(1 + s) as 1 + q,
/// q = -2s (1 - s)(1 + s^2) to 2^-10.
pub fn log_parts_p<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let (f, e) = log_split(x);
    let s = f / (sp::<T, N>(2.0) + f);
    let z = s * s;
    let (qh, ql) = two_prod(f * T::c(0.5), f); // f^2 / 2, exact
    let t = s * (qh + z * T::poly::<{Poly::LogP}>(z));
    let (a, b) = two_sum(f, -qh);
    return e, a, b - ql + t, (-(s + s) * (sp::<T, N>(1.0) - s)).fma(s.fma(s, sp(1.0)), sp(1.0));
}

/// `(v, im)`: log(1 + f) = v for 1 + f in [sqrt(1/2), sqrt(2)] (fdlibm: s = f / (2 + f), f - f^2/2 +
/// s (f^2/2 + s^2 P(s^2))), and im = 1/(1 + f) to 2^-10 (as `log_parts_p`).
pub fn log1p_f<T: Lane, const N: usize>(f: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let s = f / (sp::<T, N>(2.0) + f);
    let z = s * s;
    let hf = f * f * T::c(0.5);
    return f - (hf - s * z.fma(T::poly::<{Poly::LogP}>(z), hf)), (-(s + s) * (sp::<T, N>(1.0) - s)).fma(
        s.fma(s, sp(1.0)),
        sp(1.0),
    );
}

/// log((h + l) 2^de) rounded, for a positive double word (|l| at most half an ULP of h) and an
/// integer-valued de: `log_parts` with e + de, and l/h as a correction without a division, u im with
/// u = l 2^-e and im about 1/m (h = m 2^e), which rounds once where the result is that itself (h + l
/// near 1).
pub fn log_hl<T: Lane, const N: usize>(h: Simd<T, N>, l: Simd<T, N>, de: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    let (e0, a, b, im) = T::log_parts(h);
    let c = l * T::pow2i(at_most(at_least(-e0, Simd::splat(kc.emin)), Simd::splat(kc.emax))) * im;
    let e = e0 + de;
    let (eh, el) = two_prod(e, Simd::splat(kc.ln2_hi));
    let (hh, hl) = two_sum(eh, a);
    return hh + (hl + (b + c + e.fma(Simd::splat(kc.ln2_lo), el)));
}

/// `Lane::logk` by a polynomial: log x as a double word with about 2^-(2p - 16) relative error, for
/// positive x.
pub fn logk_p<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let (f, e) = log_split(x);
    let (dh, d0) = two_sum(sp::<T, N>(2.0), f);
    let (sh, sl) = dw_div(f, sp(0.0), dh, d0); // s = f / (2 + f)
    // log(1 + f) = 2s + 2/3 s^3 + 2/5 s^5 + s^7 Q(s^2), the first three terms as double words.
    let (zh, z0) = two_prod(sh, sh);
    let zl = (sh + sh).fma(sl, z0);
    let (ch, c0) = two_prod(sh, zh);
    let cl = sh.fma(zl, sl.fma(zh, c0)); // s^3
    let (vh, v0) = two_prod(ch, zh);
    let vl = ch.fma(zl, cl.fma(zh, v0)); // s^5
    let (uh, u0) = two_prod(ch, Simd::splat(kc.two_thirds_hi));
    let ul = ch.fma(Simd::splat(kc.two_thirds_lo), cl.fma(Simd::splat(kc.two_thirds_hi), u0));
    let (wh, w0) = two_prod(vh, Simd::splat(kc.two_fifths_hi));
    let wl = vh.fma(Simd::splat(kc.two_fifths_lo), vl.fma(Simd::splat(kc.two_fifths_hi), w0));
    let tail = vh * zh * T::poly::<{Poly::LogkP}>(zh);
    let (ah, al) = two_sum(sh + sh, uh);
    let (bh, bl) = two_sum(ah, wh);
    let (eh, el) = two_prod(e, Simd::splat(kc.ln2_hi));
    let (hh, hl) = two_sum(eh, bh);
    let lo = hl + (bl + al + (sl + sl) + ul + wl + tail + e.fma(Simd::splat(kc.ln2_lo), el));
    let (rh, rl) = fast_two_sum(hh, lo);
    return rh, rl;
}

/// erf x as a double word for |x| < 1/2: 2/sqrt(pi) x + x z P(z), z = x^2, the first product exact.
pub fn erf_small<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let z = x * x;
    let (ph, p0) = two_prod(x, Simd::splat(kc.two_sqrtpi_hi));
    let (h, l) = fast_two_sum(ph, p0 + x.fma(Simd::splat(kc.two_sqrtpi_lo), x * z * T::poly::<{Poly::ErfP}>(z)));
    return h, l;
}

/// erfc a = (h + l) 2^k for a >= 1/2 (NaN as 1/2): e^-a^2 from `expk` of the exact -a^2, times
/// g = erfc(a) e^(a^2) from the table, 8 pieces per binade: a = m 2^e, piece 8 (e + 1) + 8 (m - 1).
pub fn erfc_dw<T: Lane, const N: usize>(a: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let b = at_most(at_least(a, sp(0.5)), Simd::splat(T::kc().erfc_max));
    let (m, e) = T::frexp(b);
    let (gh, gl) = T::erfc_g(b, (e + T::c(1.0)) * T::c(8.0) + ((m - T::c(1.0)) * T::c(8.0)).floor());
    let (sh, sl) = two_prod(b, b);
    let (eh, el, k) = T::expk(-sh, -sl);
    let (ph, p0) = two_prod(eh, gh);
    return ph, p0 + eh.fma(gl, el * gh), k;
}

/// x^y from m0 = e^z, z = y log|x| (zh its high part), for x^y = +-m0: overflow and underflow past
/// the thresholds by 1 (`k` alone decides inside them), the sign of a negative x with an odd y, and the
/// Annex F cases: |x| 0 or infinite, y infinite, NaN, a negative x with y not integral, and
/// pow(x, +-0) = pow(1, y) = 1 for every x and y.
pub fn pow_finish<T: Lane, const N: usize>(
    x: Simd<T, N>,
    y: Simd<T, N>,
    yint: Mask<N>,
    yodd: Mask<N>,
    zh: Simd<T, N>,
    m0: Simd<T, N>,
) Simd<T, N> {
    let kc = T::kc();
    let m = choose(
        zh.greater_than(Simd::<T, N>::splat(kc.exp_max) + T::c(1.0)),
        inf(),
        choose(zh.less_than(Simd::<T, N>::splat(kc.exp_min) - T::c(1.0)), sp(0.0), m0),
    );
    // A positive finite x other than 1 and a finite nonzero y: m itself (NaN fails every comparison).
    let plain = x.greater_than(sp(0.0)) & x.less_than(inf()) & y.abs().less_than(inf()) & y.not_equal(sp(0.0)) & x.not_equal(
        sp(1.0),
    );
    if likely(plain.all()) {
        return m;
    }
    return pow_special(x, y, yint, yodd, m);
}

// `pow_finish`'s Annex F cases and sign, apart: they take their call only when a lane needs them.
fn pow_special<T: Lane, const N: usize>(x: Simd<T, N>, y: Simd<T, N>, yint: Mask<N>, yodd: Mask<N>, m0: Simd<T, N>) Simd<
    T,
    N
> {
    let a = x.abs();
    let mut m = m0;
    let ylt = y.less_than(sp(0.0));
    m = choose(a.equal(sp(0.0)), choose(ylt, inf(), sp(0.0)), m);
    m = choose(a.equal(inf()), choose(ylt, sp(0.0), inf()), m);
    m = choose(
        y.abs().equal(inf()),
        choose(a.equal(sp(1.0)), sp(1.0), choose(a.less_than(sp(1.0)) ^ ylt, sp(0.0), inf())),
        m,
    );
    let neg = sp::<T, N>(1.0).copysign(x).less_than(sp(0.0));
    let r = choose(neg & yodd, -m, m);
    let bad = x.is_nan() | y.is_nan() | neg & !yint & x.not_equal(sp(0.0)) & a.not_equal(inf());
    return choose(y.equal(sp(0.0)) | x.equal(sp(1.0)), sp(1.0), choose(bad, nan(), r));
}

/// x - j pi/2 by four fmas for an integral j: below cw_max for |x| the first is exact and each later
/// one rounds at the size of the remainder, about 1.5 ULP of it in all.
pub fn sub_pio2<T: Lane, const N: usize>(x: Simd<T, N>, j: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    let r = (-j).fma(Simd::splat(kc.pio2_2), (-j).fma(Simd::splat(kc.pio2_1), x));
    return (-j).fma(Simd::splat(kc.pio2_4), (-j).fma(Simd::splat(kc.pio2_3), r));
}

/// x reduced by pi/2: `(q, rh, rl)` with x = q pi/2 + rh + rl modulo 2 pi, q in 0..4 (as floats),
/// |rh + rl| <= pi/4, the absolute error far below the closest any float comes to a multiple of pi/2.
/// Below `cw_max` three parts of pi/2: k pio2_1 exact, k pio2_2f an exact double word, the sums exact
/// but the last; from it the bit reduction. A NaN or infinite x gives a NaN rh.
pub fn rem_pio2<T: Lane, const N: usize>(x: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let big = x.abs().greater_equal(Simd::splat(kc.cw_max));
    if unlikely(big.any()) {
        // Its own path, so that nothing of the common one lives across the bit reduction's call. The
        // lanes it does not serve get cw_max: its table reads stay in range (`rem_pio2_big`).
        let (q, rh, rl) = rem_pio2_cw(x, choose(big, sp::<T, N>(0.0), (x * kc.two_over_pi).round_even()));
        let fin = x.is_finite();
        let (bq, bh, bl) = T::rem_pio2_big(choose(big & fin, x, Simd::splat(kc.cw_max)));
        return choose(big, bq, q), choose(big, choose(fin, bh, x - x), rh), choose(big, bl, rl);
    }
    let (q, rh, rl) = rem_pio2_cw(x, (x * kc.two_over_pi).round_even());
    return q, rh, rl;
}

// `rem_pio2` below `cw_max` for x near k pi/2.
fn rem_pio2_cw<T: Lane, const N: usize>(x: Simd<T, N>, k: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let kc = T::kc();
    let r1 = (-k).fma(Simd::splat(kc.pio2_1), x);
    let (ph, pl) = two_prod(k, Simd::splat(kc.pio2_2f));
    let (s, e) = two_sum(r1, -ph);
    let (rh, rl) = fast_two_sum(s, (-k).fma(Simd::splat(kc.pio2_3f), e - pl));
    return k - (k * T::c(0.25)).floor() * T::c(4.0), rh, rl;
}

/// `(c, y, q)` of the cube root of positive a = m 2^e: e = 3q + r, r in {-1, 0, 1}, c = m 2^r, and
/// y = P(m) 2^(r/3), the start of the iterations to cbrt c.
pub fn cbrt_start<T: Lane, const P: Poly, const N: usize>(a: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Simd<T, N>) {
    let (m, e) = frexp_any(a);
    let q = (e * T::c(1.0 / 3.0)).round_even();
    let r = e - q * T::c(3.0);
    let up = r.equal(sp(1.0));
    let dn = r.equal(sp(-1.0));
    let s: Simd<T, N> = choose(up, sp(1.2599210498948731648), choose(dn, sp(0.79370052598409973738), sp(1.0)));
    let p2: Simd<T, N> = choose(up, sp(2.0), choose(dn, sp(0.5), sp(1.0)));
    return m * p2, T::poly::<P>(m) * s, q;
}

/// cbrt x from y = cbrt(c) (`cbrt_start`): y 2^q with x's sign; +-0, +-inf and NaN as x.
pub fn cbrt_finish<T: Lane, const N: usize>(x: Simd<T, N>, y: Simd<T, N>, q: Simd<T, N>) Simd<T, N> {
    let a = x.abs();
    return choose(a.equal(sp(0.0)) | a.equal(inf()) | x.is_nan(), x + x, (y * T::pow2i(q)).copysign(x));
}

/// hypot's per-lane scale for hi = max(|x|, |y|): the exponent of hi where its squares could overflow
/// or lose bits, else 0 (a lane's result then does not depend on its neighbors), and whether any lane
/// scales.
pub fn hypot_e<T: Lane, const N: usize>(hi: Simd<T, N>) (Simd<T, N>, bool) {
    let kc = T::kc();
    let far = hi.greater_than(Simd::splat(kc.hyp_hi)) | hi.less_than(Simd::splat(kc.hyp_lo)) & hi.not_equal(sp(0.0));
    let (_, e) = frexp_any(choose(far, hi, sp(1.0)));
    return e, far.any();
}

/// hypot from its root `r` of the unscaled squares: +inf for an infinite argument (NaN included), NaN
/// for a NaN.
pub fn hypot_finish<T: Lane, const N: usize>(x: Simd<T, N>, y: Simd<T, N>, r: Simd<T, N>) Simd<T, N> {
    return choose(x.abs().equal(inf()) | y.abs().equal(inf()), inf(), choose(x.is_nan() | y.is_nan(), x + y, r));
}

/// atan2's octant: `(n, d, swap)` with atan2 = atan(n / d) or, `swap`, pi/2 - atan(d / n) before the
/// sign and the x < 0 reflection; an infinite pair as (1, 1), one infinity as 1 over 0 or 0 over 1.
pub fn atan2_nd<T: Lane, const N: usize>(y: Simd<T, N>, x: Simd<T, N>) (Simd<T, N>, Simd<T, N>, Mask<N>) {
    let xi = x.abs().equal(inf());
    let yi = y.abs().equal(inf());
    let n = choose(yi, sp(1.0), choose(xi, sp(0.0), y.abs()));
    let d = choose(xi, sp(1.0), choose(yi, sp(0.0), x.abs()));
    return n, d, n.greater_than(d);
}

/// atan2 from v = atan of the octant's quotient (`atan2_nd`): base +- v, the base pi/2 (`swap`), pi
/// (x < 0 or -0), both, or 0, as hi + lo so that pi/2 and pi come out rounded once.
pub fn atan2_finish<T: Lane, const N: usize>(y: Simd<T, N>, x: Simd<T, N>, swap: Mask<N>, v: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    let neg = sp::<T, N>(1.0).copysign(x).less_than(sp(0.0));
    let m: Simd<T, N> = choose(swap, sp(1.0), choose(neg, sp(2.0), sp(0.0)));
    let r = m * kc.pio2_hi + (m * kc.pio2_lo + choose(swap ^ neg, -v, v));
    return choose(x.is_nan() | y.is_nan(), x + y, r.copysign(y));
}

/// `(int, odd)`: whether each y is an integer, and an odd one (`pow_finish`).
pub fn pow_parity<T: Lane, const N: usize>(y: Simd<T, N>) (Mask<N>, Mask<N>) {
    let yi = y.trunc().equal(y);
    let half = y * T::c(0.5);
    return yi, yi & half.trunc().not_equal(half);
}

/// The argument of log1p whose result is asinh a for a >= 0: |x| <= 2, a + a^2 / (1 + w); else 2a - 1 +
/// 1 / (w + a), w = sqrt(a^2 + 1); past `big`, a - 1 (log a, and `asinh_finish` adds ln2).
pub fn asinh_arg<T: Lane, const N: usize>(a: Simd<T, N>) Simd<T, N> {
    let two = a.greater_than(sp(2.0));
    let z = a * a;
    let w = (z + T::c(1.0)).sqrt();
    let q = choose(two, sp(1.0), z) / choose(two, w + a, w + T::c(1.0));
    return choose(
        a.greater_than(Simd::splat(T::kc().big)),
        a - T::c(1.0),
        choose(two, a.fma(sp(2.0), sp(-1.0)) + q, a + q),
    );
}

/// asinh x from v = log1p of `asinh_arg(|x|)`.
pub fn asinh_finish<T: Lane, const N: usize>(x: Simd<T, N>, v: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    let a = x.abs();
    let r = choose(a.greater_than(Simd::splat(kc.big)), v + kc.ln2_hi, v);
    return choose(a.less_than(Simd::splat(kc.tiny)) | x.is_nan() | a.equal(inf()), x, r.copysign(x));
}

/// The argument of log1p whose result is acosh x for x >= 1: x <= 2, t + sqrt(t (t + 2)), t = x - 1;
/// else 2x - 1 - 1 / (x + sqrt(x^2 - 1)); past `big`, x - 1 (log x, and `acosh_finish` adds ln2).
pub fn acosh_arg<T: Lane, const N: usize>(x: Simd<T, N>) Simd<T, N> {
    let t = x - T::c(1.0);
    let w = (t * (t + T::c(2.0))).sqrt();
    let two = x.fma(sp(2.0), sp(-1.0)) - T::c(1.0) / (x + w);
    return choose(x.greater_than(Simd::splat(T::kc().big)), t, choose(x.greater_than(sp(2.0)), two, t + w));
}

/// acosh x from v = log1p of `acosh_arg(x)`.
pub fn acosh_finish<T: Lane, const N: usize>(x: Simd<T, N>, v: Simd<T, N>) Simd<T, N> {
    let kc = T::kc();
    let r = choose(x.greater_than(Simd::splat(kc.big)), v + kc.ln2_hi, v);
    return choose(x.greater_equal(sp(1.0)), choose(x.equal(inf()), x, r), nan());
}

/// atanh x from v = log1p(2|x| / (1 - |x|)).
pub fn atanh_finish<T: Lane, const N: usize>(x: Simd<T, N>, v: Simd<T, N>) Simd<T, N> {
    let a = x.abs();
    let out = choose(a.equal(sp(1.0)), inf(), choose(a.greater_than(sp(1.0)), nan(), v * T::c(0.5)));
    return choose(a.less_than(Simd::splat(T::kc().tiny)) | x.is_nan(), x, out.copysign(x));
}

/// sin(rh + rl) for |rh + rl| <= pi/4.
pub fn sin_core<T: Lane, const N: usize>(rh: Simd<T, N>, rl: Simd<T, N>) Simd<T, N> {
    let z = rh * rh;
    return rh + (z * rh).fma(T::poly::<{Poly::SinP}>(z), (-(z * T::c(0.5))).fma(rl, rl));
}

/// cos(rh + rl) for |rh + rl| <= pi/4.
pub fn cos_core<T: Lane, const N: usize>(rh: Simd<T, N>, rl: Simd<T, N>) Simd<T, N> {
    let z = rh * rh;
    let hz = z * T::c(0.5);
    let w = sp::<T, N>(1.0) - hz;
    return w + (sp::<T, N>(1.0) - w - hz + (z * z).fma(T::poly::<{Poly::CosP}>(z), -(rh * rl)));
}

// k as an integer for an integer-valued |k| < 2^51 (NaN as 0, as a cast), and back: the low bits of k +
// 1.5 2^52, exact (an f64 to i64 conversion has no AVX2 instruction).
const fn f2i<const N: usize>(k: Simd<f64, N>) Simd<i64, N> {
    return (choose(k.equal(k), k, Simd::splat(0.0)) + 0x1.8p52).to_bits().wrapping_sub(
        Simd::splat(0x4338000000000000u64),
    ).bitcast::<i64, N>();
}

const fn i2f<const N: usize>(i: Simd<i64, N>) Simd<f64, N> {
    return Simd::<f64, N>::from_bits(i.bitcast::<u64, N>().wrapping_add(Simd::splat(0x4338000000000000u64))) - 0x1.8p52;
}

// The f64 log table's reduction for positive x (a subnormal scaled by 2^54 first, in the lanes that
// are): `(k, r, log(1/invc) hi and lo, invc)` with x = 2^k z, z in [0x1.6p-1, 0x1.6p0), and r = z invc - 1
// exact (|r| < 2^-7, `coeffs_f64.spc`). Any other x gives values the callers replace.
fn log_cell<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>, Simd<f64, N>, Simd<f64, N>, Simd<f64, N>) {
    let sub = x.less_than(Simd::splat(0x1p-1022)) & x.greater_than(Simd::splat(0.0));
    let (xs, ds) = if unlikely(sub.any()) {
        (choose(sub, x * 0x1p54, x), choose(sub, Simd::<f64, N>::splat(-54.0), Simd::splat(0.0)));
    } else {
        (x, Simd::<f64, N>::splat(0.0));
    };
    let ix = xs.to_bits();
    let tmp = ix.wrapping_sub(Simd::splat(0x3fe6000000000000u64));
    let i = tmp >> 45 & 127;
    let b = ((i << 1) + i).cast::<u32>().to_array(); // 3 i: no 64-bit multiply on AVX2
    let z = Simd::<f64, N>::from_bits(ix.wrapping_sub(tmp & 0xfff0000000000000u64));
    let invc = col::<f64, N>(c64::LOG_TAB, &b, 0);
    let kf = i2f(tmp.bitcast::<i64, N>() >> 52) + ds;
    return kf, z.fma(invc, Simd::splat(-1.0)), col::<f64, N>(c64::LOG_TAB, &b, 1), col::<f64, N>(c64::LOG_TAB, &b, 2), invc;
}

extend f32 as Lane {
    pub fn c(v: f64) f32 {
        return v as f32;
    }

    pub fn kc() &'static Konsts<f32> {
        return &c32::K;
    }

    pub fn poly<const P: Poly, const N: usize>(z: Simd<f32, N>) Simd<f32, N> {
        return c32::poly::<P, N>(z);
    }

    pub fn pow2i<const N: usize>(k: Simd<f32, N>) Simd<f32, N> {
        // k + 127 + 1.5 2^23 is exact; its low bits are k + 127, the exponent field.
        return Simd::<f32, N>::from_bits((k + 12583039.0).to_bits() << 23);
    }

    pub fn frexp<const N: usize>(x: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>) {
        let b = x.to_bits();
        return Simd::<f32, N>::from_bits(b & 0x007FFFFF | 0x3F800000), ((b >> 23).bitcast::<i32, N>() - 127).cast::<f32>();
    }

    pub fn rem_pio2_big<const N: usize>(x: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>, Simd<f32, N>) {
        // x is exact in f64, and the f64 reduction (three parts of pi/2 up to 2^19, then the bits of 2/pi)
        // leaves r far more accurate than f32 needs.
        let (q, h, l) = rem_pio2(x.cast::<f64>());
        let rh = h.cast::<f32>();
        return q.cast::<f32>(), rh, (h - rh.cast::<f64>() + l).cast::<f32>();
    }

    pub fn add_exp<const N: usize>(y: Simd<f32, N>, k: Simd<f32, N>) Simd<f32, N> {
        // The low bits of k + 1.5 2^23 are k's; a NaN k adds nothing (a NaN's payload would).
        let e = choose(k.equal(k), (k + 12582912.0).to_bits() << 23, Simd::splat(0));
        return Simd::<f32, N>::from_bits(y.to_bits().wrapping_add(e));
    }

    pub fn erfc_g<const N: usize>(a: Simd<f32, N>, i: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>) {
        let (h, l) = c32::erfc_g(a, i);
        return h, l;
    }

    pub fn expk<const N: usize>(xh: Simd<f32, N>, xl: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>, Simd<f32, N>) {
        let (h, l, k) = expk_p(xh, xl);
        return h, l, k;
    }

    pub fn log_parts<const N: usize>(x: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>, Simd<f32, N>, Simd<f32, N>) {
        let (e, a, b, im) = log_parts_p(x);
        return e, a, b, im;
    }

    pub fn logk<const N: usize>(x: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>) {
        let (h, l) = logk_p(x);
        return h, l;
    }

    pub fn index<const N: usize>(k: Simd<f32, N>) Simd<u32, N> {
        return k.cast::<u32>();
    }

    pub fn inf<const N: usize>() Simd<f32, N> {
        return Simd::<f32, N>::from_bits(Simd::splat(0x7F800000));
    }

    pub fn nan<const N: usize>() Simd<f32, N> {
        return Simd::<f32, N>::from_bits(Simd::splat(0x7FC00000));
    }

    pub fn log_b<const N: usize>(x: Simd<f32, N>) (Simd<f32, N>, Simd<f32, N>, Simd<f32, N>) {
        let (f, e) = log_split(x);
        let (v, im) = log1p_f(f);
        return e, v, im;
    }

    pub fn of_i32<const N: usize>(n: Simd<i32, N>) (Simd<f32, N>, Simd<f32, N>) {
        // The top 24 bits and the low 8 are exact in f32; their sum, exact as a double word.
        let (h, l) = two_sum((n >> 8 << 8).cast::<f32>(), (n & 0xFF).cast::<f32>());
        return h, l;
    }
}

extend f64 as Lane {
    pub fn c(v: f64) f64 {
        return v;
    }

    pub fn kc() &'static Konsts<f64> {
        return &c64::K;
    }

    pub fn poly<const P: Poly, const N: usize>(z: Simd<f64, N>) Simd<f64, N> {
        return c64::poly::<P, N>(z);
    }

    pub fn pow2i<const N: usize>(k: Simd<f64, N>) Simd<f64, N> {
        // As the f32 form: k + 1023 + 1.5 2^52.
        return Simd::<f64, N>::from_bits((k + 6755399441056767.0).to_bits() << 52);
    }

    pub fn frexp<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>) {
        let b = x.to_bits();
        return Simd::<f64, N>::from_bits(b & 0x000FFFFFFFFFFFFF | 0x3FF0000000000000), i2f(
            (b >> 52).bitcast::<i64, N>() - 1023,
        );
    }

    pub fn rem_pio2_big<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>, Simd<f64, N>) {
        // As the f32 form: a 224-bit window from bit E - 1, x 2/pi = mant * window 2^-222 modulo 4,
        // 32 bits per table word after 64 zero bits: window bit 0 is stream bit biased - 1077 + 64.
        let b = x.to_bits() & 0x7FFFFFFFFFFFFFFF;
        let mant = b & 0x000FFFFFFFFFFFFF | 0x0010000000000000;
        let j0 = (b >> 52) - 1013;
        let w = j0 >> 5;
        let sh = 32 - (j0 & 31);
        let all = Mask::<N>::splat(true);
        let zero = Simd::<u64, N>::splat(0);
        let mut lim: [Simd<u64, N>; 7] = [zero; 7];
        let mut prev = unsafe gather_unchecked(c64::TWO_OVER_PI, w, all, zero);
        for k in 0..7 {
            let next = unsafe gather_unchecked(c64::TWO_OVER_PI, w + (k as u64 + 1), all, zero);
            unsafe lim[6 - k] = (prev << 32 | next) >> sh & 0xFFFFFFFF;
            prev = next;
        }
        // mant * window in 32-bit columns (every product < 2^64, every column < 2^35).
        let m0 = mant & 0xFFFFFFFF;
        let m1 = mant >> 32;
        let mut acc: [Simd<u64, N>; 9] = [zero; 9];
        for k in 0..7 {
            // Wrapping: every product and column is below 2^64 (no check to pay).
            let p0 = m0.wrapping_mul(unsafe lim[k]);
            let p1 = m1.wrapping_mul(unsafe lim[k]);
            unsafe acc[k] = unsafe acc[k].wrapping_add(p0 & 0xFFFFFFFF);
            unsafe acc[k + 1] = unsafe acc[k + 1].wrapping_add((p0 >> 32).wrapping_add(p1 & 0xFFFFFFFF));
            unsafe acc[k + 2] = unsafe acc[k + 2].wrapping_add(p1 >> 32);
        }
        for c in 0..8 {
            unsafe acc[c + 1] = unsafe acc[c + 1].wrapping_add(unsafe acc[c] >> 32);
            unsafe acc[c] = unsafe acc[c] & 0xFFFFFFFF;
        }
        // Bits 223 and 222: the quadrant q0; bits 221 .. 63: the fraction in [0, 1), in three exact
        // 53-bit chunks of falling weight; rounded to the nearest quadrant and times pi/2.
        let a1 = acc[1];
        let a2 = acc[2];
        let a3 = acc[3];
        let a4 = acc[4];
        let a5 = acc[5];
        let a6 = acc[6];
        let q0 = (a6 >> 30).cast::<f64>();
        let fh = ((a6 & 0x3FFFFFFF) << 23 | a5 >> 9).cast::<f64>() * 0x1p-53;
        let fm = ((a5 & 0x1FF) << 44 | a4 << 12 | a3 >> 20).cast::<f64>() * 0x1p-106;
        let fl = ((a3 & 0xFFFFF) << 33 | a2 << 1 | a1 >> 31).cast::<f64>() * 0x1p-159;
        let kc = &c64::K;
        let up = fh.greater_equal(Simd::splat(0.5));
        let q1 = choose(up, q0 + 1.0, q0);
        let q = choose(q1.greater_equal(Simd::splat(4.0)), q1 - 4.0, q1);
        let (h, l) = fast_two_sum(choose(up, fh - 1.0, fh), fm);
        let (p, p0) = two_prod(h, Simd::splat(kc.pio2_hi));
        let (rh, rl) = fast_two_sum(p, h.fma(Simd::splat(kc.pio2_lo), (l + fl).fma(Simd::splat(kc.pio2_hi), p0)));
        let neg = x.less_than(Simd::splat(0.0));
        let qn = choose(q.equal(Simd::splat(0.0)), q, 4.0 - q);
        return choose(neg, qn, q), choose(neg, -rh, rh), choose(neg, -rl, rl);
    }

    pub fn add_exp<const N: usize>(y: Simd<f64, N>, k: Simd<f64, N>) Simd<f64, N> {
        let e = choose(k.equal(k), (k + 6755399441055744.0).to_bits() << 52, Simd::splat(0));
        return Simd::<f64, N>::from_bits(y.to_bits().wrapping_add(e));
    }

    pub fn erfc_g<const N: usize>(a: Simd<f64, N>, i: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>) {
        let (h, l) = c64::erfc_g(a, i);
        return h, l;
    }

    pub fn expk<const N: usize>(xh: Simd<f64, N>, xl: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>, Simd<f64, N>) {
        // x = k ln2/128 + r (k ln2n_hi exact below 2^18; a larger k only where e^x overflows or
        // underflows, a lane the callers replace), e^x = 2^(k >> 7) 2^(j/128) e^r, j = k mod 128: th
        // (1 + tail) from the table, e^r = 1 + r + r^2 P(r).
        let kc = &c64::K;
        let kn = (xh * kc.inv_ln2n).round_even();
        let r = (-kn).fma(Simd::splat(kc.ln2n_hi), xh) + (-kn).fma(Simd::splat(kc.ln2n_lo), xl);
        let ki = f2i(kn);
        let b = ((ki & 127) << 1).cast::<u32>().to_array();
        let th = col::<f64, N>(c64::EXP_TAB, &b, 0);
        let tmp = col::<f64, N>(c64::EXP_TAB, &b, 1) + r + r * r * c64::poly::<{Poly::ExpT}, N>(r);
        return th, th * tmp, i2f(ki >> 7);
    }

    pub fn log_parts<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>, Simd<f64, N>, Simd<f64, N>) {
        let (kf, r, lch, lcl, invc) = log_cell(x);
        // log z = log(1/invc) + log1p(r), log1p(r) = r - r^2/2 + r^3 P(r): (a, b) from the exact sum.
        let (a, a0) = two_sum(lch, r);
        return kf, a, a0 + (lcl + r * r * r.fma(c64::poly::<{Poly::LogT}, N>(r), Simd::splat(-0.5))), invc * (1.0 - r);
    }

    pub fn logk<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>) {
        let kc = &c64::K;
        let (kf, r, lch, lcl, _) = log_cell(x);
        // k ln2 + log(1/invc) + r - r^2/2 exactly as a sum of double words, then r^3 P(r).
        let (eh, e0) = two_prod(kf, Simd::splat(kc.ln2_hi));
        let (s1, e1) = two_sum(eh, lch);
        let (s2, e2) = two_sum(s1, r);
        let (qh, ql) = two_prod(r, r);
        let (s3, e3) = two_sum(s2, qh * -0.5);
        let lo = kf.fma(Simd::splat(kc.ln2_lo), e0) + lcl + e1 + e2 + e3 + ql * -0.5 + r * qh * c64::poly::<
            {Poly::LogTP},
            N
        >(r);
        let (h, l) = fast_two_sum(s3, lo);
        return h, l;
    }

    pub fn index<const N: usize>(k: Simd<f64, N>) Simd<u32, N> {
        return f2i(k).cast::<u32>();
    }

    pub fn inf<const N: usize>() Simd<f64, N> {
        return Simd::<f64, N>::from_bits(Simd::splat(0x7FF0000000000000));
    }

    pub fn nan<const N: usize>() Simd<f64, N> {
        return Simd::<f64, N>::from_bits(Simd::splat(0x7FF8000000000000));
    }

    pub fn log_b<const N: usize>(x: Simd<f64, N>) (Simd<f64, N>, Simd<f64, N>, Simd<f64, N>) {
        let (kf, r, lch, lcl, invc) = log_cell(x);
        return kf, lch + (r + (lcl + r * r * r.fma(c64::poly::<{Poly::LogT}, N>(r), Simd::splat(-0.5)))), invc * (1.0 - r);
    }

    pub fn of_i32<const N: usize>(n: Simd<i32, N>) (Simd<f64, N>, Simd<f64, N>) {
        return i2f(n.cast::<i64>()), Simd::<f64, N>::splat(0.0);
    }
}
