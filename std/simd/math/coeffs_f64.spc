    0x1.55548efcc23d3p-3,
    0x1.55545dfcfe76cp-5,
    0x1.123b48acb1bdap-7,
    0x1.6db41840be765p-10,
];

/// balanced: e^r = 1 + r + r^2/2 + r^3 p(r) (e^x, not e^x - 1); error weighted by |r|^3; r in [-0x1.62e5de15ca6cap-2, 0x1.62e5de15ca6cap-2], degree 8, weighted error 2^-57.2.
const EXP_B: [f64; 9] = [
    0x1.555555555555cp-3,
    0x1.555555555316dp-5,
    0x1.111111110e582p-7,
    0x1.6c16c17cf326p-10,
    0x1.a01a01b671bd2p-13,
    0x1.a019aa99420bbp-16,
    0x1.71dde8830ef85p-19,
    0x1.28a01ab99bba6p-22,
    0x1.af7930162830bp-26,
];

/// fast: log((1 + s)/(1 - s)) = 2s + s z p(z), z = s^2; error weighted by z; z in [0.0, 0x1.e24d6791df90fp-6], degree 2, weighted error 2^-29.2.
const LOG_F: [f64; 3] = [0x1.55557a25ecf7ap-1, 0x1.995eb9d9a8fb2p-2, 0x1.31e2f5b516889p-2];

/// fast: sin r = r + r z p(z), z = r^2, |r| <= pi/2 + 2^-8; error weighted by z; z in [0.0, 0x1.3d70a3d70a3d7p1], degree 3, weighted error 2^-27.5.
const SIN_F: [f64; 4] = [-0x1.55554cd628eep-3, 0x1.110efa9443292p-7, -0x1.9f76792531773p-13, 0x1.5e11281a1f237p-19];

/// fast: tan r = r + r z p(z), z = r^2, |r| <= pi/4 + 2^-8; error weighted by z; z in [0.0, 0x1.428f5c28f5c29p-1], degree 5, weighted error 2^-25.3.
const TAN_F: [f64; 6] = [
    0x1.5554bdd90dbd5p-2,
    0x1.11341bb88f56ap-3,
    0x1.b4bff4fc011cbp-5,
    0x1.95c492aef460fp-6,
    0x1.54196b1678fbap-9,
    0x1.3d817e0a20484p-7,
];

/// fast: asin x = x + x z p(z), z = x^2; error weighted by z; z in [0.0, 0x1p-2], degree 4, weighted error 2^-27.5.
const ASIN_F: [f64; 5] = [
    0x1.5555ca7404506p-3,
    0x1.33014e70ac13ap-4,
    0x1.748c6345a6b7ep-5,
    0x1.8ba262bbe5d24p-6,
    0x1.59dabfcb71736p-5,
];

/// fast: atan t = t + t z p(z), z = t^2; error weighted by z; z in [0.0, 0x1.5f62b6ae7d567p-3], degree 3, weighted error 2^-25.5.
const ATAN_F: [f64; 4] = [-0x1.55545798c463cp-2, 0x1.9925dd828f72dp-3, -0x1.1c4257ccb716ap-3, 0x1.4a2626e867381p-4];

/// cbrt m = p(m), the Newton start; relative error; m in [0x1p0, 0x1p1], degree 4, weighted error 2^-16.7.
const CBRT_P: [f64; 5] = [
    0x1.0392cc8a3db1ep-1,
    0x1.6fb1e0e9956ap-1,
    -0x1.33d3870eb4c1p-2,
    0x1.60a156db4abd3p-4,
    -0x1.5b77f4b2a26a7p-7,
];

/// cbrt m = p(m), the Halley start of the balanced class; relative error; m in [0x1p0, 0x1p1], degree 5, weighted error 2^-19.6.
const CBRT_B: [f64; 6] = [
    0x1.e4b0caeac3a99p-2,
    0x1.ad2351f8ed75fp-1,
    -0x1.e07d83fd73ca4p-2,
    0x1.9f49b2723bf95p-3,
    -0x1.9cc444b5bbb72p-5,
    0x1.5e85c6831af37p-8,
];

/// Polynomial `P` of the kernels at `z`.
pub const fn poly<const P: Poly, const N: usize>(z: Simd<f64, N>) Simd<f64, N> {
    return switch P {
        ExpP => horner(z, &EXP_P),
        LogP => horner(z, &LOG_P),
        LogkP => horner(z, &LOGK_P),
        SinP => horner(z, &SIN_P),
        CosP => horner(z, &COS_P),
        TanP => horner(z, &TAN_P),
        AsinP => horner(z, &ASIN_P),
        AtanP => horner(z, &ATAN_P),
        ErfP => horner(z, &ERF_P),
        ExpT => horner(z, &EXP_T),
        LogT => horner(z, &LOG_T),
        LogTP => horner(z, &LOG_T_P),
        SinhP => horner(z, &SINH_P),
        TanhP => horner(z, &TANH_P),
        ExpF => horner(z, &EXP_F),
        ExpB => horner(z, &EXP_B),
        LogF => horner(z, &LOG_F),
        SinF => horner(z, &SIN_F),
        TanF => horner(z, &TAN_F),
        AsinF => horner(z, &ASIN_F),
        AtanF => horner(z, &ATAN_F),
        CbrtP => horner(z, &CBRT_P),
        CbrtB => horner(z, &CBRT_B),
    };
}

