@arch(aarch64)
@simd_impl(simd::Op::OverflowAdd, [cpu::Feature::Neon])
fn overflow_add_i8x16(a: i8x16, b: i8x16) mask16 {
    let x = q_s8(a);
    let y = q_s8(b);
