@arch(aarch64)
@simd_impl(simd::Op::Compress, [cpu::Feature::Neon])
fn compress_i16x8(m: mask8, v: i16x8, fill: i16x8) i16x8 {
    let i = unsafe vld1q_u8(((&unsafe COMPRESS_2_8_Q[(m as u64 << 1) as usize]) as *const u64) as *const u8);
    let lo = vqtbl1q_u8(vreinterpretq_u8_s16(q_s16(v)), i);
    return v_s16(vreinterpretq_s16_u8(vqtbx1q_u8(lo, vreinterpretq_u8_s16(q_s16(fill)), veorq_u8(i, vdupq_n_u8(16)))));
}

