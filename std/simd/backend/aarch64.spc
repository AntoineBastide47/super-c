@arch(aarch64)
@simd_impl(simd::Op::WrappingAdd, [cpu::Feature::Neon])
fn wrapping_add_i8x16(a: i8x16, b: i8x16) i8x16 {
    return v_s8(vreinterpretq_s8_u8(vaddq_u8(vreinterpretq_u8_s8(q_s8(a)), vreinterpretq_u8_s8(q_s8(b)))));
}

