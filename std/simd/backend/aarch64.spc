@arch(aarch64)
@simd_impl(simd::Op::LoadMasked, [cpu::Feature::Neon])
fn load_masked_i8x16(p: *const i8, m: mask16, fb: i8x16) i8x16 {
    let bits = m as u64;
    if bits == 65535 {
        return v_s8(unsafe vld1q_s8(p));
    }
    let mut r = q_s8(fb);
    if (bits >> 0 & 1) != 0 {
        r = unsafe vld1q_lane_s8(p, r, 0);
    }
    if (bits >> 1 & 1) != 0 {
        r = unsafe vld1q_lane_s8(p + 1, r, 1);
    }
    if (bits >> 2 & 1) != 0 {
